{- | The diagonal homotopy groups of spheres and ``pi 3 (S^2)``, the HoTT book, Section 8.6. -}

\import Algebra.Group
\import Arith.Int
\import Category \hiding (id, o)
\import Homotopy.HomotopyGroup
\import Homotopy.HomotopyGroup.Hopf
\import Homotopy.HomotopyGroup.Stabilization
\import Homotopy.Pointed
\import Homotopy.Sphere
\import Paths

\sfunc PiGroup_Sn_diagonal (m : Nat)
  : PiGroup_1+ (suc m) (Sphere.pointed (suc (suc m))) = AddGroup.toGroup IntRing \elim m
  | 0 => PiGroup2_S2
  | suc m => inv (Cat.isotoid (sphereStabilization.diagonalIso m)) *> PiGroup_Sn_diagonal m

\sfunc PiGroup3_S2 : PiGroup_1+ 2 (Sphere.pointed 2) = AddGroup.toGroup IntRing
  => inv (Cat.isotoid hopfPi3Iso) *> PiGroup_Sn_diagonal 1
