\import Algebra.Group
\import Algebra.Group.GroupCat
\import Algebra.Group.GroupHom
\import Algebra.Group.Product
\import Algebra.Pointed (ide)
\import Arith.Int
\import Category \hiding (id, o)
\import Equiv
\import Equiv.Sigma
\import Homotopy.HomotopyGroup
\import Homotopy.HomotopyGroup.Circle
\import Homotopy.Pointed
\import Homotopy.Sphere
\import Homotopy.Sphere.Circle
\import Homotopy.Torus
\import Logic
\import Logic.Unique
\import Paths
\import Paths.Meta

\sfunc PiGroup_Torus
  : PiGroup_1+ 0 (Pointed.make point) = ProductGroup (AddGroup.toGroup IntRing) (AddGroup.toGroup IntRing)
  => Cat.isotoid iso
     *> PiGroup_Product 0 (Sphere.pointed 1) (Sphere.pointed 1)
     *> path \lam i => ProductGroup (PiGroup_S1 i) (PiGroup_S1 i)
  \where \protected {
    \func torusFun (t : Torus) : \Sigma (Sphere 1) (Sphere 1)
      => (Sphere1-equiv (TorusSphere-equiv t).1, Sphere1-equiv (TorusSphere-equiv t).2)

    \lemma torusFun-isEquiv : IsEquiv torusFun
      => inP (transQEquiv TorusSphere-equiv (sigma-equiv Sphere1-equiv (\lam _ => Sphere1-equiv)))

    \func torusMap : Pointed.make point ->* PointedProduct (Sphere.pointed 1) (Sphere.pointed 1)
      => (torusFun, idp)

    \func hom : GroupHom (PiGroup_1+ 0 (Pointed.make point)) (PiGroup_1+ 0 (PointedProduct (Sphere.pointed 1) (Sphere.pointed 1)))
      => piGroupMap 0 torusMap

    \func iso : Iso {GroupCat} hom
      => GroupCat.isoOfEquiv hom (IsEquiv.toQEquiv (piMap-isEquiv 1 torusMap torusFun-isEquiv))
  }

\lemma torus-pi-high-contr (r : Nat) : Contr (PiSet (suc (suc r)) (Pointed.make point))
  => pi-high-contr-of-loopSet r (Pointed.make point) (rewrite Loop_S1^2 \lam _ _ => prop-isProp)
  \where \protected {
    \lemma at (r : Nat) (t : Torus) : Contr (PiSet (suc (suc r)) (Pointed.make t))
      => pi-high-contr-of-loopSet r (Pointed.make t) (torus-isGpd t t)

    \lemma trivial (r : Nat) (z : PiCGroup_2+ r (Pointed.make point))
      : z = ide {PiCGroup_2+ r (Pointed.make point)}
      => isContr=>isProp (torus-pi-high-contr r) z _
  }
