{- | Constructs accessible reflective subuniverses and modalities from a small family of maps, including nullification
 -   at a family of types.
 -
 -   A localization is *accessible* when it is generated by a small family of maps `F j : X j -> Y j`: a type `Z` is
 -   local iff precomposition with each `F j` is an equivalence on `Y j -> Z`. The reflector is built as a higher
 -   inductive type `LData A` whose path constructor `isExt` forces every `F j` to become invertible. To obtain
 -   *uniqueness* of extensions (not just existence), the construction is repeated against an augmented family `famHat`
 -   that pairs each `F j` with the codiagonal of its pushout, which encodes path-equivalences and yields the full
 -   universal property. Nullification — quotienting by maps to the unit type — is recovered as the special case where
 -   each `Y j` is contractible.
 -
 -   Augmented Family for Coherence: The augmented family `famHat` doubles each generator with its codiagonal so that
 -   the localization respects path-spaces, making the recursion principle into a genuine equivalence rather than just a
 -   section.
 -}

\import Algebra.Meta
\import Data.Or
\import Equiv
\import Equiv.Path
\import Equiv.Sigma
\import Function
\import Function.Meta
\import Homotopy.Cube
\import Homotopy.Localization.Modality
\import Homotopy.Localization.Universe
\import Homotopy.Pushout
\import Logic
\import Paths

{- | Main constructor. Packages `universe` and the HIT into a `ReflUniverse`, providing for each `A` a `Localization`
 -   with reflector `LData` and unit `alpha`.
 -}
\func famUniverse.{u} {fam : Family.{u}} : ReflUniverse \cowith
  | Universe => universe
  | localization A => \new Localization {
    | S' {
      | S => LData {famHat} A
      | local j => inP \new QEquiv {
        | ret => ext {famHat} {A} {inl j}
        | ret_f g =>
          \have p s => path (isExt {famHat} {A} {inr j} (rec (ext {famHat} {A} {inl j} (g `o` F j)) g (\lam x => path (isExt {famHat} {A} {inl j} (g `o` F j) x))) s)
          \in path (\lam i y => (inv (p (pinl y)) *> p (pinr y)) @ i)
        | f_sec f => path (\lam i x => isExt {famHat} {A} {inl j} f x i)
      }
    }
    | inL => alpha {famHat}
    | local-univ Z => alpha-equiv {famHat} {A} {\new Local {universe {famHat}} Z
        \case \elim __ \with {
          | inl j => local {Z} j
          | inr j => transport IsEquiv (inv (path (\lam i g d => rec.map g id id (\lam x => idpe (F j x)) d @ i)))
                               (IsEquiv.trans (Embedding.diag-equiv (Embedding.fromIsEquiv (Z.local j))) (pushout_pullback-equiv (F j)))
        }}
  }
  \where {
    \open PushoutData

    {- | A class packaging a generating family of maps: index `J : \Type`, domain/codomain families `X, Y : J -> \Type`,
     -   and maps `F : \Pi (j : J) -> X j -> Y j`. A type is local w.r.t. this family when each `F j` is "invertible"
     -   against it.
     -}
    \class Family.{u}
      | J : \Type u
      | X : J -> \Type u
      | Y : J -> \Type u
      | F : \Pi (j : J) -> X j -> Y j

    {- | Instance of `Universe` for a `Family`. A type `Z` is local iff `o F j : (Y j -> Z) -> (X j -> Z)` is an
     -   equivalence for every `j`.
     -}
    \instance universe.{u} {fam : Family.{u}} : Universe.{u} \cowith
      | isLocal Z => \Pi (j : J) -> IsEquiv {Y j -> Z} {X j -> Z} (o F j)

    -- | Higher inductive type giving the localization of `A` at `fam`. Constructors:
    \data LData.{u} {fam : Family.{u}} (A : \Type u)
      -- | unit map `A -> LData A`.
      | alpha A
      -- | extends a function `X j -> LData A` along `F j` to `Y j -> LData A`.
      | ext {j : J} (X j -> LData A) (Y j)
      -- | path constructor making `ext f (F j x) = f x`, ensuring extensions are sections of precomposition.
      | isExt {j : J} (f : X j -> LData A) (x : X j) : ext f (F j x) = f x

    {- | Recursion principle. Given `h : A -> Z` into a local type, produces `LData A -> Z` by using local-section data
     -   `sec` to interpret `ext` and `f_sec` to interpret `isExt`.
     -}
    \func dataExt.{u} {fam : Family.{u}} {A : \Type u} {Z : Local.{u}} (h : A -> Z) (d : LData A) : Z \elim d
      | alpha a => h a
      | ext {j} f y => IsEquiv.ret (Z.local j) (\lam x => dataExt h (f x)) y
      | isExt {j} f x i => (IsEquiv.f_ret (Z.local j) {\lam x => dataExt h (f x)} i) x

    {- | Uniqueness of extensions. Two maps `H1, H2 : LData A -> Z` agreeing on `alpha` are equal everywhere; the proof
     -   uses the augmented family `famHat` so that the path-level coherence of `isExt` is itself extendable.
     -}
    \func dataExt-unique.{u} {fam : Family.{u}} {A : \Type u} {Z : Local.{u}} (H1 H2 : LData A -> Z) (K : \Pi (a : A) -> H1 (alpha a) = H2 (alpha a)) (d : LData A) : H1 d = H2 d \elim d
      | alpha a => K a
      | ext {j} f y =>
        \have p x => path (\lam i => H1 (isExt f x i)) <* dataExt-unique H1 H2 K (f x) *> inv (path (\lam i => H2 (isExt f x i)))
        \in path (\lam i => IsEquiv.ret (pmapIsEquiv (Z.local j) {H1 `o` ext f} {H2 `o` ext f}) (path (\lam i' x => p x i')) i y)
      | isExt {j} f x i =>
        \let | p x => path (\lam i => H1 (isExt f x i)) <* dataExt-unique H1 H2 K (f x) *> inv (path (\lam i => H2 (isExt f x i)))
             | e => pmapIsEquiv (Z.local j) {H1 `o` ext f} {H2 `o` ext f}
             | q => path (\lam i => IsEquiv.ret e (path (\lam i' x => p x i')) i (F j x))
             | s : q = p x => path (\lam k => path (\lam i => IsEquiv.f_ret e k i x))
        \in Cube2.map _ _ _ _ s i

    {- | The reflection equivalence `(LData A -> Z) ≃ (A -> Z)` given by precomposition with `alpha`, for any local `Z`.
     -   This is the defining universal property of the localization.
     -}
    \lemma alpha-equiv.{u} {fam : Family.{u}} {A : \Type u} {Z : Local.{u}} : IsEquiv {LData A -> Z} {A -> Z} (-o alpha)
      => inP \new QEquiv {
        | ret => dataExt
        | ret_f h => path (\lam i d => dataExt-unique (dataExt (h `o` alpha)) h (\lam _ => idp) d i)
        | f_sec _ => idp
      }

    {- | Augmented domain, codomain, and map. For `inl j` they recover `F j`; for `inr j` they take the codiagonal
     -   `PushoutData (F j) (F j) -> Y j` (the canonical map sending both copies to identity).
     -}
    \func DHat.{u} {fam : Family.{u}} (k : J `Or` J) : \Type u \elim k
      | inl j => X j
      | inr j => PushoutData (F j) (F j)

    {- | Augmented domain, codomain, and map. For `inl j` they recover `F j`; for `inr j` they take the codiagonal
     -   `PushoutData (F j) (F j) -> Y j` (the canonical map sending both copies to identity).
     -}
    \func CHat.{u} {fam : Family.{u}} (k : J `Or` J) : \Type u \elim k
      | inl j => Y j
      | inr j => Y j

    {- | Augmented domain, codomain, and map. For `inl j` they recover `F j`; for `inr j` they take the codiagonal
     -   `PushoutData (F j) (F j) -> Y j` (the canonical map sending both copies to identity).
     -}
    \func FHat.{u} {fam : Family.{u}} (k : J `Or` J) (d : DHat k) : CHat k \elim k
      | inl j => F j d
      | inr j => rec id id (\lam _ => idp) d

    {- | The augmented `Family` indexed by `J `Or` J` built from `DHat`, `CHat`, `FHat`. Locality w.r.t. `famHat` is
     -   equivalent to locality w.r.t. `fam` plus path-locality, which is what `dataExt-unique` needs.
     -}
    \func famHat.{u} {fam : Family.{u}}
      => \new Family (J `Or` J) DHat CHat FHat

    {- | For `f : X -> Y`, `Σ (g1 g2 : Y -> Z) (g1 ∘ f = g2 ∘ f) ≃ (PushoutData f f -> Z)`. Used to identify locality at
     -   the codiagonal of `f` with the diagonal of `o f` being an embedding.
     -}
    \lemma pushout_pullback-equiv {X Y Z : \Type} (f : X -> Y)
      : IsEquiv {\Sigma (g1 g2 : Y -> Z) (g1 `o` f = g2 `o` f)}
                {PushoutData f f -> Z}
                (\lam t => rec t.1 t.2 (\lam x => path ((t.3 @ __) x)))
      => inP \new QEquiv {
        | ret m => (m `o` pinl, m `o` pinr, path (\lam i x => m (pglue x i)))
        | ret_f t => idp
        | f_sec m => path (\lam i d => (\case \elim d \return rec (m `o` pinl) (m `o` pinr) (\lam x => path (\lam i => m (pglue x i))) d = m d \with {
          | pinl y => idp
          | pinr y => idp
          | pglue x i => idp
        }) @ i)
      }
  }

{- | Modality obtained by localizing at a family `X : J -> \Type`, viewed as maps `X j -> \Sigma` (the unit type). This
 -   *nullifies* each `X j`, making it contractible after reflection.
 -}
\func nullFamUniverse.{u} {J : \Type u} (X : J -> \Type u) : Modality \cowith
  | ReflUniverse => famUniverse {\new famUniverse.Family J X (\lam _ => \Sigma) (\lam _ _ => ())}
  | isModality A B => \new Local {
    | local j => inP $ equation
        (\Sigma -> \Sigma (a : A) (B a))                   {\new QEquiv { | B => \Sigma (f : \Sigma -> A) (\Sigma -> B (f ())) | f g => (\lam _ => (g ()).1, \lam _ => (g ()).2) | ret p _ => (p.1 (), p.2 ()) | ret_f g => idp | f_sec p => idp }}
        (\Sigma (f : \Sigma -> A) (\Sigma -> B (f ())))    {sigma-right {\Sigma -> A} $ \lam f => IsEquiv.toQEquiv $ (B (f ())).local j}
        (\Sigma (f : \Sigma -> A) (X j -> B (f ())))       {sigma-left $ IsEquiv.toQEquiv (A.local j)}
        (\Sigma (f : X j -> A) (\Pi (x : X j) -> B (f x))) {\new QEquiv { | B => X j -> \Sigma (a : A) (B a) | f p x => (p.1 x, p.2 x) | ret g => ((g __).1, (g __).2) | ret_f p => idp | f_sec g => idp }}
        (X j -> \Sigma (a : A) (B a))
  }
  \where {
    {- | `Z` is local for this modality iff for every `j`, the constant map `Z -> (X j -> Z)` is an equivalence — i.e.
     -   `X j -> Z` is essentially `Z`.
     -}
    \lemma localDesc.{u} {J : \Type u} {X : J -> \Type u} (Z : \Type u) : (nullFamUniverse X).isLocal Z = (\Pi (j : J) -> IsEquiv {Z} {X j -> Z} (\lam z _ => z))
      => path \lam i => \Pi (j : J) -> IsEquiv {QEquiv_= (unit-func Z) i} {X j -> Z} (\lam t _ => coe2 (QEquiv_= (unit-func Z)) i t right)
  }

{- | Special case nullifying a single type `M`, giving the modality whose local types `Z` satisfy `Z ≃ (M -> Z)` via the
 -   constant map.
 -}
\func nullTypeUniverse.{u} (M : \Type u) : Modality => nullFamUniverse {\Sigma} (\lam _ => M)
  \where {
    -- | Characterization of locality as the constant-map equivalence `Z ≃ (M -> Z)`.
    \lemma localDesc.{u} (M Z : \Type u) : (nullTypeUniverse M).isLocal Z = IsEquiv {Z} {M -> Z} (\lam z _ => z)
      => nullFamUniverse.localDesc Z *> QEquiv_= (unit-func (IsEquiv {Z} {M -> Z} (\lam z _ => z)))
  }
