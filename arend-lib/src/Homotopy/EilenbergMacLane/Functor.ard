-- | After ``theorems/homotopy/EilenbergMacLaneFunctor.agda`` in HoTT-Agda.

\import Algebra.Group
\import Algebra.Group.GroupHom
\import Equiv
\import Homotopy.Connectivity
\import Homotopy.EilenbergMacLane.Definition
\import Homotopy.EilenbergMacLane.Loop
\import Homotopy.K1
\import Homotopy.K1.Basic
\import Homotopy.K1.Functor
\import Homotopy.Localization.Truncation
\import Homotopy.Loop
\import Homotopy.Pointed \hiding (base)
\import Homotopy.Pushout
\import Homotopy.Suspension
\import Homotopy.Truncation
\import Logic
\import Paths

\open ->* (∘*, compose-assoc)

\func EM-map.{u} {G H : CGroup.{u}} (n : Nat) (phi : GroupHom G H) : EMSpace G n ->* EMSpace H n \elim n
  | 0 => (phi, phi.func-ide)
  | 1 => K1Map phi
  | suc (suc n) => truncSusp (suc (suc (suc n))) (EM-map (suc n) phi).1
  \where {
    \func truncSusp.{u} (m : Nat) {A B : \Type u} (f : A -> B)
      : Pointed.make {Trunc_-1+ m (Susp A)} (inT north) ->* Pointed.make {Trunc_-1+ m (Susp B)} (inT north)
      => (TruncMap m (Susp.map f), idp)

    \func susp-id {A : \Type} (y : Susp A) : Susp.map (\lam x => x) y = y \elim y
      | north => idp
      | south => idp
      | pglue a i => idp

    \func susp-comp {A B C : \Type} (f : A -> B) (g : B -> C) (y : Susp A)
      : Susp.map (\lam x => g (f x)) y = Susp.map g (Susp.map f y) \elim y
      | north => idp
      | south => idp
      | pglue a i => idp

    \func truncSusp-id.{u} (m : Nat) {A : \Type u} : truncSusp m (\lam (x : A) => x) = ->*.id
      => ->*.ext (trunc-unique (Trunc_-1+.level m (Susp A)) _ (\lam t => t) (\lam y => pmap inT (susp-id y))) idp

    \func truncSusp-comp.{u} (m : Nat) {A B C : \Type u} (f : A -> B) (g : B -> C)
      : truncSusp m (\lam x => g (f x)) = truncSusp m g ∘* truncSusp m f
      => ->*.ext (trunc-unique (Trunc_-1+.level m (Susp C)) _ _ (\lam y => pmap inT (susp-comp f g y))) idp

    \protected \sfunc id.{u} {G : CGroup.{u}} (n : Nat) : EM-map n (GroupHom.id {G}) = ->*.id \elim n
      | 0 => ->*.ext {EMSpace G 0} {EMSpace G 0} (\lam _ => idp) prop-pi
      | 1 => K1Map.id
      | suc (suc n) => pmap (\lam (f : EMSpace G (suc n) ->* EMSpace G (suc n)) => truncSusp (suc (suc (suc n))) f.1) (id (suc n))
                       *> truncSusp-id (suc (suc (suc n)))

    \protected \sfunc comp.{u} {G H L : CGroup.{u}} (n : Nat) (psi : GroupHom H L) (phi : GroupHom G H)
      : EM-map n (psi GroupHom.∘ phi) = EM-map n psi ∘* EM-map n phi \elim n
      | 0 => ->*.ext {EMSpace G 0} {EMSpace L 0} (\lam _ => idp) prop-pi
      | 1 => K1Map.comp psi phi
      | suc (suc n) => pmap (\lam (f : EMSpace G (suc n) ->* EMSpace L (suc n)) => truncSusp (suc (suc (suc n))) f.1) (comp (suc n) psi phi)
                       *> truncSusp-comp (suc (suc (suc n))) (EM-map (suc n) phi).1 (EM-map (suc n) psi).1
  }

\sfunc KMap_loopUnit.{u} {G H : CGroup.{u}} (n : Nat) (phi : GroupHom G H)
  : ->*.compose {EMSpace G n} {Loop (EMSpace G (suc n))} {Loop (EMSpace H (suc n))} (Loop-Func (EM-map (suc n) phi)) (EM-loopUnit n)
    = ->*.compose {EMSpace G n} {EMSpace H n} {Loop (EMSpace H (suc n))} (EM-loopUnit n) (EM-map n phi) \elim n
  | 0 => ->*.ext {EMSpace G 0} {Loop (EMSpace H 1)} (\lam g => idp_*>) (ToProp.fromProp (K1-level base base _ _) _ _)
  | suc n => susp-natural {EMSpace G (suc n)} {EMSpace H (suc n)} {EMSpace G (suc (suc n))} {EMSpace H (suc (suc n))} (EM-map (suc n) phi) (EM-map (suc (suc n)) phi) (EM-susp (suc n)) (EM-susp (suc n)) idp
  \where
    \sfunc susp-natural.{u} {X Y Z W : Pointed.{u}} (f : X ->* Y) (F : Z ->* W)
                            (sX : Susp.pointed X ->* Z) (sY : Susp.pointed Y ->* W)
                            (sq : ->*.compose {Susp.pointed X} {Z} {W} F sX = ->*.compose {Susp.pointed X} {Susp.pointed Y} {W} sY (Susp-Func f))
      : ->*.compose {X} {Loop Z} {Loop W} (Loop-Func F) (->*.compose {X} {Loop (Susp.pointed X)} {Loop Z} (Loop-Func sX) (SuspLoopEquiv.unit X))
        = ->*.compose {X} {Y} {Loop W} (->*.compose {Y} {Loop (Susp.pointed Y)} {Loop W} (Loop-Func sY) (SuspLoopEquiv.unit Y)) f
      => compose-assoc (Loop-Func F) (Loop-Func sX) (SuspLoopEquiv.unit X)
         *> pmap (∘* SuspLoopEquiv.unit X) (inv (Loop-Func-comp F sX) *> pmap Loop-Func sq *> Loop-Func-comp sY (Susp-Func f))
         *> inv (compose-assoc (Loop-Func sY) (Loop-Func (Susp-Func f)) (SuspLoopEquiv.unit X))
         *> pmap (Loop-Func sY ∘*) (SuspLoopEquiv.unit.natural f)
         *> compose-assoc (Loop-Func sY) (SuspLoopEquiv.unit Y) f

\sfunc EM-map_loopInv.{u} {G H : CGroup.{u}} (n : Nat) (phi : GroupHom G H) (z : Loop (EMSpace G (suc n)))
  : (EM-map n phi).1 ((EM-loopInv n).1 z) = (EM-loopInv n).1 ((Loop-Func (EM-map (suc n) phi)).1 z)
  => IsEquiv.isInj (EM-loopUnit-isEquiv n)
      (inv (->*.happly {EMSpace G n} {Loop (EMSpace H (suc n))} (KMap_loopUnit n phi) ((EM-loopInv n).1 z))
       *> pmap (Loop-Func (EM-map (suc n) phi)).1 (EM-loopInv.right n z)
       *> inv (EM-loopInv.right n _))
