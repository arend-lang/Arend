-- | After ``theorems/homotopy/EilenbergMacLane.agda`` in HoTT-Agda.

\import Algebra.Group
\import Algebra.Group.GroupCat
\import Algebra.Group.GroupHom
\import Arith.Nat
\import Category
\import Equiv
\import Homotopy.EilenbergMacLane.Definition
\import Homotopy.EilenbergMacLane.Functor
\import Homotopy.EilenbergMacLane.Loop
\import Homotopy.HomotopyGroup
\import Homotopy.HomotopyGroup.Connectivity
\import Homotopy.HomotopyGroup.PathComparison
\import Homotopy.K1.Basic
\import Homotopy.K1.Functor
\import Homotopy.Loop
\import Homotopy.Pointed
\import Logic
\import Logic.Unique
\import Paths
\import Paths.Meta
\import Set
\open NatOrder (suc<suc)

\lemma EM-pi-below.{u} {G : CGroup.{u}} {n k : Nat} (p : k NatOrder.< n) : Contr (PiSet k (EMSpace G n)) \elim n
  | suc r => pi-vanishes-below (EM-connected r) p

\lemma EM-pi-above.{u} {G : CGroup.{u}} {n k : Nat} (p : n NatOrder.< k) : Contr (PiSet k (EMSpace G n))
  => pi-vanishes-above (EM-level n) (<_suc_<= (suc<suc p))

\func pi0_EM.{u} (G : CGroup.{u}) : QEquiv {PiSet 0 (EMSpace G 0)} {G}
  => Trunc0.setEquiv

\func PiGroup_EM.{u} (G : CGroup.{u}) (n : Nat) : PiGroup_1+ n (EMSpace G (suc n)) = {Group.{u}} G
  => inv (Cat.isotoid iso)
  \where {
    \protected \func hom (n : Nat) : GroupHom G (PiGroup_1+ n (EMSpace G (suc n))) \elim n
      | 0 => PiGroup_K1.hom {G}
      | suc n => PiGroup_LoopShift.hom n (EMSpace G (suc (suc n)))
                   GroupHom.∘ piGroupMap n {EMSpace G (suc n)} {Loop (EMSpace G (suc (suc n)))} (EM-loopUnit (suc n))
                   GroupHom.∘ hom n

    \lemma hom-isEquiv (n : Nat) : IsEquiv (hom n) \elim n
      | 0 => inP PiGroup_K1.hom-equiv
      | suc n => IsEquiv.trans (IsEquiv.trans (hom-isEquiv n) (piMap-isEquiv (suc n) {EMSpace G (suc n)} {Loop (EMSpace G (suc (suc n)))} (EM-loopUnit (suc n)) (EM-loopUnit-isEquiv (suc n))))
                               (Trunc0.map-isEquiv (loop^Shift.isEquiv (suc n) (EMSpace G (suc (suc n)))))

    \protected \func iso : Iso {GroupCat} (hom n)
      => GroupCat.isoOfEquiv (hom n) (IsEquiv.toQEquiv (hom-isEquiv n))
  }

\lemma PiGroup_EM-natural.{u} {G H : CGroup.{u}} (n : Nat) (phi : GroupHom G H)
  : piGroupMap n (EM-map (suc n) phi) GroupHom.∘ PiGroup_EM.hom {G} n = PiGroup_EM.hom {H} n GroupHom.∘ phi \elim n
  | 0 => K1Map.pi_K1Map phi
  | suc n => exts \lam g =>
      \let | F => EM-map (suc (suc n)) phi
           | t => PiGroup_EM.hom {G} n g
           | uG => EM-loopUnit {G} (suc n)
           | uH => EM-loopUnit {H} (suc n)
      \in inv (piMap-loopShift.square {suc n} {EMSpace G (suc (suc n))} {EMSpace H (suc (suc n))} {F} (piMap (suc n) {EMSpace G (suc n)} {Loop (EMSpace G (suc (suc n)))} uG t))
          *> pmap (\lam w => Trunc0.map w (loop^Shift (suc n) (EMSpace H (suc (suc n)))).1)
                  (inv (piMap-comp (suc n) {EMSpace G (suc n)} {Loop (EMSpace G (suc (suc n)))} {Loop (EMSpace H (suc (suc n)))} (Loop-Func {EMSpace G (suc (suc n))} {EMSpace H (suc (suc n))} F) uG t)
                   *> pmap (\lam (h : EMSpace G (suc n) ->* Loop (EMSpace H (suc (suc n)))) => piMap (suc n) {EMSpace G (suc n)} {Loop (EMSpace H (suc (suc n)))} h t) (KMap_loopUnit (suc n) phi)
                   *> piMap-comp (suc n) {EMSpace G (suc n)} {EMSpace H (suc n)} {Loop (EMSpace H (suc (suc n)))} uH (EM-map (suc n) phi) t
                   *> pmap (piMap (suc n) {EMSpace H (suc n)} {Loop (EMSpace H (suc (suc n)))} uH)
                           (pmap (\lam (h : GroupHom G (PiGroup_1+ n (EMSpace H (suc n)))) => h g) (PiGroup_EM-natural n phi)))
