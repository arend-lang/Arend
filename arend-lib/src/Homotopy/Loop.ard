\import Equiv
\import Equiv.Path
\import Equiv.Sigma
\import Function.Iterate
\import Homotopy.HLevel
\import Homotopy.Space
\import Logic
\import Logic.Unique
\import Homotopy.Pointed
\import Homotopy.Pushout
\import Homotopy.Sphere
\import Homotopy.Square
\import Homotopy.Suspension
\import Meta
\import Paths
\import Paths.Meta

\instance Loop (X : Pointed) : Pointed
  | E => base = {X} base
  | base => idp

\func loopMap {A B : \Type} (f : A -> B) {a : A} {b : B} (q : f a = b) (z : a = a) : b = b
  => inv q *> pmap f z *> q
  \where {
    \func idp-case {A B : \Type} (f : A -> B) {a : A} {b : B} (q : f a = b) : loopMap f q idp = idp
      => pmap (inv q *>) idp_*> *> inv_*>

    \lemma isEquiv {A B : \Type} (f : A -> B) {a : A} {b : B} (q : f a = b) (e : IsEquiv f)
      : IsEquiv (loopMap f q) \elim b, q
      | _, idp => transport IsEquiv (inv (path \lam i z => idp_*> {_} {_} {_} {pmap f z} i)) (pmapIsEquiv e)

    \func comp {A B C : \Type} (f : A -> B) {a : A} {b : B} (q : f a = b) (g : B -> C) {c : C} (r : g b = c) (z : a = a)
      : loopMap (\lam x => g (f x)) (pmap g q *> r) z = loopMap g r (loopMap f q z) \elim b, q, c, r
      | _, idp, _, idp => pmap (\lam w => idp *> pmap g w) (inv idp_*>)

    \func comp-coh {A B C : \Type} (f : A -> B) {a : A} {b : B} (q : f a = b) (g : B -> C) {c : C} (r : g b = c)
      : comp f q g r idp *> (pmap (loopMap g r) (idp-case f q) *> idp-case g r) = idp-case (\lam x => g (f x)) (pmap g q *> r) \elim b, q, c, r
      | _, idp, _, idp => idp
  }

\func Loop-Func {X Y : Pointed} (f : X ->* Y) : Loop X ->* Loop Y
  => (loopMap f.1 f.2, loopMap.idp-case f.1 f.2)
  \where
    \protected \lemma isEquiv {X Y : Pointed} (f : X ->* Y) (e : IsEquiv f.1) : IsEquiv (Loop-Func f).1
      => loopMap.isEquiv f.1 f.2 e

\func loopEquiv (e : PointedEquiv) : PointedEquiv (Loop e.X) (Loop e.Y) \cowith
  | map => Loop-Func e.map
  | map-isEquiv => Loop-Func.isEquiv e.map e.map-isEquiv

\func Loop-Func-comp {X Y Z : Pointed} (g : Y ->* Z) (f : X ->* Y)
  : Loop-Func (g ->*.∘* f) = Loop-Func g ->*.∘* Loop-Func f
  => ->*.ext (loopMap.comp f.1 f.2 g.1 g.2) (loopMap.comp-coh f.1 f.2 g.1 g.2)

\func LoopProductMap (X Y : Pointed) : Loop (PointedProduct X Y) ->* PointedProduct (Loop X) (Loop Y)
  => (\lam p => (pmap (\lam t => t.1) p, pmap (\lam t => t.2) p), idp)
  \where \protected {
    \func equiv (X Y : Pointed) : QEquiv (LoopProductMap X Y).1 \cowith
      | ret pq => path (\lam i => (pq.1 @ i, pq.2 @ i))
      | ret_f _ => idp
      | f_sec _ => idp

    \func proj1 (X Y : Pointed)
      : PointedProduct.proj1 ->*.∘* LoopProductMap X Y = Loop-Func (PointedProduct.proj1 {X} {Y})
      => ->*.ext (\lam p => inv idp_*>) idp

    \func proj2 (X Y : Pointed)
      : PointedProduct.proj2 ->*.∘* LoopProductMap X Y = Loop-Func (PointedProduct.proj2 {X} {Y})
      => ->*.ext (\lam p => inv idp_*>) idp
  }

\lemma loop-level {X : \Type}
                  (n : Nat)
                  (p : \Pi (x0 : X) -> (x0 = x0) ofHLevel_-1+ n)
  : X ofHLevel_-1+ suc n
  => \lam x x' => hLevel-inh n (later rewriteI __ (p x))
  \where \protected {
    \func set {X : \Type} (pr : \Pi (x0 : X) -> isSet (x0 = x0)) (x y : X) (p q : x = y) : isProp (p = q) \elim p
      | idp => pr x idp q

    \func prop {X : \Type} (pr : \Pi (x0 : X) -> isProp (x0 = x0)) (x y : X) (p q : x = y) : p = q \elim p
      | idp => pr x idp q
  }

\lemma loop-level-iter.{u} {X : \Type u}
                           (n : Nat)
                           (c : \Pi (x0 : X) -> Contr (iterl {Pointed.{u}} (Loop __) n (\new Pointed X x0)))
  : X ofHLevel_-1+ n \elim n
  | 0 => toProp (isContr'=>isProp c)
  | suc n => \lam x x' => loop-level-iter n (\lam x=x' => Jl (\lam x'' x=x'' => Contr (iterl {Pointed.{u}} (Loop __) n (\new Pointed (x = x'') x=x''))) (c x) x=x')

\lemma loop-level-iter-inv.{u} {X : \Type u} (n : Nat) (h : X ofHLevel_-1+ n) (x0 : X)
  : Contr (iterl {Pointed.{u}} (Loop __) n (\new Pointed X x0)) \elim n
  | 0 => isProp=>isContr (ToProp.fromProp h) x0
  | suc n => loop-level-iter-inv n (h x0 x0) idp

\lemma loop-contr (X : Pointed) (c : Contr X) : Contr (Loop X)
  => isProp=>PathContr X (isContr=>isProp c) base base

-- | The suspension-loop adjunction on pointed maps as an explicit chain of equivalences.
\func SuspLoopQEquiv.{u} (A B : Pointed.{u}) : QEquiv {Susp.pointed A ->* B} {A ->* Loop B} =>
  \let S => Square { | Y => B | U => A | V => \Sigma | X => \Sigma | uv _ => () | ux _ => () } \in
  sigma-left {_} {S} {\lam s => Square.vy {s} () = base} (IsEquiv.toQEquiv (Susp.pushout A).pushout-univ)
  `transQEquiv` (\new QEquiv {\Sigma (s : S) (Square.vy {s} () = base)} {\Sigma (p : \Sigma (b1 : B) (b1 = base)) (\Sigma (b2 : B) (A -> p.1 = b2))} {
    | f p => \let s : Square => p.1 \in ((s.vy (), p.2), (s.xy (), s.sqcomm))
    | ret q => (\new Square { | vy _ => q.1.1 | xy _ => q.2.1 | sqcomm => q.2.2 }, q.1.2)
    | ret_f => idpe
    | f_sec => idpe
  })
  `transQEquiv` contr-left (rsigma base) {\lam p => \Sigma (b2 : B) (A -> p.1 = b2)}
  `transQEquiv` symQEquiv (contr-right (\lam (p : \Sigma (b2 : B) (A -> base = b2)) => lsigma (p.2 base)))
  `transQEquiv` (\new QEquiv {\Sigma (p : \Sigma (b2 : B) (A -> base = b2)) (\Sigma (q : base = p.1) (p.2 base = q))}
                              {\Sigma (p : \Sigma (b2 : B) (base = b2)) (\Sigma (g : A -> base = p.1) (g base = p.2))} {
    | f p => ((p.1.1, p.2.1), (p.1.2, p.2.2))
    | ret q => ((q.1.1, q.2.1), (q.1.2, q.2.2))
    | ret_f => idpe
    | f_sec => idpe
  })
  `transQEquiv` contr-left (lsigma base) {\lam p => \Sigma (g : A -> base = p.1) (g base = p.2)}

\func SuspLoopEquiv.{u} (A B : Pointed.{u}) : (Susp.pointed A ->* B) = (A ->* Loop B)
  => path (QEquiv_= (SuspLoopQEquiv A B))
  \where
    -- | The unit of the adjunction, the HoTT book, Section 8.6.
    \func unit (X : Pointed) : X ->* Loop (Susp.pointed X)
      => (\lam x => pmerid x *> inv (pmerid base), *>_inv)
      \where {
        \func natural.{u} {X Y : Pointed.{u}} (f : X ->* Y)
          : Loop-Func (Susp-Func f) ->*.∘* unit X = unit Y ->*.∘* f
          => ->*.ext (pt f.1 f.2) (coh f.1 f.2)

        \func loopMap_*>-inv {S T : \Type} {n s : S} (G : S -> T) (m1 m2 : n = s)
          : loopMap G idp (m1 *> inv m2) = pmap G m1 *> inv (pmap G m2) \elim s, m2
          | _, idp => idp_*>

        \func pt {X : Pointed} {E : \Type} (g : X -> E) {y : E} (e : g base = y) (x : X)
          : loopMap (Susp.map g) idp (pmerid x *> inv (pmerid base)) = pmerid (g x) *> inv (pmerid y)
          => loopMap_*>-inv (Susp.map g) (pmerid x) (pmerid base)
             *> pmap (\lam w => pmerid (g x) *> inv (pmerid w)) e

        \func coh {X : Pointed} {E : \Type} (g : X -> E) {y : E} (e : g base = y)
          : pt g e base *> (pmap (\lam z => pmerid z *> inv (pmerid y)) e *> *>_inv)
            = pmap (loopMap (Susp.map g) idp) *>_inv *> loopMap.idp-case (Susp.map g) {north} {north} idp
          \elim y, e
          | _, idp => coh-raw (Susp.map g) (pmerid (base {X}))

        \func coh-raw {S T : \Type} {n s : S} (G : S -> T) (m : n = s)
          : loopMap_*>-inv G m m *> (idp *> *>_inv)
            = pmap (loopMap G idp) *>_inv *> loopMap.idp-case G idp \elim s, m
          | _, idp => idp
      }

\func SphereLoopEquiv.{u} (n : Nat) (B : Pointed.{u}) : (Sphere.pointed n ->* B) = iterl {Pointed.{u}} (Loop __) n B \elim n
  | 0 => path (QEquiv_= (sphere0-equiv B))
  | suc n => SuspLoopEquiv (Sphere.pointed n) B *> SphereLoopEquiv n (Loop B)
  \where
    -- | Pointed maps out of the 0-sphere are points.
    \func sphere0-equiv.{u} (B : Pointed.{u}) : QEquiv {Sphere.pointed 0 ->* B} {B} (__.1 south) \cowith
      | ret b => (smap b, idp)
      | ret_f p => ->*.ext {Sphere.pointed 0} (\lam s =>
          \case \elim s \return smap (p.1 south) s = p.1 s \with {
            | pinl _ => inv p.2
            | pinr _ => idp
            | pglue () _
          }) inv_*>
      | f_sec b => idp
      \where
        \func smap {B : Pointed} (b : B) (s : Sphere 0) : B \elim s
          | pinl _ => base
          | pinr _ => b
          | pglue () _

\func Loop-Func-id {X : Pointed} : Loop-Func (->*.id {X}) = ->*.id
  => ->*.ext (\lam z => idp_*>) idp

\func Loop-Func_*> {X Y : Pointed} (f : X ->* Y) (p q : Loop X)
  : (Loop-Func f).1 (p *> q) = (Loop-Func f).1 p *> (Loop-Func f).1 q
  => aux f.1 f.2 p q
  \where
    \private \func aux {X : Pointed} {E : \Type} (f1 : X -> E) {y : E} (f2 : f1 base = y) (p q : base {X} = base)
      : inv f2 *> (pmap f1 (p *> q) *> f2) = (inv f2 *> (pmap f1 p *> f2)) *> (inv f2 *> (pmap f1 q *> f2)) \elim y, f2
      | _, idp => idp_*> *> pmap_*>-comm f1 p q *> inv (pmap2 (*>) idp_*> idp_*>)

\func Loop^.{u} (n : Nat) (X : Pointed.{u}) : Pointed.{u}
  => iterr {Pointed.{u}} (Loop __) n X

\func Loop^-Func.{u} (n : Nat) {X Y : Pointed.{u}} (f : X ->* Y) : Loop^ n X ->* Loop^ n Y \elim n
  | 0 => f
  | suc n => Loop-Func (Loop^-Func n f)
  \where \protected {
    \lemma isEquiv.{u} (n : Nat) {X Y : Pointed.{u}} (f : X ->* Y) (e : IsEquiv f.1) : IsEquiv (Loop^-Func n f).1 \elim n
      | 0 => e
      | suc n => Loop-Func.isEquiv (Loop^-Func n f) (isEquiv n f e)

    \func id.{u} (n : Nat) {X : Pointed.{u}} : Loop^-Func n (->*.id {X}) = ->*.id \elim n
      | 0 => idp
      | suc n => pmap (Loop-Func {Loop^ n X} {Loop^ n X}) (id n) *> Loop-Func-id

    \func comp.{u} (n : Nat) {X Y Z : Pointed.{u}} (g : Y ->* Z) (f : X ->* Y)
      : Loop^-Func n (g ->*.∘* f) = Loop^-Func n g ->*.∘* Loop^-Func n f \elim n
      | 0 => idp
      | suc n => pmap (Loop-Func {Loop^ n X} {Loop^ n Z}) (comp n g f)
                 *> Loop-Func-comp (Loop^-Func n g) (Loop^-Func n f)
  }

\func loop^ProductMap.{u} (n : Nat) (X Y : Pointed.{u})
  : Loop^ n (PointedProduct X Y) ->* PointedProduct (Loop^ n X) (Loop^ n Y) \elim n
  | 0 => ->*.id
  | suc n => LoopProductMap (Loop^ n X) (Loop^ n Y) ->*.∘* Loop-Func (loop^ProductMap n X Y)
  \where \protected {
    \lemma isEquiv.{u} (n : Nat) (X Y : Pointed.{u}) : IsEquiv (loop^ProductMap n X Y).1 \elim n
      | 0 => inP idEquiv
      | suc n => IsEquiv.trans (Loop-Func.isEquiv (loop^ProductMap n X Y) (isEquiv n X Y))
                               (inP (LoopProductMap.equiv (Loop^ n X) (Loop^ n Y)))

    \func proj1.{u} (n : Nat) (X Y : Pointed.{u})
      : PointedProduct.proj1 ->*.∘* loop^ProductMap n X Y = Loop^-Func.{u} n PointedProduct.proj1 \elim n
      | 0 => idp
      | suc n => ->*.compose-assoc PointedProduct.proj1 (LoopProductMap (Loop^ n X) (Loop^ n Y)) (Loop-Func (loop^ProductMap n X Y))
                 *> pmap (\lam h => h ->*.∘* Loop-Func (loop^ProductMap n X Y)) (LoopProductMap.proj1 (Loop^ n X) (Loop^ n Y))
                 *> inv (Loop-Func-comp PointedProduct.proj1 (loop^ProductMap n X Y))
                 *> pmap Loop-Func (proj1 n X Y)

    \func proj2.{u} (n : Nat) (X Y : Pointed.{u})
      : PointedProduct.proj2 ->*.∘* loop^ProductMap n X Y = Loop^-Func.{u} n PointedProduct.proj2 \elim n
      | 0 => idp
      | suc n => ->*.compose-assoc PointedProduct.proj2 (LoopProductMap (Loop^ n X) (Loop^ n Y)) (Loop-Func (loop^ProductMap n X Y))
                 *> pmap (\lam h => h ->*.∘* Loop-Func (loop^ProductMap n X Y)) (LoopProductMap.proj2 (Loop^ n X) (Loop^ n Y))
                 *> inv (Loop-Func-comp PointedProduct.proj2 (loop^ProductMap n X Y))
                 *> pmap Loop-Func (proj2 n X Y)
  }

\func loop^LoopShift.{u} (n : Nat) (X : Pointed.{u}) : Loop^ n (Loop X) = Loop^ (suc n) X
  => iterr-step (Loop __) n X

\func loop^Shift.{u} (n : Nat) (X : Pointed.{u}) : Loop^ n (Loop X) ->* Loop^ (suc n) X \elim n
  | 0 => ->*.id
  | suc n => Loop-Func (loop^Shift n X)
  \where {
    \lemma isEquiv.{u} (n : Nat) (X : Pointed.{u}) : IsEquiv (loop^Shift n X).1 \elim n
      | 0 => inP idEquiv
      | suc n => Loop-Func.isEquiv (loop^Shift n X) (isEquiv n X)

    \func natural.{u} (n : Nat) {X Y : Pointed.{u}} (f : X ->* Y)
      : loop^Shift n Y ->*.∘* Loop^-Func n {Loop X} {Loop Y} (Loop-Func f)
        = Loop^-Func (suc n) f ->*.∘* loop^Shift n X \elim n
      | 0 => inv (->*.compose-id (Loop-Func f))
      | suc n =>
        inv (Loop-Func-comp (loop^Shift n Y) (Loop^-Func n {Loop X} {Loop Y} (Loop-Func f)))
        *> pmap (Loop-Func {Loop^ n (Loop X)} {Loop^ (suc n) Y}) (natural n f)
        *> Loop-Func-comp (Loop^-Func (suc n) f) (loop^Shift n X)
  }

\func loop^ShiftEquiv.{u} (n : Nat) (X : Pointed.{u})
  : PointedEquiv (Loop^ n (Loop X)) (Loop^ (suc n) X) \cowith
  | map => loop^Shift n X
  | map-isEquiv => loop^Shift.isEquiv n X

\func loop^ShiftInv.{u} (n : Nat) (X : Pointed.{u}) : Loop^ (suc n) X ->* Loop^ n (Loop X)
  => PointedEquiv.map {PointedEquiv.inverse (loop^ShiftEquiv n X)}
  \where {
    \lemma isEquiv.{u} (n : Nat) (X : Pointed.{u}) : IsEquiv (loop^ShiftInv n X).1
      => PointedEquiv.map-isEquiv {PointedEquiv.inverse (loop^ShiftEquiv n X)}

    \func left.{u} (n : Nat) (X : Pointed.{u}) (z : Loop^ n (Loop X))
      : (loop^ShiftInv n X).1 ((loop^Shift n X).1 z) = z
      => Section.ret_f {PointedEquiv.toHAEquiv (loop^ShiftEquiv n X)} z

    \func right.{u} (n : Nat) (X : Pointed.{u}) (c : Loop^ (suc n) X)
      : (loop^Shift n X).1 ((loop^ShiftInv n X).1 c) = c
      => Retraction.f_sec {PointedEquiv.toHAEquiv (loop^ShiftEquiv n X)} c

    \func concat.{u} (n : Nat) (X : Pointed.{u}) (u v : Loop^ (suc (suc n)) X)
      : (loop^ShiftInv (suc n) X).1 (u *> v)
        = (loop^ShiftInv (suc n) X).1 u *> (loop^ShiftInv (suc n) X).1 v
      => IsEquiv.isInj (loop^Shift.isEquiv (suc n) X)
          (right (suc n) X (u *> v)
           *> inv (Loop-Func_*> (loop^Shift n X) _ _
                   *> pmap2 (*>) (right (suc n) X u) (right (suc n) X v)))
  }

\func loopSphere.{u} (n : Nat) (X : Pointed.{u}) : (Sphere.pointed n ->* X) = Loop^ n X
  => SphereLoopEquiv n X *> pmap (BaseSpace.E {__}) (iterl=iterr {Pointed.{u}} (Loop __) n X)

-- | Loops in a pointed mapping space are pointed maps into the loop space.
\func loopPointedMap {A B : Pointed} : PointedEquiv (Loop (PointedMap A B)) (PointedMap A (Loop B)) \cowith
  | map => (\lam s => (->*.happly s, ->*.happly-base s), idp)
  | map-isEquiv => ->*.happly-equiv

-- | The suspension-loop adjunction as a pointed equivalence of pointed mapping spaces.
\func suspLoopPointed.{u} {A B : Pointed.{u}} : PointedEquiv (PointedMap (Susp.pointed A) B) (PointedMap A (Loop B)) \cowith
  | map => (SuspLoopQEquiv A B, idp)
  | map-isEquiv => inP (SuspLoopQEquiv A B)