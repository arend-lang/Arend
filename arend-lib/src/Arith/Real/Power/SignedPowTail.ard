{- | The tails $\varphi^{(a)}(t) = \varphi_r(t) - \varphi_r(c_a(t))$ of the signed power $\varphi_r(t) = t|t|^{r-2}$, $r > 1$,
  where $c_a$ is the clamp to $[-a,a]$ ({clampSym}).

  $\varphi^{(a)}$ vanishes on $[-a,a]$, so it is linearly bounded near `0` for every $r > 1$, and $\varphi^{(a)} \to \varphi_r$ as
  $a \to 0$ with $|\varphi_r - \varphi^{(a)}| \le a^{r-1}$. All estimates below hold for every $r > 1$, with conjugate exponent $r'$.

  * {signedPowTail}, {signedPowTail-in}, {signedPowTail-nonneg}, {signedPowTail-odd}.
  * {signedPowTail-cauchy}: $|\varphi^{(a)}(t) - \varphi^{(b)}(t)|^{r'} \le d^{r-1} (|t| \wedge d)$ for $a, b \le d$.
  * {signedPowTail-mul}: $\bigl|t \varphi^{(a)}(t) - |t|^r\bigr| \le a^{r-1} |t|$.
  * {signedPowTail-conj}: $0 \le |t|^r - |\varphi^{(a)}(t)|^{r'} \le r' a^{r-1} |t|$.
  * {signedPowTail-tangent}: $|x|^r + r \varphi^{(a)}(x) (y - x) \le |y|^r + r a^{r-1} |y - x|$.
-}

\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Arith.Rat
\import Arith.Real
\import Arith.Real.Field
\import Arith.Real.Power
\import Arith.Real.Power.PowerIneq
\import Arith.Real.Power.SignedPow
\import Arith.Real.Power.UniformConvexity
\import Arith.Real.UpperReal
\import Topology.CoverSpace.Complete
\import Topology.NormedAbGroup.Real
\import Topology.NormedAbGroup.Real.Interval
\import Logic
\import Logic.Meta
\import Meta
\import Order.Biordered
\import Order.Lattice
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\open signedPow

-- | $\varphi^{(a)}(t) = \varphi_r(t) - \varphi_r(c_a(t))$.
\func signedPowTail {r : Real} (r>1 : (1 : Real) < r) (a t : Real) : Real
  => signedPow r>1 t - signedPow r>1 (clampSym a t)

\lemma clampSym-nonneg {a t : Real} (a>=0 : (0 : Real) <= a) (t>=0 : (0 : Real) <= t) : clampSym a t = t ∧ a
  => RealAbGroup.join-comm *> RealAbGroup.join_<= (linarith (meet-univ t>=0 a>=0 : (0 : Real) <= t ∧ a))

\lemma clampSym-nonpos {a t : Real} (a>=0 : (0 : Real) <= a) (t<=0 : t <= 0) : clampSym a t = negative (negative t ∧ a)
  => pmap (\lam u => u ∨ negative a) (RealAbGroup.meet_<= (t<=0 <=∘ a>=0)) *> inv (RealAbGroup.meet_negative *> pmap (\lam u => u ∨ negative a) RealAbGroup.negative-isInv)

-- | $\varphi^{(a)}(t) = t^{r-1} - (t \wedge a)^{r-1}$ for $t \ge 0$.
\lemma signedPowTail-nonneg {r : Real} {r>1 : (1 : Real) < r} {a t : Real} (a>=0 : (0 : Real) <= a) (t>=0 : (0 : Real) <= t)
  : signedPowTail r>1 a t = rpow t t>=0 (r - 1) (sub1>0 r>1) - rpow (t ∧ a) (meet-univ t>=0 a>=0) (r - 1) (sub1>0 r>1)
  => pmap2 (-) (nonneg t>=0) (pmap (signedPow r>1) (clampSym-nonneg a>=0 t>=0) *> nonneg (meet-univ t>=0 a>=0))

-- | $\varphi^{(a)}(t) = -(s^{r-1} - (s \wedge a)^{r-1})$ for $t = -s \le 0$.
\lemma signedPowTail-nonpos {r : Real} {r>1 : (1 : Real) < r} {a t : Real} (a>=0 : (0 : Real) <= a) (t<=0 : t <= 0) {s>=0 : (0 : Real) <= negative t}
  : signedPowTail r>1 a t = negative (rpow (negative t) s>=0 (r - 1) (sub1>0 r>1) - rpow (negative t ∧ a) (meet-univ s>=0 a>=0) (r - 1) (sub1>0 r>1))
  => \have | m>=0 : (0 : Real) <= negative t ∧ a => meet-univ s>=0 a>=0
           | e1 : signedPow r>1 t = negative (rpow (negative t) s>=0 (r - 1) (sub1>0 r>1)) => nonpos t<=0
           | e2 : signedPow r>1 (clampSym a t) = negative (rpow (negative t ∧ a) m>=0 (r - 1) (sub1>0 r>1))
               => pmap (signedPow r>1) (clampSym-nonpos a>=0 t<=0) *> nonpos (linarith : negative (negative t ∧ a) <= 0) {transportInv ((0 : Real) <=) RealAbGroup.negative-isInv m>=0}
                  *> pmap negative (rpow-base RealAbGroup.negative-isInv)
     \in pmap2 (\lam (u v : Real) => u - v) e1 e2 *> equation.abGroup

\private \module TailHelpers \where {
  -- | $(m^{r-1})^{r'} = m^r \le d^{r-1} m$ for $0 \le m \le d$.
  \lemma pow-conj-le {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {q : Real} {q>0 : (0 : Real) < q}
                     (rq : HolderConjugate r q r>0 q>0) {m d : Real} {m>=0 : (0 : Real) <= m} {d>0 : (0 : Real) < d} (m<=d : m <= d)
    : rpow (rpow m m>=0 (r - 1) (sub1>0 r>1)) rpow>=0 q q>0 <= rpow-pos d d>0 (r - 1) * m
    => =_<= (rpow-rpow {m} {m>=0} {r - 1} {q} {sub1>0 r>1} {q>0} {_} {RealField.<_*_positive_positive (sub1>0 r>1) q>0} *> rpow-exp (signedPow-conj.conj-exp rq)
             *> rpow-exp (equation.cRing : r = (r - 1) + (1 : Real)) *> rpow_+ {m} {m>=0} {r - 1} {1} {sub1>0 r>1} {RealField.zro<ide} *> pmap (_ *) rpow-one)
        <=∘ <=_*_positive-left (rpow-mono {m} {d} {m>=0} {<=-less d>0} m<=d <=∘ =_<= (rpow-pos-eq d>0)) m>=0

  -- | $|v - u| \le M$ for $0 \le u, v \le M$.
  \lemma abs-diff-le {u v M : Real} (u>=0 : (0 : Real) <= u) (v>=0 : (0 : Real) <= v) (uM : u <= M) (vM : v <= M) : RealAbGroup.abs (v - u) <= M
    => join-univ (linarith : v - u <= M) (linarith : negative (v - u) <= M)

  \lemma meet-mono {s a d : Real} (a<=d : a <= d) : s ∧ a <= s ∧ d
    => meet-univ meet-left (meet-right <=∘ a<=d)
}

-- | $|\varphi^{(a)}(t) - \varphi^{(b)}(t)|^{r'} \le d^{r-1} (|t| \wedge d)$ for $0 \le a, b \le d$.
\lemma signedPowTail-cauchy {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {q : Real} {q>0 : (0 : Real) < q}
                            (rq : HolderConjugate r q r>0 q>0) {d : Real} (d>0 : (0 : Real) < d) {a b : Real}
                            (a>=0 : (0 : Real) <= a) (b>=0 : (0 : Real) <= b) (a<=d : a <= d) (b<=d : b <= d) (t : Real)
  : rpow (RealAbGroup.abs (signedPowTail r>1 a t - signedPowTail r>1 b t)) RealAbGroup.abs>=0 q q>0 <= rpow-pos d d>0 (r - 1) * (RealAbGroup.abs t ∧ d)
  => sign-cases' {t}
      (\lam t>=0 => \have e : signedPowTail r>1 a t - signedPowTail r>1 b t
                            = rpow (t ∧ b) (meet-univ t>=0 b>=0) (r - 1) (sub1>0 r>1) - rpow (t ∧ a) (meet-univ t>=0 a>=0) (r - 1) (sub1>0 r>1)
                        => pmap2 (\lam (u v : Real) => u - v) (signedPowTail-nonneg a>=0 t>=0) (signedPowTail-nonneg b>=0 t>=0) *> equation.abGroup
                    \in transportInv (\lam z => _ <= rpow-pos d d>0 (r - 1) * (z ∧ d)) (RealAbGroup.abs-ofPos t>=0)
                          (core rq d>0 a>=0 b>=0 a<=d b<=d t>=0 (pmap RealAbGroup.abs e)))
      (\lam t<=0 => \have | s>=0 : (0 : Real) <= negative t => linarith
                          | e : signedPowTail r>1 a t - signedPowTail r>1 b t
                              = negative (rpow (negative t ∧ b) (meet-univ s>=0 b>=0) (r - 1) (sub1>0 r>1) - rpow (negative t ∧ a) (meet-univ s>=0 a>=0) (r - 1) (sub1>0 r>1))
                              => pmap2 (\lam (u v : Real) => u - v) (signedPowTail-nonpos {r} {r>1} a>=0 t<=0 {s>=0}) (signedPowTail-nonpos {r} {r>1} b>=0 t<=0 {s>=0}) *> equation.abGroup
                    \in transportInv (\lam z => _ <= rpow-pos d d>0 (r - 1) * (z ∧ d)) (RealAbGroup.abs-ofNeg t<=0)
                          (core rq d>0 a>=0 b>=0 a<=d b<=d s>=0 (pmap RealAbGroup.abs e *> RealAbGroup.abs_negative)))
  \where {
    \lemma sign-cases' {t x y : Real} (pos : (0 : Real) <= t -> x <= y) (neg : t <= 0 -> x <= y) : x <= y
      => real-cases {t} {0} (\lam t<0 => neg (<=-less t<0)) pos

    \lemma core {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {q : Real} {q>0 : (0 : Real) < q}
                (rq : HolderConjugate r q r>0 q>0) {d : Real} (d>0 : (0 : Real) < d) {a b : Real}
                (a>=0 : (0 : Real) <= a) (b>=0 : (0 : Real) <= b) (a<=d : a <= d) (b<=d : b <= d) {s : Real} (s>=0 : (0 : Real) <= s) {D : Real}
                (De : RealAbGroup.abs D = RealAbGroup.abs (rpow (s ∧ b) (meet-univ s>=0 b>=0) (r - 1) (sub1>0 r>1) - rpow (s ∧ a) (meet-univ s>=0 a>=0) (r - 1) (sub1>0 r>1)))
      : rpow (RealAbGroup.abs D) RealAbGroup.abs>=0 q q>0 <= rpow-pos d d>0 (r - 1) * (s ∧ d)
      => \have | m>=0 : (0 : Real) <= s ∧ d => meet-univ s>=0 (<=-less d>0)
               | uM : rpow (s ∧ a) (meet-univ s>=0 a>=0) (r - 1) (sub1>0 r>1) <= rpow (s ∧ d) m>=0 (r - 1) (sub1>0 r>1) => rpow-mono (TailHelpers.meet-mono a<=d)
               | vM : rpow (s ∧ b) (meet-univ s>=0 b>=0) (r - 1) (sub1>0 r>1) <= rpow (s ∧ d) m>=0 (r - 1) (sub1>0 r>1) => rpow-mono (TailHelpers.meet-mono b<=d)
               | dM : RealAbGroup.abs D <= rpow (s ∧ d) m>=0 (r - 1) (sub1>0 r>1) => =_<= De <=∘ TailHelpers.abs-diff-le rpow>=0 rpow>=0 uM vM
         \in rpow-mono {_} {_} {RealAbGroup.abs>=0} {rpow>=0} dM <=∘ TailHelpers.pow-conj-le rq meet-right
  }

-- | $|c_a(t)| \le a$.
\lemma clampSym-abs {a t : Real} (a>=0 : (0 : Real) <= a) : RealAbGroup.abs (clampSym a t) <= a
  => \have j : negative a <= (t ∧ a) ∨ negative a => join-right
     \in join-univ (join-univ meet-right (linarith : negative a <= a)) (linarith : negative ((t ∧ a) ∨ negative a) <= a)

-- | $|\varphi_r(c_a(t))| \le a^{r-1}$.
\lemma signedPow-clamp-bound {r : Real} {r>1 : (1 : Real) < r} {a : Real} (a>0 : (0 : Real) < a) {t : Real}
  : RealAbGroup.abs (signedPow r>1 (clampSym a t)) <= rpow-pos a a>0 (r - 1)
  => =_<= signedPow-abs <=∘ rpow-mono {_} {a} {RealAbGroup.abs>=0} {<=-less a>0} (clampSym-abs (<=-less a>0)) <=∘ =_<= (rpow-pos-eq a>0)

-- | $\bigl|t \varphi^{(a)}(t) - |t|^r\bigr| \le a^{r-1} |t|$.
\lemma signedPowTail-mul {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {a : Real} (a>0 : (0 : Real) < a) {t : Real}
  : RealAbGroup.abs (t * signedPowTail r>1 a t - rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 r r>0) <= rpow-pos a a>0 (r - 1) * RealAbGroup.abs t
  => \have | e : t * signedPowTail r>1 a t - rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 r r>0 = negative (t * signedPow r>1 (clampSym a t))
               => pmap (\lam u => t * signedPowTail r>1 a t - u) (inv signedPow-mul) *> equation.cRing
           | b => signedPow-clamp-bound {r} {r>1} a>0 {t}
     \in =_<= (pmap RealAbGroup.abs e *> RealAbGroup.abs_negative *> RealField.abs_* *> RealField.*-comm)
          <=∘ <=_*_positive-left b RealAbGroup.abs>=0

-- | $|x|^r + r \varphi^{(a)}(x) (y - x) \le |y|^r + r a^{r-1} |y - x|$.
\lemma signedPowTail-tangent {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {a : Real} (a>0 : (0 : Real) < a) (x y : Real)
  : rpow (RealAbGroup.abs x) RealAbGroup.abs>=0 r r>0 + r * signedPowTail r>1 a x * (y - x)
      <= rpow (RealAbGroup.abs y) RealAbGroup.abs>=0 r r>0 + r * rpow-pos a a>0 (r - 1) * RealAbGroup.abs (y - x)
  => \let c => signedPow r>1 (clampSym a x)
     \in \have | t => absPow-tangent {r} {r>0} r>1 x y
           | b : negative (c * (y - x)) <= rpow-pos a a>0 (r - 1) * RealAbGroup.abs (y - x)
               => RealAbGroup.abs>=neg <=∘ =_<= RealField.abs_* <=∘ <=_*_positive-left (signedPow-clamp-bound a>0) RealAbGroup.abs>=0
           | rb : r * negative (c * (y - x)) <= r * (rpow-pos a a>0 (r - 1) * RealAbGroup.abs (y - x)) => <=_*_positive-right (<=-less r>0) b
           | e1 : r * signedPowTail r>1 a x * (y - x) = r * signedPow r>1 x * (y - x) + r * negative (c * (y - x)) => equation.cRing
           | e2 : r * (rpow-pos a a>0 (r - 1) * RealAbGroup.abs (y - x)) = r * rpow-pos a a>0 (r - 1) * RealAbGroup.abs (y - x) => equation.cRing
     \in linarith

-- | The conjugate exponent of `r > 1` is `> 1`.
\lemma conj>1 {r : Real} {r>0 : (0 : Real) < r} {q : Real} {q>0 : (0 : Real) < q} (r>1 : (1 : Real) < r) (rq : HolderConjugate r q r>0 q>0)
  : (1 : Real) < q
  => \have | pr>0 : (0 : Real) < RealField.pinv r r>0 => RealField.pinv>0 r>0
           | pq<1 : RealField.pinv q q>0 < (1 : Real) => linarith
           | e : q * RealField.pinv q q>0 = (1 : Real) => RealField.pinv-right q>0
           | m : q * RealField.pinv q q>0 < q * 1 => RealField.<_*_positive-right q>0 pq<1
     \in transport2 (<) e RealField.ide-right m

-- | $|\varphi^{(a)}(t)|^{r'} \le |t|^r \le |\varphi^{(a)}(t)|^{r'} + r' a^{r-1} |t|$.
\lemma signedPowTail-conj {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {q : Real} {q>0 : (0 : Real) < q}
                          (rq : HolderConjugate r q r>0 q>0) {a : Real} (a>0 : (0 : Real) < a) (t : Real)
  : \Sigma (rpow (RealAbGroup.abs (signedPowTail r>1 a t)) RealAbGroup.abs>=0 q q>0 <= rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 r r>0)
           (rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 r r>0 <= rpow (RealAbGroup.abs (signedPowTail r>1 a t)) RealAbGroup.abs>=0 q q>0 + q * rpow-pos a a>0 (r - 1) * RealAbGroup.abs t)
  => (signedPowTail-cauchy.sign-cases' {t} (\lam t>=0 => (pos {r} {r>1} {r>0} {q} {q>0} {rq} {a} {a>0} t>=0).1) (\lam t<=0 => (neg {r} {r>1} {r>0} {q} {q>0} {rq} {a} {a>0} t<=0).1),
      signedPowTail-cauchy.sign-cases' {t} (\lam t>=0 => (pos {r} {r>1} {r>0} {q} {q>0} {rq} {a} {a>0} t>=0).2) (\lam t<=0 => (neg {r} {r>1} {r>0} {q} {q>0} {rq} {a} {a>0} t<=0).2))
  \where \protected {
    \lemma pos {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {q : Real} {q>0 : (0 : Real) < q}
               {rq : HolderConjugate r q r>0 q>0} {a : Real} {a>0 : (0 : Real) < a} {t : Real} (t>=0 : (0 : Real) <= t)
      : \Sigma (rpow (RealAbGroup.abs (signedPowTail r>1 a t)) RealAbGroup.abs>=0 q q>0 <= rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 r r>0)
               (rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 r r>0 <= rpow (RealAbGroup.abs (signedPowTail r>1 a t)) RealAbGroup.abs>=0 q q>0 + q * rpow-pos a a>0 (r - 1) * RealAbGroup.abs t)
      => \have | c => core rq a>0 t>=0 (pmap RealAbGroup.abs (signedPowTail-nonneg (<=-less a>0) t>=0) *> RealAbGroup.abs-ofPos (linarith (rpow-mono {t ∧ a} {t} {meet-univ t>=0 (<=-less a>0)} {t>=0} {r - 1} {sub1>0 r>1} meet-left)))
               | e : rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 r r>0 = rpow t t>=0 r r>0 => rpow-base (RealAbGroup.abs-ofPos t>=0)
               | et : RealAbGroup.abs t = t => RealAbGroup.abs-ofPos t>=0
         \in (c.1 <=∘ =_<= (inv e), =_<= e <=∘ c.2 <=∘ =_<= (pmap (\lam z => _ + q * rpow-pos a a>0 (r - 1) * z) (inv et)))

    \lemma neg {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {q : Real} {q>0 : (0 : Real) < q}
               {rq : HolderConjugate r q r>0 q>0} {a : Real} {a>0 : (0 : Real) < a} {t : Real} (t<=0 : t <= 0)
      : \Sigma (rpow (RealAbGroup.abs (signedPowTail r>1 a t)) RealAbGroup.abs>=0 q q>0 <= rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 r r>0)
               (rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 r r>0 <= rpow (RealAbGroup.abs (signedPowTail r>1 a t)) RealAbGroup.abs>=0 q q>0 + q * rpow-pos a a>0 (r - 1) * RealAbGroup.abs t)
      => \have | s>=0 : (0 : Real) <= negative t => linarith
               | c => core rq a>0 s>=0 (pmap RealAbGroup.abs (signedPowTail-nonpos {r} {r>1} (<=-less a>0) t<=0 {s>=0}) *> RealAbGroup.abs_negative
                                          *> RealAbGroup.abs-ofPos (linarith (rpow-mono {negative t ∧ a} {negative t} {meet-univ s>=0 (<=-less a>0)} {s>=0} {r - 1} {sub1>0 r>1} meet-left)))
               | e : rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 r r>0 = rpow (negative t) s>=0 r r>0 => rpow-base (RealAbGroup.abs-ofNeg t<=0)
               | et : RealAbGroup.abs t = negative t => RealAbGroup.abs-ofNeg t<=0
         \in (c.1 <=∘ =_<= (inv e), =_<= e <=∘ c.2 <=∘ =_<= (pmap (\lam z => _ + q * rpow-pos a a>0 (r - 1) * z) (inv et)))

    \lemma core {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {q : Real} {q>0 : (0 : Real) < q}
                (rq : HolderConjugate r q r>0 q>0) {a : Real} (a>0 : (0 : Real) < a) {s : Real} (s>=0 : (0 : Real) <= s) {D : Real}
                (De : RealAbGroup.abs D = rpow s s>=0 (r - 1) (sub1>0 r>1) - rpow (s ∧ a) (meet-univ s>=0 (<=-less a>0)) (r - 1) (sub1>0 r>1))
      : \Sigma (rpow (RealAbGroup.abs D) RealAbGroup.abs>=0 q q>0 <= rpow s s>=0 r r>0)
               (rpow s s>=0 r r>0 <= rpow (RealAbGroup.abs D) RealAbGroup.abs>=0 q q>0 + q * rpow-pos a a>0 (r - 1) * s)
      => \let | x => rpow s s>=0 (r - 1) (sub1>0 r>1)
              | m => rpow (s ∧ a) (meet-univ s>=0 (<=-less a>0)) (r - 1) (sub1>0 r>1)
         \in \have | q>1 : (1 : Real) < q => conj>1 r>1 rq
                   | m<=x : m <= x => rpow-mono meet-left
                   | m>=0 : (0 : Real) <= m => rpow>=0
                   | m<=a : m <= rpow-pos a a>0 (r - 1) => rpow-mono {_} {a} {_} {<=-less a>0} meet-right <=∘ =_<= (rpow-pos-eq a>0)
                   | x>=0 : (0 : Real) <= x => rpow>=0
                   | xq : rpow x x>=0 q q>0 = rpow s s>=0 r r>0
                       => rpow-rpow {s} {s>=0} {r - 1} {q} {sub1>0 r>1} {q>0} {_} {RealField.<_*_positive_positive (sub1>0 r>1) q>0} *> rpow-exp (signedPow-conj.conj-exp rq)
                   | ce : (r - 1) * (q - 1) = (1 : Real) => \have c => signedPow-conj.conj-exp rq \in equation.cRing {c}
                   | phx : signedPow q>1 x = s
                       => nonneg x>=0 *> rpow-rpow {s} {s>=0} {r - 1} {q - 1} {sub1>0 r>1} {sub1>0 q>1} {_} {RealField.<_*_positive_positive (sub1>0 r>1) (sub1>0 q>1)} *> rpow-exp ce *> rpow-one
                   | eD : rpow (RealAbGroup.abs D) RealAbGroup.abs>=0 q q>0 = rpow (RealAbGroup.abs (x - m)) RealAbGroup.abs>=0 q q>0
                       => rpow-base (De *> inv (RealAbGroup.abs-ofPos (linarith : (0 : Real) <= x - m)))
                   | ex : rpow (RealAbGroup.abs x) RealAbGroup.abs>=0 q q>0 = rpow s s>=0 r r>0 => rpow-base (RealAbGroup.abs-ofPos x>=0) *> xq
                   | tg => absPow-tangent {q} {q>0} q>1 x (x - m)
                   | tq : q * s * m <= q * rpow-pos a a>0 (r - 1) * s
                       => =_<= (equation.cRing : q * s * m = q * (s * m)) <=∘ <=_*_positive-right (<=-less q>0) (=_<= RealField.*-comm <=∘ <=_*_positive-left m<=a s>=0) <=∘ =_<= (equation.cRing : q * (rpow-pos a a>0 (r - 1) * s) = q * rpow-pos a a>0 (r - 1) * s)
                   | e3 : q * signedPow q>1 x * (x - m - x) = negative (q * s * m) => rewrite phx equation.cRing
         \in (=_<= eD <=∘ rpow-mono (=_<= (RealAbGroup.abs-ofPos (linarith : (0 : Real) <= x - m)) <=∘ (linarith : x - m <= x)) <=∘ =_<= xq,
              =_<= (inv ex) <=∘ (linarith : rpow (RealAbGroup.abs x) RealAbGroup.abs>=0 q q>0 <= rpow (RealAbGroup.abs (x - m)) RealAbGroup.abs>=0 q q>0 + q * s * m)
                <=∘ <=_+ (=_<= (inv eD)) tq)
  }

-- | $\varphi_r(\lambda z) = \lambda^{r-1} \varphi_r(z)$ for $\lambda > 0$.
\lemma signedPow-homog {r : Real} {r>1 : (1 : Real) < r} {l : Real} (l>0 : (0 : Real) < l) {z : Real}
  : signedPow r>1 (l * z) = rpow-pos l l>0 (r - 1) * signedPow r>1 z
  => sign-cases-eq {z}
      (\lam z>=0 => \have lz>=0 : (0 : Real) <= l * z => RealField.<=_*_positive_positive (<=-less l>0) z>=0
                    \in nonneg lz>=0 *> rpow_* {l} {z} {<=-less l>0} {z>=0} *> pmap2 (*) (rpow-pos-eq l>0) (inv (nonneg z>=0)))
      (\lam z<=0 => \have | s>=0 : (0 : Real) <= negative z => linarith
                          | lz<=0 : l * z <= 0 => transport (_ <=) RealField.zro_*-right (<=_*_positive-right (<=-less l>0) z<=0)
                          | e : negative (l * z) = l * negative z => equation.cRing
                          | ls>=0 : (0 : Real) <= l * negative z => RealField.<=_*_positive_positive (<=-less l>0) s>=0
                    \in nonpos lz<=0 {transportInv ((0 : Real) <=) e ls>=0} *> pmap negative (rpow-base e *> rpow_* {l} {negative z} {<=-less l>0} {s>=0} *> pmap (\lam u => u * _) (rpow-pos-eq l>0))
                          *> inv (pmap (_ *) (nonpos z<=0 {s>=0}) *> equation.cRing))

\lemma two>0 : (0 : Real) < 2
  => linarith

-- | $(|x| + |y|)^r \le 2^r (|x|^r + |y|^r)/2$ for $r \ge 1$.
\lemma rpow-sum-le {r : Real} {r>0 : (0 : Real) < r} (r>1 : (1 : Real) < r) {x y : Real} {s>=0 : (0 : Real) <= x + y} (x>=0 : (0 : Real) <= x) (y>=0 : (0 : Real) <= y)
  : rpow (x + y) s>=0 r r>0 <= rpow-pos 2 two>0 r * (Real.fromRat (ratio 1 2) * (rpow x x>=0 r r>0 + rpow y y>=0 r r>0))
  => \have | hh2 : (2 : Real) * Real.fromRat (ratio 1 2) = (1 : Real) => RealField.*-rat *> idp
           | e2 : x + y = (2 : Real) * (Real.fromRat (ratio 1 2) * (x + y)) => inv (inv RealField.*-assoc *> pmap (\lam t => t * (x + y)) hh2 *> RealField.ide-left)
           | ea {z : Real} (z>=0 : (0 : Real) <= z) : powAbs r r>0 z = rpow z z>=0 r r>0 => unfold powAbs (rpow-base (RealAbGroup.abs-ofPos z>=0))
           | c => AbsPowLemmas.conv-mid {r} {r>0} r>1 {x} {y}
     \in =_<= (inv (ea s>=0) *> pmap (powAbs r r>0) e2 *> AbsPowLemmas.scale two>0)
          <=∘ <=_*_positive-right (<=-less rpow-pos>0) c <=∘ =_<= (pmap (\lam t => _ * (Real.fromRat (ratio 1 2) * t)) (pmap2 (+) (ea x>=0) (ea y>=0)))

-- | $|\varphi_r(x) - \varphi_r(y)|^{r'} \le 2^{r'} (|x| + |y|)^r$.
\lemma signedPow-diff-far {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {q : Real} {q>0 : (0 : Real) < q}
                          (rq : HolderConjugate r q r>0 q>0) {x y : Real} {M>=0 : (0 : Real) <= RealAbGroup.abs x + RealAbGroup.abs y}
  : rpow (RealAbGroup.abs (signedPow r>1 x - signedPow r>1 y)) RealAbGroup.abs>=0 q q>0 <= rpow-pos 2 two>0 q * rpow (RealAbGroup.abs x + RealAbGroup.abs y) M>=0 r r>0
  => \let M => RealAbGroup.abs x + RealAbGroup.abs y
     \in \have | P>=0 : (0 : Real) <= rpow M M>=0 (r - 1) (sub1>0 r>1) => rpow>=0
               | bx : RealAbGroup.abs (signedPow r>1 x) <= rpow M M>=0 (r - 1) (sub1>0 r>1) => =_<= signedPow-abs <=∘ rpow-mono (linarith (RealAbGroup.abs>=0 {y}))
               | by' : RealAbGroup.abs (signedPow r>1 y) <= rpow M M>=0 (r - 1) (sub1>0 r>1) => =_<= signedPow-abs <=∘ rpow-mono (linarith (RealAbGroup.abs>=0 {x}))
               | d : RealAbGroup.abs (signedPow r>1 x - signedPow r>1 y) <= (2 : Real) * rpow M M>=0 (r - 1) (sub1>0 r>1)
                   => RealAbGroup.abs_+ <=∘ =_<= (pmap (_ +) RealAbGroup.abs_negative) <=∘ (linarith : RealAbGroup.abs (signedPow r>1 x) + RealAbGroup.abs (signedPow r>1 y) <= (2 : Real) * rpow M M>=0 (r - 1) (sub1>0 r>1))
               | tP>=0 : (0 : Real) <= (2 : Real) * rpow M M>=0 (r - 1) (sub1>0 r>1) => linarith
     \in rpow-mono {_} {_} {RealAbGroup.abs>=0} {tP>=0} d <=∘ =_<= (rpow_* {2} {rpow M M>=0 (r - 1) (sub1>0 r>1)} {<=-less two>0} {P>=0} {tP>=0} {q} {q>0}
          *> pmap2 (*) (rpow-pos-eq two>0) (rpow-rpow {M} {M>=0} {r - 1} {q} {sub1>0 r>1} {q>0} {P>=0} {RealField.<_*_positive_positive (sub1>0 r>1) q>0} *> rpow-exp (signedPow-conj.conj-exp rq)))

-- | Modulus of continuity of $\varphi_r$: for every $\eta > 0$ there is `C` with $|\varphi_r(x) - \varphi_r(y)|^{r'} \le C |x - y|^r + \eta (|x|^r + |y|^r)$.
\lemma signedPow-modulus {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {q : Real} {q>0 : (0 : Real) < q}
                         (rq : HolderConjugate r q r>0 q>0) {eta : Rat} (eta>0 : 0 RatField.< eta)
  : ∃ (C : Rat) (0 RatField.<= C) (\Pi (x y : Real) -> rpow (RealAbGroup.abs (signedPow r>1 x - signedPow r>1 y)) RealAbGroup.abs>=0 q q>0
        <= Real.fromRat C * rpow (RealAbGroup.abs (x - y)) RealAbGroup.abs>=0 r r>0 + Real.fromRat eta * (rpow (RealAbGroup.abs x) RealAbGroup.abs>=0 r r>0 + rpow (RealAbGroup.abs y) RealAbGroup.abs>=0 r r>0))
  => \case UpperReal.U-inh_>0 {rpow-pos 2 two>0 r} \with {
    | inP (T,Tu,T>0) =>
      \let eps => 1 RatField.∧ (eta RatField.* RatField.finv T)
      \in \have | eps>0 : 0 RatField.< eps => RatField.<_meet-univ RatField.zro<ide (RatField.<_*_positive_positive eta>0 (RatField.finv>0 T>0))
                | g : CoverMap (IntervalSpace (negative (1 : Real)) (1 : Real)) RealNormed (\lam z => signedPow r>1 z.1) => signedPow-cover r>1 CoverMap.∘ intervalInc (negative (1 : Real)) (1 : Real)
      \in \case interval-uniform (linarith : negative (1 : Real) <= 1) g eps>0 \with {
        | inP (delta,delta>0,hd) =>
          \let rho => delta RatField.* ratio 1 2
          \in \have | rho>0 : 0 RatField.< rho => linarith
                    | irho>0 : (0 : Real) < Real.fromRat (RatField.finv rho) => rat_real_<.1 (RatField.finv>0 rho>0)
          \in \case UpperReal.U-inh_>0 {rpow-pos 2 two>0 q * rpow-pos (Real.fromRat (RatField.finv rho)) irho>0 r} \with {
            | inP (C,Cu,C>0) => inP (C, <=-less C>0, \lam x y =>
              \let | M => RealAbGroup.abs x + RealAbGroup.abs y
                   | D => rpow (RealAbGroup.abs (x - y)) RealAbGroup.abs>=0 r r>0
                   | S => rpow (RealAbGroup.abs x) RealAbGroup.abs>=0 r r>0 + rpow (RealAbGroup.abs y) RealAbGroup.abs>=0 r r>0
              \in \have | M>=0 : (0 : Real) <= M => usingOnly (RealAbGroup.abs>=0 {x}, RealAbGroup.abs>=0 {y}) linarith
                        | CD>=0 : (0 : Real) <= Real.fromRat C * D => RealField.<=_*_positive_positive (rat_real_<=.1 (<=-less C>0)) rpow>=0
                        | eS>=0 : (0 : Real) <= Real.fromRat eta * S => RealField.<=_*_positive_positive (rat_real_<=.1 (<=-less eta>0)) (linarith (rpow>=0 {RealAbGroup.abs x} {RealAbGroup.abs>=0} {r} {r>0}, rpow>=0 {RealAbGroup.abs y} {RealAbGroup.abs>=0} {r} {r>0}))
              \in real-cases {Real.fromRat rho * M} {RealAbGroup.abs (x - y)}
                   (\lam lt =>
                     \have | ir : Real.fromRat (RatField.finv rho) * Real.fromRat rho = (1 : Real) => RealField.*-rat *> pmap Real.fromRat (RatField.finv-left (RatField.>_/= rho>0))
                           | ML : M <= Real.fromRat (RatField.finv rho) * RealAbGroup.abs (x - y)
                               => =_<= (inv (pmap (\lam t => t * M) ir *> RealField.ide-left) *> RealField.*-assoc) <=∘ <=_*_positive-right (<=-less irho>0) (<=-less lt)
                           | IX>=0 : (0 : Real) <= Real.fromRat (RatField.finv rho) * RealAbGroup.abs (x - y) => RealField.<=_*_positive_positive (<=-less irho>0) RealAbGroup.abs>=0
                           | f1 => signedPow-diff-far {r} {r>1} {r>0} {q} {q>0} rq {x} {y} {M>=0}
                           | f2 : rpow M M>=0 r r>0 <= rpow-pos (Real.fromRat (RatField.finv rho)) irho>0 r * D
                               => rpow-mono {_} {_} {M>=0} {IX>=0} ML <=∘ =_<= (rpow_* {_} {_} {<=-less irho>0} {RealAbGroup.abs>=0} *> pmap (\lam t => t * D) (rpow-pos-eq irho>0))
                           | f3 : rpow-pos 2 two>0 q * rpow M M>=0 r r>0 <= Real.fromRat C * D
                               => <=_*_positive-right (<=-less rpow-pos>0) f2 <=∘ =_<= (inv RealField.*-assoc) <=∘ <=_*_positive-left (<=-less (real_<_U.2 Cu)) rpow>=0
                     \in f1 <=∘ f3 <=∘ transport (__ <= _) zro-right (<=_+ <=-refl eS>=0))
                   (\lam ge => real-cases {0} {M}
                     (\lam M>0 =>
                       \let | iM => RealField.pinv M M>0
                            | x' => iM * x
                            | y' => iM * y
                            | P => rpow-pos M M>0 (r - 1)
                       \in \have | iM>0 : (0 : Real) < iM => RealField.pinv>0 M>0
                                 | iMM : iM * M = (1 : Real) => RealField.pinv-left M>0
                                 | small {z : Real} (zM : RealAbGroup.abs z <= M) : RealAbGroup.abs (iM * z) <= (1 : Real)
                                     => =_<= (RealField.abs_* *> pmap (\lam t => t * _) (RealAbGroup.abs-ofPos (<=-less iM>0))) <=∘ <=_*_positive-right (<=-less iM>0) zM <=∘ =_<= iMM
                                 | inI {z : Real} (z1 : RealAbGroup.abs z <= (1 : Real)) : ClosedInterval (negative (1 : Real)) (1 : Real) z
                                     => (usingOnly (z1, RealAbGroup.abs>=neg {z}) linarith, RealAbGroup.abs>=id <=∘ z1)
                                 | x1 => small (usingOnly (RealAbGroup.abs>=0 {y}) linarith : RealAbGroup.abs x <= M)
                                 | y1 => small (usingOnly (RealAbGroup.abs>=0 {x}) linarith : RealAbGroup.abs y <= M)
                                 | eyx : y' - x' = iM * (y - x) => equation.cRing
                                 | dxy : RealAbGroup.abs (y' - x') < Real.fromRat delta
                                     => (=_<= (pmap RealAbGroup.abs eyx *> RealField.abs_* *> pmap2 (*) (RealAbGroup.abs-ofPos (<=-less iM>0)) RealAbGroup.abs_-)
                                        <=∘ <=_*_positive-right (<=-less iM>0) ge <=∘ =_<= ((equation.cRing : iM * (Real.fromRat rho * M) = Real.fromRat rho * (iM * M)) *> pmap (Real.fromRat rho *) iMM *> RealField.ide-right))
                                        <∘r rat_real_<.1 (usingOnly delta>0 linarith : rho RatField.< delta)
                                 | u : RealAbGroup.abs (signedPow r>1 y' - signedPow r>1 x') <= Real.fromRat eps => hd {x', inI x1} {y', inI y1} dxy
                                 | ex : signedPow r>1 x = P * signedPow r>1 x' => pmap (signedPow r>1) (inv (inv RealField.*-assoc *> pmap (\lam t => t * x) (RealField.*-comm *> iMM) *> RealField.ide-left)) *> signedPow-homog M>0
                                 | ey : signedPow r>1 y = P * signedPow r>1 y' => pmap (signedPow r>1) (inv (inv RealField.*-assoc *> pmap (\lam t => t * y) (RealField.*-comm *> iMM) *> RealField.ide-left)) *> signedPow-homog M>0
                                 | eps>0' : (0 : Real) < Real.fromRat eps => rat_real_<.1 eps>0
                                 | d : RealAbGroup.abs (signedPow r>1 x - signedPow r>1 y) <= Real.fromRat eps * P
                                     => =_<= (pmap2 (\lam a b => RealAbGroup.abs (a - b)) ex ey *> pmap RealAbGroup.abs (equation.cRing : P * signedPow r>1 x' - P * signedPow r>1 y' = P * (signedPow r>1 x' - signedPow r>1 y'))
                                              *> RealField.abs_* *> pmap2 (*) (RealAbGroup.abs-ofPos (<=-less rpow-pos>0)) RealAbGroup.abs_- *> RealField.*-comm)
                                        <=∘ <=_*_positive-left u (<=-less rpow-pos>0)
                                 | eP>=0 : (0 : Real) <= Real.fromRat eps * P => RealField.<=_*_positive_positive (<=-less eps>0') (<=-less rpow-pos>0)
                                 | pw : rpow (Real.fromRat eps * P) eP>=0 q q>0 = rpow-pos (Real.fromRat eps) eps>0' q * rpow M M>=0 r r>0
                                     => rpow_* {_} {P} {<=-less eps>0'} {<=-less rpow-pos>0} {eP>=0} {q} {q>0} *> pmap2 (*) (rpow-pos-eq eps>0')
                                          (rpow-base {P} {rpow M M>=0 (r - 1) (sub1>0 r>1)} (inv (rpow-pos-eq M>0)) *> rpow-rpow {M} {M>=0} {r - 1} {q} {sub1>0 r>1} {q>0} {rpow>=0} {RealField.<_*_positive_positive (sub1>0 r>1) q>0} *> rpow-exp (signedPow-conj.conj-exp rq))
                                 | sp : rpow-pos (Real.fromRat eps) eps>0' q <= Real.fromRat eps
                                     => AbsPowLemmas.small-pow (<=-less (conj>1 r>1 rq)) eps>0' (rat_real_<=.1 RatField.meet-left)
                                 | Mr : rpow M M>=0 r r>0 <= rpow-pos 2 two>0 r * (Real.fromRat (ratio 1 2) * S) => rpow-sum-le r>1 RealAbGroup.abs>=0 RealAbGroup.abs>=0
                                 | S>=0 : (0 : Real) <= S => usingOnly (rpow>=0 {RealAbGroup.abs x} {RealAbGroup.abs>=0} {r} {r>0}, rpow>=0 {RealAbGroup.abs y} {RealAbGroup.abs>=0} {r} {r>0}) linarith
                                 | hS : Real.fromRat (ratio 1 2) * S <= S => usingOnly S>=0 linarith
                                 | cT : Real.fromRat eps * rpow-pos 2 two>0 r <= Real.fromRat eta
                                     => <=_*_positive-right (<=-less eps>0') (<=-less (real_<_U.2 Tu)) <=∘ =_<= RealField.*-rat
                                        <=∘ rat_real_<=.1 (RatField.<=_*_positive-left RatField.meet-right (<=-less T>0) <=∘ =_<= (RatField.*-assoc *> pmap (eta RatField.*) (RatField.finv-left (RatField.>_/= T>0)) *> RatField.ide-right))
                                 | chain : rpow (RealAbGroup.abs (signedPow r>1 x - signedPow r>1 y)) RealAbGroup.abs>=0 q q>0 <= Real.fromRat eta * S
                                     => rpow-mono {_} {_} {RealAbGroup.abs>=0} {eP>=0} d <=∘ =_<= pw <=∘ <=_*_positive-left sp rpow>=0
                                        <=∘ <=_*_positive-right (<=-less eps>0') (Mr <=∘ <=_*_positive-right (<=-less rpow-pos>0) hS)
                                        <=∘ =_<= (inv RealField.*-assoc) <=∘ <=_*_positive-left cT S>=0
                       \in chain <=∘ transport (__ <= _) zro-left (<=_+ CD>=0 <=-refl))
                     (\lam M<=0 =>
                       \have | x0 : x = (0 : Real) => RealAbGroup.abs_zro-ext (<=-antisymmetric (usingOnly (M<=0, RealAbGroup.abs>=0 {y}) linarith) RealAbGroup.abs>=0)
                             | y0 : y = (0 : Real) => RealAbGroup.abs_zro-ext (<=-antisymmetric (usingOnly (M<=0, RealAbGroup.abs>=0 {x}) linarith) RealAbGroup.abs>=0)
                             | z : rpow (RealAbGroup.abs (signedPow r>1 x - signedPow r>1 y)) RealAbGroup.abs>=0 q q>0 = (0 : Real)
                                 => rpow-zero-ext (pmap (\lam t => RealAbGroup.abs (signedPow r>1 x - signedPow r>1 t)) (y0 *> inv x0) *> pmap RealAbGroup.abs RealAbGroup.negative-right *> RealAbGroup.abs_zro)
                       \in =_<= z <=∘ (usingOnly (CD>=0, eS>=0) linarith : (0 : Real) <= Real.fromRat C * D + Real.fromRat eta * S))))
          }
      }
  }

-- | $|c_a(t)| \le |t|$ for $a \ge 0$.
\lemma clampSym-abs-le {a t : Real} (a>=0 : (0 : Real) <= a) : RealAbGroup.abs (clampSym a t) <= RealAbGroup.abs t
  => signedPowTail-cauchy.sign-cases' {t}
      (\lam t>=0 => =_<= (pmap RealAbGroup.abs (clampSym-nonneg a>=0 t>=0) *> RealAbGroup.abs-ofPos (meet-univ t>=0 a>=0)) <=∘ meet-left <=∘ RealAbGroup.abs>=id)
      (\lam t<=0 => \have s>=0 : (0 : Real) <= negative t => usingOnly t<=0 linarith
                    \in =_<= (pmap RealAbGroup.abs (clampSym-nonpos a>=0 t<=0) *> RealAbGroup.abs_negative *> RealAbGroup.abs-ofPos (meet-univ s>=0 a>=0)) <=∘ meet-left <=∘ RealAbGroup.abs>=neg)

-- | $|c_a(t)|^r \le a^{r-1} |t|$.
\lemma clampSym-pow {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {a : Real} (a>0 : (0 : Real) < a) {t : Real}
  : rpow (RealAbGroup.abs (clampSym a t)) RealAbGroup.abs>=0 r r>0 <= rpow-pos a a>0 (r - 1) * RealAbGroup.abs t
  => \have | c>=0 : (0 : Real) <= RealAbGroup.abs (clampSym a t) => RealAbGroup.abs>=0
           | e : rpow (RealAbGroup.abs (clampSym a t)) RealAbGroup.abs>=0 r r>0 = rpow (RealAbGroup.abs (clampSym a t)) c>=0 (r - 1) (sub1>0 r>1) * RealAbGroup.abs (clampSym a t)
               => rpow-exp (equation.cRing : r = (r - 1) + (1 : Real)) *> rpow_+ {_} {c>=0} {r - 1} {1} {sub1>0 r>1} {RealField.zro<ide} *> pmap (_ *) rpow-one
           | m : rpow (RealAbGroup.abs (clampSym a t)) c>=0 (r - 1) (sub1>0 r>1) <= rpow-pos a a>0 (r - 1)
               => rpow-mono {_} {a} {c>=0} {<=-less a>0} (clampSym-abs (<=-less a>0)) <=∘ =_<= (rpow-pos-eq a>0)
     \in =_<= e <=∘ <=_*_positive-left m c>=0 <=∘ <=_*_positive-right (<=-less rpow-pos>0) (clampSym-abs-le (<=-less a>0))

-- | $|\varphi^{(a)}(x) - \varphi^{(a)}(y)|^{r'} \le 2^{r'}(C |x-y|^r + \eta(|x|^r + |y|^r)) + 2^{r'} 2^{r'} 2^r a^{r-1} (|x| + |y|)$, with `C` from {signedPow-modulus}.
\lemma signedPowTail-modulus {r : Real} {r>1 : (1 : Real) < r} {r>0 : (0 : Real) < r} {q : Real} {q>0 : (0 : Real) < q}
                             (rq : HolderConjugate r q r>0 q>0) {eta : Rat} (eta>0 : 0 RatField.< eta)
  : ∃ (C : Rat) (0 RatField.<= C) (\Pi {a : Real} (a>0 : (0 : Real) < a) (x y : Real) -> rpow (RealAbGroup.abs (signedPowTail r>1 a x - signedPowTail r>1 a y)) RealAbGroup.abs>=0 q q>0
        <= rpow-pos 2 two>0 q * (Real.fromRat C * rpow (RealAbGroup.abs (x - y)) RealAbGroup.abs>=0 r r>0 + Real.fromRat eta * (rpow (RealAbGroup.abs x) RealAbGroup.abs>=0 r r>0 + rpow (RealAbGroup.abs y) RealAbGroup.abs>=0 r r>0))
         + rpow-pos 2 two>0 q * rpow-pos 2 two>0 q * rpow-pos 2 two>0 r * rpow-pos a a>0 (r - 1) * (RealAbGroup.abs x + RealAbGroup.abs y))
  => \case signedPow-modulus {r} {r>1} {r>0} {q} {q>0} rq eta>0 \with {
    | inP (C,C>=0,h) => inP (C, C>=0, \lam {a} a>0 x y =>
      \let | A => signedPow r>1 x - signedPow r>1 y
           | B => signedPow r>1 (clampSym a y) - signedPow r>1 (clampSym a x)
           | Q2 => rpow-pos 2 two>0 q
      \in \have | e : signedPowTail r>1 a x - signedPowTail r>1 a y = A + B => equation.abGroup
                | AB>=0 : (0 : Real) <= RealAbGroup.abs A + RealAbGroup.abs B => usingOnly (RealAbGroup.abs>=0 {A}, RealAbGroup.abs>=0 {B}) linarith
                | s1 : rpow (RealAbGroup.abs (A + B)) RealAbGroup.abs>=0 q q>0 <= Q2 * (Real.fromRat (ratio 1 2) * (rpow (RealAbGroup.abs A) RealAbGroup.abs>=0 q q>0 + rpow (RealAbGroup.abs B) RealAbGroup.abs>=0 q q>0))
                    => rpow-mono {_} {_} {RealAbGroup.abs>=0} {AB>=0} RealAbGroup.abs_+ <=∘ rpow-sum-le (conj>1 r>1 rq) RealAbGroup.abs>=0 RealAbGroup.abs>=0
                | cx>=0 : (0 : Real) <= RealAbGroup.abs (clampSym a y) + RealAbGroup.abs (clampSym a x) => usingOnly (RealAbGroup.abs>=0 {clampSym a y}, RealAbGroup.abs>=0 {clampSym a x}) linarith
                | sB : rpow (RealAbGroup.abs B) RealAbGroup.abs>=0 q q>0 <= Q2 * (rpow-pos 2 two>0 r * (Real.fromRat (ratio 1 2) * (rpow-pos a a>0 (r - 1) * RealAbGroup.abs y + rpow-pos a a>0 (r - 1) * RealAbGroup.abs x)))
                    => signedPow-diff-far {r} {r>1} {r>0} {q} {q>0} rq {clampSym a y} {clampSym a x} {cx>=0}
                       <=∘ <=_*_positive-right (<=-less rpow-pos>0) (rpow-sum-le r>1 RealAbGroup.abs>=0 RealAbGroup.abs>=0
                         <=∘ <=_*_positive-right (<=-less rpow-pos>0) (<=_*_positive-right (rat_real_<=.1 (RatField.<=-less (idp : 0 RatField.< ratio 1 2))) (<=_+ (clampSym-pow {r} {r>1} {r>0} a>0) (clampSym-pow {r} {r>1} {r>0} a>0))))
                | sA => h x y
      \in =_<= (pmap (\lam z => rpow (RealAbGroup.abs z) RealAbGroup.abs>=0 q q>0) e)
           <=∘ fin (<=-less rpow-pos>0) (<=-less rpow-pos>0) (<=-less rpow-pos>0) rpow>=0 rpow>=0 (rat_real_<=.1 (RatField.<=-less (idp : 0 RatField.< ratio 1 2))) (rat_real_<=.1 (linarith : ratio 1 2 RatField.<= 1)) RealAbGroup.abs>=0 RealAbGroup.abs>=0 s1 sA sB)
  }
  \where
    \private \lemma fin {L Q2 R2 P Aq Bq X x' y' h : Real} (Q2>=0 : (0 : Real) <= Q2) (R2>=0 : (0 : Real) <= R2) (P>=0 : (0 : Real) <= P) (Aq>=0 : (0 : Real) <= Aq) (Bq>=0 : (0 : Real) <= Bq)
                        (h>=0 : (0 : Real) <= h) (h<=1 : h <= (1 : Real)) (x'>=0 : (0 : Real) <= x') (y'>=0 : (0 : Real) <= y') (s1 : L <= Q2 * (h * (Aq + Bq))) (sA : Aq <= X) (sB : Bq <= Q2 * (R2 * (h * (P * y' + P * x'))))
      : L <= Q2 * X + Q2 * Q2 * R2 * P * (x' + y')
      => \have | t1 : h * (Aq + Bq) <= Aq + Bq => <=_*_positive-left h<=1 (usingOnly (Aq>=0, Bq>=0) linarith) <=∘ =_<= RealField.ide-left
               | W>=0 : (0 : Real) <= P * y' + P * x' => =_<= (inv RealAbGroup.zro-left) <=∘ <=_+ (RealField.<=_*_positive_positive P>=0 y'>=0) (RealField.<=_*_positive_positive P>=0 x'>=0)
               | t2 : Bq <= Q2 * (R2 * (P * y' + P * x')) => sB <=∘ <=_*_positive-right Q2>=0 (<=_*_positive-right R2>=0 (<=_*_positive-left h<=1 W>=0 <=∘ =_<= RealField.ide-left))
               | t3 : Q2 * (Aq + Bq) <= Q2 * X + Q2 * (Q2 * (R2 * (P * y' + P * x'))) => =_<= RealField.ldistr <=∘ <=_+ (<=_*_positive-right Q2>=0 sA) (<=_*_positive-right Q2>=0 t2)
               | e : Q2 * (Q2 * (R2 * (P * y' + P * x'))) = Q2 * Q2 * R2 * P * (x' + y') => equation.cRing
         \in s1 <=∘ <=_*_positive-right Q2>=0 t1 <=∘ t3 <=∘ =_<= (pmap (_ +) e)

-- | $\varphi^{(a)}(t) = 0$ for $|t| \le a$.
\lemma signedPowTail-in {r : Real} {r>1 : (1 : Real) < r} {a t : Real} (ta : RealAbGroup.abs t <= a) : signedPowTail r>1 a t = (0 : Real)
  => pmap (\lam c => signedPow r>1 t - signedPow r>1 c) (clampSym-in ta) *> RealAbGroup.negative-right

-- | $|\varphi^{(a)}(t)| \le (a^{r-2} + (R \vee a)^{r-2}) |t|$ for $|t| \le R$ and $a > 0$.
\lemma signedPowTail-lin {r : Real} {r>1 : (1 : Real) < r} {a : Real} (a>0 : (0 : Real) < a) {R t : Real} (tR : RealAbGroup.abs t <= R)
  : RealAbGroup.abs (signedPowTail r>1 a t) <= (rpow-pos a a>0 (r - 2) + rpow-pos (R ∨ a) (a>0 <∘l join-right) (r - 2)) * RealAbGroup.abs t
  => \have C>=0 : (0 : Real) <= rpow-pos a a>0 (r - 2) + rpow-pos (R ∨ a) (a>0 <∘l join-right) (r - 2) => <=-less (transport (__ < _) RealAbGroup.zro-left (RealField.<_+ rpow-pos>0 rpow-pos>0))
     \in real-cases {RealAbGroup.abs t} {a}
      (\lam t<a => =_<= (pmap RealAbGroup.abs (signedPowTail-in (<=-less t<a)) *> RealAbGroup.abs_zro) <=∘ RealField.<=_*_positive_positive C>=0 RealAbGroup.abs>=0)
      (\lam a<=t => \have | t>0 : (0 : Real) < RealAbGroup.abs t => a>0 <∘l a<=t
                          | b : RealAbGroup.abs (signedPowTail r>1 a t) <= rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 (r - 1) (sub1>0 r>1) => tail-abs {r} {r>1} {a} {t} {<=-less a>0}
                    \in b <=∘ =_<= (signedPow.pow-split t>0) <=∘ <=_*_positive-left (rpow-pos-between a<=t (tR <=∘ join-left)) RealAbGroup.abs>=0)
  \where
    \lemma tail-abs {r : Real} {r>1 : (1 : Real) < r} {a t : Real} {a>=0 : (0 : Real) <= a}
      : RealAbGroup.abs (signedPowTail r>1 a t) <= rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 (r - 1) (sub1>0 r>1)
      => signedPowTail-cauchy.sign-cases' {t}
          (\lam t>=0 => \have | m : rpow (t ∧ a) (meet-univ t>=0 a>=0) (r - 1) (sub1>0 r>1) <= rpow t t>=0 (r - 1) (sub1>0 r>1) => rpow-mono meet-left
                              | e : rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 (r - 1) (sub1>0 r>1) = rpow t t>=0 (r - 1) (sub1>0 r>1) => rpow-base (RealAbGroup.abs-ofPos t>=0)
                        \in =_<= (pmap RealAbGroup.abs (signedPowTail-nonneg a>=0 t>=0)) <=∘ TailHelpers.abs-diff-le rpow>=0 rpow>=0 m <=-refl <=∘ =_<= (inv e))
          (\lam t<=0 => \have | s>=0 : (0 : Real) <= negative t => usingOnly t<=0 linarith
                              | m : rpow (negative t ∧ a) (meet-univ s>=0 a>=0) (r - 1) (sub1>0 r>1) <= rpow (negative t) s>=0 (r - 1) (sub1>0 r>1) => rpow-mono meet-left
                              | e : rpow (RealAbGroup.abs t) RealAbGroup.abs>=0 (r - 1) (sub1>0 r>1) = rpow (negative t) s>=0 (r - 1) (sub1>0 r>1) => rpow-base (RealAbGroup.abs-ofNeg t<=0)
                        \in =_<= (pmap RealAbGroup.abs (signedPowTail-nonpos {r} {r>1} a>=0 t<=0 {s>=0}) *> RealAbGroup.abs_negative)
                             <=∘ TailHelpers.abs-diff-le rpow>=0 rpow>=0 m <=-refl <=∘ =_<= (inv e))