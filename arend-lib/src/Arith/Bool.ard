{- | Order-theoretic structure on the booleans, exhibiting `Bool` as both a bounded distributive lattice and a decidable
 -   linear order.
 -
 -   This module equips the two-element type `Bool` with its canonical order `false <= true`, derived from a custom
 -   inductive `<=` relation. The lattice structure interprets logical conjunction `and` as meet and disjunction `or` as
 -   join, with `false` as bottom and `true` as top — the standard Boolean algebra viewed as a distributive lattice. A
 -   separate strict-order instance provides decidable trichotomy, making `Bool` usable wherever a `LinearOrder` or
 -   decidable poset is required.
 -}

\import Data.Bool
\import Logic.Meta
\import Meta
\import Order.Lattice
\import Order.LinearOrder

{- | Instance of `BoundedDistributiveLattice Bool`, with `meet = and`, `join = or`, `top = true`, `bottom = false`.
 -   Provides the lattice/Boolean-algebra view of `Bool`.
 -}
\instance BoolLattice : BoundedDistributiveLattice Bool
  | <= => <=
  | <=-refl {x} => cases x constructor
  | <=-transitive {x} {y} {z} p q => cases (x,y,z,p,q) constructor
  | <=-antisymmetric {x} {y} p q => cases (x,y,p,q) idp
  | meet => and
  | meet-left {x} {y} => cases (x,y) constructor
  | meet-right {x} {y} => cases (x,y) constructor
  | meet-univ {x} {y} {z} p q => cases (x,y,z,p,q) constructor
  | join => or
  | join-left {x} {y} => cases x constructor
  | join-right {x} {y} => cases (x,y) constructor
  | join-univ {x} {y} {z} p q => cases (x,y,z,p,q) constructor
  | top => true
  | top-univ {x} => cases x constructor
  | bottom => false
  | bottom-univ => false<=_
  | ldistr>= {x} {y} {z} => cases (x,y,z) constructor
  \where {
    {- | Inductive non-strict order on `Bool` with constructors `false<=_` (so `false <= y` for any `y`) and
     -   `true<=true`.
     -}
    \data \infix 4 <= (x y : Bool) \with
      | false, _ => false<=_
      | true, true => true<=true
  }

{- | Instance of `Dec Bool` (a decidable linear order), giving `Bool` strict comparison, irreflexivity, transitivity,
 -   and trichotomy.
 -}
\instance BoolPoset : Dec Bool
  | < => <
  | <-irreflexive => \lam {(true)} ()
  | <-transitive {x} {y} {z} => \case \elim x, \elim y, \elim z, __, __
  | trichotomy => \case \elim __, \elim __ \with {
    | true, true => equals idp
    | true, false => greater false<true
    | false, true => less false<true
    | false, false => equals idp
  }
  \where {
    \open LinearOrder

    -- | Inductive strict order on `Bool` with the single constructor `false<true`.
    \data \infix 4 < (x y : Bool) \with
      | false, true => false<true
  }
