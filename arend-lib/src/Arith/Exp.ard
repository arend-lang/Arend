\open AddMonoid (BigSum)

\sfunc exp {A : RealBanachAlgebra} : CoverMap A A
  => funcLimit (\lam n x => partialSum (powerSeries (\lam n => A.fromRat (RatField.finv (fac n))) __ x) n) (powerSeriesConv-funcConv exp-series-conv)
  \where {
    \open ExUpperRealSemigroup(<=_*, ide-right)

    \lemma exp-series-conv : IsPowerSeriesConv \lam n => A.fromRat (RatField.finv (fac n))
      => power-ratio-test-inf (\lam n => RatField.finv (suc n)) (\lam n => =_<= $ A.norm_*q *> *-comm *> pmap (_ *) (pmap ExUpperReal.fromRat
          (RatField.abs-ofPos (RatField.finv>=0 $ <=_ratNom $ pos<=pos zero<=_) *> RatField.finv_* {suc n} *>
          pmap (`* _) (inv $ RatField.abs-ofPos $ RatField.finv>=0 $ <=_ratNom $ pos<=pos zero<=_)) *>
          inv (ExUpperReal.*-rat RatField.abs>=0 $ <=_ratNom $ pos<=pos zero<=_)) *> inv (pmap (`* _) (A.norm_*q {RatField.finv (fac n)} {1} *> *-comm) *> *-assoc))
        inv-limit

    \lemma inv-limit : RealNormed.IsLimit (\lam n => RatField.finv (suc n)) 0
      => \lam Uo U0 =>
        \have | (inP (eps,eps>0,h)) => (dist_open {RealNormed}).1 Uo U0
              | (N,eps'<N) => rat_natBound (RatField.finv eps)
        \in inP (N, \lam {n} N<=n => h $ unfold OBall $ rewriteI (norm_dist {RealNormed}) $
              rewrite (RealAbGroup.abs-ofPos $ rat_real_<=.1 $ <=_ratNom $ pos<=pos zero<=_) $
              RatField.finv_<-left {eps} {suc n} eps>0 $ eps'<N <∘l fromInt_<= (pos<=pos $ N<=n <=∘ id<=suc))
  }

\open Monoid (pow)

{- | Partial sums of the exp-series at $x = 0$ stabilise at $1$ after step $1$:
     only the $k = 0$ term contributes ($0^0 = 1$); all later terms have $0^k = 0$. -}
\private \lemma exp-partialSum-at-zero {A : RealBanachAlgebra} (n : Nat) (p : 1 <= n)
  : partialSum (powerSeries (\lam k => A.fromRat (RatField.finv (fac k))) __ 0) n = 1 \elim n
  | 0 => absurd (p NatOrder.zero<suc)
  | 1 => partialSum_suc
      *> pmap (`+ _) partialSum-empty
      *> zro-left
      *> pmap (`* _) (pmap A.fromRat (inv ide-left *> RatField.finv-right (\lam q => RatField.zro/=ide (inv q))) *> A.ide_*q)
      *> ide-left
  | suc (suc n) => partialSum_suc
      *> pmap2 (+) (exp-partialSum-at-zero (suc n) (suc<=suc zero<=_))
                   (pmap (A.fromRat (RatField.finv (fac (suc n))) *) (Semiring.pow_0 (\lam q => suc/=0 q)) *> zro_*-right)
      *> zro-right

{- | $\exp 0 = 1$. At $x = 0$ the power series collapses: only the $k = 0$ term
     (which is $1$) survives because $0^k = 0$ for $k \geq 1$. So every partial
     sum for $n \geq 1$ already equals $1$, and the limit is just $1$. -}
\lemma exp_zro {A : RealBanachAlgebra} : exp 0 = 1
  => A.limit-unique (rewrite (\peval exp) limit-isLimit)
       \lam {U} Uo U1 => inP (1, \lam {n} p => transport U (inv (exp-partialSum-at-zero n p)) U1)

{- | Bridge: $\exp x$ is the `IsSeriesSum` value of the exp power series at $x$.
     Used by `exp_+` to connect the `\sfunc exp` (defined via {funcLimit}) with
     the {IsSeriesSum}-based API needed by the Cauchy product {conv-sum}. -}
\lemma exp-IsSeriesSum {A : RealBanachAlgebra} (x : A)
  : IsSeriesSum (powerSeries (\lam k => A.fromRat (RatField.finv (fac k))) __ x) (exp x)
  => rewrite (\peval exp) limit-isLimit

{- | Each convolution term of the exp-series at $x$ and $y$ equals the
     corresponding power-series term at $x + y$, given $x \cdot y = y \cdot x$:
     $$\sum_{k=0}^{n} (c_k \cdot x^k) \cdot (c_{n - k} \cdot y^{n - k})
       = c_n \cdot (x + y)^n,$$
     where $c_k := \mathrm{A.fromRat}\,(1/k!)$. Strategy: `conv` unfolds
     definitionally to $\sum_k (c_k \cdot x^k) \cdot (c_{n - k} \cdot y^{n - k})$.
     Each term rearranges ($c_\bullet$ central, {cs-binom-id}) to
     $c_n \cdot \binom{n}{k} \cdot (x^k \cdot y^{n - k})$. `BigSum-ldistr`
     factors $c_n$ out, then {binom.expansion-noncomm} collapses the inner BigSum
     to $(x + y)^n$, which definitionally equals $\mathrm{powerSeries}\,c\,n\,(x + y)$. -}
\private \lemma exp-conv-eq {A : RealBanachAlgebra} {x y : A} (xy=yx : x * y = y * x) (n : Nat)
  : conv (powerSeries (\lam k => A.fromRat (RatField.finv (fac k))) __ x)
         (powerSeries (\lam k => A.fromRat (RatField.finv (fac k))) __ y) n
    = powerSeries (\lam k => A.fromRat (RatField.finv (fac k))) n (x + y)
  => \let
      | cs k => A.fromRat (RatField.finv (fac k))
      | a k => powerSeries (\lam j => cs j) k x
      | b k => powerSeries (\lam j => cs j) k y
      | term-eq (k : Fin (suc n)) : a k * b (n -' k) = cs n * (natCoef (binom n k) * (pow x k * pow y (n -' k)))
          => *-assoc
             *> pmap (cs k *) (inv *-assoc *> pmap (`* _) (inv A.fromRat-comm) *> *-assoc)
             *> inv *-assoc
             *> pmap (`* _) (cs-binom-id $ <_suc_<= (fin_< k))
             *> pmap (`* _) Semiring.natCoef-comm
             *> *-assoc
     \in
      -- conv (ps x) (ps y) n  reduces to  BigSum (\new Array A (suc n) (\lam k => a k * b (n -' k)))  by def of `conv`.
      path (\lam j => BigSum (\new Array A (suc n) (\lam k => term-eq k j)))
      -- = BigSum [cs n * (binom n k * (pow x k * pow y (n -' k)))]
      *> inv (A.BigSum-ldistr {cs n} {\new Array A (suc n) \lam k => natCoef (binom n k) * (pow x k * pow y (n -' k))})
      -- = cs n * BigSum [binom n k * (pow x k * pow y (n -' k))]
      *> pmap (cs n *) (inv (binom.expansion-noncomm xy=yx))
      -- = cs n * pow (x + y) n  (definitionally = powerSeries cs n (x+y))
  \where {
    \private \lemma binom-fac-rat {n k : Nat} (p : k <= n)
      : RatField.finv (fac k) * RatField.finv (fac (n -' k)) = natCoef (binom n k) * RatField.finv (fac n)
      => inv $ *-comm *> pmap (_ *) (inv (RatField.*-assoc {binom n k} *>
              pmap (_ *) (RatField.finv-right $ natRat/=0 $ NatSemiring.>_/= $ NatSemiring.<_*_positive_positive fac>0 fac>0))
            *> pmap (RatField.`* _) (pmap (_ *) *-comm *> inv *-assoc *> binom.fac-id-le p))
          *> inv *-assoc *> pmap (`* _) (RatField.finv-left $ natRat/=0 fac/=0) *> ide-left *> RatField.finv_*

    \private \lemma cs-binom-id {A : RealBanachAlgebra} {n k : Nat} (p : k <= n)
      : A.fromRat (RatField.finv (fac k)) * A.fromRat (RatField.finv (fac (n -' k)))
          = natCoef (binom n k) * A.fromRat (RatField.finv (fac n))
      => A.fromRat_* *> pmap A.fromRat (binom-fac-rat p) *> inv A.fromRat_* *> pmap (`* _) A.fromRat_natCoef
  }

{- | Exponent property: $\exp(x + y) = \exp x \cdot \exp y$ when $x$ and $y$
     commute. Combines Cauchy product ({conv-sum}), the exp-to-seriesSum bridge
     ({exp-IsSeriesSum}), and the per-term equality ({exp-conv-eq}). -}
\lemma exp_+ {A : RealBanachAlgebra} {x y : A} (xy=yx : x * y = y * x) : exp (x + y) = exp x * exp y
  => A.limit-unique (exp-IsSeriesSum (x + y)) $ transport (\lam f => IsSeriesSum f (exp x Semiring.* exp y)) (path (\lam i n => exp-conv-eq xy=yx n @ i)) $
      conv-sum (exp-IsSeriesSum x) (exp-IsSeriesSum y) (powerSeriesConv-absConv exp.exp-series-conv) (powerSeriesConv-absConv exp.exp-series-conv)

{- | Exponent of a negative is the multiplicative inverse:
     $\exp x \cdot \exp(-x) = 1$. Corollary of {exp_+} — $x$ and $-x$ commute
     (both products equal $-(x \cdot x)$) — together with
     $x + (-x) = 0$ (`negative-right`) and `exp_zro`. -}
\lemma exp_negative {A : RealBanachAlgebra} {x : A} : exp x * exp (negative x) = 1
  => inv (exp_+ (PseudoRing.negative_*-right *> inv PseudoRing.negative_*-left)) *> pmap exp negative-right *> exp_zro