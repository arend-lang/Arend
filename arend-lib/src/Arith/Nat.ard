{- | Arithmetic, order, and divisibility infrastructure for the natural numbers.
 -
 -   This module equips `Nat` with the algebraic and order-theoretic structure needed throughout the library: it defines
 -   truncated subtraction `-'` and predecessor `pred`, packages the strict order via the inductive `NatOrder.<`, and
 -   assembles the canonical instances `NatSemiring : LinearlyOrderedCSemiring.Dec` and
 -   `NatBSemilattice : BottomJoinSemilattice`. A second focus is the interplay between `Nat` and `Fin n`, providing
 -   conversions `toFin`, `toFin'`, `mod_Fin` along with their characterization lemmas. The remainder of the file
 -   develops the basic theory of `div`/`mod`, divisibility (`LDiv`), and modular arithmetic congruences used elsewhere
 -   in the library.
 -}

\import Algebra.Monoid(Monoid)
\import Algebra.Ordered
\import Algebra.StrictlyOrdered
\import Data.Bool
\import Data.Or
\import Function.Meta
\import Logic
\import Meta
\import Order.Biordered
\import Order.Lattice
\import Order.LinearOrder
\import Order.PartialOrder \hiding (<=)
\import Paths
\import Paths.Meta
\import Set (==, ==_=)
\open Nat
\open LinearlyOrderedAbMonoid
\open NatOrder

-- # Various operations

-- | Truncated subtraction on `Nat`: `0 -' m = 0`, `suc n -' suc m = n -' m`.
\func \infixl 6 -' (n m : Nat) : Nat
  | 0, _ => 0
  | suc n, 0 => suc n
  | suc n, suc m => n -' m

-- | Predecessor: `pred 0 = 0`, `pred (suc x) = x`.
\func pred (x : Nat) : Nat
  | zero => 0
  | suc x' => x'

-- | `suc (pred n) = n` when `n /= 0`.
\lemma suc_pred {n : Nat} (n/=0 : n /= 0) : suc (pred n) = n \elim n
  | 0 => absurd (n/=0 idp)
  | suc n => idp

-- | `n -' 0 = n`.
\lemma -'0 {n : Nat} : n -' 0 = n \elim n
  | 0 => idp
  | suc n => idp

-- | `(n + m) -' m = n`.
\lemma -'+ {n m : Nat} : n + m -' m = n \elim m
  | 0 => -'0
  | suc n => -'+

-- | `n -' n = 0`.
\lemma -'id {n : Nat} : n -' n = 0 => -'+ {0}

\lemma -'-'l {a b c : Nat} : a -' b -' c = a -' (b + c) \elim a, b
  | 0, b => idp
  | suc a, 0 => idp
  | suc a, suc b => -'-'l

-- | `suc n = 0` is impossible.
\func suc/=0 {n : Nat} (p : suc n = 0) : Empty

-- # The order relations

\module NatOrder \where {
  -- | Inductive strict order: `0 < suc _` and `suc n < suc m` from `n < m`.
  \data \infix 4 < (n m : Nat) \with
    | 0, suc _ => zero<suc
    | suc n, suc m => suc<suc (n < m)

  -- | Inverts `suc<suc`: `suc n < suc m -> n < m`.
  \lemma unsuc< {n m : Nat} (p : suc n < suc m) : n < m \elim p
    | suc<suc p => p
}

\open NatOrder

-- | `0 < n -' m` implies `m < n`.
\lemma -'_< {n m : Nat} (p : 0 < n -' m) : m < n \elim n, m, p
  | suc n, 0, _ => zero<suc
  | suc n, suc m, p => suc<suc (-'_< p)

-- | `m < n` implies `0 < n -' m`.
\lemma <_-' {n m : Nat} (p : m < n) : 0 < n -' m \elim n, m, p
  | suc n, 0, _ => zero<suc
  | suc n, suc m, suc<suc p => <_-' p

-- | `n < suc n`.
\lemma id<suc {n : Nat} : n < suc n \elim n
  | 0 => zero<suc
  | suc n => suc<suc id<suc

-- | `n /= suc n`.
\lemma id/=suc {n : Nat} : n /= suc n \elim n
  | 0 => \case __
  | suc n => \lam p => id/=suc {n} (pmap pred p)

-- | `n /= 0` implies `0 < n`.
\lemma nonZero>0 {n : Nat} (n/=0 : n /= 0) : 0 < n \elim n
  | 0 => absurd (n/=0 idp)
  | suc n => zero<suc

-- # Fin properties

-- | A `Fin n` is bounded by `n`.
\lemma fin_< {n : Nat} (x : Fin n) : x < n \elim n, x
  | suc n, zero => zero<suc
  | suc n, suc x => suc<suc (fin_< x)

-- | Lifts `k : Nat` with `k < n` to `Fin n` by structural recursion.
\func toFin (k : Nat) {n : Nat} (\property p : k < n) : Fin n \elim k, n
  | 0, suc n => 0
  | suc k, suc n => suc (toFin _ (unsuc< p))

-- | `toFin k p = k` as naturals.
\lemma toFin=id {k n : Nat} {p : k < n} : toFin k p = {Nat} k \elim k, n, p
  | 0, suc n, zero<suc => idp
  | suc k, suc n, suc<suc p => pmap suc toFin=id

-- | `toFin` is a left inverse on `Fin n`.
\lemma toFin=fin {n : Nat} {k : Fin n} : toFin k (fin_< k) = k
  => fin_nat-inj toFin=id

-- | Alternative lift via `mod`: `k mod suc n : Fin (suc n)`.
\func toFin' {k n : Nat} (p : k < n) : Fin n \elim n
  | suc n => k mod suc n

-- | Convert `k : Nat` to `Fin n` using modular reduction, given `0 < n`.
\func mod_Fin (k : Nat) {n : Nat} (p : 0 < n) : Fin n \elim n
  | suc n => k mod suc n

-- | `mod_Fin k p = k mod n` as naturals.
\lemma mod_Fin=mod {k n : Nat} {p : 0 < n} : mod_Fin k p = {Nat} k mod n \elim n
  | suc n => idp

\func finMod {n : Nat} (k : Nat) : Fin (suc n)
  => k mod suc n

-- | Equality on `Nat` lifts to equality on `Fin n`.
\lemma fin_nat-inj {n : Nat} {x y : Fin n} (p : x = {Nat} y) : x = y \elim n, x, y, p
  | suc n, zero, zero, _ => idp
  | suc n, suc x, suc y, p => pmap (\lam z => suc z) (fin_nat-inj (pmap pred p))

-- | Disequality on `Fin n` lifts to disequality on `Nat`.
\lemma fin_nat-ineq {n : Nat} {x y : Fin n} (p : Not (x = y)) : Not (x = {Nat} y)
  => \lam q => p (fin_nat-inj q)

-- # Properties of +, *, and <

-- | Decidable linearly ordered commutative semiring instance on `Nat` with the usual `+`, `*`, `<`, `0`, `1`.
\instance NatSemiring : LinearlyOrderedCSemiring.Dec Nat
  | zro => 0
  | + => +
  | zro-left => idp
  | +-assoc {n m k : Nat} : (n + m) + k = n + (m + k) \elim k {
    | 0 => idp
    | suc k => pmap suc +-assoc
  }
  | +-comm {n m : Nat} : n + m = m + n \elim n, m {
    | 0, m => idp
    | n, 0 => idp
    | suc n, suc m => pmap (\lam x => suc (suc x)) +-comm
  }
  | ide => 1
  | * => *
  | ide-left {n : Nat} : 1 * n = n \elim n {
    | 0 => idp
    | suc n => pmap suc ide-left
  }
  | *-assoc {n m k : Nat} : (n * m) * k = n * (m * k) \elim k {
    | 0 => idp
    | suc k => pmap (+ n * m) *-assoc *> inv ldistr
  }
  | ldistr {n m k : Nat} : n * (m + k) = n * m + n * k \elim k {
    | 0 => idp
    | suc k =>
        n * (m + k) + n     ==< pmap (+ n) ldistr >==
        n * m + n * k + n   ==< +-assoc >==
        n * m + (n * k + n) `qed
  }
  | *-comm {n m : Nat} : n * m = m * n \elim n, m {
    | 0, 0 => idp
    | suc n, 0 => *-comm
    | 0, suc m => *-comm
    | suc n, suc m => pmap suc (
        suc n * m + n   ==< pmap (+ n) *-comm >==
        m * n + m + n   ==< +-assoc >==
        m * n + (m + n) ==< pmap2 (+) (inv *-comm) +-comm >==
        n * m + (n + m) ==< inv +-assoc >==
        n * m + n + m   ==< pmap (+ m) *-comm >==
        suc m * n + m   `qed)
  }
  | zro_*-left => *-comm
  | < => <
  | <-irreflexive {n : Nat} (p : n < n) : Empty \elim n, p {
    | suc n, suc<suc p => <-irreflexive p
  }
  | <-transitive {n m k : Nat} (p : n < m) (q : m < k) : n < k \elim n, m, k, p, q {
    | 0, suc n, suc m, zero<suc, suc<suc q => zero<suc
    | suc n, suc m, suc k, suc<suc p, suc<suc q => suc<suc (<-transitive p q)
  }
  | trichotomy n m => \case n - m \as d, idp : n - m = d \with {
    | pos 0, p => equals (triEquals p)
    | pos (suc d), p => greater (triGreater p)
    | neg (suc d), p => less (triLess p)
  }
  | <_+-left (k : Nat) {n m : Nat} (p : n < m) : n + k < m + k \elim k {
    | 0 => p
    | suc k => suc<suc (<_+-left k p)
  }
  | zro<ide => zero<suc
  | <_*_positive-left {n m k : Nat} (p : n < m) (q : 0 < k) : n * k < m * k \elim k, q {
    | 1, _ => p
    | suc (suc k), q => <-transitive (<_+-left n (<_*_positive-left p zero<suc)) (transport2 (<) +-comm +-comm (<_+-left _ p))
  }
  | <_*_negative-left x<y z<0 => \case z<0
  | natCoef n => n
  | natCoefZero => idp
  | natCoefSuc n => idp
  \where {
    \open LinearOrder

    -- | Read off equality / strict comparison from the sign of `n - m` (in `Int`).
    \lemma triEquals {n m : Nat} (p : n - m = 0) : n = m \elim n, m
      | 0, 0 => idp
      | suc n, suc m => pmap suc (triEquals p)

    -- | Read off equality / strict comparison from the sign of `n - m` (in `Int`).
    \lemma triGreater {n m d : Nat} (p : n - m = suc d) : m < n \elim n, m, p
      | suc n, 0, p => zero<suc
      | suc n, suc m, p => suc<suc (triGreater p)

    -- | Read off equality / strict comparison from the sign of `n - m` (in `Int`).
    \lemma triLess {n m d : Nat} (p : n - m = neg (suc d)) : n < m \elim n, m, p
      | 0, suc m, p => zero<suc
      | suc n, suc m, p => suc<suc (triLess p)

    -- | Additive cancellation.
    \lemma cancel-right {n m : Nat} (k : Nat) (p : n + k = m + k) : n = m \elim k
      | 0 => p
      | suc k => cancel-right k (pmap pred p)

    -- | Additive cancellation.
    \lemma cancel-left (n : Nat) {m k : Nat} (p : n + m = n + k) : m = k
      => cancel-right n (+-comm *> p *> +-comm)

    -- | Multiplicative cancellation by a nonzero factor.
    \lemma cancel_*-left {k : Nat} (k/=0 : k /= 0) {n m : Nat} (p : k * n = k * m) : n = m \elim k, n, m
      | 0, _, _ => absurd (k/=0 idp)
      | _, 0, 0 => idp
      | k, suc n, suc m => pmap suc (cancel_*-left k/=0 (cancel-right k p))

    -- | Multiplicative cancellation by a nonzero factor.
    \lemma cancel_*-right {n m k : Nat} (k/=0 : k /= 0) (p : n * k = m * k) : n = m
      => cancel_*-left k/=0 (*-comm *> p *> *-comm)
  }

-- # Properties of <= and <

\open LinearOrder \hiding (Dec)

-- | Bottom join-semilattice on `Nat` with `bottom = 0`, joining the semiring's lattice structure.
\instance NatBSemilattice : BottomJoinSemilattice
  | JoinSemilattice => NatSemiring
  | bottom => 0
  | bottom-univ {_} => \case __
  \where {
    -- | Additive cancellation under `<=`.
    \lemma <=_cancel-left (n : Nat) {m k : Nat} (p : n + m <= n + k) : m <= k \elim n
      | 0 => p
      | suc n => <=_cancel-left n (suc<=suc.conv p)

    -- | Additive cancellation under `<=`.
    \lemma <=_cancel-right (n : Nat) {m k : Nat} (p : m + n <= k + n) : m <= k \elim n
      | 0 => p
      | suc n => <=_cancel-right n (suc<=suc.conv p)

    -- | `x ∧ 0 = 0` and `0 ∧ x = 0`.
    \lemma ldistr0 {x : Nat} : x ∧ 0 = 0
      => cases x idp

    -- | `x ∧ 0 = 0` and `0 ∧ x = 0`.
    \lemma rdistr0 {x : Nat} : 0 ∧ x = 0
      => cases x idp
  }

-- | `0 <= x`.
\lemma zero<=_ {x : Nat} : 0 <= x
  => NatBSemilattice.bottom-univ

-- | Monotonicity of `suc` w.r.t. `<=`, with converse `suc<=suc.conv`.
\lemma suc<=suc {x y : Nat} (p : x <= y) : suc x <= suc y
  => \case <=-dec p \with {
       | inl x<y => <=-less (suc<suc x<y)
       | inr p => rewrite p <=-refl
     }
  \where
    \lemma conv {x y : Nat} (p : suc x <= suc y) : x <= y
      => \lam y<x => p (suc<suc y<x)

\lemma -'-'r {n m k : Nat} (k<=m : k <= m) (m<=n : m <= n) : n -' (m -' k) = n -' m + k \elim n, m, k
  | 0, m, k => <=-antisymmetric zero<=_ (k<=m <=∘ m<=n)
  | suc n, 0, k => pmap (\lam x => suc (n + x)) (<=-antisymmetric zero<=_ k<=m)
  | suc n, suc m, 0 => idp
  | suc n, suc m, suc k => -'+-comm {_} {_} {1} (-'<=id <=∘ suc<=suc.conv m<=n) *> pmap suc (-'-'r (suc<=suc.conv k<=m) (suc<=suc.conv m<=n))

\lemma -'-'r_id {n k : Nat} (k<=n : k <= n) : n -' (n -' k) = k
  => -'-'r k<=n <=-refl *> pmap (+ k) -'id

-- | `n <= m` witnesses `n + (m -' n) = m`.
\lemma <=_exists {n m : Nat} (p : n <= m) : n + (m -' n) = m \elim n, m
  | 0, 0 => idp
  | 0, suc m => idp
  | suc n, suc m => \case <=-dec p \with {
    | inl (suc<suc q) => pmap suc (<=_exists (<=-less q))
    | inr q => rewrite (pmap pred q, -'id) idp
  }
  | suc n, 0 => absurd (p zero<suc)

-- | `n -' m <= n`.
\lemma -'<=id {n m : Nat} : n -' m <= n \elim n, m
  | 0, _ => zero<=_
  | suc n, 0 => <=-refl
  | suc n, suc m => -'<=id <=∘ <=_+ <=-refl (zero<=_ {1})

\func -'_suc {n m : Nat} (p : m <= n) : suc n -' m = suc (n -' m) \elim n, m
  | 0, 0 => idp
  | 0, suc m => \case suc_<=_< p
  | suc n, 0 => idp
  | suc n, suc m => -'_suc (suc<=suc.conv p)

\func -'_inv {k m : Nat} (A0 : m <= k) : k -' (k -' m) = m \elim k, m
  | 0, 0 => idp
  | 0, suc m => \case suc_<=_< A0
  | suc k, 0 => -'id
  | suc k, suc m => \let A1 => -'_inv (suc<=suc.conv A0) \in rewrite (-'_suc -'<=id, A1) idp

\lemma -'_<=+ {n m : Nat} : n <= (n -' m) + m \elim n, m
  | 0, _ => zero<=_
  | suc n, 0 => <=-refl
  | suc n, suc m => suc<=suc -'_<=+

-- | Distributes `-'` over `+` when subtrahend is bounded.
\lemma -'+-comm {n m k : Nat} (p : m <= n) : n + k -' m = n -' m + k \elim n, m, k
  | _, _, 0 => idp
  | _, 0, _ => rewrite (-'0, -'0) idp
  | 0, _, _ => rewrite (<=-antisymmetric p zero<=_, -'0) idp
  | suc n, suc m, k => -'+-comm (\lam q => p (suc<suc q))

-- | Monotonicity of `-'` in each argument (right is anti-monotone).
\lemma -'-monotone-left {n m k : Nat} (p : n <= m) : n -' k <= m -' k \elim n, m, k
  | 0, _, _ => zero<=_
  | suc n, 0, 0 => p
  | suc n, 0, suc k => absurd $ suc/=0 (<=_exists p)
  | suc n, suc m, 0 => p
  | suc n, suc m, suc k => -'-monotone-left (suc<=suc.conv p)

-- | Monotonicity of `-'` in each argument (right is anti-monotone).
\lemma -'-monotone-right {n m k : Nat} (p : m <= n) : k -' n <= k -' m \elim n, m, k
  | 0, _, _ => rewrite (<=_exists p) <=-refl
  | suc n, m, 0 => zero<=_
  | suc n, 0, suc k => -'<=id <=∘ <=_+ <=-refl (zero<=_ {1})
  | suc n, suc m, suc k => -'-monotone-right (suc<=suc.conv p)

\lemma -'_<-monotone-left {n m k : Nat} (p : n < m) (q : k < m) : n -' k < m -' k \elim n, m, k
  | 0, 0, k => p
  | 0, suc m, 0 => p
  | 0, suc m, suc k => <_-' (unsuc< q)
  | suc n, 0, 0 => p
  | suc n, 0, suc k => \case p
  | suc n, suc m, 0 => p
  | suc n, suc m, suc k => -'_<-monotone-left (unsuc< p) (unsuc< q)

-- | `n -' m = 0` implies `n <= m`.
\lemma -'_<= {n m : Nat} (p : n -' m = 0) : n <= m \elim n, m
  | 0, m => zero<=_
  | suc n, 0 => \case p
  | suc n, suc m => suc<=suc (-'_<= p)

\lemma -'_+_<= {n m k : Nat} (p : n + m <= k) : n <= k -' m \elim m, k
  | m, 0 => <=_+ <=-refl zero<=_ <=∘ p
  | 0, suc k => p
  | suc m, suc k => -'_+_<= (suc<=suc.conv p)

\lemma -'=0 {n m : Nat} (p : n <= m) : n -' m = 0 \elim n, m
  | 0, _ => idp
  | suc n, 0 => absurd (p zero<suc)
  | suc n, suc m => -'=0 (\lam q => p (suc<suc q))

\open LinearlyOrderedSemiring \hiding (Dec)

-- | Multiplication is monotone in both arguments.
\lemma <=_* {n m k l : Nat} (n<=m : n <= m) (k<=l : k <= l) : n * k <= m * l
  => <=-transitive (<=_*_positive-right zero<=_ k<=l) (<=_*_positive-left n<=m zero<=_)

-- | A strictly increasing `f : Nat -> Nat` satisfies `n <= f n`.
\lemma monotone-diagonal (f : Nat -> Nat) (mon : \Pi (n : Nat) -> suc (f n) <= f (suc n)) {n : Nat} : n <= f n \elim n
  | 0 => zero<=_
  | suc n => <=-transitive (suc<=suc (monotone-diagonal f mon)) (mon n)

-- | Iterated step inequalities promote to general `<=`-comparisons; `sequence-monotone.induction` is the additive form.
\lemma sequence-monotone {X : Preorder} {f : Nat -> X} (fm : \Pi {n : Nat} -> f n X.<= f (suc n)) {n k : Nat} (p : n <= k) : f n X.<= f k
  => transport (_ X.<= f __) (<=_exists p) induction
  \where
    \private \lemma induction {m : Nat} : f n X.<= f (n + m) \elim m
      | 0 => <=-refl
      | suc m => induction <=∘ fm

-- | Iterated step inequalities promote to general `<=`-comparisons; `sequence-monotone.induction` is the additive form.
\lemma sequence-anti-monotone {X : Preorder} {f : Nat -> X} (fm : \Pi {n : Nat} -> f (suc n) X.<= f n) {n k : Nat} (p : n <= k) : f k X.<= f n
  => sequence-monotone {X.op} fm p

-- | Conversions between `<` and `<=` shifted by `suc`.
\lemma suc_<_<= {n m : Nat} (p : n < m) : suc n <= m \elim n, m, p
  | 0, suc m, p => suc<=suc zero<=_
  | suc n, suc m, p => suc<=suc $ suc_<_<= {n} {m} (\case p \with { | suc<suc x => x })

-- | Conversions between `<` and `<=` shifted by `suc`.
\lemma <_suc_<= {n m : Nat} (p : n < suc m) : n <= m
  => \lam q => suc_<_<= p (suc<suc q)

-- | Conversions between `<` and `<=` shifted by `suc`.
\lemma suc_<=_< {n m : Nat} (p : suc n <= m) : n < m
  => id<suc <∘l p

-- | Conversions between `<` and `<=` shifted by `suc`.
\lemma <=_<_suc {n m : Nat} (p : n <= m) : n < suc m
  => suc_<=_< (suc<=suc p)

-- | `n <= suc n`.
\lemma id<=suc {n : Nat} : n <= suc n => <=_+ <=-refl (zero<=_ {1})

-- | `n * q + r < n` forces `q = 0`.
\lemma n*_+_<n {n q r : Nat} (p : n * q + r < n) : q = 0 \elim q
  | 0 => idp
  | suc q => absurd (notLess (<=-transitive (<=_+ zero<=_ <=-refl) (<=_+ <=-refl zero<=_)) p)

\open NatSemiring \hiding (<_*_positive-left, <_+-left)

-- | Uniqueness of remainder and quotient in the Euclidean decomposition.
\lemma mod-unique {n q r q' r' : Nat} (r<n : r < n) (r'<n : r' < n) (p : n * q + r = n * q' + r') : r = r' \elim q, q'
  | 0, 0 => p
  | 0, suc q' => \case n*_+_<n {n} {suc q'} (transport (< n) p r<n)
  | suc q, 0 => \case n*_+_<n {n} {suc q} (transport (< n) (inv p) r'<n)
  | suc q, suc q' =>
    \have t => +-assoc *> pmap (_ +) +-comm *> inv +-assoc *> p *> +-assoc *> pmap (_ +) +-comm *> inv +-assoc
    \in mod-unique r<n r'<n (cancel-right n t)

-- | Uniqueness of remainder and quotient in the Euclidean decomposition.
\lemma div-unique {n q r q' r' : Nat} (r<n : r < n) (r'<n : r' < n) (n/=0 : n /= 0) (p : n * q + r = n * q' + r') : q = q'
  => cancel_*-left n/=0 $ cancel-right r' $ rewrite (mod-unique r<n r'<n p) in p

-- | `n mod m <= n`.
\lemma mod<=left {n m : Nat} : n mod m <= n
  => transport (_ <=) (divModProp n m) (<=_+ zero<=_ <=-refl)

-- | `n mod m < m` when `m /= 0`.
\lemma mod<right {n m : Nat} (m/=0 : m /= 0) : n mod m < m \elim m
  | 0 => absurd (m/=0 idp)
  | suc m => fin_< (n mod suc m)

-- | When `n < m`, division yields `0` and `mod` yields `n`.
\lemma div_< {n m : Nat} (n<m : n < m) : n div m = 0
  => n*_+_<n (transportInv (< m) (divModProp n m) n<m)

-- | When `n < m`, division yields `0` and `mod` yields `n`.
\lemma mod_< {n m : Nat} (n<m : n < m) : n mod m = n
  => inv (pmap (m * __ + _) (div_< n<m)) *> divModProp n m

-- | `toFin' p = k` as naturals when `k < n`.
\lemma toFin'=id {k n : Nat} (p : k < n) : toFin' p = {Nat} k \elim n
  | suc n => mod_< p

-- | `mod_Fin k p = k` as naturals when `k < n`.
\lemma mod_Fin_< {n k : Nat} {p : 0 < n} (q : k < n) : mod_Fin k p = {Nat} k \elim n
  | suc n => mod_< q

-- | `mod_Fin k p = k` for `k : Fin n`.
\lemma mod_Fin=id {n : Nat} {k : Fin n} {p : 0 < n} : mod_Fin k p = k
  => fin_nat-inj $ mod_Fin_< (fin_< k)

-- | `x mod suc n = x` for `x : Fin (suc n)`.
\lemma fin_mod_id {n : Nat} (x : Fin (suc n)) : x mod suc n = x
  => fin_nat-inj (mod_< (fin_< x))

-- | `n * m = 1` forces `m = 1` (units in `Nat` are trivial).
\lemma natUnit {n m : Nat} (p : n * m = 1) : m = 1 \elim n, m, p
  | _, 1, _ => idp
  | 0, suc (suc n), p => \case inv NatSemiring.zro_*-left *> p

\open Monoid(LDiv)

-- | Mutually divisible naturals are equal.
\lemma natAssociates-areEqual {n m : Nat} (n|m : LDiv n m) (m|n : LDiv m n) : n = m \elim n
  | 0 => inv NatSemiring.zro_*-left *> n|m.inv-right
  | suc _ \as n =>
    \have t : m|n.inv = 1 => natUnit (cancel_*-left {n} (\case __) (inv *-assoc *> pmap (* _) n|m.inv-right *> m|n.inv-right))
    \in inv m|n.inv-right *> pmap (m *) t

-- | `n | m` with `m /= 0` implies `n <= m`.
\lemma ldiv_<= {n m : Nat} (m/=0 : m /= 0) (n|m : LDiv n m) : n <= m
  => \case n|m.inv \as k, n|m.inv-right : n * k = m \with {
    | 0, p => absurd (m/=0 (inv p))
    | suc k, p => transport (n <=) p (<=_+ zero<=_ <=-refl)
  }

\lemma ldiv*div=id {n m : Nat} (m|n : LDiv m n) : m * (n div m) = n
  => pmap (m * (n div m) +) (inv (div_mod m|n)) *> divModProp n m

-- | `n mod m = 0` produces an `LDiv m n`.
\func mod_div {n m : Nat} (p : n mod m = 0) : LDiv m n
  => rewriteI (divModProp n m) (rewrite p (\new LDiv {
    | inv => n div m
    | inv-right => idp
  }))

-- | `m | n` implies `n mod m = 0`.
\lemma div_mod {n m : Nat} (m|n : LDiv m n) : n mod m = 0 \elim n, m
  | 0, _ => idp
  | n, 0 => inv m|n.inv-right *> *-comm
  | suc x \as n, suc y \as m => mod-unique {m} {n div m} {_} {m|n.inv} (fin_< (n mod m)) zero<suc (divModProp n m *> inv m|n.inv-right)

-- | `n mod n = 0`.
\lemma id_mod {n : Nat} : n mod n = 0
  => div_mod \new LDiv {
    | inv => 1
    | inv-right => NatSemiring.ide-right
  }

-- | `(n div m) * m <= n`.
\lemma div_*<=id {n m : Nat} : n div m * m <= n
  => transport2 (<=) *-comm (Nat.divModProp n m) (<=_+ <=-refl zero<=_)

-- | Reflects the boolean test `nat_<=_Bool n m := (n -' m == 0)` into `n <= m`.
\lemma nat_<=-dec {n m : Nat} {so : So (nat_<=_Bool n m)} : n <= m
  => -'_<= (==_= so)
  \where
    -- | The underlying boolean comparison.
    \func nat_<=_Bool (n m : Nat) : Bool
      => n -' m == 0

-- | Boolean form of strict comparison `n < m`.
\lemma nat_<-dec {n m : Nat} {so : So (nat_<=-dec.nat_<=_Bool (suc n) m)} : n < m
  => id<suc <∘l nat_<=-dec {suc n} {m} {so}

-- | `n < 2^n`.
\lemma id<pow2 {n : Nat} : n < Monoid.pow 2 n \elim n
  | 0 => zero<suc
  | suc n => <=_+-left (suc_<_<= $ zero<=_ <∘r id<pow2) id<pow2

-- | Every $n$ is $2k$ or $2k+1$.
\func nat-parity (n : Nat)
  : Or (\Sigma (k : Nat) (n = 2 * k)) (\Sigma (k : Nat) (n = 2 * k + 1)) \elim n
  | 0 => inl (0, idp)
  | suc n' => \case nat-parity n' \with {
    | inl (k, p) => inr (k, pmap suc p)
    | inr (k, p) => inl (suc k, pmap suc p)
  }

-- Properties of mod

-- | `(n * q + r) mod n = r` when `r < n`.
\lemma n*_+_mod_n {n q r : Nat} (r<n : r < n) : (n * q + r) mod n = {Nat} r \elim n
  | 0 => pmap (+ r) NatSemiring.zro_*-left
  | suc n => mod-unique (fin_< _) r<n (divModProp (suc n * q + r) (suc n))

-- | `(suc n * q + r) mod suc n = r mod suc n`; `.nat` is the variant for general `n`.
\lemma n*_+_mod_n=mod {n q r : Nat} : (suc n * q + r) mod suc n = r mod suc n
  => run {
    rewriteI {1} (divModProp r (suc n)),
    rewriteI (NatSemiring.+-assoc, NatSemiring.ldistr),
    fin_nat-inj (n*_+_mod_n (fin_< (r mod suc n)))
  }
  \where
    \lemma nat {n q r : Nat} : (n * q + r) mod n = r mod n \elim n
      | 0 => pmap (+ r) NatSemiring.zro_*-left
      | suc n => n*_+_mod_n=mod

-- | Reducing one summand modulo `suc n` does not change the sum's residue.
\lemma mod_+-left {n a b : Nat} : (a mod suc n + b) mod suc n = (a + b) mod suc n
  => run {
    rewriteI {2} (divModProp a (suc n)),
    rewrite NatSemiring.+-assoc,
    inv n*_+_mod_n=mod
  }

-- | Reducing one summand modulo `suc n` does not change the sum's residue.
\lemma mod_+-right {n a b : Nat} : (a + b mod suc n) mod suc n = (a + b) mod suc n
  => fin_nat-inj (pmap (mod _) +-comm *> mod_+-left *> pmap (mod _) +-comm)

-- | Same for multiplication.
\lemma mod_*-left {n a b : Nat} : (a mod suc n * b) mod suc n = (a * b) mod suc n
  => run {
    rewriteI {2} (divModProp a (suc n)),
    rewrite (NatSemiring.rdistr, NatSemiring.*-assoc),
    inv n*_+_mod_n=mod
  }

-- | Same for multiplication.
\lemma mod_*-right {n a b : Nat} : (a * b mod suc n) mod suc n = (a * b) mod suc n
  => fin_nat-inj (pmap (mod _) *-comm *> mod_*-left *> pmap (mod _) *-comm)

-- | Congruence of `mod` under addition: equal residues remain equal after adding a common term.
\lemma mod_+-cong-left {n c a b : Nat} (p : a mod suc n = b mod suc n) : (c + a) mod suc n = (c + b) mod suc n
  => inv mod_+-right *> pmap ((c + __) mod suc n) p *> mod_+-right

-- | Congruence of `mod` under addition: equal residues remain equal after adding a common term.
\lemma mod_+-cong-right {n c a b : Nat} (p : a mod suc n = b mod suc n) : (a + c) mod suc n = (b + c) mod suc n
  => inv mod_+-left *> pmap ((__ + c) mod suc n) p *> mod_+-left

-- Properties of div

-- | `(n + m) div m = suc (n div m)` for `m /= 0`; adding the divisor increments the quotient.
\lemma div_suc-lem {n m : Nat} (m/=0 : m /= 0) : (n + m) div m = suc (n div m)
  => div-unique (mod<right m/=0) (mod<right m/=0) m/=0 $ divModProp (n + m) m *> pmap (+ m) (inv (divModProp n m) *> pmap (_ +) (inv (pmap (mod m) +-comm *> n*_+_mod_n=mod.nat {m} {1})) *> +-comm) *> +-assoc *> +-comm

-- | `(m * q + r) div m = q + r div m`; quotient on a `mq + r` decomposition.
\lemma n*_+_div_n=div {m q r : Nat} (m/=0 : m /= 0) : (m * q + r) div m = q + r div m \elim q
  | 0 => idp
  | suc q => pmap (div m) (+-assoc *> pmap (_ +) +-comm *> inv +-assoc) *> div_suc-lem m/=0 *> pmap suc (n*_+_div_n=div m/=0)

-- | `(q * m) div m = q` for nonzero `m`; division cancels a clean multiple.
\lemma *_div=id {m q : Nat} (m/=0 : m /= 0) : (q * m) div m = q
  => pmap (div m) *-comm *> n*_+_div_n=div {m} {q} {0} m/=0

{- | Monotonicity of division: `n <= k` implies `n div m <= k div m` (proved via the helper `aux` by induction on a
 -   bounding constant).
 -}
\lemma div-monotone {n k m : Nat} (p : n <= k) : n div m <= k div m
  => aux n <=-refl p
  \where
    \lemma aux (c : Nat) {n k m : Nat} (q : n <= c) (p : n <= k) : n div m <= k div m \elim c, m
      | _, 0 => p
      | 0, _ => rewrite (<=_exists q) zero<=_
      | suc c, suc _ \as m => \case LinearOrder.dec<_<= n m, LinearOrder.dec<_<= k m \with {
        | inl n<m, _ => transportInv (<= _) (div_< n<m) zero<=_
        | inr m<=n, inl k<m => absurd $ <-irreflexive $ k<m <∘l m<=n <∘l p
        | inr m<=n, inr m<=k => \case m \as m', idp : m' = m \with {
          | 0, s => rewriteI s p
          | suc xxx, s =>
            \have m/=0 m=0 => suc/=0 (s *> m=0)
            \in rewriteI (<=_exists m<=n, <=_exists m<=k, NatSemiring.+-comm) $ rewrite {2} NatSemiring.+-comm $
                  transport2 (<=) (inv $ div_suc-lem m/=0) (inv $ div_suc-lem m/=0) $ suc<=suc $ aux c (cases (n,q) \with {
                    | 0, _ => zero<=_
                    | suc n, q => -'<=id <=∘ suc<=suc.conv q
                  }) (-'-monotone-left p)
        }
      }