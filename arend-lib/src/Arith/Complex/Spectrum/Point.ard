\import Topology.MetricSpace.Complete
\import Topology.MetricSpace.Multiset
\import Topology.NormedAbGroup
\import Topology.UniformSpace
\open Monoid (pow)

{- | **A4: the spectrum of a monic polynomial, with no axiom at all.**

     Richman's reformulated fundamental theorem: the multiset of roots of a monic degree-`n`
     polynomial exists as a point of the *completion* of the space of `n`-multisets over
     $\mathbb{C}$. That is strictly weaker than "there is a root" — the multiset space is not
     complete, and a complex square root cannot be constructed without countable choice — but it is
     a genuine theorem, and it is the most that is available axiom-free.

     The construction is a filter, not a sequence, which is what keeps it choice-free: the
     approximate-factorisation sets `nearFactorSet p delta` are inhabited (A2, `approx-factor`),
     nested in `delta`, and shrink in the matching metric (A3.3, `nearFactor-match`), so they
     generate a Cauchy filter on `Array Complex n`. Points of `Multiset ComplexNormed n` *are*
     strongly regular Cauchy filters on that array space, so the completion's own completeness is
     never invoked. -}

-- | The space of completed `n`-multisets of complex numbers.
\func ComplexMultiset (n : Nat) : CompleteMetricSpace => Multiset ComplexNormed n

{- | **A ball criterion for membership in the regularisation.** `sregCF_<=` is the easy inclusion
     `sregCF F ⊆ F`; this is the converse direction one needs when *producing* facts about the
     regularised filter. Every filter below `F` is still Cauchy, so it contains an `eps`-ball
     (`cauchyFilter-metric-char`), and that ball is one of `F`'s own sets; so it is enough to know
     that *every* `eps`-ball belonging to `F` already sits inside `U`.

     This avoids reasoning about `s<=<` directly, which for a set like `nearFactorSet` would need
     continuity of `r ↦ ∏(X − rᵢ)`.

     Belongs beside `sregCF_<=` in `Topology/CoverSpace/StronglyComplete.ard`; kept here to keep the
     edit loop off that module's cone. -}
\lemma sregCF-mem {X : PseudoMetricSpace} {F : WeaklyCauchyFilter X} {U : Set X} {eps : Rat}
                  (eps>0 : 0 < eps)
                  (h : \Pi (x : X) -> F (OBall eps x) -> OBall eps x ⊆ U)
  : sregCF F U
  => \lam {G} G<=F => \case (cauchyFilter-metric-char {X} {G}).1 G.isCauchyFilter eps>0 \with {
       | inP (x, Gb) => filter-mono Gb (h x (G<=F Gb))
     }

-- | In a linear order, a nonnegative element below every positive element is zero: both
-- `Not (x < 0)` and `Not (0 < x)` hold, and `<-connectedness` closes it.
\lemma below-all-positive {x : Real} (x>=0 : 0 <= x)
                          (h : \Pi {c : Real} -> 0 < c -> x < c) : x = 0
  => <-connectedness x>=0 \lam pos => <-irreflexive (h pos)

-- | The `delta`-near factorisations of `p`: root arrays whose monic product matches `p`
-- coefficientwise to within `delta`.
\func nearFactorSet {n : Nat} (p : Poly ComplexField) (delta : Real) : Set (Array Complex n)
  => \lam r => \Pi (j : Nat) -> cabs (polyCoef (prodLin r) j - polyCoef p j) < delta

{- | **The spectrum filter.** Generated by the near-factorisation sets: `U` is large iff it contains
     every `delta`-near factorisation for some `delta > 0`.

     `filter-meet` is where the *nesting* in `delta` is used — a meet of two thresholds is a
     threshold. `isProper` is A2 and `isCauchyFilter` is A3.3, via
     `cauchyFilter-metric-char`, which reduces Cauchyness to "some element of the filter fits inside
     an `eps`-ball": take the ball around any single `delta`-near factorisation. -}
\func specSetFilter {n : Nat} (p : Poly ComplexField) : SetFilter (Array Complex n) \cowith
  | F U => ∃ (delta : Real) (0 < delta) (nearFactorSet p delta ⊆ U)
  | filter-mono (inP (d, d>0, h)) q => inP (d, d>0, h <=∘ q)
  | filter-top => inP (1, RealAbGroup.zro<ide, \lam _ => ())
  | filter-meet (inP (d1, d1>0, h1)) (inP (d2, d2>0, h2))
  => inP (d1 ∧ d2, <_meet-univ d1>0 d2>0,
          \lam hr => (h1 (\lam j => hr j <∘l meet-left), h2 (\lam j => hr j <∘l meet-right)))

\func specFilter {n : Nat} (p : Poly ComplexField) (deg : degree< p (suc n))
                 (monic : polyCoef p n = 1)
  : CauchyFilter (MultisetPseudoMetric {ComplexNormed} n) \cowith
  | SetFilter => specSetFilter p
  | isProper (inP (d, d>0, h)) => \case approx-factor p deg monic d>0 \with {
    | inP (r, hr) => inP (r, h hr)
  }
  | isCauchyFilter =>
      (cauchyFilter-metric-char {MultisetPseudoMetric {ComplexNormed} n} {specSetFilter p}).2
        \lam {eps} eps>0 => \case nearFactor-match p deg monic (rat_real_<.1 eps>0) \with {
          | inP (d, d>0, MATCH) => \case approx-factor p deg monic d>0 \with {
            | inP (r, hr) => inP (r, inP (d, d>0, \lam {s} hs => real_<_U.1 (MATCH r s hr hs)))
          }
        }

{- | **Richman's spectrum.** The root multiset of a monic degree-`n` polynomial, as a point of the
     completion of the `n`-multiset space. No axiom is used: `sregCF` regularises the spectrum filter
     and points of `ComplexMultiset n` are exactly the strongly regular Cauchy filters. -}
\func spectrum {n : Nat} (p : Poly ComplexField) (deg : degree< p (suc n))
               (monic : polyCoef p n = 1)
  : ComplexMultiset n
  => sregCF (specFilter p deg monic)

-- # Distance from a point to a multiset

{- | `minDist`'s base index is redundant: the entry it names is itself one of the entries being
     minimised over, so every choice of index gives the same value. This is what lets membership
     below pin the index at `0`. -}
\lemma minDist-indep {n : Nat} (s : Array Complex n) (z : Complex) (i i' : Fin n)
  : minDist s z i = minDist s z i'
  => <=-antisymmetric
       (bigMeet-univ {\new Array Real n (\lam j => cabs (z - s j))}
          (minDist-cond s z i i') (minDist-cond s z i))
       (bigMeet-univ {\new Array Real n (\lam j => cabs (z - s j))}
          (minDist-cond s z i' i) (minDist-cond s z i'))

{- | **`minDist _ z` is 1-Lipschitz for `rawDist`.** For an injective pairing `f`, the entry of `r`
     matched to `s j` is within `maxDist s r f` of it, so the triangle inequality at `z` bounds
     `minDist r z` by `|z - s j| + maxDist s r f` for *every* `j` — including the base index — and
     `bigMeet-univ` turns that into a bound by `minDist s z`. Being true of every injective pairing,
     it holds for the infimum by `rawDist-univ`.

     This is the estimate the plan's step 4 asks for; it is what makes membership in the completion
     well behaved without any lifting machinery. -}
\lemma minDist-lip {n : Nat} (r s : Array Complex n) (z : Complex) (i : Fin n)
  : minDist r z i <= minDist s z i + rawDist {ComplexNormed} s r
  => \have h : minDist r z i - minDist s z i <= rawDist {ComplexNormed} s r
        => rawDist-univ {ComplexNormed} \lam f fi =>
             \have | step : \Pi (j : Fin n)
                     -> minDist r z i - maxDist {ComplexNormed} s r f <= cabs (z - s j)
                      => \lam j =>
                           \have | tri : cabs (z - r (f j)) <= cabs (z - s j) + cabs (s j - r (f j))
                                    => ldist-triang {ComplexNormed} {z} {s j} {r (f j)}
                                 | mc : cabs (s j - r (f j)) <= maxDist {ComplexNormed} s r f
                                    => maxDist-cond {ComplexNormed} {n} {s} {r} {f} j
                           \in linarith (minDist-cond r z i (f j))
                   | bd : minDist r z i - maxDist {ComplexNormed} s r f <= minDist s z i
                      => bigMeet-univ {\new Array Real n (\lam j => cabs (z - s j))} (step i) step
             \in linarith
     \in linarith

-- | The same for the symmetrised `matchDist`, which is the multiset space's own distance.
\lemma minDist-lipM {n : Nat} (r s : Array Complex n) (z : Complex) (i : Fin n)
  : minDist r z i <= minDist s z i + matchDist {ComplexNormed} r s
  => minDist-lip r s z i <=∘ RealAbGroup.<=_+ <=-refl join-right

-- # Membership

-- | Arrays having an entry within `eps` of `z`. Open, and increasing in `eps`.
\func nearRootSet {m : Nat} (z : Complex) (eps : Real) : Set (Array Complex (suc m))
  => \lam r => minDist {suc m} r z 0 < eps

{- | **`z` belongs to the multiset `mu`.** Points of `ComplexMultiset (suc m)` *are* filters on
     `Array Complex (suc m)`, so this predicate needs no well-definedness argument: `mu` contains
     arrays with an entry arbitrarily close to `z`.

     Equivalent to "the extension of `minDist _ z` to the completion vanishes at `mu`", but stated so
     that no `completion-lift` plumbing is needed. -}
\func mem {m : Nat} (mu : ComplexMultiset (suc m)) (z : Complex) : \Prop
  => \Pi {eps : Real} -> 0 < eps -> mu (nearRootSet z eps)

-- # The root characterisation

-- | `polyEval (X - w) z = z - w`. Stated over an abstract `CRing` so that `equation.cRing` fires:
-- at concrete `Complex` the operations compute on `re`/`im` (arend-quirks §4).
\lemma polyEval_padd1 {R : CRing} (w z : R) : polyEval (padd 1 (negative w)) z = z - w
  => equation.cRing

{- | **One factor of the product, isolated.** `prodLin-skip` splits `∏_i (z - s_i)` as
     `(z - s_j)` times the value at `z` of the deflated product, and the latter is bounded by
     `prodLin-coefBound` (coefficients below `(1 + B)^m`) through `cabs_polyEval-boundD`.

     This is the upper bound complementing `pow<=absProd`, and it is what turns "some entry of `s` is
     close to `z`" into "the product at `z` is small". -}
\lemma absProd-factor {m : Nat} (s : Array Complex (suc m)) (z : Complex) (j : Fin (suc m))
    {B : Real} (B>=0 : 0 <= B) (hB : \Pi (i : Fin (suc m)) -> cabs (s i) <= B)
  : absProd s z <= cabs (z - s j) * (pow (1 + B) m * powSum (cabs z) (suc m))
  => \have | hB' : \Pi (i : Fin m) -> cabs (skip s j i) <= B
              => \lam i => transportInv (\lam t => cabs t <= B) (skip-sface s j i) (hB (sface j i))
           | tail : cabs (polyEval (prodLin (skip s j)) z) <= pow (1 + B) m * powSum (cabs z) (suc m)
              => cabs_polyEval-boundD (prodLin-degree (skip s j))
                   (prodLin-coefBound (skip s j) B>=0 hB') z
           | val : polyEval (prodLin s) z = (z - s j) * polyEval (prodLin (skip s j)) z
              => pmap (polyEval __ z) (prodLin-skip s j)
                 *> (polyEvalRingHom z).func-* {padd 1 (negative (s j))} {prodLin (skip s j)}
                 *> pmap (`* polyEval (prodLin (skip s j)) z) (polyEval_padd1 (s j) z)
           | eq : absProd s z = cabs (z - s j) * cabs (polyEval (prodLin (skip s j)) z)
              => inv (cabs_linProd s z) *> pmap cabs (inv (polyEval_prodLin s z) *> val)
                 *> cabs_* {z - s j} {polyEval (prodLin (skip s j)) z}
     \in rewrite eq (RealField.<=_*_positive-right (cabs>=0 {z - s j}) tail)

{- | **A root attracts every near factorisation.** If `p z = 0` then `∏_i (z - r_i)` is `|p(z) -
     ∏(X-r_i)(z)|`, which a coefficient bound of `delta` makes small; `minDist-small` converts a small
     product into a small minimum. Choice-free, and no root bound is needed — only `powSum |z| n`. -}
\lemma root-nearRoot {m : Nat} (p : Poly ComplexField) (deg : degree< p (suc (suc m)))
    (monic : polyCoef p (suc m) = 1) {z : Complex} (root : polyEval p z = 0)
    {eta : Real} (eta>0 : 0 < eta)
  : ∃ (delta : Real) (0 < delta)
      (\Pi (r : Array Complex (suc m)) -> nearFactorSet p delta r -> minDist {suc m} r z 0 < eta)
  => \case split-eps (RealField.pow>0 eta>0 {suc m})
             (linarith (powSum>=0 (cabs>=0 {z}) (suc m))
                : (0 : Real) < powSum (cabs z) (suc m) + 1) \with {
       | inP (d, d>0, dP) => inP (d, d>0, \lam r hr =>
           \have | small : absProd r z < pow eta (suc m)
                    => (=_<= (inv (cabs_linProd r z) *> pmap cabs (inv (polyEval_prodLin r z))
                              *> cabs_polyEval-diff-at-root root)
                        <=∘ cabs_polyEval-boundD
                              (degree<-monic-diff deg (prodLin-degree r) monic (prodLin-monic r))
                              (coefs-minus p r hr) z)
                       <∘r (RealField.<=_*_positive-right (<=-less d>0)
                              (linarith : powSum (cabs z) (suc m)
                                       <= powSum (cabs z) (suc m) + 1)
                            <∘r dP)
           \in minDist-small {suc m} (NatSemiring.>_/= NatOrder.zero<suc) r z 0 eta>0 small)
     }

-- | Abstract on purpose (arend-quirks §4): at concrete `Complex` the group operations compute on
-- `re`/`im` and `simplify` does not fire.
\private \lemma sub-add {G : AddGroup} (x y : G) : x = (x - y) + y => simplify

-- | The coefficients of `p - prodLin r` are what `nearFactorSet` bounds, up to `cabs_-comm`.
\private \lemma coefs-minus {n : Nat} (p : Poly ComplexField) (r : Array Complex n) {delta : Real}
    (hr : nearFactorSet p delta r) (k : Nat)
  : cabs (polyCoef (p - prodLin r) k) <= delta
  => transportInv (\lam t => cabs t <= delta) (polyCoef-minus p (prodLin r) k)
       (transport (\lam t => t <= delta) (cabs_-comm (polyCoef (prodLin r) k) (polyCoef p k))
          (<=-less (hr k)))

{- | **Near factorisations with an entry near `z` force `z` to be a root.** Split `p` as
     `(p - ∏(X-rᵢ)) + ∏(X-rᵢ)`: the first summand's coefficients are below `delta`, so
     `cabs_polyEval-boundD` bounds its value by `delta * powSum |z| n`; the second is `∏(z - rᵢ)`,
     which `absProd-factor` bounds by `|z - r j| * (1+B)^{n-1} * powSum |z| n` for the near entry `j`
     that `minDist-index` extracts. Both go below `c/2` for suitable accuracies, and `c` was
     arbitrary. The root bound `B` is A3.1. -}
\lemma nearRoot-root {m : Nat} (p : Poly ComplexField) (deg : degree< p (suc (suc m)))
    (monic : polyCoef p (suc m) = 1) {z : Complex}
    (h : \Pi {delta eta : Real} -> 0 < delta -> 0 < eta
         -> ∃ (r : Array Complex (suc m)) (nearFactorSet p delta r) (nearFactorSet p 1 r)
              (minDist {suc m} r z 0 < eta))
  : polyEval p z = 0
  => cabs_zro-ext $ below-all-positive cabs>=0 \lam {c} c>0 =>
       \case nearFactor-bound p deg monic \with {
         | inP (B, B>=1, hB) =>
           \have | B>=0 : (0 : Real) <= B => linarith
                 | P>=0 : 0 <= powSum (cabs z) (suc m) => powSum>=0 cabs>=0 (suc m)
                 | Q>=0 : 0 <= pow (1 + B) m * powSum (cabs z) (suc m)
                    => RealField.<=_*_positive_positive
                         (RealField.pow>=0 (linarith : (0 : Real) <= 1 + B)) P>=0
           \in \case split-eps (linarith : (0 : Real) < c * ratio 1 2)
                       (linarith : (0 : Real) < powSum (cabs z) (suc m) + 1) \with {
             | inP (delta, delta>0, dP) =>
               \case split-eps (linarith : (0 : Real) < c * ratio 1 2)
                       (linarith : (0 : Real) < pow (1 + B) m * powSum (cabs z) (suc m) + 1) \with {
                 | inP (eta, eta>0, dQ) =>
                   \case h delta>0 (linarith : (0 : Real) < eta * ratio 1 2) \with {
                     | inP (r, hr, hr1, hd) =>
                       \case minDist-index {suc m} r z 0 (<=-less hd)
                               (linarith : eta * ratio 1 2 < eta) \with {
                         | inP (j, hj) =>
                           \have
                           | pz-eq : polyEval p z
                                   = polyEval (p - prodLin r) z + polyEval (prodLin r) z
                              => pmap (polyEval __ z) (sub-add p (prodLin r))
                                 *> (polyEvalRingHom z).func-+
                           | val-eq : cabs (polyEval (prodLin r) z) = absProd r z
                              => pmap cabs (polyEval_prodLin r z) *> cabs_linProd r z
                           | bound1 : cabs (polyEval (p - prodLin r) z) < c * ratio 1 2
                              => cabs_polyEval-boundD
                                   (degree<-monic-diff deg (prodLin-degree r) monic
                                      (prodLin-monic r)) (coefs-minus p r hr) z
                                 <∘r (RealField.<=_*_positive-right (<=-less delta>0)
                                        (linarith : powSum (cabs z) (suc m)
                                                 <= powSum (cabs z) (suc m) + 1)
                                      <∘r dP)
                           | bound2 : cabs (polyEval (prodLin r) z) < c * ratio 1 2
                              => =_<= val-eq
                                 <∘r (absProd-factor r z j B>=0 (hB r hr1)
                                      <∘r ((RealField.<=_*_positive-left (<=-less hj) Q>=0
                                            <=∘ RealField.<=_*_positive-right (<=-less eta>0)
                                                  (linarith : pow (1 + B) m * powSum (cabs z) (suc m)
                                                           <= pow (1 + B) m
                                                              * powSum (cabs z) (suc m) + 1))
                                           <∘r dQ))
                           | total : cabs (polyEval p z)
                                  <= cabs (polyEval (p - prodLin r) z)
                                     + cabs (polyEval (prodLin r) z)
                              => rewrite pz-eq cabs_+
                           \in linarith
                       }
                   }
               }
           }
       }

{- | **From membership to concrete near factorisations.** `sregCF_<=` drops the regularisation, so
     membership hands back a threshold; intersecting it with any other two thresholds and applying A2
     produces a single array that is simultaneously as near to `p` as required and has an entry near
     `z`. The `nearFactorSet p 1` component is what A3.1's root bound needs. -}
\lemma mem-witness {m : Nat} (p : Poly ComplexField) (deg : degree< p (suc (suc m)))
    (monic : polyCoef p (suc m) = 1) {z : Complex} (h : mem (spectrum p deg monic) z)
    {delta eta : Real} (delta>0 : 0 < delta) (eta>0 : 0 < eta)
  : ∃ (r : Array Complex (suc m)) (nearFactorSet p delta r) (nearFactorSet p 1 r)
      (minDist {suc m} r z 0 < eta)
  => \case sregCF_<= (h eta>0) \with {
       | inP (d, d>0, hd) =>
         \case approx-factor p deg monic
                 (<_meet-univ d>0 (<_meet-univ delta>0 RealAbGroup.zro<ide)
                    : 0 < d ∧ (delta ∧ 1)) \with {
           | inP (r, hr) => inP (r, \lam j => hr j <∘l (meet-right <=∘ meet-left),
                                    \lam j => hr j <∘l (meet-right <=∘ meet-right),
                                    hd (\lam j => hr j <∘l meet-left))
         }
     }

{- | **A root of `p` belongs to the spectrum.** The work is in `sregCF-mem`: `nearRootSet` is not one
     of the filter's generators, so membership in the *regularised* filter is proved through the ball
     criterion. Any ball the filter contains also contains a near factorisation `r1`, which
     `root-nearRoot` puts within `e` of `z`; then `minDist-lipM` transports that to every other point
     of the ball at a cost of two ball radii. Three radii of slack, hence the `eps/3`. -}
\lemma root-mem {m : Nat} (p : Poly ComplexField) (deg : degree< p (suc (suc m)))
    (monic : polyCoef p (suc m) = 1) {z : Complex} (root : polyEval p z = 0)
  : mem (spectrum p deg monic) z
  => \lam {eps} eps>0 =>
       \case real_<-rat-char.1 (linarith : (0 : Real) < eps * ratio 1 3) \with {
         | inP (e, e>0, e<eps/3) =>
           \have | e>0' : 0 < e => rat_real_<.2 (real_<_U.2 e>0)
                 | eR<eps/3 : (e : Real) < eps * ratio 1 3 => real_<_L.2 e<eps/3
           \in sregCF-mem {MultisetPseudoMetric {ComplexNormed} (suc m)} {specFilter p deg monic}
                 {nearRootSet z eps} e>0' \lam r0 (inP (d, d>0, hd)) =>
                 \case root-nearRoot p deg monic root (rat_real_<.1 e>0' : (0 : Real) < e) \with {
                   | inP (d2, d2>0, hd2) =>
                     \case approx-factor p deg monic (<_meet-univ d>0 d2>0 : 0 < d ∧ d2) \with {
                       | inP (r1, hr1) =>
                         \have | m0 : matchDist {ComplexNormed} r0 r1 < e
                                  => real_<_U.2 (hd (\lam j => hr1 j <∘l meet-left))
                               | m1 : minDist {suc m} r1 z 0 < e
                                  => hd2 r1 (\lam j => hr1 j <∘l meet-right)
                         \in \lam {s} bs =>
                               \have | m2 : matchDist {ComplexNormed} r0 s < e => real_<_U.2 bs
                                     | lip : minDist {suc m} s z 0
                                          <= minDist {suc m} r1 z 0
                                             + matchDist {ComplexNormed} s r1
                                        => minDist-lipM {suc m} s r1 z 0
                                     | tri : matchDist {ComplexNormed} s r1
                                          <= matchDist {ComplexNormed} s r0
                                             + matchDist {ComplexNormed} r0 r1
                                        => matchDist-triang {ComplexNormed} {suc m} {s} {r0} {r1}
                                     | symm : matchDist {ComplexNormed} s r0
                                            = matchDist {ComplexNormed} r0 s
                                        => matchDist-symm {ComplexNormed} {suc m} {s} {r0}
                               \in usingOnly (m0, m1, m2, lip, tri, symm, eR<eps/3) linarith
                     }
                 }
       }

{- | **A4, the characterisation.** `z` belongs to the spectrum of `p` exactly when it is a root.

     Both directions are quantitative consequences of the estimates already in Phase A: `⟸` is
     `root-nearRoot` transported into the regularised filter, `⟹` is `nearRoot-root`. No axiom is
     used anywhere, and in particular this does *not* assert that a root exists — only that the
     spectrum, which does exist, has the roots as its members. -}
\lemma spectrum-char {m : Nat} (p : Poly ComplexField) (deg : degree< p (suc (suc m)))
    (monic : polyCoef p (suc m) = 1) (z : Complex)
  : mem (spectrum p deg monic) z <-> polyEval p z = 0
  => (\lam h => nearRoot-root p deg monic (mem-witness p deg monic h),
      root-mem p deg monic)

{- | **Sanity check.** For a polynomial that *is* a product of linear factors, every root array entry
     is a member of the spectrum. Together with `spectrum-char`'s other direction this pins down
     `spectrum (prodLin r)` as the multiset of the `r i` — the case where the answer is known. -}
\lemma spectrum-prodLin {m : Nat} (r : Array Complex (suc m)) (i : Fin (suc m))
  : mem (spectrum (prodLin r) (prodLin-degree r) (prodLin-monic r)) (r i)
  => root-mem (prodLin r) (prodLin-degree r) (prodLin-monic r) (prodLin-root r i)
