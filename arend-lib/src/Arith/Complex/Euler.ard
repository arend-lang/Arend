\import Algebra.Meta
\import Algebra.Pointed
\import Algebra.Monoid
\import Algebra.Ring
\import Algebra.Semiring
\import Arith.Complex
\import Arith.Complex.Banach
\import Arith.Complex.Norm
\import Arith.Exp
\import Arith.Real
\import Arith.Real.Field
\import Arith.Real.Pi
\import Function.Meta
\import Logic
\import Meta
\import Arith.Trig.Real
\import Paths
\import Paths.Meta
\open Complex \using (iunit \as i)
\open Monoid (pow)

{- | Every complex number decomposes as
     $z = \mathrm{fromReal}\,(\Re z) + i \cdot \mathrm{fromReal}\,(\Im z)$.
     Pure record eta — `Complex` is the record `(re im : Real)`, and the RHS
     reconstructs $z$ componentwise. Both $\Re$ and $\Im$ of the RHS reduce to
     $\Re z$ and $\Im z$ respectively after the standard ring moves (the cross
     terms $0 \cdot \_$ / $\_ \cdot 0$ vanish). -}
\lemma complex-decomp (z : Complex) : z = fromReal z.re + i * z.im
  => cring-ext

{- | Euler's formula:
     $$\exp(i \cdot \mathrm{fromReal}\,x)
       = \mathrm{fromReal}\,(\cos x) + i \cdot \mathrm{fromReal}\,(\sin x).$$
     A direct specialisation of `complex-decomp` to
     $z := \exp(i \cdot \mathrm{fromReal}\,x)$, using $\cos x = \Re z$ and
     $\sin x = \Im z$ (definitions of `cos` / `sin` in `Arith.Trig`). -}
\lemma euler {x : Real} : exp (i * x) = fromReal (cos x) + i * sin x
  => complex-decomp (exp (i * x)) *> inv (pmap2 (fromReal __ + i * fromReal __) (\peval cos x) (\peval sin x))

{- | The circle map $a \mapsto e^{it}$. Reduces to `exp (i * t)`, but naming it
     keeps `pmap` from having to guess whether its argument is a `Real` to be
     coerced or already a `Complex` — an unannotated `\lam t => exp (i * t)`
     elaborates inconsistently across the two sides of an equation. -}
\func e^i* (t : Real) : Complex => exp (i * t)

-- | $e^{i0} = 1$.
\lemma e^i*_zro : e^i* 0 = 1 => pmap exp zro_*-right *> exp_zro

-- | $e^{i(a+b)} = e^{ia}\,e^{ib}$.
\lemma e^i*_+ {a b : Real} : e^i* (a + b) = e^i* a * e^i* b
  => pmap exp cring-ext *> exp_+ cring-ext

-- | $(e^{ia})^k = e^{i(ka)}$.
\lemma pow_e^i* {a : Real} {k : Nat} : pow (e^i* a) k = e^i* (natCoef {RealField} k * a) \elim k
  | 0 => inv $ pmap e^i* (pmap (`* a) RealField.natCoefZero *> zro_*-left) *> e^i*_zro
  | suc k => pmap (`* e^i* a) pow_e^i* *> inv e^i*_+
             *> pmap e^i* (inv $ pmap (`* a) (RealField.natCoefSuc k) *> rdistr
                                *> pmap (natCoef {RealField} k * a +) ide-left)

-- | Euler's identity $e^{i\pi} = -1$, from `cos_pi` and `sin_pi`.
\lemma e^i*_pi : e^i* pi = ComplexField.negative 1
  => euler *> pmap2 (\lam c s => Complex.fromReal c + i * Complex.fromReal s) cos_pi sin_pi
     *> cring-ext
