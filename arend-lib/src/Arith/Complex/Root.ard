\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.Pointed
\import Algebra.Semiring
\import Algebra.StrictlyOrdered
\import Arith.Complex
\import Arith.Complex.Norm
\import Arith.Nat
\import Arith.Real
\import Arith.Real.Field
\import Arith.Real.Root
\import Arith.Complex.Arg
\import Arith.Complex.Euler
\import Logic
\import Logic.Meta
\import Order.Biordered
\import Order.StrictOrder
\import Paths

{- | Every nonzero complex number has a $k$-th root for $k \geq 1$.

     Take the polar form $z = |z|\,e^{i\theta}$ from `complex-arg` and assemble
     $w = \sqrt[k]{|z|}\,e^{i\theta/k}$ from the real `root` and `e^i*`. -}
\lemma complex-root {z : Complex} (rho>0 : 0 < cabs z) {k : Nat} (k>0 : 0 NatOrder.< k)
  : ∃ (w : Complex) (Monoid.pow w k = z) \elim k
  | 0 => absurd \case k>0
  | suc k-1 \as k =>
    \have kc>0 : (0 : Real) < natCoef {RealField} k => LinearlyOrderedSemiring.natCoef>0 k>0
    \in \case complex-arg rho>0 \with {
      | inP (theta, z-eq) =>
        \let | b => OrderedField.pinv (natCoef {RealField} k) kc>0 * theta
        \in inP (Complex.fromReal (root k (cabs z)) * e^i* b,
                 CMonoid.pow_*-comm {ComplexField} {Complex.fromReal (root k (cabs z))} {e^i* b} {k}
                 *> pmap2 (*)
                      (inv (Complex.fromReal_pow {root k (cabs z)} {k})
                       *> pmap Complex.fromReal (pow_root suc/=0 (<=-less rho>0)))
                      (pow_e^i*
                       *> pmap e^i* (inv *-assoc *> pmap (`* theta) (OrderedField.pinv-right kc>0) *> ide-left))
                 *> inv z-eq)
    }
