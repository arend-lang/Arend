{- | The factorial function on natural numbers and its basic positivity property.
 -
 -   This module provides the standard recursive definition of the factorial along with a fundamental lemma stating that
 -   factorials are always strictly positive. The factorial is defined directly by pattern matching on natural numbers,
 -   using `Nat.*` for the recursive multiplication step. The positivity lemma is essential for using factorials as
 -   denominators or as witnesses in combinatorial arguments where non-zero values are required.
 -}

\import Algebra.Ordered
\import Arith.Nat
\import Function.Meta
\import Logic
\import Order.StrictOrder
\import Paths.Meta

-- | The factorial function `Nat -> Nat`, defined recursively: `fac 0 = 1` and `fac (suc n) = suc n * fac n`.
\func fac (n : Nat) : Nat
  | 0 => 1
  | suc n => suc n Nat.* fac n

{- | For any `n : Nat`, `0 < fac n`. Establishes that the factorial is always strictly positive, useful whenever
 -   non-vanishing of `fac n` is required.
 -}
\lemma fac>0 {n : Nat} : 0 < fac n \elim n
  | 0 => NatOrder.zero<suc
  | suc n => rewrite NatSemiring.*-comm $ NatSemiring.<=_+-left zero<=_ fac>0

\lemma fac/=0 {n : Nat} : fac n /= 0
  => NatSemiring.>_/= fac>0