{- | The simplicial nerve of a category.

     For a category {C}, we construct a right fibration {snerve-proj} over the simplex category {DeltaCat} (a simplicial type)
     whose fiber over `[n]` is the type of functors from `[n]` to {C} ({snerve-nu-equiv}), and whose transport along a monotone map
     `d : [n] -> [n']` is precomposition with `d` ({snerve-nu-tr}).

     This is an instance of {Exp}: take `X` to be the nerve of the category {SimplexVert} of simplices with a chosen vertex,
     `R [n] (m,j) = Δ([m],[n])` ({simplexHom}), and `W` the vertex-preserving arrows ({IsVertPres}). The category of elements `K_n`
     of `R [n]` is the nerve of the strict category of simplices of `[n]` with a vertex ({elMap-equiv}), and the vertex functor
     {svert} to `[n]` has a fully faithful left adjoint {ssec} whose counit preserves vertices, so `K_n` localizes to `[n]`.
 -}

\import Arith.Fin.Order
\import Arith.Nat
\import Category
\import Category.Functor
\import Category.Simplex
\import Equiv
\import Function.Meta
\import InfCat.Basics
\import InfCat.Fibration.Categorical
\import InfCat.Fibration.ExponentRight
\import InfCat.Fibration.LeftFib
\import InfCat.Fibration.RightFib
\import InfCat.Fibration.SimplexFib
\import InfCat.Functor.Conservative
\import InfCat.Functor.Equiv
\import InfCat.Localization.Abstract
\import InfCat.Localization.Concrete
\import InfCat.Nerve.Nerve
\import InfCat.Nerve.NerveHom
\import InfCat.Nerve.NerveNat
\import InfCat.Nerve.NerveSet
\import InfCat.Paths
\import InfCat.Rezk
\import InfCat.SubCat.Full
\import Logic
\import Logic.Unique
\import Order.PartialOrder
\import Paths
\import Paths.Meta
\import Set.SetCategory
\open FullSubCat (inc)
\open snerve-loc-equiv

-- # Simplices with a vertex

-- | The poset `[n]`.
\func Simplex (n : Nat) : Preorder
  => FinOrder (suc n)

{- | Simplices with a chosen vertex. An arrow `(k,l) -> (m,j)` is a monotone map `f : [m] -> [k]` with `l <= f j`.
 -   Simplicial operators act on simplices by precomposition, so this is covariant in `X`.
 -}
\func SimplexVert : Precat \cowith
  | Ob => \Sigma (m : Nat) (Fin (suc m))
  | Hom x y => \Sigma (f : Hom {SimplexCat} y.1 x.1) (x.2 <= f y.2)
  | id {x} => (id {SimplexCat} {x.1}, <=-refl)
  | o {x} {y} {z} g f => (Precat.o {SimplexCat} f.1 g.1, f.2 <=∘ func-<= {f.1} g.2)
  | id-left => ext idp
  | id-right => ext idp
  | o-assoc => ext idp

-- | A vertex-preserving arrow.
\type IsVertPres {x y : SimplexVert} (h : Hom {SimplexVert} x y) : \Prop
  => x.2 = h.1 y.2

-- | The functor `(m,j) ↦ Δ([m],[n])`.
\func simplexHom (n : Nat) : Functor SimplexVert SetCat \cowith
  | F x => Hom {SimplexCat} x.1 n
  | Func h e => Precat.o {SimplexCat} e h.1
  | Func-id => idp
  | Func-o => idp

-- | The functor `[n] ↦ simplexHom n`; simplicial operators act by postcomposition.
\func simplexHomFun : Functor SimplexCat (FunctorPrecat SimplexVert SetCat) \cowith
  | F => simplexHom
  | Func d => \new NatTrans {
    | trans x e => d SimplexCat.∘ e
    | natural h => idp
  }
  | Func-id => idp
  | Func-o => idp

-- # The simplicial nerve

-- | `R [n] (m,j) = Δ([m],[n])` on nerves.
\type SimplexR (b :⁺ DeltaCat) (x :⁺ Nerve SimplexVert) : \Type0
  => inc (setFam2 simplexHomFun b x)

-- | Transport in {SimplexR} is transport in its body.
\sfunc SimplexR-coe+ {b' b : DeltaCat} (beta : b' ~> b) {x : Nerve SimplexVert} (e : SimplexR b' x)
  : coe+ (\lam i => inc (setFam2 simplexHomFun (beta i) x)) e dright = coe+ (\lam i => SimplexR (beta i) x) e dright
  => coe+-dpath (dpath {\lam i => inc (setFam2 simplexHomFun (beta i) x)} \lam i => coe+ (\lam i => SimplexR (beta i) x) e i)

-- | Vertex-preserving arrows of the nerve of {SimplexVert}.
\type SimplexW (a : DI ->⁺ Nerve SimplexVert) : \Prop
  => NerveW {SimplexVert} IsVertPres a

-- | The total category of the simplicial nerve of {C}.
\func SNerve.{u} (C : \Cat u) : \Cat
  => Exp C (\lam b x => SimplexR b x) SimplexW

-- | The projection of the simplicial nerve to the simplex category.
\func snerve-proj.{u} (C : \Cat u) (z :⁺ SNerve C) : DeltaCat
  => exp-proj C (\lam b x => SimplexR b x) SimplexW z

-- | The fibers of the simplicial nerve of {C}.
\func SNerveFib.{u} (C : \Cat u) (b :⁺ DeltaCat) : \Cat
  => Fibers (snerve-proj.{u} C) b

\lemma snerve-rightFib.{u} {C : \Cat u} : IsRightFib (SNerveFib C)
  => exp-rightFib {_} {_} {C} {\lam b x => SimplexR b x} {SimplexW}

-- # The localization of `K_n` to `[n]`

-- | Functors out of `K_n` inverting {SimplexW} are functors out of `[n]`, by restriction along {rK}.
\lemma snerve-loc-equiv.{u} (n : Nat) {C : \Cat u}
  : IsEquiv {MapW (ExpW {_} {\lam x => SimplexR (nerveOb n) x} SimplexW) C} {Nerve (Simplex n) ->⁺ C} (\lam s t => s.1 (rK n t))
  => IsEquiv.trans (mapW-precomp-equiv (elK-equiv n)) $
     IsEquiv.trans (inP \new QEquiv {MapW (\lam a => SimplexW (\lam i => (elK n (a i)).1)) C} {MapW (KW n) C} {
       | f s => (s.1, \lam {a} w => s.2 w)
       | ret s => (s.1, \lam {a} w => s.2 w)
       | ret_f _ => idp
       | f_sec _ => idp
     }) $ radj-isLocalization.radj-section-equiv (nvert-inverts n) (\lam t => nsec n t)
                 (ncounit n) (nunit n) (nunit-iso n) (\lam F Fw x => Fw (ncounit-W n x))
  \where {
    -- | Simplices of `[n]` with a vertex.
    \func SimplexUnder (n : Nat) : Precat.{0,0}
      => ElPrecat (simplexHom n)

    -- | Arrows of {SimplexUnder} are determined by their maps.
    \lemma sunder-hom-ext {n : Nat} {s t : SimplexUnder n} {h h' : Hom {SimplexUnder n} s t} (p : h.1.1 = h'.1.1) : h = h'
      => ext (ext p)

    -- | The vertex functor `(m, j, e) ↦ e j`.
    \func svert (n : Nat) : Functor (SimplexUnder n) (Simplex n) \cowith
      | F s => s.2 s.1.2
      | Func {s} {t} h => s.2.func-<= h.1.2 <=∘ transport (\lam (g : SimplexCat.Hom t.1.1 n) => s.2 (h.1.1 t.1.2) <= g t.1.2) h.2 <=-refl
      | Func-id => prop-pi
      | Func-o => prop-pi

    -- | The top simplex with a vertex, `t ↦ (n, t, id)`.
    \func ssec (n : Nat) : Functor (Simplex n) (SimplexUnder n) \cowith
      | F t => ((n, t), SimplexCat.id {n})
      | Func p => ((SimplexCat.id {n}, p), idp)
      | Func-id {t} => sunder-hom-ext {n} {(n, t), SimplexCat.id {n}} {(n, t), SimplexCat.id {n}} idp
      | Func-o {t} {_} {t''} {_} {_} => sunder-hom-ext {n} {(n, t), SimplexCat.id {n}} {(n, t''), SimplexCat.id {n}} idp

    -- | The counit `(n, e j, id) -> (m, j, e)`.
    \func scounit {n : Nat} (s : SimplexUnder n) : Hom {SimplexUnder n} (ssec n (svert n s)) s
      => ((s.2, <=-refl), idp)

    \lemma scounit-natural {n : Nat} {s t : SimplexUnder n} (h : Hom {SimplexUnder n} s t)
      : (SimplexUnder n).o {ssec n (svert n s)} {ssec n (svert n t)} (scounit t) ((ssec n).Func ((svert n).Func h))
        = (SimplexUnder n).o {ssec n (svert n s)} h (scounit s)
      => sunder-hom-ext {n} {ssec n (svert n s)} {t} (inv h.2)

    -- | Vertex preservation is invariant under isomorphisms.
    \lemma vertPres-iso {x x' y y' : SimplexVert} (u : Iso {SimplexVert} {x'} {x}) (v : Iso {SimplexVert} {y} {y'}) (h : SimplexVert.Hom x y)
                        (q : IsVertPres h) : IsVertPres (v.f SimplexVert.∘ (h SimplexVert.∘ u.f))
      => \have | ux : x'.2 = u.f.1 x.2 => <=-antisymmetric u.f.2 (u.f.1.func-<= u.hinv.2 <=∘ transportInv (<= x'.2) (path \lam i => (u.hinv_f i).1 x'.2) <=-refl)
               | vy : y.2 = v.f.1 y'.2 => <=-antisymmetric v.f.2 (v.f.1.func-<= v.hinv.2 <=∘ transportInv (<= y.2) (path \lam i => (v.hinv_f i).1 y.2) <=-refl)
         \in ux *> pmap u.f.1 (q *> pmap h.1 vy)

    -- | The vertex functor on nerves.
    \func nvert (n : Nat) (x :⁺ Nerve (SimplexUnder n)) : Nerve (Simplex n)
      => nerveMap (svert n) x

    -- | The top simplex functor on nerves.
    \func nsec (n : Nat) (t :⁺ Nerve (Simplex n)) : Nerve (SimplexUnder n)
      => nerveMap (ssec n) t

    -- | Hom-types of the nerve of `[n]` are propositions.
    \lemma simplex-thin {n : Nat} {a b : Nerve (Simplex n)} : isProp (a ~> b)
      => nerve-preorder-prop a b

    -- | The counit `nsec ∘ nvert -> id`.
    \func ncounit (n : Nat) (x :⁺ Nerve (SimplexUnder n)) : nsec n (nvert n x) ~> x
      => nerve-nat nerve-isTruncCat (\lam x => nsec n (nvert n x)) (\lam x => x) (ncounit.cmp n) (ncounit.natural n) x
      \where {
        \func cmp (n : Nat) (s : SimplexUnder n) : nsec n (nvert n (nerveOb s)) ~> nerveOb s
          => nerveHom {SimplexUnder n} (scounit s)

        \sfunc natural (n : Nat) {s t : SimplexUnder n} (f : Hom {SimplexUnder n} s t)
          : comp (dmap (\lam x => nsec n (nvert n x)) (nerveHom f)) (cmp n t) = comp (cmp n s) (dmap (\lam x => x) (nerveHom f))
          => nerveHom-comp *> pmap (nerveHom {SimplexUnder n} {ssec n (svert n s)}) (scounit-natural f) *> inv nerveHom-comp

        \sfunc ob (n : Nat) (s : SimplexUnder n) : ncounit n (nerveOb s) = nerveHom {SimplexUnder n} (scounit s)
          => nerve-nat.ob {SimplexUnder n} s
      }

    -- | The unit `nvert ∘ nsec -> id`; its components are identities.
    \func nunit (n : Nat) (t :⁺ Nerve (Simplex n)) : nvert n (nsec n t) ~> t
      => nerve-nat nerve-isTruncCat (\lam t => nvert n (nsec n t)) (\lam t => t) (\lam t => idd) (\lam f => simplex-thin _ _) t

    \lemma nunit-iso (n : Nat) (t : Nerve (Simplex n)) : IsIso (nunit n t)
      => inP (nerve-nat nerve-isTruncCat (\lam t => t) (\lam t => nvert n (nsec n t)) (\lam t => idd) (\lam f => simplex-thin _ _) t,
              simplex-thin _ _, simplex-thin _ _)

    -- | The category of elements `K_n` of `R [n]`.
    \type KTot (n : Nat) : \Cat
      => \Sigma⁺ (x : Nerve SimplexVert) (SimplexR (nerveOb n) x)

    -- | The comparison from the nerve of {SimplexUnder} to `K_n`.
    \func elK (n : Nat) (x :⁺ Nerve (SimplexUnder n)) : KTot n
      => elK-equiv.toK (elMap (simplexHom n) x)

    \lemma elK-equiv (n : Nat) : IsHEquiv {_} {\Sigma⁺ (x : Nerve SimplexVert) (SimplexR (nerveOb n) x)} (\lam x => elK n x)
      => IsHEquiv.trans (elMap-equiv (simplexHom n)) {toK} toK-equiv
      \where {
        \func toK {n : Nat} (p :⁺ \Sigma⁺ (x : Nerve SimplexVert) (inc (setFam (simplexHom n) x))) : \Sigma⁺ (x : Nerve SimplexVert) (SimplexR (nerveOb n) x)
          => (p.1, p.2)

        \lemma toK-equiv {n : Nat} : IsHEquiv (toK {n})
          => inP \new HQEquiv {
            | finv p => (p.1, p.2)
            | finv_f _ => idp
            | f_finv _ => idp
          }
      }

    -- | The arrows of the nerve of {SimplexUnder} whose image in the nerve of {SimplexVert} is vertex-preserving.
    \type KW (n : Nat) (a : DI ->⁺ Nerve (SimplexUnder n)) : \Prop
      => SimplexW (\lam i => (elK n (a i)).1)

    \lemma nvert-inverts (n : Nat) : InvertsW (KW n) (nvert n)
      => \lam {a} w => \case nerve-arrow-strict a \with {
        | inP (s, t, h, p) => transport (\lam a => KW n a -> IsIso (dpath \lam i => nvert n (a i))) p (strict-case h) w
      }
      \where {
        \lemma strict-case {n : Nat} {s t : SimplexUnder n} (h : (SimplexUnder n).Hom s t) (w : KW n (\lam i => nerveHom h i))
          : IsIso (dpath \lam i => nvert n (nerveHom h i)) \elim w
          | inP (x, y, hT, q, e) =>
            \have | vp : IsVertPres h.1 => nerve-strict-transfer {SimplexVert} IsVertPres vertPres-iso hT h.1 e q
                  | eq : svert n s = svert n t => pmap s.2 vp *> path (\lam i => (h.2 i) t.1.2)
            \in inP (nerveHom (transport (<= svert n s) eq <=-refl), simplex-thin _ _, simplex-thin _ _)
      }

    -- | The counit is in {KW}.
    \lemma ncounit-W (n : Nat) (x : Nerve (SimplexUnder n)) : KW n (\lam i => ncounit n x i)
      => \case nerveOb-surj x \with {
        | inP (s, p) => transport (\lam x => KW n (\lam i => ncounit n x i)) p $
            transportInv (\lam c => KW n (\lam i => c i)) (ncounit.ob n s) (inP (_, _, (scounit s).1, idp, idp))
      }

    -- | The section `[n] -> K_n`, `t ↦ (n, t, id)`.
    \func rK (n : Nat) (t :⁺ Nerve (Simplex n)) : KTot n
      => elK n (nsec n t)
  }

-- # Transport

-- | The functor `[n] -> C` corresponding to an `n`-simplex of the nerve.
\func snerve-nu.{u} {C : \Cat u} (n : Nat) (z : SNerveFib C (nerveOb n)) (t :⁺ Nerve (Simplex n)) : C
  => (exp-nu {_} {_} {C} {SimplexR} (nerveOb n) z).1 (rK n t)

-- | `n`-simplices of the nerve are functors `[n] -> C`.
\lemma snerve-nu-equiv.{u} {C : \Cat u} (n : Nat)
  : IsEquiv {SNerveFib C (nerveOb n)} {Nerve (Simplex n) ->⁺ C} (snerve-nu n)
  => IsEquiv.trans (exp-nu-equiv {_} {_} {C} {SimplexR} (nerveOb n)) (snerve-loc-equiv n)

-- | Transport along a simplicial operator {d} is precomposition with {d}.
\sfunc snerve-nu-tr.{u} {C : \Cat u} {n n' : Nat} (d : SimplexCat.Hom n n') (z : SNerveFib C (nerveOb n')) {t :⁺ Nerve (Simplex n)}
  : snerve-nu n (rightFib-tr (exp-rightFib {_} {_} {C} {SimplexR}) (nerveHom d) z) t = snerve-nu n' z (nerveMap d t)
  => exp-nu-tr (nerveHom {SimplexCat} d) z
     *> pmap+ (\lam e => (nuG n' z).1 ((rK n t).1, e))
              (coe+-dpath (dpath (coe+ (\lam i => SimplexR (nerveHom {SimplexCat} d i) (rK n t).1) (rK n t).2)))
     *> pmap+ (\lam k => (nuG n' z).1 k) (kd-path d (nsec n t))
     *> inv (path \lam i => counit-path d (nuG n' z) i t)
     *> pmap+ (\lam u => (nuG n' z).1 (elK n' (nsec n' u))) (spost-vert d t)
  \where \private {
    \func nuG.{u} {C : \Cat u} (n' : Nat) (z : SNerveFib C (nerveOb n')) : MapW (ExpW SimplexW) C
      => exp-nu {_} {_} {C} {SimplexR} (nerveOb n') z

    -- | The counit of `K_{n'}` at `K_d ∘ nsec` is inverted by {G}.
    \sfunc counit-path.{u} {C : \Cat u} {n n' : Nat} (d : SimplexCat.Hom n n') (G : MapW (ExpW {_} {SimplexR (nerveOb n')} SimplexW) C)
      : (\lam t => G.1 (elK n' (nsec n' (nvert n' (nerveMap (spost d) (nsec n t))))))
        = {Nerve (Simplex n) ->⁺ C} (\lam t => G.1 (elK n' (nerveMap (spost d) (nsec n t))))
      => natIso-path (\lam t => dmap (\lam x => G.1 (elK n' x)) (ncounit n' (nerveMap (spost d) (nsec n t))))
                     (\lam t => G.2 {\lam i => elK n' (ncounit n' (nerveMap (spost d) (nsec n t)) i)} (ncounit-W n' (nerveMap (spost d) (nsec n t))))

    -- | Postcomposition `(m, j, e) ↦ (m, j, d ∘ e)`.
    \func spost {n n' : Nat} (d : SimplexCat.Hom n n') : Functor (SimplexUnder n) (SimplexUnder n') \cowith
      | F s => (s.1, d SimplexCat.∘ s.2)
      | Func {s} {t} h => (h.1, path \lam i => d SimplexCat.∘ h.2 i)
      | Func-id {s} => sunder-hom-ext {n'} {s.1, d SimplexCat.∘ s.2} {s.1, d SimplexCat.∘ s.2} idp
      | Func-o {s} {_} {t} {_} {_} => sunder-hom-ext {n'} {s.1, d SimplexCat.∘ s.2} {t.1, d SimplexCat.∘ t.2} idp

    -- | The functor `K_d` between categories of elements is postcomposition on the strict categories of elements.
    \sfunc kd-path {n n' : Nat} (d : Hom {SimplexCat} n n') (x :⁺ Nerve (SimplexUnder n))
      : expMap SimplexR (nerveHom {SimplexCat} d) (elK n x) = elK n' (nerveMap (spost d) x)
      => pmap+ elK-equiv.toK (path \lam i => fun d i x)
      \where \private {
        \func Tot (n' : Nat)
          => \Sigma⁺ (x : Nerve SimplexVert) (inc (setFam (simplexHom n') x))

        \func proj {n' : Nat} (p :⁺ Tot n') : Nerve SimplexVert
          => p.1

        \func fromK {n' : Nat} (p :⁺ KTot n') : Tot n'
          => (p.1, p.2)

        \sfunc fun {n n' : Nat} (d : Hom {SimplexCat} n n')
          : (\lam x =>⁺ fromK (expMap SimplexR (nerveHom {SimplexCat} d) (elK n x))) = (\lam x =>⁺ elMap (simplexHom n') (nerveMap (spost d) x))
          => nerve-maps-ext' (setTotal-IsTruncCat nerve-isTruncCat \lam x => setFam (simplexHom n') x) (ob d)
               \lam {s} {t} f => setTotal-hom-ext (dmap_comp proj *> pmap (comp _) (dmap_=_~> proj) *> comp_idd-right
                                                   *> inv (dmap_comp proj *> pmap (comp __ _) (dmap_=_~> proj) *> comp_idd-left))

        \func ob {n n' : Nat} (d : Hom {SimplexCat} n n') (s : SimplexUnder n)
          : fromK (expMap SimplexR (nerveHom {SimplexCat} d) (elK n (nerveOb s))) = elMap (simplexHom n') (nerveOb (spost d s))
          => pmap (\lam e => ((nerveOb s.1, e) : Tot n')) (inv (SimplexR-coe+ (nerveHom {SimplexCat} d) s.2) *> setFam2-tr simplexHomFun d s.1 s.2)
      }

    -- | `nvert ∘ K_d ∘ nsec` is `d`.
    \sfunc spost-vert {n n' : Nat} (d : Hom {SimplexCat} n n') (t :⁺ Nerve (Simplex n))
      : nvert n' (nerveMap (spost d) (nsec n t)) = nerveMap d t
      => path \lam i => nerve-maps-ext' nerve-isTruncCat (\lam _ => idp) (\lam f => simplex-thin _ _) i t
  }