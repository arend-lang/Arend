\import Category
\import Category.Functor
\import InfCat.Basics
\import Logic
\import InfCat.Nerve.Nerve
\import InfCat.Square
\import InfCat.Trunc.ArrowFam
\import InfCat.Trunc.IsCatTrunc
\import Paths
\import Homotopy.HLevel
\import Equiv

{- | A natural transformation between functors out of a nerve into a 1-category
 -   is determined by its components at vertices, provided they are natural with respect to edges.
 -}
\func nerve-nat {C : Precat} {Z : \Cat} (Zt : IsTruncCat 1 Z) (F G : Nerve C ->⁺ Z)
                (t : \Pi (x : C) -> F (nerveOb x) ~> G (nerveOb x))
                (tn : \Pi {x y : C} (f : Hom x y) -> comp (dmap F (nerveHom f)) (t y) = comp (t x) (dmap G (nerveHom f)))
                (e :⁺ Nerve C) : F e ~> G e
  => nerve-section T Tt t0 square rc ri e
  \where \protected {
    \type T (e :⁺ Nerve C) : \Type => F e ~> G e

    \func t0 (x : C) : T (nerveOb x) => t x

    \func toB (p :⁺ \Sigma⁺ (e : Nerve C) (T e)) : \Sigma⁺ (e : Nerve C) (F e ~> G e) => (p.1, p.2)

    \func fromB (p :⁺ \Sigma⁺ (e : Nerve C) (F e ~> G e)) : \Sigma⁺ (e : Nerve C) (T e) => (p.1, p.2)

    \lemma Tt : IsTruncCat 1 (\Sigma⁺ (e : Nerve C) (T e))
      => \lam p q => HLevel-retracts (\new QEquiv {p ~> q} {toB p ~> toB q} {
           | f u => dmap toB u
           | ret v => dmap fromB v
           | ret_f _ => idp
           | f_sec _ => idp
         }) {1} (transf-IsTruncCat nerve-isTruncCat Zt F G (toB p) (toB q))

    \func square {x y : C} (f : Hom x y) : DPath (\lam i => T (nerve-edge {C} f i)) (t0 x) (t0 y)
      => dpath {\lam i => T (nerve-edge {C} f i)} \lam i => (square-equiv (dmap F (nerveHom f)) (dmap G (nerveHom f))).ret (tn f) i

    \sfunc rc {x y z : C} (f : Hom x y) (g : Hom y z)
      : comp (nerve-total-edge T square f) (nerve-total-edge T square g) = nerve-total-edge T square (g ∘ f)
      => pmap (dmap fromB) (transf-hom-ext Zt {_} {_} {_} {_} {dmap toB (comp (nerve-total-edge T square f) (nerve-total-edge T square g))}
                                           {dmap toB (nerve-total-edge T square (g ∘ f))}
                                           (dmap_comp (\lam (p : \Sigma⁺ (e : Nerve C) (T e)) => p.1) *> nerveHom-comp))

    \sfunc ri (x : C) : nerve-total-edge T square (C.id {x}) = idd
      => pmap (dmap fromB) (transf-hom-ext Zt {_} {_} {_} {_} {dmap toB (nerve-total-edge T square (C.id {x}))} {idd} nerveHom-id)

    -- | The component of {nerve-nat} at a vertex.
    \sfunc ob (x : C) : nerve-nat Zt F G t tn (nerveOb x) = t x
      => path \lam i => nerve-section.base-eval {C} {T} {Tt} {t0} {square} {rc} {ri} x i
  }

-- | The nerve of a natural transformation.
\sfunc nerveNat {C D : Precat} {F G : Functor C D} (a : NatTrans F G) (e :⁺ Nerve C) : nerveMap F e ~> nerveMap G e
  => nerve-nat nerve-isTruncCat (nerveMap F) (nerveMap G) (\lam x => nerveHom (a x))
               (\lam f => nerveHom-comp *> pmap nerveHom (a.natural f) *> inv nerveHom-comp) e

-- | Covariant families of arrows into a 1-category are equal if they agree at vertices.
\sfunc nerve-arrow-ext {C : Precat} {Z : \Cat} (Zt : IsTruncCat 1 Z) {F G : Nerve C ->⁺ Z} (s1 s2 : \Pi (e :⁺ Nerve C) -> F e ~> G e)
                       (v : \Pi (x : C) -> s1 (nerveOb x) = s2 (nerveOb x)) (e :⁺ Nerve C) : s1 e = s2 e
  => arrow-fam-ext Zt s1 s2 (\lam e => \scase nerveOb-surj e \return s1 e = s2 e \level hom-isSet Zt _ _ (s1 e) (s2 e) \with {
       | inP (x, p) => transport (\lam e' => s1 e' = s2 e') p (v x)
     }) e