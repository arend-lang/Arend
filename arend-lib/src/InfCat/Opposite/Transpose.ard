{- | Transposition of functors along {Op}: functors `Op C ->⁺ D` are functors `C ->⁺ Op D`.
 -
 -   {opTranspose} sends `F : Op C ->⁺ D` to `OpFunc F ∘ toOpOp`. It is an equivalence ({opTranspose-equiv})
 -   since {OpFunc} is an equivalence on functors ({OpFunc-equiv}): applying {OpFunc} twice is conjugation by {toOpOp}
 -   ({toOpOp-natural}), so the claim follows by 2-out-of-6. Transposition is natural in {C} ({opTranspose-precomp}),
 -   and `opTranspose F` inverts {b} if and only if {F} inverts the opposite arrow `opArr b` ({opTranspose-iso}).
 -}

\import Equiv
\import Equiv.Path
\import Equiv.Sigma
\import Function.Meta
\import InfCat.Basics
\import InfCat.Fibration.Categorical
\import InfCat.Fibration.Univalence.DirectedUnivalence
\import InfCat.Fibration.Univalence.Straightening
\import InfCat.Functor.Equiv
\import InfCat.Functor.FullyFaithful
\import InfCat.Kan.LeftKanExtType
\import InfCat.Opposite
\import InfCat.Paths
\import InfCat.Rezk
\import InfCat.Yoneda.CovariantYoneda
\import InfCat.Yoneda.YonedaLemma
\import Logic
\import Logic.Unique
\import Meta
\import Paths
\import Paths.Meta

-- | The transpose `C ->⁺ Op D` of a functor `Op C ->⁺ D`.
\func opTranspose.{u} {C D : \Cat u} (F : Op C ->⁺ D) (x :⁺ C) : Op D
  => OpFunc F (toOpOp x)

-- | {OpFunc} is an equivalence on functors.
\lemma OpFunc-equiv.{u} {A B : \Cat u} : IsEquiv {A ->⁺ B} {Op A ->⁺ Op B} OpFunc
  => \case twice-equiv {A} {B}, twice-equiv {Op A} {Op B} \with {
       | inP gf, inP hg => inP $ QEquiv.leftFactor (later \new Section {
           | f H w => OpFunc H w
           | ret K => hg.ret (\lam w => OpFunc K w)
           | ret_f H => hg.ret_f H
         }) gf
     }
  \where {
    -- | Applying {OpFunc} twice is an equivalence, since it is conjugation by {toOpOp}.
    \lemma twice-equiv.{u} {A B : \Cat u} : IsEquiv {A ->⁺ B} {Op (Op A) ->⁺ Op (Op B)} (\lam F => OpFunc (\lam z => OpFunc F z))
      => IsEquiv.leftFactor (IsHEquiv.toIsEquiv (IsHEquiv.precomp toOpOp.isEquiv)) $
           transport IsEquiv (ext \lam F a => inv toOpOp-natural)
                     (IsHEquiv.toIsEquiv (IsHEquiv.postcomp toOpOp.isEquiv))
  }

-- | {OpFunc} preserves and reflects equivalences.
\lemma OpFunc-hequiv.{u} {A B : \Cat u} {f : A ->⁺ B} : IsHEquiv f <-> IsHEquiv (OpFunc f)
  => (preserve, \lam e => IsHEquiv.leftFactor toOpOp.isEquiv $ transport IsHEquiv (funExt+ \lam x => toOpOp-natural)
                             (IsHEquiv.trans toOpOp.isEquiv (preserve e)))
  \where
    \lemma preserve.{v} {A B : \Cat v} {f : A ->⁺ B} (e : IsHEquiv f) : IsHEquiv (OpFunc f)
      => IsHEquiv.biEquiv {_} {_} {OpFunc f} {OpFunc (IsHEquiv.ret e)}
           (\lam z => inv OpFunc-comp *> path (\lam i => OpFunc (funExt+ (\lam x => IsHEquiv.ret_f e) i) z) *> OpFunc-id)
           (\lam z => inv OpFunc-comp *> path (\lam i => OpFunc (funExt+ (\lam y => IsHEquiv.f_ret e) i) z) *> OpFunc-id)

-- | {opTranspose} is an equivalence.
\lemma opTranspose-equiv.{u} {C D : \Cat u} : IsEquiv {Op C ->⁺ D} {C ->⁺ Op D} opTranspose
  => IsEquiv.trans OpFunc-equiv (IsHEquiv.toIsEquiv (IsHEquiv.precomp toOpOp.isEquiv))

-- | Transposition is natural.
\sfunc opTranspose-precomp.{u} {C' C D : \Cat u} {g : C' ->⁺ C} {G : Op C ->⁺ D} {x :⁺ C'}
  : opTranspose (\lam z => G (OpFunc g z)) x = opTranspose G (g x)
  => OpFunc-comp *> pmap+ (OpFunc G) toOpOp-natural

-- | The transpose of {F} inverts {b} if and only if {F} inverts the opposite arrow of {b}.
\lemma opTranspose-iso.{u} {C D : \Cat u} (F : Op C ->⁺ D) {x y : C} (b : x ~> y)
  : IsIso (dmap (opTranspose F) b) <-> IsIso (dmap F (opArr b))
  => \let | K : ~>_-> (dmap (yoneda y) (opArr b)) (Op.Hom-idd y) = ~>_-> (dmap (ReprFunctor x) b) (Op.Hom-idd x)
              => inv (ReprFunctor.equiv.ret_f _) *> pmap Straight.toStraight opArr.unop *> inv (ReprFunctor-transport-idd b)
          | U => univElem-iso-char
                   (leftKanExtType-univElem F (yonedaLemma x)) (leftKanExtType-univElem F (yonedaLemma y))
                   (~>_->-natural (\lam w e => ~>_-> (dmap (__ w) (leftKanExtType-unit F (yoneda y))) e) (opArr b)
                    *> pmap (~>_-> (dmap (__ (Op.toOp x)) (leftKanExtType-unit F (yoneda y)))) K
                    *> inv (~>_->-natural (\lam z e => ~>_-> (dmap (__ (Op.toOp x)) (leftKanExtType-unit F (yoneda z))) e) b))
          | e : (\lam z =>⁺ Op.Hom (opTranspose F z)) = (\lam z =>⁺ LeftKanExtType F (yoneda z))
              => funExt+ \lam z => OpFunc.char *> pmap+ (LeftKanExtType F) (funExt+ \lam w => toOpOp.char)
     \in (\lam i => U.1 $ transport (\lam G => IsIso (dmap G b)) e (dmap_IsIso Op.Hom i),
          \lam i => IsFFMap.isConservative Op.Hom-ff $ transportInv (\lam G => IsIso (dmap G b)) e (U.2 i))

-- | Sections of the fibers of {q} along {h} are sections of the fibers of `OpFunc q` along `OpFunc h`.
\sfunc op-sections.{u} {T E A : \Cat u} (q : E ->⁺ A) (h : T ->⁺ A)
  : QEquiv {\Pi (t :⁺ T) -> Fibers q (h t)} {\Pi (w :⁺ Op T) -> Fibers (\lam e =>⁺ OpFunc q e) (OpFunc h w)}
  => symQEquiv (sections-fib q h)
     `transQEquiv` fib-parallel-equiv {T ->⁺ E} {T ->⁺ A} {Op T ->⁺ Op E} {Op T ->⁺ Op A}
                     {\lam k t => q (k t)} {\lam K w => OpFunc q (K w)} {\lam f w => OpFunc f w} {\lam f w => OpFunc f w}
                     OpFunc-equiv OpFunc-equiv (\lam k => funExt+ \lam w => OpFunc-comp {_} {_} {_} {k} {q}) h
     `transQEquiv` sections-fib (\lam e =>⁺ OpFunc q e) (\lam w => OpFunc h w)

-- | The first component of {op-sections} is {OpFunc} of the first components.
\sfunc op-sections-fst.{u} {T E A : \Cat u} {q : E ->⁺ A} {h : T ->⁺ A} {s : \Pi (t :⁺ T) -> Fibers q (h t)} {w :⁺ Op T}
  : ((op-sections q h).f s w).1 = OpFunc (\lam t => (s t).1) w
  => path \lam i => (((\peval op-sections q h) @ i).f s w).1

-- | If paths of functors into {D} are propositions, then so are paths of functors into `Op D`.
\lemma op-fun-path-isProp.{u} {D : \Cat u} (Dp : \Pi {A : \Cat u} (f g : A ->⁺ D) -> isProp (f = g)) {A : \Cat u} (f g : A ->⁺ Op D)
  : isProp (f = g)
  => \let e : IsEquiv {A ->⁺ Op D} {Op A ->⁺ D} (\lam f z => IsHEquiv.ret toOpOp.isEquiv (OpFunc f z))
            => IsEquiv.trans OpFunc-equiv (IsHEquiv.toIsEquiv (IsHEquiv.postcomp (IsHEquiv.ret-equiv toOpOp.isEquiv)))
     \in \lam p q => IsEquiv.isInj (pmapIsEquiv e) (Dp _ _ _ _)