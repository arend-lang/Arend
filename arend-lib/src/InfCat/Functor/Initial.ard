{- | Initial functors.
 -
 -   A functor is initial if it is a left map ({CatFactor.Family.IsLeft}) of the factorization system generated by
 -   `dleft : 1 ->⁺ DI` ({InfCat.Fibration.FreeLeft}), that is, if the right factor {freeLeftProj} of its factorization
 -   is an equivalence. Initial functors are exactly the maps left orthogonal to left fibrations
 -   ({initialFunctor-orthogonal}, {orthogonal-initialFunctor}).
 -   Restriction of sections of left fibrations along initial functors is an equivalence ({initialFunctor-sections}),
 -   and this characterizes initial functors ({sections-initialFunctor}).
 -   Left adjoints are initial ({ladj-initialFunctor}).
 -}

\import Equiv
\import InfCat.Basics
\import InfCat.Fibration.FreeLeft
\import InfCat.Fibration.LeftFib
\import InfCat.Functor.Adjunction
\import InfCat.Limit.Initial
\import InfCat.OFS.CatAccessibleOFS
\import InfCat.OFS.CatOFS
\import InfCat.Paths
\import Logic
\import Paths

-- | {f} is initial if it is a left map of the factorization system generated by {leftFam}.
\type IsInitialFunctor {C D : \Cat} (f : C ->⁺ D) : \Prop
  => leftFam.IsLeft f

-- | Initial functors are left orthogonal to left fibrations.
\lemma initialFunctor-orthogonal {C D E B : \Cat} {f : C ->⁺ D} (fi : IsInitialFunctor f) {h : E ->⁺ B} (hr : leftFam.IsRight h)
  : IsOrthogonal f h
  => IsLeft-orthogonal {leftFam} fi hr

-- | Restriction of sections of a left fibration along an initial functor is an equivalence.
\lemma initialFunctor-sections {C D : \Cat} {f : C ->⁺ D} (fi : IsInitialFunctor f) {Q : D ->⁺ \Cat} (Ql : IsLeftFib Q)
  : IsEquiv {\Pi (y :⁺ D) -> Q y} {\Pi (x :⁺ C) -> Q (f x)} (\lam s x => s (f x))
  => IsOrthogonal-family-sections (initialFunctor-orthogonal fi (leftFam-right-char.2 (leftFib-total Ql))) id+

-- | Restriction of sections of a left fibration along a left adjoint is an equivalence.
\lemma ladj-sections {C D : \Cat} (Ad : QAdjunction C D) {Q : D ->⁺ \Cat} (Ql : IsLeftFib Q)
  : IsEquiv {\Pi (y :⁺ D) -> Q y} {\Pi (x :⁺ C) -> Q (Ad.ladj x)} (\lam s d => s (Ad.ladj d))
  => inP \new QEquiv {
    | ret t c => leftFib-tr Ql (Ad.heps c) (t (Ad.radj c))
    | ret_f s => funExt+ \lam c => leftFib-tr-dpath Ql (dpath \lam i => s (Ad.heps c i))
    | f_sec t => funExt+ \lam d =>
        path (\lam i => leftFib-tr Ql (Ad.heps (Ad.ladj d)) (inv (leftFib-tr-dpath Ql (dpath \lam j => t (Ad.heta d j))) i))
        *> inv (leftFib-tr_comp Ql _ _)
        *> path (\lam i => leftFib-tr Ql (Ad.heta_heps-right i) (t d))
        *> leftFib-tr_idd Ql
  }

-- | Left adjoints are initial.
\lemma ladj-initialFunctor {C D : \Cat} (Ad : QAdjunction C D) : IsInitialFunctor Ad.ladj
  => sections-IsLeft {leftFam} (ladj-sections Ad (freeLeft-leftFib Ad.ladj))

-- | Restriction of sections of a family of types along a left adjoint is an equivalence.
\lemma ladj-sections-type.{u} {C D : \Cat} (Ad : QAdjunction C D) (G : D ->⁺ \Type u)
  : IsEquiv {\Pi (y :⁺ D) -> G y} {\Pi (x :⁺ C) -> G (Ad.ladj x)} (\lam s d => s (Ad.ladj d))
  => ladj-sections Ad (leftFib-pullback G universe-leftFib)

-- | Sections of a family of types over a category with an initial object are determined by their value there.
\lemma initial-sections.{u} {C : \Cat} (c0 : C) (init : IsInitial c0) (G : C ->⁺ \Type u)
  : IsEquiv {\Pi (c :⁺ C) -> G c} {G c0} (\lam s => s c0)
  => IsEquiv.trans (ladj-sections-type (IsInitial.adjunction init) G) (inP \new QEquiv {
       | f t => t ()
       | ret a _ => a
       | ret_f t => idp
       | f_sec a => idp
     })