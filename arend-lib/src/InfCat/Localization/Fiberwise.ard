{- | Fiberwise localizations of cocartesian fibrations [1, Section 7.6.3].
 -
 -   Let `F` be a cocartesian fibration over `S` and let `W` be a family of classes of morphisms in its fibers
 -   that is stable under cocartesian transport ({IsTransportStable}).
 -   We define a class {TotW} of weak equivalences in the total category `\Sigma⁺ (s : S) (F s)`.
 -   We take the localization at {TotW} in {FibLoc} and take the fibers of the induced projection to {S} in {FibLocFam}.
 -   {FibLocFam} is again a cocartesian fibration (`fibLoc-cocartesian` in `Fiberwise.FiberwiseCocartesian`) and its fibers are
 -   the localizations of the fibers of `F` (`fibLoc-fibre` in `Fiberwise.FiberwiseFiber`; [1, Proposition 7.6.16 (3) and Theorem 7.6.20];
 -   see also V. Hinich, Dwyer-Kan localization revisited, Proposition 2.1.4).
 -
 -   [1] Denis-Charles Cisinski, Bastiaan Cnossen, Kim Nguyen, Tashi Walde, Synthetic Category Theory, 2026
 -}

\import Function.Meta
\import InfCat.Basics
\import InfCat.Fibration.Categorical
\import InfCat.Fibration.CocartesianFib
\import InfCat.Fibration.CocartesianMap
\import InfCat.Fibration.CovariantLift
\import InfCat.Localization.Abstract
\import InfCat.Localization.Concrete
\import InfCat.Rezk
\import Logic
\import Logic.Meta
\import Logic.Unique
\import Paths
\import Paths.Meta

{- | A family of classes {W} of morphisms in the fibers of {F} is stable under cocartesian transport
 -   if the transport of a morphism in `W s` along any `g : s ~> s'` is in `W s'`.
 -   The transport is given as an arbitrary square over `g` whose horizontal sides are cocartesian lifts.
 -}
\type IsTransportStable {S : \Cat} (F : S ->⁺ \Cat) (W : \Pi (s : S) -> (DI ->⁺ F s) -> \Prop) : \Prop
  => \Pi {s s' : S} (g : s ~> s') {b : DI ->⁺ F s} -> W s b ->
       ∃ (k : DI ->⁺ F s') (W s' k) (H : DPath (\lam i => DI ->⁺ F (g i)) b k)
         (IsCocartesianLift {S} {F} {s, s', g, b dleft} (k dleft, dpath \lam i => H i dleft))
         (IsCocartesianLift {S} {F} {s, s', g, b dright} (k dright, dpath \lam i => H i dright))

-- | Transport stability is preserved by base change along a functor.
\lemma transportStable-pullback {X S : \Cat} {F : S ->⁺ \Cat} {W : \Pi (s : S) -> (DI ->⁺ F s) -> \Prop}
                                (Ws : IsTransportStable F W) (p : X ->⁺ S)
  : IsTransportStable (\lam x => F (p x)) (\lam x => W (p x))
  => \lam m wb => TruncP.map (Ws (dmap p m) wb) \lam t => (t.1, t.2, t.3, cocartesianLift-pullback p t.4, cocartesianLift-pullback p t.5)

-- | A family of classes {W} of morphisms in the values of {Q} as classes of morphisms in the fibers of {totalProj}.
\func TotalFibW {X : \Cat} {Q : X ->⁺ \Cat} (W : \Pi (x : X) -> (DI ->⁺ Q x) -> \Prop) (x : X) (b : DI ->⁺ Fibers (totalProj Q) x) : \Prop
  => W x (\lam i => fibers-total-equiv.fibers-total-ret (b i))

-- | Transport stability is preserved by passing to the fibers of {totalProj}.
\lemma transportStable-total {X : \Cat} {Q : X ->⁺ \Cat} {W : \Pi (x : X) -> (DI ->⁺ Q x) -> \Prop} (Ws : IsTransportStable Q W)
  : IsTransportStable (Fibers (totalProj Q)) (TotalFibW {X} {Q} W)
  => \lam {x} {x'} m {b} wb => transport {DI ->⁺ Fibers (totalProj Q) x} (\lam b' =>
        ∃ (k : DI ->⁺ Fibers (totalProj Q) x') (TotalFibW {X} {Q} W x' k) (H : DPath (\lam i => DI ->⁺ Fibers (totalProj Q) (m i)) b' k)
          (IsCocartesianLift {X} {Fibers (totalProj Q)} {x, x', m, b' dleft} (k dleft, dpath \lam i => H i dleft))
          (IsCocartesianLift {X} {Fibers (totalProj Q)} {x, x', m, b' dright} (k dright, dpath \lam i => H i dright)))
      (path \lam j i => fibers-total-equiv.fibers-total-ret-sec (b i) j)
      (TruncP.map (Ws m wb) \lam t => (\lam i => ((x', t.1 i), idp), t.2, dpath \lam i => \lam j => ((m i, t.3 i j), idp),
                                         cocartesianLift-total t.4, cocartesianLift-total t.5))

-- | The transport of a morphism of {W} along cocartesian lifts is in {W}.
\lemma transportStable-lift {S : \Cat} {F : S ->⁺ \Cat} (Ff : IsCocartesianFib F) {W : \Pi (s : S) -> (DI ->⁺ F s) -> \Prop}
                            (Ws : IsTransportStable F W) {s s' : S} (g : s ~> s') {b : DI ->⁺ F s} (wb : W s b)
  : W s' (\lam i => (cocartesianFib-lift {_} {F} Ff (s, s', g, b i)).1)
  => \case Ws g wb \with {
    | inP (k, wk, H, cl, cr) => transport (W s') (pmap __.1 (isContr=>isProp (transports-contr Ff g b) (k, H, cl, cr)
        (\lam i => (cocartesianFib-lift {_} {F} Ff (s, s', g, b i)).1, dpath \lam j i => (cocartesianFib-lift {_} {F} Ff (s, s', g, b i)).2 j,
         cocartesianFib-lift.isCocartesian {_} {F} (s, s', g, b dleft), cocartesianFib-lift.isCocartesian {_} {F} (s, s', g, b dright)))) wk
  }

-- | The morphisms of the total category {E} that lie in a single fiber and satisfy {W} there.
\type TotW {S E : \Cat} (p : E ->⁺ S) (W : \Pi (s : S) -> (DI ->⁺ Fibers p s) -> \Prop) (a : DI ->⁺ E) : \Prop
  => ∃ (s : S) (b : \Pi (i :⁺ DI) -> p (a i) = s) (W s \lam i => (a i, b i))

-- | The projection to the base inverts {TotW}.
\lemma proj-inverts {S E : \Cat} (p : E ->⁺ S) (W : \Pi (s : S) -> (DI ->⁺ Fibers p s) -> \Prop) : InvertsW (TotW p W) p
  => \lam {a} (inP (s,b,Wab)) => IsIso-diag-char.2 $ inP (s, ext \lam i => inv (b i))

-- | A functor inverting {W} on every fiber inverts {TotW}.
\lemma totW-inverts {S E D : \Cat} {p : E ->⁺ S} {W : \Pi (s : S) -> (DI ->⁺ Fibers p s) -> \Prop} {T : E ->⁺ D}
                    (Tw : \Pi (s : S) -> InvertsW (W s) (\lam (y :⁺ Fibers p s) => T y.1))
  : InvertsW (TotW p W) T
  => \lam (inP (s, b, w)) => Tw s w

-- | A functor on the total category of {Q} inverting {W} on every value of {Q} inverts {TotalFibW}.
\lemma totalFibW-inverts {X D : \Cat} {Q : X ->⁺ \Cat} {W : \Pi (x : X) -> (DI ->⁺ Q x) -> \Prop} {T : \Sigma⁺ (x : X) (Q x) ->⁺ D}
                         (Tw : \Pi (x : X) -> InvertsW (W x) (\lam (q :⁺ Q x) => T (x, q)))
  : InvertsW (TotW (totalProj Q) (TotalFibW {X} {Q} W)) T
  => \lam {a} (inP (x, b, w)) => transport {DI ->⁺ \Sigma⁺ (x : X) (Q x)} (\lam a' => IsIso (dpath \lam i => T (a' i)))
      (path \lam j i => (fibers-total-equiv.fibers-total-ret-sec {X} {Q} {x} (a i, b i) j).1) (Tw x w)

-- | The localization of the total category of {p} at the morphisms of `TotW F W`.
\func FibLoc {S E : \Cat} (p : E ->⁺ S) (W : \Pi (s : S) -> (DI ->⁺ Fibers p s) -> \Prop) : \Cat
  => Localize (TotW p W)

-- | The projection of {FibLoc} to the base.
\func fibLocProj {S E : \Cat} (p : E ->⁺ S) (W : \Pi (s : S) -> (DI ->⁺ Fibers p s) -> \Prop) (y :⁺ FibLoc p W) : S
  => localize-lift (proj-inverts p W) y

-- | The fiberwise localization of {p} at {W}: the family of fibers of {fibLocProj}.
\func FibLocFam {S E : \Cat} (p : E ->⁺ S) (W : \Pi (s : S) -> (DI ->⁺ Fibers p s) -> \Prop) (s :⁺ S) : \Cat
  => Fibers (fibLocProj p W) s

-- | The map from the fibers of {p} to the fibers of {FibLocFam}.
\func fibLoc-incl {S E : \Cat} (p : E ->⁺ S) (W : \Pi (s : S) -> (DI ->⁺ Fibers p s) -> \Prop) (x :⁺ E) : FibLocFam p W (p x)
  => (localize (TotW p W) x, idp)