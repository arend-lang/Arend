{- | The geometric realization of a category, that is, its localization at all morphisms.
 -}

\import InfCat.Basics
\import InfCat.Functor.Conservative
\import InfCat.Functor.Equiv
\import InfCat.Groupoid
\import InfCat.Localization.Abstract
\import InfCat.Localization.CatWeakEq
\import InfCat.Localization.Concrete
\import InfCat.Objects
\import InfCat.Paths
\import InfCat.Rezk
\import Logic

-- | The geometric realization of {C}.
\func Realization (C : \Cat) : \Cat
  => Localize (MaxCatWeakEq C)

-- | The localization functor into the geometric realization.
\func realize {C : \Cat} (x :⁺ C) : Realization C
  => localize (MaxCatWeakEq C) x

-- | {realize} inverts all morphisms.
\lemma realize-inverts {C : \Cat} {x y : C} (f : x ~> y) : IsIso (dmap realize f)
  => (localize-inverts {MaxCatWeakEq C}).hfunc-we {f} ()

-- | The geometric realization is a groupoid.
\lemma realization-groupoid {C : \Cat} : IsGroupoid (Realization C)
  => \let | G => core-lift {C} {Realization C} {realize} realize-inverts
          | r (y :⁺ Realization C) : Ob (Realization C) => localize-lift (\new InvertsWeakEq G.1 { | hfunc-we _ => type-groupoid _ }) y
     \in retract-groupoid type-groupoid r unob \lam y => loc-ext-eq localize-isLocalizationFor {\lam y => unob (r y)} G.2

-- | Functors from the geometric realization to a groupoid are functors from {C}.
\lemma realization-univ {C D : \Cat} (Dg : IsGroupoid D) : IsHEquiv {Realization C ->⁺ D} {C ->⁺ D} (\lam G x => G (realize x))
  => IsLocalization.groupoid {MaxCatWeakEq C} {Realization C} {D} localize-isLocalization Dg

-- | Functors out of the geometric realization agreeing on {realize} agree.
\sfunc realization-ext {C D : \Cat} {G H : Realization C ->⁺ D} (p : \Pi (x :⁺ C) -> G (realize x) = H (realize x))
                       {y :⁺ Realization C} : G y = H y
  => loc-ext-eq (localize-isLocalizationFor {MaxCatWeakEq C} {D}) {G} {H} p {y}

-- | Functoriality of the geometric realization; it computes on {realize}.
\func realization-map {C D : \Cat} (F : C ->⁺ D) (y :⁺ Realization C) : Realization D
  => localize-map (\new FuncWeakEq (MaxCatWeakEq C) (MaxCatWeakEq D) F { | hfunc-we _ => () }) y

-- | A natural transformation becomes a path after realization.
\sfunc realize-natTrans {C D : \Cat} {F G : C ->⁺ D} (t : \Pi (x :⁺ C) -> F x ~> G x) (x :⁺ C)
  : realize (F x) = realize (G x)
  => path \lam i => natIso-path {C} {Realization D} {\lam x => realize (F x)} {\lam x => realize (G x)}
                                (\lam x => dmap realize (t x)) (\lam x => realize-inverts (t x)) i x

-- | The geometric realization of a groupoid is itself.
\lemma groupoid-realization {G : \Cat} (Gg : IsGroupoid G) : IsHEquiv {G} {Realization G} realize
  => \let r => IsHEquiv.ret (realization-univ Gg) (\lam x => x)
     \in inP \new HQEquiv {
       | finv => r
       | finv_f x => path (\lam i => IsHEquiv.f_ret (realization-univ Gg) {\lam x => x} i x)
       | f_finv y => realization-ext {_} {_} {\lam y => realize (r y)} {\lam y => y}
                       (\lam x => pmap+ realize (path (\lam i => IsHEquiv.f_ret (realization-univ Gg) {\lam x => x} i x))) {y}
     }