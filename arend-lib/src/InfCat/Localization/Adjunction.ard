{- | Right adjoints descend to localizations: if `G : D ->⁺ C` is a right adjoint with left adjoint `F` and
 -   `lC : C ->⁺ LC`, `lD : D ->⁺ LD` are localizations such that `lD ∘ F` and `lC ∘ G` invert the localized arrows,
 -   then the induced functor `G' : LD ->⁺ LC` ({IsLocalization.lift}) is a right adjoint ({radj-lift}); its left adjoint
 -   is the functor `F'` induced by `F`. If `G` is fully faithful, then so is `G'` ({radj-lift-ff}).
 -
 -   Proof. Restriction along a localization is fully faithful, so the transformations `lC x ~> G' (F' (lC x))`
 -   and `F' (G' (lD y)) ~> lD y` given by the unit and the counit extend to transformations `y ~> G' (F' y)` and
 -   `F' (G' y) ~> y`. The triangle identities hold on the images of {lC} and {lD}, where they are images of the
 -   triangle identities of `F ⊣ G`. This is enough for the universality of the unit, since it is a proposition
 -   and localizations are surjective on objects. If `G` is fully faithful, then the counit of `F ⊣ G` is invertible,
 -   hence so is the counit of `F' ⊣ G'` on the image of {lD}, and so everywhere.
 -}

\import Equiv
\import Function.Meta
\import InfCat.Basics
\import InfCat.Functor.Adjunction
\import InfCat.Functor.FullyFaithful
\import InfCat.Localization.Abstract
\import InfCat.Localization.Concrete
\import InfCat.Rezk
\import InfCat.Square
\import Logic
\import Paths

-- | The functor between localizations induced by a right adjoint is a right adjoint.
\lemma radj-lift {C D LC LD : \Cat} {WC : (DI ->⁺ C) -> \Prop} {WD : (DI ->⁺ D) -> \Prop}
                 {lC : C ->⁺ LC} {lD : D ->⁺ LD} (LzC : IsLocalization WC lC) (LzD : IsLocalization WD lD)
                 (A : QAdjunction C D) (Fw : InvertsW WC (\lam x => lD (A.ladj x))) (Gw : InvertsW WD (\lam y => lC (A.radj y)))
  : RightAdjoint radjL \cowith
  | lob => ladjL
  | eta0 => etaL
  | eta0-adjoint => etaL-univ
  \where {
    -- | The functor induced by the left adjoint.
    \func ladjL (y :⁺ LC) : LD
      => IsLocalization.lift LzC Fw y

    -- | The functor induced by the right adjoint.
    \func radjL (y :⁺ LD) : LC
      => IsLocalization.lift LzD Gw y

    -- | {ladjL} computes on the image of {lC}.
    \sfunc ladjL_lC (x :⁺ C) : ladjL (lC x) = lD (A.ladj x)
      => IsLocalization.lift.restrict

    -- | {radjL} computes on the image of {lD}.
    \sfunc radjL_lD (y :⁺ D) : radjL (lD y) = lC (A.radj y)
      => IsLocalization.lift.restrict

    -- | The adjunction `F' ⊣ G'`.
    \func adj : QAdjunction LC LD ladjL radjL etaL
      => (\new UnivUnit ladjL radjL {
           | ueta => etaL
           | ueta-univ x y => etaL-univ
         }).toAdjunction

    -- | The unit on the image of {lC}, transported to `G' (F' (lC x))`.
    \func eta0 (x :⁺ C) : lC x ~> radjL (ladjL (lC x))
      => comp (dmap lC (A.heta x)) (comp (=_~> (inv (radjL_lD (A.ladj x)))) (dmap radjL (=_~> (inv (ladjL_lC x)))))

    -- | The counit on the image of {lD}, transported to `F' (G' (lD y))`.
    \func eps0 (y :⁺ D) : ladjL (radjL (lD y)) ~> lD y
      => comp (dmap ladjL (=_~> (radjL_lD y))) (comp (=_~> (ladjL_lC (A.radj y))) (dmap lD (A.heps y)))

    -- | The unit as a transformation of endofunctors of {LC}, extended from {eta0} along {lC}.
    \sfunc etaNat : (\lam y => y) ~> {LC ->⁺ LC} (\lam y => radjL (ladjL y))
      => IsEquiv.ret (localization-ff (IsLocalization.univ LzC) (\lam y => y) (\lam y => radjL (ladjL y))) (dpath \lam i x => eta0 x i)

    -- | The counit as a transformation of endofunctors of {LD}, extended from {eps0} along {lD}.
    \sfunc epsNat : (\lam y => ladjL (radjL y)) ~> {LD ->⁺ LD} (\lam y => y)
      => IsEquiv.ret (localization-ff (IsLocalization.univ LzD) (\lam y => ladjL (radjL y)) (\lam y => y)) (dpath \lam i x => eps0 x i)

    -- | The unit of {adj}.
    \func etaL (y :⁺ LC) : y ~> radjL (ladjL y)
      => dmap (\lam u => u y) etaNat

    -- | The counit extended along {lD}; it agrees with the counit of {adj} ({heps-restrict}).
    \func epsL (y :⁺ LD) : ladjL (radjL y) ~> y
      => dmap (\lam u => u y) epsNat

    -- | The unit on the image of {lC}.
    \sfunc etaL-restrict {x : C} : etaL (lC x) = eta0 x
      => pmap (\lam N => dmap (\lam u => u (lC x)) N) (\peval etaNat)
         *> pmap (dmap (\lam (u : C ->⁺ LC) => u x))
              (IsEquiv.f_ret (localization-ff (IsLocalization.univ LzC) (\lam y => y) (\lam y => radjL (ladjL y))) {dpath \lam i x => eta0 x i})

    -- | The counit on the image of {lD}.
    \sfunc epsL-restrict {y : D} : epsL (lD y) = eps0 y
      => pmap (\lam N => dmap (\lam u => u (lD y)) N) (\peval epsNat)
         *> pmap (dmap (\lam (u : D ->⁺ LD) => u y))
              (IsEquiv.f_ret (localization-ff (IsLocalization.univ LzD) (\lam y => ladjL (radjL y)) (\lam y => y)) {dpath \lam i x => eps0 x i})

    -- | Cancelling the image of a path against the image of its inverse.
    \private \sfunc cancel-inv {X Y : \Cat} (f : X ->⁺ Y) {x x' : X} (p : x = x') {y : Y} {r : f x' ~> y}
      : comp (dmap f (=_~> (inv p))) (comp (dmap f (=_~> p)) r) = r \elim p
      | idp => comp_idd-left *> comp_idd-left

    -- | A path composed with its inverse is the identity.
    \private \sfunc inv-cancel {X : \Cat} {x x' : X} {p : x = x'} : comp (=_~> p) (=_~> (inv p)) = idd \elim p
      | idp => comp_idd-left

    -- | A transformation at the endpoint of a path is conjugate to its value at the other endpoint.
    \private \sfunc natural-at-path {X Y : \Cat} {f g : X ->⁺ Y} (h : \Pi (x :⁺ X) -> f x ~> g x) {x x' : X} (p : x = x')
      : h x = comp (dmap f (=_~> p)) (comp (h x') (dmap g (=_~> (inv p)))) \elim p
      | idp => inv (comp_idd-left *> comp_idd-right)

    -- | The triangle identity for {radjL} on the image of {lD}.
    \sfunc triangle-left {b : D} : comp (etaL (radjL (lD b))) (dmap radjL (epsL (lD b))) = idd
      => pmap (comp __ _) (natural-at-path etaL (radjL_lD b)) *> pmap (comp _ __) (pmap (dmap radjL) epsL-restrict)
         *> inv comp-assoc *> pmap (comp _ __) (inv comp-assoc *> inner) *> inv-cancel
      \where
        \sfunc inner : comp (etaL (lC (A.radj b))) (comp (dmap (\lam y => radjL (ladjL y)) (=_~> (inv (radjL_lD b)))) (dmap radjL (eps0 b))) = =_~> (inv (radjL_lD b))
          => pmap (comp _ __) (inv (dmap_comp radjL) *> pmap (dmap radjL) (cancel-inv ladjL (radjL_lD b)) *> dmap_comp radjL)
             *> pmap (comp __ _) etaL-restrict
             *> inv comp-assoc *> pmap (comp _ __) (inv comp-assoc *> pmap (comp _ __) (cancel-inv radjL (ladjL_lC (A.radj b))))
             *> pmap (comp _ __) (inv (~>-natural (\lam a => =_~> (inv (radjL_lD a))) {_} {_} {A.heps b}))
             *> comp-assoc *> pmap (comp __ _) (inv (dmap_comp lC) *> pmap (dmap lC) A.heta_heps-left) *> comp_idd-left

    -- | The triangle identity for {ladjL} on the image of {lC}.
    \sfunc triangle-right {a : C} : comp (dmap ladjL (etaL (lC a))) (epsL (ladjL (lC a))) = idd
      => pmap (comp _ __) (natural-at-path epsL (ladjL_lC a)) *> pmap (comp __ _) (pmap (dmap ladjL) etaL-restrict)
         *> pmap (comp _ __) comp-assoc *> comp-assoc *> pmap (comp __ _) inner *> inv-cancel
      \where
        \sfunc inner : comp (dmap ladjL (eta0 a)) (comp (dmap (\lam y => ladjL (radjL y)) (=_~> (ladjL_lC a))) (epsL (lD (A.ladj a)))) = =_~> (ladjL_lC a)
          => pmap (comp __ _) (dmap_comp ladjL *> pmap (comp _ __) (dmap_comp ladjL))
             *> inv comp-assoc *> pmap (comp _ __) (inv comp-assoc *> pmap (comp _ __) (cancel-inv (\lam y => ladjL (radjL y)) (ladjL_lC a)))
             *> pmap (comp _ __) (pmap (comp _ __) epsL-restrict *> cancel-inv ladjL (radjL_lD (A.ladj a)))
             *> comp-assoc *> pmap (comp __ _) (~>-natural (\lam x => =_~> (ladjL_lC x)) {_} {_} {A.heta a})
             *> inv comp-assoc *> pmap (comp _ __) (inv (dmap_comp lD) *> pmap (dmap lD) A.heta_heps-right) *> comp_idd-right

    -- | The unit is universal.
    \lemma etaL-univ {x : LC} {y : LD} : IsEquiv (\lam (g : ladjL x ~> y) => comp (etaL x) (dmap radjL g))
      => \case \elim x, \elim y, IsLocalization.isSurj LzC x, IsLocalization.isSurj LzD y \with {
        | _, _, inP (a, idp), inP (b, idp) => inP \new QEquiv {
          | f g => comp (etaL (lC a)) (dmap radjL g)
          | ret h => comp (dmap ladjL h) (epsL (lD b))
          | ret_f g => counit-comp-natural ladjL radjL epsL (etaL (lC a)) g *> pmap (comp __ g) triangle-right *> comp_idd-left
          | f_sec h => unit-comp-natural ladjL radjL etaL h (epsL (lD b)) *> pmap (comp h __) triangle-left *> comp_idd-right
        }
      }

    -- | The counit of {adj} on the image of {lD}.
    \sfunc heps-restrict {b : D} : adj.heps (lD b) = eps0 b
      => IsEquiv.isInj etaL-univ (adj.heta_heps-left *> inv triangle-left) *> epsL-restrict

    -- | If `A.radj` is fully faithful, then the counit of {adj} is invertible.
    \lemma heps-iso (ff : IsFFMap A.radj) (y : LD) : IsIso (adj.heps y)
      => \case \elim y, IsLocalization.isSurj LzD y \with {
        | _, inP (b, idp) => transportInv IsIso heps-restrict $
            comp-IsIso (dmap_IsIso ladjL (=_~>-iso _)) (comp-IsIso (=_~>-iso _) (dmap_IsIso lD (A.radj-ff-char.1 ff b)))
      }
  }

-- | If the right adjoint is fully faithful, then so is the induced functor.
\lemma radj-lift-ff {C D LC LD : \Cat} {WC : (DI ->⁺ C) -> \Prop} {WD : (DI ->⁺ D) -> \Prop}
                    {lC : C ->⁺ LC} {lD : D ->⁺ LD} (LzC : IsLocalization WC lC) (LzD : IsLocalization WD lD)
                    (A : QAdjunction C D) (Fw : InvertsW WC (\lam x => lD (A.ladj x))) (Gw : InvertsW WD (\lam y => lC (A.radj y))) (ff : IsFFMap A.radj)
  : IsFFMap (IsLocalization.lift LzD Gw)
  => (radj-lift.adj {_} {_} {_} {_} {_} {_} {_} {_} {LzC} {LzD} {_} {Fw} {Gw}).radj-ff-char.2 (radj-lift.heps-iso ff)
