{- | Opposite categories preserve localizations ({OpFunc-isLocalization}):
 -   if `l : E ->⁺ L` is a localization at {W}, then `OpFunc l : Op E ->⁺ Op L` is a localization at `OpW W`,
 -   the class of arrows opposite to arrows in {W}.
 -
 -   Proof. By {localization-criterion} it is enough to show that restriction along `OpFunc l` is an equivalence
 -   on functors inverting {W} into every category `D : \Cat u`. Transposition ({opTranspose}) identifies functors
 -   `Op L ->⁺ D` with functors `L ->⁺ Op D`, commutes with restriction ({opTranspose-precomp}),
 -   and identifies functors inverting `OpW W` with functors inverting {W} ({opTranspose-invertsW}).
 -   So the claim follows from the universal property of {l} with respect to `Op D`.
 -}

\import Equiv
\import Equiv.Sigma
\import Function.Meta
\import InfCat.Localization.Abstract
\import InfCat.Localization.Concrete
\import InfCat.Opposite
\import InfCat.Opposite.Transpose
\import InfCat.Paths
\import InfCat.Yoneda.YonedaLemma
\import InfCat.Rezk
\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta

-- | The arrows of `Op C` opposite to arrows satisfying {W}.
\func OpW.{u} {C : \Cat u} (W : (DI ->⁺ C) -> \Prop) (a : DI ->⁺ Op C) : \Prop
  => ∃ (b : DI ->⁺ C) (W b) ((\lam i => opArr (dpath b) i) = {DI ->⁺ Op C} a)

-- | A functor `Op C ->⁺ D` inverts `OpW W` if and only if its transpose inverts {W}.
\lemma opTranspose-invertsW.{u} {C D : \Cat u} {W : (DI ->⁺ C) -> \Prop} {F : Op C ->⁺ D}
  : InvertsW (OpW W) F <-> InvertsW W (opTranspose F)
  => (\lam Fw {b} w => (opTranspose-iso F (dpath b)).2 $ Fw {\lam i => opArr (dpath b) i} (inP (b, w, idp)),
      \lam Tw {a} aw => \case aw \with {
        | inP (b, w, p) => transport (\lam a => IsIso (dpath \lam i => F (a i))) p $ (opTranspose-iso F (dpath b)).1 (Tw w)
      })

-- | {OpFunc} preserves localizations.
\lemma OpFunc-isLocalization.{u} {E L : \Cat u} {W : (DI ->⁺ E) -> \Prop} {l : E ->⁺ L} (Lz : IsLocalization W l)
  : IsLocalization (OpW W) (OpFunc l)
  => IsLocalization.fromUniv (localization-criterion (OpFunc-inverts Lz) (restrict-equiv Lz) (restrict-equiv Lz))
                             (localization-criterion (OpFunc-inverts Lz) (restrict-equiv Lz) (restrict-equiv Lz))
  \where {
    \lemma OpFunc-inverts.{u} {E L : \Cat u} {W : (DI ->⁺ E) -> \Prop} {l : E ->⁺ L} (Lz : IsLocalization W l)
      : InvertsW (OpW W) (OpFunc l)
      => opTranspose-invertsW.2 $ transport (InvertsW W) (funExt+ \lam x => inv toOpOp-natural) (invertsW-postcomp toOpOp Lz.1)

    -- | Restriction along `OpFunc l` is an equivalence on functors inverting `OpW W`.
    \lemma restrict-equiv.{u} {E L : \Cat u} {W : (DI ->⁺ E) -> \Prop} {l : E ->⁺ L} (Lz : IsLocalization W l) {D : \Cat u}
      : IsEquiv (restrictW {Op E} {Op L} {D} (OpFunc-inverts Lz))
      => (IsEquiv.parallelEquiv {Op L ->⁺ D} {MapW (OpW W) D} {L ->⁺ Op D} {MapW W (Op D)} {restrictW (OpFunc-inverts Lz)} {restrictW Lz.1} {\lam G x => opTranspose G x}
                                {\lam s => (\lam x => opTranspose s.1 x, opTranspose-invertsW.1 s.2)}
           opTranspose-equiv (subtype-equiv {Op E ->⁺ D} {E ->⁺ Op D} opTranspose-equiv {InvertsW (OpW W)} {InvertsW W}
                                         (\lam Fw => opTranspose-invertsW.1 Fw) (\lam {F} Tw => opTranspose-invertsW.2 Tw))
           (\lam G => ext (funExt+ \lam x => opTranspose-precomp))).2
         (restrictW-equiv (IsLocalization.univ Lz))
  }