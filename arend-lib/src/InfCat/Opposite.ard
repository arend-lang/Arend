\import Equiv
\import Function.Meta
\import InfCat.Basics
\import InfCat.Kan.LeftKanExtType
\import InfCat.Fibration.Straightening
\import InfCat.Functor.Equiv
\import InfCat.Functor.FullyFaithful
\import InfCat.Paths
\import InfCat.Resizing
\import InfCat.Rezk
\import InfCat.SubCat.Full
\import InfCat.Yoneda.CovariantYoneda
\import Logic
\import Logic.Meta
\import Meta
\import Paths
\import Paths.Meta

\type Op.{u} (C : \Cat u) : \Cat u
  => ResizeFromObjects {OpLarge C} OpLargeOb-equiv OpLarge-hom
  \where {
    \private \func OpLarge.{u} (C : \Cat u)
      => FullSubCat {C ->⁺ \Type u} \lam F => ∃ (x : C) (F = ReprFunctor x)

    \private \func OpLargeOb.{u} {C : \Cat u} (x : C) : OpLarge C
      => FullSubCat.make (ReprFunctor x) $ inP (x,idp)

    \private \sfunc OpLargeOb-equiv.{u} {C : \Cat u} : QEquiv (OpLargeOb {C})
      => IsEquiv.toQEquiv $ IsEquiv.fromEmbSurj
          (leftEmbedding (IsFFMap.isObEmbedding FullSubCat.inc-ff) ReprFunctor-embedding)
          \lam y => \case FullSubCat.inc-con {_} {_} {y} \with {
            | inP (x,p) => inP (x, ((IsFFMap.isObEmbedding FullSubCat.inc-ff).isEmb (OpLargeOb x) y).sec (inv p))
          }

    \private \sfunc OpLarge-hom.{u} {C : \Cat u} (x y : C) : QEquiv {y ~> x} {OpLargeOb x ~> OpLargeOb y}
      => symQEquiv $ IsEquiv.toQEquiv $ IsEquiv.trans (FullSubCat.inc-ff _ _) yonedaEmbCov

    \private \lemma OpLarge-equiv.{u} {C : \Cat u} : IsHEquiv {OpLarge C} {Op C} (\lam x => resizeCat x)
      => inP \new HQEquiv {
        | finv (resizeCat x) => x
        | finv_f x => idp
        | f_finv (resizeCat x) => idp
      }

    \func toLarge.{u} {C : \Cat u} (x :⁺ Op C) : OpLarge C \elim x
      | resizeCat x => x

    \func Hom.{u} {C : \Cat u} (x :⁺ Op C) (y :⁺ C) : \Type u
      => FullSubCat.inc (toLarge x) y

    \lemma Hom-ff.{u} {C : \Cat u} : IsFFMap (Hom {C})
      => ffMap-comp (ff-surj-equiv.2 $ inP $ later \new HQEquiv {
        | finv x => resizeCat x
        | finv_f (resizeCat x) => idp
        | f_finv => idpe
      }).1 FullSubCat.inc-ff

    \func toOp.{u} {C : \Cat u} (x : C) : Op C
      => resizeCat (OpLargeOb x)

    \lemma toOp-equiv.{u} {C : \Cat u} : IsEquiv (toOp {C})
      => IsEquiv.trans (inP OpLargeOb-equiv) (IsHEquiv.toIsEquiv OpLarge-equiv)

    -- | The identity of {x} as an element of `Hom (toOp x) x`.
    \func Hom-idd.{u} {C : \Cat u} (x : C) : Hom (toOp x) x
      => Straight.toStraight idd
  }

\func yoneda.{u} {C : \Cat u} (x :⁺ C) (y :⁺ Op C)
  => Op.Hom y x

\sfunc OpFunc.{u} {C D : \Cat u} (f : C ->⁺ D) (x :⁺ Op C) : Op D
  => pair.1 x
  \where {
    \private \sfunc pair
      => ffMap-lift Op.Hom-ff (\lam x => LeftKanExtType f (Op.Hom x))
          \lam x' => \case IsEquiv.isSurj Op.toOp-equiv x' \with {
            | inP (x,p) => inP (Op.toOp (f x), ext (\lam b => inv LeftKanExtType_ReprFunctor) *> pmap (LeftKanExtType f) (pmap Op.Hom p))
          }

    \protected \sfunc char : Op.Hom (OpFunc f x) = LeftKanExtType f (Op.Hom x)
      => pmap+ Op.Hom (\peval OpFunc f x) *> pair.2 x
  }

-- | {OpFunc} sends `toOp x` to `toOp (f x)`.
\sfunc OpFunc_toOp.{u} {C D : \Cat u} {f : C ->⁺ D} {x : C} : OpFunc f (Op.toOp x) = Op.toOp (f x)
  => ((IsFFMap.isObEmbedding Op.Hom-ff).isEmb _ _).sec toOp-hom
  \where {
    \sfunc toOp-hom.{u} {C D : \Cat u} {f : C ->⁺ D} {x : C} : Op.Hom (OpFunc f (Op.toOp x)) = ReprFunctor (f x)
      => OpFunc.char *> funExt+ \lam b => LeftKanExtType_ReprFunctor

    \sfunc toOp-pmap.{u} {C D : \Cat u} {f : C ->⁺ D} {x : C} : pmap Op.Hom (OpFunc_toOp {C} {D} {f} {x}) = toOp-hom
      => pmap (pmap Op.Hom) (\peval OpFunc_toOp {C} {D} {f} {x}) *> ((IsFFMap.isObEmbedding Op.Hom-ff).isEmb _ _).f_sec toOp-hom
  }

-- | {OpFunc} preserves composition.
\sfunc OpFunc-comp.{u} {A B C : \Cat u} {f : A ->⁺ B} {g : B ->⁺ C} {z :⁺ Op A} : OpFunc (\lam a => g (f a)) z = OpFunc g (OpFunc f z)
  => path \lam i => ((IsFFMap.isObEmbedding (postcomp-ff Op.Hom-ff)).isEmb (\lam z => OpFunc (\lam a => g (f a)) z) (\lam z => OpFunc g (OpFunc f z))).sec
                     (funExt+ \lam z => OpFunc.char *> funExt+ (\lam c => LeftKanExtType-comp) *> inv (OpFunc.char *> pmap+ (LeftKanExtType g) OpFunc.char)) i z

-- | The arrow of `Op C` opposite to {b}.
\func opArr.{u} {C : \Cat u} {x y : C} (b : x ~> y) : Op.toOp y ~> Op.toOp x
  => IsEquiv.ret (Op.Hom-ff (Op.toOp y) (Op.toOp x)) (IsEquiv.ret yonedaEmbCov b)
  \where {
    -- | The natural transformation of representable functors induced by {opArr} corresponds to {b}.
    \sfunc unop.{u} {C : \Cat u} {x y : C} {b : x ~> y} : yonedaEmbCov.fun (dmap Op.Hom (opArr b)) = b
      => pmap yonedaEmbCov.fun (IsEquiv.f_ret (Op.Hom-ff _ _)) *> IsEquiv.f_ret yonedaEmbCov

    -- | {opArr} preserves and reflects isomorphisms.
    \lemma isIso.{u} {C : \Cat u} {x y : C} {b : x ~> y} : IsIso (opArr b) <-> IsIso b
      => (\lam e => transport IsIso unop $ yonedaEmbCov.isIso $ dmap_IsIso Op.Hom e,
          \lam e => IsFFMap.isConservative Op.Hom-ff $ yonedaEmbCov.isConservative $ transportInv IsIso unop e)
  }