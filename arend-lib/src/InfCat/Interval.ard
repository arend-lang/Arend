\import InfCat.Basics
\import Logic
\import Logic.Unique
\import Paths
\import Equiv

-- | The minimum of two points of the directed interval.
\func dmin (i j :⁺ DI) : DI => conn-right (dpath \lam k => k) i j

-- | The maximum of two points of the directed interval.
\func dmax (i j :⁺ DI) : DI => conn-left (dpath \lam k => k) i j

\lemma DI-hom-ll-contr : Contr (dleft ~> dleft)
  => Contr.make idd \lam p => inv (comp-equiv.flipped.f (dpath \lam k => conn-right (dpath \lam i => i) (p k))) *> comp_idd-left

\lemma DI-hom-lr-contr : Contr (dleft ~> dright)
  => Contr.make (dpath \lam i => i) \lam p => inv (comp-equiv.flipped.f (dpath \lam k => conn-right (dpath \lam i => i) (p k))) *> comp_idd-left

\lemma DI-hom-rr-contr : Contr (dright ~> dright)
  => Contr.make idd \lam p => inv (comp-char (dpath \lam k => conn-left (dpath \lam i => i) (p k))) *> comp_idd-right

\func DI-hom-rl-empty (p : dright ~> dleft) : Empty
  => coe+ (\lam i => iso+ (\lam _ => ()) (p i)) () dright

\lemma DI-hom-prop {x y : DI} : isProp (x ~> y) \elim x
  | dleft => \case \elim y \with {
    | dleft => isContr=>isProp DI-hom-ll-contr
    | dright => isContr=>isProp DI-hom-lr-contr
  }
  | dright => \case \elim y \with {
    | dleft => \lam p => absurd (DI-hom-rl-empty p)
    | dright => isContr=>isProp DI-hom-rr-contr
  }

-- | A property of the arrows of {DI} holding for identities and for `dleft ~> dright` holds for all arrows.
\lemma DI-arrow-ind (P : \Pi {i j : DI} -> i ~> j -> \Prop) (Pid : \Pi {i : DI} -> P (idd {DI} {i})) (P01 : P (dpath \lam i => i))
                    {i j : DI} (k : i ~> j) : P k \elim i
  | dleft => \case \elim j, \elim k \with {
    | dleft, k => transportInv P (DI-hom-prop k idd) Pid
    | dright, k => transportInv P (DI-hom-prop k (dpath \lam i => i)) P01
  }
  | dright => \case \elim j, \elim k \with {
    | dleft, k => absurd (DI-hom-rl-empty k)
    | dright, k => transportInv P (DI-hom-prop k idd) Pid
  }