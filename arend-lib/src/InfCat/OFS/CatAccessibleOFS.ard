\import Data.Bool
\import Equiv
\import Equiv.Fiber
\import Function
\import Function.Meta
\import Homotopy.Cube
\import InfCat.Basics
\import InfCat.CatPushout
\import InfCat.Functor.Equiv
\import InfCat.Functor.FullyFaithful
\import InfCat.OFS.CatOFS
\import InfCat.Paths
\import Logic
\import Logic.Meta
\import Logic.Unique
\import Meta
\import Paths
\import Paths.Meta
\open CatFactor \using (Family)

\type CatFactor {fam : Family} {C D : \Cat} (f : C ->⁺ D)
  => LData {famHat} f
  \where {
    \protected \class Family {
      | J : \Type
      | X : J -> \Cat
      | Y : J -> \Cat
      | F : \Pi (j : J) -> X j ->⁺ Y j

      \func IsRight {C D : \Cat} (g : C ->⁺ D) : \Prop
        => \Pi (j : J) -> IsOrthogonal (F j) g
    }

    \data LData {fam : Family} {C D : \Cat} (f : C ->⁺ D)
      | alpha (c :⁺ C)
      | lext {j : J} (u : X j ->⁺ LData f) (v : Y j ->⁺ D) (c : \Pi (x :⁺ X j) -> v (F j x) = fromLData (u x)) (y :⁺ Y j)
      | isExt {j : J} (u : X j ->⁺ LData f) (v : Y j ->⁺ D) (c : \Pi (x :⁺ X j) -> v (F j x) = fromLData (u x)) (x :⁺ X j) : lext u v c (F j x) = u x

    \lemma alpha-isSurj {fam : Family} (fs : \Pi (j : J) -> IsSurjMap (F j)) {C D : \Cat} {f : C ->⁺ D} : IsSurjMap (alpha {fam} {C} {D} {f})
      => induction __
      \where {
        \private \lemma induction (d : LData {fam} f) : ∃ (c : C) (alpha c = d) \elim d
          | alpha c => inP (c,idp)
          | lext {j} u v c y => \case fs j y \with {
            | inP (x,Fx=y) => \case induction (u x) \with {
              | inP (r,ar=ux) => inP (r, ar=ux *> inv (path (isExt u v c x)) *> pmap (lext u v c) Fx=y)
            }
          }
      }

    \func fromLData {fam : Family} {C D : \Cat} {f : C ->⁺ D} (d :⁺ LData f) : D \elim d
      | alpha c => f c
      | lext u v c y => v y
      | isExt u v c x => c x
      \where {
        \lemma isRight : fam.IsRight (fromLData {famHat} {C} {D} {f})
          => \lam j => IsEquiv.fromMonoRetraction (later \lam {h} {h'} p =>
              \have r (e :⁺ CatPushout (F j) (F j)) => path $ isExt {famHat} {C} {D} {f} {j,false}
                      (lift2 $ CatPushout.rec h h' \lam x => path \lam i => (p i).1.1 x)
                      (\lam y => fromLData {famHat} (h y))
                      (lift2 $ CatPushout.elim (\lam y => idp) (\lam y => path \lam i => (p i).1.2 y) $ later
                                 \lam x => Cube2.map idp _ idp (path \lam i => fromLData {famHat} ((p i).1.1 x)) $
                                 inv $ pmap+ (*> _) (path \lam j => path \lam i => (p i).2 x j) *> *>_inv)
                      (dHat2 e)
              \in ext \lam y => inv (r (cinl y)) *> r (cinr y)) $ later \new Retraction {
                | sec s => \lam y => lext {famHat} {C} {D} {f} {j,true} (lift s.1.1) s.1.2 (lift s.2) y
                | f_sec s => ext (ext (path \lam i x => isExt (lift s.1.1) s.1.2 (lift s.2) (dHat1 x) i, idp),
                                  simp_coe \lam x => transport+_path_pmap (\lam _ => s.1.2 (fam.F j x)) (\lam y => y) idp)
              }

        \private \func lift {j : J} {B : DHat j true ->⁺ \Cat} (u : \Pi (x :⁺ fam.X j) -> B (dHat1 x)) (d :⁺ DHat j true) : B d \elim d
          | dHat1 x => u x

        \private \func lift2 {j : fam.J} {B : DHat j false ->⁺ \Cat} (u : \Pi (x :⁺ CatPushout (F j) (F j)) -> B (dHat2 x)) (d :⁺ DHat j false) : B d \elim d
          | dHat2 x => u x
      }

    \func dataExt {fam : Family} {C D : \Cat} {f : C ->⁺ D} {E : \Cat} {g : C ->⁺ E} {h : E ->⁺ D} (hr : fam.IsRight h) (p : \Pi (x :⁺ C) -> h (g x) = f x) (d :⁺ LData f) : \Sigma⁺ (e : E) (h e = fromLData d) \elim d
      | alpha x => (g x, p x)
      | lext {j} u v c y =>
        \have r => IsEquiv.splitSurj (hr j) ((\lam x => (dataExt hr p (u x)).1, v), \lam x => c x *> inv (dataExt hr p (u x)).2)
        \in (r.1 y, path \lam i => (r.2 i).1.2 y)
      | isExt {j} u v c x => unfold_let
        \let | r => IsEquiv.f_ret (hr j) {(\lam x => (dataExt hr p (u x)).1, v), \lam x => c x *> inv (dataExt hr p (u x)).2}
             | q => pmap+ (*> (dataExt hr p (u x)).2) $ inv idp_*> *> coe_path_pmap.conv (path \lam i => (r i).1.2 (F j x)) (path \lam i => h ((r i).1.1 x)) ((simp_coe in pmapd __.2 r) x) *> inv *>-assoc
        \in sigma-depPath (path \lam i => (r i).1.1 x) (pathOver $ coe_path (path \lam i => h ((IsEquiv.f_ret (hr j) i).1.1 x)) _ _ *> rotatePathLeft (inv $ q *> *>-assoc *> pmap+ (_ *> __) inv_*>))

    -- | Sections of pullbacks over `LData f` are determined by their restrictions along {alpha}.
    \func LData-sections {fam : Family} {C D : \Cat} {f : C ->⁺ D} {E E' : \Cat} {g : E ->⁺ E'} (gr : fam.IsRight g) (v : LData f ->⁺ E')
      : QEquiv (restrict-sections {C} {LData f} (\lam c => alpha c) g v) \cowith
      | ret t => liftData t
      | ret_f s => path \lam i d => inv (liftData-unique s d) i
      | f_sec => idpe
      \where \private {
        -- | Moving a point of the fiber over `v a` to the fiber over `v a'` along a path `P : a' = a`.
        \func pb-shift {A E F : \Cat} {g : E ->⁺ F} (v : A ->⁺ F) {a' a :⁺ A} (P :⁺ a' = a) (b :⁺ \Sigma⁺ (e : E) (g e = v a))
          : \Sigma⁺ (e : E) (g e = v a')
          => (b.1, b.2 *> pmap+ v (inv P))

        \func pb-shift-over {A E F : \Cat} {g : E ->⁺ F} (v : A ->⁺ F) {a' a :⁺ A} (P :⁺ a' = a) (b :⁺ \Sigma⁺ (e : E) (g e = v a))
          : Path (\lam i => \Sigma⁺ (e : E) (g e = v (P i))) (pb-shift v P b) b \elim P
          | idp => idp

        \func pb-over-shift {A E F : \Cat} {g : E ->⁺ F} (v : A ->⁺ F) {a' a :⁺ A} (P :⁺ a' = a)
                            {b' :⁺ \Sigma⁺ (e : E) (g e = v a')} {b :⁺ \Sigma⁺ (e : E) (g e = v a)}
                            (t :⁺ Path (\lam i => \Sigma⁺ (e : E) (g e = v (P i))) b' b) : b' = pb-shift v P b \elim P
          | idp => t

        \func pb-concat-over {A E F : \Cat} {g : E ->⁺ F} (v : A ->⁺ F) {a' a :⁺ A} (P :⁺ a' = a)
                             {b0 b1 :⁺ \Sigma⁺ (e : E) (g e = v a')} {b2 :⁺ \Sigma⁺ (e : E) (g e = v a)}
                             (s :⁺ b0 = b1) (t :⁺ Path (\lam i => \Sigma⁺ (e : E) (g e = v (P i))) b1 b2)
          : Path (\lam i => \Sigma⁺ (e : E) (g e = v (P i))) b0 b2 \elim P
          | idp => s *> t

        \func square-path {B :⁺ \Cat} {x0 x1 y0 y1 :⁺ B} (p :⁺ x0 = x1) (q :⁺ y0 = y1) (r :⁺ x0 = y0) (s :⁺ x1 = y1)
                          (c :⁺ r *> q = p *> s) : Path (\lam i => p i = q i) r s \elim p, q
          | idp, idp => c *> idp_*>

        \func pb-over-square {A E F : \Cat} {g : E ->⁺ F} (v : A ->⁺ F) {a' a :⁺ A} (P :⁺ a' = a)
                             {s' :⁺ \Sigma⁺ (e : E) (g e = v a')} {s :⁺ \Sigma⁺ (e : E) (g e = v a)}
                             (sP :⁺ Path (\lam i => \Sigma⁺ (e : E) (g e = v (P i))) s' s)
                             {l' :⁺ \Sigma⁺ (e : E) (g e = v a')} {l :⁺ \Sigma⁺ (e : E) (g e = v a)}
                             (pr :⁺ l' = pb-shift v P l) (ih :⁺ s = l) (q :⁺ s' = l')
                             (c :⁺ q *> pr = pb-over-shift v P sP *> pmap+ (pb-shift v P __) ih)
          : Path (\lam i => sP i = pb-concat-over v P pr (pb-shift-over v P l) i) q ih \elim P
          | idp => square-path sP pr q ih c

        -- | For a cell `lext u w c`, restriction along `F j` of sections of the pullback of {g} is an equivalence.
        \func cellEquiv
            {j : J} (u : X j ->⁺ LData f) (w : Y j ->⁺ D) (c : \Pi (x :⁺ X j) -> w (F j x) = fromLData (u x))
          => IsOrthogonal-sections.1 (gr j) (\lam y => v (lext u w c y))

        -- | A section over `X j` of the pullback of {g} along {u} moved to the boundary of the cell along {isExt}.
        \func cellData
            {j : fam.J} (u : X j ->⁺ LData f) (w : Y j ->⁺ D) (c : \Pi (x :⁺ X j) -> w (F j x) = fromLData (u x))
            (r : \Pi (x :⁺ X j) -> \Sigma⁺ (e : E) (g e = v (u x)))
          : \Pi (x :⁺ X j) -> \Sigma⁺ (e : E) (g e = v (lext u w c (F j x)))
          => \lam x => pb-shift v (path (isExt u w c x)) (r x)

        -- | The unique extension of {cellData} to the cell.
        \func cellSec
            {j : J} (u : X j ->⁺ LData f) (w : Y j ->⁺ D) (c : \Pi (x :⁺ X j) -> w (F j x) = fromLData (u x))
            (r : \Pi (x :⁺ X j) -> \Sigma⁺ (e : E) (g e = v (u x)))
          : \Pi (y :⁺ Y j) -> \Sigma⁺ (e : E) (g e = v (lext u w c y))
          => IsEquiv.ret (cellEquiv u w c) (cellData u w c r)

        \func cellSec-F
            {j : J} (u : X j ->⁺ LData f) (w : Y j ->⁺ D) (c : \Pi (x :⁺ X j) -> w (F j x) = fromLData (u x))
            (r : \Pi (x :⁺ X j) -> \Sigma⁺ (e : E) (g e = v (u x))) (x :⁺ X j)
          : cellSec u w c r (F j x) = pb-shift v (path (isExt u w c x)) (r x)
          => path \lam i => IsEquiv.f_ret (cellEquiv u w c) {cellData u w c r} i x

        -- | The extension of a section over {C} of the pullback of {g} along {v} to `LData f`.
        \func liftData
            (t : \Pi (c :⁺ C) -> \Sigma⁺ (e : E) (g e = v (alpha c))) (d :⁺ LData f) : \Sigma⁺ (e : E) (g e = v d) \elim d
          | alpha c => t c
          | lext u w c y => cellSec u w c (\lam x => liftData t (u x)) y
          | isExt u w c x => pb-concat-over v (path (isExt u w c x)) (cellSec-F u w c (\lam x => liftData t (u x)) x)
                                              (pb-shift-over v (path (isExt u w c x)) (liftData t (u x)))

        -- | The path from a section {s} of the pullback over `Y j` of {g} to {cellSec} as a point of a contractible fiber.
        \sfunc cellFiber
            {j : J} (u : X j ->⁺ LData f) (w : Y j ->⁺ D) (c : \Pi (x :⁺ X j) -> w (F j x) = fromLData (u x))
            (s : \Pi (d :⁺ LData f) -> \Sigma⁺ (e : E) (g e = v d))
            (r : \Pi (x :⁺ X j) -> \Sigma⁺ (e : E) (g e = v (u x))) (ih : \Pi (x :⁺ X j) -> s (u x) = r x)
          : (\lam y => s (lext u w c y), path \lam i x => cellPt u w c s r ih x i)
            = {\Sigma (a : \Pi (y :⁺ Y j) -> \Sigma⁺ (e : E) (g e = v (lext u w c y)))
                      (restrict-sections (F j) g (\lam y => v (lext u w c y)) a = cellData u w c r)}
              (cellSec u w c r, IsEquiv.f_ret (cellEquiv u w c))
          => isContr=>isProp (IsEquiv=>contrFibers (cellEquiv u w c) (cellData u w c r)) _ _
          \where {
            \func cellPt
                {j : fam.J} (u : X j ->⁺ LData f) (w : Y j ->⁺ D) (c : \Pi (x :⁺ X j) -> w (F j x) = fromLData (u x))
                (s : \Pi (d :⁺ LData f) -> \Sigma⁺ (e : E) (g e = v d))
                (r : \Pi (x :⁺ X j) -> \Sigma⁺ (e : E) (g e = v (u x))) (ih : \Pi (x :⁺ X j) -> s (u x) = r x) (x :⁺ X j)
              : s (lext u w c (F j x)) = pb-shift v (path (isExt u w c x)) (r x)
              => pb-over-shift v (path (isExt u w c x)) (path \lam i => s (isExt u w c x i)) *> pmap+ (pb-shift v (path (isExt u w c x)) __) (ih x)
          }

        -- | Every section over `LData f` is the extension of its restriction along {alpha}.
        \func liftData-unique
            (s : \Pi (d :⁺ LData f) -> \Sigma⁺ (e : E) (g e = v d)) (d :⁺ LData f)
          : s d = liftData (\lam c => s (alpha c)) d \elim d
          | alpha c => idp
          | lext u w c y =>
            \let q => cellFiber u w c s (\lam x => liftData (\lam c => s (alpha c)) (u x)) (\lam x => liftData-unique s (u x))
            \in path \lam i => (q i).1 y
          | isExt {j} u w c x =>
            \let | r => \lam x =>⁺ liftData (\lam c => s (alpha c)) (u x)
                 | ih => \lam x =>⁺ liftData-unique s (u x)
                 | q => cellFiber u w c s r ih
            \in pb-over-square v (path (isExt u w c x)) (path \lam i => s (isExt u w c x i))
                  (cellSec-F u w c r x) (ih x)
                  (path \lam i => (q i).1 (F j x))
                  (restrict-sections.fiber-coh (F j) g (\lam y => v (lext u w c y)) q x)
      }

    \data DHat {fam : Family} (j : J) (b : Bool) \elim b
      | true => dHat1 (x :⁺ X j)
      | false => dHat2 (p :⁺ CatPushout (F j) (F j))

    \func unDHat1 {fam : Family} {j : J} (d :⁺ DHat j true) : X j \elim d
      | dHat1 x => x

    \func unDHat2 {fam : Family} {j : J} (d :⁺ DHat j false) : CatPushout (F j) (F j) \elim d
      | dHat2 y => y

    \func FHat {fam : Family} (j : J) (b : Bool) (d :⁺ DHat j b) : Y j \elim b, d
      | true, dHat1 x => F j x
      | false, dHat2 y => CatPushout.rec (\lam x => x) (\lam x => x) (\lam x => idp) y

    \func famHat {fam : Family}
      => \new Family (\Sigma J Bool) (\lam s => DHat s.1 s.2) (\lam s => Y s.1) (\lam s => FHat s.1 s.2)

    \lemma famHat_IsRight {fam : Family} {C D : \Cat} {f : C ->⁺ D} (fr : fam.IsRight f) : famHat.IsRight f
      => \case \elim __ \with {
        | (j,true) => transport (IsOrthogonal __ f) (ext \lam (dHat1 x) => idp) $
          IsOrthogonal_o-left (IsOrthogonal_IsHEquiv-left $ inP \new HQEquiv {
            | f => unDHat1
            | finv => dHat1
            | finv_f (dHat1 x) => idp
            | f_finv => idpe
          }) (fr j)
        | (j,false) => transport (IsOrthogonal __ f) (ext \lam (dHat2 y) => idp) $
          IsOrthogonal_o-left (IsOrthogonal_IsHEquiv-left $ inP \new HQEquiv {
            | f => unDHat2
            | finv => dHat2
            | finv_f (dHat2 x) => idp
            | f_finv => idpe
          }) $ IsOrthogonal-codiag (fr j)
      }
  }

\cons catFactorLeft {fam : Family} {C D : \Cat} {f : C ->⁺ D} (c :⁺ C) : CatFactor f
  => alpha c
  \where {
    -- | {catFactorLeft} is left orthogonal to every right map.
    \lemma isLeft {fam : Family} {C D : \Cat} {f : C ->⁺ D} {E E' : \Cat} {g : E ->⁺ E'} (gr : fam.IsRight g)
      : IsOrthogonal (catFactorLeft {fam} {C} {D} {f}) g
      => IsOrthogonal_o-left
          (IsOrthogonal-sections.2 \lam v => inP (LData-sections {famHat} (famHat_IsRight gr) v))
          (IsOrthogonal_IsHEquiv-left $ inP \new HQEquiv {
            | f d => d
            | finv d => d
            | finv_f d => idp
            | f_finv d => idp
          })

    \protected \lemma isSurj {fam : Family} (fs : \Pi (j : fam.J) -> IsSurjMap (fam.F j)) {C D : \Cat} {f : C ->⁺ D}
      : IsSurjMap (catFactorLeft {fam} {C} {D} {f})
      => IsSurj.comp {_} {_} {CatFactor f} (alpha-isSurj {famHat} \case \elim __ \with {
        | (j, true) => \lam y => \case fs j y \with {
          | inP (x,p) => inP (dHat1 x, p)
        }
        | (j, false) => \lam y => inP (dHat2 (cinl y), idp)
      }) {\lam x => x} \lam x => inP (x,idp)
  }

\func catFactorRight {fam : Family} {C D : \Cat} {f : C ->⁺ D} (x :⁺ CatFactor f) : D
  => fromLData {famHat} x
  \where {
    \lemma isRight : fam.IsRight (catFactorRight {fam} {C} {D} {f})
      => \lam j => IsOrthogonal_o-right (IsOrthogonal_IsHEquiv-right $ inP $ later \new HQEquiv {
        | finv d => d
        | finv_f d => idp
        | f_finv d => idp
      }) (fromLData.isRight j)

    \sfunc lift {fam : Family} {C D : \Cat} {f : C ->⁺ D} {E : \Cat} (g : C ->⁺ E) {h : E ->⁺ D} (hr : fam.IsRight h)
                (p : \Pi (x :⁺ C) -> h (g x) = f x) (d :⁺ CatFactor f) : \Sigma⁺ (e : E) (h e = catFactorRight d)
      => dataExt {famHat} (famHat_IsRight hr) p d
  }