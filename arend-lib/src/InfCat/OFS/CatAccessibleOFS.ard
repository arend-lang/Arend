\import Data.Bool
\import Equiv
\import Function
\import Function.Meta
\import Homotopy.Cube
\import InfCat.Basics
\import InfCat.CatPushout
\import InfCat.Functor.Equiv
\import InfCat.Functor.FullyFaithful
\import InfCat.OFS.CatOFS
\import InfCat.Objects
\import InfCat.Paths
\import Logic
\import Logic.Meta
\import Meta
\import Paths
\import Paths.Meta
\open CatFactor \using (Family)

\type CatFactor {fam : Family} {C D : \Cat} (f : C ->⁺ D)
  => LData {famHat} f
  \where {
    \protected \class Family {
      | J : \Type
      | X : J -> \Cat
      | Y : J -> \Cat
      | F : \Pi (j : J) -> X j ->⁺ Y j

      \func IsRight {C D : \Cat} (g : C ->⁺ D) : \Prop
        => \Pi (j : J) -> IsOrthogonal (F j) g
    }

    \data LData {fam : Family} {C D : \Cat} (f : C ->⁺ D)
      | alpha (c :⁺ C)
      | lext {j : J} (u : X j ->⁺ LData f) (v : Y j ->⁺ D) (c : \Pi (x :⁺ X j) -> v (F j x) = fromLData (u x)) (y :⁺ Y j)
      | isExt {j : J} (u : X j ->⁺ LData f) (v : Y j ->⁺ D) (c : \Pi (x :⁺ X j) -> v (F j x) = fromLData (u x)) (x :⁺ X j) : lext u v c (F j x) = u x

    \lemma alpha-isSurj {fam : Family} (fs : \Pi (j : J) -> IsSurjMap (F j)) {C D : \Cat} {f : C ->⁺ D} : IsSurjMap (alpha {fam} {C} {D} {f})
      => induction __
      \where {
        \private \lemma induction (d : LData {fam} f) : ∃ (c : C) (alpha c = d) \elim d
          | alpha c => inP (c,idp)
          | lext {j} u v c y => \case fs j y \with {
            | inP (x,Fx=y) => \case induction (u x) \with {
              | inP (r,ar=ux) => inP (r, ar=ux *> inv (path (isExt u v c x)) *> pmap (lext u v c) Fx=y)
            }
          }
      }

    \func fromLData {fam : Family} {C D : \Cat} {f : C ->⁺ D} (d :⁺ LData f) : D \elim d
      | alpha c => f c
      | lext u v c y => v y
      | isExt u v c x => c x
      \where {
        \lemma isRight : fam.IsRight (fromLData {famHat} {C} {D} {f})
          => \lam j => IsEquiv.fromMonoRetraction (later \lam {ob h} {ob h'} p =>
              \have r (e :⁺ CatPushout (F j) (F j)) => path $ isExt {famHat} {C} {D} {f} {j,false}
                      (lift2 $ CatPushout.rec h h' \lam x => path \lam i => (p i).1.1 x)
                      (\lam y => fromLData {famHat} (h y))
                      (lift2 $ CatPushout.elim (\lam y => idp) (\lam y => path \lam i => (p i).1.2 y) $ later
                                 \lam x => Cube2.map idp _ idp (path \lam i => fromLData {famHat} ((p i).1.1 x)) $
                                 inv $ pmap+ (*> _) (path \lam j => path \lam i => (p i).2 x j) *> *>_inv)
                      (dHat2 e)
              \in pmap ob $ ext \lam y => inv (r (cinl y)) *> r (cinr y)) $ later \new Retraction {
                | sec s => ob $ lext {famHat} {C} {D} {f} {j,true} (lift s.1.1) s.1.2 (lift s.2)
                | f_sec s => ext (ext (path \lam i x => isExt (lift s.1.1) s.1.2 (lift s.2) (dHat1 x) i, idp),
                                  simp_coe \lam x => transport+_path_pmap (\lam _ => s.1.2 (fam.F j x)) (\lam y => y) idp)
              }

        \private \func lift {j : J} {B : DHat j true ->⁺ \Cat} (u : \Pi (x :⁺ fam.X j) -> B (dHat1 x)) (d :⁺ DHat j true) : B d \elim d
          | dHat1 x => u x

        \private \func lift2 {j : fam.J} {B : DHat j false ->⁺ \Cat} (u : \Pi (x :⁺ CatPushout (F j) (F j)) -> B (dHat2 x)) (d :⁺ DHat j false) : B d \elim d
          | dHat2 x => u x
      }

    \func dataExt {fam : Family} {C D : \Cat} {f : C ->⁺ D} {E : \Cat} {g : C ->⁺ E} {h : E ->⁺ D} (hr : fam.IsRight h) (p : \Pi (x :⁺ C) -> h (g x) = f x) (d :⁺ LData f) : \Sigma⁺ (e : E) (h e = fromLData d) \elim d
      | alpha x => (g x, p x)
      | lext {j} u v c y =>
        \have r => IsEquiv.splitSurj (hr j) ((\lam x => (dataExt hr p (u x)).1, v), \lam x => c x *> inv (dataExt hr p (u x)).2)
        \in (unob r.1 y, path \lam i => (r.2 i).1.2 y)
      | isExt {j} u v c x => unfold_let
        \let | r => IsEquiv.f_ret (hr j) {(\lam x => (dataExt hr p (u x)).1, v), \lam x => c x *> inv (dataExt hr p (u x)).2}
             | q => pmap+ (*> (dataExt hr p (u x)).2) $ inv idp_*> *> coe_path_pmap.conv (path \lam i => (r i).1.2 (F j x)) (path \lam i => h ((r i).1.1 x)) ((simp_coe in pmapd __.2 r) x) *> inv *>-assoc
        \in sigma-depPath (path \lam i => (r i).1.1 x) (pathOver $ coe_path (path \lam i => h ((IsEquiv.f_ret (hr j) i).1.1 x)) _ _ *> rotatePathLeft (inv $ q *> *>-assoc *> pmap+ (_ *> __) inv_*>))

    \data DHat {fam : Family} (j : J) (b : Bool) \elim b
      | true => dHat1 (x :⁺ X j)
      | false => dHat2 (p :⁺ CatPushout (F j) (F j))

    \func unDHat1 {fam : Family} {j : J} (d :⁺ DHat j true) : X j \elim d
      | dHat1 x => x

    \func unDHat2 {fam : Family} {j : J} (d :⁺ DHat j false) : CatPushout (F j) (F j) \elim d
      | dHat2 y => y

    \func FHat {fam : Family} (j : J) (b : Bool) (d :⁺ DHat j b) : Y j \elim b, d
      | true, dHat1 x => F j x
      | false, dHat2 y => CatPushout.rec (\lam x => x) (\lam x => x) (\lam x => idp) y

    \func famHat {fam : Family}
      => \new Family (\Sigma J Bool) (\lam s => DHat s.1 s.2) (\lam s => Y s.1) (\lam s => FHat s.1 s.2)

    \lemma famHat_IsRight {fam : Family} {C D : \Cat} {f : C ->⁺ D} (fr : fam.IsRight f) : famHat.IsRight f
      => \case \elim __ \with {
        | (j,true) => transport (IsOrthogonal __ f) (ext \lam (dHat1 x) => idp) $
          IsOrthogonal_o-left (IsOrthogonal_IsHEquiv-left $ inP \new HQEquiv {
            | f => unDHat1
            | finv => dHat1
            | finv_f (dHat1 x) => idp
            | f_finv => idpe
          }) (fr j)
        | (j,false) => transport (IsOrthogonal __ f) (ext \lam (dHat2 y) => idp) $
          IsOrthogonal_o-left (IsOrthogonal_IsHEquiv-left $ inP \new HQEquiv {
            | f => unDHat2
            | finv => dHat2
            | finv_f (dHat2 x) => idp
            | f_finv => idpe
          }) $ IsOrthogonal-codiag (fr j)
      }
  }

\cons catFactorLeft {fam : Family} {C D : \Cat} {f : C ->⁺ D} (c :⁺ C) : CatFactor f
  => alpha c
  \where {
    -- TODO: Prove that catFactorLeft is left orthogonal to any right map.

    \protected \lemma isSurj {fam : Family} (fs : \Pi (j : fam.J) -> IsSurjMap (fam.F j)) {C D : \Cat} {f : C ->⁺ D}
      : IsSurjMap (catFactorLeft {fam} {C} {D} {f})
      => IsSurj.comp {_} {_} {CatFactor f} (alpha-isSurj {famHat} \case \elim __ \with {
        | (j, true) => \lam y => \case fs j y \with {
          | inP (x,p) => inP (dHat1 x, p)
        }
        | (j, false) => \lam y => inP (dHat2 (cinl y), idp)
      }) {\lam x => x} \lam x => inP (x,idp)
  }

\func catFactorRight {fam : Family} {C D : \Cat} {f : C ->⁺ D} (x :⁺ CatFactor f) : D
  => fromLData {famHat} x
  \where {
    \lemma isRight : fam.IsRight (catFactorRight {fam} {C} {D} {f})
      => \lam j => IsOrthogonal_o-right (IsOrthogonal_IsHEquiv-right $ inP $ later \new HQEquiv {
        | finv d => d
        | finv_f d => idp
        | f_finv d => idp
      }) (fromLData.isRight j)

    \sfunc lift {fam : Family} {C D : \Cat} {f : C ->⁺ D} {E : \Cat} (g : C ->⁺ E) {h : E ->⁺ D} (hr : fam.IsRight h)
                (p : \Pi (x :⁺ C) -> h (g x) = f x) (d :⁺ CatFactor f) : \Sigma⁺ (e : E) (h e = catFactorRight d)
      => dataExt {famHat} (famHat_IsRight hr) p d
  }