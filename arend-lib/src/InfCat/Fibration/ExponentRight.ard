{- | Fiberwise core of exponents of cartesian fibrations.
 -
 -   Let `p : E ->⁺ A` be a cartesian fibration and let `C` be a category. Suppose we can construct the exponent
 -   from `p` to `C` over `A` and then take fiberwise core of this category over `A`.
 -   This will be a left fibration over `A`. Applying `Op`, we get a right fibration over `Op A`.
 -   Our aim is to construct this fibration directly.
 -
 -   This module does this construction in presented form.
 -   Consider a functor `R : B ->⁺ X ->⁺ \Type u` together with a set of weak equivalences `W` on `X`.
 -   For `b : B`, consider the category of elements `K_b = \Sigma⁺ (x : X) (R b x)` of `R b`.
 -   The family `b ↦ K_b` is a cartesian fibration over `Op B`.
 -   If we apply fiberwise localization to `K_b`, we still get a cartesian fibration over `Op B`.
 -   We construct the fiberwise core of the exponent of this cartesian fibration.
 -
 -   Note that any cartesian fibration `p : E ->⁺ A` can be presented in this form.
 -   Define `B = Op A`, `X = E`, `R a x = Op.Hom a (p x)`, and `W` as the set of cartesian arrows.
 -   Then the family of localizations of `K_b` is equivalent to the family of fibers of `p`.
 -   We do not need this presentation theorem, so we skip the proof.
 -
 -   Interface:
 -   * {exp-proj} `: Exp C R W ->⁺ B` is a right fibration ({exp-rightFib}).
 -   * Universal property ({exp-sec}): for every `pi : T ->⁺ B`, sections of the fibers of {exp-proj} along `pi` are functors to {C}
 -     on the category of elements of `(t, x) ↦ R (pi t) x` ({secFam}) inverting the arrows whose `X`-component is in `W` ({secW}),
 -     provided `W` contains the identities. At each `t`, the section {exp-sec.map} of a functor is its restriction ({exp-sec-point}).
 -   * Fibers ({exp-nu-equiv}): objects of the fiber over `b` are functors `K_b ->⁺ C` inverting `ExpW W`,
 -     and transport is precomposition with {expMap} ({exp-nu-tr}).
 -
 -   Construction: {target} from {CartSubCat} `P` to `P = \Sigma⁺ (x : X) (Op.{u} C) ->⁺ \Type u` is a right fibration.
 -   Its sections along a functor are functors on the category of elements inverting the arrows constant in the second variable
 -   ({target-sec}). We pull it back along {Exp.expFam} `R` and restrict to the full subcategory {Exp.ExpPred} of objects
 -   whose curried functor has representable values and inverts `ExpW W` ({Exp.IsExpFun}); this subcategory is stable under transport.
 -   Functors with representable values are functors to {C} by the Yoneda embedding ({postcomp-image-equiv}).
 -}

\import Equiv
\import Equiv.Sigma
\import Function.Meta
\import InfCat.Basics
\import InfCat.Interval
\import InfCat.CartesianClosed.TypeLCCC
\import InfCat.Fibration.Categorical
\import InfCat.Fibration.CodomainRight
\import InfCat.Fibration.LeftFib
\import InfCat.Functor.Conservative
\import InfCat.Fibration.RightFib
\import InfCat.Functor.FullyFaithful
\import InfCat.Localization.Abstract
\import InfCat.Opposite
\import InfCat.Rezk
\import InfCat.Slice.TotalSlice
\import InfCat.SubCat.Full
\import InfCat.Yoneda.YonedaLemma
\import Logic
\import Logic.Meta
\import Logic.Unique
\import Paths
\import Paths.Meta
\open CartSubCat
\open pullbackSlice-isProduct
\open sumSlice-equiv
\open Exp

-- | The arrows of the category of elements of {F} whose image in {X} satisfies {W}.
\func ExpW {X : \Cat} {F : X ->⁺ \Type} (W : (DI ->⁺ X) -> \Prop) (a : DI ->⁺ \Sigma⁺ (x : X) (F x)) : \Prop
  => W (\lam i => (a i).1)

-- | The functor between categories of elements induced by an arrow {beta} of {B}; it is the identity on the {X}-component.
\func expMap.{u} {X B : \Cat u} (R : B ->⁺ X ->⁺ \Type u) {b' b : B} (beta : b' ~> b) (k :⁺ \Sigma⁺ (x : X) (R b' x)) : \Sigma⁺ (x : X) (R b x)
  => totalMap (dmap R beta) k

-- | The total category of the exponent.
\func Exp.{u} {X B : \Cat u} (C : \Cat u) (R : B ->⁺ X ->⁺ \Type u) (W : (DI ->⁺ X) -> \Prop) : \Cat
  => FullSubCat (ExpPred C R W)
  \where {
    -- | {R} as a functor to functors on `X × Op C`, constant in the second variable.
    \func expFam.{u} {X B : \Cat u} (C : \Cat u) (R : B ->⁺ X ->⁺ \Type u) (b :⁺ B) (q :⁺ \Sigma⁺ (x : X) (Op C)) : \Type u
      => R b q.1

    -- | Currying of a functor on the category of elements of {expFam}.
    \func expCurry.{u} {X B : \Cat u} {C : \Cat u} (R : B ->⁺ X ->⁺ \Type u) {b : B}
                       (H : \Sigma⁺ (q : \Sigma⁺ (x : X) (Op C)) (expFam C R b q) ->⁺ \Type u)
                       (k :⁺ \Sigma⁺ (x : X) (R b x)) (c :⁺ Op C) : \Type u
      => H ((k.1, c), k.2)

    -- | A functor to presheaves on {C} with representable values that inverts `ExpW W`.
    \type IsExpFun.{u} {X : \Cat u} {F : X ->⁺ \Type u} (C : \Cat u) (W : (DI ->⁺ X) -> \Prop)
                       (G : \Sigma⁺ (x : X) (F x) ->⁺ Op C ->⁺ \Type u) : \Prop
      => \Sigma (\Pi (k : \Sigma⁺ (x : X) (F x)) -> ∃ (c : C) ((\lam x =>⁺ Op.Hom x c) = G k)) (InvertsW (ExpW W) G)

    -- | The predicate on the pullback of {target} along {expFam}.
    \func ExpPred.{u} {X B : \Cat u} (C : \Cat u) (R : B ->⁺ X ->⁺ \Type u) (W : (DI ->⁺ X) -> \Prop)
                      (t : \Sigma⁺ (b : B) (Fibers (target {\Sigma⁺ (x : X) (Op C) ->⁺ \Type u}) (expFam C R b))) : \Prop
      => IsExpFun C W (expCurry R (fibFam (target-fibers (expFam C R t.1) t.2).2))
  }

-- | The projection of the exponent to {B}.
\func exp-proj.{u} {X B : \Cat u} (C : \Cat u) (R : B ->⁺ X ->⁺ \Type u) (W : (DI ->⁺ X) -> \Prop) (x :⁺ Exp C R W) : B
  => subProj (ExpPred C R W) x

\lemma exp-rightFib.{u} {X B : \Cat u} {C : \Cat u} {R : B ->⁺ X ->⁺ \Type u} {W : (DI ->⁺ X) -> \Prop}
  : IsRightFib (Fibers (exp-proj C R W))
  => rightFib-full (rightFib-pullback (expFam C R) target-rightFib) (ExpPred C R W) (\lam beta e h => pred-tr R beta e h)
  \where
    -- | {ExpPred} is stable under transport: transport is precomposition with {expMap} ({target-tr-totalMap}).
    \lemma pred-tr.{u} {X B : \Cat u} {C : \Cat u} (R : B ->⁺ X ->⁺ \Type u) {W : (DI ->⁺ X) -> \Prop} {b' b : B} (beta : b' ~> b)
                       (e : Fibers (target {\Sigma⁺ (x : X) (Op C) ->⁺ \Type u}) (expFam C R b)) (h : ExpPred C R W (b, e))
      : ExpPred C R W (b', rightFib-tr (rightFib-pullback (expFam C R) target-rightFib) beta e)
      => transport (\lam e' => ExpPred C R W (b', e')) (inv (rightFib-pullback-tr (expFam C R) target-rightFib beta e)) $
         transport (\lam H => IsExpFun C W (expCurry R H)) (inv (target-tr-totalMap (dmap (expFam C R) beta) e))
                   (\lam k => h.1 (expMap R beta k), \lam {a} w => h.2 {\lam i => expMap R beta (a i)} w)

-- | The functor to {C} corresponding to an object of a fiber of {exp-proj}.
\func exp-nu.{u} {X B : \Cat u} {C : \Cat u} (R : B ->⁺ X ->⁺ \Type u) {W : (DI ->⁺ X) -> \Prop} (b : B)
                 (z : Fibers (exp-proj C R W) b) : MapW (ExpW W) C
  => IsEquiv.ret yon-equiv (theta R b (subProj.fibers-equiv (ExpPred C R W) b z))
  \where {
    -- | The curried functor of an object of the pullback of {target}, with its property.
    \func theta.{u} {X B : \Cat u} {C : \Cat u} (R : B ->⁺ X ->⁺ \Type u) {W : (DI ->⁺ X) -> \Prop} (b : B)
                    (s : \Sigma (e : Fibers (target {\Sigma⁺ (x : X) (Op C) ->⁺ \Type u}) (expFam C R b)) (ExpPred C R W (b, e)))
      : \Sigma (G : \Sigma⁺ (x : X) (R b x) ->⁺ Op C ->⁺ \Type u) (IsExpFun C W G)
      => (expCurry R (fibFam (target-fibers (expFam C R b) s.1).2), s.2)

    -- | The composite of a functor to {C} with the Yoneda embedding.
    \func yon.{u} {X : \Cat u} {F : X ->⁺ \Type u} {C : \Cat u} {W : (DI ->⁺ X) -> \Prop} (h : MapW (ExpW {_} {F} W) C)
      : \Sigma (G : \Sigma⁺ (x : X) (F x) ->⁺ Op C ->⁺ \Type u) (IsExpFun C W G)
      => (\lam k x => Op.Hom x (h.1 k), (\lam k => inP (h.1 k, idp), invertsW-postcomp (\lam y x =>⁺ Op.Hom x y) h.2))

    -- | Functors to {C} inverting {W} are functors to presheaves on {C} with representable values inverting {W} ({yonedaEmbedding}).
    \lemma yon-equiv.{u} {X : \Cat u} {F : X ->⁺ \Type u} {C : \Cat u} {W : (DI ->⁺ X) -> \Prop}
      : IsEquiv {MapW (ExpW W) C} {\Sigma (G : \Sigma⁺ (x : X) (F x) ->⁺ Op C ->⁺ \Type u) (IsExpFun C W G)} yon
      => IsEquiv.trans (inP $ sigma-equiv {_} {_} {_} {\lam s => InvertsW (ExpW W) s.1}
                                (IsEquiv.toQEquiv (postcomp-image-equiv yonedaEmbedding))
                                \lam h => \new QEquiv {
                                  | f => invertsW-postcomp (\lam y x =>⁺ Op.Hom x y)
                                  | ret => invertsW-postcomp-ff (yonedaEmbedding {C})
                                  | ret_f _ => prop-pi
                                  | f_sec _ => prop-pi
                                }) $
           inP \new QEquiv {
             | f s => (s.1.1, (s.1.2, s.2))
             | ret t => ((t.1, t.2.1), t.2.2)
             | ret_f _ => idp
             | f_sec _ => idp
           }
  }

\lemma exp-nu-equiv.{u} {X B : \Cat u} {C : \Cat u} {R : B ->⁺ X ->⁺ \Type u} {W : (DI ->⁺ X) -> \Prop} (b : B)
  : IsEquiv (exp-nu R b)
  => \have base-equiv : IsEquiv {Fibers target (expFam C R b)}
                                {\Sigma⁺ (x : X) (R b x) ->⁺ Op C ->⁺ \Type u}
                                (\lam e => expCurry R (fibFam (target-fibers (expFam C R b) e).2))
           => IsEquiv.trans (target-fibers-equiv (expFam C R b)) $
              IsEquiv.trans (inP (symQEquiv (totalFun-slice (expFam C R b)))) $ inP \new QEquiv {
                | f => expCurry R
                | ret G s => G (s.1.1, s.2) s.1.2
                | ret_f _ => idp
                | f_sec _ => idp
              }
     \in IsEquiv.trans (inP (subProj.fibers-equiv (ExpPred C R W) b)) $
         IsEquiv.trans (inP (qsigma-left (IsEquiv.toQEquiv base-equiv))) (IsEquiv.ret-equiv exp-nu.yon-equiv)

-- | Transport along {beta} is precomposition with {expMap} {beta}.
\sfunc exp-nu-tr.{u} {X B : \Cat u} {C : \Cat u} {R : B ->⁺ X ->⁺ \Type u} {W : (DI ->⁺ X) -> \Prop} {b' b : B} (beta : b' ~> b)
                     (z : Fibers (exp-proj C R W) b) {k :⁺ \Sigma⁺ (x : X) (R b' x)}
  : (exp-nu R b' (rightFib-tr exp-rightFib beta z)).1 k = (exp-nu R b z).1 (expMap R beta k)
  => \have | yon-path (d : B) (w : Fibers (exp-proj C R W) d)
             : (\lam k x =>⁺ Op.Hom x ((exp-nu R d w).1 k)) = (exp-nu.theta R d (subProj.fibers-equiv (ExpPred C R W) d w)).1
             => pmap __.1 (IsEquiv.f_ret exp-nu.yon-equiv)
           | tr-path : (exp-nu.theta R b' (subProj.fibers-equiv (ExpPred C R W) b' (rightFib-tr exp-rightFib beta z))).1
                       = (\lam k =>⁺ (exp-nu.theta R b (subProj.fibers-equiv (ExpPred C R W) b z)).1 (expMap R beta k))
             => \let e => (subProj.fibers-equiv (ExpPred C R W) b z).1
                \in pmap (\lam e' => expCurry R (fibFam (target-fibers (expFam C R b') e').2))
                        (rightFib-full-tr (rightFib-pullback (expFam C R) target-rightFib) (ExpPred C R W)
                                          (\lam beta' e' h => exp-rightFib.pred-tr R beta' e' h) beta z
                         *> rightFib-pullback-tr (expFam C R) target-rightFib beta e)
                   *> pmap (expCurry R) (target-tr-totalMap (dmap (expFam C R) beta) e)
     \in \let | t => rightFib-tr (exp-rightFib {_} {_} {_} {R}) beta z
              | q => (IsFFMap.isObEmbedding (postcomp-ff yonedaEmbedding)).isEmb (exp-nu R b' t).1 (\lam k' => (exp-nu R b z).1 (expMap R beta k'))
     \in path \lam i => q.sec (yon-path b' t *> tr-path *> pmap (\lam H => \lam k' =>⁺ H (expMap R beta k')) (inv (yon-path b z))) i k

-- # Sections

-- | The family `(t, x) ↦ R (pi t) x` over `T × X`.
\func secFam.{u} {X B T : \Cat u} (R : B ->⁺ X ->⁺ \Type u) (pi : T ->⁺ B) (q :⁺ \Sigma⁺ (t : T) X) : \Type u
  => R (pi q.1) q.2

-- | The arrows of `T × X` whose `X`-component satisfies {W}.
\func secW {X T : \Cat} (W : (DI ->⁺ X) -> \Prop) (a : DI ->⁺ \Sigma⁺ (t : T) X) : \Prop
  => W (\lam i => (a i).2)

{- | Sections of the fibers of {exp-proj} along {pi} are functors to {C} on the category of elements of {secFam}
 -   inverting {secW}; the section {map} of a functor is described pointwise by {exp-sec-point}.
 -}
\lemma exp-sec.{u} {X B T : \Cat u} {C : \Cat u} {R : B ->⁺ X ->⁺ \Type u} {W : (DI ->⁺ X) -> \Prop}
                   (Wid : \Pi (x : X) -> W (\lam _ => x)) (pi : T ->⁺ B)
  : IsEquiv {MapW (ExpW (secW W)) C} {\Pi (t :⁺ T) -> Fibers (exp-proj C R W) (pi t)} (map Wid pi)
  => transport IsEquiv (path \lam i F => inv (\peval map Wid pi F) i) $
     IsEquiv.trans exp-nu.yon-equiv $
     IsEquiv.trans (inP (split-equiv Wid pi)) $
     IsEquiv.trans (inP (sigma-equiv (IsEquiv.toQEquiv (target-sec (\lam t => expFam C R (pi t)))) (pred-equiv pi)))
                   (IsEquiv.ret-equiv (subProj.sections-equiv (ExpPred C R W) pi))
  \where {
    {- | The section of the fibers of {exp-proj} corresponding to a functor {F}:
     -   compose {F} with the Yoneda embedding ({exp-nu.yon}), uncurry it ({split-equiv}),
     -   take the corresponding section of {target} ({target-sec.map}), and lift it to the full subcategory ({subProj.sections-equiv}).
     -}
    \protected \sfunc map.{v} {X B T : \Cat v} {C : \Cat v} {R : B ->⁺ X ->⁺ \Type v} {W : (DI ->⁺ X) -> \Prop}
                              (Wid : \Pi (x : X) -> W (\lam _ => x)) (pi : T ->⁺ B) (F : MapW (ExpW {_} {secFam R pi} (secW W)) C)
      : \Pi (t :⁺ T) -> Fibers (exp-proj C R W) (pi t)
      => IsEquiv.ret (subProj.sections-equiv (ExpPred C R W) pi)
           (target-sec.map (split-equiv Wid pi (exp-nu.yon F)).1,
            pred-equiv pi (split-equiv {X} {B} {T} {C} {R} {W} Wid pi (exp-nu.yon F)).1
                       (split-equiv {X} {B} {T} {C} {R} Wid pi (exp-nu.yon F)).2)

    -- | The restriction of a functor on the category of elements over `T × (X × Op C)` to `t`.
    \func restr.{v} {X B T : \Cat v} {C : \Cat v} (R : B ->⁺ X ->⁺ \Type v) (pi : T ->⁺ B)
                    (m : \Sigma⁺ (s : \Sigma⁺ (t : T) (\Sigma⁺ (x : X) (Op C))) (HTot (\lam t q => expFam C R (pi t) q) s) ->⁺ \Type v) (t : T)
                    (z :⁺ \Sigma⁺ (q : \Sigma⁺ (x : X) (Op C)) (expFam C R (pi t) q)) : \Type v
      => m ((t, z.1), z.2)

    \func split-equiv.{v} {X B T : \Cat v} {C : \Cat v} {R : B ->⁺ X ->⁺ \Type v} {W : (DI ->⁺ X) -> \Prop}
                          (Wid : \Pi (x : X) -> W (\lam _ => x)) (pi : T ->⁺ B)
      : QEquiv {\Sigma (G : \Sigma⁺ (q : \Sigma⁺ (t : T) X) (secFam R pi q) ->⁺ Op C ->⁺ \Type v) (IsExpFun C (secW W) G)}
               {\Sigma (m : MapW TArrow (\Type v))
                       (\Pi (t : T) -> IsExpFun C W (expCurry R (restr R pi m.1 t)))} \cowith
      | f s => ((\lam z => s.1 ((z.1.1, z.1.2.1), z.2) z.1.2.2, tarrow-inv R W Wid s.2.2),
                \lam t => (\lam k => s.2.1 ((t, k.1), k.2), \lam {a} => s.2.2 {\lam i => ((t, (a i).1), (a i).2)}))
      | ret s => (cur R pi s.1.1, (\lam k => (s.2 k.1.1).1 (k.1.2, k.2), sec-inv R pi s.1 s.2))
      | ret_f _ => ext idp
      | f_sec _ => ext idp
      \where {
        -- | Currying of a functor on the category of elements over `T × (X × Op C)`.
        \func cur.{w} {X B T : \Cat w} {C : \Cat w} (R : B ->⁺ X ->⁺ \Type w) (pi : T ->⁺ B)
                      (m : \Sigma⁺ (s : \Sigma⁺ (t : T) (\Sigma⁺ (x : X) (Op C))) (HTot (\lam t q => expFam C R (pi t) q) s) ->⁺ \Type w)
                      (k :⁺ \Sigma⁺ (q : \Sigma⁺ (t : T) X) (secFam R pi q)) (c :⁺ Op C) : \Type w
          => m ((k.1.1, (k.1.2, c)), k.2)

        -- | A functor inverting {secW} inverts the arrows constant in the `X × Op C`-direction.
        \lemma tarrow-inv.{w} {X B T : \Cat w} {C : \Cat w} (R : B ->⁺ X ->⁺ \Type w) (W : (DI ->⁺ X) -> \Prop)
                              (Wid : \Pi (x : X) -> W (\lam _ => x)) {pi : T ->⁺ B}
                              {G : \Sigma⁺ (q : \Sigma⁺ (t : T) X) (secFam R pi q) ->⁺ Op C ->⁺ \Type w}
                              (Gi : InvertsW (ExpW {_} {secFam R pi} (secW W)) G)
          : InvertsW (TArrow {T} {_} {\lam t q => expFam C R (pi t) q}) (\lam z => G ((z.1.1, z.1.2.1), z.2) z.1.2.2)
          => \lam {a} => \case \elim __ \with {
               | inP (y, p) => const-iso R W Wid pi Gi y p (\lam i => (a i).2)
             }

        \lemma const-iso.{w} {X B T : \Cat w} {C : \Cat w} (R : B ->⁺ X ->⁺ \Type w) (W : (DI ->⁺ X) -> \Prop)
                             (Wid : \Pi (x : X) -> W (\lam _ => x)) (pi : T ->⁺ B)
                             {G : \Sigma⁺ (q : \Sigma⁺ T X) (secFam R pi q) ->⁺ Op C ->⁺ \Type w}
                             (Gi : InvertsW (ExpW (secW W)) G)
                             {tau : DI ->⁺ T} (y : \Sigma⁺ X (Op C)) {zeta : DI ->⁺ \Sigma⁺ X (Op C)}
                             (p : (\lam _ =>⁺ y) = zeta) (rho : \Pi (i :⁺ DI) -> R (pi (tau i)) (zeta i).1)
          : IsIso (dpath \lam i => G ((tau i, (zeta i).1), rho i) (zeta i).2) \elim p
          | idp => dmap_IsIso (\lam F => F y.2) (Gi (Wid y.1))

        -- | A functor inverting the arrows constant in the `X × Op C`-direction and {W} on the fibers inverts {secW}.
        \lemma sec-inv.{w} {X B T : \Cat w} {C : \Cat w} (R : B ->⁺ X ->⁺ \Type w) {W : (DI ->⁺ X) -> \Prop} (pi : T ->⁺ B)
                           (m : MapW (TArrow {T} {_} {\lam t => expFam C R (pi t)}) (\Type w))
                           (p : \Pi (t : T) -> IsExpFun C W (expCurry R (restr R pi m.1 t)))
          : InvertsW (ExpW (secW W)) (cur R pi m.1)
          => \lam {b} w => transport (\lam s => IsIso (dmap (cur R pi m.1) s.2)) (factor b) $
               transportInv IsIso (dmap_comp (cur R pi m.1) {_} {_} {_} {dpath (factor.fb1 b)} {dpath (factor.fb2 b)})
                 (comp-IsIso (objectwise-iso {_} {_} {_} {_} {dmap (cur R pi m.1) (dpath (factor.fb1 b))}
                                \lam c => m.2 {\lam i => (((b i).1.1, ((b dleft).1.2, c)), (factor.fb1 b i).2)} (inP (((b dleft).1.2, c), idp)))
                             ((p (b dright).1.1).2 {\lam j => ((b j).1.2, (factor.fb2 b j).2)} w))

        -- | An arrow over `T × X` is a composite of an arrow in the `T`-direction and an arrow in the `X`-direction.
        \sfunc factor.{w} {T X : \Cat w} {F : \Sigma⁺ T X ->⁺ \Type w} (b : DI ->⁺ \Sigma⁺ (q : \Sigma⁺ T X) (F q))
          : (fb2 b dright, comp (dpath (fb1 b)) (dpath (fb2 b))) = {\Sigma (e : \Sigma⁺ (q : \Sigma⁺ (t : T) X) (F q)) (b dleft ~> e)} (b dright, dpath b)
          => \have base-path : dmap __.1 (comp (dpath (fb1 b)) (dpath (fb2 b))) = dpath (\lam i => (b i).1)
                   => \let | ab : (b dleft).1 ~> ((b dright).1.1, (b dleft).1.2)
                             => dpath \lam i => ((b i).1.1, (b dleft).1.2)
                           | bc : ((b dright).1.1, (b dleft).1.2) ~> {\Sigma⁺ T X} (b dright).1
                             => dpath \lam j => ((b dright).1.1, (b j).1.2)
                      \in dmap_comp __.1 {fb1 b dleft} {fb1 b dright} {fb2 b dright}
                          *> pmap __.1 (isContr=>isProp (segal-contr ab bc) (comp ab bc, dpath \lam i => dpath (fill2 ab bc i))
                                         (dpath (\lam i => (b i).1), dpath \lam i => dpath \lam j => ((b i).1.1, (b (dmin i j)).1.2)))
             \in IsEquiv.isInj (leftFib-coslice-equiv (leftFib-pullback F universe-leftFib) (b dleft)) $
                  path \lam k => ((b dright).1, base-path k)
          \where {
            \func fb1.{v} {T X : \Cat v} {F : \Sigma⁺ T X ->⁺ \Type v} (b : DI ->⁺ \Sigma⁺ (q : \Sigma⁺ T X) (F q)) (i :⁺ DI)
              : \Sigma⁺ (q : \Sigma⁺ T X) (F q)
              => (((b i).1.1, (b dleft).1.2), coe+ (\lam m => F ((b m).1.1, (b dleft).1.2)) (b dleft).2 i)

            \func fb2.{v} {T X : \Cat v} {F : \Sigma⁺ T X ->⁺ \Type v} (b : DI ->⁺ \Sigma⁺ (q : \Sigma⁺ T X) (F q)) (j :⁺ DI)
              : \Sigma⁺ (q : \Sigma⁺ T X) (F q)
              => (((b dright).1.1, (b j).1.2), coe+ (\lam m => F ((b dright).1.1, (b m).1.2)) (fb1 b dright).2 j)
          }
      }

    \func pred-equiv.{v} {X B T : \Cat v} {C : \Cat v} {R : B ->⁺ X ->⁺ \Type v} {W : (DI ->⁺ X) -> \Prop} (pi : T ->⁺ B)
                         (m : MapW (TArrow {T} {_} {\lam t => expFam C R (pi t)}) (\Type v))
      : QEquiv {\Pi (t : T) -> IsExpFun C W (expCurry R (restr R pi m.1 t))}
               {\Pi (t : T) -> ExpPred C R W (pi t, target-sec.map m t)} \cowith
      | f p t => transport (\lam G => IsExpFun C W (expCurry R G)) (inv (fib-path pi m t)) (p t)
      | ret p t => transport (\lam G => IsExpFun C W (expCurry R G)) (fib-path pi m t) (p t)
      | ret_f _ => prop-pi
      | f_sec _ => prop-pi
      \where
        -- | The functor of the slice of {target-sec} at `t` is the restriction of {m}.
        \sfunc fib-path.{w} {X B T : \Cat w} {C : \Cat w} {R : B ->⁺ X ->⁺ \Type w} (pi : T ->⁺ B)
                            (m : MapW (TArrow {T} {_} {\lam t => expFam C R (pi t)}) (\Type w)) (t : T)
          : fibFam (target-fibers (expFam C R (pi t)) (target-sec.map m t)).2 = restr R pi m.1 t
          => pmap (\lam s => fibFam s.2) (target-sec-fibers (\lam t => expFam C R (pi t)) m t)
             *> (totalFun-slice (expFam C R (pi t))).ret_f _
  }

-- | The functor of {exp-nu} at `t` of the section {exp-sec.map} of {F} is {F} restricted to `t`.
\sfunc exp-sec-point.{u} {X B T : \Cat u} {C : \Cat u} {R : B ->⁺ X ->⁺ \Type u} {W : (DI ->⁺ X) -> \Prop}
                         (Wid : \Pi (x : X) -> W (\lam _ => x)) (pi : T ->⁺ B)
                         (F : MapW (ExpW {_} {secFam R pi} (secW W)) C) (t : T)
                         {k :⁺ \Sigma⁺ (x : X) (R (pi t) x)}
  : (exp-nu R (pi t) (exp-sec.map Wid pi F t)).1 k = F.1 ((t, k.1), k.2)
  => \let | restrF : MapW (ExpW W) C
            => (\lam k => F.1 ((t, k.1), k.2), \lam {a} w => F.2 {\lam i => ((t, (a i).1), (a i).2)} w)
          | mOf => (exp-sec.split-equiv Wid pi (exp-nu.yon F)).1
     \in \have
          | sec-path : (subProj.fibers-equiv (ExpPred C R W) (pi t) (exp-sec.map Wid pi F t)).1 = target-sec.map mOf t
            => pmap (\lam s => (subProj.fibers-equiv (ExpPred C R W) (pi t) (s t)).1) (\peval exp-sec.map Wid pi F)
               *> path \lam i => (IsEquiv.f_ret (subProj.sections-equiv (ExpPred C R W) pi) i).1 t
          | theta-path : exp-nu.theta R (pi t) (subProj.fibers-equiv (ExpPred C R W) (pi t) (exp-sec.map Wid pi F t)) = exp-nu.yon restrF
            => ext $ pmap (\lam e => expCurry R (fibFam (target-fibers (expFam C R (pi t)) e).2)) sec-path
                     *> pmap (expCurry R) (exp-sec.pred-equiv.fib-path pi mOf t)
          | fun-path : exp-nu R (pi t) (exp-sec.map {_} {_} {_} {_} {R} Wid pi F t) = restrF
            => pmap (IsEquiv.ret exp-nu.yon-equiv) theta-path *> IsEquiv.ret_f exp-nu.yon-equiv {restrF}
     \in path \lam i => (fun-path i).1 k