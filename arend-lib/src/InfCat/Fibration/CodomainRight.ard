{- | The codomain right fibration.
 -
 -   This is not the target projection `(DI ->⁺ C) ->⁺ C` of the whole arrow category, but its restriction to a wide subcategory.
 -   The objects of {CartSubCat} are arrows `x ~> y` of {C}, and its morphisms are pullback squares between them
 -   ({IsPullbackSquare.isPullback-idd} and {IsPullbackSquare.paste} make it a wide subcategory of `DI ->⁺ C`).
 -   The functor {cod} from `Cart C` to {C} sends an arrow `G ~> F` to its target `F`.
 -
 -   If {C} has pullbacks, then {cod} is a right fibration ({cod-rightFib}):
 -   a lift of an arrow `p : a' ~> cod x` is a pullback square into `x` with bottom side `p`,
 -   and these form a contractible type since pullback squares into `x` are equivalent to the slice over `cod x` via their bottom sides
 -   ({IsPullbackSquare.bottom-equiv}).
 -   The fibers of {cod} are slices ({cod-fibers-equiv}), and transport along `p` is pullback along `p` ({cod-tr-product}).
 -
 -   For functors to types, sections of {target} along `H : T ->⁺ Y ->⁺ \Type u` are functors on the category of elements of `H`
 -   whose sums are pullback squares ({cart-sections}), that is, functors inverting the arrows constant in the `Y`-direction
 -   ({sumSquare-pullback}, {target-sec}). Pullback squares of functors to types are detected pointwise ({pointwise-pullback}, {type-pullback}).
 -}

\import Equiv
\import Equiv.Fiber
\import Equiv.Sigma
\import Function.Meta
\import Homotopy.Fibration
\import InfCat.Basics
\import InfCat.CartesianClosed.TypeLCCC
\import InfCat.Fibration.Categorical
\import InfCat.Fibration.RightFib
\import InfCat.Functor.Embedding
\import InfCat.Interval
\import InfCat.Limit.Product
\import InfCat.Limit.Pullback
\import InfCat.Limit.PullbackFun
\import InfCat.Fibration.CovariantLift
\import InfCat.Fibration.DirectedUnivalence
\import InfCat.Fibration.LeftFib
\import InfCat.Localization.Abstract
\import InfCat.Paths
\import InfCat.Rezk
\import InfCat.Slice
\import InfCat.Slice.TotalSlice
\import InfCat.SubCat.Sub
\import Logic
\import Logic.Meta
\import Logic.Unique
\import Meta
\import Paths
\import Paths.Meta
\open pullbackSlice-isProduct
\open sumSlice-equiv
\open CartSubCat
\open IsPullbackSquare

-- | The wide subcategory of the arrow category of {C} on pullback squares.
\func CartSubCat.{u} (C : \Cat u) : \Cat u
  => SubCat (IsPullbackSquare {C})
  \where
    -- | The target projection restricted to pullback squares: an arrow `G ~> F` goes to `F`.
    \func target.{u} {C : \Cat u} (x :⁺ CartSubCat C) : C
      => SubCat.inc x dright

-- | The target projection is a right fibration.
\lemma target-rightFib.{u} {C : \Cat u} {PB : HCatWithPullbacks C} : IsRightFib (Fibers (target {C}))
  => \lam d => aux d.4.1 d.3 d.4.2
  \where {
    \private \lemma aux.{u} {C : \Cat u} {PB : HCatWithPullbacks C} {a' a : C} (x : CartSubCat C) (p : a' ~> a) (q : target x = a)
      : Contr (ContLift (Fibers target) (a', a, p, (x, q))) \elim q
      | idp => Contr.Contr_QEquiv (symQEquiv (fibers-lift-equiv target x p))
                 (IsEquiv=>contrFibers (IsEquiv.trans (IsEquiv.trans (subCat-into-equiv (isPullback-idd, paste) x)
                                                                     (bottom-equiv (SubCat.inc x)))
                                                      (inP \new QEquiv {SliceCat (target x)} {\Sigma (y : C) (y ~> target x)} {
                                                        | f t => (t.1, t.2)
                                                        | ret t => (t.1, t.2)
                                                        | ret_f t => idp
                                                        | f_sec t => idp
                                                      }))
                                       (a', p))
  }

-- | An object of the fiber of {target} over {F} as an object of the slice over {F}.
\func target-fibers.{u} {C : \Cat u} (F : C) (x : Fibers target F) : SliceCat F
  => (SubCat.inc x.1 dleft, transport (SubCat.inc x.1 dleft ~>) x.2 (dpath (SubCat.inc x.1)))

-- | The fibers of {target} are slices.
\lemma target-fibers-equiv.{u} {C : \Cat u} (F : C) : IsEquiv (target-fibers F)
  => inP $ later \new QEquiv {
       | f s => (s.1, s.2)
       | ret s => (s.1, s.2)
       | ret_f s => idp
       | f_sec s => idp
     } `transQEquiv` qsigma-left (IsEquiv.toQEquiv (IsEquiv.fromEmbSurj (IsEmbedding.char.1 SubCat.inc-emb).1
                                                                        (SubCat.inc-surj isPullback-idd)))
       `transQEquiv` fib-slice F
  \where {
    -- | Functors from {DI} ending at {F} are objects of the slice over {F}.
    \func fib-slice {E : \Cat} (F : E) : QEquiv {Fib {DI ->⁺ E} (\lam u => u dright) F} {SliceCat F} \cowith
      | f s => (s.1 dleft, transport (s.1 dleft ~> __) s.2 (dpath s.1))
      | ret s => (\lam i => s.2 i, idp)
      | ret_f s => aux s.2
      | f_sec s => idp
      \where
        \private \sfunc aux {E : \Cat} {u : DI ->⁺ E} {F : E} (e : u dright = F)
          : ((\lam i => transport (u dleft ~> __) e (dpath u) i, idp) : Fib {DI ->⁺ E} (\lam u => u dright) F) = (u, e) \elim e
          | idp => idp
  }

{- | Transport along {p} in {target} is pullback along {p}:
 -   it underlies a product cone of `(a', p)` and {x} in the slice over {a}.
 -}
\sfunc target-tr-product.{u} {C : \Cat u} {PB : HCatWithPullbacks C} {a' a : C} (x : Fibers target a) (p : a' ~> a)
  : \Sigma (c : SliceCat {SliceCat a} (a', p)) (q : c.1 ~> target-fibers a x) (IsProduct c.2 q)
           (SliceCat.over-forget c = target-fibers a' (rightFib-tr target-rightFib p x))
  \elim x
  | (x,idp) => \let v => fibers-lift-equiv target x p (target-rightFib (a', target x, p, (x, idp))).center
               \in cone v.1.2 v.2
  \where {
    -- | An arrow {w} into {x} in {CartSubCat} as a product cone over its image.
    \private \sfunc cone.{u} {C : \Cat u} {x y : CartSubCat C} (w : y ~> x) {t : \Sigma (y : C) (y ~> target x)}
                             (e : (target y, dpath \lam i => target (w i)) = {\Sigma (y : C) (y ~> target x)} t)
      : \Sigma (c : SliceCat {SliceCat (target x)} (t.1, t.2)) (r : c.1 ~> target-fibers (target x) (x, idp)) (IsProduct c.2 r)
               (SliceCat.over-forget c = target-fibers t.1 (y, pmap __.1 e)) \elim e
      | idp => \let s => sliceSquare (\lam i => SubCat.inc (w i))
               \in ((s dleft dleft, dpath (s dleft)), dpath \lam l => s l dleft, (product-char (\lam i => SubCat.inc (w i))).1 $
                    SubCat.inc-con {_} {IsPullbackSquare {C}} (\lam {h} _ => (isPullback-idd (h dleft), isPullback-idd (h dright)), paste) {w}, idp)
  }

-- | For functors to types, transport along {alpha} in {target} is {pullbackSlice}.
\sfunc target-tr-slice.{u} {X : \Cat u} {F' F : X ->⁺ \Type u} (alpha : F' ~> F) (x : Fibers (target {X ->⁺ \Type u}) F)
  : target-fibers F' (rightFib-tr (target-rightFib {X ->⁺ \Type u}) alpha x) = pullbackSlice alpha (target-fibers F x)
  => \let | a => target-tr-product x alpha
          | b => pullbackSlice-isProduct alpha (target-fibers F x)
     \in inv a.4 *> pmap (\lam s => SliceCat.over-forget s.1.1) (IsProduct.cones-unique ((a.1, a.2), a.3) ((b.1, b.2), b.3)) *> b.4

-- | Under {totalFun-slice}, transport along {alpha} in {target} is precomposition with {totalMap} {alpha}.
\sfunc target-tr-totalMap.{u} {X : \Cat u} {F' F : X ->⁺ \Type u} (alpha : F' ~> F) (x : Fibers (target {X ->⁺ \Type u}) F)
  : fibFam (target-fibers F' (rightFib-tr target-rightFib alpha x)).2 = (\lam z => fibFam (target-fibers F x).2 (totalMap alpha z))
  => pmap (\lam s => fibFam s.2) (target-tr-slice alpha x) *> (totalFun-slice F').ret_f _

-- # Sections of the target fibration of functors to types

-- | A functor of two variables as a functor on the product.
\func HTot.{u} {T Y : \Cat u} (H : T ->⁺ Y ->⁺ \Type u) (s :⁺ \Sigma⁺ T Y) : \Type u
  => H s.1 s.2

-- | Arrows of the category of elements of {H} whose `Y`-component is constant.
\type TArrow.{u} {T Y : \Cat u} {H : T ->⁺ Y ->⁺ \Type u} (a : DI ->⁺ \Sigma⁺ (s : \Sigma⁺ (t : T) Y) (HTot H s)) : \Prop
  => ∃ (y : Y) ((\lam _ =>⁺ y) = (\lam i =>⁺ (a i).1.2))

-- | The sum of {G} over the values of {H}, as a functor from {T} to arrows of functors on {Y}.
\func sumSquare.{u} {T Y : \Cat u} (H : T ->⁺ Y ->⁺ \Type u) (G : \Sigma⁺ (s : \Sigma⁺ (t : T) Y) (HTot H s) ->⁺ \Type u)
                   (t :⁺ T) (j :⁺ DI) (y :⁺ Y) : \Type u
  => sumSlice.sumProj (HTot H) G j (t, y)

{- | Sections of {target} along a functor {H} of two variables are functors on the category of elements of {H}
 -   whose sums ({sumSquare}) are families of pullback squares ({cart-sections-fibers}).
 -}
\lemma cart-sections.{u} {T Y : \Cat u} (H : T ->⁺ Y ->⁺ \Type u)
  : IsEquiv {\Sigma (G : \Sigma⁺ (s : \Sigma⁺ (t : T) Y) (HTot H s) ->⁺ \Type u) (SliceB H (sumSlice (HTot H) G))}
            {\Pi (t :⁺ T) -> Fibers (target {Y ->⁺ \Type u}) (H t)}
            (map H)
  => \let | split-equiv : QEquiv {\Sigma (c : T ->⁺ CartSubCat (Y ->⁺ \Type u)) (\Pi (t :⁺ T) -> target (c t) = H t)}
                                 {\Pi (t :⁺ T) -> Fibers (target {Y ->⁺ \Type u}) (H t)}
                        => \new QEquiv {
                             | f c t => (c.1 t, c.2 t)
                             | ret s => (\lam t => (s t).1, \lam t => (s t).2)
                             | ret_f _ => idp
                             | f_sec _ => idp
                           }
          | e => qsigma-left (totalFun-slice (HTot H))
                   `transQEquiv` qsigma-left (symQEquiv (target-fibers-equiv.fib-slice (HTot H)))
                   `transQEquiv` curry-equiv H
                   `transQEquiv` symQEquiv (sub-equiv H)
                   `transQEquiv` split-equiv
     \in \have agree (Gc : \Sigma (G : \Sigma⁺ (s : \Sigma⁺ (t : T) Y) (HTot H s) ->⁺ \Type u) (SliceB H (sumSlice (HTot H) G))) : e Gc = map H Gc
               => pmap split-equiv (pmap (sub-equiv H).ret (inv (sub-path (funExt+ (lift H Gc).2)))
                                    *> (sub-equiv H).ret_f (\lam t => (map H Gc t).1, \lam t => (map H Gc t).2))
     \in inP \new QEquiv {
       | ret => e.ret
       | ret_f Gc => pmap e.ret (inv (agree Gc)) *> e.ret_f Gc
       | f_sec s => inv (agree (e.ret s)) *> e.f_sec s
     }
  \where {
    -- | The arrow {sumSquare} at `t` as an object of the fiber of {target} over `H t`.
    \protected \func map.{v} {T Y : \Cat v} (H : T ->⁺ Y ->⁺ \Type v)
                  (Gc : \Sigma (G : \Sigma⁺ (s : \Sigma⁺ (t : T) Y) (HTot H s) ->⁺ \Type v) (SliceB H (sumSlice (HTot H) G)))
                  (t :⁺ T) : Fibers (target {Y ->⁺ \Type v}) (H t)
      => ((lift H Gc).1 t, pmap+ (\lam x => x dright) ((lift H Gc).2 t))

    -- | {sumSquare} as a functor to {CartSubCat}.
    \func lift.{v} {T Y : \Cat v} (H : T ->⁺ Y ->⁺ \Type v)
                   (Gc : \Sigma (G : \Sigma⁺ (s : \Sigma⁺ (t : T) Y) (HTot H s) ->⁺ \Type v) (SliceB H (sumSlice (HTot H) G)))
      => SubCat.isMax {DI ->⁺ Y ->⁺ \Type v} {IsPullbackSquare {Y ->⁺ \Type v}} {T} {\lam t j y => sumSquare H Gc.1 t j y} Gc.2

    -- | A path {p} between functors to arrows gives a path between the corresponding elements of the codomain of {sub-equiv}.
    \func sub-path.{v} {T Y : \Cat v} {g g' : T ->⁺ DI ->⁺ Y ->⁺ \Type v}
                       {pb : \Pi (k : DI ->⁺ T) -> IsPullbackSquare {Y ->⁺ \Type v} (\lam i => g (k i))}
                       {pb' : \Pi (k : DI ->⁺ T) -> IsPullbackSquare {Y ->⁺ \Type v} (\lam i => g' (k i))} (p : g' = g)
      : ((g', pb'), \lam t => pmap+ (\lam f => f t dright) p)
        = {\Sigma (x : \Sigma (g : T ->⁺ DI ->⁺ Y ->⁺ \Type v) (\Pi (k : DI ->⁺ T) -> IsPullbackSquare {Y ->⁺ \Type v} (\lam i => g (k i))))
                   (\Pi (t :⁺ T) -> x.1 t dright = g t dright)} ((g, pb), \lam t => idp) \elim p
      | idp => path \lam i => ((g, prop-isProp pb' pb i), \lam t => idp)

    \func SliceB.{v} {T Y : \Cat v} (H : T ->⁺ Y ->⁺ \Type v) (s : Slice (HTot H)) : \Prop
      => \Pi (k : DI ->⁺ T) -> IsPullbackSquare {Y ->⁺ \Type v} (\lam i j y => s.2 j (k i, y))

    \func FibB.{v} {T Y : \Cat v} (H : T ->⁺ Y ->⁺ \Type v)
                   (u : Fib {DI ->⁺ \Sigma⁺ (t : T) Y ->⁺ \Type v} (\lam u => u dright) (HTot H)) : \Prop
      => \Pi (k : DI ->⁺ T) -> IsPullbackSquare {Y ->⁺ \Type v} (\lam i j y => u.1 j (k i, y))

    \func FunB.{v} {T Y : \Cat v} (H : T ->⁺ Y ->⁺ \Type v)
                   (g : \Sigma (g : T ->⁺ DI ->⁺ Y ->⁺ \Type v) (\Pi (k : DI ->⁺ T) -> IsPullbackSquare {Y ->⁺ \Type v} (\lam i => g (k i)))) : \Type
      => \Pi (t :⁺ T) -> g.1 t dright = H t

    \func sub-equiv.{v} {T Y : \Cat v} (H : T ->⁺ Y ->⁺ \Type v)
      => qsigma-left {_} {_} {FunB H} (IsEquiv.toQEquiv (subCat-fun-equiv {DI ->⁺ Y ->⁺ \Type v} {IsPullbackSquare {Y ->⁺ \Type v}}
                                                         (\lam {h} _ => (isPullback-idd (h dleft), isPullback-idd (h dright)), paste)))

    \func curry-equiv.{v} {T Y : \Cat v} (H : T ->⁺ Y ->⁺ \Type v)
      : QEquiv {\Sigma (u : Fib {DI ->⁺ \Sigma⁺ (t : T) Y ->⁺ \Type v} (\lam u => u dright) (HTot H)) (FibB H u)}
               {\Sigma (g : \Sigma (g : T ->⁺ DI ->⁺ Y ->⁺ \Type v) (\Pi (k : DI ->⁺ T) -> IsPullbackSquare {Y ->⁺ \Type v} (\lam i => g (k i)))) (FunB H g)} \cowith
      | f u => ((\lam t j y => u.1.1 j (t, y), u.2), \lam t => path \lam m => \lam y => (u.1.2 @ m) (t, y))
      | ret g => ((\lam j s => g.1.1 s.1 j s.2, path \lam m => \lam s => (g.2 s.1 @ m) s.2), g.1.2)
      | ret_f _ => idp
      | f_sec _ => idp
  }

-- | The section {cart-sections} at `t` is the sum of the functor restricted to `t`.
\sfunc cart-sections-fibers.{u} {T Y : \Cat u} (H : T ->⁺ Y ->⁺ \Type u)
    (Gc : \Sigma (G : \Sigma⁺ (s : \Sigma⁺ (t : T) Y) (HTot H s) ->⁺ \Type u) (cart-sections.SliceB H (sumSlice (HTot H) G))) (t : T)
  : target-fibers (H t) (cart-sections.map H Gc t) = sumSlice (H t) (\lam z =>⁺ Gc.1 ((t, z.1), z.2))
  => pmap (target-fibers-equiv.fib-slice (H t)) (aux ((cart-sections.lift H Gc).2 t))
  \where
    \private \func aux {E : \Cat} {u v : DI ->⁺ E} (p : u = v)
      : ((u, pmap (__ dright) p) : Fib {DI ->⁺ E} (\lam u => u dright) (v dright)) = (v, idp) \elim p
      | idp => idp

-- | The sum of {G} is a family of pullback squares if and only if {G} inverts the arrows constant in the `Y`-direction.
\lemma sumSquare-pullback.{u} {T Y : \Cat u} {H : T ->⁺ Y ->⁺ \Type u} {G : \Sigma⁺ (s : \Sigma⁺ (t : T) Y) (HTot H s) ->⁺ \Type u}
  : (\Pi (k : DI ->⁺ T) -> IsPullbackSquare {Y ->⁺ \Type u} (\lam i j y => sumSquare H G (k i) j y)) <-> InvertsW (TArrow {T} {Y} {H}) G
  => (\lam cart {a} => \case \elim __ \with {
        | inP (y, p) => tarrow-case {T} {Y} {H} {G} cart y p (\lam i => (a i).2)
      }, sumSquare-pullback-inv)
  \where {
    \lemma tarrow-case.{v} {T Y : \Cat v} {H : T ->⁺ Y ->⁺ \Type v} {G : \Sigma⁺ (s : \Sigma⁺ (t : T) Y) (HTot H s) ->⁺ \Type v}
      (cart : \Pi (k : DI ->⁺ T) -> IsPullbackSquare {Y ->⁺ \Type v} (\lam i j y => sumSquare H G (k i) j y))
      {tau : DI ->⁺ T} (y : Y) {zeta : DI ->⁺ Y} (p : (\lam _ =>⁺ y) = zeta) (rho : \Pi (i :⁺ DI) -> H (tau i) (zeta i))
      : IsIso (dpath \lam i => G ((tau i, zeta i), rho i)) \elim p
      | idp => di-case {Y} {\lam i' => H (tau i')} {\lam z => G ((tau z.1.1, z.1.2), z.2)} (cart tau) y rho

    -- | Transport to the target.
    \func push.{v} {Y : \Cat v} {alpha : DI ->⁺ Y ->⁺ \Type v} (i :⁺ DI) (y :⁺ Y) (h :⁺ alpha i y) : alpha dright y
      => coe+ (\lam m => alpha (dmax i m) y) h dright

    \lemma push-inv.{v} {Y : \Cat v} {alpha : DI ->⁺ Y ->⁺ \Type v} {G : \Sigma⁺ (s : \Sigma⁺ (i : DI) Y) (HTot alpha s) ->⁺ \Type v}
      : InvertsW (TArrow {DI} {Y} {alpha}) (\lam z => G ((dright, z.1.2), push {Y} {alpha} z.1.1 z.1.2 z.2))
      => \lam {a} => \case \elim __ \with {
           | inP (y, p) => aux y p (\lam i => (a i).2)
         }
      \where
        \private \lemma aux {tau : DI ->⁺ DI} (y : Y) {zeta : DI ->⁺ Y} (p : (\lam _ => y) = {DI ->⁺ Y} zeta) (rho : \Pi (i :⁺ DI) -> alpha (tau i) (zeta i))
          : IsIso (dpath \lam i => G ((dright, zeta i), push {Y} {alpha} (tau i) (zeta i) (rho i))) \elim p
          | idp => dmap_IsIso (\lam c => G ((dright, y), c)) (IsIso-char.2 (inP (~>_= (dpath \lam i => push {Y} {alpha} (tau i) y (rho i)), ~>_=_~>)))

    \lemma di-case.{v} {Y : \Cat v} {alpha : DI ->⁺ Y ->⁺ \Type v} {G : \Sigma⁺ (s : \Sigma⁺ (i : DI) Y) (HTot alpha s) ->⁺ \Type v}
        (pb : IsPullbackSquare {Y ->⁺ \Type v} (\lam i j y => sumSquare alpha G i j y)) (y : Y) (rho : \Pi (i :⁺ DI) -> alpha i y)
      : IsIso (dpath \lam i => G ((i, y), rho i))
      => \have cart-unique (Gc Gc' : \Sigma (G : \Sigma⁺ (s : \Sigma⁺ (i : DI) Y) (HTot alpha s) ->⁺ \Type v) (cart-sections.SliceB alpha (sumSlice (HTot alpha) G)))
                           (q : (\lam (w :⁺ \Sigma⁺ (y : Y) (alpha dright y)) => Gc.1 ((dright, w.1), w.2)) = (\lam w => Gc'.1 ((dright, w.1), w.2)))
               : Gc.1 = Gc'.1
               => pmap __.1 $ IsEquiv.isInj (cart-sections alpha) $
                  IsEquiv.isInj (rightFib-sections-ev (target-rightFib {Y ->⁺ \Type v}) (\lam i => alpha i)) $
                  IsEquiv.isInj (target-fibers-equiv (alpha dright)) $
                  cart-sections-fibers alpha Gc dright *> pmap (sumSlice (alpha dright)) q *> inv (cart-sections-fibers alpha Gc' dright)
         \in transportInv (\lam K => IsIso (dpath \lam i => K ((i, y), rho i)))
               (cart-unique (G, \lam k => pullback-reparam pb k)
                            (\lam z => G ((dright, z.1.2), push {Y} {alpha} z.1.1 z.1.2 z.2), \lam k => sumSquare-pullback-inv (push-inv {Y} {alpha} {G}) k)
                            (ext \lam w => pmap+ (\lam t => G ((dright, w.1), t)) (inv ~>_->_idd)))
               (push-inv {Y} {alpha} {G} {\lam i => ((i, y), rho i)} (inP (y, idp)))

    {- | At a point `y`, sections over the square of the sum of {G} over {alpha} are determined by the bottom and right sides
     -   if {G} inverts the arrows over `y` constant in the `Y`-direction.
     -
     -   Sections are determined by their value at the top left corner ({square-sections-ev}), transport in the sum is
     -   the pair of transports (`plift`), and lifts in {alpha} and along the projection to {alpha} are contractible.
     -}
    \lemma sum-boundary.{u} {Y : \Cat u} {alpha : DI ->⁺ Y ->⁺ \Type u} {G : \Sigma⁺ (s : \Sigma⁺ (i : DI) Y) (HTot alpha s) ->⁺ \Type u} (y : Y)
      (Gi : \Pi (h : alpha dleft y) -> IsIso (dpath \lam i => G ((i, y), coe+ (\lam i' => alpha i' y) h i)))
      : IsEquiv (boundary {\lam i j => sumSquare alpha G i j y})
      => \let | E (i :⁺ DI) : \Type u => sumSlice.sumFam {\Sigma⁺ (i : DI) Y} (HTot alpha) G (i, y)
              | applyLam (z : \Pi (i :⁺ DI) -> E i) (i j :⁺ DI) : sumSquare alpha G i j y => coe+ (\lam j' => sumSquare alpha G i j' y) (z i) j
              | zeta (a : E dleft) (i :⁺ DI) : E i => coe+ (\lam i' => E i') a i
              | lam (a : E dleft) (i j :⁺ DI) : sumSquare alpha G i j y => coe+ (\lam j' => sumSquare alpha G i j' y) (coe+ (\lam i' => E i') a i) j
              | plift (a : E dleft) (i :⁺ DI) : E i
                  => (coe+ (\lam i' => alpha i' y) a.1 i, coe+ (\lam i' => G ((i', y), coe+ (\lam i'' => alpha i'' y) a.1 i')) a.2 i)
              | N (a : E dleft) : \Sigma (g : alpha dleft y) (G ((dright, y), coe+ (\lam i => alpha i y) g dright))
                  => (a.1, (plift a dright).2)
              | B1 => \Sigma (b : E dright) (\Sigma (g : alpha dleft y) (DPath (\lam i => alpha i y) g b.1))
              | Lift (g : alpha dleft y) => CovLift {\Type u} (\lam A => A) (alpha dleft y, alpha dright y, dpath \lam i => alpha i y, g)
              | kappa (t : \Sigma (g : alpha dleft y) (G ((dright, y), coe+ (\lam i => alpha i y) g dright))) : B1
                  => ((coe+ (\lam i => alpha i y) t.1 dright, t.2), (t.1, dpath \lam i => coe+ (\lam i' => alpha i' y) t.1 i))
              | Lift1 (b : E dright) => CovLift {\Type u} (\lam A => A) (E dright, alpha dright y, dpath \lam j => sumSquare alpha G dright j y, b)
              | iota (t : B1) : Boundary (\lam i j => sumSquare alpha G i j y)
                  => (t.1, t.2.1, t.1.1, dpath \lam j => coe+ (\lam j' => sumSquare alpha G dright j' y) t.1 j, t.2.2)
         \in \have
              | lam-equiv : IsEquiv lam
                => IsEquiv.leftFactor (square-sections-ev (\lam i j => sumSquare alpha G i j y)) (inP idEquiv)
              | lift-path (a : E dleft) : lam a = (\lam i j => coe+ (\lam j' => sumSquare alpha G i j' y) (plift a i) j)
                => pmap applyLam (IsEquiv.isInj (DI-sections-ev E) idp)
              | N-equiv : IsEquiv N
                => IsEquiv.trans {E dleft} {\Sigma (g : alpha dleft y) (G ((dleft, y), g))}
                                 {\Sigma (g : alpha dleft y) (G ((dright, y), coe+ (\lam i => alpha i y) g dright))}
                     (inP \new QEquiv { | f a => (a.1, a.2) | ret b => (b.1, b.2) | ret_f _ => idp | f_sec _ => idp })
                     {\lam p => (p.1, ~>_-> (dpath \lam i => G ((i, y), coe+ (\lam i' => alpha i' y) p.1 i)) p.2)}
                     (IsSigma-right (\lam g => ~>_-> (dpath \lam i => G ((i, y), coe+ (\lam i' => alpha i' y) g i)))
                                    (\lam g => ~>_->-iso-equiv (Gi g)))
              | kappa-equiv : IsEquiv kappa
                => IsEquiv.trans {\Sigma (g : alpha dleft y) (G ((dright, y), coe+ (\lam i => alpha i y) g dright))}
                                 {\Sigma (g : alpha dleft y) (\Sigma (cp : Lift g) (G ((dright, y), cp.1)))} {B1}
                     (IsSigma-right (\lam g z => (((coe+ (\lam i => alpha i y) g dright, dpath \lam i => coe+ (\lam i' => alpha i' y) g i), z)
                                       : \Sigma (cp : Lift g) (G ((dright, y), cp.1))))
                                    (\lam g => contr-point-equiv (universe-leftFib (alpha dleft y, alpha dright y, dpath \lam i => alpha i y, g))
                                                                 (coe+ (\lam i => alpha i y) g dright, dpath \lam i => coe+ (\lam i' => alpha i' y) g i)))
                     {\lam s => ((s.2.1.1, s.2.2), (s.1, s.2.1.2))}
                     (inP \new QEquiv {
                        | ret b => (b.2.1, ((b.1.1, b.2.2), b.1.2))
                        | ret_f _ => idp
                        | f_sec _ => idp
                      })
              | iota-equiv : IsEquiv iota
                => IsEquiv.trans
                     (IsSigma-right (\lam b (q : \Sigma (g : alpha dleft y) (DPath (\lam i => alpha i y) g b.1)) =>
                                       ((q.1, ((b.1, dpath \lam j => coe+ (\lam j' => sumSquare alpha G dright j' y) b j) , q.2))
                                         : \Sigma (g : alpha dleft y) (\Sigma (cp : Lift1 b) (DPath (\lam i => alpha i y) g cp.1))))
                        \lam b => IsSigma-right (\lam g p2 => (((b.1, dpath \lam j => coe+ (\lam j' => sumSquare alpha G dright j' y) b j) , p2)
                                                   : \Sigma (cp : Lift1 b) (DPath (\lam i => alpha i y) g cp.1)))
                          \lam g => contr-point-equiv (universe-leftFib (E dright, alpha dright y, dpath \lam j => sumSquare alpha G dright j y, b))
                                                      (b.1, dpath \lam j => coe+ (\lam j' => sumSquare alpha G dright j' y) b j))
                     {\lam s => ((s.1, s.2.1, s.2.2.1.1, s.2.2.1.2, s.2.2.2) : Boundary (\lam i j => sumSquare alpha G i j y))}
                     (inP \new QEquiv {
                        | ret b => (b.1, (b.2, ((b.3, b.4), b.5)))
                        | ret_f _ => idp
                        | f_sec _ => idp
                      })
         \in IsEquiv.rightFactor lam-equiv $
             transport IsEquiv (ext \lam a => pmap boundary (inv (lift-path a))) $
             IsEquiv.trans N-equiv (IsEquiv.trans kappa-equiv iota-equiv)

    -- | The sum of a functor inverting the arrows constant in the `Y`-direction is a family of pullback squares.
    \lemma sumSquare-pullback-inv.{u} {T Y : \Cat u} {H : T ->⁺ Y ->⁺ \Type u} {G : \Sigma⁺ (s : \Sigma⁺ (t : T) Y) (HTot H s) ->⁺ \Type u}
        (Gi : InvertsW (TArrow {T} {Y} {H}) G) (k : DI ->⁺ T)
      : IsPullbackSquare {Y ->⁺ \Type u} (\lam i j y => sumSquare H G (k i) j y)
      => pointwise-pullback (\lam i j y => sumSquare (\lam i' => H (k i')) (\lam z => G ((k z.1.1, z.1.2), z.2)) i j y)
           \lam y => type-pullback _ $ sum-boundary {Y} {\lam i' => H (k i')} {\lam z => G ((k z.1.1, z.1.2), z.2)} y
                                          \lam h => Gi (inP (y, idp))
  }

{- | Sections of {target} along a functor {H} of two variables are functors on the category of elements of {H}
 -   that invert the arrows constant in the `Y`-direction ({target-sec-fibers}).
 -}
\lemma target-sec.{u} {T Y : \Cat u} (H : T ->⁺ Y ->⁺ \Type u)
  : IsEquiv {MapW (TArrow {T} {Y} {H}) (\Type u)} {\Pi (t :⁺ T) -> Fibers (target {Y ->⁺ \Type u}) (H t)} map
  => IsEquiv.trans (inP cart-equiv) (cart-sections H)
  \where {
    \func cart-equiv.{v} {T Y : \Cat v} {H : T ->⁺ Y ->⁺ \Type v}
      : QEquiv {MapW (TArrow {T} {Y} {H}) (\Type v)}
               {\Sigma (G : \Sigma⁺ (s : \Sigma⁺ (t : T) Y) (HTot H s) ->⁺ \Type v)
                       (cart-sections.SliceB H (sumSlice (HTot H) G))} \cowith
      | f s => (s.1, sumSquare-pullback.2 s.2)
      | ret s => (s.1, sumSquare-pullback.1 s.2)
      | ret_f _ => ext idp
      | f_sec _ => ext idp

    \protected \func map.{u} {T Y : \Cat u} {H : T ->⁺ Y ->⁺ \Type u}
                             (G : MapW (TArrow {T} {Y} {H}) (\Type u)) (t :⁺ T) : Fibers (target {Y ->⁺ \Type u}) (H t)
      => cart-sections.map H (G.1, sumSquare-pullback.2 G.2) t
  }

-- | The section {target-sec} at `t` is the sum of {G} restricted to `t`.
\sfunc target-sec-fibers.{u} {T Y : \Cat u} (H : T ->⁺ Y ->⁺ \Type u) (G : MapW (TArrow {T} {Y} {H}) (\Type u)) (t : T)
  : target-fibers (H t) (target-sec.map G t) = sumSlice (H t) (\lam z =>⁺ G.1 ((t, z.1), z.2))
  => cart-sections-fibers H (target-sec.cart-equiv G) t