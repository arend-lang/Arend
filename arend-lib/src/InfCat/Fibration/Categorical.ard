\import Equiv
\import InfCat.Basics
\import InfCat.Paths
\import InfCat.Rezk
\import Logic
\import Paths.Meta

-- | The family of fibers of {p}.
\func Fibers {E A : \Cat} (p : E ->⁺ A) (a :⁺ A) : \Cat
  => \Sigma⁺ (e : E) (p e = a)

{- | The fiber of {p} over a fixed {a}.
 -   It is the same category as `Fibers p a`, but it lives in `\Cat u` since the path type is released by the binder of `e`.
 -}
\func Fiber.{u} {E A : \Cat u} (p : E ->⁺ A) (a : A) : \Cat u
  => \Sigma⁺ (e : E) (p e = a)

-- | The base change of {p} along {pi}.
\func BaseChange.{u} {X S E : \Cat u} (pi : X ->⁺ S) (p : E ->⁺ S) : \Cat u
  => \Sigma⁺ (x : X) (\Sigma⁺ (e : E) (p e = pi x))

-- | The projection from the total category of a family.
\func totalProj {B : \Cat} (Q : B ->⁺ \Cat) (s :⁺ \Sigma⁺ (b : B) (Q b)) : B
  => s.1

-- | The fibers of {totalProj} are the values of {Q}.
\func fibers-total-equiv {B : \Cat} {Q : B ->⁺ \Cat} (b : B) : QEquiv {Q b} {Fibers (totalProj Q) b} \cowith
  | f q => ((b, q), idp)
  | ret => fibers-total-ret
  | ret_f _ => idp
  | f_sec => fibers-total-ret-sec
  \where {
    \func fibers-total-ret {B : \Cat} {Q : B ->⁺ \Cat} {b :⁺ B} (t :⁺ Fibers (totalProj Q) b) : Q b
      => transport+ Q t.2 t.1.2

    \func fibers-total-ret-sec {B : \Cat} {Q : B ->⁺ \Cat} {b :⁺ B} (t :⁺ Fibers (totalProj Q) b)
      : ((b, fibers-total-ret t), idp) = {Fibers (totalProj Q) b} t
      => aux t.1.2 t.2
      \where
        \func aux {B : \Cat} {Q : B ->⁺ \Cat} {b' b :⁺ B} (q :⁺ Q b') (p :⁺ b' = b)
          : ((b, transport+ Q p q), idp) = {Fibers (totalProj Q) b} ((b', q), p) \elim p
          | idp => idp

    -- | Sections of {Q} are sections of the fibers of {totalProj}.
    \func sections {B Y : \Cat} {Q : B ->⁺ \Cat} (v : Y ->⁺ B)
      : QEquiv {\Pi (y :⁺ Y) -> Q (v y)} {\Pi (y :⁺ Y) -> Fibers (totalProj Q) (v y)} \cowith
      | f s y => ((v y, s y), idp)
      | ret s y => fibers-total-ret (s y)
      | ret_f _ => idp
      | f_sec s => ext \lam y => fibers-total-ret-sec (s y)
  }

-- | An arrow of a fiber whose image in the total category is an isomorphism is an isomorphism.
\lemma fibers-conservative {E A : \Cat} {p : E ->⁺ A} {a : A} {m : DI ->⁺ Fibers p a} (mi : IsIso (dpath \lam i => (m i).1))
  : IsIso (dpath \lam i => m i)
  => \case IsIso-diag-char.1 mi \with {
    | inP (c, e) => aux e (\lam i => (m i).2)
  }
  \where
    \private \lemma aux {c : E} {m1 : DI ->⁺ E} (e : (\lam _ => c) = {DI ->⁺ E} m1) (m2 : \Pi (i :⁺ DI) -> p (m1 i) = a)
      : IsIso (dpath \lam i => ((m1 i, m2 i) : Fibers p a)) \elim e
      | idp => dmap_IsIso (\lam (q : p c = a) => ((c, q) : Fibers p a)) {_} {_} {dpath m2} (IsIso-char.2 (inP (~>_= (dpath m2), ~>_=_~>)))