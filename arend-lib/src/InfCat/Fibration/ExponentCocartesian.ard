{- | The exponent of a cocartesian fibration into a fixed category.

 -   Let `p : E ->⁺ B` be a cocartesian map and let {C} be a category. The exponent {ExpCoc} is a family over {B}
 -   whose families of objects along `pi : T ->⁺ B` are functors `BaseChange pi p ->⁺ C`:
 -   * {ExpCoc.eval}: an object over `b` evaluated as a functor `Fibers p b ->⁺ C`.
 -   * {ExpCoc.eval-univ}: the universal property.

 -   Construction (route B of exponent-cocart.tex): the slice construction {ExpSl} exponentiates fiberwise opposites.
 -   * For a cocartesian map `q : E' ->⁺ B`, let `R b x = Op.Hom (OpFunc q x) b` on `Op E'` ({ExpCocHelpers.preR}) and let `W`
 -     consist of the opposites of `q`-cocartesian arrows ({ExpCocHelpers.CocartOpW}). The total category {SecTot} of the categories
 -     of elements along {pi} is the base change of the pre-opposite `PreFiberOp q` ({ExpCocHelpers.jT}, {ExpCocHelpers.jT-equiv}),
 -     and the classes {SecW} and `TotalFibW` correspond ({ExpCocHelpers.class-equiv}).
 -     Since fiberwise localization commutes with base change ({fibLoc-baseChange}), {SecTot} localizes to the base change of
 -     `FibOp q` ({ExpCocHelpers.loc}). So {ExpSl.eval-univ} gives the universal property for `FibOp q` ({ExpCocHelpers.secPre-equiv}),
 -     where {ExpCocHelpers.secPre} is the extension of {ExpSl.eval} along this localization; it is natural in {pi}
 -     ({ExpCocHelpers.secPre-natural}).
 -   * Apply this to `q = FibOp p` and transport along the involution `FibOp (FibOp p) = p` ({fibOp-invol}).
 -   * The total category {ExpCocHelpers.ExpCocTot} of the exponent is too large to localize its base change, but it is equivalent
 -     to the small category {ExpCocHelpers.ExpCocU}, since its arrows are families of objects along `DI` ({ExpCocHelpers.expCocTot-arrows}).
 -     {ExpCoc.eval} is the functor corresponding to the universal family over {ExpCocHelpers.ExpCocU},
 -     and {ExpCoc.eval-univ} follows from the naturality of this correspondence ({ExpCocHelpers.secGen-natural}).
 -}

\import Equiv
\import Equiv.Sigma
\import Function.Meta
\import InfCat.Fibration.Categorical
\import InfCat.Fibration.CocartesianMap
\import InfCat.Fibration.ExponentSlice
\import InfCat.Functor.Equiv
\import InfCat.Localization.Abstract
\import InfCat.Localization.Concrete
\import InfCat.Localization.Fiberwise
\import InfCat.Localization.Fiberwise.FiberwiseTotal
\import InfCat.Opposite
\import InfCat.Opposite.Fiberwise
\import InfCat.Paths
\import InfCat.Resizing
\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta
\open FibOpConstruction (PreFiberOp, preFiberOp-cocartesian, W, W-stable)
\open ExpCocHelpers

-- | The exponent from the cocartesian map {p} to {C}: its fiber over {b} consists of functors `Fibers p b ->⁺ C`.
\type ExpCoc.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u) (b :⁺ B) : \Cat
  => ExpSl (preR (FibOp.proj pc)) C (CocartOpW (FibOp.proj pc)) b
  \where {
    -- | The evaluation map.
    \protected \sfunc eval.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) {C : \Cat u} {b :⁺ B}
                               (e :⁺ ExpCoc pc C b) (x :⁺ Fibers p b) : C
      => secGen (fibOp-cocartesian pc) (fibOp-invol pc) (\lam y => (unresize y).1) (\lam y => (unresize y).2) (resizeCat (b, e), x)

    -- | The universal property: families of objects along {pi} are functors on the base change of {p} along {pi}.
    \protected \lemma eval-univ.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) {C : \Cat u} {T : \Cat u} (pi : T ->⁺ B)
      : IsEquiv {\Pi (t :⁺ T) -> ExpCoc pc C (pi t)} {BaseChange pi p ->⁺ C} (\lam s q => eval pc (s q.1) q.2)
      => transport IsEquiv (path \lam j (s : \Pi (t :⁺ T) -> ExpCoc pc C (pi t)) => funExt+ (\lam q =>
           secGen-natural (fibOp-cocartesian pc) (fibOp-invol pc) (\lam y => (unresize y).1) (\lam y => (unresize y).2)
                          (\lam t => resizeCat (pi t, s t)) {q}
           *> inv (\peval eval pc (s q.1) q.2)) j)
         (inP (expCoc-sl pc C pi `transQEquiv` IsEquiv.toQEquiv (secGen-equiv (fibOp-cocartesian pc) (fibOp-invol pc) pi)))
  }

\module ExpCocHelpers \where {
  -- | The presheaves `Op.Hom (OpFunc q -) b` on `Op E`; their categories of elements are the fibers of the pre-opposite.
  \type preR.{u} {B E : \Cat u} (q : E ->⁺ B) (b :⁺ B) (x :⁺ Op E) : \Type u
    => Op.Hom (OpFunc q x) b

  -- | The opposites of {q}-cocartesian arrows.
  \type CocartOpW.{u} {B E : \Cat u} (q : E ->⁺ B) (a : DI ->⁺ Op E) : \Prop
    => ∃ (v : DI ->⁺ E) (IsCocartesianArrow q (dpath v)) ((\lam i =>⁺ a i) = opArr (dpath v))

  -- | {SecTot} as the base change of the pre-opposite.
  \func jT.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) (w :⁺ SecTot (preR q) pi) : BaseChange pi (PreFiberOp.proj q)
    => (w.1, ((w.2.1, pi w.1, w.2.2), idp))

  -- | The inverse of {jT}.
  \func jInv.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) (y :⁺ BaseChange pi (PreFiberOp.proj q)) : SecTot (preR q) pi
    => (y.1, (y.2.1.1, PreFiberOp.fiberHom y.2))

  \lemma jT-equiv.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) : IsHEquiv (jT {B} {E} {T} {q} pi)
    => IsHEquiv.biEquiv {_} {_} {_} {jInv pi} (\lam x => idp) {jInv pi} \lam y => pair-path (PreFiberOp.fiber-path y.2)
    \where
      \sfunc pair-path {T : \Cat} {F : T ->⁺ \Cat} {t :⁺ T} {x y :⁺ F t} (r :⁺ x = y) : ((t, x) : \Sigma⁺ (z : T) (F z)) = (t, y) \elim r
        | idp => idp

  -- | The first component of a transport in {secFib}.
  \sfunc transport+_secFib.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) {t s :⁺ T} (r :⁺ t = s) (k :⁺ secFib (preR q) pi t)
    : (transport+ (secFib (preR q) pi) r k).1 = k.1 \elim r
    | idp => idp

  -- | The `Op E`-component of a transport in the fibers of the pre-opposite.
  \sfunc transport+_PreFiberOp.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) {t s :⁺ T} (r :⁺ t = s) (y :⁺ Fibers (PreFiberOp.proj q) (pi t))
    : (transport+ (\lam z => Fibers (PreFiberOp.proj q) (pi z)) r y).1.1 = y.1.1 \elim r
    | idp => idp

  -- | {jT} identifies {SecW} with the class of {fibLoc-baseChange}.
  \lemma class-equiv.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) (a : DI ->⁺ SecTot (preR q) pi)
    : TotW (totalProj (\lam z => Fibers (PreFiberOp.proj q) (pi z)))
           (TotalFibW {T} {\lam z => Fibers (PreFiberOp.proj q) (pi z)} (\lam z => W q (pi z))) (\lam i => jT pi (a i))
      <-> SecW (preR q) pi (CocartOpW q) a
    => (\lam (inP (s, b, w)) => inP (s, b, transport {DI ->⁺ Op E} (CocartOpW q)
          (path \lam j i => (transport+_PreFiberOp pi (b i) (jT pi (a i)).2 *> inv (transport+_secFib pi (b i) (a i).2)) j) w),
        \lam (inP (s, b, w)) => inP (s, b, transport {DI ->⁺ Op E} (CocartOpW q)
          (path \lam j i => (transport+_secFib pi (b i) (a i).2 *> inv (transport+_PreFiberOp pi (b i) (jT pi (a i)).2)) j) w))

  -- | The localization of {SecTot} to the base change of the fiberwise localization of the pre-opposite.
  \func locMap.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) (w :⁺ SecTot (preR q) pi)
    : BaseChange pi (fibLocProj (PreFiberOp.proj q) (W q))
    => (w.1, (localize (TotW (PreFiberOp.proj q) (W q)) (w.2.1, pi w.1, w.2.2), idp))

  \lemma loc.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {T : \Cat u} (pi : T ->⁺ B)
    : IsLocalization (SecW (preR q) pi (CocartOpW q)) (locMap pi)
    => isLocalization-transfer' {SecTot (preR q) pi} {BaseChange pi (PreFiberOp.proj q)}
        (fibLoc-baseChange (preFiberOp-cocartesian q) (W-stable qc) pi) (jT-equiv pi) idHEquiv (\lam w => idp) (class-equiv pi)

  -- | The functor corresponding to a family of objects: the extension of {ExpSl.eval} along {loc}.
  \sfunc secPre.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {C : \Cat u} {T : \Cat u} (pi : T ->⁺ B)
                   (s : \Pi (t :⁺ T) -> ExpSl (preR q) C (CocartOpW q) (pi t)) (w :⁺ BaseChange pi (fibLocProj (PreFiberOp.proj q) (W q))) : C
    => IsLocalization.lift (loc qc pi) (totalFibW-inverts {T} {_} {_} {_} {\lam w => ExpSl.eval (s w.1) w.2} (\lam t => ExpSl.eval-inverts (s t))) w

  \lemma secPre-equiv.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {C : \Cat u} {T : \Cat u} (pi : T ->⁺ B)
    : IsEquiv (secPre qc {C} pi)
    => IsEquiv.leftFactor (restrictW-equiv (IsLocalization.univ (loc qc pi))) $
       transport IsEquiv (ext \lam s => ext (funExt+ \lam w => inv IsLocalization.lift.restrict *> inv (\peval secPre qc pi s (locMap pi w)))) (ExpSl.eval-univ pi)

  -- | {secPre} is natural in `pi`: along `pi' ∘ g`, it is the restriction of {secPre} along {pi'}.
  \sfunc secPre-natural.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {C : \Cat u} {T T' : \Cat u} (pi' : T' ->⁺ B)
                            (s' : \Pi (t :⁺ T') -> ExpSl (preR q) C (CocartOpW q) (pi' t)) (g : T ->⁺ T')
                            {w :⁺ BaseChange (\lam (t :⁺ T) => pi' (g t)) (fibLocProj (PreFiberOp.proj q) (W q))}
    : secPre qc (\lam t => pi' (g t)) (\lam t => s' (g t)) w = secPre qc pi' s' (g w.1, w.2)
    => loc-ext-eq (IsLocalization.univ (loc qc \lam t => pi' (g t))) {\lam w => secPre qc (\lam t => pi' (g t)) (\lam t => s' (g t)) w}
         \lam x => (\peval secPre qc (\lam t => pi' (g t)) (\lam t => s' (g t)) (locMap (\lam t => pi' (g t)) x))
                    *> IsLocalization.lift.restrict
                    *> inv (IsLocalization.lift.restrict {_} {_} {_} {_} {_} {loc qc pi'} {_} {_} {g x.1, x.2})
                    *> inv (\peval secPre qc pi' s' (locMap pi' (g x.1, x.2)))

  -- | {secPre} for any {d} equal to the fiberwise opposite of {q}.
  \func secGen.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {d : \Sigma (E' : \Cat u) (E' ->⁺ B)}
                   (r : (FibLoc (PreFiberOp.proj q) (W q), fibLocProj (PreFiberOp.proj q) (W q)) = {\Sigma (E' : \Cat u) (E' ->⁺ B)} d)
                   {C : \Cat u} {T : \Cat u} (pi : T ->⁺ B) (s : \Pi (t :⁺ T) -> ExpSl (preR q) C (CocartOpW q) (pi t)) : BaseChange pi d.2 ->⁺ C \elim r
    | idp => secPre qc pi s

  \lemma secGen-equiv.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {d : \Sigma (E' : \Cat u) (E' ->⁺ B)}
                          (r : (FibLoc (PreFiberOp.proj q) (W q), fibLocProj (PreFiberOp.proj q) (W q)) = {\Sigma (E' : \Cat u) (E' ->⁺ B)} d)
                          {C : \Cat u} {T : \Cat u} (pi : T ->⁺ B)
    : IsEquiv (secGen qc r {C} pi) \elim r
    | idp => secPre-equiv qc pi

  \sfunc secGen-natural.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {d : \Sigma (E' : \Cat u) (E' ->⁺ B)}
                            (r : (FibLoc (PreFiberOp.proj q) (W q), fibLocProj (PreFiberOp.proj q) (W q)) = {\Sigma (E' : \Cat u) (E' ->⁺ B)} d)
                            {C : \Cat u} {T T' : \Cat u} (pi' : T' ->⁺ B) (s' : \Pi (t :⁺ T') -> ExpSl (preR q) C (CocartOpW q) (pi' t)) (g : T ->⁺ T')
                            {w :⁺ BaseChange (\lam (t :⁺ T) => pi' (g t)) d.2}
    : secGen qc r (\lam t => pi' (g t)) (\lam t => s' (g t)) w = secGen qc r pi' s' (g w.1, w.2) \elim r
    | idp => secPre-natural qc pi' s' g

  -- | Families of objects of {ExpCoc} are families of objects of its defining {ExpSl}.
  \func expCoc-sl.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u) {T : \Cat u} (pi : T ->⁺ B)
    : QEquiv {\Pi (t :⁺ T) -> ExpCoc pc C (pi t)} {\Pi (t :⁺ T) -> ExpSl (preR (FibOp.proj pc)) C (CocartOpW (FibOp.proj pc)) (pi t)} \cowith
    | f s t => s t
    | ret s t => s t
    | ret_f _ => idp
    | f_sec _ => idp

  -- | The total category of the exponent.
  \type ExpCocTot.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u) : \Cat
    => \Sigma⁺ (b : B) (ExpCoc pc C b)

  -- | Arrows of {ExpCocTot} are functors on the base changes of {p} along arrows of {B}.
  \sfunc expCocTot-arrows.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u)
    : QEquiv {DI ->⁺ ExpCocTot pc C} {\Sigma (beta : DI ->⁺ B) (BaseChange beta p ->⁺ C)}
    => \new QEquiv {DI ->⁺ ExpCocTot pc C} {\Sigma (beta : DI ->⁺ B) (\Pi (i :⁺ DI) -> ExpCoc pc C (beta i))} {
         | f h => (\lam i => (h i).1, \lam i => (h i).2)
         | ret s i => (s.1 i, s.2 i)
         | ret_f _ => idp
         | f_sec _ => idp
       } `transQEquiv` sigma-right \lam beta => expCoc-sl pc C beta `transQEquiv` IsEquiv.toQEquiv (secGen-equiv (fibOp-cocartesian pc) (fibOp-invol pc) {C} beta)

  -- | {ExpCocTot} resized to `\Cat u`.
  \type ExpCocU.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u) : \Cat u
    => ResizeFromArrows (expCocTot-arrows pc C)

  -- | The inverse of `resizeCat`.
  \func unresize.{u} {B E : \Cat u} {p : E ->⁺ B} {pc : IsCocartesianMap p} {C : \Cat u} (y :⁺ ExpCocU pc C) : ExpCocTot pc C \elim y
    | resizeCat z => z
}