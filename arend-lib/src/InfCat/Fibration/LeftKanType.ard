{- | The left Kan extension of a left fibration along a functor.
 -
 -   Given `P : A ->⁺ \Cat` and `f : A ->⁺ B`, {LeftKanExt} is the free left fibration ({InfCat.Fibration.FreeLeft})
 -   on `f ∘ π : \Sigma⁺ (a : A) (P a) ->⁺ B`, that is, the right part of the factorization of `f ∘ π` with respect to
 -   the factorization system generated by `dleft : 1 ->⁺ DI`. Unlike {InfCat.Fibration.KanExtension}, this needs no
 -   fibrewise localization. It is a left fibration ({leftKanExt-leftFib}), and maps from it to a left fibration over {B}
 -   are maps from {P} to the pullback of that fibration along {f} ({leftKanExt-univ}).
 -   When {P} is a left fibration, its fiber over `b` is the colimit of {P} over the comma category `f ↓ b`.
 -
 -   For small data (`A B : \Cat u`, `P : A ->⁺ \Type u`), the fibers are small ({leftKanExt-small}), so straightening
 -   (`Resize+`, see {InfCat.Fibration.Straightening}) gives a functor {LeftKanExtStraight} with values in `\Type u`.
 -   Since `Resize+` and the factorization are not functorial in {P}, {LeftKanExtType} is defined instead as the
 -   left adjoint to restriction along {f} ({leftKanRightAdjoint}), which is covariant in {P} and agrees with
 -   {LeftKanExtStraight} on objects ({leftKanExtType-char}).
 -}

\import Equiv
\import Function.Meta
\import InfCat.Basics
\import InfCat.Fibration.Categorical
\import InfCat.Fibration.DirectedUnivalence
\import InfCat.Fibration.FreeLeft
\import InfCat.Fibration.LeftFib
\import InfCat.Fibration.Straightening
\import InfCat.Functor.Adjunction
\import InfCat.Functor.Equiv
\import InfCat.OFS.CatOFS
\import InfCat.Paths
\import Logic
\import Paths
\import Paths.Meta

-- | The left Kan extension of {P} along {f}.
\func LeftKanExt {A B : \Cat} (f : A ->⁺ B) (P : A ->⁺ \Cat) (b :⁺ B) : \Cat
  => FreeLeft {\Sigma⁺ (a : A) (P a)} (\lam t => f t.1) b

\lemma leftKanExt-leftFib {A B : \Cat} (f : A ->⁺ B) (P : A ->⁺ \Cat) : IsLeftFib (LeftKanExt f P)
  => freeLeft-leftFib _

-- | The comparison map from {P} to the pullback of {LeftKanExt} along {f}.
\func leftKanExt-unit {A B : \Cat} (f : A ->⁺ B) (P : A ->⁺ \Cat) (a :⁺ A) (x :⁺ P a) : LeftKanExt f P (f a)
  => freeLeft-unit (\lam t => f t.1) ((a, x) : \Sigma⁺ (a : A) (P a))

-- | The fibers of {LeftKanExt} of a small family along a functor between small categories are small.
\lemma leftKanExt-small.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u) (b : B) : IsSmall.{u} (LeftKanExt f P b)
  => IsSmall.fromGroupoid {LeftKanExt f P b} (leftFib-grpd (leftKanExt-leftFib f P) b) \new QEquiv
      {\Sigma (d : FreeLeftTot {\Sigma⁺ (a : A) (P a)} (\lam t => f t.1)) (freeLeftProj d = b)} {LeftKanExt f P b} {
        | f x => (x.1, x.2)
        | ret y => (y.1, y.2)
        | ret_f _ => idp
        | f_sec _ => idp
      }

-- | The left Kan extension of a small family along a functor between small categories, as a functor to `\Type u`.
\func LeftKanExtStraight.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u) (b :⁺ B) : \Type u
  => Straight (leftKanExt-leftFib f P) (leftKanExt-small f P) b

\lemma leftKanExtStraight-leftFib.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u) : IsLeftFib (LeftKanExtStraight f P)
  => straighten-leftFib

-- | {LeftKanExtStraight} is equivalent to {LeftKanExt}.
\func leftKanExtStraight-equiv.{u} {A B : \Cat u} {f : A ->⁺ B} {P : A ->⁺ \Type u} {b : B}
  : QEquiv {LeftKanExtStraight f P b} {LeftKanExt f P b}
  => Straight.equiv

-- | The comparison map from {P} to the pullback of {LeftKanExtStraight} along {f}.
\func leftKanExtStraight-unit.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u) (a :⁺ A) (x :⁺ P a) : LeftKanExtStraight f P (f a)
  => Straight.toStraight (leftKanExt-unit f P a x)

-- | The total category of {LeftKanExtStraight} is equivalent to that of the free left fibration.
\func leftKanExtStraight-total.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u)
  : HQEquiv {FreeLeftTot {\Sigma⁺ (a : A) (P a)} (\lam t => f t.1)} {\Sigma⁺ (b : B) (LeftKanExtStraight f P b)}
  => \new HQEquiv {
    | f d => (freeLeftProj d, Straight.toStraight (d, idp))
    | finv s => (Straight.fromStraight s.2).1
    | finv_f => idpe
    | f_finv s => \let x => Straight.fromStraight s.2
                  \in path (\lam i => (x.2 i, Straight.toStraight (x.1, path \lam j => x.2 @ I.squeeze i j)))
                      *> path (\lam i => (s.1, Straight.toStraight_fromStraight s.2 i))
  }

-- | The unit of {LeftKanExtStraight} on total categories is left orthogonal to every left fibration over {B}.
\lemma leftKanExtStraight-isLeft.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u) {E : \Cat} {h : E ->⁺ B} (hl : IsLeftFib (Fibers h))
  : IsOrthogonal {\Sigma⁺ (a : A) (P a)} {\Sigma⁺ (b : B) (LeftKanExtStraight f P b)} (\lam t => (f t.1, leftKanExtStraight-unit f P t.1 t.2)) h
  => IsOrthogonal_o-left (freeLeft-isLeft hl) (IsOrthogonal_IsHEquiv-left (inP (leftKanExtStraight-total f P)))

-- | Sections over the total category of {LeftKanExtStraight} of a left fibration {Q} over {B} are maps from {P} to its pullback along {f}.
\lemma leftKanExtStraight-univ.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u) {Q : B ->⁺ \Cat} (Ql : IsLeftFib Q)
  : IsEquiv {\Pi (s :⁺ \Sigma⁺ (b : B) (LeftKanExtStraight f P b)) -> Q s.1} {\Pi (t :⁺ \Sigma⁺ (a : A) (P a)) -> Q (f t.1)}
            (\lam g t => g (f t.1, leftKanExtStraight-unit f P t.1 t.2))
  => IsOrthogonal-family-sections (leftKanExtStraight-isLeft f P (leftFib-total Ql)) __.1

-- | Under {depUnivalence}, postcomposing the unit of {LeftKanExtStraight} with a restricted arrow is restriction of sections.
\sfunc leftKanExtStraight-comp-unit.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u) (Q : B ->⁺ \Type u)
                                        (g : LeftKanExtStraight f P ~> Q)
  : (\lam (t :⁺ \Sigma⁺ (a : A) (P a)) => depUnivalence g (f t.1, leftKanExtStraight-unit f P t.1 t.2))
    = depUnivalence (comp (depUnivalence.ret \lam t => leftKanExtStraight-unit f P t.1 t.2) (dmap (\lam G a =>⁺ G (f a)) g))
  => \let | eta => depUnivalence.ret (\lam t => leftKanExtStraight-unit f P t.1 t.2)
          | rg => dmap (\lam G a =>⁺ G (f a)) g
     \in ext \lam t => inv (~>_->_comp (dmap (\lam H => H t.1) eta) (dmap (\lam H => H t.1) rg))
                       *> pmap+ (~>_-> __ t.2) (inv (dmap_comp (\lam (H : A ->⁺ \Type u) => H t.1) {_} {_} {_} {eta} {rg}))

-- | {LeftKanExtStraight} is pointwise left adjoint to restriction along {f}.
\func leftKanRightAdjoint.{u} {A B : \Cat u} (f : A ->⁺ B) : RightAdjoint {A ->⁺ \Type u} {B ->⁺ \Type u} (\lam Q a => Q (f a)) \cowith
  | lob P => LeftKanExtStraight f P
  | eta0 P => depUnivalence.ret (\lam t => leftKanExtStraight-unit f P t.1 t.2)
  | eta0-adjoint {P} {Q} => IsEquiv.leftFactor (inP depUnivalence) $ transport IsEquiv
      (path \lam i g => leftKanExtStraight-comp-unit f P Q g i)
      (IsEquiv.trans (inP depUnivalence) (leftKanExtStraight-univ f P (leftFib-pullback Q universe-leftFib)))

-- | The left Kan extension along {f} of functors to `\Type u`; unlike {LeftKanExtStraight}, it is covariant in {P}.
\func LeftKanExtType.{u} {A B : \Cat u} (f : A ->⁺ B) (P :⁺ A ->⁺ \Type u) (b :⁺ B) : \Type u
  => (leftKanRightAdjoint f).ladj P b

-- | Left Kan extension along {f} is left adjoint to restriction along {f}.
\func leftKanAdjunction.{u} {A B : \Cat u} (f : A ->⁺ B) : QAdjunction (A ->⁺ \Type u) (B ->⁺ \Type u)
  => (leftKanRightAdjoint f).toAdjunction

-- | The unit of {LeftKanExtType}.
\func leftKanExtType-unit.{u} {A B : \Cat u} (f : A ->⁺ B) (P :⁺ A ->⁺ \Type u) : P ~> (\lam a => LeftKanExtType f P (f a))
  => (leftKanRightAdjoint f).heta P

-- | The universal property of {LeftKanExtType}: natural transformations out of it are natural transformations out of {P}.
\lemma leftKanExtType-univ.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u) (Q : B ->⁺ \Type u)
  : IsEquiv {LeftKanExtType f P ~> Q} {P ~> (\lam a => Q (f a))}
            (\lam g => comp (leftKanExtType-unit f P) (dmap (\lam G a =>⁺ G (f a)) g))
  => (leftKanRightAdjoint f).heta-univ P Q

-- | The universal arrow given by {LeftKanExtType}.
\func leftKanExtType-univArrow.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u)
  : UnivArrow {A ->⁺ \Type u} {B ->⁺ \Type u} (\lam G a =>⁺ G (f a)) P \cowith
  | L0x => LeftKanExtType f P
  | eta0x => leftKanExtType-unit f P
  | eta0x-univ {Q} => leftKanExtType-univ f P Q

-- | On objects, {LeftKanExtType} agrees with {LeftKanExtStraight}.
\func leftKanExtType-char.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u) (b :⁺ B) : LeftKanExtType f P b = LeftKanExtStraight f P b
  => path \lam i => L0x {UnivArrow.levelProp (leftKanExtType-univArrow f P) (RightAdjoint.univArrow (leftKanRightAdjoint f) P) i} b

\lemma leftKanExtType-leftFib.{u} {A B : \Cat u} (f : A ->⁺ B) (P : A ->⁺ \Type u) : IsLeftFib (LeftKanExtType f P)
  => leftFib-pullback (LeftKanExtType f P) universe-leftFib