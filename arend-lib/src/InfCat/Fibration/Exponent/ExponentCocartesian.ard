{- | The exponent of a cocartesian fibration into a fixed category.

 -   Let `p : E ->⁺ B` be a cocartesian map and let {C} be a category. The exponent is the small category {ExpCocConst}
 -   with the projection {ExpCocConst.proj} to {B}; its objects over `b` are functors `Fibers p b ->⁺ C`:
 -   * {ExpCocConst.eval}: an object `y` evaluated as a functor `Fibers p (proj y) ->⁺ C`.
 -   * {ExpCocConst.eval-univ}: the universal property; functors `T ->⁺ ExpCocConst` are functors `pi : T ->⁺ B`
 -     together with functors `BaseChange pi p ->⁺ C`.

 -   Construction (route B of exponent-cocart.tex): the slice construction {ExpSl} exponentiates fiberwise opposites.
 -   * For a cocartesian map `q : E' ->⁺ B`, let `R b x = Op.Hom (OpFunc q x) b` on `Op E'` ({ExpCocHelpers.preR}) and let `W`
 -     consist of the opposites of `q`-cocartesian arrows ({ExpCocHelpers.CocartOpW}). The total category {SecTot} of the categories
 -     of elements along {pi} is the base change of the pre-opposite `PreFiberOp q` ({ExpCocHelpers.jT}, {ExpCocHelpers.jT-equiv}),
 -     and the classes {SecW} and `TotalFibW` correspond ({ExpCocHelpers.class-equiv}).
 -     Since fiberwise localization commutes with base change ({fibLoc-baseChange}), {SecTot} localizes to the base change of
 -     `FibOp q` ({ExpCocHelpers.loc}). So {ExpSl.eval-univ} gives the universal property for `FibOp q` ({ExpCocHelpers.secPre-equiv}),
 -     where {ExpCocHelpers.secPre} is the extension of {ExpSl.eval} along this localization; it is natural in {pi}
 -     ({ExpCocHelpers.secPre-natural}).
 -   * Apply this to `q = FibOp p` and transport along the involution `FibOp (FibOp p) = p` ({fibOp-invol}).
 -   * The total category {ExpCocHelpers.ExpCocTot} of these exponents ({ExpCocHelpers.ExpCocL}) is too large, but its arrows are
 -     families of objects along `DI` ({ExpCocHelpers.expCocTot-arrows}), so it can be resized; {ExpCocConst} is the resized category.
 -     {ExpCocHelpers.evalL} is the functor corresponding to the universal family over {ExpCocConst},
 -     and {ExpCocHelpers.evalL-univ} follows from the naturality of this correspondence ({ExpCocHelpers.secGen-natural}).

 -   For an arbitrary functor `q : Y ->⁺ B`, the exponent {ExpCoc} (thm:main of exponent-cocart.tex) has objects over `b`
 -   the functors `Fibers p b ->⁺ Fibers q b`:
 -   * {ExpCoc.eval-univ}: functors `T ->⁺ ExpCoc` are functors `pi : T ->⁺ B` together with functors over {B}
 -     from `BaseChange pi p` to {q}.
 -   * Construction (Lemma const of exponent-cocart.tex): {ExpCoc} is the pullback of the postcomposition with {q}
 -     ({ExpCocHelpers.expPost}) along the section {ExpCocHelpers.expSec} of `ExpCocConst pc B` that corresponds to the
 -     projections of the fibers. The universal property is the chain {ExpCocHelpers.expChain} of equivalences; it is natural in `T`
 -     ({ExpCocHelpers.evalPathF-natural}), so it is given by the evaluation along the identity of {ExpCoc}.
 -}

\import Equiv
\import Equiv.Path
\import Equiv.Sigma
\import Function.Meta
\import InfCat.Fibration.Categorical
\import InfCat.Fibration.Covariant.CocartesianMap
\import InfCat.Fibration.Exponent.ExponentSlice
\import InfCat.Functor.Equiv
\import InfCat.Localization.Abstract
\import InfCat.Localization.Concrete
\import InfCat.Localization.Fiberwise
\import InfCat.Localization.Fiberwise.FiberwiseTotal
\import InfCat.Opposite
\import InfCat.Opposite.Fiberwise
\import InfCat.Paths
\import InfCat.Resizing
\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta
\open FibOpConstruction (PreFiberOp, preFiberOp-cocartesian, W, W-stable)
\open ExpCocHelpers

-- | The total category of the exponent from the cocartesian map {p} to {C}; its objects over `b` are functors `Fibers p b ->⁺ C`.
\type ExpCocConst.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u) : \Cat u
  => ResizeFromArrows (expCocTot-arrows pc C)
  \where {
    -- | The projection of the exponent to the base.
    \protected \func proj.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u) (y :⁺ ExpCocConst pc C) : B
      => (unresize y).1

    -- | The evaluation map.
    \protected \sfunc eval.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) {C : \Cat u}
                               (y :⁺ ExpCocConst pc C) (x :⁺ Fibers p (proj pc C y)) : C
      => evalL pc (unresize y).2 x

    -- | The universal property: functors into the exponent are functors to {B} together with functors on the base change of {p}.
    \protected \lemma eval-univ.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) {C : \Cat u} (T : \Cat u)
      : IsEquiv {T ->⁺ ExpCocConst pc C} {\Sigma (pi : T ->⁺ B) (BaseChange pi p ->⁺ C)}
                (\lam s => (\lam t => proj pc C (s t), \lam q => eval pc (s q.1) q.2))
      => transport IsEquiv (path \lam j (s : T ->⁺ ExpCocConst pc C) =>
           ((\lam t => proj pc C (s t), funExt+ (\lam q => inv (\peval eval pc (s q.1) q.2)) j) : \Sigma (pi : T ->⁺ B) (BaseChange pi p ->⁺ C)))
           (inP (unresize-equiv pc C T `transQEquiv` tot-split pc C T `transQEquiv` sigma-right \lam pi => IsEquiv.toQEquiv (evalL-univ pc {C} pi)))
  }

-- | The exponent from the cocartesian map {p} to {q}; its objects over `b` are functors `Fibers p b ->⁺ Fibers q b`.
\type ExpCoc.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B) : \Cat u
  => BaseChange (expSec pc) (expPost pc q)
  \where {
    -- | The projection of the exponent to the base.
    \protected \func proj.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B) (y :⁺ ExpCoc pc q) : B
      => ExpCocConst.proj pc Y y.2.1

    -- | The evaluation map.
    \protected \func eval.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) {q : Y ->⁺ B}
                              (y :⁺ ExpCoc pc q) (x :⁺ Fibers p (proj pc q y)) : Fibers q (proj pc q y)
      => (ExpCocConst.eval pc y.2.1 x, path \lam i => evalPathF pc q (\lam y => y) i (y, x))

    {- | The universal property: functors into the exponent are functors `pi` to {B} together with functors over {B}
     -   from the base change of {p} along `pi` to {q}.
     -}
    \protected \lemma eval-univ.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B) (T : \Cat u)
      : IsEquiv {T ->⁺ ExpCoc pc q} {\Sigma (pi : T ->⁺ B) (\Pi (w :⁺ BaseChange pi p) -> Fibers q (pi w.1))}
                (\lam s => (\lam t => proj pc q (s t), \lam w => eval pc (s w.1) w.2))
      => transport IsEquiv (path \lam j (s : T ->⁺ ExpCoc pc q) =>
           ((\lam t => proj pc q (s t), \lam w => (ExpCocConst.eval pc (s w.1).2.1 w.2, path \lam i => evalPathF-natural pc q s j i w))
             : \Sigma (pi : T ->⁺ B) (\Pi (w :⁺ BaseChange pi p) -> Fibers q (pi w.1))))
           (expChain pc q T)
  }

\module ExpCocHelpers \where {
  -- | The presheaves `Op.Hom (OpFunc q -) b` on `Op E`; their categories of elements are the fibers of the pre-opposite.
  \type preR.{u} {B E : \Cat u} (q : E ->⁺ B) (b :⁺ B) (x :⁺ Op E) : \Type u
    => Op.Hom (OpFunc q x) b

  -- | The opposites of {q}-cocartesian arrows.
  \type CocartOpW.{u} {B E : \Cat u} (q : E ->⁺ B) (a : DI ->⁺ Op E) : \Prop
    => ∃ (v : DI ->⁺ E) (IsCocartesianArrow q (dpath v)) ((\lam i =>⁺ a i) = opArr (dpath v))

  -- | {SecTot} as the base change of the pre-opposite.
  \func jT.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) (w :⁺ SecTot (preR q) pi) : BaseChange pi (PreFiberOp.proj q)
    => (w.1, ((w.2.1, pi w.1, w.2.2), idp))

  -- | The inverse of {jT}.
  \func jInv.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) (y :⁺ BaseChange pi (PreFiberOp.proj q)) : SecTot (preR q) pi
    => (y.1, (y.2.1.1, PreFiberOp.fiberHom y.2))

  \lemma jT-equiv.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) : IsHEquiv (jT {B} {E} {T} {q} pi)
    => IsHEquiv.biEquiv {_} {_} {_} {jInv pi} (\lam x => idp) {jInv pi} \lam y => pair-path (PreFiberOp.fiber-path y.2)
    \where
      \sfunc pair-path {T : \Cat} {F : T ->⁺ \Cat} {t :⁺ T} {x y :⁺ F t} (r :⁺ x = y) : ((t, x) : \Sigma⁺ (z : T) (F z)) = (t, y) \elim r
        | idp => idp

  -- | The first component of a transport in {secFib}.
  \sfunc transport+_secFib.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) {t s :⁺ T} (r :⁺ t = s) (k :⁺ secFib (preR q) pi t)
    : (transport+ (secFib (preR q) pi) r k).1 = k.1 \elim r
    | idp => idp

  -- | The `Op E`-component of a transport in the fibers of the pre-opposite.
  \sfunc transport+_PreFiberOp.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) {t s :⁺ T} (r :⁺ t = s) (y :⁺ Fibers (PreFiberOp.proj q) (pi t))
    : (transport+ (\lam z => Fibers (PreFiberOp.proj q) (pi z)) r y).1.1 = y.1.1 \elim r
    | idp => idp

  -- | {jT} identifies {SecW} with the class of {fibLoc-baseChange}.
  \lemma class-equiv.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) (a : DI ->⁺ SecTot (preR q) pi)
    : TotW (totalProj (\lam z => Fibers (PreFiberOp.proj q) (pi z)))
           (TotalFibW {T} {\lam z => Fibers (PreFiberOp.proj q) (pi z)} (\lam z => W q (pi z))) (\lam i => jT pi (a i))
      <-> SecW (preR q) pi (CocartOpW q) a
    => (\lam (inP (s, b, w)) => inP (s, b, transport {DI ->⁺ Op E} (CocartOpW q)
          (path \lam j i => (transport+_PreFiberOp pi (b i) (jT pi (a i)).2 *> inv (transport+_secFib pi (b i) (a i).2)) j) w),
        \lam (inP (s, b, w)) => inP (s, b, transport {DI ->⁺ Op E} (CocartOpW q)
          (path \lam j i => (transport+_secFib pi (b i) (a i).2 *> inv (transport+_PreFiberOp pi (b i) (jT pi (a i)).2)) j) w))

  -- | The localization of {SecTot} to the base change of the fiberwise localization of the pre-opposite.
  \func locMap.{u} {B E T : \Cat u} {q : E ->⁺ B} (pi : T ->⁺ B) (w :⁺ SecTot (preR q) pi)
    : BaseChange pi (fibLocProj (PreFiberOp.proj q) (W q))
    => (w.1, (localize (TotW (PreFiberOp.proj q) (W q)) (w.2.1, pi w.1, w.2.2), idp))

  \lemma loc.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {T : \Cat u} (pi : T ->⁺ B)
    : IsLocalization (SecW (preR q) pi (CocartOpW q)) (locMap pi)
    => isLocalization-transfer' {SecTot (preR q) pi} {BaseChange pi (PreFiberOp.proj q)}
        (fibLoc-baseChange (preFiberOp-cocartesian q) (W-stable qc) pi) (jT-equiv pi) idHEquiv (\lam w => idp) (class-equiv pi)

  -- | The functor corresponding to a family of objects: the extension of {ExpSl.eval} along {loc}.
  \sfunc secPre.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {C : \Cat u} {T : \Cat u} (pi : T ->⁺ B)
                   (s : \Pi (t :⁺ T) -> ExpSl (preR q) C (CocartOpW q) (pi t)) (w :⁺ BaseChange pi (fibLocProj (PreFiberOp.proj q) (W q))) : C
    => IsLocalization.lift (loc qc pi) (totalFibW-inverts {T} {_} {_} {_} {\lam w => ExpSl.eval (s w.1) w.2} (\lam t => ExpSl.eval-inverts (s t))) w

  \lemma secPre-equiv.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {C : \Cat u} {T : \Cat u} (pi : T ->⁺ B)
    : IsEquiv (secPre qc {C} pi)
    => IsEquiv.leftFactor (restrictW-equiv (IsLocalization.univ (loc qc pi))) $
       transport IsEquiv (ext \lam s => ext (funExt+ \lam w => inv IsLocalization.lift.restrict *> inv (\peval secPre qc pi s (locMap pi w)))) (ExpSl.eval-univ pi)

  -- | {secPre} is natural in `pi`: along `pi' ∘ g`, it is the restriction of {secPre} along {pi'}.
  \sfunc secPre-natural.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {C : \Cat u} {T T' : \Cat u} (pi' : T' ->⁺ B)
                            (s' : \Pi (t :⁺ T') -> ExpSl (preR q) C (CocartOpW q) (pi' t)) (g : T ->⁺ T')
                            {w :⁺ BaseChange (\lam (t :⁺ T) => pi' (g t)) (fibLocProj (PreFiberOp.proj q) (W q))}
    : secPre qc (\lam t => pi' (g t)) (\lam t => s' (g t)) w = secPre qc pi' s' (g w.1, w.2)
    => loc-ext-eq (IsLocalization.univ (loc qc \lam t => pi' (g t))) {\lam w => secPre qc (\lam t => pi' (g t)) (\lam t => s' (g t)) w}
         \lam x => (\peval secPre qc (\lam t => pi' (g t)) (\lam t => s' (g t)) (locMap (\lam t => pi' (g t)) x))
                    *> IsLocalization.lift.restrict
                    *> inv (IsLocalization.lift.restrict {_} {_} {_} {_} {_} {loc qc pi'} {_} {_} {g x.1, x.2})
                    *> inv (\peval secPre qc pi' s' (locMap pi' (g x.1, x.2)))

  -- | {secPre} for any {d} equal to the fiberwise opposite of {q}.
  \func secGen.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {d : \Sigma (E' : \Cat u) (E' ->⁺ B)}
                   (r : (FibLoc (PreFiberOp.proj q) (W q), fibLocProj (PreFiberOp.proj q) (W q)) = {\Sigma (E' : \Cat u) (E' ->⁺ B)} d)
                   {C : \Cat u} {T : \Cat u} (pi : T ->⁺ B) (s : \Pi (t :⁺ T) -> ExpSl (preR q) C (CocartOpW q) (pi t)) : BaseChange pi d.2 ->⁺ C \elim r
    | idp => secPre qc pi s

  \lemma secGen-equiv.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {d : \Sigma (E' : \Cat u) (E' ->⁺ B)}
                          (r : (FibLoc (PreFiberOp.proj q) (W q), fibLocProj (PreFiberOp.proj q) (W q)) = {\Sigma (E' : \Cat u) (E' ->⁺ B)} d)
                          {C : \Cat u} {T : \Cat u} (pi : T ->⁺ B)
    : IsEquiv (secGen qc r {C} pi) \elim r
    | idp => secPre-equiv qc pi

  \sfunc secGen-natural.{u} {B E : \Cat u} {q : E ->⁺ B} (qc : IsCocartesianMap q) {d : \Sigma (E' : \Cat u) (E' ->⁺ B)}
                            (r : (FibLoc (PreFiberOp.proj q) (W q), fibLocProj (PreFiberOp.proj q) (W q)) = {\Sigma (E' : \Cat u) (E' ->⁺ B)} d)
                            {C : \Cat u} {T T' : \Cat u} (pi' : T' ->⁺ B) (s' : \Pi (t :⁺ T') -> ExpSl (preR q) C (CocartOpW q) (pi' t)) (g : T ->⁺ T')
                            {w :⁺ BaseChange (\lam (t :⁺ T) => pi' (g t)) d.2}
    : secGen qc r (\lam t => pi' (g t)) (\lam t => s' (g t)) w = secGen qc r pi' s' (g w.1, w.2) \elim r
    | idp => secPre-natural qc pi' s' g

  -- | The exponent before resizing.
  \type ExpCocL.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u) (b :⁺ B) : \Cat
    => ExpSl (preR (FibOp.proj pc)) C (CocartOpW (FibOp.proj pc)) b

  -- | Families of objects of {ExpCocL} are families of objects of its defining {ExpSl}.
  \func expCoc-sl.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u) {T : \Cat u} (pi : T ->⁺ B)
    : QEquiv {\Pi (t :⁺ T) -> ExpCocL pc C (pi t)} {\Pi (t :⁺ T) -> ExpSl (preR (FibOp.proj pc)) C (CocartOpW (FibOp.proj pc)) (pi t)} \cowith
    | f s t => s t
    | ret s t => s t
    | ret_f _ => idp
    | f_sec _ => idp

  -- | The total category of the exponent.
  \type ExpCocTot.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u) : \Cat
    => \Sigma⁺ (b : B) (ExpCocL pc C b)

  -- | Arrows of {ExpCocTot} are functors on the base changes of {p} along arrows of {B}.
  \sfunc expCocTot-arrows.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u)
    : QEquiv {DI ->⁺ ExpCocTot pc C} {\Sigma (beta : DI ->⁺ B) (BaseChange beta p ->⁺ C)}
    => \new QEquiv {DI ->⁺ ExpCocTot pc C} {\Sigma (beta : DI ->⁺ B) (\Pi (i :⁺ DI) -> ExpCocL pc C (beta i))} {
         | f h => (\lam i => (h i).1, \lam i => (h i).2)
         | ret s i => (s.1 i, s.2 i)
         | ret_f _ => idp
         | f_sec _ => idp
       } `transQEquiv` sigma-right \lam beta => expCoc-sl pc C beta `transQEquiv` IsEquiv.toQEquiv (secGen-equiv (fibOp-cocartesian pc) (fibOp-invol pc) {C} beta)

  -- | The inverse of `resizeCat`.
  \func unresize.{u} {B E : \Cat u} {p : E ->⁺ B} {pc : IsCocartesianMap p} {C : \Cat u} (y :⁺ ExpCocConst pc C) : ExpCocTot pc C \elim y
    | resizeCat z => z

  -- | The evaluation map of {ExpCocL}.
  \sfunc evalL.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) {C : \Cat u} {b :⁺ B}
                   (e :⁺ ExpCocL pc C b) (x :⁺ Fibers p b) : C
    => secGen (fibOp-cocartesian pc) (fibOp-invol pc) (\lam y => (unresize y).1) (\lam y => (unresize y).2) (resizeCat (b, e), x)

  \lemma evalL-univ.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) {C : \Cat u} {T : \Cat u} (pi : T ->⁺ B)
    : IsEquiv {\Pi (t :⁺ T) -> ExpCocL pc C (pi t)} {BaseChange pi p ->⁺ C} (\lam s q => evalL pc (s q.1) q.2)
    => transport IsEquiv (path \lam j (s : \Pi (t :⁺ T) -> ExpCocL pc C (pi t)) => funExt+ (\lam q =>
         secGen-natural (fibOp-cocartesian pc) (fibOp-invol pc) (\lam y => (unresize y).1) (\lam y => (unresize y).2)
                        (\lam t => resizeCat (pi t, s t)) {q}
         *> inv (\peval evalL pc (s q.1) q.2)) j)
       (inP (expCoc-sl pc C pi `transQEquiv` IsEquiv.toQEquiv (secGen-equiv (fibOp-cocartesian pc) (fibOp-invol pc) pi)))

  -- | The inverse of {unresize}.
  \sfunc resize-eta.{u} {B E : \Cat u} {p : E ->⁺ B} {pc : IsCocartesianMap p} {C : \Cat u} (y :⁺ ExpCocConst pc C)
    : resizeCat (unresize y) = {ExpCocConst pc C} y \elim y
    | resizeCat z => idp

  -- | Functors into {ExpCocConst} are functors into {ExpCocTot}.
  \func unresize-equiv.{u} {S E : \Cat u} {p : E ->⁺ S} (pc : IsCocartesianMap p) (C : \Cat u) (T : \Cat u)
    : QEquiv {T ->⁺ ExpCocConst pc C} {T ->⁺ ExpCocTot pc C} \cowith
    | f s t => unresize (s t)
    | ret h t => resizeCat (h t)
    | ret_f s => funExt+ \lam t => resize-eta (s t)
    | f_sec _ => idp

  -- | Functors into {ExpCocTot} are functors to {S} with families of objects of {ExpCocL}.
  \func tot-split.{u} {S E : \Cat u} {p : E ->⁺ S} (pc : IsCocartesianMap p) (C : \Cat u) (T : \Cat u)
    : QEquiv {T ->⁺ ExpCocTot pc C} {\Sigma (pi : T ->⁺ S) (\Pi (t :⁺ T) -> ExpCocL pc C (pi t))} \cowith
    | f h => (\lam t => (h t).1, \lam t => (h t).2)
    | ret s t => (s.1 t, s.2 t)
    | ret_f _ => idp
    | f_sec _ => idp

  -- | The map of {ExpCocConst.eval-univ}.
  \func evalPair.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u) {T : \Cat u} (s : T ->⁺ ExpCocConst pc C)
    : \Sigma (pi : T ->⁺ B) (BaseChange pi p ->⁺ C)
    => (\lam t => ExpCocConst.proj pc C (s t), \lam w => ExpCocConst.eval pc (s w.1) w.2)

  \func evalPairQ.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (C : \Cat u) (T : \Cat u) : QEquiv (evalPair pc C {T})
    => IsEquiv.toQEquiv (ExpCocConst.eval-univ pc T)

  -- | Precomposition with {g}.
  \func preComp.{u} {B E T T' C : \Cat u} {p : E ->⁺ B} (g : T ->⁺ T') (x : \Sigma (pi : T' ->⁺ B) (BaseChange pi p ->⁺ C))
    : \Sigma (pi : T ->⁺ B) (BaseChange pi p ->⁺ C)
    => (\lam t => x.1 (g t), \lam w => x.2 (g w.1, w.2))

  -- | Precomposition with the base change of {g}.
  \func preFun.{u} {B E T T' C : \Cat u} {p : E ->⁺ B} (g : T ->⁺ T') {pi : T' ->⁺ B} (G : BaseChange pi p ->⁺ C)
    : BaseChange (\lam t => pi (g t)) p ->⁺ C
    => \lam w => G (g w.1, w.2)

  -- | The functor {pi} together with the projection of the base change along {pi}.
  \func projPair.{u} {B E T : \Cat u} {p : E ->⁺ B} (pi : T ->⁺ B) : \Sigma (pi : T ->⁺ B) (BaseChange pi p ->⁺ B)
    => (pi, \lam w => pi w.1)

  -- | The projection and the evaluation postcomposed with {q} on the base change along the projection of {ExpCocConst}.
  \func postPair.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B)
    : \Sigma (pi : ExpCocConst pc Y ->⁺ B) (BaseChange pi p ->⁺ B)
    => (\lam y => ExpCocConst.proj pc Y y, \lam w => q (ExpCocConst.eval pc w.1 w.2))

  -- | Postcomposition with {q}.
  \func expPost.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B) : ExpCocConst pc Y ->⁺ ExpCocConst pc B
    => (evalPairQ pc B (ExpCocConst pc Y)).ret (postPair pc q)

  \sfunc expPost-eval.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B) : evalPair pc B (expPost pc q) = postPair pc q
    => (evalPairQ pc B (ExpCocConst pc Y)).f_sec (postPair pc q)

  -- | The section of the projection of {ExpCocConst} corresponding to the projections of the fibers.
  \func expSec.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) : B ->⁺ ExpCocConst pc B
    => (evalPairQ pc B B).ret (projPair (\lam b => b))

  \sfunc expSec-eval.{u} {B E : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) : evalPair pc B (expSec pc) = projPair (\lam b => b)
    => (evalPairQ pc B B).f_sec (projPair (\lam b => b))

  -- | Conjugation of paths is an equivalence.
  \lemma conj-equiv {A : \Cat} {a a' b b' : A} (u : a = a') (v : b = b') : IsEquiv {a = b} {a' = b'} (\lam r => inv u *> r *> v) \elim u, v
    | idp, idp => transport IsEquiv (path \lam j (r : a = b) => inv (idp_*> {A} {a} {b} {r}) j) (inP idEquiv)

  -- | The map from the fiber of the pairing with a section {d} over {x} to the paths from `x.2` to `d x.1`.
  \func secFib-map {A : \Cat} {P : A -> \Cat} (d : \Pi (a : A) -> P a) (x : \Sigma (a : A) (P a)) (s : \Sigma (a : A) (x = (a, d a))) : x.2 = d x.1
    => transport (\lam (z : \Sigma (a : A) (P a)) => z.2 = d z.1) (inv s.2) idp

  \func secFib-equiv {A : \Cat} {P : A -> \Cat} (d : \Pi (a : A) -> P a) (x : \Sigma (a : A) (P a))
    : QEquiv {\Sigma (a : A) (x = (a, d a))} {x.2 = d x.1} \cowith
    | f => secFib-map d x
    | ret c => (x.1, path \lam i => (x.1, c i))
    | ret_f s => ret_f-aux d s.2
    | f_sec c => f_sec-aux d c
    \where {
      \sfunc ret_f-aux {A : \Cat} {P : A -> \Cat} (d : \Pi (a : A) -> P a) {x : \Sigma (a : A) (P a)} {a : A} (r : x = (a, d a))
        : ((x.1, path \lam i => (x.1, secFib-map d x (a, r) i)) : \Sigma (a' : A) (x = (a', d a'))) = (a, r) \elim r
        | idp => idp

      \sfunc f_sec-aux {A : \Cat} {P : A -> \Cat} (d : \Pi (a : A) -> P a) {a : A} {y : P a} (c : y = d a)
        : transport (\lam (z : \Sigma (a : A) (P a)) => z.2 = d z.1) (inv (path \lam i => ((a, c i) : \Sigma (a : A) (P a)))) idp = c \elim c
        | idp => idp
    }

  -- | {secFib-map} commutes with precomposition.
  \sfunc secFib-natural.{u} {B E T T' : \Cat u} {p : E ->⁺ B} (h : T ->⁺ T') {x z : \Sigma (pi : T' ->⁺ B) (BaseChange pi p ->⁺ B)}
                            (r : x = z) (c : z.2 = (\lam w => z.1 w.1))
    : transport (\lam (z' : \Sigma (pi : T ->⁺ B) (BaseChange pi p ->⁺ B)) => z'.2 = (\lam w => z'.1 w.1)) (inv (pmap (preComp h) r)) (pmap (preFun h) c)
      = pmap (preFun h) (transport (\lam (z' : \Sigma (pi : T' ->⁺ B) (BaseChange pi p ->⁺ B)) => z'.2 = (\lam w => z'.1 w.1)) (inv r) c) \elim r
    | idp => idp

  -- | Functors into {ExpCoc} are functors to {B} and to {ExpCocConst} with a path between their images in `ExpCocConst pc B`.
  \func expSplit.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B) (T : \Cat u)
    : QEquiv {T ->⁺ ExpCoc pc q} {\Sigma (pi : T ->⁺ B) (\Sigma (s : T ->⁺ ExpCocConst pc Y) (\Pi (t :⁺ T) -> expPost pc q (s t) = expSec pc (pi t)))} \cowith
    | f h => (\lam t => (h t).1, (\lam t => (h t).2.1, \lam t => (h t).2.2))
    | ret x t => (x.1 t, (x.2.1 t, x.2.2 t))
    | ret_f _ => idp
    | f_sec _ => idp

  -- | The path in {ExpCocConst.eval-univ} corresponding to a functor into {ExpCoc}.
  \func expPath.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B) {T : \Cat u} (h : T ->⁺ ExpCoc pc q)
    : preComp (\lam t => (h t).2.1) (postPair pc q) = projPair (\lam t => (h t).1)
    => inv (pmap (preComp (\lam t => (h t).2.1)) (expPost-eval pc q))
       *> pmap (evalPair pc B {T}) (funExt+ {T} {\lam _ => ExpCocConst pc B} {\lam t => expPost pc q (h t).2.1} {\lam t => expSec pc (h t).1} \lam t => (h t).2.2)
       *> pmap (preComp (\lam t => (h t).1)) (expSec-eval pc)

  \sfunc expPath-natural.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B) {T : \Cat u} (h : T ->⁺ ExpCoc pc q)
    : expPath pc q h = pmap (preComp h) (expPath pc q (\lam y => y))
    => \let | u => pmap (preComp (\lam (y :⁺ ExpCoc pc q) => y.2.1)) (expPost-eval pc q)
             | m => pmap (evalPair pc B {ExpCoc pc q}) (funExt+ {ExpCoc pc q} {\lam _ => ExpCocConst pc B} {\lam y => expPost pc q y.2.1} {\lam y => expSec pc y.1} \lam y => y.2.2)
             | v => pmap (preComp (\lam (y :⁺ ExpCoc pc q) => y.1)) (expSec-eval pc)
       \in inv (pmap_*>-comm (preComp h) (inv u) (m *> v)
               *> pmap (`*> pmap (preComp h) (m *> v)) (pmap_inv-comm (preComp h) u)
               *> pmap (inv (pmap (preComp h) u) *>) (pmap_*>-comm (preComp h) m v))

  -- | The paths from `q ∘ eval` to the projection along a functor into {ExpCoc}.
  \func evalPathF.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B) {T : \Cat u} (h : T ->⁺ ExpCoc pc q)
    : (\lam w => q (ExpCocConst.eval pc (h w.1).2.1 w.2)) = {BaseChange (\lam t => ExpCocConst.proj pc Y (h t).2.1) p ->⁺ B}
      (\lam w => ExpCocConst.proj pc Y (h w.1).2.1)
    => secFib-map {T ->⁺ B} {\lam pi => BaseChange pi p ->⁺ B} (\lam pi w => pi w.1) (preComp (\lam t => (h t).2.1) (postPair pc q))
                  (\lam t => (h t).1, expPath pc q h)

  \sfunc evalPathF-natural.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B) {T : \Cat u} (h : T ->⁺ ExpCoc pc q)
    : evalPathF pc q h = pmap (preFun h) (evalPathF pc q (\lam y => y))
    => pmap (\lam R => secFib-map {T ->⁺ B} {\lam pi => BaseChange pi p ->⁺ B} (\lam pi w => pi w.1)
                                  (preComp (\lam t => (h t).2.1) (postPair pc q)) (\lam t => (h t).1, R)) (expPath-natural pc q h)
       *> secFib-natural h (expPath pc q (\lam y => y)) idp

  -- | The equivalence of {ExpCoc.eval-univ}, before the naturality of {evalPathF}.
  \lemma expChain.{u} {B E Y : \Cat u} {p : E ->⁺ B} (pc : IsCocartesianMap p) (q : Y ->⁺ B) (T : \Cat u)
    : IsEquiv {T ->⁺ ExpCoc pc q} {\Sigma (pi : T ->⁺ B) (\Pi (w :⁺ BaseChange pi p) -> Fibers q (pi w.1))}
              (\lam s => (\lam t => ExpCoc.proj pc q (s t), \lam w => (ExpCocConst.eval pc (s w.1).2.1 w.2, path \lam i => evalPathF pc q s i w)))
    => inP (expSplit pc q T
       `transQEquiv` sigma-right (\lam (pi : T ->⁺ B) => sigma-right \lam (s : T ->⁺ ExpCocConst pc Y) =>
            funExt+-equiv {T} {\lam _ => ExpCocConst pc B} {\lam t => expPost pc q (s t)} {\lam t => expSec pc (pi t)}
            `transQEquiv` IsEquiv.toQEquiv (pmapIsEquiv (ExpCocConst.eval-univ pc {B} T))
            `transQEquiv` IsEquiv.toQEquiv (conj-equiv (pmap (preComp s) (expPost-eval pc q)) (pmap (preComp pi) (expSec-eval pc))))
       `transQEquiv` swap
       `transQEquiv` sigma-right (\lam (s : T ->⁺ ExpCocConst pc Y) =>
            secFib-equiv {T ->⁺ B} {\lam pi => BaseChange pi p ->⁺ B} (\lam pi w => pi w.1) (preComp s (postPair pc q))
            `transQEquiv` symQEquiv funExt+-equiv)
       `transQEquiv` qsigma-left {_} {_} {\lam (x : \Sigma (pi : T ->⁺ B) (BaseChange pi p ->⁺ Y)) => \Pi (w :⁺ BaseChange x.1 p) -> q (x.2 w) = x.1 w.1}
                                 (evalPairQ pc Y T)
       `transQEquiv` join)
    \where {
      \func swap : QEquiv {\Sigma (pi : T ->⁺ B) (\Sigma (s : T ->⁺ ExpCocConst pc Y) (preComp s (postPair pc q) = projPair pi))}
                          {\Sigma (s : T ->⁺ ExpCocConst pc Y) (\Sigma (pi : T ->⁺ B) (preComp s (postPair pc q) = projPair pi))} \cowith
        | f x => (x.2.1, (x.1, x.2.2))
        | ret x => (x.2.1, (x.1, x.2.2))
        | ret_f _ => idp
        | f_sec _ => idp

      \func join : QEquiv {\Sigma (x : \Sigma (pi : T ->⁺ B) (BaseChange pi p ->⁺ Y)) (\Pi (w :⁺ BaseChange x.1 p) -> q (x.2 w) = x.1 w.1)}
                          {\Sigma (pi : T ->⁺ B) (\Pi (w :⁺ BaseChange pi p) -> Fibers q (pi w.1))} \cowith
        | f y => (y.1.1, \lam w => (y.1.2 w, y.2 w))
        | ret z => ((z.1, \lam w => (z.2 w).1), \lam w => (z.2 w).2)
        | ret_f _ => idp
        | f_sec _ => idp
    }
}