\import Equiv
\import Equiv.Fiber
\import Function.Meta
\import Homotopy.Diagonal
\import Homotopy.HLevel
\import Homotopy.Truncation
\import InfCat.Arrows
\import InfCat.Basics
\import InfCat.CatPushout
\import InfCat.Fibration.DirectedUnivalence
\import InfCat.Fibration.Straightening
\import InfCat.Functor.Equiv
\import InfCat.Functor.FullyFaithful
\import InfCat.OFS.CatAccessibleOFS
\import InfCat.OFS.CatOFS
\import InfCat.Objects
\import InfCat.Paths
\import InfCat.Square
\import InfCat.SubCat.Full
\import InfCat.Trunc.TruncUniverse
\import InfCat.Yoneda.EncodeDecode
\import InfCat.Yoneda.CovariantYoneda
\import Logic
\import Meta
\import Paths
\import Paths.Meta

\type IsTruncCat (n : Nat) (C : \Cat) : \Prop
  => \Pi (x y : C) -> (x ~> y) ofHLevel_-1+ n

\lemma TypeCat_IsTruncCat.{u} {n : Nat} : IsTruncCat n (TypeCat.{u} n)
  => \lam A B => TypeCat-hom-level

-- | The universal category with hom-types of level {n} under {C}.
\type CatTrunc (n : Nat) (C : \Cat) : \Cat
  => CatFactor {family n} {C} (\lam _ => ())
  \where {
    -- | Iterated codiagonals of {unob}.
    \protected \func codiagMap (n : Nat) : \Sigma (S : \Cat0) (S ->⁺ DI) \elim n
      | 0 => (Ob DI, unob)
      | suc n => (CatPushout (codiagMap n).2 (codiagMap n).2, codiag (codiagMap n).2)

    -- | Right maps of this family are exactly the maps whose hom-types are `(n-1)`-types.
    \protected \func family (n : Nat) : CatFactor.Family \cowith
      | J => \Sigma
      | X _ => (codiagMap (suc n)).1
      | Y _ => DI
      | F _ => (codiagMap (suc n)).2

    \lemma right1-char {C : \Cat} : IsOrthogonal ((family n).F ()) (\lam (c :⁺ C) => ()) <-> IsTruncCat n C
      => <->trans IsOrthogonal-terminal $ later
           (\lam o x y => HLevel_-2+1=>HLevel_-1 (x ~> y) n $ (truncMap-unob {C} {suc n}).1 $
                            (truncMap-codiagMap (suc n) {0}).1 $ IsEquiv=>contrFibers o,
            \lam Ct => contrFibers=>IsEquiv $ (truncMap-codiagMap (suc n) {0}).2 $
                            truncMap-unob.2 \lam {a} {b} => HLevel_-1=>HLevel_-2+1 (a ~> b) n (Ct _ _))
      \where {
        -- | Restriction of maps along {f}.
        \private \func res {A B E : \Cat} (f : A ->⁺ B) (h : Ob (B ->⁺ E)) : Ob (A ->⁺ E)
          => ob (\lam x => unob h (f x))

        -- | Fibers of restriction along {unob} are hom-types.
        \private \lemma truncMap-unob {E : \Cat} {k : Nat}
          : IsTruncMap k (res {Ob DI} unob) <-> (\Pi {a b : E} -> (a ~> b) ofHLevel_-2+ k)
          => <->sym (IsTruncMap.truncMap-post {Ob (DI ->⁺ E)} {_} {_} {res unob} ObDI-equiv)
            `<->trans` IsTruncMap.truncMap-pre DI-equiv
            `<->trans` IsTruncMap.truncMap-proj {\Sigma E E} {\lam j => j.1 ~> j.2} {k}
            `<->trans` (\lam r {a} {b} => r (a,b), \lam r s => r)

      \private \lemma truncMap-codiagMap {E : \Cat} (m : Nat) {j : Nat}
        : IsTruncMap j (res {_} {_} {E} (codiagMap m).2) <-> IsTruncMap (j Nat.+ m) (res {Ob DI} {DI} {E} unob) \elim m
        | 0 => <->refl
        | suc m => <->trans truncMap-codiag (truncMap-codiagMap m)
        \where {
          -- | Maps out of the pushout of {f} along itself are pairs of maps with equal restrictions along {f}.
          \func codiag-maps {A B E : \Cat} (f : A ->⁺ B)
            : QEquiv {Ob (CatPushout f f ->⁺ E)} {\Sigma (u v : Ob (B ->⁺ E)) (res f u = res f v)}
            => transQEquiv (CatPushout.elim-equiv {A} {B} {B} {f} {f} {\lam _ => E}) $ later \new QEquiv {
              | f s => (ob s.1, ob s.2, path \lam i => ob (\lam x => s.3 x i))
              | ret t => (unob t.1, unob t.2, \lam x => path \lam i => unob (t.3 i) x)
              | ret_f s => idp
              | f_sec t => aux t.1 t.2 t.3
            }
            \where {
              \private \func aux (u v : Ob (B ->⁺ E)) (p : res f u = res f v)
                : (ob (unob u), ob (unob v), path \lam i => ob (\lam x => unob (p i) x)) = {\Sigma (u v : Ob (B ->⁺ E)) (res f u = res f v)} (u,v,p) \elim u, v
                | ob u, ob v => pmap {res f (ob u) = res f (ob v)} {\Sigma (u v : Ob (B ->⁺ E)) (res f u = res f v)} (\lam q => (ob u, ob v, q)) (unob_=.ret_f p)

              \func res-codiag (h : Ob (B ->⁺ E)) : codiag-maps f (res (codiag f) h) = diagonal (res f) h \elim h
                | ob h => idp
            }

          \lemma truncMap-codiag {A B E : \Cat} {f : A ->⁺ B} {k : Nat}
            : IsTruncMap k (res {_} {_} {E} (codiag f)) <-> IsTruncMap (suc k) (res {A} {B} {E} f)
            => \have p : (\lam h => codiag-maps f (res (codiag f) h)) = diagonal (res {A} {B} {E} f) => ext \lam h => codiag-maps.res-codiag h
               \in <->sym (transport (IsTruncMap k __ <-> _) p $ IsTruncMap.truncMap-post {_} {_} {_} {res {_} {_} {E} (codiag f)} (codiag-maps {A} {B} {E} f))
                    `<->trans` truncMap-diagonal `<->trans` <->sym IsTruncMap.truncMap-suc
        }
      }

    \lemma isTruncCat : IsTruncCat n (CatTrunc n C)
      => right1-char.1 $ IsOrthogonal_o-right {_} {_} {CatTrunc n C} {CatFactor {family n} (\lam _ => ())}
          (IsOrthogonal_IsHEquiv-right (inP \new HQEquiv {
            | finv x => x
            | finv_f => idpe
            | f_finv => idpe
          })) (catFactorRight.isRight {family n} ())
  }

-- | The unit of the n-truncation.
\func catTrunc {n : Nat} {C : \Cat} (x :⁺ C) : CatTrunc n C
  => catFactorLeft {CatTrunc.family n} x

\lemma catTrunc-univ {n : Nat} {C Z : \Cat} (Zt : IsTruncCat n Z)
  : IsEquiv {Ob (CatTrunc n C ->⁺ Z)} {Ob (C ->⁺ Z)} (\lam f => ob \lam x => unob f (catTrunc x))
  => IsOrthogonal-terminal.1 (catTrunc-isLeft Zt)
  \where {
    \sfunc lift (Zt : IsTruncCat n Z) (f : C ->⁺ Z) (x :⁺ CatTrunc n C) : Z
      => unob (IsEquiv.ret (catTrunc-univ {n} {C} Zt) (ob f)) x

    \sfunc lift_catTrunc {Zt : IsTruncCat n Z} {f : C ->⁺ Z} {x :⁺ C} : lift Zt f (catTrunc x) = f x
      => (\peval lift Zt f _) *> path \lam i => unob (IsEquiv.f_ret (catTrunc-univ {n} {C} Zt) i) x

    -- | {catTrunc} is left orthogonal to the map to the terminal category from any category with hom-types of level {n}.
    \lemma catTrunc-isLeft {n : Nat} {C E : \Cat} (Et : IsTruncCat n E) : IsOrthogonal (catTrunc {n} {C}) (\lam (e :⁺ E) => ())
      => IsOrthogonal_o-left {_} {_} {CatTrunc n C}
          (catFactorLeft.isLeft {CatTrunc.family n} \lam _ => (CatTrunc.right1-char {n}).2 Et)
          (IsOrthogonal_IsHEquiv-left $ inP \new HQEquiv {
            | f x => x
            | finv x => x
            | finv_f => idpe
            | f_finv => idpe
          })
  }

-- | Restriction along {catTrunc} to functors to a category with hom-types of level {n} is fully faithful.
\lemma catTrunc-ext-ff {n : Nat} {C Z : \Cat} (Zt : IsTruncCat n Z)
  : IsFFMap {CatTrunc n C ->⁺ Z} {C ->⁺ Z} (\lam H y => H (catTrunc y))
  => IsOrthogonal-res-ff (catTrunc-univ.catTrunc-isLeft Zt) (catTrunc-univ.catTrunc-isLeft (arr-IsTruncCat Zt))
  \where {
    -- | The arrow category of a category with hom-types of level {n} has hom-types of level {n}.
    \lemma arr-IsTruncCat {n : Nat} {Z : \Cat} (Zt : IsTruncCat n Z) : IsTruncCat n (DI ->⁺ Z)
      => \lam u v => HLevel-retracts DI-hom-equiv $
          HLevels-sigma (\lam l => \Sigma (r : u dright ~> v dright) (DPath (\lam i => u i ~> v i) l r)) (Zt _ _) \lam l =>
          HLevels-sigma (\lam r => DPath (\lam i => u i ~> v i) l r) (Zt _ _) \lam r =>
          HLevel-retracts (square-equiv {Z} {u dleft} {u dright} {v dleft} {v dright} {dpath (\lam i => u i)} {r} {l} {dpath (\lam i => v i)}) (HLevel_-1_suc (Zt _ _) _ _)
  }

-- | The action of {catTrunc} on arrows, factored through the truncation.
\func catTrunc-hom-map.{u} {n : Nat} {C : \Cat u} {x y : C} (t : Trunc_-1+ n (x ~> y)) : catTrunc x ~> catTrunc y
  => Trunc_-1+.rec (CatTrunc.isTruncCat (catTrunc x) (catTrunc y)) (dmap catTrunc) t
  \where {
    \open FullSubCat

    -- | The functor `y ↦ Trunc_-1+ n (x ~> y)`.
    \func codeB.{u} {C : \Cat u} (x : C) (y :⁺ C) : TypeCat.{u} n
      => (truncAdjunction n).ladj (ReprFunctor x y)

    -- | Its extension to `CatTrunc n C`.
    \func codeL.{u} {C : \Cat u} (x : C) (y :⁺ CatTrunc n C) : TypeCat.{u} n
      => catTrunc-univ.lift TypeCat_IsTruncCat (codeB x) y

    \func code.{u} {C : \Cat u} (x : C) (y :⁺ CatTrunc n C) : \Type u
      => inc (codeL x y)

    \lemma code-level.{u} {C : \Cat u} {x : C} {y : CatTrunc n C} : code x y ofHLevel_-1+ n
      => inc-con {_} {_} {codeL x y}

    \func code=codeB.{u} {C : \Cat u} {x : C} {y :⁺ C} : code x (catTrunc y) = inc (codeB x y)
      => pmap+ inc catTrunc-univ.lift_catTrunc

    \sfunc code-equiv.{u} {C : \Cat u} {x y : C} : QEquiv {code x (catTrunc y)} {Trunc_-1+ n (x ~> y)}
      => transportInv (QEquiv {__} {_}) code=codeB codeB-equiv
      \where {
        \sfunc codeB-equiv.{u} {C : \Cat u} {x y : C} : QEquiv {inc (codeB x y)} {Trunc_-1+ n (x ~> y)}
          => transQEquiv truncAdjunction.ladj-equiv \new QEquiv {
               | f => Trunc_-1+.rec (Trunc_-1+.level n (x ~> y)).isTruncated \lam r => inT (Straight.fromStraight r)
               | ret => Trunc_-1+.rec (Trunc_-1+.level n (ReprFunctor x y)).isTruncated \lam r => inT (Straight.toStraight r)
               | ret_f => Trunc_-1+.elim-eq (Trunc_-1+.level n (ReprFunctor x y)).isTruncated \lam r => pmap inT (Straight.toStraight_fromStraight r)
               | f_sec => Trunc_-1+.elim-eq (Trunc_-1+.level n (x ~> y)).isTruncated \lam r => idp
             }

        -- | {codeB-equiv} maps the class of an arrow to its image under the unit of the truncation adjunction.
        \sfunc codeB-equiv_inT.{u} {C : \Cat u} {x y : C} {r : x ~> y}
          : codeB-equiv.ret (inT r) = ~>_-> ((truncAdjunction n).heta (ReprFunctor x y)) (Straight.toStraight r)
          => pmap (\lam (e : QEquiv {inc (codeB x y)} {Trunc_-1+ n (x ~> y)}) => e.ret (inT r)) (\peval codeB-equiv {n} {C} {x} {y})

        -- | {code-equiv} is {codeB-equiv} transported along {code=codeB}.
        \sfunc code-equiv_ret.{u} {C : \Cat u} {x y : C} {t : Trunc_-1+ n (x ~> y)}
          : code-equiv.ret t = transport (\lam X => X) (inv (pmap inc catTrunc-univ.lift_catTrunc)) (codeB-equiv.ret t)
          => pmap (\lam (e : QEquiv {code x (catTrunc y)} {Trunc_-1+ n (x ~> y)}) => e.ret t) (\peval code-equiv {n} {C} {x} {y})
             *> aux {_} {inc (codeB x y)}
          \where
            \private \func aux.{v} {X Y : \Type v} {B : \Type} {q : X = Y} {e : QEquiv {Y} {B}} {b : B}
              : (transportInv (QEquiv {__} {B}) q e).ret b = transport (\lam X => X) (inv q) (e.ret b) \elim q
              | idp => idp
      }

    -- | The representable functor of `catTrunc x` as a functor to {TypeCat}.
    \sfunc ReprFunctorL.{u} {C : \Cat u} (x : C)
      : \Sigma (h : CatTrunc n C ->⁺ TypeCat n) (\Pi (t :⁺ CatTrunc n C) -> inc (h t) = ReprFunctor (catTrunc x) t)
      => isMax {_} {_} {_} {ReprFunctor (catTrunc x)} \lam t => HLevel-retracts ReprFunctor.equiv (CatTrunc.isTruncCat (catTrunc x) t)

    \sfunc decode.{u} {C : \Cat u} {x : C}
      : \Sigma (d : \Pi (s :⁺ \Sigma⁺ (y : CatTrunc n C) (code x y)) -> catTrunc x ~> s.1)
               (\Pi {y : C} (p : x ~> y) -> d (catTrunc y, code-equiv.ret (inT p)) = dmap catTrunc p)
      => \let | (h,hp) => ReprFunctorL x
              | ff => catTrunc-ext-ff {n} {C} {TypeCat n} TypeCat_IsTruncCat (\lam t => codeL x t) h
              | lc {y :⁺ C} => catTrunc-univ.lift_catTrunc {n} {C} {TypeCat n} {TypeCat_IsTruncCat} {codeB x} {y}
              -- The arrow from `y ↦ (x ~> y)` to `y ↦ (catTrunc x ~> catTrunc y)` given by {catTrunc}.
              | a : (\lam y => ReprFunctor x y) ~> {C ->⁺ \Type u} (\lam y => inc (h (catTrunc y)))
                  => depUnivalence.ret \lam s => transport+ (\lam X => X) (inv (hp (catTrunc s.1))) (Straight.toStraight (dmap catTrunc (Straight.fromStraight s.2)))
              | b0 : (\lam t => codeL x (catTrunc t)) ~> {C ->⁺ TypeCat n} (\lam t => h (catTrunc t))
                  => dpath \lam i y => comp (=_~> lc) ((truncAdjunction n).heta_heps-rl (dmap (__ y) a)) i
              | b => IsEquiv.ret ff b0
              | d (s :⁺ \Sigma⁺ (y : CatTrunc n C) (code x y)) : catTrunc x ~> s.1
                  => Straight.fromStraight (transport+ (\lam X => X) (hp s.1) (depUnivalence (dmap (\lam H t =>⁺ inc (H t)) b) s))
         \in (d, \lam {y} p => pmap (\lam z => Straight.fromStraight (transport+ (\lam X => X) (hp (catTrunc y)) z)) (
                pmap (\lam (r : (\lam t => codeL x (catTrunc t)) ~> {C ->⁺ TypeCat n} (\lam t => h (catTrunc t))) => ~>_-> (dmap (\lam H => inc (H y)) r) (code-equiv.ret (inT p))) (IsEquiv.f_ret ff {b0})
                *> pmap (~>_-> __ _) (dmap_comp inc) *> ~>_->_comp _ _
                *> pmap (~>_-> (dmap inc ((truncAdjunction n).heta_heps-rl (dmap (__ y) a)))) (pmap (~>_-> __ _) (dmap_=_~> inc) *> ~>_->_=_~> _ *> pmap (transport (\lam X => X) (pmap+ inc lc)) code-equiv.code-equiv_ret *> transport_id_inv (\lam X => X) _ _ *> code-equiv.codeB-equiv_inT)
                *> inv (~>_->_comp _ _) *> pmap (~>_-> __ _) ((truncAdjunction n).heta_heps-rlr {_} {_} {dmap (__ y) a}))
              *> pmap Straight.fromStraight (transport_id_inv (\lam X => X) _ _))

    \func encodeDecode.{u} {C : \Cat u} {x : C} : EncodeDecode.{u} (catTrunc {n} x) \cowith
      | code => code x
      | ce => code-equiv.ret (inT idd)
      | decode => decode.1
      | decode_base => decode.2 idd

    \lemma isEquiv.{u} {C : \Cat u} {x y : C} : IsEquiv (catTrunc-hom-map {n} {C} {x} {y})
      => \have ed => encodeDecode.decode-equiv {catTrunc y} $ unfold \lam c => rewriteI (code-equiv.ret_f c) $
                      Trunc_-1+.elim-eq code-level {\lam t => encodeDecode.encode (decode.1 (catTrunc y, code-equiv.ret t))} {code-equiv.ret}
                        (\lam p => pmap encodeDecode.encode (decode.2 p) *>
                          \let eta (y :⁺ C) => (truncAdjunction n).heta (ReprFunctor x y)
                          \in pmap (~>_-> (dmap (\lam y => code x (catTrunc y)) p)) code-equiv.code-equiv_ret
                              *> ~>_->-natural {_} {\lam y => inc (codeB x y)} (\lam y m => transport+ (\lam X => X) (inv code=codeB) m) p
                              *> pmap (transport (\lam X => X) (inv code=codeB)) (pmap (~>_-> (dmap (\lam y => inc (codeB x y)) p)) code-equiv.codeB-equiv_inT
                                  *> ~>_->-natural (\lam y a => ~>_-> (eta y) a) p
                                  *> pmap (~>_-> (eta _)) (pmap (\lam S => S (_, Straight.toStraight p)) (yonedaCov.ext-sec-unique x (\lam y => ReprFunctor x y) (\lam k => k.2)))
                                  *> inv code-equiv.codeB-equiv_inT)
                              *> inv code-equiv.code-equiv_ret)
                        (code-equiv c)
         \in transport IsEquiv
              (ext \lam t => Trunc_-1+.elim-eq {n} {_} {catTrunc x ~> catTrunc y} (CatTrunc.isTruncCat _ _) (\lam p => decode.2 p) t)
              (inP (transQEquiv (symQEquiv code-equiv) ed))
  }