\import Equiv
\import Equiv.Sigma
\import Function.Meta
\import InfCat.Arrows
\import InfCat.CatPushout
\import InfCat.Functor.Equiv
\import InfCat.Functor.Embedding
\import InfCat.Functor.FullyFaithful
\import InfCat.OFS.CatAccessibleOFS
\import InfCat.OFS.CatOFS
\import Logic
\import Logic.Meta
\import Paths

-- | The subcategory of {C} generated by the arrows satisfying {P}.
\type SubCat {C : \Cat} (P : (DI ->⁺ C) -> \Prop) : \Cat
  => CatFactor {_} {Arrows P} {C} evalArr
  \where {
    \protected \instance family : CatFactor.Family
      | J => \Sigma
      | X _ => CatPushout {Empty} {DI} {DI} absurd+ absurd+
      | Y _ => DI
      | F _ => codiag absurd+

    \protected \lemma family-emb {C D : \Cat} {f : C ->⁺ D} : family.IsRight f <-> IsEmbedding f
      => (\lam r => embedding-orthogonal.2 (r ()), \lam fe () => embedding-orthogonal.1 fe)
      \where {
        -- | A functor is an embedding if and only if it is right orthogonal to the fold map `DI ⊔ DI -> DI`.
        \lemma embedding-orthogonal {C D : \Cat} {f : C ->⁺ D} : IsEmbedding f <-> IsOrthogonal (codiag {Empty} {DI} absurd+) f
          => IsEmbedding.diag-equiv `<->trans` post-DI-equiv `<->trans` <->sym IsOrthogonal-fold

        -- | {f} is right orthogonal to the fold map `X ⊔ X -> X` if and only if postcomposition with its diagonal is an equivalence on functors from {X}.
        \lemma IsOrthogonal-fold {X C D : \Cat} {f : C ->⁺ D}
          : IsOrthogonal (codiag {Empty} {X} absurd+) f <-> IsEquiv {X ->⁺ C} {X ->⁺ \Sigma⁺ (x y : C) (f x = f y)} (\lam h x => IsEmbedding.diag f (h x))
          => \have p => IsEquiv.parallelEquiv {X ->⁺ C} {\Sigma (uv : \Sigma (CatPushout {Empty} {X} {X} absurd+ absurd+ ->⁺ C) (X ->⁺ D)) (\Pi (z :⁺ CatPushout {Empty} {X} {X} absurd+ absurd+) -> uv.2 (codiag absurd+ z) = f (uv.1 z))}
                           {_} {_} {\lam h => ((\lam z => h (codiag absurd+ z), \lam y => f (h y)), \lam z => idp)} {\lam (h : X ->⁺ C) (x :⁺ X) => IsEmbedding.diag f (h x)}
                           (inP idEquiv)
                           (IsEquiv.trans (inP IsOrthogonal-sections.squares-equiv) $
                            IsEquiv.trans (inP (sigma-right \lam (v : X ->⁺ D) => empty-pushout-equiv {X} {X} {\lam z =>⁺ \Sigma⁺ (c : C) (f c = v (codiag absurd+ z))}))
                                          (lifts-equiv f))
                           (\lam h => idp)
             \in (\lam o => propExt.dir p o, \lam e => propExt.conv p e)
          \where {
            -- | Two lifts of the same functor to {D} give a functor to the domain of the diagonal of {f}.
            \func lifts-map {X C D : \Cat} (f : C ->⁺ D)
                            (s : \Sigma (v : X ->⁺ D) (\Sigma (\Pi (x :⁺ X) -> \Sigma⁺ (c : C) (f c = v x)) (\Pi (x :⁺ X) -> \Sigma⁺ (c : C) (f c = v x))))
              : X ->⁺ \Sigma⁺ (x y : C) (f x = f y)
              => \lam x => ((s.2.1 x).1, (s.2.2 x).1, (s.2.1 x).2 *> inv (s.2.2 x).2)

            \func lifts-ret {X C D : \Cat} (f : C ->⁺ D) (k : X ->⁺ \Sigma⁺ (x y : C) (f x = f y))
              : \Sigma (v : X ->⁺ D) (\Sigma (\Pi (x :⁺ X) -> \Sigma⁺ (c : C) (f c = v x)) (\Pi (x :⁺ X) -> \Sigma⁺ (c : C) (f c = v x)))
              => (\lam x => f (k x).1, (\lam x => ((k x).1, idp), \lam x => ((k x).2, inv (k x).3)))

            \lemma lifts-equiv {X C D : \Cat} (f : C ->⁺ D) : IsEquiv (lifts-map {X} f)
              => inP \new QEquiv {
                | ret => lifts-ret f
                | ret_f s => contract f (\lam x => (s.2.1 x).1) (path \lam i x => (s.2.1 x).2 i) s.2.2
                | f_sec k => path \lam j x => ((k x).1, (k x).2, (idp_*> *> inv_inv {_} {_} {_} {(k x).3}) j)
              }

            \func contract {X C D : \Cat} (f : C ->⁺ D) (a : X ->⁺ C) {v : X ->⁺ D} (q : (\lam x =>⁺ f (a x)) = v)
                           (b : \Pi (x :⁺ X) -> \Sigma⁺ (c : C) (f c = v x))
              : lifts-ret f (lifts-map f (v, (\lam x => (a x, path \lam i => q i x), b))) = (v, (\lam x => (a x, path \lam i => q i x), b)) \elim q
              | idp => path \lam j => (\lam x => f (a x), (\lam x => (a x, idp), \lam x => ((b x).1, inv-cancel (b x).2 j)))

            \private \func inv-cancel {A :⁺ \Cat} {a a' :⁺ A} (p :⁺ a = a') : inv (idp *> inv p) = p \elim p
              | idp => idp
          }
      }

    -- | Arrows of {C} satisfying {P}, freely as a category.
    \data Arrows {C : \Cat} (P : (DI ->⁺ C) -> \Prop)
      | arr (h : DI ->⁺ C) (Ph : P h) (i :⁺ DI)

    \func evalArr {C : \Cat} {P : (DI ->⁺ C) -> \Prop} (a :⁺ Arrows P) : C \elim a
      | arr h _ i => h i

    \func inc (d :⁺ SubCat P) : C
      => catFactorRight d

    \func make (h : DI ->⁺ C) (Ph : P h) (i :⁺ DI) : SubCat P
      => catFactorLeft {_} {Arrows P} (arr h Ph i)

    \lemma inc-sat {h : DI ->⁺ C} (Ph : P h) : ∃ (k : DI ->⁺ SubCat P) (\Pi (i :⁺ DI) -> inc (k i) = h i)
      => inP (make h Ph, \lam i => idp)

    \lemma inc-emb : IsEmbedding inc
      => family-emb.1 \lam p => IsOrthogonal_o-right (IsOrthogonal_IsHEquiv-right $
          inP \new HQEquiv {SubCat P} {CatFactor evalArr} {
            | f d => d
            | finv d => d
            | finv_f d => idp
            | f_finv d => idp
          }) (catFactorRight.isRight p)

    -- | If {P} contains identities, then the subcategory is wide.
    \lemma inc-surj (Pid : \Pi (x : C) -> P (idd {C} {x})) : IsSurjMap inc
      => \lam y => inP (make (\lam _ => y) (Pid y) dleft, idp)

    -- | The subcategory is contained in every subcategory containing the arrows satisfying {P}.
    \sfunc isMin {E : \Cat} {f : E ->⁺ C} (fe : IsEmbedding f)
                 (fs : \Pi {h : DI ->⁺ C} -> P h -> ∃ (k : DI ->⁺ E) (\Pi (i :⁺ DI) -> f (k i) = h i))
      : \Sigma (g : SubCat P ->⁺ E) (\Pi (x :⁺ SubCat P) -> f (g x) = inc x)
      => \have l => catFactorRight.lift (arrLift fe fs) (family-emb.2 fe) (arrLift-eq fe fs)
         \in (\lam d =>⁺ (l d).1, \lam d => (l d).2)
      \where {
        \lemma lift {E : \Cat} {f : E ->⁺ C} (fe : IsEmbedding f)
                    (fs : \Pi {h : DI ->⁺ C} -> P h -> ∃ (k : DI ->⁺ E) (\Pi (i :⁺ DI) -> f (k i) = h i))
                    {h : DI ->⁺ C} (Ph : P h) : \Sigma (k : DI ->⁺ E) (\Pi (i :⁺ DI) -> f (k i) = h i)
          => TruncP.remove (IsEmbedding.lift-isProp fe h) (fs Ph)

        \func arrLift {E : \Cat} {f : E ->⁺ C} (fe : IsEmbedding f)
                      (fs : \Pi {h : DI ->⁺ C} -> P h -> ∃ (k : DI ->⁺ E) (\Pi (i :⁺ DI) -> f (k i) = h i))
                      (a :⁺ Arrows P) : E \elim a
          | arr h Ph i => (lift fe fs Ph).1 i

        \func arrLift-eq {E : \Cat} {f : E ->⁺ C} (fe : IsEmbedding f)
                         (fs : \Pi {h : DI ->⁺ C} -> P h -> ∃ (k : DI ->⁺ E) (\Pi (i :⁺ DI) -> f (k i) = h i))
                         (a :⁺ Arrows P) : f (arrLift fe fs a) = evalArr a \elim a
          | arr h Ph i => (lift fe fs Ph).2 i
      }

    -- | A functor whose arrows satisfy {P} factors through the subcategory.
    \sfunc isMax {E : \Cat} {g : E ->⁺ C} (gP : \Pi (k : DI ->⁺ E) -> P (\lam i => g (k i)))
      : \Sigma (h : E ->⁺ SubCat P) (\Pi (y :⁺ E) -> inc (h y) = g y)
      => embedding-lift inc-emb g \lam k => inc-sat (gP k)
  }
