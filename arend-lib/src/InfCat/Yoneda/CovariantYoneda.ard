\import Equiv
\import Equiv.Sigma
\import Function.Meta
\import InfCat.Basics
\import InfCat.Fibration.DirectedUnivalence
\import InfCat.Fibration.LeftFib
\import InfCat.Fibration.Straightening
\import InfCat.Paths
\import InfCat.Rezk
\import Logic
\import Logic.Unique
\import Paths
\import Paths.Meta

-- | The canonical arrow from the initial object `(x, idd)` of the coslice under {x}.
\func coslice-arrow {C : \Cat} {x : C} (k :⁺ \Sigma⁺ (y : C) (x ~> y)) : (x, idd) ~> {\Sigma⁺ (y : C) (x ~> y)} k
  => dpath \lam i => (k.2 i, conn-right k.2 i)
  \where {
    \sfunc idd-path {C : \Cat} {x : C} : coslice-arrow {C} {x} (x, idd) = idd
      => pmap {\Sigma (a : x ~> x) (DPath (\lam i => x ~> a i) idd idd)} {(x, idd) ~> {\Sigma⁺ (y : C) (x ~> y)} (x, idd)}
              (\lam p => dpath \lam i => (p.1 i, p.2 i))
              (isContr=>isProp (segal-contr.conn idd) (idd, conn-right idd) (idd, dpath \lam _ => idd))
  }

-- | Sections of a family of types over the coslice under {x} are determined by their value at `(x, idd)`.
\func coslice-yoneda.{u} {C : \Cat} (x : C) (G : \Sigma⁺ (y : C) (x ~> y) ->⁺ \Type u)
  : QEquiv {\Pi (k :⁺ \Sigma⁺ (y : C) (x ~> y)) -> G k} {G (x, idd)} \cowith
  | f M => M (x, idd)
  | ret b k => coe+ (\lam i => G (coslice-arrow k i)) b dright
  | ret_f M => ext \lam k => coe+-dpath (dpath \lam i => M (coslice-arrow k i))
  | f_sec b => pmap (\lam p => ~>_-> (dmap G p) b) coslice-arrow.idd-path *> ~>_->_idd

-- | The Yoneda lemma: natural transformations from the representable functor of {x} to {F} are elements of `F x`.
\lemma yonedaCov.{u} {C : \Cat u} (x : C) (F : C ->⁺ \Type u) : IsEquiv {ReprFunctor x ~> F} {F x} fun
  => inP (depUnivalence `transQEquiv` Sec-equiv x F)
  \where {
    \protected \func fun (p : ReprFunctor x ~> F) : F x
      => ~>_-> (dmap (\lam H => H x) p) (Straight.toStraight idd)

    -- | Sections over the total category of the representable functor.
    \protected \func Sec.{u} {C : \Cat u} (x : C) (F : C ->⁺ \Type u)
      => \Pi (k :⁺ \Sigma⁺ (y : C) (ReprFunctor x y)) -> F k.1

    -- | Sections over the total category of the representable functor are sections over the coslice.
    \func Sec-reindex.{u} {C : \Cat u} (x : C) (F : C ->⁺ \Type u)
      : QEquiv {Sec x F} {\Pi (k :⁺ \Sigma⁺ (y : C) (x ~> y)) -> F k.1} \cowith
      | f S k => S (k.1, Straight.toStraight k.2)
      | ret T k => T (k.1, Straight.fromStraight k.2)
      | ret_f S => path \lam j k => S (k.1, Straight.toStraight_fromStraight k.2 j)
      | f_sec T => idp

    \func Sec-equiv.{u} {C : \Cat u} (x : C) (F : C ->⁺ \Type u) : QEquiv {Sec x F} {F x}
      => Sec-reindex x F `transQEquiv` coslice-yoneda x (\lam k => F k.1)
  }

-- | Transporting the identity in the representable functor along {r} gives {r}.
\sfunc ReprFunctor-transport-idd.{u} {C : \Cat u} {x w : C} (r : x ~> w)
  : ~>_-> (dmap (ReprFunctor x) r) (Straight.toStraight idd) = Straight.toStraight r
  => pmap (\lam S => S (w, Straight.toStraight r)) ((yonedaCov.Sec-equiv x (ReprFunctor x)).ret_f (\lam k => k.2))

-- | Transport in the representable functor is postcomposition.
\sfunc ReprFunctor-transport.{u} {C : \Cat u} {x y z : C} {q : x ~> y} {p : y ~> z}
  : ~>_-> (dmap (ReprFunctor x) p) (Straight.toStraight q) = Straight.toStraight (comp q p)
  => pmap (~>_-> (dmap (ReprFunctor x) p)) (inv (ReprFunctor-transport-idd q)) *> inv (~>_->_comp _ _)
      *> pmap (~>_-> __ _) (inv (dmap_comp (ReprFunctor x))) *> ReprFunctor-transport-idd (comp q p)

-- | Components of a natural transformation out of a representable functor are determined by its value at the identity.
\sfunc yonedaCov-component.{u} {C : \Cat u} {x w : C} {G : C ->⁺ \Type u} {q : ReprFunctor x ~> G} {r : x ~> w}
  : ~>_-> (dmap G r) (yonedaCov.fun q) = ~>_-> (dmap (\lam H => H w) q) (Straight.toStraight r)
  => ~>_->-natural (\lam z b => ~>_-> (dmap (\lam H => H z) q) b) r
     *> pmap (~>_-> (dmap (\lam H => H w) q)) (ReprFunctor-transport-idd r)

-- | The Yoneda equivalence is natural in the functor.
\sfunc yonedaCov-natural.{u} {C : \Cat u} {x : C} {F G : C ->⁺ \Type u} {a : ReprFunctor x ~> F} {g : F ~> G}
  : yonedaCov.fun (comp a g) = ~>_-> (dmap (\lam H => H x) g) (yonedaCov.fun a)
  => pmap+ (~>_-> __ _) (dmap_comp (\lam (H : C ->⁺ \Type u) => H x) {_} {_} {_} {a} {g}) *> ~>_->_comp _ _

\lemma yonedaEmbCov.{u} {C : \Cat u} {x y : C} : IsEquiv {ReprFunctor y ~> ReprFunctor x} {x ~> y} fun
  => IsEquiv.trans (yonedaCov y (ReprFunctor x)) (inP ReprFunctor.equiv)
  \where {
    \protected \func fun {x y : C} (p : ReprFunctor y ~> ReprFunctor x) : x ~> y
      => Straight.fromStraight (yonedaCov.fun p)

    \sfunc fun_idd {x : C} : fun {C} {x} idd = idd
      => pmap Straight.fromStraight ~>_->_idd
      \where {
        \protected \sfunc conv {x : C} {p : ReprFunctor x ~> ReprFunctor x} (q : fun p = idd) : p = idd
          => IsEquiv.isInj yonedaEmbCov (q *> inv fun_idd)
      }

    \sfunc fun_comp {x y z : C} {p : ReprFunctor z ~> ReprFunctor y} {q : ReprFunctor y ~> ReprFunctor x}
      : fun (comp p q) = comp (fun q) (fun p)
      => pmap Straight.fromStraight $ yonedaCov-natural
          *> pmap (~>_-> (dmap (\lam H => H z) q)) (inv (ReprFunctor.equiv.ret_f _))
          *> inv yonedaCov-component
          *> pmap (~>_-> (dmap (ReprFunctor x) (yonedaEmbCov.fun p))) (inv (ReprFunctor.equiv.ret_f _))
          *> ReprFunctor-transport

    \lemma isIso {x y : C} {p : ReprFunctor y ~> ReprFunctor x} (e : IsIso p) : IsIso (fun p)
      \elim e
      | inP (q,qp=id,pq=id) => inP (fun q, inv fun_comp *> pmap fun pq=id *> fun_idd, inv fun_comp *> pmap fun qp=id *> fun_idd)

    \lemma isConservative {p : ReprFunctor y ~> ReprFunctor x} (e : IsIso (fun p)) : IsIso p
      => \case IsIso-char.1 e \with {
        | inP (r,q) => \case \elim y, \elim r, \elim p, \elim q \with {
          | _, idp, p, q => transportInv IsIso (fun_idd.conv (inv q)) idd-iso
        }
      }
  }

\lemma ReprFunctor-embedding.{u} {C : \Cat u} : Embedding (ReprFunctor {C}) \cowith
  | isEmb x y =>
    \let | g {y : C} (q : ReprFunctor x = ReprFunctor y) => IsEquiv.ret =-char (yonedaEmbCov.fun (=_~> (inv q)), yonedaEmbCov.isIso (=_~>-iso (inv q)))
         | ge : IsEquiv g => IsEquiv.trans
                  (IsEquiv.trans (IsEquiv.trans (inP inv-equiv) =-char)
                                 (subtype-equiv yonedaEmbCov yonedaEmbCov.isIso yonedaEmbCov.isConservative))
                  (IsEquiv.ret-equiv =-char)
         | gp {y : C} {p : x = y} : g (pmap ReprFunctor p) = p => \case \elim y, \elim p \with {
           | _, idp => pmap (IsEquiv.ret =-char) (ext yonedaEmbCov.fun_idd) *> IsEquiv.ret_f =-char
         }
    \in \new Retraction {
      | sec => g
      | f_sec q => IsEquiv.isInj ge gp
    }