\import Equiv
\import Equiv.Fiber
\import Equiv.Sigma
\import Function
\import Function.Meta
\import Homotopy.Fibration
\import InfCat.Basics
\import InfCat.Functor.Equiv
\import InfCat.Functor.FullyFaithful
\import InfCat.Objects
\import Logic
\import Logic.Unique
\import Meta
\import Paths
\import Paths.Meta

\func ObDI-elim {B : Ob DI ->⁺ \Cat} (x :⁺ B (ob dleft)) (y :⁺ B (ob dright)) (d :⁺ Ob DI) : B d \elim d
  | ob dleft => x
  | ob dright => y

\func DI-equiv {C : \Cat} : QEquiv {DI ->⁺ C} {\Sigma (j : \Sigma C C) (j.1 ~> j.2)} \cowith
  | f h => ((h dleft, h dright), dpath h)
  | ret s => \lam i => s.2 i
  | ret_f => idpe
  | f_sec => idpe

\func DI-fun-equiv {X C : \Cat} : QEquiv {X ->⁺ DI ->⁺ C} {\Sigma (j : \Sigma (X ->⁺ C) (X ->⁺ C)) (j.1 ~> j.2)} \cowith
  | f o => ((\lam a => o a dleft, \lam a => o a dright), dpath \lam i a => o a i)
  | ret s => \lam a i => s.2 i a
  | ret_f => idpe
  | f_sec => idpe

\func ObDI-equiv {C : \Cat} : QEquiv {Ob DI ->⁺ C} {\Sigma C C} \cowith
  | f h => (h (ob dleft), h (ob dright))
  | ret j => ObDI-elim j.1 j.2
  | ret_f h => ext (ObDI-elim idp idp)
  | f_sec => idpe

\func ObDI-depEquiv {C : Ob DI ->⁺ \Type} : QEquiv {\Pi (d :⁺ Ob DI) -> C d} {\Sigma (C (ob dleft)) (C (ob dright))} \cowith
  | f u => (u (ob dleft), u (ob dright))
  | ret s => ObDI-elim s.1 s.2
  | ret_f u => ext (ObDI-elim idp idp)
  | f_sec => idpe

-- | A morphism in the arrow category is a commutative square.
\func DI-hom-equiv {D : \Cat} {u v : DI ->⁺ D}
  : QEquiv {u ~> v} {\Sigma (l : u dleft ~> v dleft) (\Sigma (r : u dright ~> v dright) (DPath (\lam i => u i ~> v i) l r))} \cowith
  | f t => (dpath \lam j => t j dleft, (dpath \lam j => t j dright, dpath \lam i => dpath \lam j => t j i))
  | ret s => dpath \lam i j => s.2.2 j i
  | ret_f t => idp
  | f_sec s => idp

-- | The diagonal map into the arrow category is fully faithful.
\lemma diag-ff {C : \Cat} : IsFFMap {C} {DI ->⁺ C} (\lam c _ => c)
  => \lam a b => IsEquiv.leftFactor
        (inP $ DI-hom-equiv {C} `transQEquiv` contr-right \lam p => Contr.Contr_QEquiv (sigma-right \lam q => =_~>-equiv {_} {p} {q}) (lsigma p))
        (inP idEquiv)

-- | The diagonal map into the fiberwise arrow category of a family is fully faithful.
\lemma diag-rel-ff {C : \Cat} {G : C ->⁺ \Cat} : IsFFMap {\Sigma⁺ (x : C) (G x)} {\Sigma⁺ (x : C) (DI ->⁺ G x)} (\lam s => (s.1, \lam _ => s.2))
  => \lam s t => IsEquiv.leftFactor
        (inP $ dpath-sigma-equiv (\lam _ x => DI ->⁺ G x) `transQEquiv`
               sigma-right (\lam r => DI-dhom-equiv r `transQEquiv`
                 contr-right \lam l => Contr.Contr_QEquiv (sigma-right \lam l' => =_~>-equiv {_} {l} {l'}) (lsigma l)) `transQEquiv`
               symQEquiv (dpath-sigma-equiv (\lam _ x => G x)))
        (inP idEquiv)
  \where {
    -- | A morphism in the arrow category of a family over {r} is a commutative square over {r}.
    \private \func DI-dhom-equiv {D : \Cat} {G : D ->⁺ \Cat} {x y : D} (r : x ~> y) {u : DI ->⁺ G x} {v : DI ->⁺ G y}
      : QEquiv {DPath (\lam i => DI ->⁺ G (r i)) u v}
               {\Sigma (l : DPath (\lam j => G (r j)) (u dleft) (v dleft))
                       (\Sigma (l' : DPath (\lam j => G (r j)) (u dright) (v dright)) (DPath (\lam i => DPath (\lam j => G (r j)) (u i) (v i)) l l'))} \cowith
      | f t => (dpath \lam j => t j dleft, (dpath \lam j => t j dright, dpath \lam i => dpath \lam j => t j i))
      | ret s => dpath \lam j i => s.2.2 i j
      | ret_f t => idp
      | f_sec s => idp
  }

-- | A functor is an equivalence if and only if postcomposition with it is an equivalence on arrows.
\lemma post-DI-equiv {A B : \Cat} {g : A ->⁺ B} : IsHEquiv g <-> IsEquiv {DI ->⁺ A} {DI ->⁺ B} (\lam h i => g (h i))
  => (\lam (inP e) => inP \new QEquiv {
        | ret k => \lam i => e.finv (k i)
        | ret_f h => ext \lam i => e.finv_f (h i)
        | f_sec k => ext \lam i => e.f_finv (k i)
      },
      \lam pe => \have oe => ob-equiv {A} {B} {g} pe
                 \in (ff-surj-equiv {A} {B} {g}).1
                      (\lam x y => fiberwiseEquiv (pair-equiv oe) {\lam j => j.1 ~> j.2} {\lam j => j.1 ~> j.2} (\lam j p => dmap g p) (total-equiv {A} {B} {g} pe) (x,y),
                       \lam y => inP (IsEquiv.ret oe y, IsEquiv.f_ret oe)))
  \where {
    -- | Objects of {A} are a retract of arrows of {A}.
    \lemma ob-equiv {A B : \Cat} {g : A ->⁺ B} (pe : IsEquiv {DI ->⁺ A} {DI ->⁺ B} (\lam h i => g (h i))) : IsEquiv (\lam x => g x)
      => IsEquiv.retract pe (\lam x _ => x) (\lam h => h dleft) (\lam _ => idp) (\lam y _ => y) (\lam k => k dleft) (\lam _ => idp) (\lam _ => idp) (\lam _ => idp)

    -- | Postcomposition on arrows is the total map of {g} on homs.
    \lemma total-equiv {A B : \Cat} {g : A ->⁺ B} (pe : IsEquiv {DI ->⁺ A} {DI ->⁺ B} (\lam h i => g (h i)))
      : IsEquiv {\Sigma (j : \Sigma A A) (j.1 ~> j.2)} {\Sigma (j : \Sigma B B) (j.1 ~> j.2)} (\lam s => ((g s.1.1, g s.1.2), dmap g s.2))
      => propExt.dir (IsEquiv.parallelEquiv (inP DI-equiv) (inP DI-equiv) (\lam h => idp)) pe
  }

-- | Arrows from a constant functor to {Y} are determined by their source component.
\lemma const-ev0-equiv {C : \Cat} (a : C) (Y : DI ->⁺ C)
  : IsEquiv {(\lam _ =>⁺ a) ~> Y} {a ~> Y dleft} (dmap \lam (F : DI ->⁺ C) => F dleft)
  => IsEquiv.trans (inP $ later \new QEquiv {
        | f N => (dpath \lam l => N l dleft, (dpath \lam l => N l dright, dpath \lam k => dpath \lam l => N l k))
        | ret t => dpath \lam l k => t.2.2 k l
        | ret_f N => idp
        | f_sec t => idp
      })
      (inP $ contr-right \lam n0 => segal-contr.flipped n0 (dpath Y))

{- | The bottom face and the interior of a box with the shape of {fill3} are unique.
 -   The box is a square in the arrow category whose top-left corner is constant, and the source functor is fully faithful on such squares.
 -}
\lemma box-contr {C : \Cat} {a b d a' b' c' d' : C} (_ : \Sigma)
                 {ab : a ~> b} {bd : b ~> d} {ad : a ~> d}
                 {a'b' : a' ~> b'} {b'd' : b' ~> d'} {a'c' : a' ~> c'} {c'd' : c' ~> d'}
                 {aa' : a ~> a'} {bb' : b ~> b'} {ac' : a ~> c'} {dd' : d ~> d'}
                 (leftFace : DPath (\lam j => aa' j ~> ac' j) idd a'c')
                 (rightFace : DPath (\lam j => bb' j ~> dd' j) bd b'd')
                 (backFace : DPath (\lam i => ab i ~> ad i) idd bd)
                 (frontFace : DPath (\lam i => a'b' i ~> c'd' i) a'c' b'd')
                 (topFace : DPath (\lam i => ab i ~> a'b' i) aa' bb')
  : Contr (\Sigma (bot : DPath (\lam i => ad i ~> c'd' i) ac' dd')
                  (DPath (\lam i => DPath (\lam j => topFace i j ~> bot i j) (dpath \lam k => backFace i k) (dpath \lam k => frontFace i k)) leftFace rightFace))
  => Contr.Contr_QEquiv (proj-fib _ topFace) $ flip IsEquiv=>contrFibers topFace $ IsEquiv.rightFactor (inP $ later \new QEquiv {
         | f S => (dpath \lam i => dpath \lam j => S i j dleft, (dpath \lam i => dpath \lam j => S i j dright, dpath \lam i => dpath \lam j => dpath \lam k => S i j k))
         | ret t => dpath \lam i => dpath \lam j => t.2.2 i j
         | ret_f S => idp
         | f_sec t => idp
       }) (squares-at (\lam F => F dleft) (const-ev0-equiv a b'd') (dpath \lam i k =>⁺ backFace i k)
                      (dpath \lam j => rightFace j) (dpath \lam j => leftFace j) (dpath \lam i => frontFace i))