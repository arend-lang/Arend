\import Arith.Nat
\import Paths
\import Paths.Meta
\open Nat

-- File with unsolved goals of varying difficulty for proof search testing.
-- Each lemma has {?} goals that the proof search should attempt to fill.

-- Difficulty: trivial (idp)
\lemma goal-trivial : 0 = 0
  => {?}

-- Difficulty: easy (single rewrite)
\lemma goal-rewrite (x : Nat) (p : x = 0) : x = 0
  => {?}

-- Difficulty: easy (pmap)
\lemma goal-pmap (a b : Nat) (p : a = b) : suc a = suc b
  => {?}

-- Difficulty: medium (case split needed)
\lemma goal-case-split (n : Nat) : 0 + n = n \elim n
  | 0 => {?}
  | suc n => {?}

-- Difficulty: medium (rewrite with commutativity)
\lemma goal-comm-rewrite (a b : Nat) (p : a + b = 0) : b + a = 0
  => {?}

-- Difficulty: hard (needs transitivity / path composition)
\lemma goal-trans (x y z : Nat) (p : x = y) (q : y = z) : x = z
  => {?}

-- Multiple unsolved goals in one proof
\lemma goal-multi-step (a b : Nat) : a + suc b = suc (a + b)
  => {?}
