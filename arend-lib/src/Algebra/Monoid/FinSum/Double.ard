\import Paths.Meta
\import Set
\import Set.Fin
\import Set.Fin.Instances
\import Algebra.Monoid.Properties
\import Data.Fin

\lemma .BigSum-double-dep (AM : AbMonoid) {n : Nat} (m : Fin n -> Nat) (y : (\Sigma (i : Fin n) (Fin (m i))) -> AM)
  : BigSum (\lam i => BigSum (\lam j => y (i,j))) = BigSum (\lam k => y (SigmaFin.aux.f k)) \elim n
  | 0 => idp
  | suc n => pmap (_ +) (BigSum-double-dep (\lam i => m (suc i)) (\lam p => y (suc p.1, p.2))) *> inv (FinSum_Or *> pmap2 (+) FinSum=BigSum FinSum=BigSum) *> FinSum_Equiv fin-split {\lam k => y (\case k \with {| inl s => (0,s) | inr t => (suc (SigmaFin.aux.f t).1, (SigmaFin.aux.f t).2) })} *> FinSum=BigSum

\lemma .FinSum-double-dep (AM : AbMonoid) {A : FinSet} (B : A -> FinSet) {x : (\Sigma (a : A) (B a)) -> AM}
  : FinSum (\lam a => FinSum (\lam b => x (a,b))) = FinSum {_} {SigmaFin A B} x
  => \case FinSum_char _, FinSet.choice (\lam a => FinSum_char (\lam b => x (a,b))) \with {
    | inP p, inP f => p.2 *> cong (ext \lam j => (f _).2) *> BigSum-double-dep (\lam j => (B (p.1 j)).card) (\lam s => x (p.1 s.1, (f _).1 s.2)) *>
                        inv (FinSum_char2 (unfold $ =-to-QEquiv (pmap Fin $ FinSum_char2 {NatSemiring} p.1) `transQEquiv` SigmaFin.aux `transQEquiv` sigma-equiv p.1 (\lam j => (f _).1)) *> pmap BigSum (exts $ (FinSum_char2 {NatSemiring} p.1, \lam j => idp)))
  }

\lemma .FinSum-double-dep' (AM : AbMonoid) {A : FinSet} (B : A -> FinSet) {x : \Pi (a : A) -> B a -> AM}
  : FinSum (\lam a => FinSum (x a)) = FinSum {_} {SigmaFin A B} \lam s => x s.1 s.2
  => FinSum-double-dep B

\lemma .FinSum-double (AM : AbMonoid) {A B : FinSet} {x : A -> B -> AM}
  : FinSum (\lam a => FinSum (\lam b => x a b)) = FinSum (\lam (p : \Sigma A B) => x p.1 p.2)
  => FinSum-double-dep (\lam _ => B) *> pmap {FinSet (\Sigma A B)} (FinSum {_} {__} _) prop-pi

\lemma .FinSum-inj (AM : AbMonoid) {A B : FinSet} (f : A -> B) (inj : IsInj f) {x : B -> AM} (p : \Pi (b : B) -> (\Pi (a : A) -> f a /= b) -> x b = 0) : FinSum x = FinSum (\lam a => x (f a))
  => FinSum_Equiv (later equiv)
  *> FinSum_Or {_} {SigmaFin B \lam b => DecFin (decide {dec b})} {SigmaFin B \lam b => DecFin (decide {NotDecide (dec b)})}
  *> pmap2 (+) (FinSum_Equiv $ later $ equiv2 inj) (FinSum_zro $ later \lam j => p j.1 \lam a q => j.2 $ inP (a,q)) *> zro-right
  \where {
    \protected \lemma dec (b : B) : Decide (∃ (a : A) (f a = b))
      => \new Decide { | decide => FinSet.search (\lam a => f a = b) (\lam a => decideEq (f a) b) }

    \protected \func equiv : QEquiv {Or (Given (b : B) ∃ (a : A) (f a = b)) (Given (b : B) (Not (∃ (a : A) (f a = b))))} {B} \cowith
      | f => \case __ \with {
        | inl s => s.1
        | inr s => s.1
      }
      | ret b => \case decide {dec b} \with {
        | yes e => inl (b,e)
        | no q => inr (b,q)
      }
      | ret_f => \case \elim __ \with {
        | inl s => rewrite (dec_yes_reduce s.2) idp
        | inr s => rewrite (dec_no_reduce s.2) idp
      }
      | f_sec b => mcases {2} idp

    \protected \func equiv2 {A B : FinSet} {f : A -> B} (inj : IsInj f)
      => QEquiv.fromInjSurj {A} {\Sigma (b : B) (∃ (a : A) (f a = b))} {\lam a => (f a, inP (a,idp))}
          (\lam {a} {a'} q => inj $ pmap __.1 q)
          (\lam s => TruncP.map s.2 \lam t => (t.1, ext t.2))
  }

\lemma .FinSum-inj2 (AM : AbMonoid) {A B : FinSet} (f : A -> B) (inj : IsInj f) {x : B -> AM} (p : \Pi (b : B) -> (\Pi (a : A) -> f a /= b) -> x b = 0)
                   {y : A -> AM} (q : \Pi (a : A) -> x (f a) = y a) : FinSum x = FinSum y
  => FinSum-inj f inj p *> FinSum-ext q

\lemma .FinSum-distr (SR : Semiring) {A B : FinSet} {x : A -> SR} {y : B -> SR} : FinSum x * FinSum y = FinSum (\lam (s : \Sigma A B) => x s.1 * y s.2)
  => FinSum-rdistr *> path (\lam i => FinSum (\lam a => FinSum-ldistr {_} {_} {x a} i)) *> FinSum-double
