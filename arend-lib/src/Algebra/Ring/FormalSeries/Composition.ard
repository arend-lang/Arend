\import Algebra.Meta
\import Algebra.Group
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.Semiring
\import Algebra.Ring
\import Algebra.Ring.FormalSeries
\import Analysis.Series(Series)
\import Arith.Nat
\import Data.Or
\import Function
\import Logic
\import Meta
\import Order.LinearOrder
\import Order.PartialOrder
\import Paths
\import Paths.Meta
\import Set
\import Set.Fin
\import Set.Fin.Instances
\open Monoid(pow)
\open AddMonoid

{- | Composition coefficient: the coefficient of $x^k$ in $A(B(x))$, where
     $A(y) = \sum_n a_n y^n$ and $B(x) = \sum_m b_m x^m$.  Defined as
     $[x^k]\,A(B(x)) = \sum_{n=0}^{k} a_n \cdot (b ^{\star n})_k.$

     When $b_0 = 0$ the inner term vanishes for $n > k$ (see
     `pow-conv-zero-below`), so the sum is genuinely finite and the formal
     substitution is well-defined. -}
\func compose-coeff {A : Ring} (a b : Series A) (k : Nat) : A
  => AddMonoid.BigSum \new Array A (suc k) \lam n => a n * pow {FSeriesRing A} b n k

{- | Series-level composition: the formal power series $A \circ B$ whose
     $k$-th coefficient is `compose-coeff a b k`. -}
\func compose {A : Ring} (a b : Series A) : Series A => compose-coeff a b

{- | If $c_0 = 0$, then for any $j \leq k$, the inner sum
     $\sum_{m \leq j} f_m \cdot (c^{\star m})_j$ may be extended to range $m \leq k$
     without changing its value, because $(c^{\star m})_j = 0$ whenever $m > j$
     (`pow-conv-zero-below`).  This is the form used by `compose-coeff` when
     bridging triangular and rectangular finite sums. -}
\lemma compose-coeff-extend {A : Ring} {f c : Series A} (c_0 : c 0 = A.zro) (k j : Nat) (j<=k : j NatSemiring.<= k)
  : AddMonoid.BigSum (\new Array A (suc j) \lam (m : Fin (suc j)) => f m * pow {FSeriesRing A} c m j)
  = AddMonoid.BigSum (\new Array A (suc k) \lam (m : Fin (suc k)) => f m * pow {FSeriesRing A} c m j)
  => A.BigSum-subset
    {\new Array A (suc j) \lam (m : Fin (suc j)) =>
      f m * pow {FSeriesRing A} c m j}
    {\new Array A (suc k) \lam (m : Fin (suc k)) =>
      f m * pow {FSeriesRing A} c m j}
    (suc<=suc j<=k)
    (\lam (m : Fin (suc j)) => pmap (\lam (x : Nat) => f x * pow {FSeriesRing A} c x j) (inv toFin=id))
    (\lam (m : Fin (suc k)) sj<=m => pmap (f m *) (pow-conv-zero-below c_0 m j (suc_<=_< sj<=m)) *> A.zro_*-right)

{- | Multiplicativity of the `compose-coeff(_, c)` operation: in a commutative
     ring with $c_0 = 0$,
     $$[x^k]\,((A \cdot B) \circ c) = [x^k]\,((A \circ c) \cdot (B \circ c)).$$

     Combines `LHS-eq-M` and `RHS-eq-M` through the rectangular bridge.
     Commutativity of $A$ is used to move scalar factors across products
     inside the convolution sums; $c_0 = 0$ truncates the inner sums to finite range. -}
\lemma compose-coeff-* {A : CRing} {a b c : Series A} (c_0 : c 0 = A.zro) (k : Nat)
  : compose-coeff ((FSeriesRing A).* a b) c k
  = ((FSeriesRing A).* (compose a c) (compose b c)) k
  => LHS-eq-M {A} {a} {b} {c} c_0 k *> inv (RHS-eq-M {A} {a} {b} {c} c_0 k) \where {

  {- | The rectangular bridge form used in `compose-coeff-*`:
      $$M_k(a, b, c) := \sum_{p \leq k} \sum_{q \leq k} a_p \cdot b_q \cdot (c^{p + q})_k.$$
      Both `compose-coeff (a * b) c k` and `(\compose a c * \compose b c) k` reduce
      to this form (when $c_0 = 0$), which provides a symmetric "rectangle" that
      contains the triangular diagonal sum on one side and the doubled inner
      convolution on the other. -}
  \private \func M-form {A : Ring} (a b c : Series A) (k : Nat) : A
    => AddMonoid.BigSum (\new Array A (suc k) \lam (p : Fin (suc k)) =>
      AddMonoid.BigSum (\new Array A (suc k) \lam (q : Fin (suc k)) =>
        a p * b q * pow {FSeriesRing A} c ((p : Nat) + q) k))

  {- | Per-row reduction for `RHS-eq-M`: for each $i \in \mathrm{Fin}(k+1)$, the
  product `(compose-coeff a c i) * (compose-coeff b c (k -' i))` rewrites to
  the rectangular triple-sum row. -}
  \private \lemma RHS-row-eq {A : CRing} (a b c : Series A) (c_0 : c 0 = A.zro)
                             (k : Nat) (i : Fin (suc k))
    : compose-coeff a c i Ring.* compose-coeff b c (k -' (i : Nat))
      = AddMonoid.BigSum (\new Array A (suc k) \lam (p : Fin (suc k)) =>
      AddMonoid.BigSum (\new Array A (suc k) \lam (q : Fin (suc k)) =>
        a p * b q * pow {FSeriesRing A} c p i * pow {FSeriesRing A} c q (k -' (i : Nat))))
    => run {
      rewrite (compose-coeff-extend {A} {a} {c} c_0 k i (<_suc_<= (fin_< i))),
      rewrite (compose-coeff-extend {A} {b} {c} c_0 k (k -' (i : Nat)) -'<=id),
      rewrite (Semiring.BigSum-rdistr {A} {\new Array A (suc k) \lam (p : Fin (suc k)) => a p * pow {FSeriesRing A} c p i}),
      AddMonoid.BigSum-ext {A} {suc k} {\new Array A (suc k) \lam (p : Fin (suc k)) =>
        (a p * pow {FSeriesRing A} c p i) Ring.*
        AddMonoid.BigSum (\new Array A (suc k) \lam (q : Fin (suc k)) =>
          b q * pow {FSeriesRing A} c q (k -' (i : Nat)))}
      {\new Array A (suc k) \lam (p : Fin (suc k)) =>
        AddMonoid.BigSum (\new Array A (suc k) \lam (q : Fin (suc k)) =>
          a p * b q * pow {FSeriesRing A} c p i * pow {FSeriesRing A} c q (k -' (i : Nat))) },
      \lam p,
      rewrite (Semiring.BigSum-ldistr {A} {a p * pow {FSeriesRing A} c p i}
        {\new Array A (suc k) \lam (q : Fin (suc k)) => b q * pow {FSeriesRing A} c q (k -' (i : Nat))}),
      AddMonoid.BigSum-ext {A} {suc k}
      {\new Array A (suc k) \lam (q : Fin (suc k)) =>
        (a p * pow {FSeriesRing A} c p i) Ring.*
        (b q * pow {FSeriesRing A} c q (k -' (i : Nat)))}
      {\new Array A (suc k) \lam (q : Fin (suc k)) =>
        a p * b q * pow {FSeriesRing A} c p i * pow {FSeriesRing A} c q (k -' (i : Nat))},
      \lam q,
      equation.cRing
    }

  {- | Reduction of the right-hand side (the convolution of the two composed
  series) to the rectangular bridge form `M-form`.  Uses commutativity of `A`
  to move coefficients across products inside the convolution sums. -}
  \private \lemma RHS-eq-M {A : CRing} {a b c : Series A} (c_0 : c 0 = zro) (k : Nat)
    : ((FSeriesRing A).* (compose a c) (compose b c)) k = M-form a b c k
    => run {
      rewrite (conv-at-BigSum (compose a c) (compose b c) k),
      rewrite (AddMonoid.BigSum-ext {A} {suc k}
        {\new Array A (suc k) \lam (i : Fin (suc k)) =>
          compose-coeff a c i * compose-coeff b c (k -' (i : Nat))}
        {\new Array A (suc k) \lam (i : Fin (suc k)) =>
          AddMonoid.BigSum (\new Array A (suc k) \lam (p : Fin (suc k)) =>
            AddMonoid.BigSum (\new Array A (suc k) \lam (q : Fin (suc k)) =>
              a p * b q * pow {FSeriesRing A} c p i * pow {FSeriesRing A} c q (k -' (i : Nat))))}
        (\lam (i : Fin (suc k)) => RHS-row-eq a b c c_0 k i)),
      rewrite (A.BigSum-transpose {suc k} {suc k}
        (\lam (i : Fin (suc k)) (p : Fin (suc k)) =>
          AddMonoid.BigSum (\new Array A (suc k) \lam (q : Fin (suc k)) =>
            a p * b q * pow {FSeriesRing A} c p i * pow {FSeriesRing A} c q (k -' (i : Nat))))),
      AddMonoid.BigSum-ext {A} {suc k}
      {\new Array A (suc k) \lam (p : Fin (suc k)) =>
        AddMonoid.BigSum (\new Array A (suc k) \lam (i : Fin (suc k)) =>
          AddMonoid.BigSum (\new Array A (suc k) \lam (q : Fin (suc k)) =>
            a p * b q * pow {FSeriesRing A} c p i * pow {FSeriesRing A} c q (k -' (i : Nat))))}
      {\new Array A (suc k) \lam (p : Fin (suc k)) =>
        AddMonoid.BigSum (\new Array A (suc k) \lam (q : Fin (suc k)) =>
          a p * b q * pow {FSeriesRing A} c ((p : Nat) + q) k)},
      \lam p,
      rewrite (A.BigSum-transpose {suc k} {suc k}
        (\lam (i : Fin (suc k)) (q : Fin (suc k)) =>
          a p * b q * pow {FSeriesRing A} c p i * pow {FSeriesRing A} c q (k -' (i : Nat)))),
      AddMonoid.BigSum-ext {A} {suc k}
      {\new Array A (suc k) \lam (q : Fin (suc k)) =>
        AddMonoid.BigSum (\new Array A (suc k) \lam (i : Fin (suc k)) =>
          a p * b q * pow {FSeriesRing A} c p i * pow {FSeriesRing A} c q (k -' (i : Nat)))}
      {\new Array A (suc k) \lam (q : Fin (suc k)) =>
        a p * b q * pow {FSeriesRing A} c ((p : Nat) + q) k},
      \lam q,
      rewrite (AddMonoid.BigSum-ext {A} {suc k}
        {\new Array A (suc k) \lam (i : Fin (suc k)) =>
          a p * b q * pow {FSeriesRing A} c p i * pow {FSeriesRing A} c q (k -' (i : Nat))}
        {\new Array A (suc k) \lam (i : Fin (suc k)) =>
          (a p * b q) * (pow {FSeriesRing A} c p i * pow {FSeriesRing A} c q (k -' (i : Nat)))}
        (\lam (i : Fin (suc k)) => *-assoc)),
      rewriteI (A.BigSum-ldistr
        {a p * b q}
        {\new Array A (suc k) \lam (i : Fin (suc k)) =>
          pow {FSeriesRing A} c p i * pow {FSeriesRing A} c q (k -' (i : Nat))}),
      rewriteI (conv-at-BigSum (pow {FSeriesRing A} c p) (pow {FSeriesRing A} c q) k),
      rewriteI (fseries-apply (Monoid.pow_+ {FSeriesRing A} {c} {p} {q})),
      idp
    }

  -- | Triangle index type for LHS-eq-M: $\{(n, (p, q, p + q = n)) : n \in \mathrm{Fin}(k + 1)\}$.
  \private \func LHS-tri-idx (k : Nat) : \Set
    => \Sigma (n : Fin (suc k)) (FSeriesRing.PairsFinSet (n : Nat))

  \private \func LHS-tri-fin (k : Nat) : FinSet (LHS-tri-idx k)
    => SigmaFin (FinFin (suc k)) (\lam (n : Fin (suc k)) => FSeriesRing.PairsFinSet (n : Nat))

  -- | Rectangle index type for LHS-eq-M: $\mathrm{Fin}(k + 1) \times \mathrm{Fin}(k + 1)$.
  \private \func LHS-rect-idx (k : Nat) : \Set
    => \Sigma (Fin (suc k)) (Fin (suc k))

  \private \lemma LHS-s1-bound {k : Nat} (x : LHS-tri-idx k) : (x.2.1 : Nat) NatSemiring.< suc k
    => <=_<_suc (NatSemiring.<=_+ <=-refl zero<=_ <=∘ =_<= x.2.3 <=∘ <_suc_<= (fin_< x.1))

  \private \lemma LHS-s2-bound {k : Nat} (x : LHS-tri-idx k) : (x.2.2 : Nat) NatSemiring.< suc k
    => <=_<_suc (NatSemiring.<=_+ zero<=_ <=-refl <=∘ =_<= x.2.3 <=∘ <_suc_<= (fin_< x.1))

  -- | Injection from the triangle into the rectangle: $(n, (p, q, p+q=n)) \mapsto (p, q)$.
  \private \func LHS-f {k : Nat} (x : LHS-tri-idx k) : LHS-rect-idx k
    => (toFin x.2.1 (LHS-s1-bound x), toFin x.2.2 (LHS-s2-bound x))

  -- | Injectivity of `LHS-f`.
  \private \lemma LHS-f-isInj {k : Nat} : IsInj (LHS-f {k})
    => \lam {x} {y} p => \case \elim x, \elim y, p \with {
      | (n, (i, j, p_ij)), (n', (i', j', p_ij')), q =>
        \let | qi : i = i' =>
          inv toFin=id *> pmap (\lam (z : Fin (suc k)) => (z : Nat)) (pmap __.1 q) *> toFin=id
             | qj : j = j' =>
               inv toFin=id *> pmap (\lam (z : Fin (suc k)) => (z : Nat)) (pmap __.2 q) *> toFin=id
        \in \case \elim i', \elim j', \elim p_ij', qi, qj \with {
          | _, _, p_ij'_after, idp, idp =>
            \let | n-eq : n = {Nat} n' => fin_nat-inj (inv p_ij *> p_ij'_after)
            \in \case \elim n', \elim p_ij'_after, n-eq \with {
              | _, p_ij'_final, idp =>
                path (\lam (idx : I) => (n, (i, j, (prop-pi : p_ij = p_ij'_final) @ idx)))
            }
        }
    }

  -- | Vanishing condition for `LHS-f`: outside the image (where $p + q > k$),
  --   $(c^{p + q})_k = 0$ by `pow-conv-zero-below`.
  \private \lemma LHS-y-vanishes {A : CRing} {a b c : Series A} (c_0 : c 0 = A.zro) {k : Nat}
                                 (q : LHS-rect-idx k)
                                 (no-pre : \Pi (x : LHS-tri-idx k) -> LHS-f x /= q)
    : a q.1 * b q.2 * pow {FSeriesRing A} c ((q.1 : Nat) + q.2) k = A.zro
    => \have sum-too-big : k NatSemiring.< (q.1 : Nat) + q.2
    => \case LinearOrder.dec<_<= k ((q.1 : Nat) + q.2) \with {
        | inl k<sum => k<sum
        | inr sum<=k =>
          \let | sum<sk : (q.1 : Nat) + q.2 NatSemiring.< suc k => <=_<_suc sum<=k
               | n-fin : Fin (suc k) => toFin ((q.1 : Nat) + q.2) sum<sk
               | preimage : LHS-tri-idx k =>
                 (n-fin, ((q.1 : Nat), (q.2 : Nat), inv toFin=id))
               | preimg-eq : LHS-f preimage = q =>
                 ext (fin_nat-inj toFin=id, fin_nat-inj toFin=id)
          \in absurd (no-pre preimage preimg-eq)
      }
       \in pmap ((a q.1 Ring.* b q.2) Ring.*)
        (pow-conv-zero-below c_0 ((q.1 : Nat) + q.2) k sum-too-big)
        *> A.zro_*-right

  {- | Reduction of the left-hand side `compose-coeff (a * b) c k` to the
  rectangular bridge form `M-form`.

  Proof sketch: the LHS unfolds to a diagonal double sum
  $\sum_{n \leq k} \sum_{(p, q): p + q = n} a_p \cdot b_q \cdot (c^n)_k$ (where
  the inner sum is `(a * b)_n` in `FSeriesRing` form).  Reindex
  $(n, (p, q)) \mapsto (p, q)$ via `FinSum-inj` (the map embeds the triangle
  into the rectangle).  The "out-of-triangle" terms have $(c^{p + q})_k = 0$
  by `pow-conv-zero-below` (using $c_0 = 0$).  We use `rewrite (toFin=id, ...)`
  to bridge the `Fin` and `Nat` views of the rectangle indices after applying
  `inv FinSum-inj`. -}
  \private \lemma LHS-eq-M {A : CRing} {a b c : Series A} (c_0 : c 0 = zro) (k : Nat)
    : compose-coeff ((FSeriesRing A).* a b) c k = M-form a b c k
    => AddMonoid.BigSum-ext {A} {suc k}
      {\new Array A (suc k) \lam (n : Fin (suc k)) =>
        ((FSeriesRing A).* a b) n * pow {FSeriesRing A} c n k}
      {\new Array A (suc k) \lam (n : Fin (suc k)) =>
        A.FinSum {FSeriesRing.PairsFinSet (n : Nat)}
          (\lam (s : \Sigma (i j : Nat) (\property i + j = (n : Nat))) =>
            a s.1 * b s.2 * pow {FSeriesRing A} c ((s.1 : Nat) + s.2) k)}
      (\lam (n : Fin (suc k)) => Semiring.FinSum-rdistr *> AbMonoid.FinSum-ext
                                                             (\lam (s : \Sigma (i j : Nat) (\property i + j = (n : Nat))) =>
                                                               pmap (\lam (m : Nat) => a s.1 * b s.2 * pow {FSeriesRing A} c m k) (inv s.3)))
      *> inv (A.FinSum=BigSum {suc k})
           *> AbMonoid.FinSum-double-dep
                (\lam (n : Fin (suc k)) => FSeriesRing.PairsFinSet (n : Nat))
                *> AbMonoid.FinSum-ext {A} {LHS-tri-fin k}
                     (\lam (x : LHS-tri-idx k) =>
                       unfold LHS-f
                         (pmap2 (\lam (p q : Nat) =>
                           a p * b q * pow {FSeriesRing A} c (p + q) k)
                           (inv (toFin=id {x.2.1} {suc k} {LHS-s1-bound x}))
                           (inv (toFin=id {x.2.2} {suc k} {LHS-s2-bound x}))))
                     *> inv (A.FinSum-inj {LHS-tri-fin k} {SigmaFin (FinFin (suc k)) (\lam (_ : Fin (suc k)) => FinFin (suc k))} LHS-f LHS-f-isInj
      (\lam q no-pre => LHS-y-vanishes {A} {a} {b} {c} c_0 q no-pre))
                          *> inv (A.FinSum-double-dep (\lam (_ : Fin (suc k)) => FinFin (suc k)))
                               *> AbMonoid.FinSum-ext {A} {FinFin (suc k)} (\lam (p : Fin (suc k)) => A.FinSum=BigSum {suc k})
                                    *> AbMonoid.FinSum=BigSum
}


{- | The "book proof" lemma: the $n$-fold convolution of $A \circ c$ in
$x$ agrees coefficient-wise with the composition of $A^n$ with $c$.

Mathematically, $(A(c(x)))^n = (A(x)^n) \circ c$:
$$ [x^k] (b \circ c)^{\star n} = \sum_{m \leq k} [x^m]\,b^{\star n} \cdot [x^k]\,c^{\star m}.$$

By induction on $n$:
 - Base $n = 0$: both sides equal $(\mathit{coef}\,1)_k$ (the identity series).
 - Step: use `conv-at-BigSum`, the IH at each intermediate index, and the
multiplicativity lemma `compose-coeff-*`. -}
\lemma pow-conv-compose {A : CRing} {b c : Series A} (c_0 : c 0 = A.zro) (n k : Nat)
  : pow {FSeriesRing A} (compose b c) n k = compose-coeff (pow {FSeriesRing A} b n) c k
\elim n
  | 0 => inv (AddMonoid.BigSum-unique {A}
    {\new Array A (suc k) \lam (m : Fin (suc k)) => pow {FSeriesRing A} b 0 m * pow {FSeriesRing A} c m k} 0
    (\lam (j : Fin (suc k)) (zero-not-j : (0 : Fin (suc k)) /= j) =>
      pmap (Ring.* {A} __ (pow {FSeriesRing A} c j k))
        (FSeriesRing.coef_/=0 \lam p => zero-not-j (fin_nat-inj (inv p)))
        *> A.zro_*-left)
    *> A.ide-left)
  | suc n => conv-at-BigSum (pow {FSeriesRing A} (compose b c) n) (compose b c) k
    *> AddMonoid.BigSum-ext {A} {suc k}
         {\new Array A (suc k) \lam (j : Fin (suc k)) =>
           pow {FSeriesRing A} (compose b c) n j * compose b c (k -' (j : Nat))}
         {\new Array A (suc k) \lam (j : Fin (suc k)) =>
           compose-coeff (pow {FSeriesRing A} b n) c j * compose b c (k -' (j : Nat))}
         (\lam (j : Fin (suc k)) =>
           pmap (Ring.* {A} __ (compose b c (k -' (j : Nat))))
             (pow-conv-compose c_0 n j))
         *> inv (conv-at-BigSum (compose (pow {FSeriesRing A} b n) c) (compose b c) k)
              *> inv (compose-coeff-* {A} {pow {FSeriesRing A} b n} {b} {c} c_0 k)


{- | Associativity of formal-power-series composition.  With both $b_0 = 0$
     (so the outer composition is finite/truncated) and $c_0 = 0$ (so the
     key lemma `pow-conv-compose` applies), in a commutative ring $A$:
     $$[x^k]\,((a \circ b) \circ c) = [x^k]\,(a \circ (b \circ c)).$$

     Proof outline (after `pow-conv-compose` for the inner step):
     $ [x^k]\,((a \circ b) \circ c) = \sum_m (a \circ b)_m \cdot (c^{\star m})_k
     = \sum_m \sum_{n \leq m} a_n (b^{\star n})_m (c^{\star m})_k
     = \sum_{n} a_n \sum_{m \geq n} b^n_m c^m_k
     = \sum_n a_n \sum_{m=0}^{k} (b^{\star n})_m (c^{\star m})_k
     = \sum_n a_n ((b \circ c)^{\star n})_k = [x^k]\,(a \circ (b \circ c)). $

The step $\sum_{n \leq m}$ over $(n, m)$ with $n \leq m$ to $\sum_n \sum_m$
rectangularly uses Fubini (`BigSum-transpose`) plus the vanishing of
$(b^{\star n})_m$ for $m < n$ (`pow-conv-zero-below` with $b_0 = 0$). -}
\lemma compose-coeff-assoc {A : CRing} {a b c : Series A}
                           (b_0 : b 0 = A.zro) (c_0 : c 0 = A.zro) (k : Nat)
  : compose-coeff (compose a b) c k = compose-coeff a (compose b c) k
  => run {
    rewrite (AddMonoid.BigSum-ext {A} {suc k}
      {\new Array A (suc k) \lam (m : Fin (suc k)) =>
        compose a b m Ring.* pow {FSeriesRing A} c m k}
      {\new Array A (suc k) \lam (m : Fin (suc k)) =>
        AddMonoid.BigSum (\new Array A (suc k) \lam (n : Fin (suc k)) =>
          a n * pow {FSeriesRing A} b n m * pow {FSeriesRing A} c m k)}
      (\lam (m : Fin (suc k)) =>
        pmap (Ring.* {A} __ (pow {FSeriesRing A} c m k))
          (compose-coeff-extend {A} {a} {b} b_0 k m (<_suc_<= (fin_< m)))
          *> A.BigSum-rdistr
          {\new Array A (suc k) \lam (n : Fin (suc k)) => a n * pow {FSeriesRing A} b n m})),
    rewrite (A.BigSum-transpose {suc k} {suc k}
      (\lam (m : Fin (suc k)) (n : Fin (suc k)) =>
        a n * pow {FSeriesRing A} b n m * pow {FSeriesRing A} c m k)),
    AddMonoid.BigSum-ext {A} {suc k}
      {\new Array A (suc k) \lam (n : Fin (suc k)) =>
        AddMonoid.BigSum (\new Array A (suc k) \lam (m : Fin (suc k)) =>
          a n * pow {FSeriesRing A} b n m * pow {FSeriesRing A} c m k)}
      {\new Array A (suc k) \lam (n : Fin (suc k)) =>
        a n * pow {FSeriesRing A} (compose b c) n k},
    \lam n,
    rewrite (AddMonoid.BigSum-ext (\lam (m : Fin (suc k)) => A.*-assoc {a n})),
    rewriteI (A.BigSum-ldistr {a n} {\new Array A (suc k) \lam (m : Fin (suc k)) =>
        pow {FSeriesRing A} b n m * pow {FSeriesRing A} c m k}),
    rewriteI (pow-conv-compose c_0 n k),
    idp
  }

-- ============================================================================
-- The monoid of formal substitutions
-- ============================================================================

-- | The identity for substitution: the series $w = [0, 1, 0, 0, \dots]$, so that $f \circ w = w \circ f = f$.
\func subst-ide {R : Ring} (n : Nat) : R \elim n
  | 0 => R.zro
  | 1 => R.ide
  | suc (suc _) => R.zro

-- | In $(g \cdot w)_{\text{suc } k'}$ over `PairsFinSet`, the per-pair term vanishes whenever the pair differs from the diagonal $(k', 1, \mathrm{idp})$.
\private \lemma subst-ide-off-term {R : Ring} {g : Series R} {k' : Nat} (s : FSeriesRing.PairsFinSet (suc k'))
                                   (s/=spec : s /= ((k', 1, idp) : FSeriesRing.PairsFinSet (suc k')))
  : g s.1 R.* subst-ide s.2 = R.zro
  \elim s
  | (i, 0, p) => R.zro_*-right
  | (i, suc (suc j'), p) => R.zro_*-right
  | (i, 1, p) => absurd (s/=spec (ext (pmap pred p, idp)))

-- | $(w^k)_k = 1$ in $R[[w]]$.
\lemma pow-subst-ide-diag {R : Ring} (k : Nat) : pow {FSeriesRing R} subst-ide k k = R.ide
  \elim k
  | 0 => idp
  | suc k' =>
    R.FinSum-unique (later (k', 1, idp))
      (subst-ide-off-term {R} {pow {FSeriesRing R} subst-ide k'} {k'})
    *> R.ide-right
    *> pow-subst-ide-diag k'

-- | $(w^n)_k = 0$ when $n \neq k$.
\lemma pow-subst-ide-off {R : Ring} (n k : Nat) (n/=k : n /= k) : pow {FSeriesRing R} subst-ide n k = R.zro
  \elim n, k
  | 0, 0 => absurd (n/=k idp)
  | 0, suc k' => idp
  | suc n', 0 => FSeriesRing.Pairs_zero *> R.zro_*-right
  | suc n', suc k' =>
    R.FinSum-unique (later (k', 1, idp))
      (subst-ide-off-term {R} {pow {FSeriesRing R} subst-ide n'} {k'})
    *> R.ide-right
    *> pow-subst-ide-off n' k' (\lam p => n/=k (pmap suc p))

-- | Right identity for substitution: $f \circ w = f$.
\lemma compose-coeff-subst-ide-right {R : Ring} (f : Series R) (k : Nat)
  : compose-coeff f subst-ide k = f k
  => AddMonoid.BigSum-unique {R} {\new Array R (suc k) (\lam n => f n * pow {FSeriesRing R} subst-ide n k)}
       (toFin k id<suc)
       (\lam j j/=spec => pmap (f j R.*) (pow-subst-ide-off j k (\lam p => j/=spec (fin_nat-inj (toFin=id *> inv p))))
                          *> R.zro_*-right)
     *> pmap (\lam (x : Nat) => f x R.* pow {FSeriesRing R} subst-ide x k) toFin=id
     *> pmap (f k R.*) (pow-subst-ide-diag k)
     *> R.ide-right

-- | $w_j = 0$ for $j \neq 1$.
\private \lemma subst-ide-vanish {R : Ring} (j : Nat) (j/=1 : j /= 1) : subst-ide {R} j = R.zro
  \elim j
  | 0 => idp
  | 1 => absurd (j/=1 idp)
  | suc (suc j') => idp

-- | Left identity for substitution: $w \circ f = f$ when $f_0 = 0$.
\lemma compose-coeff-subst-ide-left {R : Ring} {f : Series R} (f_0 : f 0 = R.zro) (k : Nat)
  : compose-coeff subst-ide f k = f k
  \elim k
  | 0 => R.zro-right *> R.zro_*-left *> inv f_0
  | suc k' =>
    AddMonoid.BigSum-unique {R}
       {\new Array R (suc (suc k')) (\lam n => subst-ide n * pow {FSeriesRing R} f n (suc k'))}
       (toFin 1 (NatOrder.suc<suc NatOrder.zero<suc))
       (\lam j j/=spec =>
         pmap (R.`* pow {FSeriesRing R} f j (suc k'))
              (subst-ide-vanish j (\lam p => j/=spec (fin_nat-inj {suc (suc k')} {toFin 1 (NatOrder.suc<suc NatOrder.zero<suc)} {j} (toFin=id {1} {suc (suc k')} {NatOrder.suc<suc NatOrder.zero<suc} *> inv p))))
         *> R.zro_*-left)
     *> pmap (\lam (x : Nat) => subst-ide {R} x R.* pow {FSeriesRing R} f x (suc k')) (toFin=id {1} {suc (suc k')} {NatOrder.suc<suc NatOrder.zero<suc})
     *> R.ide-left
     *> fseries-apply (ide-left {FSeriesRing R} {f})

-- | Carrier of the substitution monoid: formal series with vanishing constant term.
\record FormalSubst (R : Ring) (f : Series R) (f_0 : f 0 = R.zro)

-- | Composition of substitutions; preserves vanishing constant term.
\func subst-compose {R : Ring} (s t : FormalSubst R) : FormalSubst R \cowith
  | f n => compose-coeff s.f t.f n
  | f_0 => R.zro-right *> R.ide-right *> s.f_0

-- | The monoid of formal substitutions $\{f : R[[w]] \mid f_0 = 0\}$ under formal composition,
--   with identity $w$.
\instance FormalSubstMonoid (R : CRing) : Monoid (FormalSubst R)
  | ide => \new FormalSubst R subst-ide idp
  | * => subst-compose
  | ide-left {s} => exts (\lam k => compose-coeff-subst-ide-left s.f_0 k)
  | ide-right {s} => exts (\lam k => compose-coeff-subst-ide-right s.f k)
  | *-assoc {s} {t} {u} => exts (\lam k => compose-coeff-assoc {R} {s.f} {t.f} {u.f} t.f_0 u.f_0 k)

-- ============================================================================
-- Right inverse for substitution (accumulator pattern)
-- ============================================================================

-- | The new coefficient $g_{n}$ as a function of the prefix $g_0, \dots, g_{n - 1}$.
--   $n = 0$: $0$. $n = 1$: $f_1^{-1}$. $n \geq 2$: $-f_1^{-1} \cdot \sum_{m = 2}^{n} f_m \cdot (\mathrm{prev}^m)_n$.
\func new-coef {R : Ring} (f : Series R) (finv1 : Monoid.Inv (f 1)) (n : Nat) (prev : Series R) : R \elim n
  | 0 => R.zro
  | 1 => finv1.inv
  | suc (suc n'') =>
    R.negative finv1.inv R.*
    AddMonoid.BigSum (\new Array R (suc n'')
      (\lam (i : Fin (suc n'')) =>
         f (suc (suc i)) R.* pow {FSeriesRing R} prev (suc (suc i)) (suc (suc n''))))

-- | Accumulator: `g-prefix f finv1 n` returns a `Series R` whose first $n$ coefficients
--   agree with the recursively-defined inverse, and is junk beyond.
\func g-prefix {R : Ring} (f : Series R) (finv1 : Monoid.Inv (f 1)) (n : Nat) : Series R \elim n
  | 0 => \lam _ => R.zro
  | suc n' => \lam k => \case NatSemiring.decideEq k n' \with {
                | yes _ => new-coef f finv1 n' (g-prefix f finv1 n')
                | no _  => g-prefix f finv1 n' k
              }

-- | The right inverse of $f$ under formal composition.
\func subst-rinv {R : Ring} (f : Series R) (finv1 : Monoid.Inv (f 1)) (k : Nat) : R
  => g-prefix f finv1 (suc k) k

-- | L1: g-prefix stabilizes — extending the stage by one doesn't change values below the previous stage.
\lemma g-prefix-stable {R : Ring} {f : Series R} {finv1 : Monoid.Inv (f 1)} (n k : Nat) (k<n : k NatSemiring.< n)
  : g-prefix f finv1 (suc n) k = g-prefix f finv1 n k
  => \case (decideEq k n) \as d \return
       (\case d \with { yes _ => new-coef f finv1 n (g-prefix f finv1 n) | no _ => g-prefix f finv1 n k })
       = g-prefix f finv1 n k
     \with {
     | yes p => absurd (NatSemiring.<-irreflexive (transport (\lam (x : Nat) => x NatSemiring.< n) p k<n))
     | no _ => idp
   }

-- | L2: $\mathrm{subst\text{-}rinv}\ f\ \mathrm{finv1}\ k = \mathrm{g\text{-}prefix}\ f\ \mathrm{finv1}\ n\ k$ when $k < n$.
\lemma subst-rinv-eq-prefix {R : Ring} {f : Series R} {finv1 : Monoid.Inv (f 1)} (n k : Nat) (k<n : k NatSemiring.< n)
  : subst-rinv f finv1 k = g-prefix f finv1 n k
  \elim n
  | 0 => \case k<n
  | suc n' => \case NatSemiring.trichotomy k n' \with {
      | less k<n' => subst-rinv-eq-prefix n' k k<n' *> inv (g-prefix-stable n' k k<n')
      | equals k=n' => \case \elim k, \elim k<n, k=n' \with {
          | _, _, idp => idp
        }
      | greater k>n' => absurd (NatSemiring.<-irreflexive (NatSemiring.<-transitive-left k>n' (<_suc_<= k<n)))
    }

-- | $\mathrm{g\text{-}prefix}\ n\ 0 = 0$ — the prefix always vanishes at index 0.
\lemma g-prefix_0 {R : Ring} {f : Series R} {finv1 : Monoid.Inv (f 1)} (n : Nat)
  : g-prefix f finv1 n 0 = R.zro
  \elim n
  | 0 => idp
  | suc n' => \case decideEq 0 n' \as d \return
              (\case d \with { yes _ => new-coef f finv1 n' (g-prefix f finv1 n')
                             | no _ => g-prefix f finv1 n' 0 }) = R.zro
              \with {
              | yes p => \case \elim n', \elim p \with { | _, idp => idp }
              | no _ => g-prefix_0 n'
            }

-- | $\mathrm{g\text{-}prefix}\ (\mathrm{suc}\ K)\ K = \mathrm{new\text{-}coef}\ K\ (\mathrm{g\text{-}prefix}\ K)$
--   — manually triggering the `decideEq K K = yes _` branch.
\lemma g-prefix-top-eq {R : Ring} {f : Series R} {finv1 : Monoid.Inv (f 1)} (K : Nat)
  : g-prefix f finv1 (suc K) K = new-coef f finv1 K (g-prefix f finv1 K)
  => \case decideEq K K \as d \return
       (\case d \with { yes _ => new-coef f finv1 K (g-prefix f finv1 K) | no _ => g-prefix f finv1 K K })
       = new-coef f finv1 K (g-prefix f finv1 K)
     \with {
       | yes _ => idp
       | no neq => absurd (neq idp)
     }

\lemma pow-ext {R : Ring} {g g' : Series R}
              (K : Nat) (agree : \Pi (i : Nat) -> i NatSemiring.<= K -> g i = g' i)
              (m K' : Nat) (K'<=K : K' NatSemiring.<= K)
  : pow {FSeriesRing R} g m K' = pow {FSeriesRing R} g' m K'
  \elim m
  | 0 => idp
  | suc m' => R.FinSum-ext (\lam (s : FSeriesRing.PairsFinSet K') => \case \elim s \with {
      | (i, j, p) =>
        \have | i<=K' : i NatSemiring.<= K' => transport (i NatSemiring.<=) p (NatSemiring.<=_+ NatSemiring.<=-refl zero<=_)
              | j<=K' : j NatSemiring.<= K' => transport (j NatSemiring.<=) p (NatSemiring.<=_+ zero<=_ NatSemiring.<=-refl)
        \in pmap2 (R.*)
              (pow-ext K agree m' i (i<=K' NatSemiring.<=∘ K'<=K))
              (agree j (j<=K' NatSemiring.<=∘ K'<=K))
    })

-- | $g^{m+1}\ 0 = 0$ when $g\ 0 = 0$ — convolution at $0$ collapses to a single term containing $g\ 0$.
\lemma pow-zero-at-zero {R : Ring} {g : Series R} (g_0 : g 0 = R.zro) (m' : Nat)
  : pow {FSeriesRing R} g (suc m') 0 = R.zro
  \elim m'
  | 0 => FSeriesRing.Pairs_zero *> R.ide-left *> g_0
  | suc m'' => FSeriesRing.Pairs_zero *> pmap (R.`* g 0) (pow-zero-at-zero g_0 m'') *> R.zro_*-left

-- | L4: $g^{m+2}\ (\mathrm{suc}\ K) = (g')^{m+2}\ (\mathrm{suc}\ K)$ when $g, g'$ both vanish at $0$
--   and agree on $[0, K]$. The convolution at $\mathrm{suc}\ K$ for $m \geq 2$ doesn't see index $\mathrm{suc}\ K$.
\lemma pow-tail-eq {R : Ring} {g g' : Series R} (g_0 : g 0 = R.zro) (g'_0 : g' 0 = R.zro)
                  (K : Nat) (agree : \Pi (i : Nat) -> i NatSemiring.<= K -> g i = g' i)
                  (m'' : Nat)
  : pow {FSeriesRing R} g (suc (suc m'')) (suc K) = pow {FSeriesRing R} g' (suc (suc m'')) (suc K)
  => R.FinSum-ext (\lam (s : FSeriesRing.PairsFinSet (suc K)) => \case \elim s \with {
       | (i, 0, _) =>
         pmap (pow {FSeriesRing R} g (suc m'') i R.*) g_0 *> R.zro_*-right
         *> inv (pmap (pow {FSeriesRing R} g' (suc m'') i R.*) g'_0 *> R.zro_*-right)
       | (0, suc j', p) =>
         pmap (R.`* g (suc j')) (pow-zero-at-zero g_0 m'') *> R.zro_*-left
         *> inv (pmap (R.`* g' (suc j')) (pow-zero-at-zero g'_0 m'') *> R.zro_*-left)
       | (suc i', suc j', p) =>
         \have | si'<=K : suc i' NatSemiring.<= K =>
                 suc<=suc.conv (transport (suc (suc i') NatSemiring.<=) p
                                          (NatSemiring.<=_+ NatSemiring.<=-refl (suc<=suc zero<=_)))
               | sj'<=K : suc j' NatSemiring.<= K =>
                 suc<=suc.conv (transport (suc (suc j') NatSemiring.<=) p
                                          (NatSemiring.<=_+ (suc<=suc zero<=_) NatSemiring.<=-refl))
         \in pmap2 (R.*)
               (pow-ext K agree (suc m'') (suc i') si'<=K)
               (agree (suc j') sj'<=K)
     })

-- | $\mathrm{g\text{-}prefix}\ n\ k = 0$ when $n \leq k$ — the prefix at stage $n$ is zero from index $n$ onwards.
\lemma g-prefix-vanish-top {R : Ring} {f : Series R} {finv1 : Monoid.Inv (f 1)} (n k : Nat) (n<=k : n NatSemiring.<= k)
  : g-prefix f finv1 n k = R.zro
  \elim n
  | 0 => idp
  | suc n' => \case (decideEq k n') \as d \return
              (\case d \with { yes _ => new-coef f finv1 n' (g-prefix f finv1 n')
                             | no _ => g-prefix f finv1 n' k }) = R.zro
              \with {
              | yes p => absurd (NatSemiring.<-irreflexive
                                   (NatSemiring.<-transitive-left
                                      (transport (\lam (x : Nat) => x NatSemiring.< suc n')
                                                 (inv p) id<suc)
                                      n<=k))
              | no _ => g-prefix-vanish-top n' k (NatSemiring.<=-less id<suc NatSemiring.<=∘ n<=k)
            }

-- | $\mathrm{subst\text{-}rinv}\ k = \mathrm{g\text{-}prefix}\ (\mathrm{suc}\ K)\ k$ for all $k \leq K$.
\lemma subst-rinv-eq-prefix-up-to {R : Ring} {f : Series R} {finv1 : Monoid.Inv (f 1)} (K k : Nat) (k<=K : k NatSemiring.<= K)
  : subst-rinv f finv1 k = g-prefix f finv1 (suc K) k
  => \case NatSemiring.trichotomy k K \with {
       | less k<K => subst-rinv-eq-prefix (suc K) k (NatSemiring.<-transitive k<K id<suc)
       | equals k=K => \case \elim K, \elim k<=K, \elim k=K \with { | _, _, idp => idp }
       | greater k>K => absurd (NatSemiring.<-irreflexive (NatSemiring.<-transitive-left k>K k<=K))
     }

-- | Main theorem: $\mathrm{subst\text{-}rinv}$ is a right inverse of $f$ under formal composition.
\lemma subst-rinv-correct {R : Ring} {f : Series R} (f_0 : f 0 = R.zro) (finv1 : Monoid.Inv (f 1)) (k : Nat)
  : compose-coeff f (subst-rinv f finv1) k = subst-ide k
  \elim k
  | 0 => R.zro-right *> R.ide-right *> f_0
  | 1 => compose-coeff_1 {R} {f} {subst-rinv f finv1} *> finv1.inv-right
  | suc (suc k') =>
    run {
      rewrite (R.BigSum-ext
      {suc (suc (suc k'))}
      {\new Array R (suc (suc (suc k'))) (\lam n => f n R.* pow {FSeriesRing R} (subst-rinv f finv1) n (suc (suc k')))}
      {\new Array R (suc (suc (suc k'))) (\lam n => f n R.* pow {FSeriesRing R} (g-prefix f finv1 (suc (suc (suc k')))) n (suc (suc k')))}
      (\lam (n : Fin (suc (suc (suc k')))) =>
        pmap (f n R.*)
          (pow-ext (suc (suc k'))
            (\lam i i<=K => subst-rinv-eq-prefix-up-to {R} {f} {finv1} (suc (suc k')) i i<=K)
            n (suc (suc k')) NatSemiring.<=-refl))),
      \let gp => g-prefix f finv1 (suc (suc (suc k'))),
      \let gpK =>  g-prefix f finv1 (suc (suc k')),
      \let tail => AddMonoid.BigSum {R} (\new Array R (suc k') (\lam (i : Fin (suc k')) =>
        f (suc (suc i)) R.* pow {FSeriesRing R} gp (suc (suc i)) (suc (suc k')))),
      rewrite (pmap (\lam x => x R.* R.zro R.+ (f 1 R.* pow {FSeriesRing R} gp 1 (suc (suc k')) R.+ tail)) f_0),
      rewrite (zro_*-left, zro-left, fseries-apply (ide-left {FSeriesRing R} {gp}), g-prefix-top-eq),
      rewriteI R.*-assoc,
      rewrite (R.negative_*-right, finv1.inv-right, R.negative_*-left, R.ide-left),
      rewrite (R.BigSum-ext {suc k'}
        {\new Array R (suc k') (\lam (i : Fin (suc k')) => f (suc (suc i)) R.* pow {FSeriesRing R} gp (suc (suc i)) (suc (suc k')))}
        {\new Array R (suc k') (\lam (i : Fin (suc k')) => f (suc (suc i)) R.* pow {FSeriesRing R} gpK (suc (suc i)) (suc (suc k')))}
        (\lam (i : Fin (suc k')) => pmap (f (suc (suc i)) R.*)
          (inv (pow-tail-eq {R} {gpK} {gp} (g-prefix_0 (suc (suc k'))) (g-prefix_0 (suc (suc (suc k'))))
            (suc k')
            (\lam j j<=K-1 => inv (g-prefix-stable {R} {f} {finv1} (suc (suc k')) j (<=_<_suc j<=K-1))) i)))),
      rewrite R.negative-left,
      idp
    }

-- ============================================================================
-- The group of invertible substitutions
-- ============================================================================

-- | The composition coefficient at index 1: $[w^1]\,(s \circ t) = s_1 \cdot t_1$.
\lemma compose-coeff_1 {R : Ring} {s t : Series R} : compose-coeff s t 1 = s 1 R.* t 1
  => pmap (\lam y => s 0 R.* R.zro R.+ (s 1 R.* y R.+ R.zro)) (fseries-apply (ide-left {FSeriesRing R} {t}))
     *> pmap (R.`+ (s 1 R.* t 1 R.+ R.zro)) R.zro_*-right
     *> R.zro-left
     *> R.zro-right

-- | Formal line diffeomorphism: a formal substitution whose 1st coefficient is invertible in $R$.
\record FormalLineDiffeomorphism \extends FormalSubst {
  | f1-inv : Monoid.Inv (f 1)
}

-- | $w_1 = R.\mathrm{ide}$, so $w$ is invertible.
\func subst-ide-f1-inv {R : Ring} : Monoid.Inv {R} (subst-ide {R} 1) \cowith
  | inv => R.ide
  | inv-left => R.ide-left
  | inv-right => R.ide-right

-- | The composition of invertible substitutions is invertible (chain rule at index 1).
\func subst-compose-inv {R : CRing} (s t : FormalLineDiffeomorphism { | R => R }) : FormalLineDiffeomorphism { | R => R } \cowith
  | f n => compose-coeff s.f t.f n
  | f_0 => R.zro-right *> R.ide-right *> s.f_0
  | f1-inv => transport (Monoid.Inv {R}) (inv (compose-coeff_1 {R} {s.f} {t.f})) (Monoid.Inv.product s.f1-inv t.f1-inv)

\func subst-rinv-inv {R : Ring} (s : FormalLineDiffeomorphism { | R => R }) : FormalLineDiffeomorphism { | R => R } \cowith
  | f => subst-rinv s.f s.f1-inv
  | f_0 => idp
  | f1-inv => s.f1-inv.reverse

-- | The group of formal line diffeomorphisms. `inverse-left` is derived from `inverse-right` via Group's `\default`.
\instance FormalLineDiffeomorphismGroup (R : CRing) : Group (FormalLineDiffeomorphism { | R => R })
  | ide => \new FormalLineDiffeomorphism { | R => R | f => subst-ide | f_0 => idp | f1-inv => subst-ide-f1-inv }
  | * s t => subst-compose-inv s t
  | ide-left {s} => exts (\lam k => compose-coeff-subst-ide-left s.f_0 k)
  | ide-right {s} => exts (\lam k => compose-coeff-subst-ide-right s.f k)
  | *-assoc {s} {t} {u} => exts (\lam k => compose-coeff-assoc {R} {s.f} {t.f} {u.f} t.f_0 u.f_0 k)
  | inverse s => subst-rinv-inv s
  | inverse-right {s} => exts (\lam k => subst-rinv-correct s.f_0 s.f1-inv k)
