\import Algebra.Pointed
\import Algebra.Monoid
\import Algebra.Monoid.FinSum
\import Algebra.Monoid.FinSum.Double
\import Algebra.Ordered
\import Function
\import Function.Meta
\import Logic
\import Meta
\import Order.PartialOrder
\import Paths
\import Set
\import Set.Fin
\import Set.Fin.Instances
\import Algebra.Monoid.Properties
\import Algebra.Semiring.Properties
\import Algebra.Semiring
\import Arith.Nat
\import Data.Array
\import Paths.Meta
\open PosetSemiring
\open Semiring
\open Monoid

-- | {FinSum} analog of {BigSum_<=} on `Fin n`.
\lemma .FinSum_<= (P : PosetAbMonoid) {A : FinSet} {f g : A -> P} (p : \Pi (j : A) -> f j <= g j) : FinSum f <= FinSum g
  => \case FinSum_char f \with {
    | inP (e,q) => transport2 (<=) (inv q) (inv (FinSum_char2 e)) $ BigSum_<= \lam j => p (e j)
  }

\lemma .FinSum_>=0 (P : PosetAbMonoid) {A : FinSet} {f : A -> P} (p : \Pi (j : A) -> 0 <= f j) : 0 <= FinSum f
  => transport (<= _) (FinSum_zro \lam j => idp) $ FinSum_<= p

\lemma .FinSum_<=-inj (P : PosetAbMonoid) {A B : FinSet} (f : A -> B) (inj : IsInj f) {x : B -> P} (p : \Pi (b : B) -> (\Pi (a : A) -> f a /= b) -> 0 <= x b)
  : FinSum (\lam a => x (f a)) <= FinSum x
  => \have dec => FinSum-inj.dec {_} {_} {f}
     \in transport2 (<=) zro-right
          (inv $ FinSum_Equiv (later FinSum-inj.equiv)
              *> FinSum_Or {_} {SigmaFin B \lam b => DecFin (decide {dec b})} {SigmaFin B \lam b => DecFin (decide {NotDecide (dec b)})}) $
          <=_+ (=_<= $ FinSum_Equiv2 (later $ FinSum-inj.equiv2 inj) \lam a => idp) $ FinSum_>=0 $ later
            \lam s => p s.1 \lam a q => s.2 $ inP (a,q)

\lemma .FinSum_<=-inj2 (P : PosetAbMonoid) {A B : FinSet} (f : A -> B) (inj : IsInj f) {x : B -> P} (p : \Pi (b : B) -> (\Pi (a : A) -> f a /= b) -> 0 <= x b)
                      {y : A -> P} (q : \Pi (a : A) -> x (f a) = y a) : FinSum y <= FinSum x
  => transport (<= _) (FinSum-ext q) (FinSum_<=-inj f inj p)

\lemma .BigSum_<= (PP : PosetAddMonoid) {n : Nat} {l l' : Array PP n} (p : \Pi (j : Fin n) -> l j <= l' j) : BigSum l <= BigSum l' \elim n, l, l'
  | 0, nil, nil => <=-refl
  | suc n, a :: l, a' :: l' => <=_+ (p 0) $ BigSum_<= \lam j => p (suc j)

\lemma .BigSum_>=0 (PP : PosetAddMonoid) {l : Array PP} (q : \Pi (j : Fin l.len) -> 0 <= l j) : 0 <= BigSum l
  => transport (<= _) BigSum_replicate0 $ BigSum_<= {_} {_} {replicate l.len zro} q

\lemma .natCoef_<= (PP : PosetSemiring) {n m : Nat} (p : n NatSemiring.<= m) : natCoef n <= natCoef m
  => rewrite (inv (<=_exists p), natCoef_+) $ transport (<= _) zro-right $ <=_+ <=-refl natCoef>=0

\lemma .pow<=id (PP : PosetSemiring) {a : PP} (a>=0 : 0 <= a) (a<=1 : a <= 1) {k : Nat} (k/=0 : k /= 0) : pow a k <= a \elim k
  | 0 => \case k/=0 idp
  | 1 => transportInv (<= _) ide-left <=-refl
  | suc (suc k) => transport (_ <=) ide-right $ <=_*_positive-right (pow>=0 {_} {a} {suc k} a>=0) a<=1 <=∘ <=_*_positive-left (pow<=id a>=0 a<=1 suc/=0) (a>=0 <=∘ a<=1)

\lemma .pow>=id (PP : PosetSemiring) {a : PP} (a>=1 : 1 <= a) {k : Nat} (k/=0 : k /= 0) : a <= pow a k \elim k
  | 0 => \case k/=0 idp
  | 1 => transportInv (a <=) ide-left <=-refl
  | suc (suc k) =>
    \have a>=0 => zro<=ide <=∘ a>=1
    \in transport (<= _) ide-right $ <=_*_positive-right a>=0 a>=1 <=∘ <=_*_positive-left (pow>=id a>=1 suc/=0) a>=0

\lemma .pow<=1 (PP : PosetSemiring) {a : PP} (a>=0 : 0 <= a) (a<=1 : a <= 1) {k : Nat} : pow a k <= 1 \elim k
  | 0 => <=-refl
  | suc k => pow<=id a>=0 a<=1 {suc k} (\case __) <=∘ a<=1

\lemma .pow_<=-degree (PP : PosetSemiring) {a : PP} (a>=0 : 0 <= a) (a<=1 : a <= 1) {n k : Nat} (n<=k : n NatSemiring.<= k) : pow a k <= pow a n
  => rewrite (inv (<=_exists n<=k), pow_+) $ transport (_ <=) ide-right $ <=_*_positive-right (pow>=0 a>=0) $ pow<=1 a>=0 a<=1

\lemma .pow_<=-degree_>=1 (PP : PosetSemiring) {a : PP} (p : a >= 1) {n m : Nat} (m<=n : m NatSemiring.<= n) : pow a m <= pow a n
  => rewriteI (<=_exists m<=n, inv pow_+) $ rewriteI {1} ide-right $
      <=_*_positive-right (PosetSemiring.pow>=0 (zro<=ide <=∘ p)) (PosetSemiring.pow>=1 p)

\lemma .powSum>=0 (PP : PosetSemiring) {a : PP} (a>=0 : 0 <= a) (n : Nat) : 0 <= powSum a n
  => BigSum_>=0 (\lam k => pow>=0 a>=0)

-- | {powSum} is monotone in the base.
\lemma .powSum-mono (PP : PosetSemiring) {a b : PP} (a>=0 : 0 <= a) (a<=b : a <= b) (n : Nat) : powSum a n <= powSum b n
  => BigSum_<= (\lam k => pow_<=-monotone a>=0 a<=b)

-- | For `a >= 1`, `powSum a (suc m) <= (suc m) * a^m`.
\lemma .powSum-bound (PP : PosetSemiring) {a : PP} (a>=1 : 1 <= a) (m : Nat) : powSum a (suc m) <= natCoef (suc m) * pow a m
  => BigSum_<= {_} {suc m} {\new Array PP (suc m) (\lam k => pow a k)} {replicate (suc m) (pow a m)}
      (\lam k => pow_<=-degree_>=1 a>=1 (<_suc_<= (fin_< k)))
     <=∘ =_<= (BigSum_replicate {_} {pow a m} {suc m})
