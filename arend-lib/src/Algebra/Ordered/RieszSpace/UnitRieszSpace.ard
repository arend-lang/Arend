\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.Ordered.RieszSpace
\import Arith.Nat
\import Arith.Rat
\import Function.Meta
\import Logic
\import Logic.Meta
\import Meta
\import Order.Biordered
\import Order.Lattice
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths

-- | A Riesz space with an Archimedean strong unit.
\class UnitRieszSpace \extends RieszSpace {
  | unit : E
  | unit-strong (a : E) : ∃ (n : Nat) (a <= n *n unit)
  | unit-archimedean {a : E} : (\Pi (n : Nat) -> n *n a <= unit) -> a <= 0

  \lemma unit>=0 : 0 <= unit
    => \case unit-strong (negative unit) \with {
      | inP (n,p) => <=_*n-div {_} {suc n} (\case __) $ transport (0 <=) (pmap (_ +) negative-isInv) (to>=0 p)
    }

  \lemma unit*q>=0 {r : Rat} (r>=0 : RatField.zro RatField.<= r) : 0 <= r *q unit
    => *q_>=0 r>=0 unit>=0

  -- | Every element is below any positive multiple of the unit.
  \lemma <=s-unit {a : E} {r : Rat} (r>0 : 0 < r) : a <=s r *q unit
    => \case unit-strong a \with {
      | inP (n,p) => <=s-trans (<=s-trans (<=_<=s p) *n_<=s) (*q_<=s r>0)
    }

  \lemma <=s-top {x : E} {r : Rat} (r>0 : 0 < r) (p : r *q unit <= x) {a : E} : a <=s x
    => <=s-trans (<=s-unit r>0) (<=_<=s p)

  \lemma unit-minus {r : Rat} : unit - r *q unit = (RatField.ide - {RatField} r) *q unit
    => pmap (- _) (inv ide_*q) *> inv toRatModule.*c-rdistr_-

  \lemma <=s-unit-minus {r : Rat} (r<1 : r < 1) {a : E} : a <=s unit - r *q unit
    => \let r' : Rat => RatField.ide - {RatField} r
       \in <=s-trans (<=s-unit {_} {a} {r'} (later linarith)) (<=_<=s (=_<= (inv unit-minus)))

  -- | Every element is bounded by a rational multiple of the unit.
  \lemma unit-bounded (a : E) : ∃ (N : Rat) (RatField.zro RatField.<= N) (negative (N *q unit) <= a) (a <= N *q unit)
    => \case unit-strong a, unit-strong (negative a) \with {
      | inP (n,a<=n), inP (m,-a<=m) =>
        \have | n>=0 : RatField.zro RatField.<= RatField.natCoef n => RatField.natCoef>=0
              | m>=0 : RatField.zro RatField.<= RatField.natCoef m => RatField.natCoef>=0
        \in inP (RatField.natCoef n RatField.+ RatField.natCoef m, linarith,
                 negative_<=-conv (-a<=m <=∘ =_<= (inv *q_*n) <=∘ <=_*q-left {_} {RatField.natCoef m} (later linarith) unit>=0 <=∘ =_<= (inv negative-isInv)),
                 a<=n <=∘ =_<= (inv *q_*n) <=∘ <=_*q-left {_} {RatField.natCoef n} (later linarith) unit>=0)
    }

  -- | If `1/2 *q unit` is in the ideal generated by `x`, then `unit` is bounded by a multiple of the positive part of `x`.
  \lemma unit-ideal {x : E} (p : ratio 1 2 *q unit <=s x) : ∃ (K : Nat) (unit <= K *n part+ x) \elim p
    | inP (n,q) =>
      \have | hp : part+ (ratio 1 2 *q unit) = ratio 1 2 *q unit => part+-ofPos (unit*q>=0 (later linarith))
            | h1 : ratio 1 2 *q unit <= n *n part+ x => =_<= (inv hp) <=∘ q
            | uu : unit = ratio 1 2 *q unit + ratio 1 2 *q unit => inv ide_*q *> pmap (*q unit) idp *> toRatModule.*c-rdistr
      \in inP (n Nat.+ n, =_<= uu <=∘ <=_+ h1 h1 <=∘ =_<= (inv *n-rdistr))

  -- | The lower and the upper cuts of an element at `p < q` together are everything.
  \lemma split-top {a : E} {p q : Rat} (p<q : p < q) : ratio 1 2 * (q - p) *q unit <= (a - p *q unit) ∨ (q *q unit - a)
    => \let z => (a - p *q unit) ∨ (q *q unit - a)
       \in \have t : (q - p) *q unit <= z + z => =_<= (toRatModule.*c-rdistr_- *> equation.abGroup) <=∘ join_+-double <=∘ =_<= (inv join_+-comm)
       \in =_<= *q-assoc <=∘ <=_*q-right (later linarith) t <=∘ =_<= (pmap (_ *q) (inv *q_*2) *> inv *q-assoc *> pmap (*q z) idp *> ide_*q)

  -- | The Archimedean property with rational bounds.
  \lemma unit-archimedean-rat {a : E} (p : \Pi {r : Rat} -> 0 < r -> a <= r *q unit) : a <= 0
    => unit-archimedean \case \elim __ \with {
      | 0 => unit>=0
      | suc n => *n_<= {_} {suc n} (p {RatField.finv (suc n)} (RatField.finv>0 {suc n} (later linarith))) <=∘ =_<= (inv (*q_*n {_} {suc n}) *> inv *q-assoc *> pmap (*q unit) (RatField.finv-right $ natRat/=0 {suc n} suc/=0) *> ide_*q)
    }

  \lemma archimedean-<=s {a : E} (p : \Pi {r : Rat} -> 0 < r -> a - r *q unit <=s 0) : a <= 0
    => unit-archimedean-rat \lam r>0 => from>=0 $ negative-to>=0 $ =_<= negative_- <=∘ <=s_<=0 (p r>0) <=-refl

  -- | Shifting down by a multiple of the unit is compatible with `<=s`.
  \lemma <=s-shift {a b : E} (a<=b : a <=s b) {r : Rat} (r>0 : 0 < r) : ∃ (s : Rat) (0 < s) (a - r *q unit <=s b - s *q unit) \elim a<=b
    | inP (n,a<=nb) =>
      \let | m : Nat => suc n
           | s => r * RatField.finv m
      \in \have | m>0 : (0 : Rat) < m => later linarith
                | s>0 : 0 < s => RatField.<_*_positive_positive r>0 (RatField.finv>0 m>0)
                | ms=r : (m : Rat) * s = r => inv RatField.*-assoc *> pmap (* _) RatField.*-comm *> RatField.*-assoc *> pmap (r *) (RatField.finv-right $ natRat/=0 {m} suc/=0) *> RatField.ide-right
                | e : m *n part+ b - r *q unit = m *n (part+ b - s *q unit) => inv $ *n-ldistr {_} {m} {part+ b} {negative (s *q unit)} *> pmap (_ +) (*n_negative {_} {m} {s *q unit} *> pmap negative (inv *q_*n *> inv *q-assoc *> pmap (*q unit) ms=r))
      \in inP (s, s>0, inP (m, part+-mono (<=_+ join-left <=-refl) <=∘ part+-mono (<=_+ (a<=nb <=∘ *n_<=-nat id<=suc part+>=0) <=-refl) <=∘ =_<= (pmap part+ e *> part+_*n {_} {m} {part+ b - s *q unit} *> pmap (m *n) (part+-shift $ unit*q>=0 (<=-less s>0)))))

  \lemma lower-top {a : E} {N d : Rat} (lo : negative (N *q unit) <= a)
    : d *q unit <= a - (RatField.negative N - {RatField} d) *q unit
    => =_<= (inv zro-left) <=∘ <=_+ (to>=0 lo) <=-refl <=∘
         =_<= (inv $ pmap (a -) (toRatModule.*c-rdistr_- *> pmap (- (d *q unit)) toRatModule.*c_negative-left) *> equation.abGroup)

  \lemma upper-top {a : E} {N s d : Rat} (hi : a <= N *q unit) (N<=s : N RatField.<= s)
    : d *q unit <= (s RatField.+ d) *q unit - a
    => =_<= (inv zro-left) <=∘ <=_+ (to>=0 (hi <=∘ <=_*q-left N<=s unit>=0)) <=-refl <=∘
         =_<= (inv $ pmap (- a) toRatModule.*c-rdistr *> equation.abGroup)

  \lemma minus-scal {p y : Rat} : negative (p *q unit) - y *q unit = (RatField.negative p - {RatField} y) *q unit
    => inv (toRatModule.*c-rdistr_- *> pmap (- _) toRatModule.*c_negative-left)

  \lemma sub-scal-le {k : Rat} (k>=0 : RatField.zro RatField.<= k) {h : E} : h - k *q unit <= h
    => <=_+ <=-refl (negative<=0 (unit*q>=0 k>=0)) <=∘ =_<= zro-right

  \lemma affine-minus {p y D : Rat} {h : E} : p *q unit + D *q h - y *q unit = (p - {RatField} y) *q unit + D *q h
    => inv (pmap (+ _) toRatModule.*c-rdistr_- *> equation.abGroup)

  \lemma affine-le {p D : Rat} {h : E} (D>=0 : RatField.zro RatField.<= D) (hu : h <= unit) : p *q unit + D *q h <= (p RatField.+ D) *q unit
    => <=_+ <=-refl (<=_*q-right D>=0 hu) <=∘ =_<= (inv toRatModule.*c-rdistr)

  \lemma affine-lower {p q D k : Rat} {h : E}
    : (q *q unit - (p *q unit + D *q h)) + D *q (h - k *q unit) = (q - {RatField} p - {RatField} D * k) *q unit
    => pmap (_ +) (toRatModule.*c-ldistr_- *> pmap (_ -) (inv *q-assoc)) *> equation.abGroup
         *> inv (toRatModule.*c-rdistr_- *> pmap (- _) toRatModule.*c-rdistr_-)

  -- | `cut a p q` is positive exactly where `p < a < q`.
  \func cut (a : E) (p q : Rat) : E
    => (a - p *q unit) ∧ (q *q unit - a)

  \lemma cut-double {a : E} {p q : Rat} : cut a p q + cut a p q <= (q - {RatField} p) *q unit
    => <=_+ meet-left meet-right <=∘ =_<= (equation.abGroup *> inv toRatModule.*c-rdistr_-)

  \lemma cut<=0 {a : E} {p q : Rat} (q<=p : q RatField.<= p) : cut a p q <= 0
    => double<=0 $ cut-double <=∘ *q_<=0 (later linarith) unit>=0

  \lemma cut-mono {a : E} {p q p' q' : Rat} (p'<=p : p' RatField.<= p) (q<=q' : q RatField.<= q') : cut a p q <= cut a p' q'
    => meet-monotone (<=_+ <=-refl (negative_<= (<=_*q-left p'<=p unit>=0))) (<=_+ (<=_*q-left q<=q' unit>=0) <=-refl)

  \lemma cut-meet {a : E} {p q p' q' : Rat} : cut a p q ∧ cut a p' q' <= cut a (p RatField.∨ p') (q RatField.∧ q')
    => meet-univ
        (\case RatField.totality p p' \with {
          | byLeft p<=p' => meet-right <=∘ meet-left <=∘ =_<= (pmap (\lam t => a - t *q unit) (inv (RatField.join_<= p<=p')))
          | byRight p'<=p => meet-left <=∘ meet-left <=∘ =_<= (pmap (\lam t => a - t *q unit) (inv (RatField.join-comm *> RatField.join_<= p'<=p)))
        })
        (\case RatField.totality q q' \with {
          | byLeft q<=q' => meet-left <=∘ meet-right <=∘ =_<= (pmap (\lam t => t *q unit - a) (inv (RatField.meet_<= q<=q')))
          | byRight q'<=q => meet-right <=∘ meet-right <=∘ =_<= (pmap (\lam t => t *q unit - a) (inv (RatField.meet-comm *> RatField.meet_<= q'<=q)))
        })

  \lemma cut-shift {a : E} {p q r : Rat} : cut a p q - r *q unit = cut a (p RatField.+ r) (q - {RatField} r)
    => meet_+-right *> pmap2 (∧) (equation.abGroup *> pmap (a -) (inv toRatModule.*c-rdistr)) (equation.abGroup *> pmap (- a) (inv toRatModule.*c-rdistr_-))

  \lemma cut-top (a : E) : ∃ (K : Rat) (RatField.zro RatField.< K) (unit <= cut a (RatField.negative K) K)
    => \case unit-strong a, unit-strong (negative a) \with {
      | inP (n,a<=n), inP (m,-a<=m) =>
        \let | N => n *n unit
             | M => m *n unit
             | K : Rat => n RatField.+ m RatField.+ 1
        \in \have | N>=0 : 0 <= N => *n_>=0 unit>=0
                  | M>=0 : 0 <= M => *n_>=0 unit>=0
                  | Ku : K *q unit = N + M + unit => toRatModule.*c-rdistr *> pmap2 (+) (toRatModule.*c-rdistr *> pmap2 (+) *q_*n *q_*n) ide_*q
        \in inP (K, later linarith, meet-univ
            (=_<= (inv zro-left *> pmap (+ unit) (inv zro-left)) <=∘ <=_+ (<=_+ N>=0 (to>=0 -a<=m)) <=-refl <=∘ =_<= (equation.abGroup *> pmap (a +) (inv Ku *> inv negative-isInv *> pmap negative (inv toRatModule.*c_negative-left))))
            (=_<= (inv zro-left *> pmap (+ unit) (inv zro-left)) <=∘ <=_+ (<=_+ (to>=0 a<=n) M>=0) <=-refl <=∘ =_<= (equation.abGroup *> pmap (- a) (inv Ku))))
    }

  \lemma cut-split {a : E} {p q b c : Rat} (b<c : b < c) : cut a p q <=s pjoin (cut a p c :: cut a b q :: nil)
    => <=s-trans (<=s-meet <=s-refl (<=s-top {_} {_} {ratio 1 2 * (c - b)} (later linarith) (split-top b<c)))
        (<=_<=s $ =_<= meet-ldistr <=∘ join-univ (meet-univ meet-right (meet-left <=∘ meet-right) <=∘ join-left <=∘ join-right)
                                                 (meet-univ (meet-left <=∘ meet-left) meet-right <=∘ join-left))

  \lemma cut-add {a b : E} {J1 J2 K1 K2 : Rat} : cut a J1 J2 ∧ cut b K1 K2 <=s cut (a + b) (J1 RatField.+ K1) (J2 RatField.+ K2)
    => <=s-meet
        (<=s-trans (<=_<=s (meet-monotone meet-left meet-left)) (<=s-trans meet_<=s_+ (<=_<=s (=_<= (equation.abGroup *> pmap (a + b -) (inv toRatModule.*c-rdistr))))))
        (<=s-trans (<=_<=s (meet-monotone meet-right meet-right)) (<=s-trans meet_<=s_+ (<=_<=s (=_<= (equation.abGroup *> pmap (- (a + b)) (inv toRatModule.*c-rdistr))))))

  \lemma cut-sum-split {a b : E} {p q s e : Rat}
    : cut (a + b) p q ∧ cut a (s - {RatField} e) (s RatField.+ e) <=s cut a (s - {RatField} e) (s RatField.+ e) ∧ cut b (p - {RatField} s - {RatField} e) (q - {RatField} s RatField.+ e)
    => <=s-meet (<=_<=s meet-right) $ <=s-meet
        (<=s-trans (<=_<=s (meet-monotone meet-left meet-right)) (<=s-trans meet_<=s_+ (<=_<=s (=_<= (pmap (\lam t => a + b - p *q unit + (t - a)) toRatModule.*c-rdistr *> equation.abGroup *> pmap (b -) (inv (toRatModule.*c-rdistr_- *> pmap (- _) toRatModule.*c-rdistr_-)))))))
        (<=s-trans (<=_<=s (meet-monotone meet-right meet-left)) (<=s-trans meet_<=s_+ (<=_<=s (=_<= (pmap (\lam t => q *q unit - (a + b) + (a - t)) toRatModule.*c-rdistr_- *> equation.abGroup *> pmap (- b) (inv (toRatModule.*c-rdistr *> pmap (+ _) toRatModule.*c-rdistr_-)))))))

  \lemma cut-join {a b : E} {J1 J2 K1 K2 : Rat} : cut a J1 J2 ∧ cut b K1 K2 <= cut (a ∨ b) (J1 RatField.∨ K1) (J2 RatField.∨ K2)
    => meet-univ
        (meet-monotone meet-left meet-left <=∘ gcongr (join-left, join-right) <=∘ =_<= (inv (pmap ((a ∨ b) -) (*q_join unit>=0) *> minus-join)))
        (meet-monotone meet-right meet-right <=∘ meet-monotone (<=_+ (<=_*q-left RatField.join-left unit>=0) <=-refl) (<=_+ (<=_*q-left RatField.join-right unit>=0) <=-refl) <=∘ =_<= (inv minus-join))
}