\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.Ordered.RieszSpace
\import Algebra.Ring.Boolean
\import Arith.Rat
\import Data.Array
\import Data.Fin (fsuc/=, fsuc/=0)
\import Function.Meta
\import Logic
\import Order.Biordered
\import Order.Lattice
\import Order.PartialOrder
\import Paths
\import Paths.Meta

\class TruncRieszSpace \extends RieszSpace {
  | trunc : E -> E
  | trunc_zro>=0 : 0 <= trunc 0
  | trunc-bound {a : E} : trunc a <= a
  | trunc-assoc {a b : E} : a ∧ trunc b <= trunc a

  \lemma trunc_zro : trunc 0 = 0
    => <=-antisymmetric trunc-bound trunc_zro>=0

  \lemma trunc-pos {a : E} (a>=0 : 0 <= a) : 0 <= trunc a
    => meet-univ a>=0 trunc_zro>=0 <=∘ trunc-assoc

  \lemma trunc-neg {a : E} (a<=0 : a <= 0) : trunc a = a
    => <=-antisymmetric trunc-bound $ meet-univ <=-refl (a<=0 <=∘ trunc_zro>=0) <=∘ trunc-assoc

  \lemma trunc-mono {a b : E} (a<=b : a <= b) : trunc a <= trunc b
    => meet-univ (trunc-bound <=∘ a<=b) <=-refl <=∘ trunc-assoc

  \lemma trunc-idemp {a : E} : trunc (trunc a) = trunc a
    => <=-antisymmetric trunc-bound (meet-univ <=-refl <=-refl <=∘ trunc-assoc)

  \lemma trunc_join {a b : E} : trunc (a ∨ b) = trunc a ∨ trunc b
    => <=-antisymmetric
        (meet-univ trunc-bound <=-refl <=∘ rdistr>= <=∘ join-monotone trunc-assoc trunc-assoc)
        (join-univ (trunc-mono join-left) (trunc-mono join-right))

  \lemma trunc_meet {a b : E} : trunc (a ∧ b) = trunc a ∧ trunc b
    => <=-antisymmetric
        (meet-univ (trunc-mono meet-left) (trunc-mono meet-right))
        (meet-univ (meet-monotone trunc-bound trunc-bound) meet-left <=∘ trunc-assoc)

  \lemma trunc-spliit {a : E} : trunc a = trunc (part+ a) - part- a
    => \let | y => trunc a + part- a
       \in \have
            | ge : trunc (part+ a) - part- a <= trunc a
              => meet-univ (transport (_ <=) parts_- $ <=_+ trunc-bound <=-refl) (transport (_ <=) zro-right $ <=_+ <=-refl $ negative<=0 join-right) <=∘ trunc-assoc
            | y<=p : y <= part+ a
              => <=_+ trunc-bound <=-refl <=∘ =_<= (pmap (+ _) (inv parts_-) *> +-assoc *> pmap (_ +) negative-left *> zro-right)
            | tp<=y : trunc (part+ a) <= y
              => =_<= (inv $ +-assoc *> pmap (_ +) negative-left *> zro-right) <=∘ <=_+ ge <=-refl
            | ty>=0 : 0 <= trunc y
              => trunc-pos $ trunc-pos join-right <=∘ tp<=y
            | y<=ty : y <= trunc y
              => meet-univ <=-refl (<=_+ (meet-univ (=_<= (inv zro-right) <=∘ <=_+ <=-refl join-right) <=-refl <=∘ trunc-assoc) <=-refl)
                <=∘ meet_+-subadditive (ty>=0 <=∘ trunc-bound) ty>=0 join-right <=∘ <=_+ meet-right (meet-monotone y<=p <=-refl <=∘ =_<= parts_meet) <=∘ =_<= zro-right
       \in <=-antisymmetric (=_<= (inv $ +-assoc *> pmap (_ +) negative-right *> zro-right) <=∘ <=_+ (meet-univ y<=p y<=ty <=∘ trunc-assoc) <=-refl) ge

  \lemma trunc-diff-cmp {a b : E} (b<=a : b <= a) : trunc a - trunc b <= a - b
    => <=_+ (meet-univ trunc-bound (=_<= (inv zro-right) <=∘ <=_+ <=-refl (to>=0 b<=a)) <=∘ =_<= (pmap (__ ∧ _) (equation.abGroup : a = b + (a - b)) *> inv meet_+-right) <=∘ <=_+ trunc-assoc <=-refl) <=-refl <=∘ =_<= equation.abGroup

  \lemma trunc-diff {a b : E} : trunc a - trunc b <= part+ (a - b)
    => <=_+ <=-refl (negative_<= $ trunc-mono meet-right) <=∘ trunc-diff-cmp meet-left <=∘ =_<= (inv part+_diff_meet)

  \lemma trunc-lipschitz {a b : E} : abs (trunc a - trunc b) <= abs (a - b)
    => join-univ (trunc-diff <=∘ join-univ abs>=id abs>=0) (=_<= negative_- <=∘ trunc-diff <=∘ join-univ abs>=_- abs>=0)

  \lemma trunc_+-pos-disjoint {a b : E} (a>=0 : 0 <= a) (b>=0 : 0 <= b) (d : a ∧ b = 0) : trunc (a + b) = trunc a + trunc b
    => pmap trunc (disjoint_pos_+_join a>=0 b>=0 d) *> trunc_join *> inv (disjoint_pos_+_join (trunc-pos a>=0) (trunc-pos b>=0) $
        <=-antisymmetric (meet-monotone trunc-bound trunc-bound <=∘ =_<= d) (meet-univ (trunc-pos a>=0) (trunc-pos b>=0)))

  \lemma trunc_+-disjoint {a b : E} (d : AreDisjoint a b) : trunc (a + b) = trunc a + trunc b
    => trunc-spliit *> pmap2 (\lam u v => trunc u - v) (part+_+-disjoint d) (part-_+-disjoint d)
        *> pmap (__ - _) (trunc_+-pos-disjoint join-right join-right $ <=-antisymmetric (meet-monotone part+<=abs part+<=abs <=∘ =_<= d) (meet-univ join-right join-right))
        *> equation.abGroup *> inv (pmap2 (+) trunc-spliit trunc-spliit)

  \lemma trunc_BigSum-disjoint {l : Array E} (d : \Pi {i j : Fin l.len} -> i /= j -> AreDisjoint (l i) (l j)) : trunc (BigSum l) = BigSum (map trunc l) \elim l
    | nil => trunc_zro
    | a :: l => trunc_+-disjoint (disjoint_BigSum-right \lam j => d {0} {suc j} (/=-sym fsuc/=0)) *> pmap (_ +) (trunc_BigSum-disjoint \lam {i} {j} p => d {suc i} {suc j} (fsuc/= p))

  \type IsUnderUnit (a : E) : \Prop
    => trunc a = a

  \lemma InUnderUnit_<= {a b : E} (a<=b : a <= b) (tb : IsUnderUnit b) : IsUnderUnit a
    => <=-antisymmetric trunc-bound (meet-univ <=-refl (a<=b <=∘ =_<= (inv tb)) <=∘ trunc-assoc)

  \lemma trunc_*q-boolean_<=1 {q : Rat} (q<=1 : q RatField.<= 1) {e : E} (p : IsBoolean e) : IsUnderUnit (q *q e)
    => InUnderUnit_<= (<=_*q-left q<=1 (IsBoolean>=0 p) <=∘ =_<= ide_*q) (IsBoolean-trunc p)

  \lemma trunc_*q-boolean_>=1 {q : Rat} (q>=1 : 1 RatField.<= q) {e : E} (p : IsBoolean e) : trunc (q *q e) = e
    => \let | e>=0 => IsBoolean>=0 p
            | y => trunc (q *q e) - e
            | y>=0 : 0 <= y => to>=0 $ =_<= (inv (IsBoolean-trunc p)) <=∘ trunc-mono (=_<= (inv ide_*q) <=∘ <=_*q-left q>=1 e>=0)
            | ye : y ∧ e = 0 => meet-comm *> pmap (e ∧) (inv (part+-ofPos y>=0)) *> IsBoolean-orth p trunc-idemp
            | (n,q<n) => rat_natBound q
            | y<=ne : y <= n *n e => <=_+ trunc-bound (negative<=0 e>=0) <=∘ =_<= zro-right <=∘ <=_*q-left (<=-less q<n) e>=0 <=∘ =_<= *q_*n
       \in AddGroup.fromZero $ <=-antisymmetric (meet-univ <=-refl y<=ne <=∘ =_<= (meet_*n-zro y>=0 e>=0 ye)) y>=0

  \lemma trunc_*q-boolean {q : Rat} {e : E} (p : IsBoolean e) : trunc (q *q e) = (q RatField.∧ 1) *q e
    => \case RatField.totality q 1 \with {
      | byLeft q<=1 => \have t : q = q RatField.∧ 1 => RatField.<=-antisymmetric (RatField.meet-univ RatField.<=-refl q<=1) RatField.meet-left
                       \in trunc_*q-boolean_<=1 q<=1 p *> pmap (__ *q e) t
      | byRight q>=1 => \have t : q RatField.∧ 1 = 1 => RatField.<=-antisymmetric RatField.meet-right (RatField.meet-univ q>=1 RatField.<=-refl)
                        \in trunc_*q-boolean_>=1 q>=1 p *> inv (pmap (__ *q e) t *> ide_*q)
    }

  \type IsBoolean (a : E) : \Prop
    => trunc (a + a) = a

  \lemma IsBoolean>=0 {a : E} (p : IsBoolean a) : 0 <= a
    => <=_+-cancel-left a $ =_<= zro-right <=∘ (inv p =<= trunc-bound)

  \lemma IsBoolean_zro : IsBoolean 0
    => pmap trunc zro-left *> trunc_zro

  \lemma IsBoolean-trunc {a : E} (p : IsBoolean a) : IsUnderUnit a
    => pmap trunc (inv p) *> trunc-idemp *> p

  \lemma IsBoolean-orth {e y : E} (p : IsBoolean e) (ty : IsUnderUnit y) : e ∧ part+ (y - e) = 0
    => \have | s : e + e ∧ part+ (y - e) <= trunc (e ∨ y)
               => <=_+ <=-refl meet-right <=∘ =_<= (pmap (e +) part+_diff_join *> +-comm *> +-assoc *> pmap (_ +) negative-left *> zro-right *> join-comm *> inv (trunc_join *> pmap2 (∨) (IsBoolean-trunc p) ty))
             | t : e + e ∧ part+ (y - e) <= e
               => meet-univ <=-refl s <=∘ trunc-assoc <=∘ trunc-mono (<=_+ <=-refl meet-left) <=∘ =_<= p
       \in <=-antisymmetric (<=_+-cancel-left e $ t <=∘ =_<= (inv zro-right)) (meet-univ (IsBoolean>=0 p) join-right)

  \lemma IsBoolean_meet {a b : E} (p : IsBoolean a) (q : IsBoolean b) : IsBoolean (a ∧ b)
    => <=-antisymmetric (meet-univ (trunc-mono (<=_+ meet-left meet-left) <=∘ =_<= p) (trunc-mono (<=_+ meet-right meet-right) <=∘ =_<= q))
        (=_<= (inv $ trunc_meet *> pmap2 (∧) (IsBoolean-trunc p) (IsBoolean-trunc q)) <=∘ trunc-mono (=_<= (inv zro-right) <=∘ <=_+ <=-refl (meet-univ (IsBoolean>=0 p) (IsBoolean>=0 q))))

  \lemma IsBoolean_join {a b : E} (p : IsBoolean a) (q : IsBoolean b) : IsBoolean (a ∨ b)
    => pmap trunc join_+-comm *> trunc_join *> pmap2 (∨) p q

  \lemma IsBoolean_diff {a b : E} (p : IsBoolean a) (q : IsBoolean b) : IsBoolean (part+ (a - b))
    => \let | c => part+ (a - b)
       \in \have
            | c>=0 : 0 <= c => join-right
            | ab>=0 : 0 <= a ∧ b => meet-univ (IsBoolean>=0 p) (IsBoolean>=0 q)
            | c<=a : c <= a => =_<= part+_diff_meet <=∘ <=_+ <=-refl (negative<=0 ab>=0) <=∘ =_<= zro-right
            | c<=cc : c <= c + c => =_<= (inv zro-right) <=∘ <=_+ <=-refl c>=0
            | bc : b ∧ c = 0 => IsBoolean-orth q (IsBoolean-trunc p)
            | ab2c=0 : (a ∧ b) ∧ (c + c) = 0
              => <=-antisymmetric (meet-monotone meet-right <=-refl <=∘ meet_+-subadditive (IsBoolean>=0 q) c>=0 c>=0 <=∘ =_<= (pmap2 (+) bc bc *> zro-left)) (meet-univ ab>=0 (<=_+-positive c>=0 c>=0))
            | tc : trunc c = c => <=-antisymmetric trunc-bound (meet-univ <=-refl (c<=a <=∘ =_<= (inv (IsBoolean-trunc p))) <=∘ trunc-assoc)
       \in <=-antisymmetric
            (meet-univ trunc-bound (trunc-mono (<=_+ c<=a c<=a) <=∘ =_<= p) <=∘ =_<= (meet-comm *> pmap (__ ∧ _) part+-split *> disjoint-rdistr c>=0 ab>=0 (<=_+-positive c>=0 c>=0) (IsBoolean_diff-disj p q) *> pmap2 (+) (<=-antisymmetric meet-left (meet-univ <=-refl c<=cc)) ab2c=0 *> zro-right))
            (=_<= (inv tc) <=∘ trunc-mono c<=cc)

  \lemma IsBoolean_abs {a b : E} (p : IsBoolean a) (q : IsBoolean b) : IsBoolean (abs (a - b))
    => transport IsBoolean (pmap (_ ∨) (inv part-_diff_part+) *> parts_join) (IsBoolean_join (IsBoolean_diff p q) (IsBoolean_diff q p))

  \lemma IsBoolean_diff-disj {a b : E} (p : IsBoolean a) (q : IsBoolean b) : part+ (a - b) ∧ (a ∧ b) = 0
    => <=-antisymmetric (meet-monotone <=-refl meet-right <=∘ =_<= (meet-comm *> IsBoolean-orth q (IsBoolean-trunc p))) (meet-univ join-right (meet-univ (IsBoolean>=0 p) (IsBoolean>=0 q)))

  \func BoolRing : BooleanRing (\Sigma (a : E) (IsBoolean a)) \cowith
    | zro => (0, IsBoolean_zro)
    | + a b => (abs (a.1 - b.1), IsBoolean_abs a.2 b.2)
    | +-assoc {x} {y} {z} => ext $ abs-formula *> pmap2 (\lam u v => u + z.1 - (v + v)) abs-formula (meet-comm *> meet-formula (IsBoolean>=0 z.2) x.2 y.2 *> meet-swap)
        *> equation.abGroup *> inv (abs-formula *> pmap2 (\lam u v => x.1 + u - (v + v)) abs-formula (meet-formula (IsBoolean>=0 x.2) y.2 z.2))
    | +-comm => ext abs_-
    | * a b => (a.1 ∧ b.1, IsBoolean_meet a.2 b.2)
    | *-assoc => ext meet-assoc
    | negative x => x
    | negative-left => ext $ pmap abs negative-right *> abs_zro
    | isBooleanRing => ext meet-idemp
    | *-comm => ext meet-comm
    | ldistr {x} {y} {z} => ext $ meet-formula (IsBoolean>=0 x.2) y.2 z.2 *> inv (abs-formula *> pmap (\lam w => x.1 ∧ y.1 + x.1 ∧ z.1 - (w + w))
        (meet-assoc *> pmap (x.1 ∧) (inv meet-assoc *> pmap (__ ∧ z.1) meet-comm *> meet-assoc) *> inv meet-assoc *> pmap (__ ∧ _) meet-idemp))
    | zro-left {x} => ext $ pmap abs zro-left *> abs_negative *> abs-ofPos (IsBoolean>=0 x.2)
    \where {
      \lemma abs-formula {a b : E} : abs (a - b) = a + b - (a ∧ b + a ∧ b)
        => inv parts_+ *> pmap2 (+) part+_diff_meet part-_diff_meet *> equation.abGroup

      \lemma meet-split {a b c : E} (c>=0 : 0 <= c) (p : IsBoolean a) (q : IsBoolean b) : c ∧ a = c ∧ part+ (a - b) + c ∧ (a ∧ b)
        => meet-comm *> pmap (__ ∧ c) part+-split *> disjoint-rdistr join-right (meet-univ (IsBoolean>=0 p) (IsBoolean>=0 q)) c>=0 (IsBoolean_diff-disj p q) *> pmap2 (+) meet-comm meet-comm

      \lemma meet-formula {a b c : E} (c>=0 : 0 <= c) (p : IsBoolean a) (q : IsBoolean b) : c ∧ abs (a - b) = c ∧ a + c ∧ b - (c ∧ (a ∧ b) + c ∧ (a ∧ b))
        => meet-comm *> pmap (__ ∧ c) (inv parts_+) *> disjoint-rdistr join-right join-right c>=0 parts_meet *> pmap2 (+) meet-comm (pmap (__ ∧ c) part-_diff_part+ *> meet-comm)
            *> inv (pmap2 (\lam u v => u + v - (c ∧ (a ∧ b) + c ∧ (a ∧ b))) (meet-split c>=0 p q) (meet-split c>=0 q p *> pmap (c ∧ part+ (b - a) +) (pmap (c ∧) meet-comm)) *> equation.abGroup)

      \lemma meet-swap {a b c : E} : c ∧ a + c ∧ b - (c ∧ (a ∧ b) + c ∧ (a ∧ b)) = a ∧ c + b ∧ c - (a ∧ (b ∧ c) + a ∧ (b ∧ c))
        => pmap2 (\lam u v => u + v - (c ∧ (a ∧ b) + c ∧ (a ∧ b))) meet-comm meet-comm *> pmap (\lam w => a ∧ c + b ∧ c - (w + w)) (meet-comm *> meet-assoc)

      \lemma join-char {a b : \Sigma (x : E) (IsBoolean x)} : (a BoolRing.∨ b).1 = a.1 ∨ b.1
        => \have m=0 : (a.1 ∧ b.1) ∧ abs (a.1 - b.1) = 0
                => meet-formula (meet-univ (IsBoolean>=0 a.2) (IsBoolean>=0 b.2)) a.2 b.2
                  *> pmap2 (\lam u v => u + v - ((a.1 ∧ b.1) ∧ (a.1 ∧ b.1) + (a.1 ∧ b.1) ∧ (a.1 ∧ b.1)))
                           (<=-antisymmetric meet-left (meet-univ <=-refl meet-left))
                           (<=-antisymmetric meet-left (meet-univ <=-refl meet-right))
                  *> pmap (\lam w => a.1 ∧ b.1 + a.1 ∧ b.1 - (w + w)) meet-idemp *> negative-right
           \in abs-formula *> pmap (\lam w => abs (a.1 - b.1) + a.1 ∧ b.1 - (w + w)) (meet-comm *> m=0)
              *> pmap (\lam u => u + a.1 ∧ b.1 - (0 + 0)) (abs-formula *> pmap (\lam v => v - (a.1 ∧ b.1 + a.1 ∧ b.1)) modularity) *> equation.abGroup
    }
}

\record TruncRieszSpaceHom \extends RieszSpaceHom {
  \override Dom : TruncRieszSpace
  \override Cod : TruncRieszSpace

  | func-trunc {x : Dom} : func (trunc x) = trunc (func x)
} \where {
  \func id {X : TruncRieszSpace} : TruncRieszSpaceHom X X \cowith
    | RieszSpaceHom => RieszSpaceHom.id
    | func-trunc => idp

  \func \fixl 8 compose \alias \infixl 8 ∘ {X Y Z : TruncRieszSpace} (g : TruncRieszSpaceHom Y Z) (f : TruncRieszSpaceHom X Y) : TruncRieszSpaceHom X Z \cowith
    | RieszSpaceHom => g RieszSpaceHom.∘ f
    | func-trunc => pmap g func-trunc *> func-trunc
}