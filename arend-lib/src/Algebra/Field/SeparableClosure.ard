{- | **Separable closure and purely inseparable extensions** (Mines–Richman–Ruitenburg, §VI.6).

     Let `f : k -> E` be an extension of discrete fields.

     * `adjoinSubField f a ai`: for `a` integral over `k`, the subring `k[a]` is a subfield of `E`; more generally
       `algebraicSubField f l li` is the subfield `k[l]` generated by integral elements.
     * `separableClosure f`: the *separable closure* of `k` in `E`, the subfield of elements separable over `k`;
       `IsSeparablyClosed f`: `k` is separably closed in `E`, that is, every separable element comes from `k`.
     * `IsPurelyInseparable f a`: $a^q \in k$ for some characteristic exponent `q`; `IsPurelyInseparableExt f`: every
       element of `E` is purely inseparable over `k`.
     * **Theorem VI.6.7** (`primitive-element-rel`, `separable-rel`): if `a` is algebraic over `k` and `b` is separable
       over `k[a]`, then $k[a, b] = k[\theta]$ for some `θ`; if moreover `a` is separable over `k`, then so is `b`.
       Hence the separable closure is separably closed (`separableClosure-separablyClosed`).
     * **Theorem VI.6.8** (`separable-purelyInseparable`): if `E` is a finite-dimensional extension of `k`, then there is a
       finitely generated subfield `K = k[l]` of `E`, separable over `k`, such that `E` is purely inseparable over `K`.
-}

\import Algebra.Field
\import Algebra.Field.Algebraic
\import Algebra.Field.PrimitiveElement
\import Algebra.Field.PrimitiveElementExists
\import Algebra.Field.SeparableCharP
\import Algebra.Field.SeparableElements
\import Algebra.Field.SubField
\import Algebra.Module
\import Algebra.Monoid
\import Algebra.Monoid.SubMonoid
\import Algebra.Pointed
\import Algebra.Ring
\import Algebra.Ring.Characteristic
\import Algebra.Ring.Integral
\import Algebra.Ring.Poly
\import Algebra.Ring.Poly.Separable
\import Algebra.Ring.RingHom
\import Algebra.Ring.SubRing
\import Arith.Nat
\import Function.Meta
\import Logic
\import Logic.Meta
\import Meta
\import Paths
\import Paths.Meta
\import Set
\import Set.Fin
\open Monoid

-- # Subfields generated by algebraic elements

-- | A separable element is integral.
\lemma separable-integral {k : DiscreteField} {E : CRing} {f : RingHom k E} {a : E} (s : IsSeparableElement f a) : isIntegral f a
  => TruncP.map (separableElement-monic s) \lam t => (t.1, t.2, t.4)

-- | An integral element is algebraic.
\lemma integral-algebraic {k E : DiscreteField} {f : RingHom k E} {a : E} (ai : isIntegral f a) : ∃ (g : Poly k) (g /= 0) (polyMapEval f g a = 0)
  \elim ai
  | inP (p, inP (n, d, c), pe) => inP (p, \lam p=0 => k.zro/=ide (inv (pmap (polyCoef __ n) p=0) *> c), pe)

-- | The inverse of an integral element `a` lies in `k[a]`.
\lemma polyImage-finv {k E : DiscreteField} (f : RingHom k E) {a : E} (ai : isIntegral f a) : polyImage f a (finv a)
  => \case decideEq a 0 \with {
    | yes a=0 => transportInv (\lam z => polyImage f a (finv z)) a=0 (transportInv (polyImage f a) finv_zro (polyImage f a).contains_zro)
    | no a/=0 => \let | K => polyImage_field f a ai
                      | y => K.finv (a, polyImage-element)
                 \in \have ay : a * y.1 = 1 => pmap __.1 (K.finv-right {(a, polyImage-element)} \lam p => a/=0 (pmap __.1 p))
                 \in transport (polyImage f a) (inv ide-left *> pmap (* y.1) (inv (*-comm *> finv-right a/=0)) *> *-assoc *> pmap (finv a *) ay *> ide-right) y.2
  }

-- | For `a` integral over `k`, the subfield `k[a]` of `E`.
\func adjoinSubField {k E : DiscreteField} (f : RingHom k E) (a : E) (ai : isIntegral f a) : SubField E \cowith
  | SubRing => polyImage f a
  | contains_finv {x} xa => polyImage-sub f x (polyImage f a) (polyImage-ext f a) xa (polyImage-finv f (polyImage_integral f a ai xa))

-- | For integral elements `l`, the subfield `k[l]` of `E`.
\func algebraicSubField {k E : DiscreteField} (f : RingHom k E) (l : Array E) (li : \Pi (j : Fin l.len) -> isIntegral f (l j)) : SubField E \cowith
  | SubRing => mPolyImage f l
  | contains_finv {x} xl => polyImage-sub f x (mPolyImage f l) (mPolyImage-ext f l) xl
                              (polyImage-finv f (mPolyImage-sub f l (integralClosure-subring f) (\lam c => separable-integral (separableElement-const f c)) li xl))

-- # Separable closure, purely inseparable elements

-- | The separable closure of `k` in `E`: the subfield of elements separable over `k`.
\func separableClosure {k E : DiscreteField} (f : RingHom k E) : SubField E \cowith
  | SubRing => separableSubring f
  | contains_finv {x} xs => polyImage_separable xs (polyImage-finv f (separable-integral xs))

-- | `k` is separably closed in `E`: every element of `E` separable over `k` comes from `k`.
\type IsSeparablyClosed {k E : DiscreteField} (f : RingHom k E) : \Prop
  => \Pi (a : E) -> IsSeparableElement f a -> ∃ (c : k) (f c = a)

-- | `a` is purely inseparable over `k`: $a^q \in k$ for a characteristic exponent `q` of `k`.
\type IsPurelyInseparable {k E : DiscreteField} (f : RingHom k E) (a : E) : \Prop
  => ∃ (q : Nat) (IsCharExponent k q) (c : k) (f c = pow a q)

-- | `E` is a purely inseparable extension of `k`.
\type IsPurelyInseparableExt {k E : DiscreteField} (f : RingHom k E) : \Prop
  => \Pi (a : E) -> IsPurelyInseparable f a

-- # Theorem VI.6.7

-- | **Theorem VI.6.7.** If `a` is algebraic over `k` and `b` is separable over `k[a]`, then $k[a, b]$ has a primitive element.
\lemma primitive-element-rel {k E : DiscreteField} (f : RingHom k E) {a b : E} (ai : isIntegral f a)
  (bs : IsSeparableElement {IDiscreteField (adjoinSubField f a ai)} (SubField.embed (adjoinSubField f a ai)) b)
  : ∃ (t : ICRing (mPolyImage f (a :: b :: nil))) (IsPrimitiveElement (adjoinHom f (a :: b :: nil)) t)
  => \case separable-power f (integral-algebraic (rel-integral f ai bs)) \with {
    | inP (q, cq, bqs) => \case rel-core f ai bs cq bqs \with {
      | inP (t, tab, at, bt) => inP ((t, tab), primitive-generators f (a :: b :: nil) tab \case \elim __ \with {
        | 0 => at
        | 1 => bt
      })
    }
  }
  \where {
    -- | Integrality over `k[a]` implies integrality over `k`.
    \lemma rel-integral {k E : DiscreteField} (f : RingHom k E) {a b : E} (ai : isIntegral f a)
      (bs : IsSeparableElement {IDiscreteField (adjoinSubField f a ai)} (SubField.embed (adjoinSubField f a ai)) b) : isIntegral f b
      => \let | K => adjoinSubField f a ai
              | g : RingHom k (IDiscreteField K) => SubField.corestrict K f (polyImage-ext f a)
              | fi : isIntegralExt g => \lam x => TruncP.map (polyImage_integral f a ai x.2) \lam t =>
                  (t.1, t.2, ext (inv polyEval_polyMap *> pmap (polyEval __ x.1) (polyMap-comp g (SubField.embed K) *> polyMap-ext (\lam _ => idp)) *> t.3))
         \in TruncP.map (integral-comp {k} {IDiscreteField K} {E} {g} {SubField.embed K} fi (separable-integral bs)) \lam t =>
               (t.1, t.2, pmap (polyEval __ b) (polyMap-ext \lam _ => idp) *> t.3)

    -- | `k[a][t]` is contained in `k[a, t]`.
    \lemma rel-lift {k E : DiscreteField} (f : RingHom k E) {a t x : E} (ai : isIntegral f a)
      (r : polyImage (SubField.embed (adjoinSubField f a ai)) t x) : mPolyImage f (a :: t :: nil) x
      => polyImage-sub (SubField.embed (adjoinSubField f a ai)) t (mPolyImage f (a :: t :: nil))
           (\lam c => polyImage-sub f a (mPolyImage f (a :: t :: nil)) (mPolyImage-ext f _) (mPolyImage-element f (a :: t :: nil) 0) c.2)
           (mPolyImage-element f (a :: t :: nil) 1) r

    -- | The core of Theorem VI.6.7: given `q` with $b^q$ separable over `k`, a primitive element of $k[a, b]$.
    \lemma rel-core {k E : DiscreteField} (f : RingHom k E) {a b : E} (ai : isIntegral f a)
      (bs : IsSeparableElement {IDiscreteField (adjoinSubField f a ai)} (SubField.embed (adjoinSubField f a ai)) b)
      {q : Nat} (cq : IsCharExponent k q) (bqs : IsSeparableElement f (pow b q))
      : ∃ (t : E) (mPolyImage f (a :: b :: nil) t) (polyImage f t a) (polyImage f t b)
      => \let | K => adjoinSubField f a ai
              | g : RingHom k (IDiscreteField K) => SubField.corestrict K f (polyImage-ext f a)
              | bK => separable-polyImage-pow {IDiscreteField K} (SubField.embed K) (IsCharExponent_map g cq) bs
         \in \case primitive-element f (integral-algebraic ai) bqs \with {
           | inP (t, pe) =>
             \have | at => primitive-generators-conv f (a :: pow b q :: nil) pe 0
                   | bqt => primitive-generators-conv f (a :: pow b q :: nil) pe 1
             \in inP (t.1,
                      mPolyImage-sub f (a :: pow b q :: nil) (mPolyImage f (a :: b :: nil)) (mPolyImage-ext f _) (\case \elim __ \with {
                        | 0 => mPolyImage-element f (a :: b :: nil) 0
                        | 1 => (mPolyImage f (a :: b :: nil)).contains_pow (mPolyImage-element f (a :: b :: nil) 1)
                      }) t.2,
                      at,
                      mPolyImage-sub f (a :: pow b q :: nil) (polyImage f t.1) (polyImage-ext f t.1) (\case \elim __ \with {
                        | 0 => at
                        | 1 => bqt
                      }) (rel-lift f ai bK))
         }
  }

-- | **Theorem VI.6.7.** If `a` is separable over `k` and `b` is separable over `k[a]`, then `b` is separable over `k`.
\lemma separable-rel {k E : DiscreteField} (f : RingHom k E) {a b : E} (as : IsSeparableElement f a)
  (bs : IsSeparableElement {IDiscreteField (adjoinSubField f a (separable-integral as))} (SubField.embed (adjoinSubField f a (separable-integral as))) b) : IsSeparableElement f b
  => \have ai => separable-integral as
     \in \case separable-power f (integral-algebraic (primitive-element-rel.rel-integral f ai bs)) \with {
       | inP (q, cq, bqs) => \case primitive-element-rel.rel-core f ai bs cq bqs, cq \with {
         | _, byLeft q=1 => transport (IsSeparableElement f) (pmap (pow b) q=1 *> ide-left) bqs
         | inP (t, tab, at, bt), byRight (inP (p, e, pp, pz, qe)) =>
           \let | K => adjoinSubField f a ai
                | g : RingHom k (IDiscreteField K) => SubField.corestrict K f (polyImage-ext f a)
                | c1 : IsCharExponent k (pow p 1) => byRight (inP (p, 0, pp, pz, idp))
           \in \have | aa1 => separable-polyImage-pow f c1 as
                     | bb1 => primitive-element-rel.rel-lift f ai (separable-polyImage-pow {IDiscreteField K} (SubField.embed K) (IsCharExponent_map g c1) bs)
                     | a-t1 : polyImage f (pow t (pow p 1)) a => polyImage-sub f (pow a (pow p 1)) (polyImage f (pow t (pow p 1))) (polyImage-ext f _) (polyImage-charPow f c1 at) aa1
                     | b-t1 : polyImage f (pow t (pow p 1)) b => mPolyImage-sub f (a :: pow b (pow p 1) :: nil) (polyImage f (pow t (pow p 1))) (polyImage-ext f _) (\case \elim __ \with {
                         | 0 => a-t1
                         | 1 => polyImage-charPow f c1 bt
                       }) bb1
                     | t-t1 : polyImage f (pow t (pow p 1)) t => mPolyImage-sub f (a :: b :: nil) (polyImage f (pow t (pow p 1))) (polyImage-ext f _) (\case \elim __ \with {
                         | 0 => a-t1
                         | 1 => b-t1
                       }) tab
           \in polyImage_separable ((separable<->polyImage-pow f pp pz 0).2 t-t1) bt
       }
     }

-- | **The separable closure is separably closed**: an element separable over the separable closure of `k` is separable over `k`.
\lemma separableClosure-separablyClosed {k E : DiscreteField} (f : RingHom k E)
  : IsSeparablyClosed {IDiscreteField (separableClosure f)} (SubField.embed (separableClosure f))
  => \lam b bs => inP ((b, closure-separable f bs), idp)
  \where {
    -- | An element separable over the separable closure is separable over `k`.
    \lemma closure-separable {k E : DiscreteField} (f : RingHom k E) {b : E}
      (bs : IsSeparableElement {IDiscreteField (separableClosure f)} (SubField.embed (separableClosure f)) b) : IsSeparableElement f b
      => \case separableElement-monic bs \with {
        | inP (g, inP (n, d, c1), gs, gb) =>
          \let Ks => separableClosure f
          \in \case separable-primitive-array f (\new Array E (suc n) (\lam j => (polyCoef g j).1)) (\lam j => (polyCoef g j).2) \with {
            | inP (t, ts, tl) =>
              \let | K => adjoinSubField f t (separable-integral ts)
                   | P => polyMap (SubField.embed Ks) g
                   | D => primitive-element.descend K P (degree<=_polyMap d) (polyCoef_polyMap *> pmap __.1 c1) (\lam j => transportInv K polyCoef_polyMap (tl j))
                   | jh : RingHom (IDiscreteField K) (IDiscreteField Ks) => SubField.corestrict Ks (SubField.embed K) (\lam x => polyImage_separable ts x.2)
              \in \have ge : polyMap jh D.1 = g => polyMap-inj (RingHom.field-isInj {IDiscreteField Ks} {E} {SubField.embed Ks})
                                                     (polyMap-comp jh (SubField.embed Ks) {D.1} *> polyMap-ext {_} {_} {_} {SubField.embed K} (\lam _ => idp) {D.1} *> D.2)
              \in separable-rel f ts (inP (D.1, IsSeparable_polyMap-conv {IDiscreteField K} {IDiscreteField Ks} jh (transportInv IsSeparable ge gs), pmap (polyEval __ b) D.2 *> gb))
          }
      }

    -- | Finitely many separable elements lie in `k[θ]` for some separable `θ`.
    \lemma separable-primitive-array {k E : DiscreteField} (f : RingHom k E) (l : Array E) (ls : \Pi (j : Fin l.len) -> IsSeparableElement f (l j))
      : ∃ (t : E) (IsSeparableElement f t) (\Pi (j : Fin l.len) -> polyImage f t (l j)) \elim l
      | nil => inP (0, transport (IsSeparableElement f) f.func-zro (separableElement-const f 0), \case __)
      | x :: l => \case separable-primitive-array f l (\lam j => ls (suc j)) \with {
        | inP (t0, t0s, tl) => \case primitive-element f (integral-algebraic (separable-integral t0s)) (ls 0) \with {
          | inP (t, pe) =>
            \have t0t => primitive-generators-conv f (t0 :: x :: nil) pe 0
            \in inP (t.1, mPolyImage_separable {_} {_} {f} {t0 :: x :: nil} (\case \elim __ \with { | 0 => t0s | 1 => ls 0 }) t.2, \case \elim __ \with {
              | 0 => primitive-generators-conv f (t0 :: x :: nil) pe 1
              | suc j => polyImage-sub f t0 (polyImage f t.1) (polyImage-ext f t.1) t0t (tl j)
            })
        }
      }
  }

-- # Theorem VI.6.8

-- | **Theorem VI.6.8.** If `E` is finitely generated as a vector space over `k`, then there is a finitely generated subfield `K = k[l]` of `E`, separable over `k`, such that `E` is purely inseparable over `K`.
\lemma separable-purelyInseparable {k E : DiscreteField} (f : RingHom k E) (fg : LModule.IsFinitelyGenerated {homLModule f})
  : ∃ (l : Array E) (li : \Pi (j : Fin l.len) -> isIntegral f (l j))
      (\Pi (x : E) -> mPolyImage f l x -> IsSeparableElement f x)
      (IsPurelyInseparableExt {IDiscreteField (algebraicSubField f l li)} (SubField.embed (algebraicSubField f l li)))
  \elim fg
  | inP (gen, gg) =>
    \have fi : isIntegralExt f => finite-integralExt (inP (gen, gg))
    \in \case FinSet.finiteAC (\lam (j : Fin gen.len) => separable-power f (integral-algebraic (fi (gen j)))) \with {
      | inP qs =>
        \let | l => \new Array E gen.len (\lam j => pow (gen j) (qs j).1)
             | li (j : Fin gen.len) : isIntegral f (l j) => fi (l j)
             | K => algebraicSubField f l li
        \in inP (l, li, \lam x xl => mPolyImage_separable {_} {_} {f} {l} (\lam j => (qs j).3) xl, \lam x =>
              \case charExp-common k.zro/=ide (\lam j => (qs j).1) (\lam j => (qs j).2) \with {
                | inP (Q, cQ, divs) =>
                  \have | xg : mPolyImage f gen x => \case gg x \with {
                          | inP (c, xc) => transportInv (mPolyImage f gen) xc $ (mPolyImage f gen).contains_BigSum {\new Array E gen.len (\lam i => f (c i) * gen i)} \lam j =>
                              (mPolyImage f gen).contains_* (mPolyImage-ext f gen (c j)) (mPolyImage-element f gen j)
                        }
                        | xQ : K (pow x Q) => mPolyImage-sub f gen (PreimageRing (charExpHom (IsCharExponent_map f cQ)) K)
                            (\lam c => transport K f.func-pow (mPolyImage-ext f l (pow c Q)))
                            (\lam j => \case divs j \with {
                              | inP d => transport K (inv Monoid.pow_* *> pmap (pow (gen j)) d.inv-right) (K.contains_pow (mPolyImage-element f l j))
                            }) xg
                  \in inP (Q, IsCharExponent_map (SubField.corestrict K f (mPolyImage-ext f l)) cQ, (pow x Q, xQ), idp)
              })
    }