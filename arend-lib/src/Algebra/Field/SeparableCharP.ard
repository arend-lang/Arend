{- | **Separability and characteristic `p`** (Mines–Richman–Ruitenburg, §VI.6).

     Let `f : k -> E` make a commutative ring `E` an extension of a discrete field `k`.

     * `polyImage-sub`, `mPolyImage-sub`: `k[t]` and `k[l]` are contained in every subring containing `f k` and the
       generators; hence `k[t]` consists of separable elements if `t` is separable (`polyImage_separable`), and
       $x \in k[t]$ implies $x^q \in k[t^q]$ for a characteristic exponent `q` (`polyImage-charPow`).
     * **Theorem VI.6.2** (`separable<->polyImage-pow`): if `q` is a positive power of a prime that is zero in `k`, then
       `a` is separable over `k` if and only if $a \in k[a^q]$. The forward direction holds for every characteristic
       exponent (`separable-polyImage-pow`): represent `a` by the companion matrix `B` of a separable polynomial; `B` is
       a polynomial in $B^q$ (`separable-polyIn-pow`), and the same polynomial expresses `a` in terms of $a^q$.
-}

\import Algebra.Field
\import Algebra.Field.PrimitiveElement
\import Algebra.Field.PrimitiveElementExists
\import Algebra.Field.SeparableElements
\import Algebra.Group
\import Algebra.Linear.Matrix
\import Algebra.Linear.Matrix.AlgebraicPair
\import Algebra.Linear.Matrix.Companion
\import Algebra.Linear.Matrix.PolyEval
\import Algebra.Linear.Matrix.Separable
\import Algebra.Linear.Matrix.SeparablePower
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Monoid.Prime
\import Algebra.Pointed
\import Algebra.Ring
\import Algebra.Ring.Characteristic
\import Algebra.Ring.Integral
\import Algebra.Ring.MPoly
\import Algebra.Ring.MPoly.Rename
\import Algebra.Ring.Poly
\import Algebra.Ring.Poly.Derivative
\import Algebra.Ring.Poly.Expand
\import Algebra.Ring.Poly.Monic
\import Algebra.Ring.Poly.PurePower
\import Algebra.Ring.Poly.Separable
\import Algebra.Ring.Poly.SeparableFactorization
\import Algebra.Ring.RingHom
\import Algebra.Ring.SubRing
\import Algebra.Semiring
\import Arith.Nat
\import Data.Array
\import Function.Meta
\import Algebra.Module.Primary
\import Order.Biordered
\import Arith.Prime
\import Logic
\import Order.StrictOrder
\import Logic.Meta
\import Meta
\import Paths
\import Paths.Meta
\import Set
\import Set.Fin
\open Monoid
\open PolyRing
\open DiscreteField

-- # Subrings generated by elements

-- | `k[t]` is contained in every subring containing `f k` and `t`.
\lemma polyImage-sub {R : Ring} {E : CRing} (f : RingHom R E) (t : E) (S : SubRing E) (Sf : \Pi (c : R) -> S (f c)) (St : S t)
  {x : E} (xi : polyImage f t x) : S x \elim xi
  | inP (u, ue) => transport S ue (aux u)
  \where
    \private \lemma aux (u : Poly R) : S (polyMapEval f u t) \elim u
      | pzero => S.contains_zro
      | padd u e => S.contains_+ (S.contains_* (aux u) St) (Sf e)

-- | `k[l]` is contained in every subring containing `f k` and the elements of `l`.
\lemma mPolyImage-sub {R E : CRing} (f : RingHom R E) (l : Array E) (S : SubRing E) (Sf : \Pi (c : R) -> S (f c))
  (Sl : \Pi (j : Fin l.len) -> S (l j)) {x : E} (xl : mPolyImage f l x) : S x \elim xl
  | inP (w, we) => transport S we $ mPoly-ind (PreimageRing (mPolyMapEvalRingHom f l) S)
      (\lam r => transportInv S (primitive-generators.const-eval f l r) (Sf r))
      (\lam j => transportInv S (mPolyMapEval-var f l j) (Sl j)) w

-- | Elements of `k[t]` are separable if `t` is.
\lemma polyImage_separable {k : DiscreteField} {E : CRing} {f : RingHom k E} {t : E} (ts : IsSeparableElement f t)
  {x : E} (xi : polyImage f t x) : IsSeparableElement f x
  => polyImage-sub f t (separableSubring f) (separableElement-const f) ts xi

-- | Elements of `k[l]` are separable if the elements of `l` are.
\lemma mPolyImage_separable {k : DiscreteField} {E : CRing} {f : RingHom k E} {l : Array E}
  (ls : \Pi (j : Fin l.len) -> IsSeparableElement f (l j)) {x : E} (xl : mPolyImage f l x) : IsSeparableElement f x
  => mPolyImage-sub f l (separableSubring f) (separableElement-const f) ls xl

-- | If $x \in k[t]$, then $x^q \in k[t^q]$ for a characteristic exponent `q` of `k`.
\lemma polyImage-charPow {k : CRing} {E : CRing} (f : RingHom k E) {q : Nat} (c : IsCharExponent k q) {t x : E} (xi : polyImage f t x)
  : polyImage f (pow t q) (pow x q)
  => \let h => charExpHom (IsCharExponent_map f c)
     \in polyImage-sub f t (PreimageRing h (polyImage f (pow t q)))
           (\lam a => transport (polyImage f (pow t q)) f.func-pow (polyImage-ext f (pow t q) (pow a q)))
           polyImage-element xi

-- | If $x \in k[l]$, then $x^q \in k[l^q]$ for a characteristic exponent `q` of `k`.
\lemma mPolyImage-charPow {k E : CRing} (f : RingHom k E) {q : Nat} (c : IsCharExponent k q) {l : Array E} {x : E} (xl : mPolyImage f l x)
  : mPolyImage f (map (pow __ q) l) (pow x q)
  => \let h => charExpHom (IsCharExponent_map f c)
     \in mPolyImage-sub f l (PreimageRing h (mPolyImage f (map (pow __ q) l)))
           (\lam a => transport (mPolyImage f (map (pow __ q) l)) f.func-pow (mPolyImage-ext f _ (pow a q)))
           (\lam j => mPolyImage-element f (map (pow __ q) l) j) xl

-- # Theorem VI.6.2

-- | **Theorem VI.6.2, forward direction.** A separable element `a` lies in $k[a^q]$ for every characteristic exponent `q`.
\lemma separable-polyImage-pow {k : DiscreteField} {E : CRing} (f : RingHom k E) {q : Nat} (c : IsCharExponent k q) {a : E}
  (s : IsSeparableElement f a) : polyImage f (pow a q) a
  => \case separableElement-monic s \with {
    | inP (P, inP (n, d, c1), ps, pa) =>
      \let | cs : Array k n => \new Array k n (\lam j => polyCoef P j)
           | B => companion cs
      \in \have | pe : P = monicPoly cs => monicPoly-polyCoef d c1
                | root : polyMapEval f (monicPoly cs) a = 0 => transport (\lam P => polyMapEval f P a = 0) pe pa
                | Bs : IsSeparableMatrix B => inP (P, ps, transportInv (\lam P => matPolyEval P B = 0) pe companion-annihilates)
                | rep : MatRepresents f (\lam i => pow a i) B a => companion-represents f root
      \in \case separable-polyIn-pow Bs c \with {
        | inP (r, re) => inP (r, pmap (polyMapEval f r) (inv polyMapEval_monomial)
            *> primitive-pair.rep-unique (\lam i => natDelta i 0) (companion-unit f root)
                 (transport (MatRepresents f _ __ _) re (rep-poly (rep-poly rep {monomial 1 q}) {r})) rep)
      }
  }

-- | **Theorem VI.6.2.** If `p` is a prime zero in `k` and `q` a positive power of `p`, then `a` is separable over `k` if and only if $a \in k[a^q]$.
\lemma separable<->polyImage-pow {k : DiscreteField} {E : CRing} (f : RingHom k E) {p : Nat} (pp : Prime p) (pz : k.natCoef p = 0) (e : Nat) {a : E}
  : IsSeparableElement f a <-> polyImage f (pow a (pow p (suc e))) a
  => (separable-polyImage-pow f (byRight (inP (p, e, pp, pz, idp))), \lam (inP (u, ue)) =>
      \let | q => pow p (suc e)
           | g => polyExpand q u + negative (padd 1 0)
      \in \have | qz : k.natCoef q = 0 => Semiring.natCoef_* *> pmap (_ *) pz *> zro_*-right
                | gd : polyDeriv g = negative 1 => polyDeriv_+ *> pmap2 (+) (polyDeriv_expand qz) (polyDeriv_negative {k} {padd 1 0} *> pmap negative polyDeriv_X) *> zro-left
                | ga : polyMapEval f g a = 0 => (polyMapEvalRingHom f a).func-+ *> pmap2 (+) (polyMapEval_expand f *> ue)
                                                  ((polyMapEvalRingHom f a).func-negative {padd 1 0} *> pmap negative (polyMapEval_monomial {f} {a} {1} *> ide-left)) *> negative-right
      \in inP (g, inP (0, negative 1, pmap2 (+) (zro_*-left {_} {g}) (pmap (negative 1 *) gd *> neg-neg) *> zro-left), ga))
  \where
    \lemma neg-neg {R : Ring} : negative 1 * negative 1 = {R} 1
      => R.negative_*-left *> pmap negative (R.negative_*-right *> pmap negative ide-left) *> R.negative-isInv

-- # Corollary VI.6.4 and Theorem VI.6.6

-- | **Corollary VI.6.4.** If `a` is algebraic over a discrete subfield `k` of a discrete field `E`, then $a^q$ is separable over `k` for some characteristic exponent `q` of `k`.
\lemma separable-power {k E : DiscreteField} (f : RingHom k E) {a : E} (aa : ∃ (g : Poly k) (g /= 0) (polyMapEval f g a = 0))
  : ∃ (q : Nat) (IsCharExponent k q) (IsSeparableElement f (pow a q)) \elim aa
  | inP (g, g/=0, ga) =>
    \let G => finv (leadCoef g) *c g
    \in \case separable-factorization (G :: nil) (\case \elim __ \with { | 0 => field-toMonic g/=0 }) \with {
      | inP (T, Tf, _, Sp) => \case Sp 0 \with {
        | inP (m, Ge) => \case prod-zero (\lam j => polyMapEval f (T j) a) m
                                 (inv ((polyMapEvalRingHom f a).func-BigProd *> pmap Monoid.BigProd (exts \lam j => (polyMapEvalRingHom f a).func-pow))
                                   *> pmap (polyMapEval f __ a) (inv Ge) *> (polyMapEval-toMonic f g/=0).2 ga) \with {
          | inP (j, Tja) => \case (Tf j).2 \with {
            | inP (q, h, cq, hs, Te) => inP (q, cq, inP (h, hs, inv (polyMapEval_expand f) *> pmap (polyMapEval f __ a) (inv Te) *> Tja))
          }
        }
      }
    }
  \where
    -- | If a product of powers vanishes in a discrete field, then one of the factors vanishes.
    \lemma prod-zero {E : DiscreteField} {n : Nat} (x : Array E n) (m : Array Nat n)
      (p : Monoid.BigProd (\lam j => pow (x j) (m j)) = 0) : ∃ (j : Fin n) (x j = 0) \elim n
      | 0 => absurd (E.zro/=ide (inv p))
      | suc n => \case E.zeroProduct p \with {
        | byLeft p0 => inP (0, E.noNilpotent p0)
        | byRight p1 => TruncP.map (prod-zero (\lam j => x (suc j)) (\lam j => m (suc j)) p1) \lam t => (suc t.1, t.2)
      }

-- | **Theorem VI.6.6.** Let `p` be a prime zero in a discrete field `k` and `q` a positive power of `p`. If $X^q - a$ is reducible over `k`, then `a` is a `p`-th power.
\lemma reducible-root {k : DiscreteField} {p : Nat} (pp : Prime p) (pz : k.natCoef p = 0) (e : Nat) {a : k} {g h : Poly k}
  (gd : 0 < degree g) (hd : 0 < degree h) (gh : monomial 1 (pow p (suc e)) - padd pzero a = g * h) : ∃ (b : k) (a = pow b p)
  => \let | q => pow p (suc e)
          | P => monomial 1 q - padd pzero a
     \in \have | q>0 : 0 < q => pow-pos pp {suc e}
               | Pm : isMonic P => P-monic q>0
               | g/=0 : g /= 0 => \lam g=0 => <-irreflexive (transport (\lam x => 0 < degree x) g=0 gd)
               | h/=0 : h /= 0 => \lam h=0 => <-irreflexive (transport (\lam x => 0 < degree x) h=0 hd)
               | lg/=0 : leadCoef g /= 0 => \lam c => g/=0 (leadCoef=0-lem c)
               | lh/=0 : leadCoef h /= 0 => \lam c => h/=0 (leadCoef=0-lem c)
               | PGH : P = (finv (leadCoef g) *c g) * (finv (leadCoef h) *c h) => normalize gh (monic-leadCoef Pm)
               | Gd : 0 < degree (finv (leadCoef g) *c g) => transportInv (0 <) (degree_*c (finv/=0 lg/=0)) gd
               | Hd : 0 < degree (finv (leadCoef h) *c h) => transportInv (0 <) (degree_*c (finv/=0 lh/=0)) hd
     \in \case separable-factorization (finv (leadCoef g) *c g :: finv (leadCoef h) *c h :: nil) (\case \elim __ \with {
           | 0 => field-toMonic g/=0
           | 1 => field-toMonic h/=0
         }) \with {
       | inP (T, Tf, Tc, Sp) => \case Sp 0, Sp 1 \with {
         | inP (m, Ge), inP (n, He) => main pp pz e (\lam j => (Tf j).1) Tc (PGH *> pmap2 (*) Ge He) (rewrite Ge in Gd) (rewrite He in Hd)
       }
     }
  \where {
    \lemma pow-pos {p : Nat} (pp : Prime p) {n : Nat} : 0 < pow p n \elim n
      | 0 => NatOrder.zero<suc
      | suc n => NatSemiring.<_*_positive_positive (pow-pos pp) (NatOrder.zero<suc <∘ prime>1 pp)

    -- | $X^q - a$ is monic for `q > 0`.
    \lemma P-monic {k : DiscreteField} {q : Nat} (q>0 : 0 < q) {a : k} : isMonic (monomial 1 q - padd pzero a)
      => leadCoef-monic $ leadCoef_+ (P-deg-lt q>0 {a}) *> leadCoef_monomial

    \lemma P-deg-lt {k : DiscreteField} {q : Nat} (q>0 : 0 < q) {a : k} : degree (negative (padd pzero a)) < degree (monomial {k} 1 q)
      => transportInv (_ <) (degree_monomial (\lam p => k.zro/=ide (inv p))) (degree<=_degree {k} {negative (padd pzero a)} (degree<=_negative-const a) <∘r q>0)
      \where {
        \lemma degree<=_negative-const {k : DiscreteField} (a : k) : degree<= (negative (padd pzero a)) 0 => idp
      }

    -- | $X^q - a$ has degree `q`.
    \lemma P-deg {k : DiscreteField} {q : Nat} (q>0 : 0 < q) {a : k} : degree (monomial 1 q - padd pzero a) = q
      => degree_+ (P-deg-lt q>0 {a}) *> degree_monomial (\lam p => k.zro/=ide (inv p))

    -- | Normalizing the factors of a monic polynomial to monic ones.
    \lemma normalize {k : DiscreteField} {P g h : Poly k} (gh : P = g * h) (Pl : leadCoef P = 1)
      : P = (finv (leadCoef g) *c g) * (finv (leadCoef h) *c h)
      => \have | lgh : leadCoef g * leadCoef h = 1 => inv leadCoef_* *> pmap leadCoef (inv gh) *> Pl
               | c1 : finv (leadCoef g) * finv (leadCoef h) = 1 => inv finv_* *> pmap finv (*-comm *> lgh) *> finv_ide
         \in gh *> inv (pmap2 (*) *c_* *c_* *> alg {_} {padd pzero (finv (leadCoef g))} {padd pzero (finv (leadCoef h))} {g} {h} *> pmap (* (g * h)) (inv polyHom.func-* *> pmap (padd pzero) c1) *> ide-left)
      \where
        \lemma alg {R : CRing} {x y u v : R} : (x * u) * (y * v) = (x * y) * (u * v) => equation.cRing

    \lemma sum-one {x y : Nat} (x/=0 : x /= 0) (y/=0 : y /= 0) (s : x Nat.+ y = 1) : Empty \elim x, y
      | 0, _ => x/=0 idp
      | _, 0 => y/=0 idp
      | suc x, suc y => suc/=0 (pmap pred s)

    -- | `y` at `j0`, `z` elsewhere.
    \func sel {X : \Type} {N : Nat} (j0 j : Fin N) (y z : X) : X => \case decideEq j j0 \with {
      | yes _ => y
      | no _ => z
    }

    \lemma sel-yes {X : \Set} {N : Nat} {j0 : Fin N} {y z : X} : sel j0 j0 y z = y
      => unfold sel (rewrite (decideEq=_reduce idp) idp)

    \lemma sel-no {X : \Set} {N : Nat} {j0 j : Fin N} (ne : j /= j0) {y z : X} : sel j0 j y z = z
      => unfold sel (rewrite (decideEq/=_reduce ne) idp)

    \lemma sel-cases {X : \Set} {N : Nat} (Q : X -> \Prop) {j0 j : Fin N} {y z : X} (qy : j = j0 -> Q y) (qz : j /= j0 -> Q z) : Q (sel j0 j y z)
      => \case decideEq j j0 \with {
        | yes e => transport (\lam i => Q (sel j0 i y z)) (inv e) (transportInv Q sel-yes (qy e))
        | no ne => transportInv Q (sel-no ne) (qz ne)
      }

    -- | The core of Theorem VI.6.6, for monic factors `G = ∏ T_j^{m_j}` and `H = ∏ T_j^{n_j}` of positive degree.
    \lemma main {k : DiscreteField} {p : Nat} (pp : Prime p) (pz : k.natCoef p = 0) (e : Nat) {a : k} {N : Nat} {T : Array (Poly k) N}
      (Tm : \Pi (j : Fin N) -> isMonic (T j)) (Tc : \Pi (i j : Fin N) -> i /= j -> IsStronglyCoprime (T i) (T j)) {m n : Array Nat N}
      (PGH : monomial 1 (pow p (suc e)) - padd pzero a = Monoid.BigProd (\lam j => pow (T j) (m j)) * Monoid.BigProd (\lam j => pow (T j) (n j)))
      (Gd : 0 < degree (Monoid.BigProd (\lam j => pow (T j) (m j)))) (Hd : 0 < degree (Monoid.BigProd (\lam j => pow (T j) (n j))))
      : ∃ (b : k) (a = pow b p)
      => \case FinSet.||-finiteAC {N} {∃ (j0 : Fin N) (m j0 /= 0) (T j0 /= 1)} {\lam j => (m j = 0) || (T j = 1)} (\lam j =>
           \case NatSemiring.decideEq (m j) 0, decideEq (T j) 1 \with {
             | yes z, _ => byRight (byLeft z)
             | _, yes o => byRight (byRight o)
             | no z, no o => byLeft (inP (j, z, o))
           }) \with {
        | byLeft (inP (j0, mj0, Tj0)) => main-at pp pz e Tm Tc PGH Hd j0 mj0 Tj0
        | byRight all => absurd $ <-irreflexive $ transport (0 <) (degree_monomial {k} {1} {0} (\lam p => k.zro/=ide (inv p)))
                           $ transport (\lam x => 0 < degree x) (Monoid.BigProd_ide {_} {\new Array (Poly k) N (\lam j => pow (T j) (m j))} \lam j => \case all j \with {
                               | byLeft z => rewrite z idp
                               | byRight o => rewrite o Monoid.pow_ide
                             }) Gd
      }

    -- | Theorem VI.6.6 once a non-trivial factor `T j0` of `G` is chosen.
    \lemma main-at {k : DiscreteField} {p : Nat} (pp : Prime p) (pz : k.natCoef p = 0) (e : Nat) {a : k} {N : Nat} {T : Array (Poly k) N}
      (Tm : \Pi (j : Fin N) -> isMonic (T j)) (Tc : \Pi (i j : Fin N) -> i /= j -> IsStronglyCoprime (T i) (T j)) {m n : Array Nat N}
      (PGH : monomial 1 (pow p (suc e)) - padd pzero a = Monoid.BigProd (\lam j => pow (T j) (m j)) * Monoid.BigProd (\lam j => pow (T j) (n j)))
      (Hd : 0 < degree (Monoid.BigProd (\lam j => pow (T j) (n j)))) (j0 : Fin N) (mj0 : m j0 /= 0) (Tj0 : T j0 /= 1)
      : ∃ (b : k) (a = pow b p)
      => \let | q => pow p (suc e)
              | P => monomial 1 q - padd pzero a
              | M (j : Fin N) => m j Nat.+ n j
              | C : Array (Poly k) N => \lam j => sel j0 j (pow (T j) (M j)) 1
              | D : Array (Poly k) N => \lam j => sel j0 j 1 (pow (T j) (M j))
              | A => pow (T j0) (M j0)
              | B => Monoid.BigProd D
         \in \have | q>0 : 0 < q => pow-pos pp {suc e}
                   | PM : P = Monoid.BigProd (\lam j => pow (T j) (M j)) => PGH *> inv CMonoid.BigProd_* *> Monoid.BigProd-ext (\lam j => inv Monoid.pow_+)
                   | CD (j : Fin N) : pow (T j) (M j) = C j * D j => \case decideEq j j0 \with {
                     | yes e => rewrite e (inv (pmap2 (*) sel-yes sel-yes *> ide-right))
                     | no ne => inv (pmap2 (*) (sel-no ne) (sel-no ne) *> ide-left)
                   }
                   | Cj0 : Monoid.BigProd C = A => Monoid.BigProd-unique j0 (\lam j ne => sel-no (\lam (q : j = j0) => ne (inv q))) *> sel-yes
                   | PAB : P = A * B => PM *> Monoid.BigProd-ext CD *> CMonoid.BigProd_* *> pmap (* B) Cj0
                   | Bm : isMonic B => monic-BigProd \lam j => sel-cases isMonic (\lam _ => leadCoef-monic (leadCoef_monomial {k} {1} {0})) (\lam _ => monic-pow (Tm j))
                   | cop : IsStronglyCoprime A B => IsStronglyCoprime.BigProd-right \lam j =>
                       sel-cases (IsStronglyCoprime A) (\lam _ => IsStronglyCoprime.one-right) (\lam ne => IsStronglyCoprime.pows (Tc j0 j (\lam q => ne (inv q))))
                   | M0/=0 : M j0 /= 0 => \lam z => mj0 linarith
         \in \case pure-power-coprime pp pz e a (monic-pow (Tm j0)) Bm PAB cop \with {
           | byLeft A1 => absurd $ Tj0 $ monic-unit (Tm j0) $ pow-unit M0/=0 $ transportInv Monoid.Inv A1 Monoid.Inv.ide-isInv
           | byRight B1 =>
             \have | trivial (j : Fin N) (ne : j /= j0) : (M j = 0) || (T j = 1)
                       => \case NatSemiring.decideEq (M j) 0 \with {
                         | yes z => byLeft z
                         | no z => byRight $ monic-unit (Tm j) $ pow-unit z $ div-one $ transport (Monoid.LDiv __ 1) (sel-no ne) $ transport (Monoid.LDiv (D j)) B1 (CMonoid.LDiv_BigProd {_} {D} j)
                       }
                   | trivial-m (j : Fin N) (ne : j /= j0) : pow (T j) (m j) = 1 => \case trivial j ne \with {
                     | byLeft z => rewrite (\have t : m j = 0 => linarith \in t) idp
                     | byRight o => rewrite o Monoid.pow_ide
                   }
                   | trivial-n (j : Fin N) (ne : j /= j0) : pow (T j) (n j) = 1 => \case trivial j ne \with {
                     | byLeft z => rewrite (\have t : n j = 0 => linarith \in t) idp
                     | byRight o => rewrite o Monoid.pow_ide
                   }
                   | He : Monoid.BigProd (\lam j => pow (T j) (n j)) = pow (T j0) (n j0) => Monoid.BigProd-unique j0 (\lam j ne => trivial-n j (\lam q => ne (inv q)))
                   | nj0 : n j0 /= 0 => \lam z => <-irreflexive $ transport (0 <) (degree_monomial {k} {1} {0} (\lam p => k.zro/=ide (inv p))) $ transport (\lam x => 0 < degree x) (He *> rewrite z idp) Hd
                   | PA : P = A => PAB *> pmap (A *) B1 *> ide-right
                   | dq : q = degree (T j0) Nat.* M j0 => inv (P-deg q>0) *> pmap degree PA *> degree_pow-monic (Tm j0)
             \in \case ldiv-prime-pow {p} {M j0} {suc e} pp (\new Monoid.LDiv (M j0) q (degree (T j0)) (NatSemiring.*-comm *> inv dq)) \with {
               | inP (0, _, M=1) => absurd (sum-one mj0 nj0 M=1)
               | inP (suc j, _, Me) =>
                 \let c => polyEval (T j0) 0
                 \in \have | Pe : polyEval P 0 = negative a => (polyEvalRingHom 0).func-+ *> pmap2 (+) (polyEval_monomial *> ide-left *> k.pow_0 (\lam z => <-irreflexive (transport (0 <) z q>0)))
                                                                   ((polyEvalRingHom 0).func-negative {padd pzero a} *> pmap negative (pmap (+ a) (zro_*-left {k} {0}) *> zro-left)) *> zro-left
                           | Ae : polyEval A 0 = pow (pow c (pow p j)) p => (polyEvalRingHom 0).func-pow *> pmap (pow c) Me *> Monoid.pow_*
                           | ea : negative a = pow (pow c (pow p j)) p => inv Pe *> pmap (polyEval __ 0) PA *> Ae
                 \in inP (negative (pow c (pow p j)), inv $ pow-negative-char pp pz *> pmap negative (inv ea) *> AddGroup.negative-isInv)
             }
         }
  }