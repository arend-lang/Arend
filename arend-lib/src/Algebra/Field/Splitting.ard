{- | Construction of splitting fields for polynomials over discrete fields.
 -
 -   A splitting field of a polynomial `p` over a field `k` is a field extension `K` in which `p` factors into linear
 -   factors and which is generated as an algebra by the roots. This module defines the property `IsSplittingField` and
 -   provides a generic recursive construction that adjoins one root at a time via a `RootFieldData` interface, where
 -   each step builds a maximal-ideal quotient `k[x]/(q)` for an irreducible factor `q` of `p`. The construction is
 -   parameterized by a predicate `P` on fields (preserved under the construction) and a polynomial property `S`, and is
 -   instantiated to produce countable splitting fields when the base field is countable.
 -}

\import Algebra.Field
\import Algebra.Field.Algebraic
\import Algebra.Group
\import Algebra.Group.GroupHom
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.Pointed.PointedHom
\import Algebra.Ring.Integral
\import Algebra.Ring.RingHom
\import Algebra.Ring.Factor
\import Algebra.Ring.MPoly
\import Algebra.Ring.Poly
\import Algebra.Ring.Poly.Euclidean
\import Algebra.Semiring
\import Arith.Nat
\import Category
\import Data.Array
\import Function.Meta ($)
\import Logic
\import Logic.Meta
\import Meta
\import Order.LinearOrder
\import Paths
\import Paths.Meta
\import Relation.Equivalence
\import Set
\import Set.Countable
\open Monoid

{- | Property of a ring homomorphism `f : k -> K` stating that `p` factors over `K` as a constant times a product of
 -   linear terms `x - aᵢ`, with `K` algebra-generated by the roots `aᵢ`.
 -}
\type IsSplittingField {k K : DiscreteField} (p : Poly k) (f : RingHom k K)
  => ∃ (l : Array K) (c : K) (RingHom.isAlgebraGenerated f l) (polyMap f p = c PolyRing.*c Monoid.BigProd (map (\lam a => padd 1 (negative a)) l))

-- | A splitting field extension is an integral extension.
\lemma splitting-integral {k K : DiscreteField} {p : Poly k} {f : RingHom k K} (s : IsSplittingField p f) : isIntegralExt f \elim s
  | inP s => (finGenExt-char $ inP (s.1,s.3)).2 K.zeroDimensional

{- | For a monic polynomial, the leading constant in the splitting factorization is `1`, so `polyMap f p` equals the
 -   bare product of linear factors.
 -}
\lemma splitting-monic {k K : DiscreteField} {p : Poly k} (pm : isMonic p) {f : RingHom k K} (s : IsSplittingField p f)
  : ∃ (l : Array K) (RingHom.isAlgebraGenerated f l) (polyMap f p = Monoid.BigProd (map (\lam a => padd 1 (negative a)) l)) \elim pm, s
  | inP (n,pd,pc), inP (l, c, lg, lq) => inP (l, lg, lq *> pmap (PolyRing.*c _) (
    \have | pc1 : polyCoef (polyMap f p) n = 1 => polyCoef_polyMap *> pmap f pc *> func-ide
          | pc2 : polyCoef (polyMap f p) l.len = c => rewrite lq $ polyCoef_*c *> pmap (c *) (leadCoef_BigProd1 (\lam _ => idp) \lam _ => idp) *> ide-right
    \in \case LinearOrder.trichotomy l.len n \with {
      | less q => absurd $ K.zro/=ide $ inv (degree<=.toCoefs _ _ (rewrite lq $ degree<=_*c $ degree<=_BigProd1 \lam _ => idp) q) *> pc1
      | equals q => inv pc2 *> pmap (polyCoef _) q *> pc1
      | greater q => absurd $ K.zro/=ide $ pmap (polyCoef __ n) {pzero} (inv $ lq *> pmap (PolyRing.*c _) (inv pc2 *> degree<=.toCoefs _ _ (degree<=_polyMap pd) q) *> PolyRing.zro_*c) *> pc1
    }) *> PolyRing.ide_*c)

{- | Given a countable discrete field `k` and a polynomial `p : Poly k`, produces a countable discrete field `K`, a ring
 -   homomorphism `k -> K`, and a proof that this is a splitting field of `p`.
 -}
\sfunc countableSplittingField.{u} {k : DiscreteField.{u}} (c : Countable k) {p : Poly k} : \Sigma (K : DiscreteField.{u}) (Countable K) (f : RingHom k K) (IsSplittingField p f)
  => CountableSplittingFieldData.makeSplittingField c ()
  \where \protected {
    {- | Record packaging a one-step root extension: a field `RootField` extending `k` via `rootFieldHom`, a `root`
     -   element that satisfies `polyMapEval p root = 0`, and a witness `RootField-gen` that every element of
     -   `RootField` is the evaluation at `root` of some polynomial over `k`. The predicate `P` is required to hold of
     -   `RootField`.
     -}
    \record RootFieldData.{u} (P : DiscreteField.{u} -> \Set u) (k : DiscreteField.{u}) (p : Poly k)
      | RootField : DiscreteField.{u}
      | RootFieldP : P RootField
      | rootFieldHom : RingHom k RootField
      | root : RootField
      | isRoot : polyMapEval rootFieldHom p root = 0
      | RootField-gen (x : RootField) : ∃ (q : Poly k) (polyMapEval rootFieldHom q root = x)

    {- | Class abstracting the data needed to iterate the construction: a field predicate `P`, a polynomial property `S`
     -   closed under ring homomorphisms (`S-hom`) and division (`S-factor`), and a `nextField` operation producing a
     -   `RootFieldData` for any nonzero non-invertible polynomial satisfying `P` and `S`.
     -}
    \class SplittingFieldData.{u} \noclassifying
      (P : DiscreteField.{u} -> \Set u) (S : \Pi {K : DiscreteField.{u}} -> Poly K -> \Prop)
      (S-hom : \Pi {K K' : DiscreteField.{u}} (f : RingHom K K') {p : Poly K} -> S p -> S (polyMap f p))
      (S-factor : \Pi {K : DiscreteField.{u}} {p q : Poly K} -> S (p * q) -> S p)
      (nextField : \Pi {K : DiscreteField.{u}} {p : Poly K} -> P K -> p /= 0 -> Not (Inv p) -> RootFieldData.{u} P K p) {

      {- | Builds a splitting field for `p` by induction on `degree p`. The recursive helper `aux` adjoins a root via
       -   `nextField`, divides `p` by `(x - root)` using `rootDiv_*`, and recurses on the quotient.
       -}
      \func makeSplittingField {k : DiscreteField.{u}} (Pk : P k) {p : Poly k} (Sp : S p) : \Sigma (K : DiscreteField.{u}) (P K) (f : RingHom k K) (IsSplittingField p f)
        => aux Pk idp Sp
        \where
          \func aux {k : DiscreteField.{u}} (Pk : P k) {p : Poly k} {n : Nat} (d : degree p = n) (Sp : S p) : \Sigma (K : DiscreteField.{u}) (P K) (f : RingHom k K) (IsSplittingField p f) \elim n
            | 0 => (k, Pk, RingHom.id, inP (nil, polyCoef p 0, \lam x => inP (mConst x, simplify), rewrite {1} (degree=0-lem d) $ pmap (padd pzero) $ leadCoef_polyCoef *> pmap (polyCoef p) d *> inv ide-right))
            | suc n => \let | p/=0 : p /= 0 => \case rewrite __ in d
                            | rfd : RootFieldData P k p => nextField Pk p/=0 \lam pi => \case polyInv pi \with {
                                                             | inP (r,q,_) => \case rewrite q in d
                                                           }
                            | (K,PK,f,Ks) => aux rfd.RootFieldP {_} {n} (pmap pred (inv (rewrite (decideEq/=_reduce $ /=-sym zro/=ide) in inv (degree_polyMap RingHom.field-isInj) *> degree_*_= (\lam q => p/=0 $ polyMap-inj RingHom.field-isInj q) (rootDiv_* rfd.isRoot)) *> d)) $ S-factor $ transport S (rootDiv_* rfd.isRoot) (S-hom rfd.rootFieldHom Sp)
                       \in (K, PK, f RingHom.∘ rfd.rootFieldHom, TruncP.map Ks \lam (l,c,fl,q) => later
                            (f rfd.root :: l, c, RingHom.isAlgebraGenerated-comp rfd.RootField-gen fl,
                             inv (polyMap-comp rfd.rootFieldHom f) *> pmap (polyMap f) (rootDiv_* rfd.isRoot) *> (polyMapRingHom f).func-* *> pmap (* _) q *> inv PolyRing.*c-comm-left *>
                             pmap (c PolyRing.*c) (pmap (_ *) (pmap2 (\lam x y => padd (padd pzero x) y) func-ide AddGroupHom.func-negative) *> *-comm {_} {_} {padd 1 (negative (f root))})))
    }

    {- | Instance of `SplittingFieldData` with `P = Countable` and trivial `S`. The `nextField` step constructs the new
     -   field as the factor ring `k[x]/m`, where `m` is a maximal ideal containing `(p)` (from `poly-maximal-ideal`),
     -   with `root` the class of `x` and countability transferred via `factor-countable`.
     -}
    \func CountableSplittingFieldData.{u} : SplittingFieldData.{u} \cowith
      | P K => Countable K
      | S _ => \Sigma
      | S-hom _ _ => ()
      | S-factor _ => ()
      | nextField {k} {p} c p/=0 pc => \new RootFieldData {
        | RootField => FactorField {(poly-maximal-ideal c p pc).1} (poly-maximal-ideal c p pc).2
        | RootFieldP => factor-countable (Poly.poly-countable c)
        | rootFieldHom => factorHom RingHom.∘ polyHom
        | root => in~ (padd 1 0)
        | isRoot => pmap (polyEval __ _) (inv (polyMap-comp polyHom factorHom)) *> polyEval_polyMap *>
                                                                                   FactorRing.fequiv0 (transportInv (poly-maximal-ideal c p pc).1 poly-eval (poly-maximal-ideal c p pc).3)
        | RootField-gen (in~ q) => inP (q, pmap (polyEval __ _) (inv (later $ polyMap-comp _ _)) *> polyEval_polyMap *> pmap FactorRing.inF poly-eval)
      }

      {- | Lemma that evaluating `polyMap polyHom p` at the canonical indeterminate `padd 1 0` recovers `p`; used to
       -   verify that the constructed root is indeed a root of `p` in the factor ring.
       -}
      \lemma poly-eval {K : DiscreteField} {p : Poly K} : polyMapEval polyHom p (padd 1 0) = p \elim p
        | pzero => idp
        | padd p e => unfold polyMapEval $ rewrite poly-eval $ inv padd-expand
  }
