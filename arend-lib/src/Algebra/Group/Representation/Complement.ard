\import Algebra.Linear.Matrix.Smith (SmithDomain)
\import Algebra.Group
\import Algebra.Group.GSet
\import Algebra.Group.Representation
\import Algebra.Group.Representation.Averaging
\import Algebra.Group.Representation.IntertwiningMap
\import Algebra.Group.Representation.Irreducible
\import Algebra.Group.Representation.Product
\import Algebra.Group.Representation.SplitSubLRepres
\import Algebra.Linear.BasedSplitSubLModule (BasedSplitSubLModule, kernel-split)
\import Algebra.Meta
\import Algebra.Module
\import Algebra.Module.SubLModule
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.Ring
\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta

\lemma add-sub-cancel {A : AbGroup} (a b : A) : a + (b - a) = b => equation.abGroup

\lemma sub-add-cancel {A : AbGroup} (a b : A) : (a + b) - a = b => equation.abGroup

\lemma sub-distr {A : AbGroup} (a b c d : A) : (a + b) - (c + d) = (a - c) + (b - d) => equation.abGroup

\lemma splitProjector-idem.{u} {R : CRing.{u}} {G : FinGroup.{u}} (cardInv : Monoid.Inv (R.natCoef G.card)) {E : LinRepres.{u} R G} (S : SplitSubLRepres R G E) (e : E)
  : splitProjector cardInv S (splitProjector cardInv S e) = splitProjector cardInv S e
  => pmap (splitProjector cardInv S) (inv (splitProjector.image cardInv S e)) *> splitProjector.on-incl cardInv S _ *> splitProjector.image cardInv S e

\lemma splitProjector-complement.{u} {R : CRing.{u}} {G : FinGroup.{u}} (cardInv : Monoid.Inv (R.natCoef G.card)) {E : LinRepres.{u} R G} (S : SplitSubLRepres R G E) (e : E)
  : splitProjector cardInv S (e - splitProjector cardInv S e) = 0
  => (splitProjector cardInv S).func-minus *> pmap (_ - __) (splitProjector-idem cardInv S e) *> E.negative-right

{- | Fulton--Harris Prop. 1.5, constructive variant: over a Smith domain, a split subrepresentation of a representation with a basis has an invariant complement $C$,
    and $E \cong S \oplus C$ as representations. The complement is the kernel of the averaged projection. -}
\lemma maschke-complement.{u} {K : SmithDomain.{u}} {G : FinGroup.{u}} (cardInv : Monoid.Inv (K.natCoef G.card)) {E : LinRepres.{u} K G}
  {lv : Array E} (bv : E.IsBasis lv) (S : SplitSubLRepres K G E)
  : ∃ (C : SplitSubLRepres K G E)
      (Phi : IntertwiningMap E (ProductLRepres S.sub C.sub))
      (\Pi (e : E) -> ProductLRepres.coprod-map {K} {G} {S.sub} {C.sub} {E} S.incl C.incl (Phi e) = e)
      (\Pi (x : S.sub) (y : C.sub) -> Phi (S.incl x + C.incl y) = (x, y))
  => \let | pi => splitProjector cardInv S
          | r => S.retr
          | (inP Ker) => kernel-split bv bv pi
          | C => SplitSubLRepres.fromInvariant Ker (SchurLemma.kernel-invariant {K} {G} {E} {E} {pi})
     \in inP (C, \new IntertwiningMap {
           | func e => (r (pi e), (e - pi e, splitProjector-complement cardInv S e))
           | func-+ {e} {e'} => ext (pmap r pi.func-+ *> r.func-+,
                                     ext (pmap ((e + e') -) pi.func-+ *> sub-distr e e' (pi e) (pi e')))
           | func-*c {c} {e} => ext (pmap r pi.func-*c *> r.func-*c,
                                     ext (pmap ((c *c e) -) pi.func-*c *> inv E.*c-ldistr_-))
           | func-** {e} {g} => ext (pmap r (pi.func-** *> pmap (g **) (inv (splitProjector.image cardInv S e)) *> inv S.incl.func-**) *> S.retr_incl _,
                                     ext (pmap ((g ** e) -) pi.func-** *> inv (E.**-ldistr *> pmap (_ +) E.**_negative)))
         }, \lam e => pmap (\lam v => v + (e - pi e)) (splitProjector.image cardInv S e) *> add-sub-cancel (pi e) e,
            \lam x y => \have p : pi (S.incl x + C.incl y) = S.incl x
                                 => pi.func-+ *> pmap2 (+) (splitProjector.on-incl cardInv S x) y.2 *> zro-right
                        \in ext (pmap r p *> S.retr_incl x, ext (pmap (_ -) p *> sub-add-cancel (S.incl x) (C.incl y))))
