\import Algebra.Linear.Matrix.Smith (SmithDomain)
\import Algebra.Group
\import Algebra.Group.GSet
\import Algebra.Group.Representation
\import Algebra.Group.Representation.Averaging
\import Algebra.Group.Representation.InterwiningMap
\import Algebra.Group.Representation.Irreducible
\import Algebra.Group.Representation.Product
\import Algebra.Group.Representation.SplitSubLRepres
\import Algebra.Linear.SplitSubLModule (SplitSubLModule, kernel-split)
\import Algebra.Meta
\import Algebra.Module
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.Ring
\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta

\lemma add-sub-cancel {A : AbGroup} (a b : A) : a + (b - a) = b => equation.abGroup

\lemma sub-add-cancel {A : AbGroup} (a b : A) : (a + b) - a = b => equation.abGroup

\lemma sub-distr {A : AbGroup} (a b c d : A) : (a + b) - (c + d) = (a - c) + (b - d) => equation.abGroup

\lemma splitProjector-idem {R : CRing} {G : FinGroup} (cardInv : Monoid.Inv (R.natCoef G.card)) {E : LinRepres R G} (S : SplitSubLRepres E) (e : E)
  : splitProjector cardInv S (splitProjector cardInv S e) = splitProjector cardInv S e
  => pmap (splitProjector cardInv S) (inv (splitProjector.image cardInv S e)) *> splitProjector.on-incl cardInv S _ *> splitProjector.image cardInv S e

\lemma splitProjector-complement {R : CRing} {G : FinGroup} (cardInv : Monoid.Inv (R.natCoef G.card)) {E : LinRepres R G} (S : SplitSubLRepres E) (e : E)
  : splitProjector cardInv S (e - splitProjector cardInv S e) = 0
  => (splitProjector cardInv S).func-minus *> pmap (_ - __) (splitProjector-idem cardInv S e) *> E.negative-right

{- | Fulton--Harris Prop. 1.5, constructive variant: over a Smith domain, a split invariant subspace of a representation with a basis has an invariant complement $C$,
    and $E \cong S \oplus C$ as representations. The complement is the kernel of the averaged projection. -}
\lemma maschke-complement {K : SmithDomain} {G : FinGroup} (cardInv : Monoid.Inv (K.natCoef G.card)) {E : LinRepres K G}
  {lv : Array E} (bv : E.IsBasis lv) (S : SplitSubLRepres E)
  : ∃ (C : SplitSubLRepres E)
      (Phi : InterwiningMap E (ProductLRepres (SplitSubLRepres.toLinRepres S) (SplitSubLRepres.toLinRepres C)))
      (\Pi (e : E) -> ProductLRepres.coprod-map {K} {G} {SplitSubLRepres.toLinRepres S} {SplitSubLRepres.toLinRepres C} {E} (SplitSubLRepres.inclInterwining S) (SplitSubLRepres.inclInterwining C) (Phi e) = e)
      (\Pi (x : Array K S.dim) (y : Array K C.dim) -> Phi (S.incl x + C.incl y) = (x, y))
  => \let | pi => splitProjector cardInv S
          | (inP Ker) => kernel-split bv bv pi
          | C => SplitSubLRepres.fromInvariant Ker (SchurLemma.kernel-invariant {K} {G} {E} {E} {pi})
     \in inP (C, \new InterwiningMap {
           | func e => (S.retr (pi e), C.retr (e - pi e))
           | func-+ {e} {e'} => ext (pmap S.retr pi.func-+ *> S.retr.func-+,
                                     pmap C.retr (pmap ((e + e') -) pi.func-+ *> sub-distr e e' (pi e) (pi e')) *> C.retr.func-+)
           | func-*c {r} {e} => ext (pmap S.retr pi.func-*c *> S.retr.func-*c,
                                     pmap C.retr (pmap ((r *c e) -) pi.func-*c *> inv E.*c-ldistr_-) *> C.retr.func-*c)
           | func-** {e} {g} => ext (pmap S.retr (pi.func-** *> pmap (g **) (inv (splitProjector.image cardInv S e))),
                                     pmap C.retr (pmap ((g ** e) -) pi.func-** *> inv (E.**-ldistr *> pmap (_ +) E.**_negative) *>
                                                  pmap (g **) (inv (Ker.incl_retr (splitProjector-complement cardInv S e)))))
         }, \lam e => pmap2 (+) (splitProjector.image cardInv S e) (Ker.incl_retr (splitProjector-complement cardInv S e)) *> add-sub-cancel (pi e) e,
            \lam x y => \have p : pi (S.incl x + C.incl y) = S.incl x
                                 => pi.func-+ *> pmap2 (+) (splitProjector.on-incl cardInv S x) (Ker.incl-in y) *> zro-right
                        \in ext (pmap S.retr p *> S.retr_incl x, pmap C.retr (pmap (_ -) p *> sub-add-cancel (S.incl x) (C.incl y)) *> C.retr_incl y))
