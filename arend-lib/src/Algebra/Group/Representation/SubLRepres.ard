\import Algebra.Group.GSet
\import Algebra.Group.GSet.SubGSet
\import Algebra.Group.Representation
\import Algebra.Group.Representation.IntertwiningMap
\import Algebra.Module.SubLModule
\import Algebra.Pointed
\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta
\import Set.SubSet

\class SubLRepres \extends SubLModule, SubGSet {
  \override S : LinRepres R G

  -- | The canonical inclusion into the ambient representation.
  \func incl : IntertwiningMap \this S \cowith
    | LinearMap => IModule.embed
    | func-** => idp

  \func IsTrivial => ∀ {x} (contains x -> x = 0) || ∀ x (contains x)
} \where {
  -- | The representation carried by the membership subtype.
  \use \coerce toLinRepres (W : SubLRepres {}) : LinRepres W.R W.G \cowith
    | LModule => IModule W
    | GSet => IGSet W
    | **-ldistr => ext **-ldistr
    | **_*c => ext **_*c
}

\instance ILinRepres (S : SubLRepres {}) : LinRepres
  => SubLRepres.toLinRepres S
  \where
    \func embed : IntertwiningMap (ILinRepres S) S.S \cowith
      | LinearMap => IModule.embed
      | func-** => idp

\func KernelLRepres (f : IntertwiningMap {}) : SubLRepres f.R f.G f.Dom \cowith
  | SubLModule => KernelLModule f
  | contains_** fa=0 => f.func-** *> pmap (_ **) fa=0 *> LinRepres.**_zro

\func ImageLRepres (f : IntertwiningMap {}) : SubLRepres f.R f.G f.Cod \cowith
  | SubLModule => ImageLModule f
  | SubGSet => ImageGSet f

\func ImLRepres (f : IntertwiningMap {}) : LinRepres
  => ILinRepres (ImageLRepres f)

\func ImLRepresLeftHom (f : IntertwiningMap {}) : IntertwiningMap f.Dom (ImLRepres f) \cowith
  | LinearMap => ImLModuleLeftHom f
  | EquivariantMap => ImGSetLeftHom f
