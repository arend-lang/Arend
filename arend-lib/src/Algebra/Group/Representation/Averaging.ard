-- | The average $\frac{1}{|G|} \sum_{g} g f g^{-1}$ of a linear map; it is an intertwiner.
\func averageMap {R : CRing} {G : FinGroup} (cardInv : Monoid.Inv (R.natCoef G.card)) {E W : LinRepres R G} (f : LinearMap E W) : InterwiningMap E W
  => cardInv.inv *c SumOverGroup f

\lemma averageMap-char {R : CRing} {G : FinGroup} (cardInv : Monoid.Inv (R.natCoef G.card)) {E W : LinRepres R G} (f : LinearMap E W) (e : E)
  : averageMap cardInv f e = cardInv.inv *c W.FinSum (\lam g => g ** f (inverse g ** e))
  => pmap (cardInv.inv *c) (SumOverGroup.FinSumRewrite (\lam g => SumOverGroup.adjust g f) e)

-- | Fulton--Harris Prop. 1.5, constructive variant: averaging the projection $incl \circ retr$ of a split subspace gives an equivariant projection onto it.
\func splitProjector {R : CRing} {G : FinGroup} (cardInv : Monoid.Inv (R.natCoef G.card)) {E : LinRepres R G} (S : SplitSubLRepres E) : InterwiningMap E E
  => averageMap cardInv (LinearMap.compose {R} {E} {ArrayFinModule {R} S.dim} {E} S.incl S.retr)
  \where {
    \lemma on-incl {R : CRing} {G : FinGroup} (cardInv : Monoid.Inv (R.natCoef G.card)) {E : LinRepres R G} (S : SplitSubLRepres E) (x : Array R S.dim)
      : splitProjector cardInv S (S.incl x) = S.incl x
      => averageMap-char cardInv _ (S.incl x) *>
         pmap (_ *c) (E.FinSum-ext (\lam g => pmap (g **) (S.incl-invariant (inverse g) x) *> inv E.**-assoc *> pmap (`** _) inverse-right *> E.**_ide) *>
                      SumOverGroup.FinSumEqual-multiply (S.incl x)) *>
         inv E.*c-assoc *> pmap (`*c _) (*-comm *> cardInv.inv-right) *> E.ide_*c

    \lemma image {R : CRing} {G : FinGroup} (cardInv : Monoid.Inv (R.natCoef G.card)) {E : LinRepres R G} (S : SplitSubLRepres E) (e : E)
      : S.incl (S.retr (splitProjector cardInv S e)) = splitProjector cardInv S e
      => \have p : splitProjector cardInv S e = S.incl (cardInv.inv *c AbMonoid.FinSum {ArrayFinModule {R} S.dim} (\lam g => S.retr (g ** S.incl (S.retr (inverse g ** e)))))
                => averageMap-char cardInv _ e *> pmap (_ *c) (E.FinSum-ext (\lam g => inv (S.incl-invariant g _)) *> inv (AddMonoidHom.func-FinSum S.incl)) *> inv S.incl.func-*c
         \in pmap (\lam z => S.incl (S.retr z)) p *> pmap S.incl (S.retr_incl _) *> inv p
  }

\lemma dim=0-of-zero {R : NonZeroRing} {n : Nat} (p : \Pi (x : Array R n) -> x = AddPointed.zro {ArrayFinModule {R} n}) : n = 0 \elim n
  | 0 => idp
  | suc n => absurd (R.zro/=ide (inv (pmap (\lam (z : Array R (suc n)) => z 0) (p (\lam _ => R.ide)))))

{- | A finite free representation of positive rank whose intertwiners are all scalar is irreducible,
    over a commutative local ring in which $|G|$ is invertible. No zero test is used. -}
\lemma irreducible-from-commutant {R : LocalCRing} {G : FinGroup} (cardInv : Monoid.Inv (R.natCoef G.card)) {E : LinRepres R G}
  {l : Array E} (l>0 : 0 < l.len) (lb : E.IsBasis l)
  (comm : \Pi (h : InterwiningMap E E) -> ∃ (c : R) (\Pi (e : E) -> h e = c *c e))
  : IsFinIrreducible E
  => (inP (l, l>0, lb), \lam S => \case comm (splitProjector cardInv S) \with {
    | inP (c, hc) =>
      \let | pi => splitProjector cardInv S
           | j0 : Fin l.len => toFin 0 l>0
           | d => coordFun lb j0
           | v => l j0
           | eq : (c * c) *c v = c *c v
               => E.*c-assoc *> pmap (c *c) (inv (hc v)) *> inv (hc (pi v)) *> pmap pi (inv (splitProjector.image cardInv S v)) *>
                  splitProjector.on-incl cardInv S _ *> splitProjector.image cardInv S v *> hc v
           | cc=c : c * c = c
               => inv ide-right *> inv (d.func-*c *> pmap (_ *) E.basis_split_=) *> pmap d eq *> d.func-*c *> pmap (c *) E.basis_split_= *> ide-right
      \in \case R.connected c cc=c \with {
        | byLeft c=0 => byLeft $ dim=0-of-zero \lam x => inv (S.retr_incl x) *>
            pmap S.retr (inv (splitProjector.on-incl cardInv S x) *> hc _ *> pmap (`*c _) c=0 *> E.*c_zro-left) *> S.retr.func-zro
        | byRight c=1 => byRight \lam e => inP (S.retr (pi e), splitProjector.image cardInv S e *> hc e *> pmap (`*c e) c=1 *> E.ide_*c)
      }
  })
