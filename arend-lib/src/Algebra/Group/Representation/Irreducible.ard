\import Algebra.Field
\import Algebra.Group
\import Algebra.Group.GSet
\import Algebra.Group.Representation
\import Algebra.Meta
\import Algebra.Module
\import Algebra.Group.Representation.IntertwiningMap
\import Algebra.Group.Representation.SplitSubLRepres
\import Algebra.Group.Representation.SubLRepres
\import Algebra.Group.SubGroup
\import Algebra.Linear.SplitSubLModule (SplitSubLModule, coordsMap-section, image-split, kernel-split, split-dim-<=, split-full-surj)
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.Ring
\import Arith.Nat
