{- | Irreducibility tested against every predicate subrepresentation.
    This is classical-strength: for the trivial representation on a nonzero ring it implies excluded middle,
    since $\{x \mid P \lor x = 0\}$ is a subrepresentation for every proposition $P$. Do not use it as the default notion. -}
\func IsStronglyIrreducible {R : Ring} {G : Group} (E : LinRepres R G) : \Prop
  => \Pi (A : SubLRepres R G E) -> A.IsTrivial
  \where {
    -- | Strong irreducibility of the one-dimensional trivial representation decides every proposition.
    \lemma excludedMiddle {R : NonZeroRing} {G : Group} (p : IsStronglyIrreducible (TrivialAction (RingLModule R) G)) (P : \Prop) : P || Not P
      => \case p (W P) \with {
        | byLeft z => byRight \lam pp => R.zro/=ide (inv (z {R.ide} (byLeft pp)))
        | byRight a => \case a R.ide \with {
          | byLeft pp => byLeft pp
          | byRight one=zero => absurd (R.zro/=ide (inv one=zero))
        }
      }

    -- | The submodule $\{x \mid P \lor x = 0\}$.
    \func W {R : Ring} {G : Group} (P : \Prop) : SubLRepres R G (TrivialAction (RingLModule R) G) \cowith
      | contains x => P || (x = 0)
      | contains_zro => byRight idp
      | contains_+ {a} {b} pa pb => \case pa, pb \with {
        | byLeft pp, _ => byLeft pp
        | _, byLeft pp => byLeft pp
        | byRight a=0, byRight b=0 => byRight (pmap2 (+) a=0 b=0 *> R.zro-left)
      }
      | contains_negative {a} pa => \case pa \with {
        | byLeft pp => byLeft pp
        | byRight a=0 => byRight (pmap negative a=0 *> R.negative_zro)
      }
      | contains_*c {r} {a} pa => \case pa \with {
        | byLeft pp => byLeft pp
        | byRight a=0 => byRight (pmap (r *) a=0 *> R.zro_*-right)
      }
      | contains_** pa => pa
  }

\lemma SchurLemma-strong {R : Ring} {G : Group} {A B : LinRepres R G} (p : IsStronglyIrreducible A) (q : IsStronglyIrreducible B) (f : IntertwiningMap A B) : f.IsZero || IsEquiv f
  => \case q (ImageLRepres f) \with {
    | byLeft iz => byLeft \lam x => iz $ inP (x, idp)
    | byRight if => \case p (KernelLRepres f) \with {
      | byLeft kz => byRight $ IsEquiv.fromInjSurj (AddKernel-trivial-char.1 kz) if
      | byRight kf => byLeft kf
    }
  }

{- | A nonzero finite free representation whose split invariant submodules are zero or whole.
    Finite freeness is inherited from {FinLinRepres}; the tested submodules need no basis.
    This is the pilot's finite-dimensional notion, not a definition for arbitrary modules. -}
\class FinIrreducibleRepres.{u} \extends FinLinRepres.{u} {
  \override R : NonZeroRing.{u}
  \override G : Group.{u}
  \override E : \Set u
  | nontrivial : ∃ (v : E) (v /= 0)
  | irreducible (S : SplitSubLRepres R G (\new LinRepres { | LinRepres => \this })) : (\Pi (x : S.sub) -> x = S.sub.zro) || IsSurj S.incl

  -- | Equivalent formulation using any representation with a split inclusion; no basis of its domain is required.
  \lemma splitMono-irreducible {W : LinRepres R G}
    (j : IntertwiningMap W (\new LinRepres { | LinRepres => \this }))
    (r : LinearMap (\new LinRepres { | LinRepres => \this }) W) (rj : \Pi (w : W) -> r (j w) = w)
    : (\Pi (w : W) -> w = 0) || IsSurj j
    => SplitSubLRepres.splitMono-dichotomy {R} {G} {W} {\new LinRepres { | LinRepres => \this }} j r rj
         (irreducible (SplitSubLRepres.fromSplitMono {R} {G} {W} {\new LinRepres { | LinRepres => \this }} j r rj))

  -- | Every basis of a nontrivial representation is nonempty.
  \lemma basis-nonempty {l : Array E} (lb : IsBasis l) : 0 < l.len \elim l
    | nil => \case nontrivial \with {
      | inP (v, v/=0) => absurd (v/=0 (\this.basis-split-char {nil} {lb}))
    }
    | _ :: _ => NatOrder.zero<suc
}

-- | Fulton--Harris Schur's lemma 1.7(1): an intertwiner between finite irreducible representations is zero or an isomorphism.
\lemma SchurLemma.{u} {K : DiscreteField.{u}} {G : Group.{u}} {A B : FinIrreducibleRepres.{u} K G} (f : IntertwiningMap A B)
  : f.IsZero || IsEquiv f
  => \case A.isFinModule, B.isFinModule \with {
    | inP (la, ba), inP (lb, bb) =>
      \case kernel-split ba bb f, image-split ba bb f \with {
        | inP Ker, inP Im =>
          \let | ImRep => SplitSubLRepres.fromInvariant {K} {G} {\new LinRepres { | LinRepres => B }} Im image-invariant
               | KerRep => SplitSubLRepres.fromInvariant {K} {G} {\new LinRepres { | LinRepres => A }} Ker kernel-invariant
          \in \case B.irreducible ImRep \with {
            | byLeft z => byLeft \lam a => SplitSubLRepres.fromInvariant-zero {K} {G} {\new LinRepres { | LinRepres => B }} Im image-invariant z (inP (a, idp))
            | byRight s => \case A.irreducible KerRep \with {
              | byLeft z => byRight $ IsEquiv.fromInjSurj (AddKernel-trivial-char.1 \lam {a} fa=0 => SplitSubLRepres.fromInvariant-zero {K} {G} {\new LinRepres { | LinRepres => A }} Ker kernel-invariant z fa=0)
                                                          (\lam b => ImRep.full-of-surj s b)
              | byRight s' => byLeft \lam a => KerRep.full-of-surj s' a
            }
          }
      }
  }
  \where {
    \lemma kernel-invariant {R : Ring} {G : Group} {A B : LinRepres R G} {f : IntertwiningMap A B} (g : G) {a : A} (fa=0 : f a = 0) : f (g ** a) = 0
      => f.func-** *> pmap (g **) fa=0 *> B.**_zro

    \lemma image-invariant {R : Ring} {G : Group} {A B : LinRepres R G} {f : IntertwiningMap A B} (g : G) {b : B} (h : ∃ (a : A) (f a = b)) : ∃ (a : A) (f a = g ** b)
      => \case h \with {
        | inP (a, fa=b) => inP (g ** a, f.func-** *> pmap (g **) fa=b)
      }
  }

{- | Even on the trivial rank-one representation, the zero-or-isomorphism conclusion of Schur's lemma
    decides equality of scalars. Thus extending that conclusion to constructive complex numbers requires a zero test. -}
\lemma schur-decideEq {R : NonZeroCRing} {G : Group}
  (schur : \Pi (f : IntertwiningMap (TrivialAction (RingLModule R) G) (TrivialAction (RingLModule R) G)) -> f.IsZero || IsEquiv f)
  (x y : R) : Dec (x = y)
  => \let | f : IntertwiningMap (TrivialAction (RingLModule R) G) (TrivialAction (RingLModule R) G) => \new IntertwiningMap {
              | func a => (x - y) * a
              | func-+ => R.ldistr
              | func-*c => inv R.*-assoc *> pmap (`* _) R.*-comm *> R.*-assoc
              | func-** => idp
            }
     \in \case schur f \with {
       | byLeft z => yes (R.fromZero (inv R.ide-right *> z 1))
       | byRight e => no \lam x=y => R.zro/=ide (IsEquiv.isInj e (R.zro_*-right *> inv (pmap (`* 1) (R.toZero x=y) *> R.zro_*-left)))
     }

\lemma pos-of-/=0 {d : Nat} (n : d /= 0) : 1 <= d \elim d
  | 0 => absurd (n idp)
  | suc d => linarith

-- | An idempotent endomorphism of a free module of rank one is multiplication by an idempotent scalar.
\func rank-one-idempotent {R : CRing} {U : LModule R} {v : U} (lb : U.IsBasis (v :: nil)) (p : LinearMap U U) (pp : \Pi (e : U) -> p (p e) = p e)
  : \Sigma (c : R) (c * c = c) (\Pi (e : U) -> p e = c *c e)
  => \let | d (e : U) => U.basis-split lb e 0
          | c => d (p v)
          | expand (e : U) : e = d e *c v => U.basis-split-char {_} {lb} *> zro-right
          | scalar (e : U) : p e = c *c e => pmap p (expand e) *> p.func-*c *> pmap (d e *c) (expand (p v)) *> inv U.*c-assoc *>
                                            pmap (`*c v) R.*-comm *> U.*c-assoc *> pmap (c *c) (inv (expand e))
          | eq : (c * c) *c v = c *c v => U.*c-assoc *> pmap (c *c) (inv (scalar v)) *> inv (scalar (p v)) *> pp v *> scalar v
          | coord (r : R) : d (r *c v) = r => U.basis-split-unique lb (r :: nil) (inv zro-right) 0
     \in (c, inv (coord (c * c)) *> pmap d eq *> coord c, scalar)

{- | A representation that is free of rank one is irreducible, over every commutative ring without nontrivial idempotents.
    No averaging is involved, so $|G|$ need not be invertible. Connectedness is needed:
    over $R \times R$, the summand $R \times 0$ is a split subrepresentation. -}
\func rank-one-irreducible.{u} {R : NonZeroCRing.{u}} {G : Group.{u}} {E : LinRepres.{u} R G} (conn : R.IsConnected) {v : E} (lb : E.IsBasis (v :: nil))
  : FinIrreducibleRepres.{u} { | LinRepres => E } \cowith
  | isFinModule => inP (v :: nil, lb)
  | nontrivial => inP (v, \lam p => R.zro/=ide (E.independent-nonZero {v :: nil} lb.1 {0} p))
  | irreducible S =>
    \let | r => S.retr
         | pi => LinearMap.compose {R} {E} {S.sub} {E} S.incl r
         | (c, cc=c, hc) => rank-one-idempotent lb pi (\lam e => pmap S.incl (S.retr_incl (r e)))
    \in \case conn c cc=c \with {
      | byLeft c=0 => byLeft \lam x => inv (S.retr_incl x) *>
          pmap r (inv (pmap S.incl (S.retr_incl x)) *> hc _ *> pmap (`*c _) c=0 *> E.*c_zro-left) *> r.func-zro
      | byRight c=1 => byRight \lam e => inP (r e, hc e *> pmap (`*c e) c=1 *> E.ide_*c)
    }
