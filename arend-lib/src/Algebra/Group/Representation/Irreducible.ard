{- | Irreducibility tested against every predicate subrepresentation.
    This is classical-strength: for the trivial representation on a nonzero ring it implies excluded middle,
    since $\{x \mid P \lor x = 0\}$ is a subrepresentation for every proposition $P$. Do not use it as the default notion. -}
\func IsStronglyIrreducible {R : Ring} {G : Group} (E : LinRepres R G) : \Prop
  => \Pi (A : SubLRepres R G E) -> A.IsTrivial
  \where {
    -- | Strong irreducibility of the one-dimensional trivial representation decides every proposition.
    \lemma excludedMiddle {R : NonZeroRing} {G : Group} (p : IsStronglyIrreducible (TrivialAction (RingLModule R) G)) (P : \Prop) : P || Not P
      => \case p (W P) \with {
        | byLeft z => byRight \lam pp => R.zro/=ide (inv (z {R.ide} (byLeft pp)))
        | byRight a => \case a R.ide \with {
          | byLeft pp => byLeft pp
          | byRight one=zero => absurd (R.zro/=ide (inv one=zero))
        }
      }

    -- | The submodule $\{x \mid P \lor x = 0\}$.
    \func W {R : Ring} {G : Group} (P : \Prop) : SubLRepres R G (TrivialAction (RingLModule R) G) \cowith
      | contains x => P || (x = 0)
      | contains_zro => byRight idp
      | contains_+ {a} {b} pa pb => \case pa, pb \with {
        | byLeft pp, _ => byLeft pp
        | _, byLeft pp => byLeft pp
        | byRight a=0, byRight b=0 => byRight (pmap2 (+) a=0 b=0 *> R.zro-left)
      }
      | contains_negative {a} pa => \case pa \with {
        | byLeft pp => byLeft pp
        | byRight a=0 => byRight (pmap negative a=0 *> R.negative_zro)
      }
      | contains_*c {r} {a} pa => \case pa \with {
        | byLeft pp => byLeft pp
        | byRight a=0 => byRight (pmap (r *) a=0 *> R.zro_*-right)
      }
      | contains_** pa => pa
  }

\lemma SchurLemma-strong {R : Ring} {G : Group} {A B : LinRepres R G} (p : IsStronglyIrreducible A) (q : IsStronglyIrreducible B) (f : IntertwiningMap A B) : f.IsZero || IsEquiv f
  => \case q (ImageLRepres f) \with {
    | byLeft iz => byLeft \lam x => iz $ inP (x, idp)
    | byRight if => \case p (KernelLRepres f) \with {
      | byLeft kz => byRight $ IsEquiv.fromInjSurj (AddKernel-trivial-char.1 kz) if
      | byRight kf => byLeft kf
    }
  }

{- | Irreducibility of a finite free representation of positive rank, tested against split invariant subspaces ({SplitSubLRepres}).
    This is the working notion for finite-dimensional representations; it is not a replacement for arbitrary modules. -}
\func IsFinIrreducible {R : NonZeroRing} {G : Group} (E : LinRepres R G) : \Prop
  => \Sigma (∃ (l : Array E) (0 < l.len) (E.IsBasis l))
            (\Pi (S : SplitSubLRepres E) -> (S.dim = 0) || IsSurj S.incl)

-- | Fulton--Harris Schur's lemma 1.7(1) for {IsFinIrreducible}: an intertwiner is zero or an isomorphism.
\lemma SchurLemma {K : DiscreteField} {G : Group} {A B : LinRepres K G} (p : IsFinIrreducible A) (q : IsFinIrreducible B) (f : IntertwiningMap A B)
  : f.IsZero || IsEquiv f
  => \case p.1, q.1 \with {
    | inP (la, _, ba), inP (lb, _, bb) =>
      \case kernel-split ba bb f, image-split ba bb f \with {
        | inP Ker, inP Im =>
          \case q.2 (SplitSubLRepres.fromInvariant Im image-invariant) \with {
            | byLeft d=0 => byLeft \lam a => SplitSubLModule.dim=0 Im d=0 (inP (a, idp))
            | byRight s => \case p.2 (SplitSubLRepres.fromInvariant Ker kernel-invariant) \with {
              | byLeft d=0 => byRight $ IsEquiv.fromInjSurj (AddKernel-trivial-char.1 \lam {a} fa=0 => SplitSubLModule.dim=0 Ker d=0 fa=0)
                                                            (\lam b => SplitSubLModule.surj Im s b)
              | byRight s' => byLeft \lam a => SplitSubLModule.surj Ker s' a
            }
          }
      }
  }
  \where {
    \lemma kernel-invariant {R : Ring} {G : Group} {A B : LinRepres R G} {f : IntertwiningMap A B} (g : G) {a : A} (fa=0 : f a = 0) : f (g ** a) = 0
      => f.func-** *> pmap (g **) fa=0 *> B.**_zro

    \lemma image-invariant {R : Ring} {G : Group} {A B : LinRepres R G} {f : IntertwiningMap A B} (g : G) {b : B} (h : ∃ (a : A) (f a = b)) : ∃ (a : A) (f a = g ** b)
      => \case h \with {
        | inP (a, fa=b) => inP (g ** a, f.func-** *> pmap (g **) fa=b)
      }
  }

\lemma pos-of-/=0 {d : Nat} (n : d /= 0) : 1 <= d \elim d
  | 0 => absurd (n idp)
  | suc d => linarith

{- | A representation that is free of rank one is irreducible, over every nonzero commutative ring.
    No averaging is involved, so $|G|$ need not be invertible. -}
\lemma rank-one-irreducible {R : NonZeroCRing} {G : Group} {E : LinRepres R G} {l : Array E} (len=1 : l.len = 1) (lb : E.IsBasis l)
  : IsFinIrreducible E
  => (inP (l, transportInv (0 <) len=1 NatOrder.zero<suc, lb), \lam S => \case decideEq S.dim 0 \with {
    | yes p => byLeft p
    | no n => byRight (split-full-surj S.retr_incl (coordsMap-section lb)
        (<=-antisymmetric (split-dim-<= S.retr_incl (coordsMap-section lb)) (transportInv (`<= S.dim) len=1 (pos-of-/=0 n))))
  })
