\import Algebra.Group
\import Algebra.Group.GSet
\import Algebra.Group.Representation
\import Algebra.Group.Representation.Averaging
\import Algebra.Group.Representation.CharacterFormulas
\import Algebra.Group.Representation.Characters
\import Algebra.Module.CoordSystem
\import Algebra.Group.Representation.InterwiningMap
\import Algebra.Group.Representation.Irreducible
\import Algebra.Group.Representation.PermutationRepresentation
\import Algebra.Group.Representation.Product
\import Algebra.Group.Representation.SplitSubLRepres
\import Algebra.Group.Symmetric
\import Algebra.Group.Symmetric.Action
\import Algebra.Linear.Matrix (MatrixRing)
\import Algebra.Linear.SplitSubLModule (SplitSubLModule)
\import Algebra.Meta
\import Algebra.Module
\import Algebra.Module.FinModule
\import Algebra.Module.LinearMap
\import Algebra.Monoid
\import Algebra.Pointed
