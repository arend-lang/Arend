\import Algebra.Group
\import Algebra.Group.GSet
\import Algebra.Group.Representation
\import Algebra.Group.Representation.IntertwiningMap
\import Algebra.Group.Representation.Finite
\import Algebra.Group.Representation.SubLRepres
\import Algebra.Linear.BasedSplitSubLModule
\import Algebra.Module
\import Algebra.Module.FinModule
\import Algebra.Module.LinearMap
\import Algebra.Module.SubLModule
\import Algebra.Module.SubLModule.Split
\import Algebra.Pointed
\import Algebra.Ring
\import Equiv
\import Function
\import Logic
\import Paths
\import Paths.Meta

{- | A subrepresentation with a linear retraction of its canonical inclusion.
    Membership is inherited from {SubLRepres}; splitting is inherited from {SplitSubLModule}.
    The retraction need not be equivariant, and no basis of the submodule is assumed. -}
\class SplitSubLRepres \extends SplitSubLModule, SubLRepres {
  \override S : LinRepres R G
  -- | The representation carried by the inherited membership subtype.
  \func sub : LinRepres R G => ILinRepres \this

  -- | The inherited linear retraction, regarded as a map into the subrepresentation.
  \func retr : LinearMap S sub => retract

  \lemma retr_incl (x : sub) : retr (incl x) = x => retract_incl x

  \lemma incl-inj : IsInj incl => \lam {x} {y} p => ext p

  \lemma incl-surj-section (s : IsSurj incl) (e : S) : incl (retr e) = e
    => \case s e \with { | inP (x, p) => rewriteI p (pmap incl (retr_incl x)) }

  \lemma full-of-surj (s : IsSurj incl) (v : S) : contains v
    => \case s v \with { | inP ((w, p), q) => transport contains q p }

  \lemma incl-invariant (g : G) (x : sub) : incl (retr (g ** incl x)) = g ** incl x
    => pmap (\lam z => z.1) (retract_incl (g ** x))
} \where {
  -- | Adding invariance to a split submodule preserves its membership and retraction.
  \func fromInvariant {R : Ring} {G : Group} {E : LinRepres R G}
    (B : SplitSubLModule R E) (P-inv : \Pi (g : G) {v : E} -> B v -> B (g ** v))
    : SplitSubLRepres R G E { | contains => B.contains } \cowith
    | contains_zro => B.contains_zro
    | contains_+ => B.contains_+
    | contains_negative => B.contains_negative
    | contains_*c => B.contains_*c
    | contains_** => P-inv _
    | retract => B.retract
    | retract_incl => B.retract_incl

  -- | An arbitrary split intertwiner has the canonical split image subrepresentation.
  \func fromSplitMono {R : Ring} {G : Group} {W E : LinRepres R G}
    (j : IntertwiningMap W E) (r : LinearMap E W) (rj : \Pi (w : W) -> r (j w) = w)
    : SplitSubLRepres { | SubLRepres => ImageLRepres j } \cowith
    | retract => (SplitSubLModule.fromSplitMono j r rj).retract
    | retract_incl => (SplitSubLModule.fromSplitMono j r rj).retract_incl

  -- | An arbitrary split monomorphism and its canonical image have equivalent domains.
  \func imageEquiv {R : Ring} {G : Group} {W E : LinRepres R G}
    (j : IntertwiningMap W E) (r : LinearMap E W) (rj : \Pi (w : W) -> r (j w) = w)
    : QEquiv (ImLRepresLeftHom j) \cowith
    | ret x => r x.1
    | ret_f => rj
    | f_sec x => (fromSplitMono j r rj).retract_incl x

  -- | The canonical formulation gives the same zero-or-surjective dichotomy for every split monomorphism.
  \lemma splitMono-dichotomy {R : Ring} {G : Group} {W E : LinRepres R G}
    (j : IntertwiningMap W E) (r : LinearMap E W) (rj : \Pi (w : W) -> r (j w) = w)
    (d : (\Pi (x : (fromSplitMono j r rj).sub) -> x = (fromSplitMono j r rj).sub.zro)
         || IsSurj (fromSplitMono j r rj).incl)
    : (\Pi (w : W) -> w = 0) || IsSurj j
    => \case d \with {
      | byLeft z => byLeft \lam w => inv (rj w) *>
          pmap r (pmap (\lam x => x.1) (z (j w, inP (w, idp)))) *> r.func-zro
      | byRight s => byRight \lam e => \case s e \with {
        | inP ((v, p), q) => \case p \with { | inP (w, jw=v) => inP (w, jw=v *> q) }
      }
    }

  -- | A zero membership subtype has no nonzero member in the ambient representation.
  \lemma fromInvariant-zero {R : Ring} {G : Group} {E : LinRepres R G}
    (B : SplitSubLModule R E) (P-inv : \Pi (g : G) {v : E} -> B v -> B (g ** v))
    (z : \Pi (x : (fromInvariant B P-inv).sub) -> x = 0) {v : E} (Pv : B v) : v = 0
    => pmap (\lam x => x.1) (z (v, Pv))
}

-- | A split subrepresentation with specified finite free coordinates on its membership subtype.
\class BasedSplitSubLRepres \extends BasedSplitSubLModule, SplitSubLRepres {
  \override S : LinRepres R G
} \where {
    -- | Adding invariance to a based split submodule retains its coordinate data by inheritance.
    \func fromInvariant {R : Ring} {G : Group} {E : LinRepres R G}
      (B : BasedSplitSubLModule { | R => R | S => E }) (P-inv : \Pi (g : G) {v : E} -> B v -> B (g ** v))
      : BasedSplitSubLRepres R G E { | contains => B.contains } \cowith
      | dim => B.dim
      | basisIncl => B.basisIncl
      | coords => B.coords
      | coords_basisIncl => B.coords_basisIncl
      | basisIncl_in => B.basisIncl_in
      | basisIncl_coords => B.basisIncl_coords
      | contains_** => P-inv _

    -- | The induced representation in the chosen coordinates.
    \func arrayRepres {R : Ring} {G : Group} {E : LinRepres R G}
      (B : BasedSplitSubLModule { | R => R | S => E }) (P-inv : \Pi (g : G) {v : E} -> B v -> B (g ** v)) : LinRepres R G \cowith
      | LModule => ArrayFinModule {R} B.dim
      | ** g x => B.coords (g ** B.basisIncl x)
      | **-assoc {m} {n} {x} => pmap B.coords (E.**-assoc *> pmap (m **) (inv (B.basisIncl_coords (P-inv n (B.basisIncl_in x)))))
      | **_ide {x} => pmap B.coords E.**_ide *> B.coords_basisIncl x
      | **-ldistr {g} {x} {y} => pmap B.coords (pmap (g **) B.basisIncl.func-+ *> E.**-ldistr) *> B.coords.func-+
      | **_*c {g} {x} {c} => pmap B.coords (pmap (g **) B.basisIncl.func-*c *> E.**_*c) *> B.coords.func-*c

    -- | The inclusion written in the chosen coordinates.
    \func arrayIncl {R : Ring} {G : Group} {E : LinRepres R G}
      (B : BasedSplitSubLModule { | R => R | S => E }) (P-inv : \Pi (g : G) {v : E} -> B v -> B (g ** v))
      : IntertwiningMap (arrayRepres B P-inv) E \cowith
      | LinearMap => B.basisIncl
      | func-** {x} {g} => B.basisIncl_coords (P-inv g (B.basisIncl_in x))

    -- | The coordinate presentation is isomorphic to the same canonical membership subrepresentation.
    \func arrayToSub {R : Ring} {G : Group} {E : LinRepres R G}
      (B : BasedSplitSubLModule { | R => R | S => E }) (P-inv : \Pi (g : G) {v : E} -> B v -> B (g ** v))
      : IntertwiningMap (arrayRepres B P-inv) (fromInvariant B P-inv).sub \cowith
      | LinearMap => (BasedSplitSubLModule.coordinateIso B).f
      | func-** {x} {g} => ext (B.basisIncl_coords (P-inv g (B.basisIncl_in x)))

    \func arrayToSubEquiv {R : Ring} {G : Group} {E : LinRepres R G}
      (B : BasedSplitSubLModule { | R => R | S => E }) (P-inv : \Pi (g : G) {v : E} -> B v -> B (g ** v))
      : QEquiv (arrayToSub B P-inv) \cowith
      | ret => (BasedSplitSubLModule.coordinateIso B).finv
      | ret_f => B.coords_basisIncl
      | f_sec x => ext (B.basisIncl_coords x.2)

    \func finiteSub {R : Ring} {G : Group} {E : LinRepres R G}
      (B : BasedSplitSubLModule { | R => R | S => E }) (P-inv : \Pi (g : G) {v : E} -> B v -> B (g ** v))
      : FinLinRepres { | LinRepres => (fromInvariant B P-inv).sub } \cowith
      | isFinModule => inP (_, BasedSplitSubLModule.basis B)

    \func arrayFinite {R : Ring} {G : Group} {E : LinRepres R G}
      (B : BasedSplitSubLModule { | R => R | S => E }) (P-inv : \Pi (g : G) {v : E} -> B v -> B (g ** v))
      : FinLinRepres { | LinRepres => arrayRepres B P-inv } \cowith
      | isFinModule => (ArrayFinModule {R} B.dim).isFinModule
  }
