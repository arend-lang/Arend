\import Algebra.Group
\import Algebra.Group.GSet
\import Algebra.Group.Representation
\import Algebra.Group.Representation.IntertwiningMap
\import Algebra.Linear.SplitSubLModule
\import Algebra.Module.FinModule
\import Algebra.Module.LinearMap
\import Algebra.Module.ModuleCat
\import Algebra.Pointed
\import Algebra.Ring
\import Category
\import Function
\import Logic
\import Paths
\import Paths.Meta

{- | A subrepresentation of {E} with a linear (not necessarily equivariant) left inverse:
    an injective intertwiner {incl} that is a split monomorphism in the category of modules.
    Unlike `SubLRepres`, membership is not an arbitrary proposition, so the strong dichotomy of `SubLRepres.IsTrivial` does not apply.
    A split monomorphism in the category of representations would be an invariant direct summand; that is what averaging produces. -}
\record SplitSubLRepres.{u} {R : Ring.{u}} {G : Group.{u}} (E : LinRepres.{u} R G)
  | sub : LinRepres.{u} R G
  | incl : IntertwiningMap sub E
  | split : SplitMono {LModuleCat.{u} R} {sub} {E} incl
  \where {
    \func retr.{u} {R : Ring.{u}} {G : Group.{u}} {E : LinRepres.{u} R G} (S : SplitSubLRepres.{u} E) : LinearMap E S.sub
      => S.split.hinv

    \lemma retr_incl.{u} {R : Ring.{u}} {G : Group.{u}} {E : LinRepres.{u} R G} (S : SplitSubLRepres.{u} E) (x : S.sub) : retr S (S.incl x) = x
      => path (\lam i => (S.split.hinv_f @ i) x)

    \lemma incl-inj.{u} {R : Ring.{u}} {G : Group.{u}} {E : LinRepres.{u} R G} (S : SplitSubLRepres.{u} E) : IsInj S.incl
      => \lam {x} {y} p => inv (retr_incl S x) *> pmap (retr S) p *> retr_incl S y

    \lemma incl-surj-section.{u} {R : Ring.{u}} {G : Group.{u}} {E : LinRepres.{u} R G} (S : SplitSubLRepres.{u} E) (s : IsSurj S.incl) (e : E) : S.incl (retr S e) = e
      => \case s e \with {
        | inP (x, p) => rewriteI p (pmap S.incl (retr_incl S x))
      }

    \lemma incl-invariant.{u} {R : Ring.{u}} {G : Group.{u}} {E : LinRepres.{u} R G} (S : SplitSubLRepres.{u} E) (g : G) (x : S.sub)
      : S.incl (retr S (g ** S.incl x)) = g ** S.incl x
      => pmap (\lam z => S.incl (retr S z)) (inv S.incl.func-**) *> pmap S.incl (retr_incl S _) *> S.incl.func-**

    -- | The action on $R^{dim}$ of an invariant split submodule.
    \func arrayRepres {R : Ring} {G : Group} {E : LinRepres R G} {P : E -> \Prop} (S : SplitSubLModule E P)
                      (P-inv : \Pi (g : G) {v : E} -> P v -> P (g ** v)) : LinRepres R G \cowith
      | LModule => ArrayFinModule {R} S.dim
      | ** g x => S.retr (g ** S.incl x)
      | **-assoc {m} {n} {x} => pmap S.retr (E.**-assoc *> pmap (m **) (inv (S.incl_retr (P-inv n (S.incl-in x)))))
      | **_ide {x} => pmap S.retr E.**_ide *> S.retr_incl x
      | **-ldistr {g} {x} {y} => pmap S.retr (pmap (g **) S.incl.func-+ *> E.**-ldistr) *> S.retr.func-+
      | **_*c {g} {x} {c} => pmap S.retr (pmap (g **) S.incl.func-*c *> E.**_*c) *> S.retr.func-*c

    \func arrayIncl {R : Ring} {G : Group} {E : LinRepres R G} {P : E -> \Prop} (S : SplitSubLModule E P)
                     (P-inv : \Pi (g : G) {v : E} -> P v -> P (g ** v)) : IntertwiningMap (arrayRepres S P-inv) E \cowith
      | LinearMap => S.incl
      | func-** {x} {g} => S.incl_retr (P-inv g (S.incl-in x))

    -- | An invariant split submodule is a split subrepresentation.
    \func fromInvariant.{u} {R : Ring.{u}} {G : Group.{u}} {E : LinRepres.{u} R G} {P : E -> \Prop} (S : SplitSubLModule E P)
                        (P-inv : \Pi (g : G) {v : E} -> P v -> P (g ** v)) : SplitSubLRepres.{u} E \cowith
      | sub => arrayRepres S P-inv
      | incl => arrayIncl S P-inv
      | split => \new SplitMono {
        | hinv => S.retr
        | hinv_f => exts S.retr_incl
      }

    \lemma fromInvariant-zero.{u} {R : Ring.{u}} {G : Group.{u}} {E : LinRepres.{u} R G} {P : E -> \Prop} (S : SplitSubLModule E P)
      (P-inv : \Pi (g : G) {v : E} -> P v -> P (g ** v)) (z : \Pi (x : (fromInvariant S P-inv).sub) -> x = 0) {v : E} (Pv : P v) : v = 0
      => inv (S.incl_retr Pv) *> pmap S.incl (z (S.retr v)) *> S.incl.func-zro
  }
