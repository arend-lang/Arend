\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Pointed
\import Function.Meta ($)
\import Logic
\import Paths
\import Algebra.Group.GroupHom
\open AddGroup (*i_ipow)

\lemma commutator=ide<->comm {E : Group} {g h : E} : commutator g h = ide <-> g * h = h * g
  => (\lam p => equation.group {pmap (* (h * g)) p},
      \lam q => equation.group {pmap (\lam x => x * inverse g * inverse h) q})

\lemma comm_sym {E : Group} {g h : E} (p : commutator g h = ide) : commutator h g = ide
  => equation.group {pmap inverse p}

\lemma comm_conjugate {E : Group} {g h : E} (p : commutator g h = ide) : conjugate g h = h
  => equation.group {pmap (* h) p}

\lemma comm_inverse-right {E : Group} {g h : E} (p : commutator g h = ide) : commutator g (inverse h) = ide
  => equation.group {pmap (\lam x => conjugate (inverse h) (inverse x)) p}

\lemma comm_inverse-left {E : Group} {g h : E} (p : commutator g h = ide) : commutator (inverse g) h = ide
  => comm_sym $ comm_inverse-right $ comm_sym p

\func conjugateHom {E : Group} (g : E) : GroupHom E E \cowith
  | func => conjugate g
  | func-ide => equation.group
  | func-* => equation.group

