\import Algebra.Domain.Euclidean
\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Pointed
\import Arith.Int
\import Arith.Nat
\import Arith.Nat.Lcm
\import Arith.Nat.Sequence
\import Function.Meta
\import Logic.Unique
\import Logic
\import Logic.Meta
\import Meta
\import Order.Biordered
\import Order.LinearOrder
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Set
\import Set.Fin.Pigeonhole

\lemma hasFiniteOrder {G : Group} {P : PigeonholeSet G} (g : G) : ∃ (n : Nat) (n > 0) (G.pow g n = 1)
  => TruncP.map (P.pigeonhole< (\lam n => G.pow g n)) \lam (i,j,i<j,p) =>
      (j -' i, pos<pos.conv $ transportInv (_ <) (-'=- $ <=-less i<j) linarith, cancel_*-right (G.pow g i) $ inv G.pow_+ *> pmap (G.pow g) (unpos $ pmap (+ pos i) (-'=- $ <=-less i<j) *> linarith) *> inv p *> inv ide-left)

\sfunc order {G : Group} {P : PigeonholeSet G} {D : DecSet G} (g : G) : Nat
  => (tuple g).1
  \where {
    \protected \sfunc tuple {G : Group} {P : PigeonholeSet G} {D : DecSet G} (g : G)
      : \Sigma (n : Nat) (\Sigma (n > 0) (G.pow g n = 1)) (\Pi (m : Nat) -> (\Sigma (m > 0) (G.pow g m = 1)) -> n <= m)
      => Contr.center {search _ (\lam n => later \have t => LinearOrder.<-dec 0 n \in decide) $ TruncP.map (hasFiniteOrder g) \lam t => (t.1, (t.2, t.3))}
  }

\lemma order>0 {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} : order g > 0
  => rewrite (\peval order g) (order.tuple g).2.1

\lemma order_pow {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} : G.pow g (order g) = 1
  => rewrite (\peval order g) (order.tuple g).2.2

\lemma order-min {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} {m : Nat} (p : m > 0) (q : G.pow g m = 1) : order g <= m
  => rewrite (\peval order g) $ (order.tuple g).3 m (p,q)

-- | Powers of {g} are periodic with period `order g`.
\lemma pow_mod-order {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} {n : Nat} : G.pow g n = G.pow g (n Nat.mod order g)
  => G.pow_mod order_pow

-- | If `g^n = 1`, then the order of {g} divides {n}.
\func order-div {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} {n : Nat} (p : G.pow g n = 1) : Monoid.LDiv (order g) n
  => mod_div $ \case NatSemiring.decideEq (n Nat.mod order g) 0 \with {
    | yes e => e
    | no q => absurd $ <-irreflexive $ order-min (nonZero>0 q) (inv pow_mod-order *> p) <∘r mod<right (/=-sym $ NatSemiring.<_/= order>0)
  }

-- | If the order of {g} divides {n}, then `g^n = 1`.
\lemma pow_order-mult {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} {n : Nat} (d : Monoid.LDiv (order g) n) : G.pow g n = 1
  => pmap (G.pow g) (inv d.inv-right) *> G.pow_* *> pmap (G.pow __ _) order_pow *> G.pow_ide

-- | Different powers below the order are distinct.
\lemma pow-inj {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} {i j : Nat} (i<o : i < order g) (j<o : j < order g) (p : G.pow g i = G.pow g j) : i = j
  => \case LinearOrder.trichotomy i j \with {
    | less i<j => absurd (aux i<j j<o p)
    | equals i=j => i=j
    | greater j<i => absurd (aux j<i i<o (inv p))
  }
  \where
    \private \lemma aux {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} {i j : Nat} (i<j : i < j) (j<o : j < order g) (p : G.pow g i = G.pow g j) : Empty
      => \have | e : i + (j -' i) = j => <=_exists (<=-less i<j)
               | q : G.pow g (j -' i) = 1 => cancel_*-left (G.pow g i) $ inv G.pow_+ *> pmap (G.pow g) e *> inv p *> inv ide-right
         \in <-irreflexive $ order-min (pos<pos.conv $ transportInv (_ <) (-'=- $ <=-less i<j) linarith) q <∘r (-'<=id <∘r j<o)

-- | The order of {g} is the {n} with `g^n = 1` that divides every `i` with `g^i = 1`.
\lemma order-unique {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} {n : Nat} (p : G.pow g n = 1)
                    (q : \Pi {i : Nat} -> G.pow g i = 1 -> Monoid.LDiv n i) : order g = n
  => natAssociates-areEqual (order-div p) (q order_pow)

-- | If {c} divides the order of {g}, then `g^c` has order `order g / c`.
\lemma order_pow-div {G : Group} {P : PigeonholeSet G} {D : DecSet G} {g : G} {c : Nat} (d : Monoid.LDiv c (order g))
  : order (G.pow g c) = d.inv
  => order-unique (inv G.pow_* *> pmap (G.pow g) d.inv-right *> order_pow) \lam {i} q =>
      \have | c/=0 : c /= 0 => \lam c=0 => /=-sym (NatSemiring.<_/= order>0) $ inv d.inv-right *> pmap (* _) c=0 *> NatSemiring.zro_*-left
            | r : Monoid.LDiv (order g) (c * i) => order-div (G.pow_* *> q)
      \in Monoid.LDiv.make r.inv $ NatSemiring.cancel_*-left c/=0 $ inv NatSemiring.*-assoc *> pmap (* _) d.inv-right *> r.inv-right

-- | The order of a product of commuting elements of coprime orders is the product of their orders.
\lemma order_*-coprime {G : Group} {P : PigeonholeSet G} {D : DecSet G} {x y : G} (xy=yx : x * y = y * x)
                       (c : NatEuclidean.gcd (order x) (order y) = 1) : order (x * y) = order x * order y
  => order-unique (G.pow-comm xy=yx *> pmap2 (*) (pow_order-mult (Monoid.LDiv.make (order y) idp))
                                                  (pow_order-mult (Monoid.LDiv.make (order x) NatSemiring.*-comm)) *> ide-left)
      \lam {i} q => nat_coprime_*_div c (aux xy=yx c q) (aux (inv xy=yx) (nat_gcd-comm *> c) (pmap (G.pow __ i) (inv xy=yx) *> q))
  \where
    -- | If `(xy)^i = 1` and the orders are coprime, then `order x` divides {i}.
    \private \func aux {G : Group} {P : PigeonholeSet G} {D : DecSet G} {x y : G} (xy=yx : x * y = y * x)
                       (c : NatEuclidean.gcd (order x) (order y) = 1) {i : Nat} (q : G.pow (x * y) i = 1) : Monoid.LDiv (order x) i
      => \have | q' : G.pow x i * G.pow y i = 1 => inv (G.pow-comm xy=yx) *> q
               | yb : G.pow (G.pow y i) (order y) = 1 => inv G.pow_* *> pmap (G.pow y) NatSemiring.*-comm *> G.pow_* *> pmap (G.pow __ i) order_pow *> G.pow_ide
               | s : G.pow (G.pow x i) (order y) = 1 => inv ide-right *> pmap (_ *) (inv yb) *> inv (G.pow-comm (G.pow-comm2 xy=yx))
                                                          *> pmap (G.pow __ (order y)) q' *> G.pow_ide
               | r : Monoid.LDiv (order x) (i * order y) => order-div (G.pow_* *> s)
         \in nat_gcd_*_div (transport (Monoid.LDiv _) NatSemiring.*-comm r) c

-- | Commuting elements of orders `m` and `n` give an element of order `lcm(m,n)` (the main step of MRR VI.5.3).
\lemma order-lcm {G : Group} {P : PigeonholeSet G} {D : DecSet G} {x y : G} (xy=yx : x * y = y * x)
  : ∃ (z : G) (order z = nat-lcm (order x) (order y))
  => \case lcm-split (order x) (order y) \with {
    | inP (a,b,a|n,b|m,a_b,ab=q) =>
      \have | ob : order (G.pow x b|m.inv) = b => order_pow-div (Monoid.LDiv.swap b|m)
            | oa : order (G.pow y a|n.inv) = a => order_pow-div (Monoid.LDiv.swap a|n)
      \in inP (G.pow x b|m.inv * G.pow y a|n.inv, order_*-coprime {_} {_} {_} {G.pow x b|m.inv} {G.pow y a|n.inv} (G.pow-comm2 xy=yx)
                  (pmap2 NatEuclidean.gcd ob oa *> nat_gcd-comm *> a_b) *> pmap2 (*) ob oa *> NatSemiring.*-comm *> ab=q)
  }