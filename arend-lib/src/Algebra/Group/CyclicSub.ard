\import Algebra.Group
\import Algebra.Group.Fin
\import Algebra.Group.Lagrange
\import Algebra.Group.SubGroup
\import Algebra.Monoid
\import Arith.Nat
\import Equiv
\import Function.Meta
\import Logic
\import Logic.Meta
\import Data.Or
\import Data.Fin
\import Algebra.Pointed
\import Paths
\import Paths.Meta
\import Set
\import Set.Fin

-- | The subgroup of a finite group generated by an element `g`; it consists of the powers of `g`.
\func cyclicSubGroup {G : FinGroup} (g : G) : FinSubGroup G \cowith
  | contains x => ∃ (n : Nat) (G.pow g n = x)
  | contains_ide => inP (0, idp)
  | contains_* {x} {y} (inP (n,p)) (inP (m,q)) => inP (n + m, G.pow_+ *> pmap2 (*) p q)
  | contains_inverse {x} (inP (n,p)) => inP (n Nat.* pred (order g), pow-inverse *> pmap inverse p)
  | isDec x => \case FinSet.searchFin (\lam (k : Fin (order g)) => G.pow g k = x) (\lam k => decideEq _ _) \with {
    | inl (k,q,_) => yes (inP (k,q))
    | inr q => no \lam (inP (n,p)) => q (toFin' $ mod<right order/=0) (pmap (G.pow g) (toFin'=id _) *> inv pow_mod-order *> p)
  }
  \where {
    \lemma order/=0 {G : FinGroup} {g : G} : order g /= 0
      => /=-sym $ NatSemiring.<_/= order>0

    \lemma pow-inverse {G : FinGroup} {g : G} {n : Nat} : G.pow g (n Nat.* pred (order g)) = inverse (G.pow g n)
      => cancel_*-left (G.pow g n) $ inv G.pow_+ *> pmap (G.pow g) (NatSemiring.+-comm *> pmap (n Nat.*) (suc_pred order/=0))
          *> pow_order-mult (\new Monoid.LDiv { | inv => n | inv-right => NatSemiring.*-comm }) *> inv inverse-right
  }

-- | The cyclic subgroup generated by {g} has `order g` elements.
\lemma cyclicSubGroup-card {G : FinGroup} (g : G) : (IFinGroup (cyclicSubGroup g)).card = order g
  => inv $ card_Equiv {FinFin (order g)} {IFinGroup (cyclicSubGroup g)} $ QEquiv.fromInjSurj {Fin (order g)} {IFinGroup (cyclicSubGroup g)} {\lam k => (G.pow g k, inP (k, idp))}
      (\lam p => nat_fin_= $ pow-inj (fin_< _) (fin_< _) (pmap __.1 p))
      (\lam y => \case y.2 \with {
        | inP (n,p) => inP (toFin' $ mod<right (cyclicSubGroup.order/=0 {G} {g}), ext $ pmap (G.pow g) (toFin'=id _) *> inv pow_mod-order *> p)
      })

-- | The order of an element of a finite group divides the order of the group.
\func order-div-card {G : FinGroup} (g : G) : Monoid.LDiv (order g) G.card
  => transport (Monoid.LDiv __ G.card) (cyclicSubGroup-card g) (lagrange (cyclicSubGroup g))

-- | `g^|G| = 1` for every element `g` of a finite group `G`.
\lemma pow_card {G : FinGroup} (g : G) : G.pow g G.card = 1
  => pow_order-mult (order-div-card g)