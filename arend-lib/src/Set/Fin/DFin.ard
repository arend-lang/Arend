{- | Dedekind-finite sets: sets where every injective endomap is automatically surjective.
 -
 -   This module captures the classical Dedekind characterization of finiteness as a propositional predicate on `\Set`.
 -   The key insight is that for such sets, injective self-maps are forced to be equivalences, yielding a constructive
 -   splitting of any injection. The module also bridges this notion to the pigeonhole formulation of finiteness,
 -   showing that pigeonhole sets are Dedekind-finite.
 -}

\import Equiv
\import Function
\import Function.Iterate
\import Function.Meta
\import Logic
\import Paths
\import Set.Fin.Pigeonhole

-- | Predicate that a set `A` is Dedekind-finite: every injective `f : A -> A` is also surjective. Lives in `\Prop`.
\type isDFin (A : \Set) : \Prop
  => \Pi (f : A -> A) -> IsInj f -> IsSurj f
  \where {
    {- | Promotes an injective endomap on a Dedekind-finite set to an `Equiv`, since injectivity plus the implied
     -   surjectivity yield an equivalence.
     -}
    \lemma isEquiv {A : \Set} (p : isDFin A) (f : A -> A) (inj : IsInj f) : IsEquiv f
      => IsEquiv.fromInjSurj inj (p f inj)

    {- | Constructive preimage operation: given Dedekind-finiteness, an injection `f`, and `a : A`, returns
     -   `(a', f a' = a)` by inverting the induced equivalence.
     -}
    \func isSplit {A : \Set} (p : isDFin A) (f : A -> A) (inj : IsInj f) (a : A) : \Sigma (a' : A) (f a' = a)
      => (IsEquiv.ret (isEquiv p f inj) a, IsEquiv.f_ret (isEquiv p f inj))

    {- | Every `PigeonholeSet` is Dedekind-finite, linking the pigeonhole-principle formulation of finiteness to the
     -   Dedekind formulation.
     -}
    \lemma fromPigeonhole (A : PigeonholeSet) : isDFin A
      => \lam f inj a => TruncP.map (A.pigeonhole< (\lam i => iterr f i a))
          \lam t => (_, inv $ iterr_inj f inj a t.1 t.2 t.3 t.4)
  }
