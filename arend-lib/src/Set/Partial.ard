{- | Partial elements of a set, represented as values defined on a propositional condition.
 -
 -   A `Partial X` packages a proposition `isDefined` together with a function from a proof of that proposition to a
 -   value in `X`. This encodes the "maybe defined" pattern in a propositionally-truncated style: equality of partial
 -   elements is determined by logical equivalence of their definedness propositions plus agreement of their values
 -   where defined. The module provides constructors for total and never-defined partial elements, extensionality lemmas
 -   for proving equalities, functorial lifts of ordinary functions, and an `AddMonoid` instance that lifts addition
 -   pointwise (with the identity always defined).
 -}

\import Algebra.Monoid
\import Function.Meta
\import Logic
\import Meta
\import Paths
\import Paths.Meta
\import Set

{- | A record over `E : \Set` with a propositional definedness `isDefined : \Prop` and a coercion
 -   `value : isDefined -> E` extracting the value from a definedness witness.
 -}
\record Partial (E : \Set) {
  | isDefined : \Prop
  | \coerce value : isDefined -> E

  -- | Predicate `\Sigma (P : isDefined) (value P = a)` asserting the partial element is defined and equals `a`.
  \func HasValue (a : E) => \Sigma (P : isDefined) (value P = a)
} \where {
  -- | Builder constructing a `Partial X` from a proposition `P` and a function `P -> X`.
  \func make {X : \Set} (P : \Prop) (f : P -> X) => \new Partial X P f
}

-- | The always-defined partial element with `isDefined = \Sigma` (unit) and constant value `x`.
\func defined {X : \Set} (x : X) : Partial X \cowith
  | isDefined => \Sigma
  | value _ => x

-- | The never-defined partial element with `isDefined = Empty`.
\func undefined {X : \Set} : Partial X \cowith
  | isDefined => Empty
  | value => \case __

{- | Equality of partial elements from a logical equivalence of definedness propositions and pointwise agreement of
 -   values on both witnesses.
 -}
\lemma partial-ext {X : \Set} {u v : Partial X} (d : u.isDefined <-> v.isDefined) (e : \Pi (p : u.isDefined) (q : v.isDefined) -> u (\box p) = v \box q) : u = v
  => exts (<->_=.1 d, \lam p => pmap u prop-pi *> e p (transport (\lam P => P) (<->_=.1 d) p) *> pmap v prop-pi)

-- | Variant of `partial-ext` requiring agreement only over witnesses of `u.isDefined`.
\lemma partial-ext-left {X : \Set} {u v : Partial X} (d : u.isDefined <-> v.isDefined) (e : \Pi (p : u.isDefined) -> u p = v (d.1 p)) : u = v
  => partial-ext d \lam p _ => pmap u prop-pi *> e p *> pmap v prop-pi

-- | Variant of `partial-ext` requiring agreement only over witnesses of `v.isDefined`.
\lemma partial-ext-right {X : \Set} {u v : Partial X} (d : u.isDefined <-> v.isDefined) (e : \Pi (p : v.isDefined) -> u (d.2 p) = v p) : u = v
  => partial-ext d \lam _ q => pmap u prop-pi *> e q *> pmap v prop-pi

-- | If `u` is defined and its value equals `x`, then `u = defined x`.
\lemma defined-ext {X : \Set} {u : Partial X} {x : X} (d : u.isDefined) (p : u d = x) : u = defined x
  => partial-ext (\lam _ => (), \lam _ => d) \lam q q => pmap u prop-pi *> p
  \where {
    -- | Recovers `u.isDefined` from `u = defined x`.
    \protected \lemma isDefined (p : u = defined x) : u.isDefined
      => transportInv (\lam x => x.isDefined) p ()

    -- | Recovers the value equation `u d = x` from `u = defined x`.
    \protected \lemma value (p : u = defined x) : u (isDefined p) = x
      => transportInv (\lam (v : Partial X) => \Pi (p : v.isDefined) -> v p = x) p (\lam _ => idp) (isDefined p)
  }

-- | If `u.isDefined` is uninhabited, then `u = undefined`.
\lemma undefined-ext {X : \Set} {u : Partial X} (d : Not u.isDefined) : u = undefined
  => partial-ext (d,absurd) \lam p => absurd (d p)

-- | Equality of partials gives a logical equivalence of their definedness propositions.
\lemma partial-defined {X : \Set} {u v : Partial X} (p : u = v) : u.isDefined <-> v.isDefined
  => <->_=.2 $ pmap (isDefined {__}) p

-- | Equality of partials gives equality of their values on any witnesses of definedness.
\lemma partial-value {X : \Set} {u v : Partial X} (p : u = v) {d : u.isDefined} {e : v.isDefined} : u d = v e
  => path \lam i => p i (prop-dpi _ d e i)

-- | Injectivity of `defined`: from `defined x = defined y` derive `x = y`.
\lemma defined-inj {X : \Set} {x y : X} (p : defined x = {Partial X} defined y) : x = y
  => partial-value {X} p

-- | Lift a function `f : X -> Y` to `Partial X -> Partial Y`, preserving the underlying definedness.
\func plift {X Y : \Set} (f : X -> Y) (p : Partial X) : Partial Y \cowith
  | isDefined => p.isDefined
  | value d => f (p d)

{- | Lift a binary function `f : X -> Y -> Z` to `Partial X -> Partial Y -> Partial Z`, with combined definedness
 -   `\Sigma p.isDefined q.isDefined`.
 -}
\func plift2 {X Y Z : \Set} (f : X -> Y -> Z) (p : Partial X) (q : Partial Y) : Partial Z \cowith
  | isDefined => \Sigma p.isDefined q.isDefined
  | value d => f (p d.1) (q d.2)

-- | `AddMonoid` instance on `Partial X` for an `AddMonoid X`, with `zro = defined X.zro` and `+` given by `plift2 (+)`.
\instance PartialAddMonoid (X : AddMonoid) : AddMonoid (Partial X)
  | zro => defined X.zro
  | + => plift2 (+)
  | zro-left => partial-ext (__.2, ((),__)) \lam p q => zro-left
  | zro-right => partial-ext (__.1, (__,())) \lam p q => zro-right
  | +-assoc => partial-ext (\lam s => (s.1.1,(s.1.2,s.2)), \lam s => ((s.1,s.2.1),s.2.2)) \lam p q => +-assoc