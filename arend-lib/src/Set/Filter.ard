{- | Filters on meet-semilattices and their specializations to subsets of a set, including completeness and properness
 -   conditions.
 -
 -   A `Filter` is an upward-closed, finite-meet-stable subset of a top meet-semilattice, generalizing the classical
 -   notion of a filter on a poset or set. The module specializes this to `SetFilter` (filters on the powerset lattice
 -   `SetLattice X`), then layers properness conditions: `WeaklyProperFilter` excludes the empty set, while
 -   `ProperFilter` strengthens this by requiring every member to be inhabited. The design provides functorial action
 -   via preimage (`SetFilter-map` and variants) and equips proper/weakly-proper filters with a meet-semilattice
 -   structure where the meet is intersection of membership predicates.
 -}

\import Function.Meta
\import Logic
\import Logic.Meta
\import Order.Lattice
\import Order.Lattice.CompleteLattice
\import Order.PartialOrder
\import Paths.Meta
\import Set.Set

{- | Record on a `TopMeetSemilattice A` carrying a predicate `F : A -> \Prop` closed under upward-monotonicity
 -   (`filter-mono`), containing `top` (`filter-top`), and closed under binary meets (`filter-meet`).
 -}
\record Filter (A : TopMeetSemilattice) (\coerce F : A -> \Prop)
  | filter-mono {a b : A} : F a -> a <= b -> F b
  | filter-top : F top
  | filter-meet {a b : A} : F a -> F b -> F (a ∧ b)
  \where {
    -- | The principal filter generated by an element `a : A`, defined as `{b | a <= b}`.
    \func principal {A : TopMeetSemilattice} (a : A) : Filter A \cowith
      | F => a <=
      | filter-mono => <=∘
      | filter-top => top-univ
      | filter-meet => meet-univ
  }

{- | Extends `Filter` over a `CompleteLattice`, additionally requiring that membership of an arbitrary `Join f` implies
 -   membership of some `f j` (`filter-Join`).
 -}
\record CompleteFilter \extends Filter {
  \override A : CompleteLattice
  | filter-Join {C : A -> \Prop} : F (Join C) -> ∃ (w : C) (F w)

  \lemma filter-SJoin {I : \Type} {f : I -> A} {C : I -> \Prop} (FJ : F (CompleteLattice.SJoin f C)) : ∃ (i : C) (F (f i))
    => \case filter-Join FJ \with {
      | inP (_, inP ((i,Ci),idp), Ffi) => inP (i, Ci, Ffi)
    }

  \lemma filter-IJoin {I : \Type} {f : I -> A} (FJ : F (CompleteLattice.IJoin f)) : ∃ (i : I) (F (f i))
    => \case filter-Join FJ \with {
      | inP (_, inP (i,idp), Ffi) => inP (i,Ffi)
    }

  {- | Lemma that a complete filter containing `bottom` is empty (i.e. yields `Empty`), expressing the standard
   -   properness criterion.
   -}
  \lemma isProper (p : F CompleteLattice.bottom) : Empty
    => \case filter-Join {_} {\lam _ => Empty} (filter-mono p bottom-univ) \with {
      | inP (_,(),_)
    }
}

-- | A `Filter` specialized to `A := SetLattice X`, i.e. a filter of subsets of a set `X`.
\record SetFilter (X : \Set) \extends Filter
  | A => SetLattice X

{- | Pushforward of a `SetFilter` along `f : X -> Y`, defined by preimage: `V` belongs to the image filter iff `f ^-1 V`
 -   belongs to the source.
 -}
\func SetFilter-map {X Y : \Set} (f : X -> Y) (F : SetFilter X) : SetFilter Y \cowith
  | F V => F (f ^-1 V)
  | filter-mono d p => filter-mono d (p __)
  | filter-top => filter-top
  | filter-meet => filter-meet

-- | Extends `SetFilter` with `isWeaklyProper : Not (F bottom)`, i.e. the empty subset is not in the filter.
\record WeaklyProperFilter \extends SetFilter
  | isWeaklyProper : Not (F bottom)

{- | Extends `WeaklyProperFilter` with `isProper`: every `U` in the filter is inhabited (`∃ U`); weak properness is
 -   derived automatically.
 -}
\record ProperFilter \extends WeaklyProperFilter
  | isProper {U : Set X} : F U -> ∃ U
  | isWeaklyProper Fb => \case isProper Fb \with {
    | inP (x, inP (_,(),_))
  }

-- | The principal proper filter at a point `x : X`, consisting of all subsets `U` with `U x`.
\func pointFilter {X : \Set} (x : X) : ProperFilter X \cowith
  | F U => U x
  | filter-mono d p => p d
  | filter-top => ()
  | filter-meet p q => (p,q)
  | isProper Ux => inP (x,Ux)

-- | Pushforward along `f : X -> Y` preserving weak properness; reuses `SetFilter-map`.
\func WeaklyProperFilter-map {X Y : \Set} (f : X -> Y) (F : WeaklyProperFilter X) : WeaklyProperFilter Y \cowith
  | SetFilter => SetFilter-map f F
  | isWeaklyProper d => F.isWeaklyProper $ F.filter-mono d \lam (inP (_,(),_))

-- | Pushforward preserving properness; reuses `SetFilter-map`.
\func ProperFilter-map {X Y : \Set} (f : X -> Y) (F : ProperFilter X) : ProperFilter Y \cowith
  | SetFilter => SetFilter-map f F
  | isProper d => TruncP.map (isProper d) \lam s => (f s.1, s.2)

{- | `MeetSemilattice` instance on `WeaklyProperFilter X` with order given by inclusion of membership predicates and
 -   meet given by intersection (`F U ∧ G U` as a Σ-type).
 -}
\instance WeaklyProperFilterSemilattice (X : \Set) : MeetSemilattice (WeaklyProperFilter X)
  | <= F G => F ⊆ G
  | <=-refl c => c
  | <=-transitive f g c => g (f c)
  | <=-antisymmetric f g => exts \lam U => ext (f,g)
  | meet F G => \new WeaklyProperFilter {
    | F U => \Sigma (F U) (G U)
    | filter-mono s p => (filter-mono s.1 p, filter-mono s.2 p)
    | filter-top => (filter-top, filter-top)
    | filter-meet s t => (filter-meet s.1 t.1, filter-meet s.2 t.2)
    | isWeaklyProper s => isWeaklyProper s.1
  }
  | meet-left s => s.1
  | meet-right s => s.2
  | meet-univ f g c => (f c, g c)

{- | Analogous `MeetSemilattice` instance on `ProperFilter X`, with the meet inheriting properness from the left
 -   component.
 -}
\instance ProperFilterSemilattice (X : \Set) : MeetSemilattice (ProperFilter X)
  | <= F G => F ⊆ G
  | <=-refl c => c
  | <=-transitive f g c => g (f c)
  | <=-antisymmetric f g => exts \lam U => ext (f,g)
  | meet F G => \new ProperFilter {
    | F U => \Sigma (F U) (G U)
    | filter-mono s p => (filter-mono s.1 p, filter-mono s.2 p)
    | filter-top => (filter-top, filter-top)
    | filter-meet s t => (filter-meet s.1 t.1, filter-meet s.2 t.2)
    | isProper s => isProper s.1
  }
  | meet-left s => s.1
  | meet-right s => s.2
  | meet-univ f g c => (f c, g c)