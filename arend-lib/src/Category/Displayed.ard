{- | Displayed categories over a base category, providing a framework for fibered/indexed structures.
 -
 -   A displayed category over `C` consists of a family of "displayed objects" `DOb : C -> \hType` together with
 -   displayed morphisms `DHom f x y` lying over each base morphism `f : Hom a b`. Composition and identity laws are
 -   stated up to `transport` along the corresponding base equalities, since the displayed hom-set depends on the
 -   underlying morphism. The total category packages base and displayed data into ordinary `\Sigma`-types, and the
 -   projection to `C` is a functor; univalence is similarly displayed, ensuring identity types of displayed objects
 -   correspond to displayed isos over `idIso`.
 -}

\import Category
\import Category.Functor
\import Equiv
\import Equiv.Sigma
\import Function.Meta
\import Logic
\import Meta
\import Paths
\import Paths.Meta

{- | Class of displayed precategories over a base `Precat C`. Carries `DOb : C -> \hType`, displayed homs `DHom f x y`
 -   indexed by `f : Hom a b`, displayed identity `id^`, displayed composition `∘^`, and the unitality and associativity
 -   laws expressed as transports along the corresponding base equalities (`id-left`, `id-right`, `o-assoc`).
 -}
\class DPrecat {C : Precat} (DOb : C -> \Type)
  | DHom {a b : C} : Hom a b -> DOb a -> DOb b -> \Set
  | id^ {a : C} (x : DOb a) : DHom id x x
  -- | Displayed composition; given `g^ : DHom g y z` and `f^ : DHom f x y`, produces `DHom (g ∘ f) x z`.
  | \fixl 8 o^ \alias \infixl 8 ∘^ {a b c : C} {g : Hom b c} {f : Hom a b} {x : DOb a} {y : DOb b} {z : DOb c} : DHom g y z -> DHom f x y -> DHom (g ∘ f) x z
  -- | Coherence laws for displayed composition, modulo `transport` along the base category's laws.
  | id^-left {a b : C} {f : Hom a b} {x : DOb a} {y : DOb b} {f^ : DHom f x y} : transport (DHom __ x y) id-left (id^ y ∘^ f^) = f^
  -- | Coherence laws for displayed composition, modulo `transport` along the base category's laws.
  | id^-right {a b : C} {f : Hom a b} {x : DOb a} {y : DOb b} {f^ : DHom f x y} : transport (DHom __ x y) id-right (f^ ∘^ id^ x) = f^
  -- | Coherence laws for displayed composition, modulo `transport` along the base category's laws.
  | o^-assoc {a b c d : C} {h : Hom c d} {g : Hom b c} {f : Hom a b} {x : DOb a} {y : DOb b} {z : DOb c} {w : DOb d} {h^ : DHom h z w} {g^ : DHom g y z} {f^ : DHom f x y} : transport (DHom __ x w) o-assoc ((h^ ∘^ g^) ∘^ f^) = h^ ∘^ (g^ ∘^ f^)

{- | Record of a displayed isomorphism over a base `Iso e`, packaging a displayed morphism `f : DHom e.f dom cod`, its
 -   displayed inverse `inv^`, and the two roundtrip laws (`inv^-left`, `inv^-right`) stated via transport along
 -   `e.hinv_f` and `e.f_hinv`.
 -}
\record DIso {D : DPrecat {}} (e : Iso {D.C}) {dom : D e.dom} {cod : D e.cod} (\coerce f : DHom e.f dom cod)
  | inv^ : DHom e.hinv cod dom
  | inv^-left : transport (DHom __ dom dom) e.hinv_f (inv^ ∘^ f) = id^ dom
  | inv^-right : transport (DHom __ cod cod) e.f_hinv (f ∘^ inv^) = id^ cod

-- | The identity displayed iso over `idIso`, with both forward and inverse components given by `id^ x`.
\func idIso^ {D : DPrecat {}} {a : D.C} {x : D a} : DIso idIso {x} {x} \cowith
  | f => id^ x
  | inv^ => id^ x
  | inv^-left => rewrite (prop-isProp idIso.hinv_f id-left) id^-left
  | inv^-right => rewrite (prop-isProp idIso.hinv_f id-right) id^-right

{- | Builds the Grothendieck-style total precategory of a displayed precategory `D`, with objects `\Sigma (a : C) (D a)`
 -   and morphisms pairing a base morphism with a displayed one.
 -}
\func totalPrecat (D : DPrecat {}) : Precat \cowith
  | Ob => \Sigma (a : D.C) (D a)
  | Hom (a,x) (b,y) => \Sigma (f : Hom a b) (DHom f x y)
  | id {(a,x)} => (id, id^ x)
  | o (g,g^) (f,f^) => (g ∘ f, g^ ∘^ f^)
  | id-left => ext (id-left, id^-left)
  | id-right => ext (id-right, id^-right)
  | o-assoc => ext (o-assoc, o^-assoc)
  \where {
    -- | The forgetful functor `totalPrecat D -> C` projecting onto the base component.
    \func proj : Functor (totalPrecat D) D.C \cowith
      | F x => x.1
      | Func f => f.1
      | Func-id => idp
      | Func-o => idp
  }

{- | Extends `DPrecat` with a displayed univalence axiom: for each base object `a` and displayed objects `x y : DOb a`,
 -   the canonical map `idtoiso^ : x = y -> DIso idIso {x} {y}` is an equivalence.
 -}
\class DCat \extends DPrecat
  | univalence^ {a : C} {x y : DOb a} : IsEquiv {x = y} {DIso idIso {x} {y}} idtoiso^
  \where {
    {- | The canonical map sending a path between displayed objects (over the same base) to a displayed iso over
     -   `idIso`, defined by path induction.
     -}
    \func idtoiso^ {D : DPrecat {}} {a : D.C} {x y : D a} (q : x = y) : DIso idIso {x} {y} \elim q
      | idp => idIso^

    -- | Promotes the total precategory to a univalent `Cat`, given that the base precategory `C` is itself univalent.
    \func totalCat (D : DCat {}) (C-uni : \Pi {a b : D.C} -> IsEquiv (Precat.idtoiso {_} {a} {b})) : Cat \cowith
      | Precat => totalPrecat D
      | univalence => Cat.univalenceFromQEquiv (later \lam {t} {s} => transQEquiv (sigmaEquiv D t s) $ transQEquiv (sigma-right eq-over) $ transQEquiv (sigma-left {_} {_} {\lam e => DIso e {t.2} {s.2}} $ IsEquiv.toQEquiv C-uni) (total-iso D)) (\lam {p} => idp)

    {- | Equivalence between pairs `(e : Iso, DIso e)` and isos in the total category, used to assemble/decompose total
     -   isos.
     -}
    \func total-iso (D : DCat {}) {x y : totalPrecat D} : QEquiv {\Sigma (e : Iso {_} {x.1} {y.1}) (DIso e {x.2} {y.2})} {Iso {totalPrecat D} {x} {y}} \cowith
      | f p => \new Iso {
        | f => (p.1, p.2)
        | hinv => (hinv {p.1}, DIso.inv^ {p.2})
        | hinv_f => ext (hinv_f {p.1}, DIso.inv^-left {p.2})
        | f_hinv => ext (f_hinv {p.1}, DIso.inv^-right {p.2})
      }
      | ret (e : Iso) => (totalPrecat.proj.Func-iso e, \new DIso {
        | f => e.f.2
        | inv^ => e.hinv.2
        | inv^-left => rewrite (prop-isProp (hinv_f {totalPrecat.proj.Func-iso e}) (pmap __.1 e.hinv_f)) (sigmaEquiv _ _ _ e.hinv_f).2
        | inv^-right => rewrite (prop-isProp (f_hinv {totalPrecat.proj.Func-iso e}) (pmap __.1 e.f_hinv)) (sigmaEquiv _ _ _ e.f_hinv).2
      })
      | ret_f p => idp
      | f_sec e => idp

    {- | For a base path `p : a = b`, an equivalence between `transport D p x = y` and displayed isos
     -   `DIso (idtoiso p) {x} {y}` — the dependent generalization of univalence over a non-trivial base path.
     -}
    \func eq-over {D : DCat {}} {a b : D.C} {x : D a} {y : D b} (p : a = b) : QEquiv {transport D p x = y} {DIso (Precat.idtoiso p) {x} {y}} \elim p
      | idp => IsEquiv.toQEquiv univalence^
  }
