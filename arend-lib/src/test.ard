\lemma test8 (k n : Nat) (A0 : k < suc n) : suc k <= suc n => linarith -- linarith fails here

\func one_n : Real => Real.fromRat (ratio 1 7)

\func test_one_n : one_n * one_n > 0 => linarith

\lemma test9 : (7 : Real) * Real.fromRat (ratio 1 7) = 1 => linarith

\lemma BigSum_sum {E : CRing} {n : Nat} {l l' : Array E n} : AddMonoid.BigSum (\new Array E n (\lam i => l i + l' i)) = AddMonoid.BigSum l + AddMonoid.BigSum l' \elim n, l, l'
  | 0, nil, nil => inv zro-left
  | suc n, a :: l, a1 :: l' => unfold AddMonoid.BigSum (rewrite (BigSum_sum {E} {n} {l} {l'})
  (unfold AddMonoid.BigSum linarith))

\lemma BigSum_ldistr {E : CRing} {n : Nat} (l : Array E n) (a : E) : AddMonoid.BigSum (\new Array E n (\lam i => a * l i)) = a * AddMonoid.BigSum (\new Array E n l) \elim n, l
  | 0, nil => rewrite zro_*-right idp
  | suc n, a1 :: l => unfold AddMonoid.BigSum (rewrite (BigSum_ldistr l a) (unfold AddMonoid.BigSum equation.ring))


