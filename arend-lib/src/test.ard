\lemma test3 (V : PosetQModule) (B : BooleanRing) {l : PFunc {V} {B}} {v : V} : SFRefines l (add v BooleanRing.zro l)
  => rewrite (\peval add v BooleanRing.zro l) $ SFRefines_::-right (B.meet_<=' equation.bRing) $ SFRefines_++-right (transport (SFRefines l) (exts \lam j => ext (idp, equation.bRing)) SFuncPosetQModule.SFRefines-refl) \lam j => byRight $ meet-left <=∘ bottom-univ
  \where {
    \func step1 (V : PosetQModule) (B : BooleanRing) {l : PFunc {V} {B}} {v : V} : SFRefines l (add v BooleanRing.zro l)
      => rewrite (\peval add v BooleanRing.zro l) $ {?}
    -- goal: SFRefines l
    --       ((v, diff zro (BigJoin (map (\lam p0 => p0.2) l))) :: map (\lam s => (v + s.1, zro * s.2)) l ++ map (\lam s => (s.1, diff s.2 zro)) l)

    \func step2 (V : PosetQModule) (B : BooleanRing) {l : PFunc {V} {B}} {v : V} : SFRefines l (add v BooleanRing.zro l)
      => rewrite (\peval add v BooleanRing.zro l)
                 $ SFRefines_::-right {?} {?}
    -- goal1: diff B.zro (BigJoin (map (\lam p0 => p0.2) l)) B.<= BigJoin (map (\lam p0 => p0.2) l)
    -- goal2: SFRefines l (map (\lam s => (v + s.1, zro * s.2)) l ++ map (\lam s => (s.1, diff s.2 zro)) l)

    \func step3 (V : PosetQModule) (B : BooleanRing) {l : PFunc {V} {B}} {v : V} : SFRefines l (add v BooleanRing.zro l)
      => rewrite (\peval add v BooleanRing.zro l)
                 $ SFRefines_::-right (B.meet_<=' equation.bRing) {?}
    -- goal: SFRefines l (map (\lam s => (v + s.1, zro * s.2)) l ++ map (\lam s => (s.1, diff s.2 zro)) l)

    \func step4 (V : PosetQModule) (B : BooleanRing) {l : PFunc {V} {B}} {v : V} : SFRefines l (add v BooleanRing.zro l)
      => rewrite (\peval add v BooleanRing.zro l)
                 $ SFRefines_::-right (B.meet_<=' equation.bRing)
                                      $ SFRefines_++-right {?} {?}
    -- goal1: SFRefines l (map (\lam s => (s.1, diff s.2 B.zro)) l)
    -- goal2: \Pi (j : Fin (len {map (\lam s => (v V.+ s.1, B.zro B.* s.2)) l})) ->
    --       (v V.+ (l j).1 = V.zro) || B.zro B.* (l j).2 B.<= BigJoin (map (\lam p0 => p0.2) l)

    \func step5 (V : PosetQModule) (B : BooleanRing) {l : PFunc {V} {B}} {v : V} : SFRefines l (add v BooleanRing.zro l)
      => rewrite (\peval add v BooleanRing.zro l)
                 $ SFRefines_::-right (B.meet_<=' equation.bRing)
                                      $ SFRefines_++-right (transport (SFRefines l) {?} SFuncPosetQModule.SFRefines-refl) {?}
    -- goal1: l = map (\lam s => (s.1, diff s.2 B.zro)) l
    -- goal2: \Pi (j : Fin (len {map (\lam s => (v V.+ s.1, B.zro B.* s.2)) l})) ->
    --       (v V.+ (l j).1 = V.zro) || B.zro B.* (l j).2 B.<= BigJoin (map (\lam p0 => p0.2) l)

    \func step6 (V : PosetQModule) (B : BooleanRing) {l : PFunc {V} {B}} {v : V} : SFRefines l (add v BooleanRing.zro l)
      => rewrite (\peval add v BooleanRing.zro l)
                 $ SFRefines_::-right (B.meet_<=' equation.bRing)
                                      $ SFRefines_++-right (transport (SFRefines l) (exts {?}) SFuncPosetQModule.SFRefines-refl) {?}
    -- goal1: \Pi (j : Fin l.len) -> l j = ((l j).1, diff (l j).2 B.zro)
    -- goal2: \Pi (j : Fin (len {map (\lam s => (v V.+ s.1, B.zro B.* s.2)) l})) ->
    --       (v V.+ (l j).1 = V.zro) || B.zro B.* (l j).2 B.<= BigJoin (map (\lam p0 => p0.2) l)

    \func step7 (V : PosetQModule) (B : BooleanRing) {l : PFunc {V} {B}} {v : V} : SFRefines l (add v BooleanRing.zro l)
      => rewrite (\peval add v BooleanRing.zro l)
                  $ SFRefines_::-right (B.meet_<=' equation.bRing)
                                       $ SFRefines_++-right (transport (SFRefines l) (exts \lam j => exts (idp, equation.bRing)) SFuncPosetQModule.SFRefines-refl)
                                                            {?}
    -- goal: \Pi (j : Fin (len {map (\lam s => (v V.+ s.1, B.zro B.* s.2)) l})) ->
    --       (v V.+ (l j).1 = V.zro) || B.zro B.* (l j).2 B.<= BigJoin (map (\lam p0 => p0.2) l)

    \func step8 (V : PosetQModule) (B : BooleanRing) {l : PFunc {V} {B}} {v : V} : SFRefines l (add v BooleanRing.zro l)
      => rewrite (\peval add v BooleanRing.zro l)
                  $ SFRefines_::-right (B.meet_<=' equation.bRing)
                                       $ SFRefines_++-right (transport (SFRefines l) (exts \lam j => exts (idp, equation.bRing)) SFuncPosetQModule.SFRefines-refl)
                                                             \lam j => byRight $ meet-left <=∘ bottom-univ
    -- goal: \Pi (j : Fin (len {map (\lam s => (v V.+ s.1, B.zro B.* s.2)) l})) ->
    --       (v V.+ (l j).1 = V.zro) || B.zro B.* (l j).2 B.<= BigJoin (map (\lam p0 => p0.2) l)
  }
    -- SFRefines_++-right (transport (SFRefines l) (exts \lam j => ext (idp,equation.bRing)) SFuncPosetQModule.SFRefines-refl) \lam j => byRight $ meet-left <=∘ bottom-univ



\lemma test4 (A : BaseSet) (B : AddMonoid) (f g : FinSuppFunc A B) (s : Array f.Dom) (s' : Array g.Dom)
  (c : \Pi (i : f.Dom) -> (\Pi (j : Fin s.len) -> s j /= i) -> f i = zro {f.Cod})
  (c' : \Pi (i : g.Dom) -> (\Pi (j : Fin s'.len) -> s' j /= i) -> g i = zro {g.Cod})
  : TruncP (\Sigma (s : Array A) (\Pi (i : A) -> (\Pi (j : Fin s.len) -> s j /= i) -> f i B.+ g i = B.zro))
  => inP {?}

-- TruncP (\Sigma (s : Array A) (\Pi (i : A) -> (\Pi (j : Fin s.len) -> s j /= i) -> f i B.+ g i = B.zro))
-- inP (s ++ s', \lam a d => pmap2 (+) (c a \lam j => rewrite ++.++_index-left in d (++.index-left j)) (c' a \lam j => rewrite ++.++_index-right in d (++.index-right j)) *> zro-left)

\lemma test5 {R : CRing} {n : Nat} (M : Matrix R n n) : degree<= (charPoly M) n
  => degree<=_FinSum \lam j => degree<=_* (transport (degree<= __ 0) (sign.sign_hom polyHom) idp) $ later $ degree<=_BigProd1 \lam _ => idp

\lemma test6 {n m : Nat} (n/=0 : Not (n = 0)) (m/=0 : Not (m = 0)) : Not (n Nat.* m = 0)
  => \lam p => IntDomain.#0-* {pos n} {pos m} (\lam q => n/=0 (pmap iabs q)) (\lam q => m/=0 (pmap iabs q)) (pmap pos p)
  -- IntDomain.#0-* (\lam q => n/=0 (pmap iabs q)) (\lam q => m/=0 (pmap iabs q))
-- {pos n} {pos m}

