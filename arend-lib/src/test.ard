\lemma test2 (V : PosetQModule) (B : BooleanRing) (r r' l  : SFuncPosetQModule.PFunc {V} {B})
 (k : Fin r.len) (j : Fin l.len) (p : (l j).1 = (r k).1) (q : (l j).2 B.<= (r k).2)
  : TruncP (\Sigma (j' : Fin (r ++ r').len) ((l j).1 = ((r ++ r') j').1) ((l j).2 B.<= ((r ++ r') j').2))
  => inP (++.index-left k, {?}, q <=∘ =_<= {?})

 -- p *> pmap (\lam p0 => p0.1) (inv $ ++.++_index-left k)
