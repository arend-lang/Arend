{- | Sets and lattices equipped with compatible partial and strict order relations.
 -
 -   This module unifies a non-strict order `<=` with a strict order `<` on the same carrier, requiring the two to
 -   interact coherently via mixed transitivity laws and an implication from strict to non-strict. Building on this,
 -   `BiorderedLattice` adds lattice structure where strict inequalities propagate through meets and joins, giving
 -   universal properties and monotonicity for both finite binary operations and indexed `Big` operations over arrays.
 -   The design lets proofs freely mix `<` and `<=` steps, which is essential for ordered algebraic structures (ordered
 -   rings, fields, etc.) where both relations naturally coexist.
 -}

\import Data.Array
\import Order.Lattice
\import Order.PartialOrder
\import Order.StrictOrder

-- | Class extending `StrictPoset` and `Poset` on a common carrier `E`, with axioms tying the two orders together.
\class BiorderedSet \extends StrictPoset, Poset {
  -- | Mixed transitivity: `a1 <= a2 -> a2 < a3 -> a1 < a3`.
  | <-transitive-right \alias \infixr 9 <∘r {a1 a2 a3 : E} : a1 <= a2 -> a2 < a3 -> a1 < a3
  -- | Mixed transitivity: `a1 < a2 -> a2 <= a3 -> a1 < a3`.
  | <-transitive-left \alias \infixl 8 <∘l {a1 a2 a3 : E} : a1 < a2 -> a2 <= a3 -> a1 < a3
  -- | Strict order implies non-strict: `a1 < a2 -> a1 <= a2`.
  | <=-less {a1 a2 : E} : a1 < a2 -> a1 <= a2

  -- | The opposite biordered set, reversing both `<` and `<=`.
  \protected \func op : BiorderedSet \cowith
    | StrictPoset => StrictPoset.op
    | Poset => Poset.op
    | <-transitive-right p q => q <∘l p
    | <-transitive-left p q => q <∘r p
    | <=-less => <=-less
}

-- | Class extending `BiorderedSet` and `Lattice`, requiring strict inequalities to be compatible with meets and joins.
\class BiorderedLattice \extends BiorderedSet, Lattice {
  -- | Universal property of meet for `<`: `x < y -> x < z -> x < y ∧ z`.
  | <_meet-univ {x y z : E} : x < y -> x < z -> x < y ∧ z
  -- | Universal property of join for `<`: `x < z -> y < z -> x ∨ y < z`.
  | <_join-univ {x y z : E} : x < z -> y < z -> x ∨ y < z

  -- | Meet is strictly monotone in both arguments: `x < y -> x' < y' -> x ∧ x' < y ∧ y'`.
  \lemma <_meet-monotone {x x' y y' : E} (p : x < y) (q : x' < y') : x ∧ x' < y ∧ y'
    => <_meet-univ (meet-left <∘r p) (meet-right <∘r q)

  -- | Indexed meet universal property: if `y < x` and `y < l i` for every index, then `y < Big ∧ x l`.
  \lemma Big_<_meet-univ {l : Array E} {x y : E} (p : y < x) (f : \Pi (i : Fin l.len) -> y < l i) : y < Big (∧) x l \elim l
    | nil => p
    | :: a l => <_meet-univ (f 0) (Big_<_meet-univ p (\lam i => f (suc i)))

  -- | Join is strictly monotone in both arguments: `x < y -> x' < y' -> x ∨ x' < y ∨ y'`.
  \lemma <_join-monotone {x x' y y' : E} (p : x < y) (q : x' < y') : x ∨ x' < y ∨ y'
    => <_join-univ (p <∘l join-left) (q <∘l join-right)

  -- | Indexed join universal property: if `x < y` and `l i < y` for every index, then `Big ∨ x l < y`.
  \lemma Big_<_join-univ {l : Array E} {x y : E} (p : x < y) (f : \Pi (i : Fin l.len) -> l i < y) : Big (∨) x l < y \elim l
    | nil => p
    | :: a l => <_join-univ (f 0) (Big_<_join-univ p (\lam i => f (suc i)))
}