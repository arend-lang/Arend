\import Paths

-- # Prop

\func isProp (A : \Cat) => \Pi (a a' : A) -> a = a'
  \where {
    \use \sfunc =>isSet {A : \Cat} (p : isProp A) (a a' : A) : isProp (a = a')
      => \lam s t => \have q => Jl (\lam x q => inv (p a a) *> p a x = q) inv_*>
                     \in inv (q s) *> q t

    \use \level levelProp (A : \Cat) (e e' : isProp A) : e = e'
      => path \lam i a a' => =>isSet e a a' (e a a') (e' a a') i

  }

\func isSet (A : \Cat) => \Pi (a a' : A) (p q : a = a') -> p = q
  \where {
    \use \level levelProp {A : \Cat} (e e' : isSet A) : e = e'
      => path \lam i a a' => isProp.levelProp (a = a') (e a a') (e' a a') i

  }

-- | hLevels are closed under pi-types
\func pi-isProp {A : \Cat} (B : A -> \Cat) (p : \Pi (a : A) -> isProp (B a)) : isProp (\Pi (a : A) -> B a)
  => \lam f f' => path \lam i a => p a (f a) (f' a) i

-- # Contr

\func isProp-retract {A B : \Cat} (f : B -> A) (g : A -> B) (gf : \Pi (b : B) -> g (f b) = b) (p : isProp A) : isProp B
  => \lam b b' => inv (gf b) *> pmap g (p (f b) (f b')) *> gf b'
