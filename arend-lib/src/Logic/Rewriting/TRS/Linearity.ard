{- | Linear terms, patterns, and rewrite rules for higher-order term rewriting systems.
 -
 -   This module formalizes *linear* syntactic objects in a higher-order rewriting setting: terms in which each
 -   metavariable position appears at most once and is fully applied to the local variable context. Linearity is
 -   enforced structurally via the `GenericLinearTerm` datatype, which is parameterized by a proposition controlling
 -   whether variable occurrences are allowed — yielding `LinearTerm` (variables permitted) and `LinearPattern` (no
 -   variables, suitable as left-hand sides of rules). The metacontext for a linear term is computed inductively to
 -   match its shape, so each metavariable hole gets its own slot in a `ModularMetaContext`, allowing rewrite rules to
 -   be presented compactly without manual metacontext bookkeeping.
 -}

\import Data.List \hiding (Sort)
\import Logic
\import Logic.Rewriting.TRS.Utils.FinFunctions
\import Paths
\import Paths.Meta
\import Data.SubList
\import Logic.Rewriting.TRS.HRS
\import Logic.Rewriting.TRS.MetaContexts
\import Logic.Rewriting.TRS.Substitutions
\open FSignature

{- | Inductive datatype of linear higher-order terms over signature `env`, in `context : List Sort` at sort `termSort`,
 -   parameterized by a proposition `allow-variables` toggling whether `l-var` constructors are permitted.
 -}
\data GenericLinearTerm
  (env : FSignature)
  (context : List Sort)
  (termSort : Sort)
  (allow-variables : \Prop)
  {- | Function symbol applied to linear subterm arguments, each in the extended context
   -   `context ++ (f !!domain index)`.
   -}
  | l-func
    (f : symbol termSort)
    (arguments : DArray {arity f} (\lam index => GenericLinearTerm env (context ++ (f !!domain index)) (f !!sort index) allow-variables))
  -- | A metavariable hole applied to the identity substitution on the ambient context (i.e. fully linear use).
  | l-full-metavar
  -- | Variable reference at a context index (only available when `allow-variables` holds).
  | l-var (index : Index context) (termSort = context !! index) allow-variables

\module Linear \where {
  {- | Embeds a `GenericLinearTerm` into the general `Term` type using its computed `LinearMetaContext`, lifting subterm
   -   metavariables through `ModularMetaContext.upgrade-metavariables` so each child's local metacontext is reindexed
   -   into the combined parent metacontext.
   -}
  \func convert-to-term
    {env : FSignature} {context : List Sort} {s : Sort} {allowVariables : \Prop}
    (term : GenericLinearTerm env context s allowVariables)
    : Term env context s (LinearMetaContext term)
  \elim term
    | l-func f arguments => func f (\lam i => ModularMetaContext.upgrade-metavariables (\lam i => LinearMetaContext (arguments i)) (convert-to-term (arguments i)))
    | l-var index p _ => var index p
    | l-full-metavar => metavar idp (\lam i => var i idp)
}

{- | Computes the canonical `MetaContext Sort` induced by a linear term — `EmptyMetaContext` for variables,
 -   `SingularMetaContext s context` for a hole, and `ModularMetaContext` recursively combining children's metacontexts
 -   for function applications.
 -}
\func LinearMetaContext {env : FSignature} {context : List Sort} {s : Sort} {allowVariables : \Prop}
                        (term : GenericLinearTerm env context s allowVariables) : MetaContext.{0} Sort \elim term
  | l-func f arguments => ModularMetaContext (\lam i => LinearMetaContext (arguments i))
  | l-var index p _ => EmptyMetaContext
  | l-full-metavar => SingularMetaContext s context

-- | `GenericLinearTerm` with `allow-variables = \Sigma` (unit) — variables are permitted.
\func LinearTerm (env : FSignature) (context : List Sort) (termSort : Sort) : \Set
  => GenericLinearTerm env context termSort (\Sigma)

-- | Smart constructor for variable references in `LinearTerm`.
\cons lt-var {env : FSignature} {context : List Sort} {termSort : Sort} (index : Index context) (p : termSort = context !! index)
: LinearTerm env context termSort
=> l-var index p ()

-- | `GenericLinearTerm` with `allow-variables = Empty` — no variables, used as rewrite-rule left-hand sides.
\func LinearPattern (env : FSignature) (context : List Sort) (termSort : Sort) : \Set
  => GenericLinearTerm env context termSort Empty

{- | States that applying a metasubstitution `rho : MetaSubstitution env subcontext (ModularMetaContext sigs) msig`
 -   after upgrading a term from component `sigs i` agrees with applying the restricted substitution
 -   `\lam m => rho (i, m)` directly — i.e. modular metacontext upgrading commutes with substitution.
 -}
\lemma modular-commutation {env : FSignature} {subcontext context : List Sort} {s : Sort} {msig : MetaContext Sort}
                           {n : Nat}
                           (sigs : \Pi (i : Fin n) -> MetaContext Sort)
                           (i : Fin n)
                           (sublist : SubList subcontext context)
                           (term : Term env context s (sigs i))
                           (rho : MetaSubstitution env subcontext (ModularMetaContext sigs) msig)
  :
  MetaSubstitution.apply term sublist (\lam m => rho (i, m))
    =
  MetaSubstitution.apply (ModularMetaContext.upgrade-metavariables sigs term) sublist rho
\elim term
  | var index p => idp
  | metavar m arguments => pmap
      (\lam f => Substitution.apply (rho (i, m)) (extend-substitution-left sublist f))
      (ext (\lam index => modular-commutation sigs i sublist (arguments index) rho))
  | func f arguments => Term.fext (\lam index => modular-commutation sigs i (SubList.extend-right-single sublist) (arguments index) rho)

{- | When the source context is empty (`nil`), the choice of `SubList nil (context ++ context')` is irrelevant: any two
 -   sublist witnesses produce the same result of `MetaSubstitution.apply`.
 -}
\lemma invariant-through-empty-subst
  {env : FSignature} {context context' : List Sort} {s : Sort} {old-msig new-msig : MetaContext Sort}
  (rho : MetaSubstitution env nil old-msig new-msig)
  (sublist sublist' : SubList nil (context ++ context'))
  (term : Term env (context ++ context') s old-msig)
  :
  MetaSubstitution.apply term sublist rho
    =
  MetaSubstitution.apply term sublist' rho => lemma rho sublist sublist' term (trivial-sublist-contractible _ _)
  \where {
    -- | Auxiliary form proving the same equality from explicit equality of the sublist witnesses.
    \lemma lemma
      {env : FSignature} {context context' : List Sort} {s : Sort} {old-msig new-msig : MetaContext Sort}
      (rho : MetaSubstitution env nil old-msig new-msig)
      (sublist sublist' : SubList nil (context ++ context'))
      (term : Term env (context ++ context') s old-msig)
      (eq : sublist = sublist')
      : MetaSubstitution.apply term sublist rho = MetaSubstitution.apply term sublist' rho \elim eq
      | idp => idp
  }

{- | Extends `RewriteRule` by specifying the left-hand side as a `LinearPattern`; the rule's metacontext `rr-mc` and
 -   term `rr-l` are derived automatically via `LinearMetaContext` and `Linear.convert-to-term` respectively.
 -}
\record LinearRewriteRule \extends RewriteRule {
  -- | The `LinearPattern env nil s` serving as the rule's left-hand side.
  | rr-pattern : LinearPattern env nil s
  | rr-mc => LinearMetaContext rr-pattern
  | rr-l => Linear.convert-to-term rr-pattern
}

-- | Extends `RuleRegistry`, overriding `rule-container` to require every rule be a `LinearRewriteRule`.
\record LinearRegistry \extends RuleRegistry {
  \override rule-container : \Pi {s : Sort} (id : rule-J s) -> LinearRewriteRule {env} s

  -- | Convenience accessor returning the `LinearPattern` of a registered rule by id.
  \func rule-pattern {s : Sort} (idx : rule-J s) : LinearPattern env nil s => rr-pattern {rule-container idx}
}
