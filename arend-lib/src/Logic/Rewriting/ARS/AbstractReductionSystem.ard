{- | Defines abstract reduction systems (ARS) and the basic relations derived from a reduction relation.
 -
 -   An `AbstractReductionSystem` is a set `A` equipped with a reduction relation `~>` and a separate symmetric relation
 -   `|--|` that represents an extra "equivalence" layer (e.g., for rewriting modulo a congruence). Specializing `|--|`
 -   to propositional equality yields a `SimpleARS`. From the primitive `~>` and `|--|`, the module systematically
 -   builds reflexive, transitive, symmetric, and reflexive-transitive closures, plus joinability and conversion
 -   relations, which are the standard tools for stating confluence, normalization, and Church–Rosser-style properties.
 -}

\import Paths
\import Paths.Meta
\import Relation.Truncated

{- | A set `A` with a reduction relation `~> : Rel A` and a symmetric relation `|--| : Rel A` (with `|--|_symmetric`
 -   witnessing symmetry). The intended reading is "one-step reduction" plus an auxiliary equivalence layer.
 -}
\class AbstractReductionSystem \alias ARS (A : \Set)
  | \infix 4 ~> : Rel A -- | Reduction relation
  | \infix 5 |--| : Rel A -- | Symmetric relation
  | |--|_symmetric (a b : A) (a~b : a |--| b) : b |--| a

{- | Extends `AbstractReductionSystem` by fixing `|--|` to be propositional equality `=`, with symmetry given by path
 -   inversion. Use when no extra equivalence layer is needed.
 -}
\class SimpleARS \extends AbstractReductionSystem
  | |--| => \lam a b => a = b
  | |--|_symmetric (a b : A) (p : a |--| b) => inv p

-- | Equality `=` viewed as a relation on an ARS (zero reduction steps as identity).
\func \infix 4 ~>_0 {A : ARS} : Rel A => =

-- | The base one-step reduction `A.~>`.
\func \infix 4 ~>_1 {A : ARS} : Rel A => A.~>

-- | Reflexive closure of `~>` (zero or one step).
\func \infix 4 ~>_= {A : ARS} : Rel A => reflexive-closure (~>)

-- | Transitive closure of `~>` (one or more steps).
\func \infix 4 ~>_+ {A : ARS} : Rel A => TransClosure (~>)

-- | Reflexive-transitive closure of `~>` (zero or more steps); the standard "reduces to" relation.
\func \infix 4 ~>_* {A : ARS} : Rel A => transitive-refl-closure (~>)

-- | Reverse reduction: `a <~ b` iff `b ~> a`.
\func \infix 4 <~ {A : ARS} : Rel A => \lam a b => b ~> a

-- | Symmetric closure of `~>` (one step in either direction).
\func \infix 4 <~> {A : ARS} : Rel A => symmetric-closure (~>)

-- | Symmetry of `<~>`: swaps `sc-left` and `sc-right`.
\func <~>-reverse {A : ARS} {a b : A} (a<~>b : a <~> b) : b <~> a \elim a<~>b
  | sc-left a~>b => sc-right a~>b
  | sc-right a<~b => sc-left a<~b

-- | Reflexive-transitive closure of `<~>`; the conversion relation generated by `~>`.
\func \infix 4 <~>* {A : ARS} : A -> A -> \Prop => transitive-refl-closure (<~>)

-- | Transitivity of `<~>*`: composes two conversion sequences via an intermediate point.
\lemma <~>*-compose {A : ARS} {a c : A} (b : A) (a<~>*b : a <~>* b) (b<~>*c : b <~>* c) : a <~>* c \elim a<~>*b
  | trc-direct a=b => rewrite a=b b<~>*c
  | trc-connect c1 a<~>c1 c1<~>*c => trc-connect c1 a<~>c1 (<~>*-compose b c1<~>*c b<~>*c)

-- | Symmetry of `<~>*`: reverses a conversion sequence.
\lemma <~>*-reverse {A : ARS} {a b : A} (a<~>*b : a <~>* b) : b <~>* a \elim a<~>*b
  | trc-direct p => trc-direct (inv p)
  | trc-connect c a<~>c c<~>*b => <~>*-compose c (<~>*-reverse c<~>*b) (trc-connect a (<~>-reverse a<~>c) (trc-direct idp))

-- | Embeds a single reduction step into the conversion relation.
\lemma ~>=><~>* {A : ARS} {a b : A} (red : a ~> b) : a <~>* b => trc-connect b (sc-left red) (trc-direct idp)

-- | Embeds a multi-step reduction into the conversion relation.
\lemma ~>*=><~>* {A : ARS} {a b : A} (red : a ~>_* b) : a <~>* b \elim red
  | trc-direct a=b => trc-direct a=b
  | trc-connect c r t => trc-connect c (sc-left r) (~>*=><~>* t)

-- | Transitivity of `~>_*`: concatenates two reduction sequences.
\lemma ~>*-concat {A : ARS} {a b c : A} (a~>*b : a ~>_* b) (b~>*c : b ~>_* c) : a ~>_* c \elim a~>*b
  | trc-direct a=b => rewrite a=b b~>*c
  | trc-connect c' a~>c' c'~>*b => trc-connect c' a~>c' (~>*-concat c'~>*b b~>*c)

-- | Prepends an at-most-one-step reduction onto a multi-step reduction.
\lemma ~>_=-append {A : ARS} {a b c : A} (a~>_=b : a ~>_= b) (b~>*c : b ~>_* c) : a ~>_* c \elim a~>_=b
  | rc-id p => rewrite p b~>*c
  | rc-rel a~>b => trc-connect b a~>b b~>*c

{- | The proposition that `a` and `b` have a common reduct: `\exists c, a ~>_* c \wedge b ~>_* c`. Constructor `join`
 -   packages the witness and the two reduction paths. Joinability is the standard notion underlying confluence.
 -}
\truncated \data Join {A : ARS} (a b : A) : \Prop
  | join (c : A) (a ~>_* c) (b ~>_* c)
  \where {
    -- | If `c ~>_* a` and `Join a b`, then `Join c b` (extend the joining on the left).
    \lemma append-left {A : ARS} {a b c : A} (c~>*a : c ~>_* a) (j : Join a b) : Join c b \elim j
      | join c' a~>*c' b~>*c' => join c' (~>*-concat c~>*a a~>*c') b~>*c'

    -- | If `c ~>_* b` and `Join a b`, then `Join a c` (extend the joining on the right).
    \lemma append-right {A : ARS} {a b c : A} (c~>*b : c ~>_* b) (j : Join a b) : Join a c \elim j
      | join c' a~>*c' b~>*c' => join c' a~>*c' (~>*-concat c~>*b b~>*c')
  }

-- | Reflexive-transitive closure of `|--|`; the equivalence generated by the auxiliary symmetric relation.
\func \infix 5 ~ {A : ARS} : Rel A => transitive-refl-closure (|--|)

\truncated \data \infix 5 |==| {A : ARS} (a b : A) : \Prop
  | red-to (a ~> b)
  | red-from (a <~ b)
  | eq (a ~ b)

{- | Reflexive-transitive closure of `|==|`; full conversion that mixes reductions in both directions with
 -   `~`-equivalences.
 -}
\func Conversion~ {A : ARS} : Rel A => transitive-refl-closure (|==|)

{- | Joinability up to `~`: there exist `c`, `d` with `a ~>_* c`, `c ~ d`, and `b ~>_* d`. Constructor `join~` packages
 -   the witnesses; this is the joinability notion appropriate for rewriting modulo `~`.
 -}
\truncated \data Join~ {A : ARS} (a b : A) : \Prop
  | join~ (c d : A) (a ~>_* c) (c ~ d) (b ~>_* d)

{- | One-step reduction modulo `~`: `a ~>~ b` iff there exist `c`, `d` with `a ~ c`, `c ~> d`, `d ~ b`. Constructor
 -   `red~` packages the witnesses; this lifts `~>` to the quotient by `~`.
 -}
\truncated \data \infix 4 ~>~ {A : ARS} (a b : A) : \Prop
  | red~ (c d : A) (a ~ c) (c ~> d) (d ~ b)

