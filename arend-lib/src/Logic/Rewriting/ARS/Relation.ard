{- | Foundational definitions for abstract rewriting systems: binary relations, joins of reduction sequences, and
 -   reflexive-transitive closures.
 -
 -   This module provides the basic vocabulary used throughout the ARS development. A `Rel A` is a binary relation on
 -   `A`, a `StraightJoin` packages two reductions converging on a common reduct (the "valley" pattern in confluence
 -   proofs), and `Closure` is an inductive reflexive-transitive closure presented as a list-like sequence of
 -   single-step reductions. The `Closure` namespace also provides the standard combinators — concatenation, functorial
 -   lifting along relation morphisms, monadic flattening of nested closures, and case analysis — that let later modules
 -   build confluence and termination arguments compositionally.
 -}

\import Data.Or

{- | Record witnessing that two elements `a, b : A` reduce to a `common-reduct` under `rel`, with fields
 -   `a~>cr : rel a common-reduct` and `b~>cr : rel b common-reduct`. Encodes the "valley" shape used in confluence
 -   properties.
 -}
\record StraightJoin {A : \Type} (a b : A) (rel : A -> A -> \Type)
  | common-reduct : A
  | a~>cr : rel a common-reduct
  | b~>cr : rel b common-reduct

-- | Inductive reflexive-transitive closure of a relation `R`, with constructors:
\data Closure {A : \Type} (R : A -> A -> \Type) (a b : A)
  -- | reflexivity from a path `a = b`.
  | c-trivial (a = b)
  -- | a single `R`-step.
  | c-basic (a `R` b)
  -- | prepending an `R`-step to an existing closure (cons-like).
  | c-connect (c : A) (a `R` c) (Closure R c b)
  \where {
    -- | Concatenation of two closures `Closure R a b -> Closure R b c -> Closure R a c`, establishing transitivity.
    \func compose {A : \Type} {R : A -> A -> \Type} {a b c : A} (a~>b : Closure R a b) (b~>c : Closure R b c) : Closure R a c \elim a~>b, b~>c
      | c-basic r, rx => c-connect b r rx
      | c-connect c1 r a~>b, rx => c-connect c1 r (compose a~>b rx)
      | c-trivial idp, b~>c => b~>c

    {- | Functoriality: given `map : A -> B` and a relation morphism `rel-map`, transports a `Closure rel x y` to
     -   `Closure rel' (map x) (map y)`.
     -}
    \func lift {A B : \Type} {rel : A -> A -> \Type} {rel' : B -> B -> \Type} (map : A -> B)
               (rel-map : \Pi {a b : A} (rel a b) -> rel' (map a) (map b))
               (x y : A)
               (closure : Closure rel x y) : Closure rel' (map x) (map y) \elim closure
      | c-basic r => c-basic (rel-map r)
      | c-connect c r closure => c-connect (map c) (rel-map r) (lift map rel-map c y closure)
      | c-trivial idp => c-trivial idp

    {- | Monadic join: collapses `Closure (Closure rel) x y` to `Closure rel x y`, used to merge nested closures into a
     -   single sequence.
     -}
    \func flatten {A : \Type} {rel : A -> A -> \Type}
                  {x y : A}
                  (closure : Closure (Closure rel) x y) : Closure rel x y \elim closure
      | c-basic r => r
      | c-connect c r closure => compose r (flatten closure)
      | c-trivial idp => c-trivial idp

    {- | Case analysis on a closure, returning either a proof that `x = y` (trivial case) or a witness `(z, rel x z)` of
     -   an initial step. Useful for inducting on whether reduction has occurred.
     -}
    \func extract
      {A : \Type} {rel : A -> A -> \Type}
      {x y : A}
      (closure : Closure rel x y)
      : Or (x = y) (\Sigma (z : A) (rel x z)) \elim closure
      | c-trivial p => inl p
      | c-basic r => inr (y, r)
      | c-connect c r closure => inr (c, r)
  }
