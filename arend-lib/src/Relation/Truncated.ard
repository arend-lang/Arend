{- | Propositionally truncated relations and their standard closures.
 -
 -   This module defines `Rel A` as a `\Prop`-valued binary relation on a set, then provides the four classical closure
 -   operations as inductive datatypes that automatically live in `\Prop`. Each closure is generated by minimal
 -   constructors capturing the defining clauses (direct relation, reflexivity, transitivity step, symmetry), so proofs
 -   by induction reduce to handling these cases. The transitive-reflexive closure additionally exposes convenience
 -   constructors for unary and reflexive use.
 -}

-- | `Rel A` is `A -> A -> \Prop`, the type of propositional binary relations on a set.
\func Rel (A : \Set) : \Set => A -> A -> \Prop

\truncated \data TransClosure {A : \Set} (R : Rel A) (a b : A) : \Prop
  -- | Embed a direct relation `a R b`.
  | tc-direct (a `R` b)
  -- | Extend by a step: from `a R c` and `transitive-closure R c b` build `transitive-closure R a b`.
  | tc-connect {c : A} (TransClosure R a c) (R c b)

-- | Inductive `\Prop` defining the reflexive-transitive closure of `R`.
\truncated \data transitive-refl-closure {A : \Set} (R : Rel A) (a b : A) : \Prop
  -- | Reflexivity from a path `a = b`.
  | trc-direct (a = b)
  -- | Prepend a relation step `a R c` to a closure `c ~>* b`.
  | trc-connect (c : A) (a `R` c) (transitive-refl-closure R c b)

-- | Lifts a single `a R b` into the closure via `trc-connect b p (trc-direct idp)`.
\cons trc-unary {A : \Set} {R : Rel A} {a b : A} (p : a `R` b) : transitive-refl-closure R a b => trc-connect b p (trc-direct idp)

-- | Pure reflexivity `transitive-refl-closure R a a` from `idp`.
\cons trc-direct' {A : \Set} {R : Rel A} {a : A} : transitive-refl-closure R a a => trc-direct idp

-- | Inductive `\Prop` for the symmetric closure.
\truncated \data symmetric-closure {A : \Set} (R : Rel A) (a b : A) : \Prop
  -- | Witness from `a R b`.
  | sc-left (a `R` b)
  -- | Witness from `b R a`.
  | sc-right (b `R` a)

-- | Inductive `\Prop` for the reflexive closure.
\truncated \data reflexive-closure {A : \Set} (R : Rel A) (a b : A) : \Prop
  -- | Reflexivity from `a = b`.
  | rc-id (a = b)
  -- | Embed a direct relation `a R b`.
  | rc-rel (a `R` b)
