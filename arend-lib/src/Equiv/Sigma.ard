\import Equiv
\import Equiv.Fiber
\import Equiv.HalfAdjoint
\import Function.Meta
\import Logic.Unique
\import Homotopy.Fibration
\import Logic
\import Meta
\import Paths
\import Paths.Meta

\func unit-isContr : Contr (\Sigma) \cowith
  | center => ()
  | contraction _ => idp

\func lsigma {A : \Cat} (a0 : A) : Contr (\Sigma (x : A) (a0 = x)) \cowith
  | center => (a0,idp)
  | contraction p => Jl (\lam x q => (a0,idp) = {\Sigma (y : A) (a0 = y)} (x,q)) idp p.2

\func rsigma {A : \Cat} (a0 : A) : Contr (\Sigma (x : A) (x = a0)) \cowith
  | center => (a0,idp)
  | contraction p => Jl (\lam x q => (a0,idp) = {\Sigma (y : A) (y = a0)} (x, inv q)) idp (inv p.2) *> path (\lam i => (p.1, inv_inv i))

\func contr-left {A : \Cat} (c : Contr A) {B : A -> \Cat} : QEquiv {\Sigma (x : A) (B x)} {B c.center} \cowith
  | f p => transport B (inv (c.contraction p.1)) p.2
  | ret b => (c.center, b)
  | ret_f p => inv (ext (inv (c.contraction p.1), idp))
  | f_sec b => rewriteI (isProp.=>isSet (isContr=>isProp c) c.center c.center idp (c.contraction c.center)) idp

-- | If the total space of a family is contractible, then a fiber is equivalent to the type of paths from the center.
\func contr-sigma-fiber {A : \Cat} {B : A -> \Cat} (c : Contr (\Sigma (x : A) (B x))) (a : A) : QEquiv {B a} {c.center.1 = a}
  => symQEquiv (contr-left (rsigma a) {\lam w => B w.1}) `transQEquiv` later (\new QEquiv {
    | f u => ((u.1.1, u.2), u.1.2)
    | ret u => ((u.1.1, u.2), u.1.2)
    | ret_f => idpe
    | f_sec => idpe
  }) `transQEquiv` contr-left c {\lam w => w.1 = a}

-- | A relation that is functional in both directions is the graph of an equivalence.
\lemma contr-relation-equiv {X Y : \Cat} (R : X -> Y -> \Cat)
  (cx : \Pi (x : X) -> Contr (\Sigma (y : Y) (R x y))) (cy : \Pi (y : Y) -> Contr (\Sigma (x : X) (R x y)))
  : IsEquiv (\lam x => (cx x).center.1)
  => contrFibers=>IsEquiv \lam y => Contr.Contr_QEquiv (sigma-right \lam x => contr-sigma-fiber (cx x) y) (cy y)

\func contr-right {A : \Cat} (C : A -> Contr) : QEquiv {\Sigma (x : A) (C x)} {A} \cowith
  | f p => p.1
  | ret a => (a, Contr.center {C a})
  | ret_f p => path (\lam i => (p.1, Contr.contraction {C p.1} p.2 @ i))
  | f_sec a => idp

\func pi-contr-left {A : \Cat} (a : A) (B : \Pi (a' : A) -> a = a' -> \Cat) : QEquiv {\Pi (a' : A) (p : a = a') -> B a' p} {B a idp} \cowith
  | f h => h a idp
  | ret b a' => Jl B b
  | ret_f h => path (\lam i a' p => Jl (\lam x q => Jl B (h a idp) q = h x q) idp p @ i)
  | f_sec => idpe

\func pi-contr-right {A : \Cat} (a' : A) (B : \Pi (a : A) -> a = a' -> \Cat) : QEquiv {\Pi (a : A) (p : a = a') -> B a p} {B a' idp} \cowith
  | f h => h a' idp
  | ret b a => Jl.Jr B b
  | ret_f h => path (\lam i a p => Jl.Jr (\lam x q => Jl.Jr B (h a' idp) q = h x q) idp p @ i)
  | f_sec => idpe

\func sigma-left {A A' : \Cat} {B' : A' -> \Cat} (e : HAEquiv {A} {A'}) : QEquiv {\Sigma (a : A) (B' (e a))} {\Sigma (a' : A') (B' a')} \cowith
  | f p => (e p.1, p.2)
  | ret p => (e.ret p.1, transport B' (inv (e.f_sec p.1)) p.2)
  | ret_f p => ext (e.ret_f p.1, path (\lam i => coe (\lam j => B' (e.f_ret_f=f_sec_f p.1 i j) ) _ right) *> transport_id_inv B' _ _)
  | f_sec p => ext (e.f_sec p.1, transport_id_inv B' _ _)
  \where {
    \func path-func.{u} {A A' : \Cat u} {B' : A' -> \Cat u} (p : A = A') : (\Sigma (x : A) (B' (coe (p @) x right))) = (\Sigma (x' : A') (B' x'))
      => path \lam i => \Sigma (x : p i) (B' (coe2 p i x right))
  }

\sfunc qsigma-left {A A' : \Cat} {B' : A' -> \Cat} (e : QEquiv {A} {A'})
  : QEquiv {\Sigma (a : A) (B' (e a))} {\Sigma (a' : A') (B' a')} (\lam p => (e p.1, p.2))
  => sigma-left e

\func sigma-right {A : \Cat} {B B' : A -> \Cat} (q : \Pi (a : A) -> QEquiv {B a} {B' a})
  : QEquiv {\Sigma (a : A) (B a)} {\Sigma (a : A) (B' a)} \cowith
  | f p => (p.1, q p.1 p.2)
  | ret p' => (p'.1, (q p'.1).ret p'.2)
  | ret_f p => path (\lam i => (p.1, (q p.1).ret_f p.2 i))
  | f_sec p' => path (\lam i => (p'.1, (q p'.1).f_sec p'.2 i))

\func IsSigma-right {A : \Cat} {B B' : A -> \Cat} (f : \Pi (a : A) -> B a -> B' a) (q : \Pi (a : A) -> IsEquiv (f a))
  : IsEquiv {\Sigma (a : A) (B a)} {\Sigma (a : A) (B' a)} (\lam s => (s.1, f s.1 s.2))
  => inP $ sigma-right \lam a => IsEquiv.toQEquiv (q a)

\func sigma-equiv {A A' : \Cat} {B : A -> \Cat} {B' : A' -> \Cat} (e1 : QEquiv {A} {A'}) (e2 : \Pi (a : A) -> QEquiv {B a} {B' (e1 a)})
  : QEquiv {\Sigma (a : A) (B a)} {\Sigma (a : A') (B' a)}
  => sigma-right e2 `transQEquiv` sigma-left e1

\func unit-func (A : \Cat) : QEquiv {\Sigma -> A} {A} \cowith
  | f g => g ()
  | ret a _ => a
  | ret_f g => idp
  | f_sec a => idp

-- | The HoTT book, Theorem 4.7.7
\lemma totalEquiv {J : \Cat} {A B : J -> \Cat} (f : \Pi (j : J) -> A j -> B j)
  : (\Pi (j : J) -> IsEquiv (f j)) = IsEquiv (total f)
  => propExt (\lam e => contrFibers=>IsEquiv \lam p => Contr.Contr_QEquiv (symQEquiv (totalFiber f p.1 p.2)) (IsEquiv=>contrFibers (e p.1) p.2))
             (\lam e j => contrFibers=>IsEquiv \lam b => Contr.Contr_QEquiv (totalFiber f j b) (IsEquiv=>contrFibers e (j,b)))
  \where {
    \func total {J : \Cat} {A B : J -> \Cat} (f : \Pi (j : J) -> A j -> B j) (p : \Sigma (j : J) (A j)) : \Sigma (j : J) (B j)
      => (p.1, f p.1 p.2)

    -- | Theorem 4.7.6
    \func totalFiber {J : \Cat} {A B : J -> \Cat} (f : \Pi (j : J) -> A j -> B j) (j : J) (b : B j)
      : QEquiv {Fib (total f) ((j,b) : \Sigma (j : J) (B j))} {Fib (f j) b}
      => transQEquiv
          (sigma-right \lam p => sigmaEquiv B (total f p) (j,b))
          (transQEquiv {_} {\Sigma (p : \Sigma (j' : J) (j' = j)) (\Sigma (a : A p.1) (transport B p.2 (f p.1 a) = b))}
            (later \new QEquiv {
              | f t => ((t.1.1, t.2.1), (t.1.2, t.2.2))
              | ret t => ((t.1.1, t.2.1), (t.1.2, t.2.2))
              | ret_f => idpe
              | f_sec => idpe
            })
            (contr-left (rsigma j)))
  }

-- | A map of total spaces over an equivalence of bases is an equivalence if and only if it is a fiberwise equivalence.
\lemma fiberwiseEquiv {X Y : \Cat} {g : X -> Y} (ge : IsEquiv g) {P : X -> \Cat} {Q : Y -> \Cat} (h : \Pi (x : X) -> P x -> Q (g x))
                      (te : IsEquiv {\Sigma (x : X) (P x)} {\Sigma (y : Y) (Q y)} (\lam s => (g s.1, h s.1 s.2))) (x : X) : IsEquiv (h x)
  => propExt.conv (totalEquiv h) (IsEquiv.leftFactor (inP (qsigma-left (IsEquiv.toQEquiv ge))) te) x

-- | An equivalence that preserves and reflects a family of propositions restricts to an equivalence of the subtypes.
\lemma subtype-equiv {X Y : \Cat} {g : X -> Y} (ge : IsEquiv g) {P : X -> \Prop} {Q : Y -> \Prop}
                     (h : \Pi {x : X} -> P x -> Q (g x)) (r : \Pi {x : X} -> Q (g x) -> P x)
  : IsEquiv {\Sigma (x : X) (P x)} {\Sigma (y : Y) (Q y)} (\lam s => (g s.1, h s.2))
  => inP $ sigma-equiv (IsEquiv.toQEquiv ge) \lam x => \new QEquiv {
    | f => h
    | ret => r
    | ret_f _ => prop-pi
    | f_sec _ => prop-pi
  }

-- | A map applied to both components of a pair is an equivalence if the map is.
\lemma pair-equiv {X Y : \Cat} {g : X -> Y} (e : IsEquiv g) : IsEquiv {\Sigma X X} {\Sigma Y Y} (\lam j => (g j.1, g j.2))
  => inP $ sigma-equiv (IsEquiv.toQEquiv e) \lam _ => IsEquiv.toQEquiv e

-- | Pairs with propositional second components are equal if their first components are.
\func sigma-prop-ext {A : \Cat} {B : A -> \Cat} (Bp : \Pi (a : A) -> isProp (B a)) {s s' : \Sigma (a : A) (B a)} (p : s.1 = s'.1) : s = s'
  => path \lam i => (p i, pathOver (Bp s'.1 _ _) i)