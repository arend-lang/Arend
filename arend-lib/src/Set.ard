\import Data.Bool (Bool, So, false, not, true)
\import Equiv
\import Function.Meta
\import Logic
\import Logic.Meta
\import Logic.Unique
\import Meta
\import Paths
\import Paths.Meta

\data Dec (E : \Prop)
  | yes E
  | no (Not E)
  \where {
    \use \level levelProp {E : \Prop} : isProp (Dec E)
      => isProp-prover

    \func rec {R : \Type} {E : \Prop} (y : E -> R) (n : Not E -> R) (d : Dec E) : R \elim d
      | yes e => y e
      | no q => n q
  }

\lemma dec-separated {E : \Prop} (d : Dec E) (q : Not (Not E)) : E \elim d
  | yes e => e
  | no p => absurd (q p)

\lemma negated-dec (E : \Prop) {P : NegatedProp} (f : Dec E -> P) : P
  => isNegated \lam g => g $ f $ no \lam e => g $ f (yes e)

\func decToBool {E : \Prop} (d : Dec E) : Bool
  | yes _ => true
  | no _ => false

\class Decide (E : \Prop)
  | decide : Dec E

\lemma dec_decide {E : \Prop} (d : Dec E) : Decide E \cowith
  | decide => d

\lemma dec_yes_reduce {E : \Prop} {d : Dec E} (e : E) : d = yes e
  => prop-pi

\lemma dec_no_reduce {E : \Prop} {d : Dec E} (q : Not E) : d = no q
  => prop-pi

\lemma Dec_|| {A B : \Prop} (d : Dec A) (e : Dec B) : Dec (A || B) \elim d, e
  | yes e, _ => yes (byLeft e)
  | _, yes e => yes (byRight e)
  | no q, no q' => no \case __ \with {
    | byLeft a => q a
    | byRight b => q' b
  }

\func SigmaDecide {A : Decide} (B : A -> Decide) : Decide (\Sigma (a : A) (B a)) \cowith
  | decide => \case A.decide \with {
    | yes a => \case decide {B a} \with {
      | yes b => yes (a,b)
      | no q => no \lam p => q $ transport (B __) prop-pi p.2
    }
    | no q => no \lam p => q p.1
  }

\instance ProductDecide (A B : Decide) : Decide => SigmaDecide {A} (\lam _ => B)

\lemma NotDec {P : \Prop} (d : Dec P) : Dec (Not P) \elim d
  | yes a => no \lam f => f a
  | no q => yes q

\instance NotDecide (A : Decide) : Decide (Not A)
  | decide => NotDec A.decide

\class BaseSet (E : \Set)

\class SeparatedSet \extends BaseSet
  | separatedEq {x y : E} : Not (Not (x = y)) -> x = y

-- | A set with a tight apartness relation.
\class Set# \extends SeparatedSet {
  | \infix 4 # : E -> E -> \Prop
  | #-irreflexive {x : E} : Not (x # x)
  | #-symmetric {x y : E} : x # y -> y # x
  | #-comparison (x y z : E) : x # z -> x # y || y # z
  | tightness {x y : E} : Not (x # y) -> x = y
  | separatedEq {x} ~~x=y => tightness (\lam x#y => ~~x=y (\lam x=y => #-irreflexive (transport (x #) (inv x=y) x#y)))

  \lemma apartNotEqual {x y : E} (x#y : x # y) : x /= y =>
    \lam x=y => #-irreflexive (transport (x #) (inv x=y) x#y)
}

\class DecSet \extends BaseSet, Set# {
  \field decideEq (x y : E) : Dec (x = y)
  | nonEqualApart {x y : E} : x /= y -> x # y
  | \infix 4 == : E -> E -> Bool
  | == x y => decToBool (decideEq x y)

  \default # x y : \Prop => x /= y
  \default nonEqualApart \as nonEqualApartImpl {x} {y} (p : x /= y) : x # y => p
  \default #-irreflexive {x} (x/=x : x # x) : Empty => x/=x idp
  \default #-symmetric {x} {y} (x/=y : x # y) : y # x => /=-sym x/=y
  \default #-comparison x y z (x/=z : x # z) : x # y || y # z => \case decideEq x y \with {
    | yes x=y => byRight (\lam y=z => x/=z (x=y *> y=z))
    | no x/=y => byLeft x/=y
  }
  \default tightness {x} {y} (x//=y : Not (x # y)) : x = y => \case decideEq x y \with {
    | yes x=y => x=y
    | no x/=y => absurd (x//=y x/=y)
  }
}

\func SigmaDecSet {A : DecSet} (B : A -> DecSet) : DecSet (\Sigma (a : A) (B a)) \cowith
  | decideEq p q => \case decideEq p.1 q.1 \with {
    | yes e => \case decideEq (transport (\lam a => B a) e p.2) q.2 \with {
      | yes e' => yes (ext (e,e'))
      | no n => no (\lam e' => n (rewrite (prop-isProp e (pmap __.1 e')) (pmapd __.2 e')))
    }
    | no n => no (\lam e => n (pmap __.1 e))
  }

\func SubDecSet {A : DecSet} {B : A -> \Prop} : DecSet (\Sigma (a : A) (B a))
  => SigmaDecSet \lam a => \new DecSet (B a) {
    | decideEq b b' => yes prop-pi
  }

\instance DecBool : DecSet
  | E => Bool
  | decideEq x y => compare x y
  \where {
    \func compare (a b : Bool) : Dec (a = b)
      | false, false => yes idp
      | false, true => no contradiction
      | true, false => no contradiction
      | true, true => yes idp
  }

\instance ProductDecSet (A B : DecSet) : DecSet (\Sigma A B)
  => SigmaDecSet (\lam _ => B)

\instance EqualityDecide (A : DecSet) (a a' : A) : Decide (a = a')
  | decide => decideEq a a'

\instance ArrayDec (A : DecSet) (n : Nat) : DecSet (Array A n)
  | decideEq => aux
  \where {
    \private \func aux {n : Nat} (l l' : Array A n) : Dec (l = l') \elim n, l, l'
      | 0, nil, nil => yes idp
      | suc n, a :: l, a' :: l' => \case decideEq a a', aux l l' \with {
        | yes e, yes e' => yes $ pmap2 (::) e e'
        | _, no q => no \lam p => q \lam i => \new Array A n \lam j => p i (suc j)
        | no q, _ => no \lam p => q \lam i => p i 0
      }
  }

\lemma decideEq=_reduce {A : DecSet} {x y : A} (p : x = y) : decideEq x y = yes p
  => prop-pi

\lemma decideEq/=_reduce {A : DecSet} {x y : A} (p : x /= y) : decideEq x y = no p
  => prop-pi

\lemma ==_= {A : DecSet} {a a' : A} (so : So (a == a')) : a = a'
  => unfold (==) at so $ mcases {decToBool} so _ \with {
    | yes p, _ => p
    | no n, ()
  }

\lemma =-dec {A : DecSet} {a a' : A} {so : So (a == a')} : a = a'
  => ==_= so

\lemma /=-dec {A : DecSet} {a a' : A} {so : So (not (a == a'))} : a /= a'
  => unfold (==) at so $ mcases {decToBool} so _ \with {
    | yes _, ()
    | no p, _ => p
  }

\truncated \data Trunc0 (A : \Type) : \Set
  | in0 A
  \where {
    \sfunc remove {A : \Type} (p : isSet A) (t : Trunc0 A) : A \level p \elim t
      | in0 a => a

    \func remove' {A : \Set} (t : Trunc0 A) : A \elim t
      | in0 a => a

    \sfunc rec {A B : \Type} (p : isSet B) (t : Trunc0 A) (f : A -> B) : B \level p \elim t
      | in0 a => f a

    \lemma rec-eval {A B : \Type} {p : isSet B} {a : A} {f : A -> B} : rec p (in0 a) f = f a \level p _ _
      => \peval rec p (in0 a) f

    \func map {A B : \Type} (t : Trunc0 A) (f : A -> B) : Trunc0 B \elim t
      | in0 a => in0 (f a)

    \lemma map-id {A : \Type} (t : Trunc0 A) : map t (\lam a => a) = t \elim t
      | in0 a => idp

    \lemma map-comp {A B C : \Type} (t : Trunc0 A) (f : A -> B) (g : B -> C) : map (map t f) g = map t (\lam a => g (f a)) \elim t
      | in0 a => idp

    \lemma map-isEquiv {A B : \Type} {g : A -> B} (e : IsEquiv g) : IsEquiv (\lam (t : Trunc0 A) => map t g) \elim e
      | inP e => inP (mapEquiv e)

    \lemma contr {A : \Type} (c : Contr A) : Contr (Trunc0 A)
      => Contr.make (in0 c.center) (contr-center c)
      \where
        \lemma contr-center {A : \Type} (c : Contr A) (t : Trunc0 A) : in0 c.center = t \elim t
          | in0 a => pmap in0 (c.contraction a)

    \func mapEquiv {A B : \Type} (e : QEquiv {A} {B}) : QEquiv {Trunc0 A} {Trunc0 B} \cowith
      | f t => map t e
      | ret t => map t e.ret
      | ret_f (t : Trunc0 A) : map (map t e) e.ret = t \with {
        | in0 a => pmap in0 (e.ret_f a)
      }
      | f_sec (t : Trunc0 B) : map (map t e.ret) e = t \with {
        | in0 b => pmap in0 (e.f_sec b)
      }

    \lemma equality {A : \Type} (x y : A) : (in0 x = {Trunc0 A} in0 y) = TruncP (x = y)
      => propExt (encode (in0 x) (in0 y)) (\lam c => \case c \with { | inP p => pmap in0 p })
      \where {
        \func code {A : \Type} (t t' : Trunc0 A) : \Prop \elim t, t'
          | in0 x, in0 y => TruncP (x = y)

        \lemma refl {A : \Type} (t : Trunc0 A) : code t t \elim t
          | in0 x => inP idp

        \lemma encode {A : \Type} (t t' : Trunc0 A) (p : t = t') : code t t'
          => transport (code t) p (refl t)
      }

    \func setEquiv {A : \Set} : QEquiv {Trunc0 A} {A} \cowith
      | f => remove'
      | ret => in0
      | ret_f (t : Trunc0 A) : in0 (remove' t) = t \with {
        | in0 a => idp
      }
      | f_sec _ => idp

    \lemma in0-isEquiv {A : \Type} (p : isSet A) : IsEquiv (in0 {A})
      => inP \new QEquiv {
        | ret => remove p
        | ret_f a => \peval remove p (in0 a)
        | f_sec => in0-remove p
      }
      \where
        \lemma in0-remove {A : \Type} (p : isSet A) (t : Trunc0 A) : in0 (remove p t) = t \elim t
          | in0 a => pmap in0 (\peval remove p (in0 a))

    \func productEquiv {A B : \Type} : QEquiv {Trunc0 (\Sigma A B)} {\Sigma (Trunc0 A) (Trunc0 B)} \cowith
      | f t => (map t (\lam p => p.1), map t (\lam p => p.2))
      | ret p => pair p.1 p.2
      | ret_f (t : Trunc0 (\Sigma A B)) : pair (map t (\lam p => p.1)) (map t (\lam p => p.2)) = t \with {
        | in0 p => idp
      }
      | f_sec p => pair-proj p.1 p.2
      \where {
        \func pair {A B : \Type} (x : Trunc0 A) (y : Trunc0 B) : Trunc0 (\Sigma A B) \elim x, y
          | in0 a, in0 b => in0 (a,b)

        \lemma pair-proj {A B : \Type} (x : Trunc0 A) (y : Trunc0 B)
          : ((map (pair x y) (\lam p => p.1), map (pair x y) (\lam p => p.2)) : \Sigma (Trunc0 A) (Trunc0 B)) = (x,y) \elim x, y
          | in0 a, in0 b => idp
      }

    \lemma unequiv {A : \Type} {a b : A} (p : in0 a = in0 b) : TruncP (a = b)
      => \let code (y : Trunc0 A) : \Prop => \case \elim y \with {
                | in0 b => TruncP (a = b)
              }
         \in transport code p (inP idp)

    \lemma transport_Trunc0 {A : \Cat} {B : A -> \Type} {a a' : A} (p : a = a') {b : B a}
      : transport (\lam x => Trunc0 (B x)) p (in0 b) = in0 (transport B p b) \elim p
      | idp => idp
  }
