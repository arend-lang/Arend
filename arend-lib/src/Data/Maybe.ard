{- | The optional/partial value type `Maybe A`, representing `A` extended with a distinguished "no value" element.
 -
 -   This module defines the standard `Maybe` (option) datatype with constructors `nothing` and `just`, together with
 -   its basic eliminator `maybe` and a few utility functions. The design follows the usual functional-programming
 -   pattern: `Maybe` is a sum type used to model partiality, and `maybe` is its non-dependent recursor. A small
 -   `just-injective` lemma is provided to recover equality of contents from equality of `just` constructors via the
 -   standard "extract or default" trick using `unjust`.
 -}

\import Paths

{- | The optional type `Maybe (A : \Type)` with constructors `nothing` (absent value) and `just : A -> Maybe A` (present
 -   value).
 -}
\data Maybe (A : \Type) | nothing | just A
  \where {
    {- | Functorial action on `Maybe`: given `f : A -> B`, produces `Maybe A -> Maybe B` by mapping `just a` to
     -   `just (f a)` and preserving `nothing`.
     -}
    \func map {A B : \Type} (f : A -> B) (m : Maybe A) : Maybe B \elim m
      | nothing => nothing
      | just a => just (f a)
  }

{- | Non-dependent eliminator for `Maybe`: `maybe (b : B) (f : A -> B) (m : Maybe A) : B`, returning `b` on `nothing`
 -   and `f a` on `just a`. The standard case-analysis combinator.
 -}
\func maybe {A B : \Type} (b : B) (f : A -> B) (m : Maybe A) : B \elim m
  | nothing => b
  | just a => f a

{- | Extracts the contained value, falling back to a default: `unjust (a : A) (m : Maybe A) : A` returns `a` on
 -   `nothing` and the wrapped element on `just`.
 -}
\func unjust {A : \Type} (a : A) (maybe : Maybe A) : A \elim maybe
  | nothing => a
  | just a1 => a1

-- | Constructor injectivity for `just`: from `just a = just b` derives `a = b`, proved by `pmap (unjust a)`.
\func just-injective {A : \Type} {a b : A} (eq : just a = just b) : a = b => pmap (unjust a) eq
