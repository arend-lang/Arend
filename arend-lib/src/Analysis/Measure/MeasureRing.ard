\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Pointed
\import Arith.Real.Field
\import Data.Array
\import Data.Fin
\import Algebra.Ordered
\import Algebra.Ring.Boolean
\import Algebra.Ring.RingHom
\import Arith.Rat
\import Arith.Real
\import Arith.Real.UpperReal
\import Function.Meta
\import Logic
\import Logic.Meta
\import Data.Or
\import Meta
\import Order.Biordered
\import Order.Lattice
\import Order.LinearOrder
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Topology.MetricSpace
\import Topology.MetricSpace.ManhattanProduct
\import Topology.NormedAbGroup
\import Topology.TopSpace
\open BooleanRing

\class PseudoMeasureRing \extends BooleanRing, PseudoNormedAbGroup {
  | meas : E -> Real
  | meas_zro : meas 0 = 0
  | meas>=0 {x : E} : 0 RealAbGroup.<= meas x
  | meas-disjoint {x y : E} : x * y = 0 -> meas (x ∨ y) = meas x RealAbGroup.+ meas y

  | meas-mono {x y : E} : x <= y -> meas x RealAbGroup.<= meas y
  | meas-mono p => transport2 (RealAbGroup.<=) RealAbGroup.zro-left (inv (meas-disjoint (rdistr *> pmap (_ +) (*-assoc *> pmap (_ *) isBooleanRing) *> double=0)) *> pmap meas (inv (split_<= p))) (<=_+ meas>=0 RealAbGroup.<=-refl)
  | meas_+ {x y : E} : meas (x + y) RealAbGroup.<= meas x RealAbGroup.+ meas y
  | meas_+ => transportInv (RealAbGroup.<= _) (pmap meas +_diff *> meas-disjoint diff_*_diff) $ <=_+ (meas-mono diff_<=) (meas-mono diff_<=)
  | norm => meas
  | norm_zro => meas_zro
  | norm_negative => pmap meas negative=id
  | norm_+ => transport (_ ExUpperReal.<=) RealAbGroup.+-upper (Real.<=-upper.1 meas_+)

  -- | Multiplication is 1-Lipschitz with respect to the sum metric on the product.
  \lemma *-metric : MetricMap (ManhattanProductPseudoMetricSpace \this \this) \this (\lam s => s.1 * s.2) \cowith
    | func-dist {s} {t} => transport2 (ExUpperReal.<=) (inv norm-dist) (RealAbGroup.+-upper *> inv (pmap2 (ExUpperReal.+) norm-dist norm-dist)) $ Real.<=-upper.1 $
        transportInv (meas __ RealAbGroup.<= _) (equation.bRing : s.1 * s.2 - t.1 * t.2 = (s.1 - t.1) * s.2 + t.1 * (s.2 - t.2)) $
          meas_+ RealAbGroup.<=∘ RealAbGroup.<=_+ (meas-mono meet-left) (meas-mono meet-right)

  -- | The measure of a sum of pairwise disjoint elements is the sum of their measures.
  \lemma meas_BigSum-disjoint {l : Array E} (d : \Pi {i j : Fin l.len} -> i /= j -> l i * l j = 0)
    : meas (BigSum l) = RealAbGroup.BigSum (map meas l) \elim l
    | nil => meas_zro
    | x :: l => \have q : x * BigSum l = 0 => BigSum-ldistr *> BigSum_zro (\lam j => d (/=-sym fsuc/=0))
                \in pmap meas (inv $ pmap (_ +) q *> zro-right) *> meas-disjoint q *> pmap (_ RealAbGroup.+) (meas_BigSum-disjoint \lam {i} {j} i/=j => d {suc i} \lam p => i/=j (unfsuc p))

  -- | A measure ring is discrete if the measure of every element is either zero or positive.
  \type IsDiscreteMeasure : \Prop
    => \Pi (a : E) -> (meas a = RealAbGroup.zro) || (RealAbGroup.zro RealAbGroup.< meas a)

  -- | A measure ring has rational values if the measure of every element is a rational number.
  \type IsRationalMeasure : \Prop
    => ∀ a ∃ (q : Rat) (meas a = Real.fromRat q)

  \lemma rational-discrete (r : IsRationalMeasure) : IsDiscreteMeasure
    => \lam a => \case r a \with {
      | inP (q,p) => \case LinearOrder.dec<_<= (0 : Rat) q \with {
        | inl q>0 => byRight $ transportInv (0 RealAbGroup.<) p (rat_real_<.1 q>0)
        | inr q<=0 => byLeft $ p *> pmap Real.fromRat (RatField.<=-antisymmetric q<=0 $ rat_real_<=.2 $ transport (0 RealAbGroup.<=) p meas>=0)
      }
    }
}

\lemma meas-modular {X : PseudoMeasureRing} {x y : X} : meas x + meas y = meas (x ∨ y) + meas (x ∧ y)
  => pmap (_ +) (pmap meas (later $ split *> pmap (_ ∨) *-comm) *> meas-disjoint (inv *-assoc *> pmap (* y) diff_* *> X.zro_*-left)) *> inv +-assoc *> inv (pmap (+ _) $ pmap meas (<=-antisymmetric (join-univ join-left $ transportInv (<= _) split $ join-univ join-right $ meet-right <=∘ join-left) $ join-univ join-left $ diff_<= <=∘ join-right) *> X.meas-disjoint (*-comm *> diff_*))

\record MeasureRingHom \extends PseudoRingHom, NormedIsometricMap {
  \override Dom : PseudoMeasureRing
  \override Cod : PseudoMeasureRing

  | func-meas {x : Dom} : meas (func x) = meas x
  | func-norm-isometry => func-meas

  -- | {y} can be approximated by elements of the image of {func}.
  \type IsApprox (y : Cod) : \Prop
    => ∀ {eps} (0 < eps) ∃ (x : Dom) (lnorm (y + func x) < eps)

  \lemma approx-dense (p : \Pi (y : Cod) -> IsApprox y) : IsDense
    => \lam {y} Uo Uy => \case dist_open.1 Uo Uy \with {
      | inP (eps,eps>0,q) => \case p y (rat_real_<.1 eps>0) \with {
        | inP (x,d) => inP (func x, inP (x, idp), q $ real_<_U.1 $ transportInv (`< _) (lnorm-ldist *> pmap meas (pmap (y +) BooleanRing.negative=id)) d)
      }
    }

  \lemma dense-approx (hd : IsDense) (y : Cod) : IsApprox y
    => \lam {d} (d>0 : 0 < d) =>
        \let (inP (delta,delta>0,delta<d)) => real_<-char.1 d>0
        \in \case hd {y} {OBall delta y} OBall-open (OBall-center (rat_real_<.2 delta>0)) \with {
          | inP (z, inP (x,p), q) => inP (x, transport (`< _) (lnorm-ldist *> pmap meas (pmap (y +) BooleanRing.negative=id)) (real_<_U.2 (transportInv (OBall delta y) p q)) <∘ delta<d)
        }

  \lemma approx-zro : IsApprox 0
    => \lam eps>0 => inP (0, transportInv (< _) (pmap meas (pmap (0 +) func-zro *> zro-left) *> meas_zro) eps>0)

  \lemma approx-+ {y y' : Cod} (p : IsApprox y) (p' : IsApprox y') : IsApprox (y + y')
    => \lam {eps} eps>0 => \case split-eps eps>0 {2} linarith \with {
      | inP (d,d>0,d2<eps) => \case p d>0, p' d>0 \with {
        | inP (x,q), inP (x',q') => inP (x + x', transportInv (< _) (pmap meas (pmap (_ +) func-+ *> equation.abMonoid)) $ meas_+ <∘r (linarith : meas (y + func x) + meas (y' + func x') < eps))
      }
    }

  \lemma approx-BigSum {l : Array Cod} (p : \Pi (j : Fin l.len) -> IsApprox (l j)) : IsApprox (AddMonoid.BigSum l) \elim l
    | nil => approx-zro
    | y :: l => approx-+ (p 0) (approx-BigSum \lam j => p (suc j))
} \where {
  \func id {B : PseudoMeasureRing} : MeasureRingHom B B \cowith
    | PseudoRingHom => PseudoRingHom.id
    | func-meas => idp

  \func \fixl 8 compose \alias \infixl 8 ∘ {A B C : PseudoMeasureRing} (g : MeasureRingHom B C) (f : MeasureRingHom A B) : MeasureRingHom A C \cowith
    | PseudoRingHom => g PseudoRingHom.∘ f
    | func-meas => func-meas *> func-meas

  \lemma dense-comp {A B C : PseudoMeasureRing} {f : MeasureRingHom A B} {g : MeasureRingHom B C} (fd : f.IsDense) (gd : g.IsDense) : (g MeasureRingHom.∘ f).IsDense
    => ContMap.dense-comp fd gd
}

\class MeasureRing \extends PseudoMeasureRing, NormedAbGroup
  | meas-ext {x : E} : meas x = RealAbGroup.zro -> x = 0
  | norm-ext p => meas-ext ((Real.=-upper {_} {RealAbGroup.zro}).2 p)

\class CompleteMeasureRing \extends MeasureRing, CompleteNormedAbGroup