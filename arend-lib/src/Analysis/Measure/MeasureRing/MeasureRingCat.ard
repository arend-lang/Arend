\import Algebra.Group
\import Algebra.Monoid
\import Analysis.Measure.MeasureRing
\import Category
\import Category.Meta
\import Arith.Real
\import Category.Subcat
\import Equiv
\import Function.Meta
\import Logic
\import Paths
\import Paths.Meta
\import Topology.CoverSpace
\import Topology.UniformSpace

\instance MeasureRingCat.{u} : Cat MeasureRing.{u}
  | Hom => MeasureRingHom
  | id => MeasureRingHom.id
  | o => MeasureRingHom.∘
  | id-left => idp
  | id-right => idp
  | o-assoc => idp
  | univalence => sip \lam {X} {S1} {S2} h1 h2 => exts MeasureRing {
    | zro => h1.func-zro
    | + x y => h1.func-+
    | negative x => AddGroup.negative-equality S1 S2 h1.func-zro h1.func-+ x
    | * x y => h1.func-*
    | meas x => inv h1.func-meas
    | dist x y => inv (Real.=-upper.2 h1.func-isometry)
    | isUniform C => ext (\lam Cu => uniform-subset (h2.func-uniform Cu) \lam (inP (V,CV,p)) => transportInv C p CV,
                          \lam Cu => uniform-subset (h1.func-uniform Cu) \lam (inP (V,CV,p)) => transportInv C p CV)
    | isCauchy C => ext (\lam Cc => cauchy-subset (h2.func-cover Cc) \lam (inP (V,CV,p)) => transportInv C p CV,
                         \lam Cc => cauchy-subset (h1.func-cover Cc) \lam (inP (V,CV,p)) => transportInv C p CV)
    | isOpen U => ext (h2.func-cont, h1.func-cont)
  }
  \where {
    \lemma Iso<->IsEquiv.{u} {A B : MeasureRing.{u}} {f : MeasureRingHom A B} : Iso {MeasureRingCat} f <-> IsEquiv f
      => (\lam e => inP \new QEquiv {
            | ret => e.hinv
            | ret_f x => pmap (\lam (g : MeasureRingHom A A) => g x) e.hinv_f
            | f_sec y => pmap (\lam (g : MeasureRingHom B B) => g y) e.f_hinv
          },
          \lam e => \new Iso {
            | hinv => inverse e
            | hinv_f => exts \lam x => IsEquiv.ret_f e
            | f_hinv => exts \lam y => IsEquiv.f_ret e
          })

    -- | The inverse of a bijective homomorphism of measure rings.
    \func inverse {A B : MeasureRing} {f : MeasureRingHom A B} (e : IsEquiv f) : MeasureRingHom B A \cowith
      | func => IsEquiv.ret e
      | func-+ => IsEquiv.isInj e $ IsEquiv.f_ret e *> inv (f.func-+ *> pmap2 (+) (IsEquiv.f_ret e) (IsEquiv.f_ret e))
      | func-* => IsEquiv.isInj e $ IsEquiv.f_ret e *> inv (f.func-* *> pmap2 (*) (IsEquiv.f_ret e) (IsEquiv.f_ret e))
      | func-meas => inv f.func-meas *> pmap meas (IsEquiv.f_ret e)
  }

\instance CompleteMeasureRingCat.{u} : Cat CompleteMeasureRing.{u}
  => subCat {MeasureRingCat} \new Embedding {
    | f X => X
    | isEmb X Y => \new Retraction {
      | sec p => ext CompleteMeasureRing { | MeasureRing => p }
      | f_sec => idpe
    }
  }
  \where {
    \lemma Iso<->IsEquiv.{u} {A B : CompleteMeasureRing.{u}} {f : MeasureRingHom A B} : Iso {CompleteMeasureRingCat.{u}} f <-> IsEquiv f
      => (\lam e => MeasureRingCat.Iso<->IsEquiv.1 (subCat-iso e), \lam e => subCat-iso.conv (MeasureRingCat.Iso<->IsEquiv.2 e))
  }
