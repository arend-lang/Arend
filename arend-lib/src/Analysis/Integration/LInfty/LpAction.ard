{- | `L∞` acts on `Lᵖ`.

  For `F ∈ L∞` bounded by `a` and `g ∈ L`, the product $F g \in \mathrm L^0$ is dominated by $a|g| \in L^+$, so it lies
  in `Lᵖ` (Lemma `lem:dominated`); since $j_p$ is injective and reflects the order, $\|F g\|_p \le a \|g\|_p$.
  This Lipschitz additive map extends from `L` to `Lᵖ`.

  * {lpToL0-abs}, {lpToL0-mono}, {lpToL0-reflects}: $j_p$ preserves `|·|`, is monotone and reflects the order;
    {lpToL0-dominated}: $|G| \le h$ implies $|j_p G| \le h$.
  * {linfInc}: the inclusion `L → L∞`.
  * {linfLpMul}: the product $\mathrm L^\infty \times \mathrm L^p \to \mathrm L^p$, additive in the second argument;
    {linfLpMul-char}: $j_p(F \cdot g) = F g$ for `g ∈ L`; {linfLpMul-norm}: $\|F G\|_p \le a \|G\|_p$ if $|F| \le a$;
    {linfLpMul-norm-upper}: $\|F G\|_p \le \|F\|_\infty \|G\|_p$; {linfLpMul-negative}: $(-F) G = -(F G)$; {linfLpMul-+}: $(F + F') G = F G + F' G$;
    {linfLpMul-dominated}: $j_p(F \cdot \kappa_h(U)) = F U$ for bounded `U ∈ L⁰` with $|U| \le h$;
    {linfLpMul-clip}: $F \cdot g = \kappa_{N|g|}(F g)$ for `g ∈ L`.
-}

\import Algebra.Group
\import Algebra.Group.GroupHom
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.Ordered.RieszSpace
\import Algebra.Ordered.TruncRieszSpace
\import Algebra.Pointed
\import Algebra.QModule
\import Algebra.Ring
\import Analysis.Integration.FullIntegrationSpace
\import Analysis.Integration.FunctionalCalculus.Inequalities
\import Analysis.Integration.L0
\import Analysis.Integration.L0Product
\import Analysis.Integration.LInfty
\import Analysis.Integration.Lp
\import Analysis.Integration.LpCharacterization
\import Analysis.Integration.LpEmbedding
\import Arith.Rat
\import Arith.Real
\import Arith.Real.Field
\import Arith.Real.UpperReal
\import Function.Meta
\import Logic
\import Logic.Unique
\import Order.Biordered
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Topology.BanachLattice
\import Topology.BanachLattice.Completion
\import Topology.CoverSpace.Complete
\import Topology.CoverSpace.Product
\import Topology.NormedAbGroup
\import Topology.NormedAbGroup.Real
\import Topology.NormedAbGroup.Real.Functions
\import Topology.TopAbGroup
\import Topology.TopAbGroup.Complete
\import Topology.TopAbGroup.Product
\import Topology.TopRieszSpace
\import Topology.TopRieszSpace.Completion
\import Topology.TopSpace
\import Topology.TopSpace.Product
\open LatticeAbGroup
\open QModule
\open PosetAddGroup
\open TruncRieszSpace

-- | $j_p$ preserves `|·|`.
\lemma lpToL0-abs {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} (G : LpSpace L p p>=1)
  : lpToL0 p p>=1 (abs G) = abs (lpToL0 p p>=1 G)
  => dense-lift-unique (lpInc p p>=1) lpInc.isDense (lpToL0 p p>=1 ContMap.∘ (LpSpace L p p>=1).abs-uniform) ((L0Space L).abs-uniform ContMap.∘ lpToL0 p p>=1)
      (\lam f => pmap (lpToL0 p p>=1) (inv (RieszSpaceHom.func-abs {lpInc p p>=1})) *> lpToL0.char *> l0-pt-abs *> pmap abs (inv lpToL0.char)) G

-- | $j_p$ reflects the order.
\lemma lpToL0-reflects {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {u v : LpSpace L p p>=1}
                       (uv : lpToL0 p p>=1 u <= lpToL0 p p>=1 v) : u <= v
  => \have | j => lpToL0 {L} p p>=1
           | e : abs (v - u) = v - u => lpToL0-inj $ lpToL0-abs (v - u) *> pmap abs j.func-minus *> abs-ofPos (to>=0 uv) *> inv j.func-minus
     \in from>=0 (transport (0 <=) e abs>=0)

-- | $j_p$ is monotone.
\lemma lpToL0-mono {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {u v : LpSpace L p p>=1} (uv : u <= v)
  : lpToL0 p p>=1 u <= lpToL0 p p>=1 v
  => \have j => lpToL0 {L} p p>=1
     \in from>=0 (transport (0 <=) (inv (lpToL0-abs (v - u)) *> pmap j (abs-ofPos (to>=0 uv)) *> j.func-minus) abs>=0)

-- | $|j_p G| \le h$ if $|G| \le h$ for `h ∈ L`.
\lemma lpToL0-dominated {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {G : LpSpace L p p>=1} {h : L} (Gh : abs G <= lpInc p p>=1 h)
  : abs (lpToL0 p p>=1 G) <= pointCF {L0PreSpace L} h
  => =_<= (inv (lpToL0-abs G)) <=∘ lpToL0-mono Gh <=∘ =_<= lpToL0.char

-- | The inclusion `L → L∞`.
\func linfInc {L : FullIntegrationSpace} (g : L) : LInftyElem L
  => \new LInftyElem L (pointCF {L0PreSpace L} g) ((topTruncCompletion {L0PreSpace L}).func-IsBounded (L.trunc-bounded g))

-- | The product $\mathrm L^\infty \times \mathrm L^p \to \mathrm L^p$ (Proposition `prop:Linfty`(3)).
\func linfLpMul {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} (F : LInftyElem L) : TopAbGroupMap (LpSpace L p p>=1) (LpSpace L p p>=1)
  => dense-topAb-lift (lpInc p p>=1) (lpInc.isDense, (lpInc p p>=1).embedding->topEmbedding $ (lpInc p p>=1).embedding->coverEmbedding ((lpInc p p>=1).dense->uniformEmbedding lpInc.isDense).2) (pre {L} {p} {p>=1} F)
  \where {
    \lemma char {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {F : LInftyElem L} {g : L} : linfLpMul {L} {p} {p>=1} F (lpInc p p>=1 g) = (elem F g).1
      => dense-lift-char {_} {_} {_} {lpInc p p>=1} completion.isDenseEmbedding {pre {L} {p} {p>=1} F} g

    -- | The element $F g \in \mathrm L^p$ for `F ∈ L∞` and `g ∈ L`.
    \lemma elem {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} (F : LInftyElem L) (g : L)
      : \Sigma (G : LpSpace L p p>=1) (lpToL0 p p>=1 G = linfMul F (linfInc g))
      => TruncP.rec (level F g) (common-bound F (linfInc g))
          \lam s => (lpClip p p>=1 (dom>=0 s.2) (linfMul F (linfInc g)), lp-dominated (dom>=0 s.2) (dom-bound s.2 s.3 s.4))
      \where {
        \lemma level {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} (F : LInftyElem L) (g : L)
          : isProp (\Sigma (G : LpSpace L p p>=1) (lpToL0 p p>=1 G = linfMul F (linfInc g)))
          => \lam (s t : \Sigma (G : LpSpace L p p>=1) (lpToL0 p p>=1 G = linfMul F (linfInc g))) => ext (lpToL0-inj (s.2 *> inv t.2))

        \lemma dom>=0 {L : FullIntegrationSpace} {a : Rat} (a>0 : RatField.zro RatField.< a) {g : L} : L.zro <= a *q abs g
          => L.*q_>=0 (<=-less a>0) abs>=0

        -- | $|F g| \le a|g|$.
        \lemma dom-bound {L : FullIntegrationSpace} {F : LInftyElem L} {g : L} {a : Rat} (a>0 : RatField.zro RatField.< a)
                         (Fa : IsBelow (abs F.el) a) (ga : IsBelow (abs (linfInc g).el) a)
          : abs (linfMul F (linfInc g)) <= pointCF {L0PreSpace L} (a *q abs g)
          => =_<= (pmap abs (linfMul-char a>0 Fa ga)) <=∘ l0BMul-abs a>0 a>0 <=-refl Fa ga
              <=∘ =_<= (pmap (a *q) (inv l0-pt-abs) *> inv (func-*q {_} {_} {topTruncCompletion {L0PreSpace L}}))
      }

    -- | $F(g + g') = Fg + Fg'$.
    \lemma elem-+ {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} (F : LInftyElem L) (g g' : L)
      : (elem {L} {p} {p>=1} F (g + g')).1 = (elem F g).1 + (elem F g').1
      => \let i => topTruncCompletion {L0PreSpace L}
         \in lpToL0-inj $ (elem {L} {p} {p>=1} F (g + g')).2
              *> pmap (linfMul F) (ext i.func-+ : linfInc (g + g') = \new LInftyElem L ((linfInc g).el + (linfInc g').el) (TruncRieszSpace.IsBounded_+ (linfInc g).bounded (linfInc g').bounded))
              *> linfMul-ldistr F (linfInc g) (linfInc g') *> inv ((lpToL0 p p>=1).func-+ *> pmap2 (+) (elem {L} {p} {p>=1} F g).2 (elem {L} {p} {p>=1} F g').2)

    -- | $\|F g\|_p \le a \|g\|_p$ if $|F| \le a$.
    \lemma elem-norm {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {F : LInftyElem L} {g : L} {a : Rat} (a>0 : RatField.zro RatField.< a)
                           (Fa : IsBelow (abs F.el) a)
      : lnorm (elem {L} {p} {p>=1} F g).1 <= Real.fromRat a * pnorm p p>=1 g
      => \case common-bound F (linfInc g) \with {
        | inP (b,b>0,Fb,gb) =>
          \let | N => a RatField.∨ b
               | G => (elem {L} {p} {p>=1} F g).1
               | i => topTruncCompletion {L0PreSpace L}
          \in \have | N>0 : RatField.zro RatField.< N => a>0 <∘l RatField.join-left
                    | h>=0 => elem.dom>=0 {L} a>0 {g}
                    | jb : abs (lpToL0 p p>=1 G) <= lpToL0 p p>=1 (lpInc p p>=1 (a *q abs g))
                        => =_<= (pmap abs ((elem F g).2 *> linfMul-char N>0 (TruncRieszSpace.IsBelow-level RatField.join-left Fa) (TruncRieszSpace.IsBelow-level RatField.join-right gb)))
                            <=∘ l0BMul-abs N>0 a>0 RatField.join-left Fa (TruncRieszSpace.IsBelow-level RatField.join-right gb)
                            <=∘ =_<= (pmap (a *q) (inv l0-pt-abs) *> inv (func-*q {_} {_} {i}) *> inv lpToL0.char)
                    | le : abs G <= abs (lpInc p p>=1 (a *q abs g))
                        => lpToL0-reflects (=_<= (lpToL0-abs G) <=∘ jb) <=∘ =_<= (inv (abs-ofPos (=_<= (inv (lpInc p p>=1).func-zro) <=∘ (lpInc p p>=1).func-<= h>=0)))
          \in TruncPreBanachLattice.lnorm_<= {LpSpace L p p>=1} le <=∘ =_<= (lpInc.lnorm-char *> pnorm-*q *> pmap (`* _) (RealAbGroup.abs-ofPos (rat_real_<=.1 (<=-less a>0))))
              <=∘ RealField.<=_*_positive-right (rat_real_<=.1 (<=-less a>0)) (pnorm-abs-mono (=_<= (abs-ofPos abs>=0)))
      }

    -- | $g \mapsto F g$ is a uniformly continuous additive map $(L, \|\cdot\|_p) \to \mathrm L^p$.
    \func pre {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} (F : LInftyElem L) : UniformNormedAbGroupMap (LpPreSpace L p p>=1) (LpSpace L p p>=1) \cowith
      | func g => (elem F g).1
      | func-+ => elem-+ F _ _
      | func-norm-uniform {eps} eps>0 => \case F.bounded \with {
        | inP (M,FM) =>
          \let | a => M RatField.∨ 1
               | d => eps RatField.* RatField.finv a
          \in \have | a>0 : RatField.zro RatField.< a => RatField.zro<ide <∘l RatField.join-right
                    | ad : Real.fromRat a * Real.fromRat d = Real.fromRat eps => RealField.*-rat *> pmap Real.fromRat (equation.cRing {RatField.finv-right (RatField.>_/= a>0)})
          \in inP (d, RatField.<_*_positive_positive eps>0 (RatField.finv>0 a>0), \lam {x} xd =>
                real_<_U.1 $ elem-norm a>0 (TruncRieszSpace.IsBelow-level RatField.join-left FM)
                  <∘r RealField.<_*_positive-right (rat_real_<.1 a>0) (real_<_U.2 xd) <∘l =_<= ad)
      }
  }

-- | $j_p(F \cdot g) = F g$ for `g ∈ L`.
\lemma linfLpMul-char {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {F : LInftyElem L} {g : L}
  : lpToL0 p p>=1 (linfLpMul {L} {p} {p>=1} F (lpInc p p>=1 g)) = linfMul F (linfInc g)
  => pmap (lpToL0 p p>=1) linfLpMul.char *> (linfLpMul.elem {L} {p} {p>=1} F g).2

-- | $\|F G\|_p \le a \|G\|_p$ if $|F| \le a$.
\lemma linfLpMul-norm {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {F : LInftyElem L} {a : Rat} (a>0 : RatField.zro RatField.< a)
                      (Fa : IsBelow (abs F.el) a) (G : LpSpace L p p>=1)
  : lnorm (linfLpMul F G) <= Real.fromRat a * lnorm G
  => dense_<= real-join-uniform (lpInc p p>=1) lpInc.isDense (lnorm-metric {LpSpace L p p>=1} ContMap.∘ linfLpMul {L} {p} {p>=1} F)
      (RealField.*-cover CoverMap.∘ ProductCoverSpace.tuple (CoverMap.const (Real.fromRat a)) (lnorm-metric {LpSpace L p p>=1}))
      (\lam g => =_<= (pmap lnorm linfLpMul.char) <=∘ linfLpMul.elem-norm a>0 Fa <=∘ =_<= (pmap (_ *) (inv lpInc.lnorm-char))) G

-- | $\|F G\|_p \le \|F\|_\infty \|G\|_p$.
\lemma linfLpMul-norm-upper {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {F : LInftyElem L} {G : LpSpace L p p>=1}
  : (LpSpace L p p>=1).norm (linfLpMul F G) ExUpperReal.<= linfNorm F.el ExUpperReal.* (LpSpace L p p>=1).norm G
  => \lam {q} u => \case ExUpperReal.*_U.1 u \with {
    | inP (b, inP (M,M<b,FM), b>0, c, Gc, c>0, bc<q) =>
      real_<_U.1 $ linfLpMul-norm b>0 (TruncRieszSpace.IsBelow-level (<=-less M<b) FM) G
        <∘r RealField.<_*_positive-right (rat_real_<.1 b>0) (real_<_U.2 Gc) <∘ (=_<= RealField.*-rat <∘r rat_real_<.1 bc<q)
  }

-- | $(-F) G = -(F G)$.
\lemma linfLpMul-negative {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {F : LInftyElem L} (G : LpSpace L p p>=1)
  : linfLpMul {L} {p} {p>=1} (negative {LInfty L} F) G = negative (linfLpMul {L} {p} {p>=1} F G)
  => dense-lift-unique (lpInc p p>=1) lpInc.isDense (linfLpMul {L} {p} {p>=1} (negative {LInfty L} F)) (negative-uniform {LpSpace L p p>=1} ContMap.∘ linfLpMul {L} {p} {p>=1} F)
      (\lam g => lpToL0-inj $ linfLpMul-char *> pmap (\lam (z : LInftyElem L) => z.el) (Ring.negative_*-left {LInfty L} {F} {linfInc g})
                  *> inv ((lpToL0 p p>=1).func-negative *> pmap negative linfLpMul-char)) G

-- | $(F + F') G = F G + F' G$.
\lemma linfLpMul-+ {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {F F' : LInftyElem L} (G : LpSpace L p p>=1)
  : linfLpMul {L} {p} {p>=1} (F + {LInfty L} F') G = linfLpMul {L} {p} {p>=1} F G + linfLpMul {L} {p} {p>=1} F' G
  => dense-lift-unique (lpInc p p>=1) lpInc.isDense (linfLpMul {L} {p} {p>=1} (F + {LInfty L} F'))
      (+-uniform {LpSpace L p p>=1} ContMap.∘ ProductTopSpace.tuple (linfLpMul {L} {p} {p>=1} F) (linfLpMul {L} {p} {p>=1} F'))
      (\lam g => lpToL0-inj $ linfLpMul-char *> pmap (\lam (z : LInftyElem L) => z.el) (Ring.rdistr {LInfty L} {F} {F'} {linfInc g})
                  *> inv ((lpToL0 p p>=1).func-+ *> pmap2 (+) linfLpMul-char linfLpMul-char)) G

-- | $j_p(F \cdot \kappa_h(U)) = F U$ for `U ∈ L⁰` with $|U| \le h$ and $|U|, |F| \le N$.
\lemma linfLpMul-dominated {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {F : LInftyElem L} {N : Rat} (N>0 : 0 < N)
                           (FN : IsBelow (abs F.el) N) {h : L} (h>=0 : L.zro <= h) {U : L0Space L} (Uh : abs U <= pointCF {L0PreSpace L} h) (UN : IsBelow (abs U) N)
  : lpToL0 p p>=1 (linfLpMul {L} {p} {p>=1} F (lpClip p p>=1 h>=0 U)) = l0BMul N>0 (F.el, U)
  => \let | i => topTruncCompletion {L0PreSpace L}
          | gen : \Pi (X : L0Space L) -> lpToL0 p p>=1 (linfLpMul {L} {p} {p>=1} F (lpClip p p>=1 h>=0 (bclip N X))) = l0BMul N>0 (F.el, clip (i h) (bclip N X))
            => dense-lift-unique completion completion.isDenseEmbedding.1
                (lpToL0 p p>=1 ContMap.∘ linfLpMul {L} {p} {p>=1} F ContMap.∘ lpClip p p>=1 h>=0 ContMap.∘ bclip-cover N)
                (l0BMul N>0 ContMap.∘ ProductCoverSpace.tuple (CoverMap.const F.el) (clip-cover (i h) CoverMap.∘ bclip-cover N))
                (\lam g => \have yN : L.IsBelow (abs (L.clip h (L.bclip N g))) N => L.IsBelow_<= (=_<= (L.clip-abs-eq h>=0) <=∘ L.meet-left) (L.bclip-below N>0)
                           \in pmap (\lam z => lpToL0 p p>=1 (linfLpMul {L} {p} {p>=1} F (lpClip p p>=1 h>=0 z))) (inv (l0-bclip {L}))
                            *> pmap (\lam z => lpToL0 p p>=1 (linfLpMul {L} {p} {p>=1} F z)) (lpClip.char h>=0)
                            *> linfLpMul-char *> linfMul-char N>0 FN (transport (IsBelow __ N) (l0-pt-abs {L} {L.clip h (L.bclip N g)}) (i.func-IsBelow yN))
                            *> pmap (\lam z => l0BMul N>0 (F.el, z)) (RieszSpaceHom.func-clip {i} *> pmap (clip (i h)) (l0-bclip {L})))
     \in pmap (\lam z => lpToL0 p p>=1 (linfLpMul {L} {p} {p>=1} F (lpClip p p>=1 h>=0 z))) (inv (bclip-id N>0 UN))
          *> gen U *> pmap (\lam z => l0BMul N>0 (F.el, clip (i h) z)) (bclip-id N>0 UN) *> pmap (\lam z => l0BMul N>0 (F.el, z)) (clip-id Uh)

-- | $F \cdot g = \kappa_{N|g|}(F g)$ in `Lᵖ` for `g ∈ L` and $|F|, |g| \le N$.
\lemma linfLpMul-clip {L : FullIntegrationSpace} {p : Real} {p>=1 : (1 : Real) <= p} {F : LInftyElem L} {N : Rat} (N>0 : 0 < N)
                      (FN : IsBelow (abs F.el) N) {g : L} (gN : L.IsBelow (abs g) N)
  : linfLpMul {L} {p} {p>=1} F (lpInc p p>=1 g) = lpClip p p>=1 (linfLpMul.elem.dom>=0 N>0 {g}) (l0BMul N>0 (F.el, pointCF {L0PreSpace L} g))
  => \let i => topTruncCompletion {L0PreSpace L}
     \in \have gN' : IsBelow (abs (linfInc g).el) N => transport (IsBelow __ N) (l0-pt-abs {L} {g}) (i.func-IsBelow gN)
     \in lpToL0-inj $ linfLpMul-char *> linfMul-char N>0 FN gN'
          *> inv (lp-dominated (linfLpMul.elem.dom>=0 N>0 {g}) (l0BMul-abs N>0 N>0 <=-refl FN gN'
                    <=∘ =_<= (pmap (N *q) (inv l0-pt-abs) *> inv (func-*q {_} {_} {i}))))