{- | The unit `1 ∈ L⁰`.

  The constant `1` need not lie in `L`, but it lies in `L⁰`: the net $\tau(h)$, $h \in L^+$, is Cauchy for every $d_k$,
  since $|\tau(h) - \tau(k/\eta)| \wedge k \le \tau_\eta k$ for $h \ge k/\eta$ ({trunc-tail}) and $I(\tau_\eta k) \to 0$ by (R1).

  * {l0One}: the limit of this net ({l0One.net-conv}); {l0One-below}: $|1| \le 1$.
  * {l0One-mul}: $1 \cdot F = F$ for bounded `F` (by {fmul-trunc-tail}).
  * {trunc-controlled-conv}, {trunc-controlled-below}: a net `W` on $L^+$ with $|W(n) - W(m)| \le C|\tau(n) - \tau(m)|$ for $m \le n$
    converges by the same argument, and $|W(n)| \le C\tau(n)$ bounds its limit by `C`.
-}

\import Algebra.Group
\import Algebra.Group.GroupHom
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.Ordered.RieszSpace
\import Algebra.Ordered.TruncRieszSpace
\import Algebra.Pointed
\import Algebra.QModule
\import Analysis.Integration.FullIntegrationSpace
\import Analysis.Integration.FunctionalCalculus.Operations
\import Analysis.Integration.FunctionalCalculus.Pointwise
\import Analysis.Integration.L0
\import Analysis.Integration.L0Product
\import Analysis.Limit
\import Arith.Rat
\import Arith.Real
\import Arith.Real.Field
\import Function.Meta
\import Logic
\import Logic.Meta
\import Order.Biordered
\import Order.Lattice
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Topology.CoverSpace.Complete
\import Topology.CoverSpace.Product
\import Topology.NormedAbGroup.Real
\import Topology.NormedAbGroup.Real.Functions
\import Topology.TopAbGroup.NormFamily.Completion
\import Topology.TopAbGroup.Product
\import Topology.TopRieszSpace
\import Topology.TopRieszSpace.Completion
\import Topology.TopSpace
\import Topology.TopSpace.Product
\open LatticeAbGroup
\open QModule
\open TruncRieszSpace

-- | The unit `1 ∈ L⁰`: the limit of the net $\tau(h)$, $h \in L^+$.
\sfunc l0One (L : FullIntegrationSpace) : L0Space L
  => limit net net-conv
  \where \protected {
    -- | The net $\tau(h)$, $h \in L^+$.
    \func net {L : FullIntegrationSpace} (h : PosCone L) : L0Space L
      => pointCF {L0PreSpace L} (L.trunc h.el)

    -- | {net} is Cauchy.
    \lemma net-conv {L : FullIntegrationSpace} : IsConvergent (net {L})
      => convergent-topAbGroup-char {PosCone L} {L0Space L} {net} 2 0 \lam {U} Uo U0 => \case completion-neighborhood {L0PreSpace L} Uo U0 \with {
        | inP ((k,k>=0),eps,eps>0,g) => \case small k>=0 eps>0 \with {
          | inP (eta,eta>0,s) => inP (start k>=0 eta>0, \lam {n} start<=n => g $
              =_<= (pmap (l0Gauge k>=0) (inv (AddGroupHom.func-minus {topTruncCompletion {L0PreSpace L}})) *> l0Gauge.char k>=0)
              <∘r L.integral-mono (transport (\lam z => abs (L.trunc z - _) ∧ k <= _) (inv split) (trunc-tail eta>0 k>=0 (L.to>=0 start<=n)))
              <∘r s)
        }
      }

    \lemma limit-net {L : FullIntegrationSpace} : (L0Space L).IsLimit net (l0One L)
      => rewrite (\peval l0One L) $ limit-isLimit {PosCone L} {L0Space L} {net} {net-conv}

    -- | $|\tau(h)| \le 1$ for $h \ge 0$.
    \lemma trunc-below {L : FullIntegrationSpace} (h : PosCone L) : L.IsBelow (abs (L.trunc h.el)) 1
      => transportInv (L.IsBelow __ 1) (L.abs-ofPos (L.trunc-pos h.el>=0)) (L.IsUnderUnit-below (L.trunc-pos h.el>=0) L.trunc-idemp)

    -- | The level `k/η` beyond which {trunc-tail} applies.
    \func start {L : FullIntegrationSpace} {k : L} (k>=0 : L.zro <= k) {eta : Rat} (eta>0 : RatField.zro RatField.< eta) : PosCone L
      => \new PosElem L (RatField.finv eta *q k) (L.*q_>=0 (<=-less (RatField.finv>0 eta>0)) k>=0)

    -- | For every $d_k$ and $\varepsilon$ there is $\eta$ with $I(\tau_\eta k) < \varepsilon$.
    \lemma small {L : FullIntegrationSpace} {k : L} (k>=0 : L.zro <= k) {eps : Real} (eps>0 : (0 : Real) < eps)
      : ∃ (eta : Rat) (eta>0 : RatField.zro RatField.< eta) (L.integral (L.truncAt eta k) < eps)
      => \case real_<-char.1 eps>0 \with {
        | inP (r,r>0,r<eps) => \case L.integral-trunc-small k>=0 (rat_real_<.2 r>0) \with {
          | inP (eta,eta>0,s) => inP (eta, eta>0, s <∘ r<eps)
        }
      }

    -- | `h = k/η + (h - k/η)`.
    \lemma split {L : FullIntegrationSpace} {k h : L} {eta : Rat} : h = RatField.finv eta *q k + (h - RatField.finv eta *q k)
      => equation.abGroup
  }

-- | $|1| \le 1$.
\lemma l0One-below {L : FullIntegrationSpace} : IsBelow (abs (l0One L)) 1
  => (IsBelow_truncAt RatField.zro<ide).2 $ (L0Space L).closed-limit0 {_}
      (equalizer-closed (truncAt-cover 1 CoverMap.∘ (L0Space L).abs-uniform) (L0Space L).abs-uniform) {PosCone L} {l0One.net} l0One.limit-net
      \lam (h : PosCone L) => (IsBelow_truncAt RatField.zro<ide).1 $ transport (IsBelow __ 1) l0-pt-abs $ (topTruncCompletion {L0PreSpace L}).func-IsBelow (l0One.trunc-below h)

-- | $1 \cdot F = F$ for `F` bounded by `a`, if $a, 1 \le N$.
\lemma l0One-mul {L : FullIntegrationSpace} {N a : Rat} (N>0 : RatField.zro RatField.< N) (a>0 : RatField.zro RatField.< a)
                 (a<=N : a RatField.<= N) (N>=1 : 1 RatField.<= N) {F : L0Space L} (Fa : IsBelow (abs F) a)
  : l0BMul N>0 (l0One L, F) = F
  => \let | x => bclip a F
          | Phi (h : PosCone L) => l0BMul N>0 (l0One.net h, x)
     \in \have | l1 : (L0Space L).IsLimit Phi (l0BMul N>0 (l0One L, x))
                   => cont-limit {PosCone L} {L0Space L} {L0Space L} {l0One.net} l0One.limit-net (l0BMul N>0 CoverMap.∘ ProductCoverSpace.tuple CoverMap.id (CoverMap.const x))
               | l2 : (L0Space L).IsLimit Phi x => completion-limit {L0PreSpace L} {PosCone L} \lam (k,k>=0) eps>0 => \case l0One.small k>=0 eps>0 \with {
                   | inP (eta,eta>0,s) => inP (l0One.start k>=0 eta>0, \lam {h} start<=h => l0One-mul.tail N>0 a>0 a<=N N>=1 k>=0 eta>0 start<=h F <∘r s)
                 }
     \in pmap (\lam z => l0BMul N>0 (l0One L, z)) (inv (bclip-id a>0 Fa)) *> (L0Space L).limit-unique l1 l2 *> bclip-id a>0 Fa
  \where
    \lemma tail {L : FullIntegrationSpace} {N a : Rat} (N>0 : RatField.zro RatField.< N) (a>0 : RatField.zro RatField.< a) (a<=N : a RatField.<= N) (N>=1 : 1 RatField.<= N)
                 {k : L} (k>=0 : L.zro <= k) {eta : Rat} (eta>0 : RatField.zro RatField.< eta) {h : PosCone L} (start<=h : (l0One.start k>=0 eta>0).el L.<= h.el) (F : L0Space L)
      : l0Gauge k>=0 (l0BMul N>0 (l0One.net h, bclip a F) - bclip a F) <= L.integral (L.truncAt eta k)
      => \have | tN : L.IsBelow (abs (L.trunc h.el)) N => L.IsBelow-level N>=1 (l0One.trunc-below h)
               | bN {f : L} : L.IsBelow (abs (L.bclip a f)) N => L.IsBelow-level a<=N (L.bclip-below a>0)
         \in dense_<= real-join-uniform (completion {L0PreSpace L}) completion.isDenseEmbedding.1
              (l0Gauge k>=0 CoverMap.∘ subtract-uniform {L0Space L} CoverMap.∘ ProductCoverSpace.tuple (l0BMul N>0 CoverMap.∘ ProductCoverSpace.tuple (CoverMap.const (l0One.net h)) (bclip-cover a)) (bclip-cover a))
              (CoverMap.const (L.integral (L.truncAt eta k)))
              (\lam f => =_<= (pmap (l0Gauge k>=0) (pmap (\lam z => l0BMul N>0 (l0One.net h, z) - z) (inv (l0-bclip {L} {a} {f})) *> pmap (`- _) (l0BMul-pt N>0 tN bN)
                                                    *> inv (AddGroupHom.func-minus {topTruncCompletion {L0PreSpace L}})) *> l0Gauge.char k>=0)
                         <=∘ L.integral-mono (transport (\lam (z : L) => abs (fmul z (L.bclip a f) - L.bclip a f) ∧ k <= L.truncAt eta k) (pmap L.trunc (inv (l0One.split {L} {k} {h.el} {eta})))
                                               (transport (\lam z => abs (z - L.bclip a f) ∧ k <= L.truncAt eta k) fmul-comm (fmul-trunc-tail eta>0 k>=0 (L.to>=0 {_} {h.el} start<=h))))) F

-- | A net {W} on $L^+$ with $|W(n) - W(m)| \le C |\tau(n) - \tau(m)|$ for $m \le n$ converges (as {l0One.net} does).
\lemma trunc-controlled-conv {L : FullIntegrationSpace} {C : Rat} (C>=1 : 1 RatField.<= C) {W : PosCone L -> L0Space L}
                             (Wd : \Pi {m n : PosCone L} -> m.el L.<= n.el -> abs (W n - W m) <= pointCF {L0PreSpace L} (C *q abs (L.trunc n.el - L.trunc m.el)))
  : IsConvergent W
  => \have C>0 : RatField.zro RatField.< C => RatField.zro<ide <∘l C>=1
     \in convergent-topAbGroup-char {PosCone L} {L0Space L} {W} 2 0 \lam {U} Uo U0 => \case completion-neighborhood {L0PreSpace L} Uo U0 \with {
       | inP ((k,k>=0),eps,eps>0,g) => \case l0One.small k>=0 {Real.fromRat (RatField.finv C) * eps} (RealField.<_*_positive_positive (rat_real_<.1 (RatField.finv>0 C>0)) eps>0) \with {
         | inP (eta,eta>0,s) => inP (l0One.start k>=0 eta>0, \lam {n} start<=n => g $ gauge C>=1 k>=0 eta>0 start<=n (Wd start<=n)
             <∘r (RealField.<_*_positive-right (rat_real_<.1 C>0) s <∘l =_<= (inv RealField.*-assoc *> pmap (`* eps) (RealField.*-rat *> pmap Real.fromRat (RatField.finv-right (RatField.>_/= C>0))) *> ide-left)))
       }
     }
  \where
    -- | $d_k(X, 0) \le C I(\tau_\eta k)$ if $|X| \le C |\tau(n) - \tau(k/\eta)|$ and $n \ge k/\eta$.
    \lemma gauge {L : FullIntegrationSpace} {C : Rat} (C>=1 : 1 RatField.<= C) {k : L} (k>=0 : L.zro <= k) {eta : Rat} (eta>0 : RatField.zro RatField.< eta)
                 {n : PosCone L} (sn : (l0One.start k>=0 eta>0).el L.<= n.el) {X : L0Space L}
                 (Xd : abs X <= pointCF {L0PreSpace L} (C *q abs (L.trunc n.el - L.trunc (l0One.start k>=0 eta>0).el)))
      : l0Gauge k>=0 X <= Real.fromRat C * L.integral (L.truncAt eta k)
      => \let | i => topTruncCompletion {L0PreSpace L}
              | D => abs (L.trunc n.el - L.trunc (l0One.start k>=0 eta>0).el)
         \in \have | C>=0 : RatField.zro RatField.<= C => RatField.zro<=ide <=∘ C>=1
                   | CD>=0 : L.zro <= C *q D => L.*q_>=0 C>=0 L.abs>=0
                   | le : abs X <= abs (i (C *q D))
                       => Xd <=∘ =_<= (inv (abs-ofPos (=_<= (inv i.func-zro) <=∘ i.func-<= CD>=0)))
                   | kk : k <= C *q k => =_<= (inv ide_*q) <=∘ L.<=_*q-left C>=1 k>=0
                   | pt : abs (C *q D) ∧ k <= C *q L.truncAt eta k
                       => =_<= (pmap (__ ∧ k) (L.abs-ofPos CD>=0)) <=∘ L.meet-monotone <=-refl kk <=∘ =_<= (inv (L.meet_*q C>=0))
                           <=∘ L.<=_*q-right C>=0 (transport (\lam z => abs (L.trunc z - _) ∧ k <= _) (inv l0One.split) (trunc-tail eta>0 k>=0 (L.to>=0 sn)))
         \in normAt-lift-abs-mono {L0PreSpace L} {k,k>=0} le <=∘ =_<= (l0Gauge.char k>=0) <=∘ L.integral-mono pt <=∘ =_<= L.integral_*q

-- | The limit of a net `W` on $L^+$ with $|W(n)| \le C \tau(n)$ is bounded by `C`.
\lemma trunc-controlled-below {L : FullIntegrationSpace} {C : Rat} (C>0 : RatField.zro RatField.< C) {W : PosCone L -> L0Space L}
                              (Wb : \Pi (n : PosCone L) -> abs (W n) <= pointCF {L0PreSpace L} (C *q L.trunc n.el)) {x : L0Space L} (xl : (L0Space L).IsLimit W x)
  : IsBelow (abs x) C
  => (IsBelow_truncAt C>0).2 $ (L0Space L).closed-limit0 {_}
      (equalizer-closed (truncAt-cover C CoverMap.∘ (L0Space L).abs-uniform) (L0Space L).abs-uniform) {PosCone L} {W} xl
      \lam (n : PosCone L) => (IsBelow_truncAt C>0).1 $ IsBelow_<= (Wb n <=∘ =_<= (func-*q {_} {_} {topTruncCompletion {L0PreSpace L}})) $ transport (\lam z => IsBelow (C *q z) C) (inv l0-pt-abs *> pointCF-abs n) $
          transport (IsBelow _) RatField.ide-right $ IsBelow_*q (<=-less C>0) $ transport (IsBelow __ 1) l0-pt-abs $ (topTruncCompletion {L0PreSpace L}).func-IsBelow (l0One.trunc-below n)
  \where
    \lemma pointCF-abs {L : FullIntegrationSpace} (n : PosCone L) : pointCF {L0PreSpace L} (abs (L.trunc n.el)) = pointCF {L0PreSpace L} (L.trunc n.el)
      => pmap (pointCF {L0PreSpace L}) (L.abs-ofPos (L.trunc-pos n.el>=0))