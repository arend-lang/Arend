{- | Functional calculus between `Lᵖ` spaces.

  A cover map $\varphi \colon \mathbb R^n \to \mathbb R$ with $\varphi(0) = 0$ and the power modulus {PowModulus}
  ($|\varphi(x) - \varphi(y)|^q \le C \|x - y\|^p + \eta (\|x\|^p + \|y\|^p)$) acts as a cover map $(\mathrm L^p)^n \to \mathrm L^q$.

  * {lp-solid}: `Lᵖ` is solid in `L⁰`: $|G| \le |F|$ and `F ∈ Lᵖ` imply `G ∈ Lᵖ` (the nets $\kappa_h(G)$ are Cauchy by {l0clip-diff-mono}).
  * {l0calc-modulus}: the power modulus transferred to `L⁰`.
  * {lpCalc-isLp}: $\varphi(U) \in \mathrm L^q$, since $|\varphi(U)|^q \le (C + 1) |\sum_j |U_j||^p$ and {lp-solid};
    {lpCalc-modulus}: $\|\varphi(U) - \varphi(V)\|_q^q \le C \|U - V\|^p + \eta (\|U\|^p + \|V\|^p)$.
  * {modulus-locallyUniform}: maps between normed groups with a power modulus are locally uniformly continuous.
  * {lpCalc}, {lpCalc-char}: the cover map $(\mathrm L^p)^n \to \mathrm L^q$ (sum norm on $(\mathrm L^p)^n$);
    {lpCalc1}, {lpCalc1-char}: the unary case $\mathrm L^p \to \mathrm L^q$ for {PowModulus1}.
-}

\import Algebra.Group
\import Algebra.Group.GroupHom
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Monoid.MonoidHom
\import Algebra.Ordered
\import Algebra.Ordered.RieszSpace
\import Algebra.Pointed
\import Algebra.QModule
