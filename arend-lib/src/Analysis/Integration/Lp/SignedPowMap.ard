{- | The signed power $\varphi_r \colon \mathrm L^r \to \mathrm L^{r'}$, extended from {phi0} by local uniform continuity.

  * {ftail-modulus-int}: the integrated modulus of the tails; {phi0-locally-uniform}: {phi0} is locally uniformly continuous.
-}

\import Algebra.Group
\import Algebra.Group.GroupHom
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.Pointed
\import Analysis.Integration.FullIntegrationSpace
\import Analysis.Integration.FunctionalCalculus.Inequalities
\import Analysis.Integration.FunctionalCalculus.Operations
\import Analysis.Integration.Lp
\import Arith.Rat
\import Arith.Real
\import Arith.Real.Field
\import Arith.Real.Power
\import Arith.Real.Power.SignedPow
\import Arith.Real.Power.SignedPowTail
\import Arith.Real.UpperReal
\import Logic
\import Logic.Meta
\import Meta
\import Order.Biordered
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Topology.CoverSpace.Complete
\import Topology.MetricSpace
\import Topology.NormedAbGroup
\import Analysis.Integration.Lp.SignedPow
\open LatticeAbGroup (abs)

-- | A positive rational below a positive real.
\lemma rat-below {x : Real} (x>0 : 0 < x) : ∃ (a : Rat) (0 < a) (a RealAbGroup.< x)
  => \case real_<-rat-char.1 x>0 \with {
    | inP (a,a0,ax) => inP (a, rat_real_<.2 (real_<_U.2 a0), real_<_L.2 ax)
  }

-- | For $s, t > 0$ there is `a > 0` with $d^s \le t$ for all $0 < d \le a$.
\lemma small-rpow {s : Real} (s>0 : 0 < s) {t : Real} (t>0 : 0 < t)
  : ∃ (a : Rat) (0 < a) (\Pi {d : Rat} (d>0 : 0 < d) -> d <= a -> rpow-pos d (rat_real_<.1 d>0) s <= t)
  => \case rat-below (rpow-pos>0 {t} {t>0} {RealField.pinv s s>0}) \with {
    | inP (a,a>0,as) => inP (a, a>0, \lam {d} d>0 d<=a => rpow-pos-mono {_} {_} {rat_real_<.1 d>0} {rpow-pos>0} (<=-less s>0) (rat_real_<=.1 d<=a <=∘ <=-less as)
                                                  <=∘ =_<= (rpow-pos-rpow-pos *> pmap (rpow-pos t t>0) (RealField.pinv-left s>0) *> rpow-pos-one))
  }

-- | The integrated modulus of the tails.
\lemma ftail-modulus-int {L : FullIntegrationSpace} {r q : Real} (r>1 : 1 < r) (q>=1 : 1 <= q)
                         (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)) {eta : Rat} (eta>0 : 0 < eta)
  : ∃ (C : Rat) (0 <= C) (\Pi {a : Rat} (a>0 : 0 < a) (f g : L) -> pnormPow q q>=1 (ftail r>1 a>0 f - ftail r>1 a>0 g)
      <= rpow-pos 2 two>0 q * (Real.fromRat C * pnormPow r (ge1 r>1) (f - g) + Real.fromRat eta * (pnormPow r (ge1 r>1) f + pnormPow r (ge1 r>1) g))
       + rpow-pos 2 two>0 q * rpow-pos 2 two>0 q * rpow-pos 2 two>0 r * rpow-pos a (rat_real_<.1 a>0) (r - 1) * (L.integral (abs f) + L.integral (abs g)))
  => \case ftail-modulus {L} r>1 q>=1 rq eta>0 \with {
    | inP (C,C>=0,h) => inP (C, C>=0, \lam {a} a>0 f g => L.integral-mono (h a>0 f g) <=∘ =_<=
        (L.integral_+ *> pmap2 (+) (integral-rscale *> pmap (_ *) (L.integral_+ *> pmap2 (+) L.integral_*q (L.integral_*q *> pmap (_ *) L.integral_+)))
                                   (integral-rscale *> pmap (_ *) L.integral_+)))
  }

\lemma pinv-cancel {E W : Real} (W>0 : 0 < W) : W * (E * RealField.pinv W W>0) = E
  => equation.cRing *> pmap (E *) (RealField.pinv-right W>0) *> ide-right

-- | {phi0} is locally uniformly continuous from $\|\cdot\|_r$ to $\|\cdot\|_{r'}$.
\func phi0LU {L : FullIntegrationSpace} {r q : Real} (r>1 : 1 < r) (q>=1 : 1 <= q)
             (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1))
  : LocallyUniformMetricMap (LpPreSpace L r (ge1 r>1)) (LpSpace L q q>=1) (phi0 r>1 q>=1 rq) \cowith
  | func-dist-locally-uniform {eps} eps>0 => inP (1, RatField.zro<ide, \lam x0 =>
    \let | r>=1 => <=-less r>1
         | X => LpPreSpace L r r>=1
         | Y => LpSpace L q q>=1
         | e4 => eps * ratio 1 4
    \in \have | e4>0 : 0 < e4 => linarith
              | e4>0' : 0 < Real.fromRat e4 => rat_real_<.1 e4>0
              | q>0 : 0 < q => fpow.one>0 q>=1
              | r>0 : 0 < r => fpow.one>0 r>=1
              | E>0 : 0 < rpow-pos e4 e4>0' q => rpow-pos>0
              | E3>0 : 0 < rpow-pos e4 e4>0' q * ratio 1 3 => RealField.<_*_positive_positive E>0 (rat_real_<.1 idp)
              | Q2>0 : 0 < rpow-pos 2 two>0 q => rpow-pos>0
              | K>0 : 0 < rpow-pos 2 two>0 q * rpow-pos 2 two>0 q * rpow-pos 2 two>0 r
                  => RealField.<_*_positive_positive (RealField.<_*_positive_positive Q2>0 Q2>0) rpow-pos>0
    \in \case UpperReal.U-inh_>0 {lnorm {X} x0} \with {
      | inP (N0,N0u,N0>0) =>
        \let N => N0 + 2
        \in \have | N>0' : 0 < Real.fromRat N => rat_real_<.1 (linarith : 0 < N)
                  | Rx>0 : 0 < rpow-pos (Real.fromRat N) N>0' r => rpow-pos>0
                  | W1>0 : 0 < rpow-pos 2 two>0 q * ((2 : Real) * rpow-pos N N>0' r)
                      => RealField.<_*_positive_positive Q2>0 (RealField.<_*_positive_positive (rat_real_<.1 idp) Rx>0)
        \in \case rat-below (RealField.<_*_positive_positive E3>0 (RealField.pinv>0 W1>0)) \with {
          | inP (eta,eta>0,etab) => \case ftail-modulus-int {L} r>1 q>=1 rq eta>0 \with {
            | inP (C,C>=0,hC) =>
              \have W2>0 : 0 < rpow-pos 2 two>0 q * (Real.fromRat C + 1) => RealField.<_*_positive_positive Q2>0 (usingOnly (rat_real_<=.1 C>=0) linarith)
              \in \case small-rpow r>0 (RealField.<_*_positive_positive E3>0 (RealField.pinv>0 W2>0)) \with {
                | inP (ag,ag>0,hg) =>
                  \let gamma => ag RatField.∧ 1
                  \in \have gamma>0 : 0 < gamma => RatField.<_meet-univ ag>0 RatField.zro<ide
                  \in inP (gamma, gamma>0, \lam {x} {x'} d0 d1 =>
                    \have | dx : lnorm {X} (x0 - x) < 1 => transport (__ < _) (lnorm-ldist {X} {x0} {x}) (real_<_U.2 d0)
                          | dxx : lnorm {X} (x - x') < gamma => transport (__ < _) (lnorm-ldist {X} {x} {x'}) (real_<_U.2 d1)
                          | xN : lnorm {X} x < Real.fromRat N0 + 1 => norm-near {X} (real_<_U.2 N0u) dx
                          | x'N : lnorm {X} x' < Real.fromRat N0 + 1 + gamma => norm-near {X} xN dxx
                          | g<=1 : gamma RealAbGroup.<= 1 => rat_real_<=.1 RatField.meet-right
                          | eN : Real.fromRat N = Real.fromRat N0 + 1 + 1 => inv (pmap (+ 1) RealAbGroup.+-rat *> RealAbGroup.+-rat *> pmap Real.fromRat (linarith : N0 + 1 + 1 = N))
                          | N>=0 : 0 <= Real.fromRat N => <=-less N>0'
                          | xNb : lnorm {X} x <= N => transportInv (_ <=) eN (usingOnly xN linarith)
                          | x'Nb : lnorm {X} x' <= N => transportInv (_ <=) eN (usingOnly (x'N, g<=1) linarith)
                          | Px : pnormPow r r>=1 x <= rpow-pos N N>0' r => (pnorm<=-iff {L} {r} {r>=1} {x} {N} {N>=0}).1 xNb <=∘ =_<= (rpow-pos-eq N>0')
                          | Px' : pnormPow r r>=1 x' <= rpow-pos N N>0' r => (pnorm<=-iff {L} {r} {r>=1} {x'} {N} {N>=0}).1 x'Nb <=∘ =_<= (rpow-pos-eq N>0')
                          | gm>0 : 0 < Real.fromRat gamma => rat_real_<.1 gamma>0
                          | Pd : pnormPow r r>=1 (x - x') <= rpow-pos e4 e4>0' q * ratio 1 3 * RealField.pinv (rpow-pos 2 two>0 q * (Real.fromRat C + 1)) W2>0
                              => (pnorm<=-iff {L} {r} {r>=1} {x - x'} {gamma} {<=-less gm>0}).1 (<=-less dxx) <=∘ =_<= (rpow-pos-eq gm>0) <=∘ hg gamma>0 RatField.meet-left
                    \in \case phi0-approx r>1 q>=1 rq x e4>0, phi0-approx r>1 q>=1 rq x' e4>0, UpperReal.U-inh_>0 {L.integral (abs x) + L.integral (abs x')} \with {
                      | inP (a0,a0>0,hx), inP (a0',a0'>0,hx'), inP (M,Mu,M>0) =>
                        \have | M>0' : 0 < Real.fromRat M => rat_real_<.1 M>0
                              | W3>0 : 0 < rpow-pos 2 two>0 q * rpow-pos 2 two>0 q * rpow-pos 2 two>0 r * M => RealField.<_*_positive_positive K>0 M>0'
                        \in \case small-rpow (signedPow.sub1>0 r>1) (RealField.<_*_positive_positive E3>0 (RealField.pinv>0 W3>0)) \with {
                          | inP (at,at>0,ht) =>
                            \let a => at RatField.∧ (a0 RatField.∧ a0')
                            \in \have | a>0 : 0 < a => RatField.<_meet-univ at>0 (RatField.<_meet-univ a0>0 a0'>0)
                                      | a<=a0 : a <= a0 => RatField.meet-right <=∘ RatField.meet-left
                                      | a<=a0' : a <= a0' => RatField.meet-right <=∘ RatField.meet-right
                                      | D3b => hC a>0 x x'
                                      | G>=0 : 0 <= rpow-pos e4 e4>0' q * ratio 1 3 * RealField.pinv (rpow-pos 2 two>0 q * (Real.fromRat C + 1)) W2>0
                                          => <=-less (RealField.<_*_positive_positive E3>0 (RealField.pinv>0 W2>0))
                                      | h1 : rpow-pos 2 two>0 q * (Real.fromRat C * (rpow-pos e4 e4>0' q * ratio 1 3 * RealField.pinv (rpow-pos 2 two>0 q * (Real.fromRat C + 1)) W2>0))
                                               <= rpow-pos e4 e4>0' q * ratio 1 3
                                          => <=_*_positive-right (<=-less Q2>0) (<=_*_positive-left (usingOnly () linarith : Real.fromRat C <= Real.fromRat C + 1) G>=0)
                                             <=∘ =_<= (inv *-assoc *> pinv-cancel W2>0)
                                      | h2 : rpow-pos 2 two>0 q * (Real.fromRat eta * ((2 : Real) * rpow-pos (Real.fromRat N) N>0' r)) <= rpow-pos e4 e4>0' q * ratio 1 3
                                          => =_<= (equation.cRing : rpow-pos 2 two>0 q * (Real.fromRat eta * ((2 : Real) * rpow-pos N N>0' r)) = rpow-pos 2 two>0 q * ((2 : Real) * rpow-pos N N>0' r) * eta)
                                             <=∘ <=_*_positive-right (<=-less W1>0) (<=-less etab) <=∘ =_<= (pinv-cancel W1>0)
                                      | Aa : rpow-pos a (rat_real_<.1 a>0) (r - 1) <= rpow-pos e4 e4>0' q * ratio 1 3 * RealField.pinv (rpow-pos 2 two>0 q * rpow-pos 2 two>0 q * rpow-pos 2 two>0 r * M) W3>0
                                          => ht a>0 RatField.meet-left
                                      | SM : L.integral (abs x) + L.integral (abs x') <= M => <=-less (real_<_U.2 Mu)
                                      | h3 : rpow-pos 2 two>0 q * rpow-pos 2 two>0 q * rpow-pos 2 two>0 r * rpow-pos a (rat_real_<.1 a>0) (r - 1) * (L.integral (abs x) + L.integral (abs x'))
                                               <= rpow-pos e4 e4>0' q * ratio 1 3
                                          => <=_*_positive-right (<=-less (RealField.<_*_positive_positive K>0 rpow-pos>0)) SM
                                             <=∘ <=_*_positive-left (<=_*_positive-right (<=-less K>0) Aa) (<=-less M>0')
                                             <=∘ =_<= ((equation.cRing : rpow-pos 2 two>0 q * rpow-pos 2 two>0 q * rpow-pos 2 two>0 r * (rpow-pos e4 e4>0' q * ratio 1 3 * RealField.pinv (rpow-pos 2 two>0 q * rpow-pos 2 two>0 q * rpow-pos 2 two>0 r * M) W3>0) * M
                                                          = (rpow-pos 2 two>0 q * rpow-pos 2 two>0 q * rpow-pos 2 two>0 r * M) * (rpow-pos e4 e4>0' q * ratio 1 3 * RealField.pinv (rpow-pos 2 two>0 q * rpow-pos 2 two>0 q * rpow-pos 2 two>0 r * M) W3>0))
                                                       *> pinv-cancel W3>0)
                                      | D3 : pnormPow q q>=1 (ftail r>1 a>0 x - ftail r>1 a>0 x') <= rpow-pos e4 e4>0' q
                                          => combine (<=-less Q2>0) (rat_real_<=.1 C>=0) (rat_real_<=.1 (<=-less eta>0)) D3b Pd Px Px' h1 h2 h3
                                             <=∘ =_<= ((equation.cRing : rpow-pos e4 e4>0' q * ratio 1 3 + rpow-pos e4 e4>0' q * ratio 1 3 + rpow-pos e4 e4>0' q * ratio 1 3
                                                         = rpow-pos e4 e4>0' q * (ratio 1 3 RealAbGroup.+ ratio 1 3 + ratio 1 3))
                                                       *> pmap (_ *) (pmap (\lam t => t + _) RealAbGroup.+-rat *> RealAbGroup.+-rat) *> ide-right)
                                      | nz : lnorm {Y} (lpInc q q>=1 (ftail r>1 a>0 x) - lpInc q q>=1 (ftail r>1 a>0 x')) <= e4
                                          => =_<= (pmap (lnorm {Y}) (inv (AddGroupHom.func-minus {lpInc q q>=1})) *> lpInc.lnorm-char)
                                             <=∘ (pnorm<=-iff {L} {q} {q>=1} {_} {e4} {<=-less e4>0'}).2 (D3 <=∘ =_<= (inv (rpow-pos-eq e4>0')))
                                      | t1 => hx a>0 a<=a0
                                      | t3 => hx' a>0 a<=a0'
                                      | tri : lnorm {Y} (phi0 r>1 q>=1 rq x - phi0 r>1 q>=1 rq x')
                                               <= lnorm {Y} (phi0 r>1 q>=1 rq x - lpInc q q>=1 (ftail r>1 a>0 x)) + lnorm {Y} (lpInc q q>=1 (ftail r>1 a>0 x) - lpInc q q>=1 (ftail r>1 a>0 x'))
                                                  + lnorm {Y} (phi0 r>1 q>=1 rq x' - lpInc q q>=1 (ftail r>1 a>0 x'))
                                          => tri3 {Y}
                                      | e4e : e4 RealAbGroup.+ e4 + e4 < eps
                                          => =_<= (pmap (\lam t => t + _) RealAbGroup.+-rat *> RealAbGroup.+-rat) <∘r rat_real_<.1 (linarith : e4 + e4 + e4 < eps)
                            \in real_<_U.1 (transportInv (__ < _) (lnorm-ldist {Y}) (tri <∘r usingOnly (t1, nz, t3, e4e) linarith))
                        }
                    })
              }
          }
        }
    })
  \where {
    \lemma combine {D3 Q2 C Pd eta Px Px' K A S G Rx E3 : Real} (Q2>=0 : 0 <= Q2) (C>=0 : 0 <= C) (eta>=0 : 0 <= eta)
                   (D3b : D3 <= Q2 * (C * Pd + eta * (Px + Px')) + K * A * S) (PdG : Pd <= G) (PxR : Px <= Rx) (PxR' : Px' <= Rx)
                   (h1 : Q2 * (C * G) <= E3) (h2 : Q2 * (eta * ((2 : Real) * Rx)) <= E3) (h3 : K * A * S <= E3)
      : D3 <= E3 + E3 + E3
      => \have | s1 : C * Pd + eta * (Px + Px') <= C * G + eta * ((2 : Real) * Rx)
                   => <=_+ (<=_*_positive-right C>=0 PdG) (<=_*_positive-right eta>=0 (usingOnly (PxR, PxR') linarith <=∘ =_<= (equation.cRing : Rx + Rx = (2 : Real) * Rx)))
               | s2 : Q2 * (C * Pd + eta * (Px + Px')) <= Q2 * (C * G) + Q2 * (eta * ((2 : Real) * Rx)) => <=_*_positive-right Q2>=0 s1 <=∘ =_<= RealField.ldistr
         \in usingOnly (D3b, s2, h1, h2, h3) linarith

    -- | $\|x\| < N$ and $\|x - y\| < \delta$ imply $\|y\| < N + \delta$.
    \lemma norm-near {X : PseudoNormedAbGroup} {x y : X} {N d : Real} (xN : lnorm x < N) (xy : lnorm (x - y) < d) : lnorm y < N + d
      => \have | t : lnorm y <= lnorm x + lnorm (y - x) => =_<= (pmap lnorm (equation.abGroup : y = x + (y - x))) <=∘ lnorm_+
               | e : lnorm (y - x) = lnorm (x - y) => lnorm_-
         \in usingOnly (t, e, xN, xy) linarith
  }

\lemma tri3 {X : PseudoNormedAbGroup} {u v w z : X} : lnorm (u - v) <= lnorm (u - w) + lnorm (w - z) + lnorm (v - z)
  => \have | e : u - v = (u - w) + (w - z) + negative (v - z) => equation.abGroup
           | t1 : lnorm ((u - w) + (w - z) + negative (v - z)) <= lnorm ((u - w) + (w - z)) + lnorm (negative (v - z)) => lnorm_+
           | t2 : lnorm ((u - w) + (w - z)) <= lnorm (u - w) + lnorm (w - z) => lnorm_+
           | t3 : lnorm (negative (v - z)) = lnorm (v - z) => Real.=-upper.2 (norm_negative {X} {v - z})
     \in =_<= (pmap lnorm e) <=∘ usingOnly (t1, t2, t3) linarith

-- | The signed power $\varphi_r \colon \mathrm L^r \to \mathrm L^{r'}$.
\sfunc lpSignedPow {L : FullIntegrationSpace} {r q : Real} (r>1 : 1 < r) (q>=1 : 1 <= q)
                   (\property rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1))
  : CoverMap (LpSpace L r (ge1 r>1)) (LpSpace L q q>=1)
  => dense-lift (lpInc r (ge1 r>1)) completion.isDenseEmbedding (phi0LU r>1 q>=1 rq)

-- | $\varphi_r$ on `L` is {phi0}.
\lemma lpSignedPow-char {L : FullIntegrationSpace} {r q : Real} {r>1 : 1 < r} {q>=1 : 1 <= q}
                        {rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)} {f : L}
  : lpSignedPow r>1 q>=1 rq (lpInc r (ge1 r>1) f) = phi0 r>1 q>=1 rq f
  => rewrite (\peval lpSignedPow r>1 q>=1 rq) (dense-lift-char {_} {_} {_} {lpInc r (ge1 r>1)} completion.isDenseEmbedding {phi0LU r>1 q>=1 rq} f)