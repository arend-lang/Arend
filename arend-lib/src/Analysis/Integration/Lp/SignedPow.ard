{- | The signed power $\varphi_r(u) = u|u|^{r-2}$ as a map $\mathrm L^r \to \mathrm L^{r'}$, $1 < r < \infty$.

  $\varphi_r$ is not linearly bounded near `0` for $r < 2$, so it is not given by the functional calculus directly.
  We approximate it by the tails $\varphi^{(a)} = \varphi_r - \varphi_r \circ c_a$ ({signedPowTail}), which are.

  * {ftail-cauchy}, {ftail-mul}, {ftail-conj}, {ftail-tangent}, {ftail-modulus}: the estimates of `Arith.Real.SignedPowTail` in `L`.
-}

\import Algebra.Group
\import Algebra.Group.GroupHom
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.Ordered.TruncRieszSpace
\import Algebra.QModule
\import Analysis.Integration.FullIntegrationSpace
\import Analysis.Integration.FunctionalCalculus.Inequalities
\import Analysis.Integration.FunctionalCalculus.Operations
\import Analysis.Integration.Lp
\import Arith.Rat
\import Arith.Real
\import Arith.Real.Field
\import Arith.Real.Power
\import Arith.Real.Power.SignedPow
\import Arith.Real.Power.SignedPowTail
\import Arith.Real.UpperReal
\import Data.Or
\import Logic
\import Logic.Meta
\import Order.Biordered
\import Order.LinearOrder
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Topology.BanachLattice.Completion
\import Topology.MetricSpace.Complete
\import Topology.NormedAbGroup
\import Topology.NormedAbGroup.Real.LinBounded.Power
\open QModule (*q)
\open LatticeAbGroup (abs)

-- | $r > 1$ implies $r \ge 1$.
\lemma ge1 {r : Real} (r>1 : (1 : Real) < r) : (1 : Real) <= r
  => <=-less r>1

\func ftail {L : FullIntegrationSpace} {r : Real} (r>1 : (1 : Real) < r) {a : Rat} (a>0 : 0 RatField.< a) (f : L) : L
  => fsignedPowTail r>1 (rat_real_<.1 a>0) f

-- | $|\varphi^{(a)}(f) - \varphi^{(b)}(f)|^{r'} \le d^{r-1} \tau_d |f|$ for $0 < a, b \le d$.
\lemma ftail-cauchy {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q)
                    (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1))
                    {d a b : Rat} (d>0 : 0 RatField.< d) (a>0 : 0 RatField.< a) (b>0 : 0 RatField.< b) (a<=d : a RatField.<= d) (b<=d : b RatField.<= d) {f : L}
  : fpow q q>=1 (ftail r>1 a>0 f - ftail r>1 b>0 f) <= rscale (rpow-pos (Real.fromRat d) (rat_real_<.1 d>0) (r - 1)) (L.truncAt d (abs f))
  => fcalc-le-pt (f :: nil) (\lam z => signedPowTail-cauchy rq (rat_real_<.1 d>0) (rat_real_<=.1 (<=-less a>0)) (rat_real_<=.1 (<=-less b>0)) (rat_real_<=.1 a<=d) (rat_real_<=.1 b<=d) (z 0))
      (fcalc-pow (fcalc-sub (fcalc-op1 (signedPowTailLB r>1 (rat_real_<.1 a>0)) (fcalc-var 0)) (fcalc-op1 (signedPowTailLB r>1 (rat_real_<.1 b>0)) (fcalc-var 0))))
      (fcalc-rscale (fcalc-truncAt d>0 (fcalc-abs (fcalc-var 0))))

-- | $\bigl|f \varphi^{(a)}(f) - |f|^r\bigr| \le a^{r-1} |f|$.
\lemma ftail-mul {L : FullIntegrationSpace} {r : Real} (r>1 : (1 : Real) < r) {a : Rat} (a>0 : 0 RatField.< a) {f : L}
  : abs (fmul f (ftail r>1 a>0 f) - fpow r (ge1 r>1) f) <= rscale (rpow-pos (Real.fromRat a) (rat_real_<.1 a>0) (r - 1)) (abs f)
  => fcalc-le-pt (f :: nil) (\lam z => signedPowTail-mul (rat_real_<.1 a>0))
      (fcalc-abs (fcalc-sub (fcalc-mul (fcalc-var 0) (fcalc-op1 (signedPowTailLB r>1 (rat_real_<.1 a>0)) (fcalc-var 0))) (fcalc-pow {L} {1} {f :: nil} {r} {<=-less r>1} (fcalc-var 0))))
      (fcalc-rscale (fcalc-abs (fcalc-var 0)))

-- | $|\varphi^{(a)}(f)|^{r'} \le |f|^r$.
\lemma ftail-conj-le {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q)
                     (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)) {a : Rat} (a>0 : 0 RatField.< a) {f : L}
  : fpow q q>=1 (ftail r>1 a>0 f) <= fpow r (ge1 r>1) f
  => fcalc-le-pt (f :: nil) (\lam z => (signedPowTail-conj rq (rat_real_<.1 a>0) (z 0)).1)
      (fcalc-pow (fcalc-op1 (signedPowTailLB r>1 (rat_real_<.1 a>0)) (fcalc-var 0))) (fcalc-pow (fcalc-var 0))

-- | $|f|^r \le |\varphi^{(a)}(f)|^{r'} + r' a^{r-1} |f|$.
\lemma ftail-conj-ge {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q)
                     (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)) {a : Rat} (a>0 : 0 RatField.< a) {f : L}
  : fpow r (ge1 r>1) f <= fpow q q>=1 (ftail r>1 a>0 f) + rscale (q * rpow-pos (Real.fromRat a) (rat_real_<.1 a>0) (r - 1)) (abs f)
  => fcalc-le-pt (f :: nil) (\lam z => (signedPowTail-conj rq (rat_real_<.1 a>0) (z 0)).2)
      (fcalc-pow (fcalc-var 0)) (fcalc-add (fcalc-pow (fcalc-op1 (signedPowTailLB r>1 (rat_real_<.1 a>0)) (fcalc-var 0))) (fcalc-rscale (fcalc-abs (fcalc-var 0))))

-- | $|f|^r + r \varphi^{(a)}(f) (g - f) \le |g|^r + r a^{r-1} |g - f|$.
\lemma ftail-tangent {L : FullIntegrationSpace} {r : Real} (r>1 : (1 : Real) < r) {a : Rat} (a>0 : 0 RatField.< a) {f g : L}
  : fpow r (ge1 r>1) f + rscale r (fmul (ftail r>1 a>0 f) (g - f)) <= fpow r (ge1 r>1) g + rscale (r * rpow-pos (Real.fromRat a) (rat_real_<.1 a>0) (r - 1)) (abs (g - f))
  => fcalc-le-pt (f :: g :: nil) (\lam z => transport (\lam t => _ + t <= _) (equation.cRing : r * signedPowTail r>1 (Real.fromRat a) (z 0) * (z 1 - z 0) = r * (signedPowTail r>1 (Real.fromRat a) (z 0) * (z 1 - z 0)))
                                     (signedPowTail-tangent {r} {r>1} {fpow.one>0 (ge1 r>1)} (rat_real_<.1 a>0) (z 0) (z 1)))
      (fcalc-add (fcalc-pow (fcalc-var 0)) (fcalc-rscale (fcalc-mul (fcalc-op1 (signedPowTailLB r>1 (rat_real_<.1 a>0)) (fcalc-var 0)) (fcalc-sub (fcalc-var 1) (fcalc-var 0)))))
      (fcalc-add (fcalc-pow (fcalc-var 1)) (fcalc-rscale (fcalc-abs (fcalc-sub (fcalc-var 1) (fcalc-var 0)))))

-- | The modulus of continuity of $\varphi^{(a)}$ in `L` (see {signedPowTail-modulus}).
\lemma ftail-modulus {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q)
                     (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)) {eta : Rat} (eta>0 : 0 RatField.< eta)
  : ∃ (C : Rat) (0 RatField.<= C) (\Pi {a : Rat} (a>0 : 0 RatField.< a) (f g : L) -> fpow q q>=1 (ftail r>1 a>0 f - ftail r>1 a>0 g)
      <= rscale (rpow-pos 2 two>0 q) (C *q fpow r (ge1 r>1) (f - g) + eta *q (fpow r (ge1 r>1) f + fpow r (ge1 r>1) g))
       + rscale (rpow-pos 2 two>0 q * rpow-pos 2 two>0 q * rpow-pos 2 two>0 r * rpow-pos (Real.fromRat a) (rat_real_<.1 a>0) (r - 1)) (abs f + abs g))
  => \case signedPowTail-modulus {r} {r>1} {fpow.one>0 (ge1 r>1)} {q} {fpow.one>0 q>=1} rq eta>0 \with {
    | inP (C,C>=0,h) => inP (C, C>=0, \lam {a} a>0 f g => fcalc-le-pt (f :: g :: nil) (\lam z => h (rat_real_<.1 a>0) (z 0) (z 1))
        (fcalc-pow (fcalc-sub (fcalc-op1 (signedPowTailLB r>1 (rat_real_<.1 a>0)) (fcalc-var 0)) (fcalc-op1 (signedPowTailLB r>1 (rat_real_<.1 a>0)) (fcalc-var 1))))
        (fcalc-add (fcalc-rscale (fcalc-add (fcalc-*q (fcalc-pow (fcalc-sub (fcalc-var 0) (fcalc-var 1)))) (fcalc-*q (fcalc-add (fcalc-pow (fcalc-var 0)) (fcalc-pow (fcalc-var 1))))))
                   (fcalc-rscale (fcalc-add (fcalc-abs (fcalc-var 0)) (fcalc-abs (fcalc-var 1))))))
  }

-- | The integrated Cauchy estimate: $\|\varphi^{(a)}(f) - \varphi^{(b)}(f)\|_{r'}^{r'} \le d^{r-1} \|f\|_1$ for $0 < a, b \le d$.
\lemma ftail-cauchy-int {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q)
                        (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1))
                        {d a b : Rat} (d>0 : 0 RatField.< d) (a>0 : 0 RatField.< a) (b>0 : 0 RatField.< b) (a<=d : a RatField.<= d) (b<=d : b RatField.<= d) {f : L}
  : pnormPow q q>=1 (ftail r>1 a>0 f - ftail r>1 b>0 f) <= rpow-pos (Real.fromRat d) (rat_real_<.1 d>0) (r - 1) * L.integral (abs f)
  => L.integral-mono (ftail-cauchy r>1 q>=1 rq d>0 a>0 b>0 a<=d b<=d) <=∘ =_<= integral-rscale
      <=∘ <=_*_positive-right (<=-less rpow-pos>0) (L.integral-mono (TruncRieszSpace.truncAt-bound d>0))

\private \module PhiZero \where {
  -- | $T(d) = (d^{r-1} \|f\|_1)^{1/r'}$ bounds $\|\varphi^{(a)}(f) - \varphi^{(b)}(f)\|_{r'}$ for $a, b \le d$.
  \func T {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q) (f : L) {d : Rat} (d>0 : 0 RatField.< d) : Real
    => rpow (rpow-pos (Real.fromRat d) (rat_real_<.1 d>0) (r - 1) * L.integral (abs f))
            (RealField.<=_*_positive_positive (<=-less rpow-pos>0) (L.integral>=0 LatticeAbGroup.abs>=0)) (RealField.pinv q (fpow.one>0 q>=1)) (RealField.pinv>0 (fpow.one>0 q>=1))

  -- | `z` is $\varphi^{(a)}(f)$ for some `a` such that $T(d) \le \varepsilon$ for all $d \le a$.
  \func P {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q) (f : L) (eps : Rat) (z : LpSpace L q q>=1) : \Prop
    => ∃ (a : Rat) (a>0 : 0 RatField.< a) (z = lpInc q q>=1 (ftail r>1 a>0 f)) (\Pi {d : Rat} (d>0 : 0 RatField.< d) -> d RatField.<= a -> T r>1 q>=1 f d>0 <= Real.fromRat eps)

  \lemma dist-tail {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q)
                   (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1))
                   {f : L} {d a b : Rat} (d>0 : 0 RatField.< d) (a>0 : 0 RatField.< a) (b>0 : 0 RatField.< b) (a<=d : a RatField.<= d) (b<=d : b RatField.<= d)
    : lnorm {LpSpace L q q>=1} (lpInc q q>=1 (ftail r>1 a>0 f) - lpInc q q>=1 (ftail r>1 b>0 f)) <= T r>1 q>=1 f d>0
    => =_<= (pmap (lnorm {LpSpace L q q>=1}) (inv (AddGroupHom.func-minus {lpInc q q>=1})) *> lpInc.lnorm-char)
        <=∘ rpow-mono {_} {_} {pnormPow>=0} {RealField.<=_*_positive_positive (<=-less rpow-pos>0) (L.integral>=0 LatticeAbGroup.abs>=0)} (ftail-cauchy-int r>1 q>=1 rq d>0 a>0 b>0 a<=d b<=d {f})

  \lemma Pc {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q)
            (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)) (f : L)
            {e e' : Rat} {z z' : LpSpace L q q>=1} (e>0 : 0 RatField.< e) (e'>0 : 0 RatField.< e') (Pz : P r>1 q>=1 f e z) (Pz' : P r>1 q>=1 f e' z')
    : lnorm {LpSpace L q q>=1} (z - z') <= Real.fromRat (e RatField.+ e') \elim Pz, Pz'
    | inP (a,a>0,za,ha), inP (b,b>0,zb,hb) => =_<= (pmap2 (\lam (u v : LpSpace L q q>=1) => lnorm {LpSpace L q q>=1} (u - v)) za zb) <=∘ (\case LinearOrder.dec<_<= a b \with {
      | inl a<b => dist-tail r>1 q>=1 rq {f} b>0 a>0 b>0 (<=-less a<b) <=-refl <=∘ hb b>0 <=-refl <=∘ rat_real_<=.1 (linarith : e' RatField.<= e RatField.+ e')
      | inr b<=a => dist-tail r>1 q>=1 rq {f} a>0 a>0 b>0 <=-refl b<=a <=∘ ha a>0 <=-refl <=∘ rat_real_<=.1 (linarith : e RatField.<= e RatField.+ e')
    })

  \lemma Pi {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q) (f : L) {e : Rat} (e>0 : 0 RatField.< e)
    : ∃ (z : LpSpace L q q>=1) (P r>1 q>=1 f e z)
    => \have | q>0 : (0 : Real) < q => fpow.one>0 q>=1
             | e>=0 : (0 : Real) <= Real.fromRat e => rat_real_<=.1 (<=-less e>0)
             | r1>0 : (0 : Real) < r - 1 => signedPow.sub1>0 r>1
       \in \case UpperReal.U-inh_>0 {L.integral (abs f)} \with {
         | inP (N,Nu,N>0) =>
           \let | E => rpow (Real.fromRat e) e>=0 q q>0
                | N' => Real.fromRat N
           \in \have | N'>0 : (0 : Real) < N' => rat_real_<.1 N>0
                     | E>0 : (0 : Real) < E => transport (_ <) (inv (rpow-pos-eq (rat_real_<.1 e>0))) rpow-pos>0
                     | t>0 : (0 : Real) < E * RealField.pinv N' N'>0 => RealField.<_*_positive_positive E>0 (RealField.pinv>0 N'>0)
                     | s>0 : (0 : Real) < rpow-pos (E * RealField.pinv N' N'>0) t>0 (RealField.pinv (r - 1) r1>0) => rpow-pos>0
           \in \case real_<-rat-char.1 s>0 \with {
             | inP (a,a0',as') =>
               \have | a>0 : 0 RatField.< a => rat_real_<.2 (real_<_U.2 a0')
                     | as : Real.fromRat a < rpow-pos (E * RealField.pinv N' N'>0) t>0 (RealField.pinv (r - 1) r1>0) => real_<_L.2 as'
               \in inP (lpInc q q>=1 (ftail r>1 a>0 f), inP (a, a>0, idp, \lam {d} d>0 d<=a =>
                 \have | dr : rpow-pos (Real.fromRat d) (rat_real_<.1 d>0) (r - 1) <= E * RealField.pinv N' N'>0
                           => rpow-pos-mono {_} {_} {rat_real_<.1 d>0} {s>0} (<=-less r1>0) (rat_real_<=.1 d<=a <=∘ <=-less as) <=∘ =_<= (rpow-pos-rpow-pos {_} {t>0} {_} {_} {s>0} *> pmap (rpow-pos _ t>0) (RealField.pinv-left r1>0) *> rpow-pos-one)
                       | IN : L.integral (abs f) <= N' => <=-less (real_<_U.2 Nu)
                       | prod : rpow-pos (Real.fromRat d) (rat_real_<.1 d>0) (r - 1) * L.integral (abs f) <= E
                           => <=_*_positive-left dr (L.integral>=0 LatticeAbGroup.abs>=0) <=∘ <=_*_positive-right (<=-less t>0) IN
                              <=∘ =_<= (RealField.*-assoc *> pmap (E *) (RealField.pinv-left N'>0) *> RealField.ide-right)
                 \in rpow-mono {_} {E} {_} {<=-less E>0} prod <=∘ =_<= (rpow-rpow {Real.fromRat e} {e>=0} {q} {RealField.pinv q q>0} {q>0} {RealField.pinv>0 q>0} {<=-less E>0} {transportInv ((0 : Real) <) (RealField.pinv-right q>0) RealField.zro<ide}
                                                                       *> signedPow.rpow-exp (RealField.pinv-right q>0) *> rpow-one)))
           }
       }
}

-- | $\varphi_r(f) \in \mathrm L^{r'}$ for $f \in L$, as the limit of the tails $\varphi^{(a)}(f)$, $a \to 0$.
\sfunc phi0 {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q)
            (\property rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)) (f : L) : LpSpace L q q>=1
  => family-limit {LpSpace L q q>=1} (PhiZero.P r>1 q>=1 f) (PhiZero.Pi r>1 q>=1 f)
      (\lam e>0 e'>0 Pz Pz' => Real.<=-upper.1 (=_<= (Real.=-upper.2 (LpSpace L q q>=1).norm-dist) <=∘ PhiZero.Pc r>1 q>=1 rq f e>0 e'>0 Pz Pz'))

-- | $\varphi^{(a)}(f) \to \varphi_r(f)$ in $\mathrm L^{r'}$ as $a \to 0$.
\lemma phi0-approx {L : FullIntegrationSpace} {r q : Real} (r>1 : (1 : Real) < r) (q>=1 : (1 : Real) <= q)
                   (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)) (f : L) {e : Rat} (e>0 : 0 RatField.< e)
  : ∃ (a0 : Rat) (0 RatField.< a0) (\Pi {a : Rat} (a>0 : 0 RatField.< a) -> a RatField.<= a0 -> lnorm {LpSpace L q q>=1} (phi0 r>1 q>=1 rq f - lpInc q q>=1 (ftail r>1 a>0 f)) <= Real.fromRat e)
  => \case PhiZero.Pi r>1 q>=1 f e>0 \with {
    | inP (_, inP (a0,a0>0,_,h)) => inP (a0, a0>0, \lam {a} a>0 a<=a0 =>
        \have | Pa : PhiZero.P r>1 q>=1 f e (lpInc q q>=1 (ftail r>1 a>0 f)) => inP (a, a>0, idp, \lam d>0 d<=a => h d>0 (d<=a <=∘ a<=a0))
              | c => family-limit.char {LpSpace L q q>=1} {PhiZero.P r>1 q>=1 f} {PhiZero.Pi r>1 q>=1 f}
                       {\lam e>0 e'>0 Pz Pz' => Real.<=-upper.1 (=_<= (Real.=-upper.2 (LpSpace L q q>=1).norm-dist) <=∘ PhiZero.Pc r>1 q>=1 rq f e>0 e'>0 Pz Pz')} e>0 Pa
        \in rewrite (\peval phi0 r>1 q>=1 rq f) (=_<= (Real.=-upper.2 (inv (LpSpace L q q>=1).norm-dist)) <=∘ (Real.<=-upper {_} {Real.fromRat e}).2 c))
  }
