{- | Uniform convexity of $\mathrm L^p$ for $1 < p < \infty$ (Lemma `lem:clarkson`).

  Instead of Clarkson's inequalities, we use one pointwise inequality valid for every $p > 1$
  ({absPow-uniformly-convex}): for every $\eta > 0$ there is `K` with
  $|a - b|^p \le \eta(|a|^p + |b|^p) + K\bigl((|a|^p + |b|^p)/2 - |(a+b)/2|^p\bigr)$.

  * {fpow-uniformly-convex}: this inequality in `L`; {pnormPow-uniformly-convex}: its integrated form.
  * {lpNormPow-uniformly-convex}: the integrated form in $\mathrm L^p$, by density.
  * {lp-uniformlyConvex}: $\mathrm L^p$ is uniformly convex.
-}

\import Algebra.Group
\import Algebra.Group.GroupHom
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.Pointed
\import Algebra.QModule
\import Analysis.Integration.FullIntegrationSpace
\import Analysis.Integration.FunctionalCalculus.Inequalities
\import Analysis.Integration.FunctionalCalculus.Operations
\import Analysis.Integration.Lp
\import Arith.Rat
\import Arith.Real
\import Arith.Real.Field
\import Arith.Real.Power
\import Arith.Real.Power.UniformConvexity
\import Arith.Real.UpperReal
\import Logic
\import Logic.Meta
\import Meta
\import Order.Biordered
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Topology.BanachSpace
\import Topology.BanachSpace.UniformlyConvex
\import Topology.CoverSpace.Complete
\import Topology.CoverSpace.Product
\import Topology.NormedAbGroup
\import Topology.NormedAbGroup.Real
\import Topology.NormedAbGroup.Real.Functions
\import Topology.TopAbGroup.Product
\import Topology.TopSpace.Product
\open QModule (*q)

-- | The pointwise inequality of uniform convexity in `L`.
\lemma fpow-uniformly-convex {L : FullIntegrationSpace} {p : Real} (p>1 : 1 < p) {eta : Rat} (eta>0 : 0 < eta)
  : ∃ (K : Rat) (0 <= K) (\Pi (f g : L) -> fpow p (<=-less p>1) (f - g)
      <= eta *q (fpow p (<=-less p>1) f + fpow p (<=-less p>1) g) + K *q (ratio 1 2 *q (fpow p (<=-less p>1) f + fpow p (<=-less p>1) g) - fpow p (<=-less p>1) (ratio 1 2 *q (f + g))))
  => \case absPow-uniformly-convex {p} {fpow.one>0 (<=-less p>1)} p>1 eta>0 \with {
    | inP (K,K>=0,h) => inP (K, K>=0, \lam f g => fcalc-le-pt (f :: g :: nil) (\lam z => h (z 0) (z 1))
        (fcalc-pow (fcalc-sub (fcalc-var 0) (fcalc-var 1)))
        (fcalc-add (fcalc-*q (fcalc-add (fcalc-pow (fcalc-var 0)) (fcalc-pow (fcalc-var 1))))
                   (fcalc-*q (fcalc-sub (fcalc-*q (fcalc-add (fcalc-pow (fcalc-var 0)) (fcalc-pow (fcalc-var 1)))) (fcalc-pow (fcalc-*q (fcalc-add (fcalc-var 0) (fcalc-var 1))))))))
  }

-- | The integrated inequality of uniform convexity in `L`.
\lemma pnormPow-uniformly-convex {L : FullIntegrationSpace} {p : Real} (p>1 : 1 < p) {eta : Rat} (eta>0 : 0 < eta)
  : ∃ (K : Rat) (0 <= K) (\Pi (f g : L) -> pnormPow p (<=-less p>1) (f - g)
      <= Real.fromRat eta * (pnormPow p (<=-less p>1) f + pnormPow p (<=-less p>1) g)
       + Real.fromRat K * (Real.fromRat (ratio 1 2) * (pnormPow p (<=-less p>1) f + pnormPow p (<=-less p>1) g) - pnormPow p (<=-less p>1) (ratio 1 2 *q (f + g))))
  => \case fpow-uniformly-convex {L} p>1 eta>0 \with {
    | inP (K,K>=0,h) => inP (K, K>=0, \lam f g => L.integral-mono (h f g) <=∘ =_<=
        (L.integral_+ *> pmap2 (+) (L.integral_*q *> pmap (_ *) L.integral_+)
                                   (L.integral_*q *> pmap (_ *) (L.integral-hom.func-minus *> pmap (\lam t => t - _) (L.integral_*q *> pmap (_ *) L.integral_+)))))
  }

-- | The integrated inequality of uniform convexity in $\mathrm L^p$.
\lemma lpNormPow-uniformly-convex {L : FullIntegrationSpace} {p : Real} (p>1 : 1 < p) {eta : Rat} (eta>0 : 0 < eta)
  : ∃ (K : Rat) (0 <= K) (\Pi (u v : LpSpace L p (<=-less p>1)) -> lpNormPow p (<=-less p>1) (u - v)
      <= Real.fromRat eta * (lpNormPow p (<=-less p>1) u + lpNormPow p (<=-less p>1) v)
       + Real.fromRat K * (Real.fromRat (ratio 1 2) * (lpNormPow p (<=-less p>1) u + lpNormPow p (<=-less p>1) v) - lpNormPow p (<=-less p>1) (ratio 1 2 *q (u + v))))
  => \case pnormPow-uniformly-convex {L} p>1 eta>0 \with {
    | inP (K,K>=0,h) => inP (K, K>=0, \lam u v =>
      \let | p>=1 => <=-less p>1
           | Y => LpSpace L p p>=1
           | N : CoverMap Y RealNormed => lpNormPow.cover {L} {p} {p>=1}
           | A : CoverMap (ProductCoverSpace Y Y) RealNormed => N CoverMap.∘ ProductCoverSpace.proj1
           | B : CoverMap (ProductCoverSpace Y Y) RealNormed => N CoverMap.∘ ProductCoverSpace.proj2
           | AB : CoverMap (ProductCoverSpace Y Y) RealNormed => +-uniform CoverMap.∘ ProductCoverSpace.tuple A B
           | M : CoverMap (ProductCoverSpace Y Y) RealNormed => N CoverMap.∘ SeparatedPreBanachSpace.*q-right-uniform {Y} {ratio 1 2} CoverMap.∘ +-uniform {Y}
           | G : CoverMap (ProductCoverSpace Y Y) RealNormed => N CoverMap.∘ subtract-uniform {Y}
           | H : CoverMap (ProductCoverSpace Y Y) RealNormed => +-uniform CoverMap.∘ ProductCoverSpace.tuple (rpow-convex.scale eta CoverMap.∘ AB)
                  (rpow-convex.scale K CoverMap.∘ subtract-uniform CoverMap.∘ ProductCoverSpace.tuple (rpow-convex.scale (ratio 1 2) CoverMap.∘ AB) M)
      \in dense_<= real-join-uniform (ProductCoverSpace.prod (lpInc p p>=1) (lpInc p p>=1)) lpInc.isDense2 G H
            (\lam s => \have | e1 : lpInc p p>=1 s.1 - lpInc p p>=1 s.2 = lpInc p p>=1 (s.1 - s.2) => inv (AddGroupHom.func-minus {lpInc p p>=1})
                             | e2 : ratio 1 2 *q (lpInc p p>=1 s.1 + lpInc p p>=1 s.2) = lpInc p p>=1 (ratio 1 2 *q (s.1 + s.2))
                                 => pmap (ratio 1 2 *q) (inv (lpInc p p>=1).func-+) *> inv (func-*q {_} {_} {lpInc p p>=1})
                       \in =_<= (pmap (lpNormPow p p>=1) e1 *> lpNormPow.char) <=∘ h s.1 s.2 <=∘
                           =_<= (inv (pmap2 (\lam a b => Real.fromRat eta * (a + b) + Real.fromRat K * (Real.fromRat (ratio 1 2) * (a + b) - lpNormPow p p>=1 (ratio 1 2 *q (lpInc p p>=1 s.1 + lpInc p p>=1 s.2)))) lpNormPow.char lpNormPow.char
                                      *> pmap (\lam c => Real.fromRat eta * (pnormPow p p>=1 s.1 + pnormPow p p>=1 s.2) + Real.fromRat K * (Real.fromRat (ratio 1 2) * (pnormPow p p>=1 s.1 + pnormPow p p>=1 s.2) - c)) (pmap (lpNormPow p p>=1) e2 *> lpNormPow.char))))
            (u,v))
  }

-- | $\mathrm L^p$ is uniformly convex for $1 < p < \infty$.
\lemma lp-uniformlyConvex {L : FullIntegrationSpace} {p : Real} (p>1 : 1 < p) : IsUniformlyConvex (LpSpace L p (<=-less p>1))
  => \lam {eps} eps>0 =>
    \let | p>=1 => <=-less p>1
         | p>0 : 0 < p => fpow.one>0 p>=1
         | e2 => eps * ratio 1 2
    \in \have e2>0 : 0 RealAbGroup.< e2 => rat_real_<.1 (linarith : 0 < e2)
    \in \case real_<-rat-char.1 (rpow-pos>0 {e2} {e2>0} {p}) \with {
      | inP (a,a0,aT) =>
        \have | a>0 : 0 < a => rat_real_<.2 (real_<_U.2 a0)
              | aT' : Real.fromRat a < rpow-pos e2 e2>0 p => real_<_L.2 aT
              | eta>0 : 0 < a * ratio 1 4 => linarith
        \in \case lpNormPow-uniformly-convex {L} p>1 eta>0, UpperReal.U-inh_>0 {p} \with {
          | inP (K,K>=0,h), inP (P,pP,P>0) =>
            \let | KP1 => K * P + 1
                 | delta => ratio 1 2 RatField.∧ (a * RatField.finv KP1 * ratio 1 2)
            \in \have | KP1>0 : 0 < KP1 => linarith (RatField.<=_*_positive_positive K>=0 (<=-less P>0))
                      | delta>0 : 0 < delta => RatField.<_meet-univ (idp : 0 < ratio 1 2) (RatField.<_*_positive_positive (RatField.<_*_positive_positive a>0 (RatField.finv>0 KP1>0)) (idp : 0 < ratio 1 2))
            \in inP (delta, delta>0, \lam {u} {v} u1 v1 m1 =>
              \let | Y => LpSpace L p p>=1
                   | mid => ratio 1 2 *q (u + v)
              \in \have | d' : 0 <= Real.fromRat delta => rat_real_<=.1 (<=-less delta>0)
                        | Nu1 : lpNormPow p p>=1 u <= 1 => npow-le1 {L} {p} {p>=1} {u} (le-of-upper \lam c1 => real_<_U.2 (u1 c1))
                        | Nv1 : lpNormPow p p>=1 v <= 1 => npow-le1 {L} {p} {p>=1} {v} (le-of-upper \lam c1 => real_<_U.2 (v1 c1))
                        | lm : Real.fromRat (1 - delta) <= lnorm {Y} mid => ge-of-upper \lam mc => m1 (real_<_U.1 mc)
                        | d<1 : 0 < Real.fromRat (1 - delta) => rat_real_<.1 (linarith (RatField.meet-left : delta <= ratio 1 2))
                        | ed : 1 - Real.fromRat (1 - delta) = Real.fromRat delta => RealAbGroup.minus-rat *> pmap Real.fromRat linarith
                        | Nm : 1 - p * delta <= lpNormPow p p>=1 mid
                            => =_<= (pmap (\lam t => 1 - p * t) (inv ed)) <=∘ bernoulli p>=1 d<1 <=∘ rpow-mono {_} {_} {<=-less d<1} {lnorm>=0 {Y}} lm
                        | KPd : Real.fromRat (a * ratio 1 4) * 2 + K RealField.* (P RealField.* delta) <= a
                            => \have | r1 : K * (P * delta) <= KP1 * delta
                                          => =_<= (inv *-assoc) <=∘ RatField.<=_*_positive-left linarith (<=-less delta>0)
                                      | r2 : KP1 * delta <= KP1 * (a * RatField.finv KP1 * ratio 1 2) => RatField.<=_*_positive-right (<=-less KP1>0) RatField.meet-right
                                      | r3 : KP1 * (a * RatField.finv KP1 * ratio 1 2) = a * ratio 1 2
                                          => equation.cRing {RatField.finv-right (RatField.>_/= KP1>0)}
                                      | r : a * ratio 1 4 * 2 + K * (P * delta) <= a => linarith
                               \in =_<= (pmap2 (+) RealField.*-rat (pmap (_ *) RealField.*-rat *> RealField.*-rat) *> RealAbGroup.+-rat) <=∘ rat_real_<=.1 r
                        | t : lpNormPow p p>=1 (u - v) <= a
                            => bound (h u v) Nu1 Nv1 rpow>=0 rpow>=0 (rat_real_<=.1 (linarith : 0 <= ratio 1 2)) RealAbGroup.+-rat Nm (rat_real_<=.1 K>=0) (rat_real_<=.1 (<=-less eta>0)) (<=-less (real_<_U.2 pP)) d' KPd
                        | t' : lnorm {Y} (u - v) <= e2 => rpow-mono-inv {_} {_} {lnorm>=0 {Y}} {<=-less e2>0} {p} {p>0} (t <=∘ <=-less aT' <=∘ =_<= (inv (rpow-pos-eq e2>0)))
              \in real_<_U.1 (t' <∘r rat_real_<.1 (linarith : e2 < eps)))
        }
    }

  \where {
    \lemma le-of-upper {x : Real} {q : Rat} (h : \Pi {c : Rat} -> q < c -> x < c) : x <= q
      => \lam qx => \case real_<-rat-char.1 qx \with {
        | inP (c,qc,xc) => <-irreflexive (h (rat_real_<.2 (real_<_U.2 qc)) <∘ real_<_L.2 xc)
      }

    \lemma ge-of-upper {x : Real} {q : Rat} (h : \Pi {c : Rat} -> x < c -> q < c) : q RealAbGroup.<= x
      => \lam xq => \case real_<-rat-char.1 xq \with {
        | inP (c,xc,qc) => <-irreflexive (rat_real_<.1 (h (real_<_U.2 xc)) <∘ real_<_L.2 qc)
      }

    \lemma npow-le1 {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {u : LpSpace L p p>=1} (u1 : lnorm {LpSpace L p p>=1} u <= 1) : lpNormPow p p>=1 u <= 1
      => rpow-mono {_} {_} {lnorm>=0 {LpSpace L p p>=1}} {RealField.zro<=ide} u1 <=∘ =_<= one-rpow

    -- | Bernoulli: $1 - p\delta \le (1 - \delta)^p$.
    \lemma bernoulli {p : Real} (p>=1 : 1 <= p) {x : Real} (x>0 : 0 < x) {p>0 : 0 < p}
      : 1 - p * (1 - x) <= rpow x (<=-less x>0) p p>0
      => \have | t => rpow-pos-tangent {x} {1} {x>0} {RealField.zro<ide} p>=1
               | e1 : rpow-pos 1 RealField.zro<ide (p - 1) = 1 => one-rpow-pos
               | e2 : rpow-pos 1 RealField.zro<ide p = 1 => one-rpow-pos
               | t' : p * (x * 1) <= rpow-pos x x>0 p + (p - 1) * 1 => transport2 (\lam a b => p * (x * a) <= rpow-pos x x>0 p + (p - 1) * b) e1 e2 t
                      | e3 : 1 - p * (1 - x) = p * (x * 1) - (p - 1) * 1 => equation.cRing
         \in transportInv (_ <=) (rpow-pos-eq x>0) (=_<= e3 <=∘ usingOnly t' linarith)

    \lemma bound {Nuv Nu Nv Nm h e k p d P A : Real} (ineq : Nuv <= e * (Nu + Nv) + k * (h * (Nu + Nv) - Nm))
                 (Nu1 : Nu <= 1) (Nv1 : Nv <= 1) (Nu0 : 0 <= Nu) (Nv0 : 0 <= Nv) (h>=0 : 0 <= h) (hh : h + h = 1)
                 (Nm1 : 1 - p * d <= Nm) (k>=0 : 0 <= k) (e>=0 : 0 <= e) (pP : p <= P) (d>=0 : 0 <= d) (A-bound : e * 2 + k * (P * d) <= A)
      : Nuv <= A
      => \have | s0 : Nu + Nv <= 2 => linarith
               | s1 : h * (Nu + Nv) <= h * 2 => <=_*_positive-right h>=0 s0
               | e1 : h * 2 = 1 => equation.cRing *> hh
               | s2 : e * (Nu + Nv) <= e * 2 => <=_*_positive-right e>=0 s0
               | s3 : h * (Nu + Nv) - Nm <= p * d => linarith
               | s4 : k * (h * (Nu + Nv) - Nm) <= k * (P * d) => <=_*_positive-right k>=0 (s3 <=∘ <=_*_positive-left pP d>=0)
         \in linarith
  }