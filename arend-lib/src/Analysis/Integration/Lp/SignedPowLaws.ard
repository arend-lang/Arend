{- | The identities of the signed power $\varphi_r \colon \mathrm L^r \to \mathrm L^{r'}$ ({lpSignedPow}).

  * {lpSignedPow-mul}: $I(u\,\varphi_r(u)) = \|u\|_r^r$.
  * {lpSignedPow-conj}: $\|\varphi_r(u)\|_{r'}^{r'} = \|u\|_r^r$.
  * {lpSignedPow-tangent}: $\|u\|_r^r + r\,I(\varphi_r(u)(v - u)) \le \|v\|_r^r$.

  Each is proved on `L` by passing to the limit along the tails, and extended by continuity.
-}

\import Algebra.Group
\import Algebra.Group.GroupHom
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.Pointed
\import Analysis.Integration.FullIntegrationSpace
\import Analysis.Integration.FunctionalCalculus.Inequalities
\import Analysis.Integration.FunctionalCalculus.Operations
\import Analysis.Integration.FunctionalCalculus.Pointwise
\import Analysis.Integration.Lp
\import Arith.Rat
\import Arith.Real
\import Arith.Real.Field
\import Arith.Real.Power
\import Arith.Real.Power.SignedPow
\import Logic
\import Logic.Meta
\import Meta
\import Order.Biordered
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Topology.CoverSpace.Complete
\import Topology.CoverSpace.Product
\import Topology.MetricSpace
\import Topology.NormedAbGroup
\import Topology.NormedAbGroup.Real
\import Topology.TopAbGroup
\import Topology.TopAbGroup.Product
\import Topology.TopSpace
\import Topology.TopSpace.Product
\import Topology.NormedAbGroup.Real.Functions
\import Analysis.Integration.Lp.SignedPow
\import Analysis.Integration.IntegrationSpace
\import Analysis.Integration.Lp.Holder
\import Analysis.Integration.Lp.SignedPowMap
\open LatticeAbGroup (abs)

-- | If `G` is continuous at `z` and `z` is approximated by points `y` with $G(y) \le c + \varepsilon$, then $G(z) \le c$.
\lemma limit-le {X : PseudoMetricSpace} (G : CoverMap X RealNormed) {z : X} {c : Real}
                (h : \Pi {eps delta : Rat} -> 0 < eps -> 0 < delta -> ∃ (y : X) (X.dist z y < delta) (G y <= c + eps))
  : G z <= c
  => real_<=-eps \lam {d} d>0 =>
    \let d2 => d * ratio 1 2
    \in \have d2>0 : 0 < d2 => linarith
    \in \case metric-contAt-char.1 (cont-char.1 G z) d2>0 \with {
      | inP (delta,delta>0,hd) => \case h d2>0 delta>0 \with {
        | inP (y,zy,Gy) =>
          \have | g : RealAbGroup.abs (G z - G y) < d2 => transport (__ < _) (Real.=-upper.2 RealNormed.norm-dist) (real_<_U.2 (hd (real_<_U.1 zy)))
                | e : d2 RealAbGroup.+ d2 = Real.fromRat d => RealAbGroup.+-rat *> pmap Real.fromRat linarith
          \in usingOnly (RealAbGroup.abs>=id <∘r g, Gy, e) linarith
      }
    }

\lemma limit-ge {X : PseudoMetricSpace} (G : CoverMap X RealNormed) {z : X} {c : Real}
                (h : \Pi {eps delta : Rat} -> 0 < eps -> 0 < delta -> ∃ (y : X) (X.dist z y < delta) (c <= G y + eps))
  : c <= G z
  => \have t => limit-le (negative-uniform CoverMap.∘ G) {z} {negative c} \lam eps>0 delta>0 => \case h eps>0 delta>0 \with {
       | inP (y,zy,cy) => inP (y, zy, usingOnly cy linarith)
     }
     \in usingOnly t linarith

-- | Tails approximating {phi0} with a small error term $a^{r-1} K$.
\lemma tails-approx {L : FullIntegrationSpace} {r q : Real} (r>1 : 1 < r) (q>=1 : 1 <= q)
                    (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)) (f : L)
                    {K : Real} (K>=0 : 0 <= K) {eps delta : Rat} (eps>0 : 0 < eps) (delta>0 : 0 < delta)
  : ∃ (a : Rat) (a>0 : 0 < a) (lnorm {LpSpace L q q>=1} (phi0 r>1 q>=1 rq f - {LpSpace L q q>=1} lpInc q q>=1 (ftail r>1 a>0 f)) < delta)
      (rpow-pos a (rat_real_<.1 a>0) (r - 1) * K <= eps)
  => \have | K1>0 : 0 < K + 1 => usingOnly K>=0 linarith
           | e>0' : 0 < Real.fromRat eps => rat_real_<.1 eps>0
     \in \case phi0-approx r>1 q>=1 rq f (linarith : 0 < delta * ratio 1 2),
               small-rpow (signedPow.sub1>0 r>1) (RealField.<_*_positive_positive e>0' (RealField.pinv>0 K1>0)) \with {
      | inP (a0,a0>0,h0), inP (a1,a1>0,h1) =>
        \let a => a0 RatField.∧ a1
        \in \have | a>0 : 0 RatField.< a => RatField.<_meet-univ a0>0 a1>0
                  | t : rpow-pos a (rat_real_<.1 a>0) (r - 1) <= Real.fromRat eps * RealField.pinv (K + 1) K1>0 => h1 a>0 RatField.meet-right
                  | m : rpow-pos a (rat_real_<.1 a>0) (r - 1) * K <= Real.fromRat eps * RealField.pinv (K + 1) K1>0 * (K + 1)
                      => RealField.<=_*_positive-left t K>=0 <=∘ RealField.<=_*_positive-right (<=-less (RealField.<_*_positive_positive e>0' (RealField.pinv>0 K1>0))) (usingOnly () linarith)
        \in inP (a, a>0, h0 a>0 RatField.meet-left <∘r rat_real_<.1 (linarith : delta * ratio 1 2 < delta),
                 m <=∘ =_<= (*-assoc *> pmap (_ *) (RealField.pinv-left K1>0) *> ide-right))
    }

-- | The pairing $z \mapsto I(z v)$ with a fixed $v \in \mathrm L^q$.
\func pairWith {L : FullIntegrationSpace} {p q : Real} {p>=1 : 1 <= p} {q>=1 : 1 <= q}
               (pq : HolderConjugate p q (fpow.one>0 p>=1) (fpow.one>0 q>=1)) (v : LpSpace L q q>=1)
  : CoverMap (LpSpace L p p>=1) RealNormed
  => (IntegrationSpaceCompletion L).integral-metric CoverMap.∘ lpMul.cover pq CoverMap.∘ ProductCoverSpace.tuple {LpSpace L p p>=1} {LpSpace L p p>=1} {LpSpace L q q>=1} CoverMap.id (CoverMap.const {LpSpace L p p>=1} {LpSpace L q q>=1} v)

\lemma pairWith-char {L : FullIntegrationSpace} {p q : Real} {p>=1 : 1 <= p} {q>=1 : 1 <= q}
                     {pq : HolderConjugate p q (fpow.one>0 p>=1) (fpow.one>0 q>=1)} {v : LpSpace L q q>=1} {z : LpSpace L p p>=1}
  : pairWith pq v z = integral (lpMul pq z v)
  => pmap integral (inv lpMul.cover-eq)

-- | On `L`: $I(\varphi^{(a)}(f) g)$ is the integral of the product.
\lemma pairWith-pt {L : FullIntegrationSpace} {p q : Real} {p>=1 : 1 <= p} {q>=1 : 1 <= q}
                   {pq : HolderConjugate p q (fpow.one>0 p>=1) (fpow.one>0 q>=1)} {f g : L}
  : pairWith pq (lpInc q q>=1 g) (lpInc p p>=1 f) = L.integral (fmul f g)
  => pairWith-char {L} {p} {q} {p>=1} {q>=1} {pq} *> pmap integral (lpMul-char {L} {p} {q} {p>=1} {q>=1} {pq}) *> integrationCompletion.func-integral

-- | $|I(\varphi^{(a)}(f) f) - \|f\|_r^r| \le a^{r-1} \|f\|_1$.
\lemma ftail-mul-int {L : FullIntegrationSpace} {r : Real} (r>1 : 1 < r) {a : Rat} (a>0 : 0 < a) {f : L}
  : RealAbGroup.abs (L.integral (fmul (ftail r>1 a>0 f) f) - pnormPow r (ge1 r>1) f) <= rpow-pos a (rat_real_<.1 a>0) (r - 1) * L.integral (abs f)
  => =_<= (pmap RealAbGroup.abs (inv L.integral-hom.func-minus *> pmap (\lam t => L.integral (t - fpow r (ge1 r>1) f)) fmul-comm))
      <=∘ L.integral_abs <=∘ L.integral-mono (ftail-mul r>1 a>0) <=∘ =_<= integral-rscale

\lemma conj-swap {r q : Real} {r>0 : 0 < r} {q>0 : 0 < q} (rq : HolderConjugate r q r>0 q>0)
  : HolderConjugate q r q>0 r>0
  => RealAbGroup.+-comm *> rq

-- | A two-sided bound passes to the limit: if approximants `y` of `z` satisfy $|G(y) - c| \le \varepsilon$, then $G(z) = c$.
\lemma limit-eq {X : PseudoMetricSpace} (G : CoverMap X RealNormed) {z : X} {c : Real}
                (h : \Pi {eps delta : Rat} -> 0 < eps -> 0 < delta -> ∃ (y : X) (X.dist z y < delta) (RealAbGroup.abs (G y - c) <= eps))
  : G z = c
  => <=-antisymmetric (limit-le G \lam eps>0 delta>0 => \case h eps>0 delta>0 \with {
                         | inP (y,zy,b) => inP (y, zy, usingOnly (RealAbGroup.abs>=id <=∘ b) linarith)
                       })
                      (limit-ge G \lam eps>0 delta>0 => \case h eps>0 delta>0 \with {
                         | inP (y,zy,b) => inP (y, zy, usingOnly (RealAbGroup.abs>=neg <=∘ b) linarith)
                       })

-- | $I(\varphi_r(f) f) = \|f\|_r^r$ for $f \in L$.
\lemma phi0-mul {L : FullIntegrationSpace} {r q : Real} (r>1 : 1 < r) (q>=1 : 1 <= q)
                (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)) (f : L)
  : pairWith {L} {q} {r} {q>=1} {ge1 r>1} (conj-swap rq) (lpInc r (ge1 r>1) f) (phi0 r>1 q>=1 rq f) = pnormPow r (ge1 r>1) f
  => limit-eq {LpSpace L q q>=1} (pairWith {L} {q} {r} {q>=1} {ge1 r>1} (conj-swap rq) (lpInc r (ge1 r>1) f)) \lam {eps} {delta} eps>0 delta>0 =>
      \case tails-approx r>1 q>=1 rq f (L.integral>=0 LatticeAbGroup.abs>=0) eps>0 delta>0 \with {
        | inP (a,a>0,d,m) => inP (lpInc q q>=1 (ftail r>1 a>0 f), transportInv (__ < _) (lnorm-ldist {LpSpace L q q>=1}) d,
            =_<= (pmap (\lam t => RealAbGroup.abs (t - _)) (pairWith-pt {L} {q} {r} {q>=1} {ge1 r>1} {conj-swap rq})) <=∘ ftail-mul-int r>1 a>0 <=∘ m)
      }

-- | $\|\varphi_r(f)\|_{r'}^{r'} = \|f\|_r^r$ for $f \in L$.
\lemma phi0-conj {L : FullIntegrationSpace} {r q : Real} (r>1 : 1 < r) (q>=1 : 1 <= q)
                 (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)) (f : L)
  : lpNormPow q q>=1 (phi0 r>1 q>=1 rq f) = pnormPow r (ge1 r>1) f
  => limit-eq {LpSpace L q q>=1} (lpNormPow.cover {L} {q} {q>=1}) \lam {eps} {delta} eps>0 delta>0 =>
      \have K>=0 : 0 <= q * L.integral (abs f) => RealField.<=_*_positive_positive (<=-less (fpow.one>0 q>=1)) (L.integral>=0 LatticeAbGroup.abs>=0)
      \in \case tails-approx r>1 q>=1 rq f K>=0 eps>0 delta>0 \with {
        | inP (a,a>0,d,m) =>
          \have | le : pnormPow q q>=1 (ftail r>1 a>0 f) <= pnormPow r (ge1 r>1) f => L.integral-mono (ftail-conj-le r>1 q>=1 rq a>0)
                | ge : pnormPow r (ge1 r>1) f <= pnormPow q q>=1 (ftail r>1 a>0 f) + q * rpow-pos a (rat_real_<.1 a>0) (r - 1) * L.integral (abs f)
                    => L.integral-mono (ftail-conj-ge r>1 q>=1 rq a>0) <=∘ =_<= (L.integral_+ *> pmap (_ +) integral-rscale)
                | e : q * rpow-pos a (rat_real_<.1 a>0) (r - 1) * L.integral (abs f) = rpow-pos a (rat_real_<.1 a>0) (r - 1) * (q * L.integral (abs f))
                    => equation.cRing
                | b : RealAbGroup.abs (pnormPow q q>=1 (ftail r>1 a>0 f) - pnormPow r (ge1 r>1) f) <= eps
                    => =_<= (RealAbGroup.abs-ofNeg (usingOnly le linarith : pnormPow q q>=1 (ftail r>1 a>0 f) - pnormPow r (ge1 r>1) f <= 0)
                             *> (equation.abGroup : negative (pnormPow q q>=1 (ftail r>1 a>0 f) - pnormPow r (ge1 r>1) f) = pnormPow r (ge1 r>1) f - pnormPow q q>=1 (ftail r>1 a>0 f)))
                       <=∘ (usingOnly (ge, e, m) linarith : pnormPow r (ge1 r>1) f - pnormPow q q>=1 (ftail r>1 a>0 f) <= eps)
          \in inP (lpInc q q>=1 (ftail r>1 a>0 f), transportInv (__ < _) (lnorm-ldist {LpSpace L q q>=1}) d,
                   =_<= (pmap (\lam t => RealAbGroup.abs (t - _)) lpNormPow.char) <=∘ b)
      }

-- | The tangent inequality $\|f\|_r^r + r\,I(\varphi_r(f)(g - f)) \le \|g\|_r^r$ for $f, g \in L$.
\lemma phi0-tangent {L : FullIntegrationSpace} {r q : Real} (r>1 : 1 < r) (q>=1 : 1 <= q)
                    (rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)) (f g : L)
  : pnormPow r (ge1 r>1) f + r * pairWith {L} {q} {r} {q>=1} {ge1 r>1} (conj-swap rq) (lpInc r (ge1 r>1) (g - f)) (phi0 r>1 q>=1 rq f) <= pnormPow r (ge1 r>1) g
  => \have | r>0 : 0 < r => fpow.one>0 (ge1 r>1)
           | ir : r * RealField.pinv r r>0 = 1 => RealField.pinv-right r>0
           | t : pairWith {L} {q} {r} {q>=1} {ge1 r>1} (conj-swap rq) (lpInc r (ge1 r>1) (g - f)) (phi0 r>1 q>=1 rq f)
                   <= (pnormPow r (ge1 r>1) g - pnormPow r (ge1 r>1) f) * RealField.pinv r r>0
               => limit-le {LpSpace L q q>=1} (pairWith {L} {q} {r} {q>=1} {ge1 r>1} (conj-swap rq) (lpInc r (ge1 r>1) (g - f))) \lam {eps} {delta} eps>0 delta>0 =>
                    \case tails-approx r>1 q>=1 rq f (L.integral>=0 (LatticeAbGroup.abs>=0 {L} {g - f})) eps>0 delta>0 \with {
                      | inP (a,a>0,d,m) =>
                        \let A => rpow-pos a (rat_real_<.1 a>0) (r - 1)
                        \in \have | tg : pnormPow r (ge1 r>1) f + r * L.integral (fmul (ftail r>1 a>0 f) (g - f)) <= pnormPow r (ge1 r>1) g + r * A * L.integral (abs (g - f))
                                      => =_<= (inv (L.integral_+ *> pmap (_ +) integral-rscale)) <=∘ L.integral-mono (ftail-tangent r>1 a>0) <=∘ =_<= (L.integral_+ *> pmap (_ +) integral-rscale)
                                  | ey : pairWith {L} {q} {r} {q>=1} {ge1 r>1} (conj-swap rq) (lpInc r (ge1 r>1) (g - f)) (lpInc q q>=1 (ftail r>1 a>0 f)) = L.integral (fmul (ftail r>1 a>0 f) (g - f))
                                      => pairWith-pt {L} {q} {r} {q>=1} {ge1 r>1} {conj-swap rq}
                        \in inP (lpInc q q>=1 (ftail r>1 a>0 f), transportInv (__ < _) (lnorm-ldist {LpSpace L q q>=1}) d,
                                 =_<= ey <=∘ div-r r>0 ir tg <=∘ <=_+ <=-refl m)
                    }
           | rt : r * pairWith {L} {q} {r} {q>=1} {ge1 r>1} (conj-swap rq) (lpInc r (ge1 r>1) (g - f)) (phi0 r>1 q>=1 rq f) <= pnormPow r (ge1 r>1) g - pnormPow r (ge1 r>1) f
               => RealField.<=_*_positive-right (<=-less r>0) t <=∘ =_<= ((equation.cRing : r * ((pnormPow r (ge1 r>1) g - pnormPow r (ge1 r>1) f) * RealField.pinv r r>0) = (r * RealField.pinv r r>0) * (pnormPow r (ge1 r>1) g - pnormPow r (ge1 r>1) f))
                                                                     *> pmap (\lam u => u * _) ir *> ide-left)
     \in usingOnly rt linarith
  \where
    \lemma div-r {r P Q X A I : Real} (r>0 : 0 < r) (ir : r * RealField.pinv r r>0 = 1) (tg : P + r * X <= Q + r * A * I)
      : X <= (Q - P) * RealField.pinv r r>0 + A * I
      => \have | m : RealField.pinv r r>0 * (r * X) <= RealField.pinv r r>0 * (Q - P + r * A * I) => RealField.<=_*_positive-right (<=-less (RealField.pinv>0 r>0)) (usingOnly tg linarith : r * X <= Q - P + r * A * I)
               | e1 : RealField.pinv r r>0 * (r * X) = X => equation.cRing *> pmap (* X) ir *> ide-left
               | e2 : RealField.pinv r r>0 * (Q - P + r * A * I) = (Q - P) * RealField.pinv r r>0 + A * I
                   => (equation.cRing : RealField.pinv r r>0 * (Q - P + r * A * I) = (Q - P) * RealField.pinv r r>0 + (r * RealField.pinv r r>0) * (A * I)) *> pmap (\lam u => (Q - P) * RealField.pinv r r>0 + u * (A * I)) ir *> pmap (_ +) ide-left
         \in transport2 (<=) e1 e2 m

-- | $I(\varphi_r(u)\, u) = \|u\|_r^r$.
\lemma lpSignedPow-mul {L : FullIntegrationSpace} {r q : Real} {r>1 : 1 < r} {q>=1 : 1 <= q}
                       {rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)} (u : LpSpace L r (ge1 r>1))
  : integral (lpMul (conj-swap rq) (lpSignedPow r>1 q>=1 rq u) u) = lpNormPow r (ge1 r>1) u
  => \let H : CoverMap (LpSpace L r (ge1 r>1)) RealNormed
           => (IntegrationSpaceCompletion L).integral-metric CoverMap.∘ lpMul.cover (conj-swap rq) CoverMap.∘ ProductCoverSpace.tuple (lpSignedPow r>1 q>=1 rq) CoverMap.id
     \in pmap integral lpMul.cover-eq *> dense-lift-unique (lpInc r (ge1 r>1)) lpInc.isDense H lpNormPow.cover (\lam f =>
           pmap integral (inv lpMul.cover-eq) *> pmap (\lam z => integral (lpMul (conj-swap rq) z (lpInc r (ge1 r>1) f))) lpSignedPow-char
           *> inv (pairWith-char {L} {q} {r} {q>=1} {ge1 r>1} {conj-swap rq}) *> phi0-mul r>1 q>=1 rq f *> inv lpNormPow.char) u

-- | $\|\varphi_r(u)\|_{r'}^{r'} = \|u\|_r^r$.
\lemma lpSignedPow-conj {L : FullIntegrationSpace} {r q : Real} {r>1 : 1 < r} {q>=1 : 1 <= q}
                        {rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)} (u : LpSpace L r (ge1 r>1))
  : lpNormPow q q>=1 (lpSignedPow r>1 q>=1 rq u) = lpNormPow r (ge1 r>1) u
  => dense-lift-unique (lpInc r (ge1 r>1)) lpInc.isDense (lpNormPow.cover CoverMap.∘ lpSignedPow r>1 q>=1 rq) lpNormPow.cover (\lam f =>
       pmap (lpNormPow q q>=1) lpSignedPow-char *> phi0-conj r>1 q>=1 rq f *> inv lpNormPow.char) u

-- | The tangent inequality $\|u\|_r^r + r\,I(\varphi_r(u)(v - u)) \le \|v\|_r^r$.
\lemma lpSignedPow-tangent {L : FullIntegrationSpace} {r q : Real} {r>1 : 1 < r} {q>=1 : 1 <= q}
                           {rq : HolderConjugate r q (fpow.one>0 (ge1 r>1)) (fpow.one>0 q>=1)} (u v : LpSpace L r (ge1 r>1))
  : lpNormPow r (ge1 r>1) u + r * integral (lpMul (conj-swap rq) (lpSignedPow r>1 q>=1 rq u) ((-) {LpSpace L r (ge1 r>1)} v u)) <= lpNormPow r (ge1 r>1) v
  => \let | Y => LpSpace L r (ge1 r>1)
          | P : CoverMap (ProductCoverSpace Y Y) RealNormed
              => (IntegrationSpaceCompletion L).integral-metric CoverMap.∘ lpMul.cover (conj-swap rq)
                   CoverMap.∘ ProductCoverSpace.tuple (lpSignedPow r>1 q>=1 rq CoverMap.∘ ProductCoverSpace.proj1) (subtract-uniform {Y} CoverMap.∘ ProductCoverSpace.tuple ProductCoverSpace.proj2 ProductCoverSpace.proj1)
          | A : CoverMap (ProductCoverSpace Y Y) RealNormed
              => +-uniform CoverMap.∘ ProductCoverSpace.tuple (lpNormPow.cover CoverMap.∘ ProductCoverSpace.proj1) (rpow-convex.scale r CoverMap.∘ P)
     \in =_<= (pmap (\lam t => _ + r * integral t) lpMul.cover-eq)
         <=∘ dense_<= real-join-uniform (ProductCoverSpace.prod (lpInc r (ge1 r>1)) (lpInc r (ge1 r>1))) lpInc.isDense2 A (lpNormPow.cover CoverMap.∘ ProductCoverSpace.proj2)
              (\lam (s : \Sigma L L) => \have | e1 : (-) {LpSpace L r (ge1 r>1)} (lpInc r (ge1 r>1) s.2) (lpInc r (ge1 r>1) s.1) = lpInc r (ge1 r>1) (s.2 - s.1) => inv (AddGroupHom.func-minus {lpInc r (ge1 r>1)})
                               | e2 : integral (lpMul.cover (conj-swap rq) (lpSignedPow r>1 q>=1 rq (lpInc r (ge1 r>1) s.1), (-) {LpSpace L r (ge1 r>1)} (lpInc r (ge1 r>1) s.2) (lpInc r (ge1 r>1) s.1)))
                                        = pairWith {L} {q} {r} {q>=1} {ge1 r>1} (conj-swap rq) (lpInc r (ge1 r>1) (s.2 - s.1)) (phi0 r>1 q>=1 rq s.1)
                                   => pmap integral (inv lpMul.cover-eq) *> pmap2 (\lam z w => integral (lpMul (conj-swap rq) z w)) lpSignedPow-char e1
                                      *> inv (pairWith-char {L} {q} {r} {q>=1} {ge1 r>1} {conj-swap rq})
                         \in =_<= (pmap2 (\lam a b => a + r * b) lpNormPow.char e2) <=∘ phi0-tangent r>1 q>=1 rq s.1 s.2 <=∘ =_<= (inv lpNormPow.char))
              (u,v)