\import Algebra.Group
\import Algebra.Monoid
\import Algebra.Ordered.RieszSpace
\import Analysis.Integration.FullIntegrationSpace
\import Analysis.Integration.IntegrationSpace
\import Analysis.Integration.MeasureIntegrationSpace
\import Analysis.Measure.MeasureRing
\import Analysis.Measure.MeasureRing.MeasureRingCat
\import Arith.Real
\import Category
\import Category.Adjoint
\import Category.Functor
\import Category.Meta
\import Category.Subcat
\import Equiv
\import Function.Meta
\import Logic
\import Order.Lattice
\import Order.PartialOrder
\import Paths
\import Paths.Meta
\import Relation.Equivalence
\import Topology.CoverSpace
\import Topology.UniformSpace

\instance IntegrationSpaceCat.{u} : Cat IntegrationSpace.{u}
  | Hom => IntegrationSpaceHom
  | id => IntegrationSpaceHom.id
  | o => IntegrationSpaceHom.∘
  | id-left => idp
  | id-right => idp
  | o-assoc => idp
  | univalence => sip \lam {X} {S1} {S2} h1 h2 => exts IntegrationSpace {
    | zro => h1.func-zro
    | + x y => h1.func-+
    | negative x => AddGroup.negative-equality S1 S2 h1.func-zro h1.func-+ x
    | <= x y => ext (h1.func-<=, h2.func-<=)
    | join x y => RieszSpaceHom.func-join {h1}
    | trunc x => h1.func-trunc
    | integral x => inv h1.func-integral
    | dist x y => inv (Real.=-upper.2 h1.func-isometry)
    | isUniform C => ext (\lam Cu => uniform-subset (h2.func-uniform Cu) \lam (inP (V,CV,p)) => transportInv C p CV,
                          \lam Cu => uniform-subset (h1.func-uniform Cu) \lam (inP (V,CV,p)) => transportInv C p CV)
    | isCauchy C => ext (\lam Cc => cauchy-subset (h2.func-cover Cc) \lam (inP (V,CV,p)) => transportInv C p CV,
                         \lam Cc => cauchy-subset (h1.func-cover Cc) \lam (inP (V,CV,p)) => transportInv C p CV)
    | isOpen U => ext (h2.func-cont, h1.func-cont)
  }
  \where {
    -- | The inverse of a bijective homomorphism of integration spaces.
    \func inverse {X Y : IntegrationSpace} {f : IntegrationSpaceHom X Y} (e : IsEquiv f) : IntegrationSpaceHom Y X \cowith
      | func => IsEquiv.ret e
      | func-+ => IsEquiv.isInj e $ IsEquiv.f_ret e *> inv (f.func-+ *> pmap2 (+) (IsEquiv.f_ret e) (IsEquiv.f_ret e))
      | func-<= {y} {y'} y<=y' => transport (_ <=) (IsEquiv.isInj e $ f.func-join *> pmap2 (∨) (IsEquiv.f_ret e) (IsEquiv.f_ret e) *> Y.join_<= y<=y' *> inv (IsEquiv.f_ret e)) join-left
      | func-join>= => =_<= $ IsEquiv.isInj e $ IsEquiv.f_ret e *> inv (f.func-join *> pmap2 (∨) (IsEquiv.f_ret e) (IsEquiv.f_ret e))
      | func-trunc => IsEquiv.isInj e $ IsEquiv.f_ret e *> inv (f.func-trunc *> pmap Y.trunc (IsEquiv.f_ret e))
      | func-integral => inv f.func-integral *> pmap Y.integral (IsEquiv.f_ret e)

    \lemma Iso<->IsEquiv.{u} {X Y : IntegrationSpace.{u}} {f : IntegrationSpaceHom X Y} : Iso {IntegrationSpaceCat} f <-> IsEquiv f
      => (\lam e => inP \new QEquiv {
            | ret => e.hinv
            | ret_f x => pmap (\lam (g : IntegrationSpaceHom X X) => g x) e.hinv_f
            | f_sec y => pmap (\lam (g : IntegrationSpaceHom Y Y) => g y) e.f_hinv
          },
          \lam e => \new Iso {
            | hinv => inverse e
            | hinv_f => exts \lam x => IsEquiv.ret_f e
            | f_hinv => exts \lam y => IsEquiv.f_ret e
          })
  }

\instance CompleteIntegrationSpaceCat.{u} : Cat CompleteIntegrationSpace.{u}
  => subCat {IntegrationSpaceCat} \new Embedding {
    | f X => X
    | isEmb X Y => \new Retraction {
      | sec p => ext CompleteIntegrationSpace { | IntegrationSpace => p }
      | f_sec => idpe
    }
  }

\func MeasureIntegrationAdjunction.{u} : Adjunction MeasureRingCat.{u} IntegrationSpaceCat.{u} \cowith
  | LAdj : Functor MeasureRingCat.{u} IntegrationSpaceCat.{u} \cowith {
    | F B => SFuncIntegrationSpace B
    | Func => SFuncHom
    | Func-id => intHom-ext \lam (in~ a) => idp
    | Func-o => intHom-ext \lam (in~ a) => idp
  }
  | RAdj : Functor IntegrationSpaceCat.{u} MeasureRingCat.{u} \cowith {
    | F X => X.MeasRing
    | Func f => f.MeasRingHom
    | Func-id => idp
    | Func-o => idp
  }
  | eta {
    | trans B => integrationUnit B
    | natural f => idp
  }
  | epsilon {
    | trans X => integrationCounit X
    | natural f => intHom-ext \lam x => integrationCounit-natural f x
  }
  | eta_epsilon-left => exts \lam a => ext integrationCounit-char
  | eta_epsilon-right => intHom-ext \lam x => integrationCounit-unit x
  \where {
    -- | The unit of the adjunction between measure rings and integration spaces is an isomorphism.
    \lemma integrationUnit-iso.{u} {B : PseudoMeasureRing.{u}} : Iso (integrationUnit B)
      => MeasureRingCat.Iso<->IsEquiv.{u}.2 integrationUnit-equiv
  }

\func CompleteMeasureIntegrationAdjunction.{u} : Adjunction CompleteMeasureRingCat.{u} CompleteIntegrationSpaceCat.{u} \cowith
  | LAdj : Functor CompleteMeasureRingCat.{u} CompleteIntegrationSpaceCat.{u} \cowith {
    | F B => IntegrationSpaceCompletion (SFuncIntegrationSpace B)
    | Func f => integrationCompletion-map (SFuncHom f)
    | Func-id => intHom-ext \lam F => integrationCompletion-lift.unique (integrationCompletion-map (SFuncHom MeasureRingHom.id)) IntegrationSpaceHom.id (\lam (in~ l) => integrationCompletion-map.char) F
    | Func-o {_} {_} {_} {g} {f} => intHom-ext \lam F => integrationCompletion-lift.unique (integrationCompletion-map (SFuncHom (g MeasureRingHom.∘ f))) (integrationCompletion-map (SFuncHom g) ∘ integrationCompletion-map (SFuncHom f))
        (\lam (in~ l) => integrationCompletion-map.char *> inv (pmap (integrationCompletion-map (SFuncHom g)) integrationCompletion-map.char *> integrationCompletion-map.char)) F
  }
  | RAdj : Functor CompleteIntegrationSpaceCat.{u} CompleteMeasureRingCat.{u} \cowith {
    | F X => X.CompleteMeasRing
    | Func f => f.MeasRingHom
    | Func-id => idp
    | Func-o => idp
  }
  | eta {
    | trans X => completeIntegrationUnit X
    | natural f => exts \lam a => ext (inv integrationCompletion-map.char)
  }
  | epsilon {
    | trans X => completeIntegrationCounit X
    | natural => counit-natural
  }
  | eta_epsilon-left {Y} => exts \lam a => ext (completeIntegrationCounit-char *> integrationCounit-char)
  | eta_epsilon-right => counit-unit
  \where {
    \private \lemma counit-natural {X Y : CompleteIntegrationSpace} (f : IntegrationSpaceHom X Y)
      : completeIntegrationCounit Y IntegrationSpaceHom.∘ integrationCompletion-map (SFuncHom f.MeasRingHom) = f IntegrationSpaceHom.∘ completeIntegrationCounit X
      => exts \lam x => integrationCompletion-lift.unique (completeIntegrationCounit Y IntegrationSpaceHom.∘ integrationCompletion-map (SFuncHom f.MeasRingHom)) (f IntegrationSpaceHom.∘ completeIntegrationCounit X)
          (\lam s => pmap (completeIntegrationCounit Y) integrationCompletion-map.char *> completeIntegrationCounit-char *> integrationCounit-natural f s *> inv (pmap f completeIntegrationCounit-char)) x

    \private \lemma counit-unit {B : CompleteMeasureRing}
      : completeIntegrationCounit (IntegrationSpaceCompletion (SFuncIntegrationSpace B)) IntegrationSpaceHom.∘ integrationCompletion-map (SFuncHom (completeIntegrationUnit B)) = IntegrationSpaceHom.id
      => exts \lam x => integrationCompletion-lift.unique (completeIntegrationCounit _ IntegrationSpaceHom.∘ integrationCompletion-map (SFuncHom (completeIntegrationUnit B))) IntegrationSpaceHom.id
          (\lam s => pmap (completeIntegrationCounit _) integrationCompletion-map.char *> completeIntegrationCounit-char *> unit-aux s) x

    \private \lemma unit-aux {B : PseudoMeasureRing} (s : SFuncIntegrationSpace B)
      : integrationCounit (IntegrationSpaceCompletion (SFuncIntegrationSpace B)) (SFuncHom (completeIntegrationUnit B) s) = integrationCompletion s \elim s
      | in~ l => integrationCounit-natural integrationCompletion.inc (SFuncHom (integrationUnit B) (in~ l)) *> pmap integrationCompletion (integrationCounit-unit (in~ l))

    -- | The unit of the adjunction between complete measure rings and complete integration spaces is an isomorphism.
    \lemma completeIntegrationUnit-iso.{u} {B : CompleteMeasureRing.{u}} : Iso (CompleteMeasureIntegrationAdjunction.eta B)
      => CompleteMeasureRingCat.Iso<->IsEquiv.2 completeIntegrationUnit-equiv
  }

\instance FullIntegrationSpaceCat.{u} : Cat FullIntegrationSpace.{u}
  => subCat {IntegrationSpaceCat} \new Embedding {
    | f X => X
    | isEmb X Y => \new Retraction {
      | sec p => ext FullIntegrationSpace { | IntegrationSpace => p }
      | f_sec => idpe
    }
  }

\instance CompleteRegularIntegrationSpaceCat.{u} : Cat CompleteRegularIntegrationSpace.{u}
  => subCat {IntegrationSpaceCat} \new Embedding {
    | f X => X
    | isEmb X Y => \new Retraction {
      | sec p => ext CompleteRegularIntegrationSpace { | IntegrationSpace => p }
      | f_sec => idpe
    }
  }

-- | Full integration spaces are equivalent to complete regular integration spaces: the adjunction (completion ⊣ bounded part) has invertible unit and counit.
\func FullCompleteEquivalence.{u} : Adjunction FullIntegrationSpaceCat.{u} CompleteRegularIntegrationSpaceCat.{u} \cowith
  | LAdj : Functor FullIntegrationSpaceCat.{u} CompleteRegularIntegrationSpaceCat.{u} \cowith {
    | F L => RegularIntegrationSpaceCompletion L
    | Func f => integrationCompletion-map f
    | Func-id => intHom-ext \lam F => integrationCompletion-lift.unique (integrationCompletion-map IntegrationSpaceHom.id) IntegrationSpaceHom.id (\lam x => integrationCompletion-map.char {_} {_} {IntegrationSpaceHom.id}) F
    | Func-o {_} {_} {_} {g} {f} => intHom-ext \lam F => integrationCompletion-lift.unique (integrationCompletion-map (g IntegrationSpaceHom.∘ f)) (integrationCompletion-map g IntegrationSpaceHom.∘ integrationCompletion-map f)
        (\lam x => integrationCompletion-map.char *> inv (pmap (integrationCompletion-map g) integrationCompletion-map.char *> integrationCompletion-map.char)) F
  }
  | RAdj : Functor CompleteRegularIntegrationSpaceCat.{u} FullIntegrationSpaceCat.{u} \cowith {
    | F X => boundedFull X
    | Func f => boundedMap f
    | Func-id => idp
    | Func-o => idp
  }
  | eta {
    | trans L => fullUnit L
    | natural f => exts \lam x => inv (fullUnit-natural f)
  }
  | epsilon {
    | trans X => boundedCounit X
    | natural f => intHom-ext \lam F => boundedCounit-natural f F
  }
  | eta_epsilon-left => exts \lam b => boundedMap-counit-unit
  | eta_epsilon-right => intHom-ext \lam F => counit-completionMap-unit F
  \where {
    \lemma unit-iso.{u} {L : FullIntegrationSpace.{u}} : Iso (FullCompleteEquivalence.eta L)
      => subCat-iso.conv (IntegrationSpaceCat.Iso<->IsEquiv.{u}.2 fullUnit-equiv)

    \lemma counit-iso.{u} {X : CompleteRegularIntegrationSpace.{u}} : Iso (FullCompleteEquivalence.epsilon X)
      => subCat-iso.conv ((IntegrationSpaceCat.Iso<->IsEquiv.{u} {IntegrationSpaceCompletion (boundedFull X)} {X} {boundedCounit X}).2 boundedCounit-equiv)
  }

-- | Full integration spaces are the same as complete regular integration spaces.
\func fullComplete-equiv.{u} : QEquiv {FullIntegrationSpace.{u}} {CompleteRegularIntegrationSpace.{u}} (\lam L => RegularIntegrationSpaceCompletion L) (\lam X => boundedFull X) \cowith
  | ret_f L => inv (Cat.isotoid {FullIntegrationSpaceCat.{u}} (FullCompleteEquivalence.unit-iso {L}))
  | f_sec X => Cat.isotoid {CompleteRegularIntegrationSpaceCat.{u}} (FullCompleteEquivalence.counit-iso {X})

-- Extensionality for homomorphisms, used in the fields of the functors and adjunctions below (much faster than `exts` inside `\cowith` fields).
\private \lemma intHom-ext {X Y : IntegrationSpace} {f g : IntegrationSpaceHom X Y} (p : \Pi (x : X) -> f x = g x) : f = g
  => exts p
