           \in fcalc-le-box (f :: g :: nil) M>=0 (\lam (j : Fin 2) => \case \elim j \with { | 0 => fM | 1 => gM })
                 (\lam z zM => later $ rewrite eT (pt (hd {z 0} {z 0 + Real.fromRat t * z 1}) Mr>=0 (zM 0) (zM 1) aT<1 aTM))
