{- | `Lᵖ` and the functional calculus on `L⁰`.

  * {l0pow}: $|F|^p$ for `F ∈ L⁰`, given by {l0calc}; {l0pow.char}: it extends {fpow}.
  * {psi-pow}: $\Psi^p_h(F) = \Psi^1_{h^p}(|F|^p)$; {pow-sup}: the nets $\Psi^p_h(F)$ and $\Psi^1_k(|F|^p)$ have the same supremum,
    because $h \mapsto h^p$ is cofinal up to $I(k \wedge \delta)$ ({psi-cofinal}).
  * {lp-pow}: `F ∈ Lᵖ` if and only if $|F|^p \in \mathrm L^1$, and then $\|F\|_p^p = \||F|^p\|_1$.
-}

\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.Ordered.RieszSpace
\import Algebra.Pointed
\import Algebra.QModule
\import Analysis.Integration.FullIntegrationSpace
\import Analysis.Integration.FunctionalCalculus.Inequalities
\import Analysis.Integration.FunctionalCalculus.Operations
\import Analysis.Integration.FunctionalCalculus.Pointwise
\import Analysis.Integration.L0
\import Analysis.Integration.L0Calculus
\import Analysis.Integration.L0Product
\import Analysis.Integration.IntegrationSpace
\import Analysis.Integration.LInfty.LpAction
\import Analysis.Integration.Lp.Holder
\import Analysis.Integration.Lp.L1
\import Equiv
\import Topology.NormedAbGroup
\import Analysis.Integration.Lp
\import Analysis.Integration.LpCharacterization
\import Analysis.Integration.LpEmbedding
\import Arith.Rat
\import Arith.Real
\import Arith.Real.Extremes
\import Arith.Real.Field
\import Arith.Real.Power
\import Logic
\import Logic.Meta
\import Meta
\import Order.Biordered
\import Order.Lattice
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Topology.CoverSpace.Complete
\import Topology.CoverSpace.Product
\import Topology.NormedAbGroup.Real
\import Topology.TopAbGroup.Product
\import Topology.TopRieszSpace.Completion
\import Topology.TopSpace
\import Topology.TopSpace.Product
\import Topology.NormedAbGroup.Real.LinBounded.Power
\import Topology.NormedAbGroup.Real.Functions
\open LatticeAbGroup
\open MeetSemilattice
\open QModule

-- | $|F|^p$ for `F ∈ L⁰`.
\func l0pow {L : FullIntegrationSpace} (p : Real) (p>=1 : 1 <= p) : CoverMap (L0Space L) (L0Space L)
  => l0calc (absPow (fpow.one>0 p>=1) p>=1) CoverMap.∘ ArrayCoverSpace.tuple (CoverMap.id :: nil)
  \where \protected {
    \lemma char {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {f : L}
      : l0pow p p>=1 (pointCF {L0PreSpace L} f) = pointCF {L0PreSpace L} (fpow p p>=1 f)
      => pmap {Array (L0Space L) 1} (l0calc (absPow (fpow.one>0 p>=1) p>=1))
              {ArrayCoverSpace.tuple {L0Space L} {1} {L0Space L} (CoverMap.id :: nil) (pointCF {L0PreSpace L} f)} {\lam j => pointCF {L0PreSpace L} ((f :: nil) j)}
              (exts \lam (j : Fin 1) => \case \elim j \with { | 0 => idp })
          *> l0calc-char (absPow (fpow.one>0 p>=1) p>=1) {f :: nil}
  }

-- | {l0pow} as {l0calc} on a one-element array.
\lemma l0pow-eq {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {F : L0Space L}
  : l0pow p p>=1 F = l0calc (absPow (fpow.one>0 p>=1) p>=1) (F :: nil)
  => pmap {Array (L0Space L) 1} (l0calc (absPow (fpow.one>0 p>=1) p>=1))
          {ArrayCoverSpace.tuple {L0Space L} {1} {L0Space L} (CoverMap.id :: nil) F} {F :: nil}
          (exts \lam (j : Fin 1) => \case \elim j \with { | 0 => idp })

-- | $(a \wedge b)^p = a^p \wedge b^p$ for $a, b \ge 0$.
\lemma rpow-meet {a b : Real} {a>=0 : 0 <= a} {b>=0 : 0 <= b} {ab>=0 : 0 <= a ∧ b} {p : Real} {p>0 : 0 < p}
  : rpow (a ∧ b) ab>=0 p p>0 = rpow a a>=0 p p>0 ∧ rpow b b>=0 p p>0
  => <=-antisymmetric (meet-univ (rpow-mono meet-left) (rpow-mono meet-right)) \lam h =>
      \have | na : Not (a <= a ∧ b) => \lam ac => <-irreflexive (h <∘l (meet-left <=∘ rpow-mono ac))
            | nb : Not (b <= a ∧ b) => \lam bc => <-irreflexive (h <∘l (meet-right <=∘ rpow-mono bc))
      \in na \lam ca => nb \lam cb => <-irreflexive (<_meet-univ ca cb)

-- | $(|f| \wedge h)^p = |f|^p \wedge h^p$ for $h \ge 0$.
\lemma fpow-meet {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {f h : L} (h>=0 : L.zro <= h)
  : fpow p p>=1 (abs f ∧ h) = fpow p p>=1 f ∧ fpow p p>=1 h
  => fcalc-eq-pt (f :: h :: nil) (\lam z => \have m : 0 <= abs (z 0) ∧ (z 1 ∨ 0) => positivity
                                     \in rpow-ext (abs-ofPos m) {_} {m} idp
                                     *> rpow-meet {_} {_} {abs>=0} {join-right} {m}
                                     *> pmap (_ ∧) (rpow-ext (inv (abs-ofPos join-right)) idp))
      (fcalc-pow (fcalc-meet (fcalc-abs (fcalc-var 0)) (fcalc-pos (fcalc-var 1) h>=0)))
      (fcalc-meet (fcalc-pow (fcalc-var 0)) (fcalc-pow (fcalc-pos (fcalc-var 1) h>=0)))

-- | $\Psi^1_k(g) = I(|g| \wedge k)$.
\lemma psi-one {L : FullIntegrationSpace} {k g : L} (k>=0 : L.zro <= k) : psi 1 <=-refl k g = L.integral (abs g ∧ k)
  => pmap L.integral (fpow-one *> abs-ofPos positivity)

-- | $\Psi^p_h(F) = \Psi^1_{h^p}(|F|^p)$.
\lemma psi-pow {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {h : L} (h>=0 : L.zro <= h) (F : L0Space L)
  : l0Psi p p>=1 h>=0 F = l0Psi 1 <=-refl (fpow>=0 {L} {p} {p>=1} {h}) (l0pow p p>=1 F)
  => dense-lift-unique completion completion.isDenseEmbedding.1 (l0Psi p p>=1 h>=0) (l0Psi 1 <=-refl fpow>=0 CoverMap.∘ l0pow p p>=1)
      (\lam f => l0Psi.char h>=0 *> pmap L.integral (fpow-meet h>=0) *> inv (psi-one fpow>=0 *> pmap (\lam x => L.integral (x ∧ _)) (abs-ofPos fpow>=0))
                  *> inv (pmap (l0Psi 1 <=-refl fpow>=0) l0pow.char *> l0Psi.char fpow>=0)) F

-- | For $a, k \ge 0$, $\delta > 0$, $K \ge 1$ and $K \delta \ge 2$: $a \wedge k \le a \wedge (Kk)^p + k \wedge \delta$.
\lemma cofinal-pt {p : Real} {p>0 : 0 < p} (p>=1 : 1 <= p) {a k d K : Real} (a>=0 : 0 <= a) (k>=0 : 0 <= k)
                  (d>0 : 0 < d) (K>=1 : 1 <= K) (Kd : 1 <= K * (d * ratio 1 2)) {Kk>=0 : 0 <= K * k}
  : a ∧ k <= a ∧ rpow (K * k) Kk>=0 p p>0 + k ∧ d
  => \case RealAbGroup.<-comparison k {d * ratio 1 2} {d} linarith \with {
    | byRight k<d => meet-right <=∘ =_<= (inv (meet_<= (<=-less k<d))) <=∘ =_<= (inv zro-left) <=∘ <=_+ (meet-univ a>=0 rpow>=0) <=-refl
    | byLeft d2<k =>
      \have | K>=0 : 0 <= K => linarith
            | Kk>=1 : 1 <= K * k => Kd <=∘ gcongr
            | k<=Kk : k <= K * k => =_<= (inv ide-left) <=∘ gcongr
            | Kk<=pow : K * k <= rpow (K * k) Kk>=0 p p>0 => =_<= (inv (rpow-one {_} {Kk>=0} {RealField.zro<ide})) <=∘ rpow-exp-mono p>=1 Kk>=1
      \in meet-monotone <=-refl (k<=Kk <=∘ Kk<=pow) <=∘ =_<= (inv zro-right) <=∘ <=_+ <=-refl (meet-univ k>=0 (<=-less d>0))
  }
  \where {
    \lemma meet_<= {x y : Real} (xy : x <= y) : x ∧ y = x
      => <=-antisymmetric meet-left (meet-univ <=-refl xy)

    -- | $x^1 \le x^p$ for $x \ge 1$, $p \ge 1$.
    \lemma rpow-exp-mono {x p : Real} {x>=0 : 0 <= x} {p>0 : 0 < p} (p>=1 : 1 <= p) (x>=1 : 1 <= x)
      : rpow x x>=0 1 RealAbGroup.zro<ide <= rpow x x>=0 p p>0
      => \have x>0 : 0 < x => RealField.zro<ide <∘l x>=1
         \in =_<= (rpow-pos-eq x>0 *> inv ide-right) <=∘ gcongr (=_<= (inv (one-rpow-pos {RealField.zro<ide} {p - 1})) <=∘ rpow-pos-mono (linarith : 0 <= p - 1) x>=1)
              <=∘ =_<= (inv rpow-pos_+ *> rpow-pos-ext idp *> pmap (rpow-pos x x>0) (equation.abGroup : 1 + (p - 1) = p) *> inv (rpow-pos-eq x>0))
  }

-- | Cofinality of $h \mapsto h^p$: $\Psi^1_k(X) \le \Psi^1_{(Kk)^p}(X) + I(k \wedge \delta)$ for $K = 1 + 2/\delta$.
\lemma psi-cofinal {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {k : L} (k>=0 : L.zro <= k) {d : Rat} (d>0 : 0 < d) (X : L0Space L)
  : l0Psi 1 <=-refl k>=0 X <= l0Psi 1 <=-refl (fpow>=0 {L} {p} {p>=1} {cofinal-K d *q k}) X + L.integral (L.truncAt d k)
  => dense_<= real-join-uniform completion completion.isDenseEmbedding.1 (l0Psi 1 <=-refl k>=0)
      (+-uniform CoverMap.∘ ProductCoverSpace.tuple (l0Psi 1 <=-refl (fpow>=0 {L} {p} {p>=1} {cofinal-K d *q k})) (CoverMap.const (L.integral (L.truncAt d k))))
      (\lam g => =_<= (l0Psi.char k>=0 *> psi-one k>=0) <=∘ L.integral-mono
          (fcalc-le-pt (g :: k :: nil)
            (\lam z => \have | kz>=0 : 0 <= z 1 ∨ 0 => join-right
                             | Kk>=0 : 0 <= Real.fromRat (cofinal-K d) * (z 1 ∨ 0) => RealField.<=_*_positive_positive (<=-less (RealField.zro<ide <∘l K>=1 d>0)) kz>=0
                       \in cofinal-pt {p} {fpow.one>0 p>=1} p>=1 abs>=0 kz>=0 (rat_real_<.1 d>0) (K>=1 d>0) (Kd d>0) {Kk>=0}
                            <=∘ =_<= (pmap (\lam t => abs (z 0) ∧ t + (z 1 ∨ 0) ∧ d) (rpow-ext (inv (abs-ofPos Kk>=0)) idp)))
            (fcalc-meet (fcalc-abs (fcalc-var 0)) (fcalc-pos (fcalc-var 1) k>=0))
            (fcalc-add (fcalc-meet (fcalc-abs (fcalc-var 0)) (fcalc-pow {L} {2} {g :: k :: nil} {p} {p>=1} (fcalc-*q (fcalc-pos (fcalc-var 1) k>=0)))) (fcalc-truncAt d>0 (fcalc-pos (fcalc-var 1) k>=0))))
          <=∘ =_<= (L.integral_+ *> pmap (_ +) idp *> inv (pmap2 (+) (l0Psi.char (fpow>=0 {L} {p} {p>=1} {cofinal-K d *q k}) *> psi-one {L} (fpow>=0 {L} {p} {p>=1} {cofinal-K d *q k})) idp))) X
  \where {
    \func cofinal-K (d : Rat) : Rat => 1 + RatField.finv (d * ratio 1 2)

    \lemma K>=1 {d : Rat} (d>0 : 0 < d) : 1 <= Real.fromRat (cofinal-K d)
      => rat_real_<=.1 (linarith (RatField.finv>0 (positivity : 0 < d * ratio 1 2)))

    \lemma Kd {d : Rat} (d>0 : 0 < d) : 1 <= Real.fromRat (cofinal-K d) * (Real.fromRat d * ratio 1 2)
      => \have | x>0 : 0 < d * ratio 1 2 => positivity
               | e : (1 + RatField.finv (d * ratio 1 2)) * (d * ratio 1 2) = d * ratio 1 2 + RatField.finv (d * ratio 1 2) * (d * ratio 1 2) => equation.cRing
               | f : RatField.finv (d * ratio 1 2) * (d * ratio 1 2) = 1 => RatField.finv-left (RatField.>_/= x>0)
         \in rat_real_<=.1 (usingOnly (x>0, e, f) linarith : 1 <= cofinal-K d * (d * ratio 1 2))
          <=∘ =_<= (inv (pmap (_ *) RealField.*-rat *> RealField.*-rat))
  }

-- | A positive rational below a positive real.
\lemma pos-rat-below {x : Real} (x>0 : 0 < x) : ∃ (a : Rat) (0 < a) (Real.fromRat a < x)
  => \case real_<-rat-char.1 x>0 \with {
    | inP (a,a0,ax) => inP (a, rat_real_<.2 (real_<_U.2 a0), real_<_L.2 ax)
  }

-- | $\Psi^p_h(F) = \Psi^1_{h^p}(|F|^p)$ and cofinality: $\sup_h \Psi^p_h(F) = \sup_k \Psi^1_k(|F|^p)$.
\lemma pow-sup {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {F : L0Space L} {S : Real}
  : IsSup (psiValues p p>=1 F) S <-> IsSup (psiValues 1 <=-refl (l0pow p p>=1 F)) S
  => (\lam s => (\lam {x} (inP (k,kx)) Sx => \case pos-rat-below (linarith : 0 < x - S) \with {
                   | inP (a,a>0,ax) => \case L.integral-trunc-small k.el>=0 a>0 \with {
                     | inP (d,d>0,Id) =>
                       \have | Kk>=0 : L.zro <= psi-cofinal.cofinal-K d *q k.el => PosetQModule.*q_>=0 (<=-less (cofinal-K>0 d>0)) k.el>=0
                             | c => psi-cofinal {L} {p} {p>=1} k.el>=0 d>0 (l0pow p p>=1 F)
                             | b : l0Psi p p>=1 Kk>=0 F <= S => s.1 (inP (\new PosElem L _ Kk>=0, idp))
                             | e : l0Psi p p>=1 Kk>=0 F = l0Psi 1 <=-refl (fpow>=0 {L} {p} {p>=1} {psi-cofinal.cofinal-K d *q k.el}) (l0pow p p>=1 F) => psi-pow Kk>=0 F
                       \in usingOnly (c, b, e, Id, ax, Sx, kx) linarith
                   }
                 },
                 \lam {eps} eps>0 => \case s.2 eps>0 \with {
                   | inP (y, inP (h,hy), Sy) => inP (_, inP (\new PosElem L (fpow p p>=1 h.el) fpow>=0, idp), transport (\lam t => S < t + eps) (inv hy *> psi-pow h.el>=0 F) Sy)
                 }),
     \lam s => (\lam {x} (inP (h,hx)) => =_<= (inv hx *> psi-pow h.el>=0 F) <=∘ s.1 (inP (\new PosElem L (fpow p p>=1 h.el) fpow>=0, idp)),
                \lam {eps} eps>0 => \case s.2 (half>0 eps>0), pos-rat-below (half>0 eps>0) \with {
                  | inP (y, inP (k,ky), Sy), inP (a,a>0,ae) => \case L.integral-trunc-small k.el>=0 a>0 \with {
                    | inP (d,d>0,Id) =>
                      \have | Kk>=0 : L.zro <= psi-cofinal.cofinal-K d *q k.el => PosetQModule.*q_>=0 (<=-less (cofinal-K>0 d>0)) k.el>=0
                            | c => psi-cofinal {L} {p} {p>=1} k.el>=0 d>0 (l0pow p p>=1 F)
                            | e : l0Psi p p>=1 Kk>=0 F = l0Psi 1 <=-refl (fpow>=0 {L} {p} {p>=1} {psi-cofinal.cofinal-K d *q k.el}) (l0pow p p>=1 F) => psi-pow Kk>=0 F
                            | ky' : l0Psi 1 <=-refl k.el>=0 (l0pow p p>=1 F) = y => ky
                      \in inP (_, inP (\new PosElem L _ Kk>=0, idp), usingOnly (c, e, ky', Id, ae, Sy) linarith)
                  }
                }))
  \where {
    \lemma half>0 {eps : Real} (eps>0 : 0 < eps) : 0 < eps * ratio 1 2
      => positivity

    \lemma cofinal-K>0 {d : Rat} (d>0 : 0 < d) : 0 < psi-cofinal.cofinal-K d
      => rat_real_<.2 (RealField.zro<ide <∘l psi-cofinal.K>=1 d>0)
  }

-- | The element of `Lᵖ` representing `F` (unique by {lpToL0-inj}).
\lemma lpOf {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {F : L0Space L} (h : IsLp p p>=1 F)
  : \Sigma (G : LpSpace L p p>=1) (lpToL0 p p>=1 G = F) \level \lam s1 s2 => ext (lpToL0-inj (s1.2 *> inv s2.2))
  => \case h \with { | inP x => x }

-- | `F ∈ Lᵖ` if and only if $|F|^p \in \mathrm L^1$.
\lemma lp-pow {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {F : L0Space L}
  : IsLp p p>=1 F <-> IsLp 1 <=-refl (l0pow p p>=1 F)
  => (\lam h => \case lp-char.1 h \with { | inP (S,s) => lp-char.2 (inP (S, pow-sup.1 s)) },
      \lam h => \case lp-char.1 h \with { | inP (S,s) => lp-char.2 (inP (S, pow-sup.2 s)) })

-- | $\|G\|_p^p = \|W\|_1$ if $j_1 W = |j_p G|^p$.
\lemma lp-pow-norm {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {G : LpSpace L p p>=1} {W : LpSpace L 1 <=-refl}
                   (e : lpToL0 1 <=-refl W = l0pow p p>=1 (lpToL0 p p>=1 G))
  : lpNormPow 1 <=-refl W = lpNormPow p p>=1 G
  => IsSup.isUnique (lp-char-sup e) (pow-sup.1 (lp-char-sup idp))

-- | $|G|^p$ for `G ∈ Lᵖ`, as an element of $\mathrm L^1$.
\func lpPow {L : FullIntegrationSpace} (p : Real) (p>=1 : 1 <= p) (G : LpSpace L p p>=1) : LpSpace L 1 <=-refl
  => (lpOf (lp-pow.1 (inP (G, idp) : IsLp p p>=1 (lpToL0 p p>=1 G)))).1
  \where \protected {
    \lemma char {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {G : LpSpace L p p>=1}
      : lpToL0 1 <=-refl (lpPow p p>=1 G) = l0pow p p>=1 (lpToL0 p p>=1 G)
      => (lpOf (lp-pow.1 (inP (G, idp) : IsLp p p>=1 (lpToL0 p p>=1 G)))).2

    \lemma norm {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {G : LpSpace L p p>=1}
      : lpNormPow 1 <=-refl (lpPow p p>=1 G) = lpNormPow p p>=1 G
      => lp-pow-norm char
  }

-- | $|F|^p \ge 0$.
\lemma l0pow>=0 {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {F : L0Space L} : 0 <= l0pow p p>=1 F
  => =_<= (inv (l0calc-const {L} {1} 0 *> QModule.*q_*n {L0Space L} {0})) <=∘ l0calc-mono {L} {1} {CoverMap.const (Real.fromRat 0)} {absPow (fpow.one>0 p>=1) p>=1} (\lam x => rpow>=0)

-- | `W ≥ 0` in $\mathrm L^p$ if $j_p W \ge 0$.
\lemma lpToL0-pos {L : FullIntegrationSpace} {p : Real} {p>=1 : 1 <= p} {W : LpSpace L p p>=1} (W>=0 : 0 <= lpToL0 p p>=1 W) : 0 <= W
  => lpToL0-reflects (=_<= (lpToL0 p p>=1).func-zro <=∘ W>=0)

-- | $I(|W|) = \|W\|_1$ for $W \in \mathrm L^1$.
\lemma lp1-integral-abs {L : FullIntegrationSpace} (W : LpSpace L 1 <=-refl)
  : (IntegrationSpaceCompletion L).integral (lp1-map (abs {LpSpace L 1 <=-refl} W)) = lnorm {LpSpace L 1 <=-refl} W
  => dense-lift-unique (lpInc 1 <=-refl) lpInc.isDense ((IntegrationSpaceCompletion L).integral-metric CoverMap.∘ lp1-map CoverMap.∘ (LpSpace L 1 <=-refl).abs-uniform)
      (lnorm-metric {LpSpace L 1 <=-refl})
      (\lam f => pmap (\lam z => (IntegrationSpaceCompletion L).integral (lp1-map z)) (inv (RieszSpaceHom.func-abs {lpInc 1 <=-refl})) *> pmap (IntegrationSpaceCompletion L).integral lp1-map-char *> integrationCompletion.func-integral
                  *> inv (lpInc.lnorm-char *> pnorm-one)) W

-- | $I(W) = \|W\|_1$ for $W \in \mathrm L^1$ with $j_1 W \ge 0$.
\lemma lp1-integral-pos {L : FullIntegrationSpace} {W : LpSpace L 1 <=-refl} (W>=0 : 0 <= lpToL0 1 <=-refl W)
  : (IntegrationSpaceCompletion L).integral (lp1-map W) = lpNormPow 1 <=-refl W
  => pmap (\lam z => (IntegrationSpaceCompletion L).integral (lp1-map z)) (inv (abs-ofPos (lpToL0-pos W>=0))) *> lp1-integral-abs W *> inv (rpow-one {_} {lnorm>=0 {LpSpace L 1 <=-refl}} {RealField.zro<ide})

-- | The map $\mathrm L^1 \to \mathrm L^0$ on the completion of `L`.
\func l1ToL0 {L : FullIntegrationSpace} : CoverMap (IntegrationSpaceCompletion L) (L0Space L)
  => dense-lift completion completion.isDenseEmbedding (lpToL0 1 <=-refl CoverMap.∘ lpInc 1 <=-refl CoverMap.∘ pre)
  \where \protected {
    \func pre {L : FullIntegrationSpace} : NormedIsometricMap L (LpPreSpace L 1 <=-refl) \cowith
      | func x => x
      | func-+ => idp
      | func-norm-isometry {x} => Real.=-upper.1 (pnorm-one {L} {<=-refl} {x})

    \lemma char {L : FullIntegrationSpace} {f : L} : l1ToL0 (integrationCompletion f) = pointCF {L0PreSpace L} f
      => dense-lift-char completion.isDenseEmbedding f *> lpToL0.char

    \lemma lp1 {L : FullIntegrationSpace} (W : LpSpace L 1 <=-refl) : l1ToL0 (lp1-map W) = lpToL0 1 <=-refl W
      => dense-lift-unique (lpInc 1 <=-refl) lpInc.isDense (l1ToL0 CoverMap.∘ lp1-map) (lpToL0 1 <=-refl)
          (\lam f => pmap l1ToL0 lp1-map-char *> char *> inv lpToL0.char) W

    -- | If $j(Y) = j_1 W$, then $Y$ is the image of $W$.
    \lemma unique {L : FullIntegrationSpace} {Y : IntegrationSpaceCompletion L} {W : LpSpace L 1 <=-refl} (e : l1ToL0 Y = lpToL0 1 <=-refl W)
      : Y = lp1-map W
      => \case IsEquiv.isSurj lp1-equiv Y \with {
        | inP (V,VY) => inv VY *> pmap lp1-map (lpToL0-inj (inv (lp1 V) *> pmap l1ToL0 VY *> e))
      }
  }

-- | The product of $\mathrm L^p \times \mathrm L^q$ is the product {l0Mul} of `L⁰`: $j(uv) = (j_p u)(j_q v)$.
\lemma lpMul-l0 {L : FullIntegrationSpace} {p q : Real} {p>=1 : 1 <= p} {q>=1 : 1 <= q}
                {pq : HolderConjugate p q (fpow.one>0 p>=1) (fpow.one>0 q>=1)} (u : LpSpace L p p>=1) (v : LpSpace L q q>=1)
  : l1ToL0 (lpMul pq u v) = l0Mul (lpToL0 p p>=1 u, lpToL0 q q>=1 v)
  => pmap l1ToL0 (lpMul.cover-eq {L} {p} {q} {p>=1} {q>=1} {pq}) *> dense-lift-unique (ProductCoverSpace.prod (lpInc p p>=1) (lpInc q q>=1)) lpInc.isDense2
      (l1ToL0 CoverMap.∘ lpMul.cover pq)
