\import Function
\import Function.Meta
\import Logic
\import Logic.Meta
\import Meta
\import Operations
\import Order.Lattice
\import Order.Lattice.CompleteLattice
\import Order.PartialOrder
\import Paths
\import Set.Set
\import Topology.Locale
\import Topology.Locale.LocaleProduct
\import Topology.Locale.PreorderSite
\open ProductLocale
\open Cover
\open CompleteLattice
\open Locale (<=<w)

\func IsHausdorffLocale (L : Locale)
  => \Pi (a b : L) (U : Set (\Sigma L L)) -> a ∧ b <= SJoin (\lam s => s.1 ∧ s.2) U -> Cover {site} (a,b) (\lam s => s.1 ∧ s.2 <= bottom || U s)
  \where {
    \lemma hausdorff-char {L : Locale} : IsHausdorffLocale L <-> localeDiagonal.image.isClosed
      => (\lam Lh {U} => cover-trans* __ \lam {s} (inP (V,V<=U,Vs)) => cover-sub (Lh s.1 s.2 U.1 $ SJoin-cond Vs <=∘ V<=U) \lam {t} => \case \elim __ \with {
        | byLeft e => inP (_, byLeft idp, cover-refl $ inP (SiteLocale.embed t, SJoin-univ (\lam a<=t => coverMap FrameHom.id FrameHom.id a<=t <=∘ SJoin-univ (later \lam {_} (idp) => e)) <=∘ bottom-univ, cover-refl idp))
        | byRight Ut => inP (_, byRight idp, Ut)
      }, \lam Dc a b U ab<=U => cover-trans* (Dc {SiteLocale.closure U} $ cover-refl $ inP (SiteLocale.embed (a,b), SJoin-univ \lam {x} x<=ab => coverMap FrameHom.id FrameHom.id x<=ab <=∘ SJoin-univ (later \lam {_} (idp) => ab<=U <=∘ SJoin-univ \lam {c} Uc => SJoin-cond $ cover-refl Uc), cover-refl idp)) \lam {s} => \case \elim __ \with {
        | inP (_, byLeft idp, sc) => cover-sub sc \lam {t} (inP (V,V<=0,Vt)) => byLeft $ SJoin-cond Vt <=∘ V<=0 <=∘ SJoin-univ \lam c => coverMap FrameHom.id FrameHom.id c <=∘ SJoin-univ (later \case __ \with {
          | inP (_,(),_)
        })
        | inP (_, byRight idp, s<=U) => cover-sub s<=U \lam {u} => byRight
      })
  }

\lemma IsRegular_IsHausdorff {L : Locale} (reg : L.IsRegularLocale) : IsHausdorffLocale L
  => \lam a b U ab<=U =>
    \let | U+ s => s.1 ∧ s.2 <= bottom || U s
         | lem1 {a b : L} (c : Cover {site} (a, a ∧ b) U+) : Cover {site} (a,b) U+
           => cover-trans* (cover-basic $ byLeft  (_, reg a, idp)) $ SetIm-elim $ later \lam {a'} a'<=<a =>
             binCover-right (inv L.top-left =<= L.meet-monotone a'<=<a <=-refl <=∘ L.rdistr>=) (cover-refl $ byLeft $ L.meet-monotone <=-refl meet-left <=∘ L.meet-comm =<= L.<=-eval) (cover-left (<=<_<= a'<=<a, <=-refl) c)
         | lem2 {a b : L} (c : Cover {site} (a ∧ b, b) U+) : Cover {site} (a,b) U+
           => cover-trans* (cover-basic $ byRight (_, reg b, idp)) $ SetIm-elim $ later \lam {b'} b'<=<b =>
             binCover-left (inv L.top-right =<= L.meet-monotone <=-refl b'<=<b <=∘ ldistr>=) (cover-refl $ byLeft $ L.meet-monotone meet-right <=-refl <=∘ L.<=-eval) (cover-left (<=-refl, <=<_<= b'<=<b) c)
    \in lem1 $ cover-trans* (cover-basic $ byRight (_, ab<=U, idp)) $ SetIm-elim $ SetIm-elim \lam {u} Uu =>
        lem2 $ cover-inj (meet-right <=∘ meet-left, meet-right) (byRight Uu)

\type IsWeaklyHausdorff (L : Locale)
  => (localeDiagonal {L}).IsWeaklyClosed

-- | The basic open of `L x L` generated by the pair `(a,y)`.
\private \func emb {L : Locale} (a y : L) : ProductLocale L L
  => SiteLocale.embed {site} (a,y)

-- | `sec a W` is the largest `y` with `emb a y <= W`: right adjoint to `emb a`.
\private \func sec {L : Locale} (a : L) (W : ProductLocale L L) : L
  => L.Join \lam y => W.1 (a,y)

\private \lemma sec-mem {L : Locale} (a : L) (W : ProductLocale L L) : W.1 (a, sec a W)
  => W.2 $ cover-trans* (cover-basic $ byRight (\lam y => W.1 (a,y), <=-refl, idp)) $
      SetIm-elim $ later \lam Wy => cover-refl Wy

\private \lemma emb_sec {L : Locale} {a y : L} {W : ProductLocale L L}
  : emb a y <= W <-> y L.<= sec a W
  => (\lam p => L.Join-cond (p $ cover-refl idp),
      \lam p => SiteLocale.embed-univ $ W.2 $ cover-inj (later (<=-refl, p)) (sec-mem a W))

-- | The counit of `emb a -| sec a`.
\private \lemma emb_sec-counit {L : Locale} {a : L} {W : ProductLocale L L} : emb a (sec a W) <= W
  => emb_sec.2 <=-refl

\private \lemma emb-mono {L : Locale} {a y y' : L} (p : y L.<= y') : emb a y <= emb a y'
  => SiteLocale.closure-univ $ later \lam {_} (idp) => cover-inj (later (<=-refl, p)) idp

\private \lemma emb-meet {L : Locale} {a y y' : L} : emb a y ∧ emb a y' <= emb a (y ∧ y')
  => \lam (c1,c2) => cover-refine (cover-inter c1 c2) $
      later \lam (inP (_,idp,_,idp,eu,ev)) => inP (_, idp, (eu.1, meet-univ eu.2 ev.2))

\private \lemma sec-mono {L : Locale} {a : L} {W W' : ProductLocale L L} (p : W <= W')
  : sec a W L.<= sec a W'
  => emb_sec.1 (emb_sec-counit <=∘ p)

-- | Transporting a nucleus on `L x L` to one on `L` along the adjunction `emb a -| sec a`.
\private \func kn {L : Locale} (a : L) (j : Nucleus (ProductLocale L L)) : Nucleus L \cowith
  | nucleus y => sec a (j (emb a y))
  | nucleus-<= p => sec-mono (j.nucleus-<= (emb-mono p))
  | nucleus-unit => emb_sec.1 j.nucleus-unit
  | nucleus-meet>= => emb_sec.1 $
      meet-univ (emb-mono meet-left) (emb-mono meet-right) <=∘
      (ProductLocale L L).meet-monotone emb_sec-counit emb_sec-counit <=∘
      j.nucleus-meet>= <=∘ j.nucleus-<= emb-meet
  | nucleus-join>= => emb_sec.1 $ emb_sec-counit <=∘ j.nucleus-univ emb_sec-counit

-- | A nucleus absorbs a meet on one side: `j X /\ Y <= j (X /\ Y)`.
\private \lemma nucleus-meet-left {L : Locale} {j : Nucleus L} {X Y : L} : j X ∧ Y L.<= j (X ∧ Y)
  => L.meet-monotone <=-refl j.nucleus-unit <=∘ j.nucleus-meet>=

-- | `pHat P` meets are governed by `P` alone.
\private \lemma pHat-meet-univ {L : Locale} {P : \Prop} {W V : L} (f : P -> W L.<= V)
  : L.pHat P ∧ W <= V
  => L.Join-rdistr>= <=∘ SJoin-univ \lam p => meet-right <=∘ f p

-- | The diagonal sends the basic open `(a,y)` into `a /\ y`.
\private \lemma diag_emb {L : Locale} {a y : L} : localeDiagonal (emb a y) L.<= a ∧ y
  => SJoin-univ \lam c => coverMap FrameHom.id FrameHom.id c <=∘
      SJoin-univ (later \lam {_} (idp) => <=-refl)

-- | `a <=<w x` implies `a <= x`.
\private \lemma wbelow_<= {L : Locale} {a x : L} (w : a L.<=<w x) : a L.<= x
  => meet-univ top-univ <=-refl <=∘ L.<=-uncurry
      (L.<=-curry meet-right <=∘ w {x} <=∘ NucleusFrame.wclosure_<= {L.open a} {x})

-- | The transported nucleus dominates `open a'` on propositions, so `a' <=<w a` applies to it.
\private \lemma wbelow-kn {L : Locale} {a' a : L} {j : Nucleus (ProductLocale L L)}
  (H : \Pi {P : \Prop} {x : ProductLocale L L} -> localeDiagonal x L.<= L.pHat P -> x <= j ((ProductLocale L L).pHat P))
  (w : a' L.<=<w a) {y : L} : a L.--> y L.<= kn a' j y
  => w {y} <=∘ SMeet-cond {_} {_} {_} {_} {kn a' j} (later \lam {P} {z} h =>
       \have | h' : z L.<= a' L.--> L.pHat P
                 => L.<=-curry meet-left <=∘ h <=∘ =_<= (L.open a').locale_pHat
             | az : a' ∧ z L.<= L.pHat P => L.meet-comm =<= L.<=-uncurry h'
             | d1 : emb a' z <= j ((ProductLocale L L).pHat P) => H $ diag_emb <=∘ az
             | d2 : (ProductLocale L L).pHat P ∧ emb a' z <= emb a' (L.pHat P)
                 => pHat-meet-univ \lam p => emb-mono (L.Join-cond p)
       \in emb_sec.1 $ meet-univ d1 <=-refl <=∘
             nucleus-meet-left {ProductLocale L L} {j} {(ProductLocale L L).pHat P} {emb a' z} <=∘
             j.nucleus-<= d2)

\private \lemma emb-mono1 {L : Locale} {a a' y : L} (p : a L.<= a') : emb a y <= emb a' y
  => SiteLocale.closure-univ $ later \lam {_} (idp) => cover-inj (later (p, <=-refl)) idp

-- | Covering the first coordinate of a basic open.
\private \lemma emb-cover1 {L : Locale} {a y : L} {C : L -> \Prop} (p : a L.<= L.Join C)
  : emb a y <= (ProductLocale L L).SJoin (\lam c => emb c y) C
  => SiteLocale.closure-univ $ later \lam {_} (idp) =>
      cover-trans* (cover-basic $ byLeft (C, p, idp)) $
      SetIm-elim $ later \lam Cc => cover-refl $ inP (emb _ y, SetIm-con Cc, cover-refl idp)

-- | Covering the second coordinate of a basic open.
\private \lemma emb-cover2 {L : Locale} {a y : L} {C : L -> \Prop} (p : y L.<= L.Join C)
  : emb a y <= (ProductLocale L L).SJoin (\lam c => emb a c) C
  => SiteLocale.closure-univ $ later \lam {_} (idp) =>
      cover-trans* (cover-basic $ byRight (C, p, idp)) $
      SetIm-elim $ later \lam Cc => cover-refl $ inP (emb a _, SetIm-con Cc, cover-refl idp)

-- | The mirror of `sec`: largest first coordinate.
\private \func sec1 {L : Locale} (y : L) (W : ProductLocale L L) : L
  => L.Join \lam a => W.1 (a,y)

\private \lemma sec1-mem {L : Locale} (y : L) (W : ProductLocale L L) : W.1 (sec1 y W, y)
  => W.2 $ cover-trans* (cover-basic $ byLeft (\lam a => W.1 (a,y), <=-refl, idp)) $
      SetIm-elim $ later \lam Wa => cover-refl Wa

\private \lemma emb_sec1 {L : Locale} {a y : L} {W : ProductLocale L L}
  : emb a y <= W <-> a L.<= sec1 y W
  => (\lam p => L.Join-cond (p $ cover-refl idp),
      \lam p => SiteLocale.embed-univ $ W.2 $ cover-inj (later (p, <=-refl)) (sec1-mem y W))

\private \lemma emb_sec1-counit {L : Locale} {y : L} {W : ProductLocale L L} : emb (sec1 y W) y <= W
  => emb_sec1.2 <=-refl

\private \lemma emb-meet1 {L : Locale} {a a' y : L} : emb a y ∧ emb a' y <= emb (a ∧ a') y
  => \lam (c1,c2) => cover-refine (cover-inter c1 c2) $
      later \lam (inP (_,idp,_,idp,eu,ev)) => inP (_, idp, (meet-univ eu.1 ev.1, eu.2))

\private \lemma sec1-mono {L : Locale} {y : L} {W W' : ProductLocale L L} (p : W <= W')
  : sec1 y W L.<= sec1 y W'
  => emb_sec1.1 (emb_sec1-counit <=∘ p)

\private \func kn1 {L : Locale} (y : L) (j : Nucleus (ProductLocale L L)) : Nucleus L \cowith
  | nucleus a => sec1 y (j (emb a y))
  | nucleus-<= p => sec1-mono (j.nucleus-<= (emb-mono1 p))
  | nucleus-unit => emb_sec1.1 j.nucleus-unit
  | nucleus-meet>= => emb_sec1.1 $
      meet-univ (emb-mono1 meet-left) (emb-mono1 meet-right) <=∘
      (ProductLocale L L).meet-monotone emb_sec1-counit emb_sec1-counit <=∘
      j.nucleus-meet>= <=∘ j.nucleus-<= emb-meet1
  | nucleus-join>= => emb_sec1.1 $ emb_sec1-counit <=∘ j.nucleus-univ emb_sec1-counit

\private \lemma wbelow-kn1 {L : Locale} {b' b : L} {j : Nucleus (ProductLocale L L)}
  (H : \Pi {P : \Prop} {x : ProductLocale L L} -> localeDiagonal x L.<= L.pHat P -> x <= j ((ProductLocale L L).pHat P))
  (w : b' L.<=<w b) {y : L} : b L.--> y L.<= kn1 b' j y
  => w {y} <=∘ SMeet-cond {_} {_} {_} {_} {kn1 b' j} (later \lam {P} {z} h =>
       \have | h' : z L.<= b' L.--> L.pHat P
                 => L.<=-curry meet-left <=∘ h <=∘ =_<= (L.open b').locale_pHat
             | az : z ∧ b' L.<= L.pHat P => L.<=-uncurry h'
             | d1 : emb z b' <= j ((ProductLocale L L).pHat P) => H $ diag_emb <=∘ az
             | d2 : (ProductLocale L L).pHat P ∧ emb z b' <= emb (L.pHat P) b'
                 => pHat-meet-univ \lam p => emb-mono1 (L.Join-cond p)
       \in emb_sec1.1 $ meet-univ d1 <=-refl <=∘
             nucleus-meet-left {ProductLocale L L} {j} {(ProductLocale L L).pHat P} {emb z b'} <=∘
             j.nucleus-<= d2)

-- | Weak regularity in the second coordinate: shrinking `a` to `a /\ b` is enough.
\private \lemma wlem2 {L : Locale} (reg : L.IsWeaklyRegularLocale) {a b : L}
  {j : Nucleus (ProductLocale L L)} {U : ProductLocale L L}
  (H : \Pi {P : \Prop} {x : ProductLocale L L} -> localeDiagonal x L.<= L.pHat P -> x <= j ((ProductLocale L L).pHat P))
  (h : emb (a ∧ b) b <= j U) : emb a b <= j U
  => emb-cover2 (reg b) <=∘ (ProductLocale L L).SJoin-univ (later \lam {b'} w =>
       \have | ab : a ∧ b L.<= sec1 b' (j U) => emb_sec1.1 (emb-mono (wbelow_<= w) <=∘ h)
             | fix : b L.--> sec1 b' (j U) L.<= sec1 b' (j U)
                 => wbelow-kn1 H w <=∘ sec1-mono (j.nucleus-univ emb_sec1-counit)
       \in emb_sec1.2 $ L.<=-curry ab <=∘ fix)

-- | Weak regularity in the first coordinate: shrinking `b` to `a /\ b` is enough.
\private \lemma wlem1 {L : Locale} (reg : L.IsWeaklyRegularLocale) {a b : L}
  {j : Nucleus (ProductLocale L L)} {U : ProductLocale L L}
  (H : \Pi {P : \Prop} {x : ProductLocale L L} -> localeDiagonal x L.<= L.pHat P -> x <= j ((ProductLocale L L).pHat P))
  (h : emb a (a ∧ b) <= j U) : emb a b <= j U
  => emb-cover1 (reg a) <=∘ (ProductLocale L L).SJoin-univ (later \lam {a'} w =>
       \have | ab : a ∧ b L.<= sec a' (j U) => emb_sec.1 (emb-mono1 (wbelow_<= w) <=∘ h)
             | fix : a L.--> sec a' (j U) L.<= sec a' (j U)
                 => wbelow-kn H w <=∘ sec-mono (j.nucleus-univ emb_sec-counit)
       \in emb_sec.2 $ L.<=-curry (L.meet-comm =<= ab) <=∘ fix)

-- | The heart of [4, Corollary 3.4]: a pair whose meet is under the diagonal image of `U`
-- | already lies in every nucleus `j` that dominates the diagonal on propositions.
\private \lemma core {L : Locale} (reg : L.IsWeaklyRegularLocale) {a b : L}
  {j : Nucleus (ProductLocale L L)} {U : ProductLocale L L}
  (H : \Pi {P : \Prop} {x : ProductLocale L L} -> localeDiagonal x L.<= L.pHat P -> x <= j ((ProductLocale L L).pHat P))
  (h : a ∧ b L.<= localeDiagonal U) : emb a b <= j U
  => wlem1 reg H $ emb-cover2 h <=∘ (ProductLocale L L).SJoin-univ
      (\lam {c} m => SetIm-elim {_} {_} {\lam c => emb a c <= j U} (later \lam {t} Ut => wlem2 reg H $
         emb-mono1 (meet-right <=∘ meet-left) <=∘ emb-mono meet-right <=∘
         SiteLocale.embed-univ Ut <=∘ j.nucleus-unit) m)

-- | A weakly regular locale is weakly Hausdorff
\lemma wregular_wHausdorff {L : Locale} (reg : L.IsWeaklyRegularLocale) : IsWeaklyHausdorff L
  => (diag-surj, \lam j H {U} => (ProductLocale L L).Join-univ
        (later \lam {V} dV<=dU {s} Vs => core reg H (SJoin-cond Vs <=∘ dV<=dU) (cover-refl idp)))
  -- [4, Corollary 3.4]
  \where {
    -- | The diagonal is a split epi of frames, hence surjective.
    \lemma diag-surj {L : Locale} : IsSurj (localeDiagonal {L}).func
      => \lam x => inP (proj1 x, pmap {LocaleHom L L} (FrameHom.func {__} x) beta1)
  }
