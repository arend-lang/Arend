{- | Powers and signed powers as linearly bounded maps, used by the pointwise inequalities of the functional calculus.

  * {absPow}: `|x|^p` for `p ≥ 1`.
  * {signedPowLB}: $\varphi_r(t) = t|t|^{r-2}$ for `r ≥ 2`.
  * {signedPowCutLB}: the linearization $\varphi_{r,a}$ of $\varphi_r$ near `0` for `1 < r ≤ 2`.
  * {signedPowMul}: $\varphi_r(x_1) x_2$ for `r > 1`.

  The product $x_1 x_2$ is {LinBoundedMap.mul} of two coordinates, and $x_1 \psi_n(x_2)$ is {LinBoundedMap.mulInvJoin}.
-}

\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Arith.Real
\import Arith.Real.Field
\import Arith.Real.Power
\import Arith.Real.SignedPow
\import Logic
\import Order.Biordered
\import Order.Lattice
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Topology.CoverSpace.Complete
\import Topology.CoverSpace.Product
\import Topology.NormedAbGroup.Real
\import Topology.NormedAbGroup.Real.Functions
\import Topology.NormedAbGroup.Real.LinBounded
\import Topology.TopAbGroup
\open LatticeAbGroup (abs)

-- | `x ↦ |x|^p` for `p ≥ 1`.
\lemma absPow {p : Real} (p>0 : (0 : Real) < p) (p>=1 : (1 : Real) <= p) : LinBoundedMap 1 (\lam x => rpow (abs (x 0)) RealAbGroup.abs>=0 p p>0)
  => LinBoundedMap.makeLocal (rpow-coverMap (real-join-uniform CoverMap.∘ ProductCoverSpace.tuple (LinBoundedMap.coord 0) (negative-uniform {RealNormed} CoverMap.∘ LinBoundedMap.coord 0))
                                            (\lam _ => RealAbGroup.abs>=0) p>0) (LinBoundedMap.coord 0 :: nil) \lam R =>
      \have R1>0 : (0 : Real) < R ∨ 1 => RealField.zro<ide <∘l join-right
      \in inP (rpow-pos (R ∨ 1) R1>0 (p - 1), <=-less rpow-pos>0, \lam x xR =>
            =_<= (RealAbGroup.abs-ofPos rpow>=0) <=∘ rpow-lin-bound p>=1 R1>0 (xR 0 <=∘ join-left) <=∘ =_<= (pmap (_ *) (inv zro-right)))

-- | $\varphi_r(t) = t|t|^{r-2}$ for `r ≥ 2`.
\lemma signedPowLB {r : Real} (r>1 : (1 : Real) < r) (r>=2 : (2 : Real) <= r) : LinBoundedMap 1 (\lam x => signedPow r>1 (x 0))
  => LinBoundedMap.makeLocal (signedPow-cover r>1 CoverMap.∘ LinBoundedMap.coord 0) (LinBoundedMap.coord 0 :: nil) \lam R =>
      \have R1>0 : (0 : Real) < R ∨ 1 => RealField.zro<ide <∘l join-right
      \in inP (rpow-pos (R ∨ 1) R1>0 (r - 1 - 1), <=-less rpow-pos>0, \lam x xR =>
            =_<= signedPow-abs <=∘ rpow-lin-bound (linarith : (1 : Real) <= r - 1) R1>0 (xR 0 <=∘ join-left) <=∘ =_<= (pmap (_ *) (inv zro-right)))

-- | $\varphi_{r,a}$ (see {signedPow-cut}) for `1 < r ≤ 2` and `a > 0`.
\lemma signedPowCutLB {r : Real} (r>1 : (1 : Real) < r) (r<=2 : r <= 2) {a : Real} (a>0 : (0 : Real) < a)
  : LinBoundedMap 1 (\lam x => signedPow-cut r>1 a>0 (x 0))
  => LinBoundedMap.make1 (signedPow-cut-cover r>1 a>0 CoverMap.∘ LinBoundedMap.coord 0) (LinBoundedMap.coord 0) (<=-less rpow-pos>0) (\lam x => signedPow-cut-lin r<=2)

-- | $\varphi_r(x_1) x_2$ for `r > 1`.
\lemma signedPowMul {r : Real} (r>1 : (1 : Real) < r) : LinBoundedMap 2 (\lam x => signedPow r>1 (x 0) * x 1)
  => LinBoundedMap.mulBounded (signedPow-cover r>1 CoverMap.∘ LinBoundedMap.coord {2} 0)
      (\lam R => inP (rpow (R ∨ 0) join-right (r - 1) (signedPow.sub1>0 r>1), \lam x xR => signedPow-local-bound (xR 0))) (LinBoundedMap.coord 1)