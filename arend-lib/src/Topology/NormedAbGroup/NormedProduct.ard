\import Algebra.Group.Product
\import Algebra.Meta
\import Arith.Real
\import Arith.Real.Field
\import Data.Array
\import Function.Meta
\import Order.PartialOrder
\import Paths
\import Topology.Compact
\import Topology.MetricSpace
\import Topology.MetricSpace.ManhattanProduct
\import Topology.NormedAbGroup
\import Topology.NormedAbGroup.Real
\import Topology.NormedAbGroup.Real.Compact

-- | The product of normed groups with the sum of the norms.
\instance ProductPseudoNormedAbGroup (A B : PseudoNormedAbGroup) : PseudoNormedAbGroup (\Sigma A B)
  | PseudoMetricSpace => ManhattanMetricSpace A B
  | AbGroup => ProductAbGroup A B
  | norm s => A.norm s.1 RealAbGroup.+ B.norm s.2
  | norm-dist => Real.=-upper.1 (pmap2 (RealAbGroup.+) lnorm-ldist lnorm-ldist)

-- | The product of normed groups with the sum of the norms.
\instance ProductNormedAbGroup (A B : NormedAbGroup) : NormedAbGroup (\Sigma A B)
  | PseudoNormedAbGroup => ProductPseudoNormedAbGroup A B
  | norm-ext {x} p =>
    \have | s : lnorm x.1 RealAbGroup.+ lnorm x.2 = RealAbGroup.zro => (Real.=-upper {_} {RealAbGroup.zro}).2 p
          | a>=0 : RealAbGroup.zro <= lnorm x.1 => lnorm>=0
          | b>=0 : RealAbGroup.zro <= lnorm x.2 => lnorm>=0
          | a=0 : lnorm x.1 = RealAbGroup.zro => <=-antisymmetric linarith a>=0
          | b=0 : lnorm x.2 = RealAbGroup.zro => <=-antisymmetric linarith b>=0
    \in pmap2 (__,__) (A.norm-ext (Real.=-upper.1 a=0)) (B.norm-ext (Real.=-upper.1 b=0))

-- | The zero normed group.
\instance UnitNormedAbGroup : CompleteNormedAbGroup (\Sigma)
  | CompleteMetricSpace => UnitMetricSpace
  | zro => ()
  | + _ _ => ()
  | negative _ => ()
  | zro-left => idp
  | zro-right => idp
  | +-assoc => idp
  | +-comm => idp
  | negative-left => idp
  | norm _ => 0
  | norm-dist => idp
  | norm-ext _ => idp

-- | The product of `n` copies of a normed group with the sum of the norms.
\instance ArrayPseudoNormedAbGroup (n : Nat) (A : PseudoNormedAbGroup) : PseudoNormedAbGroup (Array A n)
  | PseudoMetricSpace => ManhattanArrayMetricSpace n A
  | AbGroup => ArrayAbGroup n A
  | norm x => RealAbGroup.BigSum (\lam j => A.norm (x j))
  | norm-dist => Real.=-upper.1 (RealAbGroup.BigSum-ext \lam j => lnorm-ldist)

-- | The product of `n` copies of a normed group with the sum of the norms.
\instance ArrayNormedAbGroup (n : Nat) (A : NormedAbGroup) : NormedAbGroup (Array A n)
  | PseudoNormedAbGroup => ArrayPseudoNormedAbGroup n A
  | norm-ext {x} p => arrayExt {_} {_} {x} {\lam _ => A.zro} \lam j => A.norm-ext $ Real.=-upper.1 $ RealAbGroup.BigSum_>=0-zero {\lam j => lnorm (x j)} (\lam j => lnorm>=0) ((Real.=-upper {_} {RealAbGroup.zro}).2 p) j

\lemma array-lnorm-init {n : Nat} {A : PseudoNormedAbGroup} {x : Array A (suc n)} : lnorm x = lnorm (initA x) RealAbGroup.+ lnorm (lastA x)
  => RealAbGroup.BigSum_init {_} {\lam j => A.norm (x j)}

\lemma array-ldist-init {n : Nat} {A : PseudoNormedAbGroup} {x y : Array A (suc n)}
  : ldist {ArrayPseudoNormedAbGroup (suc n) A} x y = ldist {ArrayPseudoNormedAbGroup n A} (initA x) (initA y) RealAbGroup.+ ldist (lastA x) (lastA y)
  => RealAbGroup.BigSum_init {_} {\lam j => A.dist (x j) (y j)}

-- | The space `ℝⁿ`.
\func RealN (n : Nat) : NormedAbGroup (Array Real n)
  => ArrayNormedAbGroup n RealNormed

-- | Balls of `ℝⁿ` are totally bounded.
\lemma RealN-ballsTB (n : Nat) : BallsTotallyBounded (RealN n)
  => array-ballsTB real-bounded-tb n

-- | Cover maps out of `ℝⁿ` are uniform on bounded sets.
\lemma RealN-locallyUniform (n : Nat) : IsLocallyUniformSpace (RealN n)
  => metric-locallyUniform (RealN-ballsTB n)