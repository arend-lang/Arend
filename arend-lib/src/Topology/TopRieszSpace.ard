\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered.RieszSpace
\import Algebra.Ordered.TruncRieszSpace
\import Arith.Int
\import Arith.Nat
\import Arith.Rat
\import Function.Meta
\import Logic
\import Logic.Meta
\import Meta
\import Order.Directed
\import Order.PartialOrder
\import Paths
\import Paths.Meta
\import Set.Set
\import Topology.CoverSpace
\import Topology.CoverSpace.Complete
\import Topology.CoverSpace.Product
\import Topology.TopAbGroup
\import Topology.TopAbGroup.Product
\import Topology.TopSpace
\import Topology.UniformSpace
\import Topology.UniformSpace.Product

\class TopRieszSpace \extends TopAbGroup, RieszSpace {
  | solid-neighborhood {U : Set E} : single 0 <=< U -> ∃ (V : IsSolid) (single 0 <=< V) (V ⊆ U)

  \lemma abs-uniform : UniformMap \this \this abs \cowith
    | func-uniform Eu => \case ab-neighborhood-uniform.1 Eu \with {
      | inP (V,Vo,V0,h) => \case solid-neighborhood (open-char.1 Vo V0) \with {
        | inP (U,US,U0,U<=V) => ab-neighborhood-uniform.2 $ inP (_, interior, U0, \lam x => \case h (abs x) \with {
          | inP (W,EW,g) => inP (_, inP $ later (W,EW,idp), \lam Uxy => g (U<=V $ US (<=<_<= Uxy idp) $ abs-univ abs_-left abs_-right))
        })
      }
    }

  \protected \lemma *q-right-uniform {q : Rat} : TopAbGroupMap \this \this (q *q) \cowith
    | func-+ => toRatModule.*c-ldistr
    | func-uniform Eu =>
      \have cu => *i-uniform ∘ *q_<=1-right-uniform (RatField.finv>=0 fromNat_>=0) (RatField.finv_<= idp $ fromInt_<= $ pos<=pos $ suc_<_<= $ nonZero>0 ratDenom/=0)
      \in uniform-subset (cu.func-uniform Eu) \lam t => TruncP.map t \lam s => later (s.1, s.2, s.3 *> ext \lam x => pmap s.1 $ inv *q_*i *> inv *q-assoc *> pmap (*q x) (inv rat-split))
    \where {
      \private \lemma *q_<=1-right-uniform {q : Rat} (q>=0 : RatField.zro RatField.<= q) (q<=1 : q RatField.<= 1) : TopAbGroupMap \this \this (q *q) \cowith
        | func-+ => toRatModule.*c-ldistr
        | func-uniform Eu => \case ab-neighborhood-uniform.1 Eu \with {
          | inP (V,Vo,V0,h) => \case solid-neighborhood (open-char.1 Vo V0) \with {
            | inP (U,US,U0,U<=V) => ab-neighborhood-uniform.2 $ inP (_, interior, U0, \lam x => \case h (q *q x) \with {
              | inP (W,EW,g) => inP (_, inP $ later (W,EW,idp), \lam Uxy => g (U<=V $ transport U toRatModule.*c-ldistr_- $ US (<=<_<= Uxy idp) $ abs_*q>=0 q>=0 =<= <=_*q-left q<=1 abs>=0 <=∘ =_<= ide_*q))
            })
          }
        }
    }

  \lemma join-uniform : UniformMap (ProductTopAbGroup \this \this) \this (\lam s => s.1 ∨ s.2)
    => transportInv (UniformMap _ _) (later $ ext \lam s => join_abs) $ *q-right-uniform ∘ +-uniform ∘ tuple +-uniform (abs-uniform ∘ subtract-uniform)

  \lemma meet-uniform : UniformMap (ProductTopAbGroup \this \this) \this (\lam s => s.1 ∧ s.2)
    => transportInv (UniformMap _ _) (later $ ext \lam s => meet_abs) $ *q-right-uniform ∘ subtract-uniform ∘ tuple +-uniform (abs-uniform ∘ subtract-uniform)
} \where {
  \open UniformMap (∘)
  \open ProductUniformSpace
}

-- | Clipping to `[-s,s]` is uniformly continuous.
\lemma clip-cover {E : TopRieszSpace} (s : E) : CoverMap E E (E.clip s)
  => E.join-uniform CoverMap.∘ ProductCoverSpace.tuple (E.meet-uniform CoverMap.∘ ProductCoverSpace.tuple CoverMap.id (CoverMap.const s)) (CoverMap.const (negative s))

-- | If clipping by `s n` eventually fixes every element of a dense set, then $\mathrm{clip}_{s_n}(y) \to y$ for every {y}.
\lemma clip-limit {E : TopRieszSpace} {S : Set E} (Sd : IsDenseSet S) {I : DirectedSet} (s : I -> E)
                  (ev : \Pi {x : E} -> S x -> ∃ (N : I) ∀ {n} (N <= n -> E.clip (s n) x = x)) (y : E)
  : E.IsLimit (\lam n => E.clip (s n) y) y
  => \lam {U} Uo Uy => \case E.shrink2 (E.UBall-open Uo {y}) (E.UBall-point {U} Uy) \with {
    | inP (W,Wo,W0,_,Wadd) => \case E.solid-neighborhood (E.open-char.1 Wo W0) \with {
      | inP (V,Vs,V0,V<=W) => \case Sd {y} (E.UBall-open (CoverSpace.interior {E} {V}) {y}) (E.UBall-center {\lam z => single z <=< V} V0 {y}) \with {
        | inP (x,Sx,yx) => \case ev Sx \with {
          | inP (N,g) => inP (N, \lam {n} N<=n =>
            \have | Vyx : V (y - x) => <=<_<= yx idp
                   | Vc : V (E.clip (s n) x - E.clip (s n) y) => Vs Vyx (E.clip-lip <=∘ =_<= E.abs_-)
                   | e : y - x + (E.clip (s n) x - E.clip (s n) y) = y - E.clip (s n) y
                       => pmap (\lam z => y - x + (z - E.clip (s n) y)) (g N<=n) *> equation.abGroup
            \in transport U (pmap (y -) e *> equation.abGroup) (Wadd (V<=W Vyx) (V<=W Vc)))
        }
      }
    }
  }

\record TopRieszSpaceMap \extends TopAbGroupMap, RieszSpaceHom {
  \override Dom : TopRieszSpace
  \override Cod : TopRieszSpace
}

-- | A topological Riesz space with a truncation; the truncation is automatically uniformly continuous.
\class TopTruncRieszSpace \extends TopRieszSpace, TruncRieszSpace {
  \lemma trunc-uniform : UniformMap \this \this trunc \cowith
    | func-uniform Eu => \case ab-neighborhood-uniform.1 Eu \with {
      | inP (V,Vo,V0,h) => \case solid-neighborhood (open-char.1 Vo V0) \with {
        | inP (U,US,U0,U<=V) => ab-neighborhood-uniform.2 $ inP (_, interior, U0, \lam x => \case h (trunc x) \with {
          | inP (W,EW,g) => inP (_, inP $ later (W,EW,idp), \lam Uxy => g (U<=V $ US (<=<_<= Uxy idp) trunc-lipschitz))
        })
      }
    }
}

\record TopTruncRieszSpaceMap \extends TopRieszSpaceMap, TruncRieszSpaceHom {
  \override Dom : TopTruncRieszSpace
  \override Cod : TopTruncRieszSpace
}

-- | A complete topological truncated Riesz space.
\class CompleteTopTruncRieszGroup \extends CompleteTopAbGroup, TopTruncRieszSpace