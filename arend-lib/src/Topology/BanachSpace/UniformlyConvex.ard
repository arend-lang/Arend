{- | Uniformly convex Banach spaces.

  * {IsUniformlyConvex}: for every $\varepsilon > 0$ there is $\delta > 0$ such that $\|u\|, \|v\| \le 1$ and
    $\|(u+v)/2\| \ge 1 - \delta$ imply $\|u - v\| < \varepsilon$.
  * {normable-attained}: in a uniformly convex space, a functional with $\sup_{\|u\| < 1} |\Lambda u| = 1$ attains its
    norm: $\Lambda u_0 = 1$ for some $\|u_0\| \le 1$. The sets $S_\delta = \{u \mid \|u\| < 1, \Lambda u > 1 - \delta\}$
    generate a Cauchy filter.
-}

\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Pointed
\import Algebra.QModule
\import Arith.Rat
\import Arith.Real
\import Arith.Real.Field
\import Arith.Real.UpperReal
\import Logic
\import Logic.Meta
\import Order.Biordered
\import Order.Lattice
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Set.Filter
\import Topology.BanachSpace
\import Topology.BanachSpace.Dual
\import Topology.NormedAbGroup
\open QModule (*q)

-- | Uniform convexity.
\type IsUniformlyConvex (E : RealBanachSpace) : \Prop
  => ∀ {eps} (0 < eps) ∃ (delta : Rat) (0 < delta) ∀ {u v : E} (norm u <= 1) (norm v <= 1)
        (ExUpperReal.fromRat (1 - delta) <= norm (ratio 1 2 *q (u + v)) -> (norm (u - v)).U eps)

-- | A normable functional of norm 1 on a uniformly convex space attains its norm.
\lemma normable-attained {E : RealBanachSpace} (uc : IsUniformlyConvex E) {f : BoundedFunctional E} (fs : IsFunctionalSup f (1 : Real))
  : ∃ (u : E) (norm u <= ExUpperReal.fromRat 1) (f u = (1 : Real))
  => \case E.isCompleteMetric (attainFilter fs) (\lam {eps} eps>0 => \case uc eps>0 \with {
       | inP (delta,delta>0,h) => \case S-inh fs delta>0 \with {
         | inP (x,Sx) => inP (x, inP (delta, delta>0, \lam {y} Sy => transportInv (\lam (z : ExUpperReal) => z.U eps) norm-dist (h (unit-le Sx.1) (unit-le Sy.1) (mid-lower fs Sx Sy))))
       }
     }) \with {
    | inP (u0,h) => inP (u0, \lam {c} c>1 =>
        \let eps => (c - 1) RatField.* ratio 1 2
        \in \have eps>0 : 0 RatField.< eps => linarith
        \in \case h eps>0 \with {
          | inP (delta,delta>0,q) => \case S-inh fs delta>0 \with {
            | inP (y,Sy) =>
              \have | d : (norm (u0 - y)).U eps => transport (\lam (z : ExUpperReal) => z.U eps) norm-dist (q Sy)
                    | t : (norm (u0 - y) ExUpperReal.+ norm y).U c => ExUpperReal.+_U.2 (inP (eps, d, 1, Sy.1, linarith))
              \in transport (\lam z => (norm z).U c) (equation.abGroup : u0 - y + y = u0) (norm_+ t)
          }
        }, DualSpace.real-eq-eps \lam {d} d>0 =>
        \let d2 => d RatField.* ratio 1 2
        \in \have d2>0 : 0 RatField.< d2 => linarith
        \in \case h d2>0 \with {
          | inP (delta,delta>0,q) => \case S-inh fs (<_meet-univ delta>0 d2>0) \with {
            | inP (y,Sy) =>
              \have | n : (norm (u0 - y)).U d2 => transport (\lam (z : ExUpperReal) => z.U d2) norm-dist (q (S-mono meet-left Sy))
                    | b1 : RealAbGroup.abs (f (u0 - y)) <= (1 : Real) * Real.fromRat d2 => fs.1 n
                    | b2 : RealAbGroup.abs (f y) <= (1 : Real) * Real.fromRat 1 => fs.1 Sy.1
                    | ly : Real.fromRat ((1 : Rat) - d2) < f y => (S-mono meet-right Sy).2
                    | e1 : f (u0 - y) = f u0 - f y => f.toAddGroupHom.func-minus
                    | e2 : Real.fromRat ((1 : Rat) - d2) = (1 : Real) - Real.fromRat d2 => inv RealAbGroup.minus-rat
                    | e3 : Real.fromRat d2 + Real.fromRat d2 = Real.fromRat d => RealAbGroup.+-rat *> pmap Real.fromRat linarith
                    | c1 : f u0 - f y <= Real.fromRat d2 => RealAbGroup.abs>=id <=∘ transport (\lam z => RealAbGroup.abs z <= _) e1 b1 <=∘ =_<= RealField.ide-left
                    | c2 : negative (f u0 - f y) <= Real.fromRat d2 => RealAbGroup.abs>=neg <=∘ transport (\lam z => RealAbGroup.abs z <= _) e1 b1 <=∘ =_<= RealField.ide-left
                    | c3 : f y <= (1 : Real) => RealAbGroup.abs>=id <=∘ b2 <=∘ =_<= RealField.ide-left
              \in DualSpace.abs<-of linarith linarith
          }
        })
  }
  \where \private {
    -- | $S_\delta = \{u \mid \|u\| < 1, \Lambda u > 1 - \delta\}$.
    \func S {E : RealBanachSpace} (f : BoundedFunctional E) (delta : Rat) (u : E) : \Prop
      => \Sigma ((norm u).U 1) (Real.fromRat ((1 : Rat) - delta) < f u)

    \lemma S-inh {E : RealBanachSpace} {f : BoundedFunctional E} (fs : IsFunctionalSup f (1 : Real)) {delta : Rat} (delta>0 : 0 RatField.< delta)
      : ∃ (u : E) (S f delta u)
      => \case fs.2 delta>0 \with {
        | inP (x,x1,fx) =>
          \have e : Real.fromRat ((1 : Rat) - delta) = (1 : Real) - Real.fromRat delta => inv RealAbGroup.minus-rat
          \in \case real-join-split (transportInv (__ < _) e fx) \with {
            | byLeft p => inP (x, (x1, p))
            | byRight p => inP (negative x, (transportInv (\lam (z : ExUpperReal) => z.U 1) norm_negative x1, transportInv (_ <) f.toAddGroupHom.func-negative p))
          }
      }

    \lemma real-join-split {a b c : Real} (p : a < b ∨ c) : (a < b) || (a < c)
      => \case real_<-rat-char.1 p \with {
        | inP (q,aq',jq') => \have | aq : a < Real.fromRat q => real_<_U.2 aq'
                                   | qj : Real.fromRat q < b ∨ c => real_<_L.2 jq'
          \in \case RealAbGroup.<-comparison b aq, RealAbGroup.<-comparison c aq \with {
            | byLeft r, _ => byLeft r
            | _, byLeft r => byRight r
            | byRight r1, byRight r2 => absurd (<-irreflexive (qj <∘l join-univ (<=-less r1) (<=-less r2)))
          }
      }

    \lemma unit-le {E : RealBanachSpace} {u : E} (p : (norm u).U 1) : norm u <= ExUpperReal.fromRat 1
      => \lam {c} c>1 => U-closed p c>1

    \lemma mid-lower {E : RealBanachSpace} {f : BoundedFunctional E} (fs : IsFunctionalSup f (1 : Real)) {delta : Rat} {u v : E} (Su : S f delta u) (Sv : S f delta v)
      : ExUpperReal.fromRat ((1 : Rat) - delta) <= norm (ratio 1 2 *q (u + v))
      => \lam {b} wb =>
        \have | t : RealAbGroup.abs (f (ratio 1 2 *q (u + v))) <= (1 : Real) * Real.fromRat b => fs.1 wb
              | ww : ratio 1 2 *q (u + v) + ratio 1 2 *q (u + v) = u + v => inv QModule.*q_*2 *> inv QModule.*q-assoc *> pmap (\lam (r : Rat) => r *q (u + v)) (idp : 2 RatField.* ratio 1 2 = 1) *> QModule.ide_*q
              | fw : f (ratio 1 2 *q (u + v)) + f (ratio 1 2 *q (u + v)) = f u + f v => inv f.func-+ *> pmap f ww *> f.func-+
              | s1 : f (ratio 1 2 *q (u + v)) <= Real.fromRat b => RealAbGroup.abs>=id <=∘ t <=∘ =_<= RealField.ide-left
              | l1 => Su.2
              | l2 => Sv.2
              | r : Real.fromRat ((1 : Rat) - delta) < Real.fromRat b => linarith
        \in rat_real_<.2 r

    \func attainFilter {E : RealBanachSpace} {f : BoundedFunctional E} (fs : IsFunctionalSup f (1 : Real)) : ProperFilter E \cowith
      | F U => ∃ (delta : Rat) (0 RatField.< delta) (\Pi {u : E} -> S f delta u -> U u)
      | filter-mono (inP (d,d>0,q)) p => inP (d, d>0, \lam Su => p (q Su))
      | filter-top => inP (1, RatField.zro<ide, \lam _ => ())
      | filter-meet (inP (d,d>0,q)) (inP (d',d'>0,q')) => inP (d ∧ d', <_meet-univ d>0 d'>0, \lam Su => (q (S-mono meet-left Su), q' (S-mono meet-right Su)))
      | isProper (inP (d,d>0,q)) => \case S-inh fs d>0 \with {
        | inP (u,Su) => inP (u, q Su)
      }

    \lemma S-mono {E : RealBanachSpace} {f : BoundedFunctional E} {d d' : Rat} (dd : d RatField.<= d') {u : E} (Su : S f d u) : S f d' u
      => (Su.1, rat_real_<=.1 (linarith : (1 : Rat) - d' RatField.<= (1 : Rat) - d) <∘r Su.2)
  }
