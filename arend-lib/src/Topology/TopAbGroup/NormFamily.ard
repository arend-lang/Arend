{- | Topological abelian groups defined by directed families of group seminorms.

  * {NormFamilyTopAbGroup}: an abelian group with a directed family of real-valued group seminorms
    (subadditive and symmetric, but not necessarily homogeneous); the topology and the uniformity
    are generated by the balls $\{x \mid n_j(x) < \varepsilon\}$.
  * {NormFamilyRieszSpace}, {NormFamilyTruncRieszSpace}: the same for a (truncated) Riesz space whose seminorms are monotone in `|x|`;
    the balls are solid, so this is a topological Riesz space.
-}

\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Arith.Rat
\import Arith.Real
\import Arith.Real.Field
\import Function.Meta
\import Logic
\import Logic.Meta
\import Order.Biordered
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Set.Set
\import Topology.CoverSpace
\import Topology.NormedAbGroup
\import Topology.NormedAbGroup.Real
\import Topology.TopAbGroup
\import Topology.TopRieszSpace
\import Topology.TopSpace
\import Topology.UniformSpace

-- | An abelian group with the topology of a directed family of group seminorms.
\class NormFamilyTopAbGroup \extends TopAbGroup {
  | NormIndex : \Set
  | normAt : NormIndex -> E -> Real
  | normAt-zro {j : NormIndex} : normAt j 0 = RealAbGroup.zro
  | normAt-negative {j : NormIndex} {x : E} : normAt j (negative x) = normAt j x
  | normAt-+ {j : NormIndex} {x y : E} : normAt j (x + y) RealAbGroup.<= normAt j x RealAbGroup.+ normAt j y
  | normAt-directed (i j : NormIndex) : ∃ (k : NormIndex) (\Pi (x : E) -> \Sigma (normAt i x RealAbGroup.<= normAt k x) (normAt j x RealAbGroup.<= normAt k x))
  | normAt-inh : TruncP NormIndex

  | isOpen U => ∀ {x : U} ∃ (j : NormIndex) (eps : Real) (RealAbGroup.zro < eps) ∀ {y} (normAt j (x - y) < eps -> U y)
  | open-top _ => TruncP.map normAt-inh \lam j => (j, 1, RealAbGroup.zro<ide, \lam _ => ())
  | open-inter Uo Vo (Ux,Vx) => \case Uo Ux, Vo Vx \with {
    | inP (i,eps,eps>0,f), inP (j,delta,delta>0,g) => \case normAt-directed i j \with {
      | inP (k,h) => inP (k, eps RealAbGroup.∧ delta, RealAbGroup.<_meet-univ eps>0 delta>0,
                          \lam d => (f $ (h _).1 <∘r d <∘l RealAbGroup.meet-left, g $ (h _).2 <∘r d <∘l RealAbGroup.meet-right))
    }
  }
  | open-Union So (inP (U,SU,Ux)) => \case So SU Ux \with {
    | inP (j,eps,eps>0,f) => inP (j, eps, eps>0, \lam d => inP (U, SU, f d))
  }
  | +-cont => \new ContMap {
    | func-cont {W} Wo {s} Ws => \case Wo Ws \with {
      | inP (j,eps,eps>0,f) =>
        \have | e2>0 => NormFamilyArith.half>0 eps>0
              | ball-open (z : E) : isOpen (\lam y => normAt j (z - y) < eps * Real.fromRat (ratio 1 2))
                  => \lam {y} d => inP (j, NormFamilyArith.gap (eps * Real.fromRat (ratio 1 2)) (normAt j (z - y)), NormFamilyArith.diff>0 d, \lam {w} d' =>
                       \have t : normAt j (z - w) RealAbGroup.<= normAt j (z - y) RealAbGroup.+ normAt j (y - w)
                               => transportInv (\lam t => normAt j t RealAbGroup.<= normAt j (z - y) RealAbGroup.+ normAt j (y - w)) equation.abGroup normAt-+
                       \in NormFamilyArith.diff-triang t d')
              | ball-center (z : E) : normAt j (z - z) < eps * Real.fromRat (ratio 1 2)
                  => transportInv (`< _) (pmap (normAt j) negative-right *> normAt-zro) e2>0
        \in inP (_, ball-open s.1, ball-center s.1, _, ball-open s.2, ball-center s.2, \lam {x} d {y} d' =>
              f $ transportInv (\lam t => normAt j t RealAbGroup.<= normAt j (s.1 - x) RealAbGroup.+ normAt j (s.2 - y)) equation.abGroup normAt-+ <∘r NormFamilyArith.half-sum d d')
    }
  }
  | negative-cont => \new ContMap {
    | func-cont Uo Ux => \case Uo Ux \with {
      | inP (j,eps,eps>0,f) => inP (j, eps, eps>0, \lam {y} d => f $ transport (`< eps) (inv normAt-negative *> pmap (normAt j) equation.abGroup) d)
    }
  }

  -- | The ball $\{y \mid n_j(x - y) < \varepsilon\}$.
  \func NBall (j : NormIndex) (eps : Real) (x : E) : Set E
    => \lam y => normAt j (x - y) < eps

  \lemma normAt>=0 {j : NormIndex} {x : E} : RealAbGroup.zro RealAbGroup.<= normAt j x
    => NormFamilyArith.double>=0 (transport (RealAbGroup.`<= _) (pmap (normAt j) negative-right *> normAt-zro) normAt-+) normAt-negative

  \lemma normAt-diff {j : NormIndex} {x y z : E} : normAt j (x - z) RealAbGroup.<= normAt j (x - y) RealAbGroup.+ normAt j (y - z)
    => transportInv (normAt j __ RealAbGroup.<= _) equation.abGroup normAt-+

  \lemma NBall-center {j : NormIndex} {eps : Real} (eps>0 : RealAbGroup.zro < eps) {x : E} : NBall j eps x x
    => transportInv (`< eps) (pmap (normAt j) negative-right *> normAt-zro) eps>0

  \lemma NBall-open {j : NormIndex} {eps : Real} {x : E} : isOpen (NBall j eps x)
    => \lam {y} d => inP (j, NormFamilyArith.gap eps (normAt j (x - y)), NormFamilyArith.diff>0 d, \lam {z} d' => NormFamilyArith.diff-triang normAt-diff d')

  -- | The ball $\{y \mid n_j(y) < \varepsilon\}$ around `0` is open.
  \lemma normAt-ball-open {j : NormIndex} {eps : Real} : isOpen (\lam y => normAt j y < eps)
    => transport isOpen (ext \lam y => ext (\lam d => transport (`< eps) (pmap (normAt j) zro-left *> normAt-negative) d,
                                          \lam d => transportInv (`< eps) (pmap (normAt j) zro-left *> normAt-negative) d)) (NBall-open {_} {j} {eps} {0})

  -- | A real-valued map that is Lipschitz for one of the seminorms is uniformly continuous.
  \func normAt-lip-uniform {j : NormIndex} {C : Real} (phi : E -> Real)
    (lip : \Pi (x y : E) -> RealAbGroup.abs ((-) {RealAbGroup} (phi x) (phi y)) RealAbGroup.<= C RealField.* normAt j (x - y))
    : UniformMap \this RealNormed phi
    => addGroup-modulus-uniform phi \lam {eps} eps>0 =>
        inP (_, normAt-ball-open {_} {j} {NormFamilyArith.lipRadius C eps}, transportInv (`< _) normAt-zro (NormFamilyArith.lipRadius>0 eps>0),
             \lam {x} {y} c => real_<_U.1 $ NormFamilyArith.lip-bound normAt>=0 (lip x y)
                 (transport (`< _) (pmap (normAt j) (equation.abGroup : y - x = negative (x - y)) *> normAt-negative) c.2))

  -- | Every neighbourhood of `0` contains a ball around `0`.
  \lemma neighborhood-char {U : Set E} (Uo : isOpen U) (U0 : U 0) : ∃ (j : NormIndex) (eps : Real) (RealAbGroup.zro < eps) ∀ {y} (normAt j y < eps -> U y)
    => \case Uo U0 \with {
      | inP (j,eps,eps>0,f) => inP (j, eps, eps>0, \lam d => f $ transportInv (`< eps) (pmap (normAt j) zro-left *> normAt-negative) d)
    }

  -- | A version of {neighborhood-char} for `single 0 <=< U`.
  \lemma neighborhood-char' {U : Set E} (p : single 0 <=< U) : ∃ (j : NormIndex) (eps : Real) (RealAbGroup.zro < eps) ∀ {y} (normAt j y < eps -> U y)
    => \case neighborhood-char CoverSpace.interior p \with {
      | inP (j,eps,eps>0,f) => inP (j, eps, eps>0, \lam d => <=<_<= (f d) idp)
    }
}

-- | A Riesz space with the topology of a directed family of seminorms that are monotone in `|x|`.
\class NormFamilyRieszSpace \extends NormFamilyTopAbGroup, TopRieszSpace {
  | normAt-abs-mono {j : NormIndex} {x y : E} : abs x <= abs y -> normAt j x RealAbGroup.<= normAt j y
  | solid-neighborhood p => \case neighborhood-char' p \with {
    | inP (j,eps,eps>0,f) =>
      inP (\lam y => normAt j y < eps, \lam d q => normAt-abs-mono q <∘r d,
           open-char.1 normAt-ball-open (transportInv (`< eps) normAt-zro eps>0), \lam {y} d => f d)
  }
}

-- | A truncated Riesz space with the topology of a directed family of seminorms that are monotone in `|x|`.
\class NormFamilyTruncRieszSpace \extends NormFamilyRieszSpace, TopTruncRieszSpace

\private \module NormFamilyArith \where {
  \lemma half>0 {eps : Real} (eps>0 : (0 : Real) < eps) : (0 : Real) < eps * Real.fromRat (ratio 1 2)
    => RealField.<_*_positive_positive eps>0 (rat_real_<.1 idp)

  \lemma half-sum {a b eps : Real} (p : a < eps * Real.fromRat (ratio 1 2)) (q : b < eps * Real.fromRat (ratio 1 2)) : a + b < eps
    => linarith

  \lemma double>=0 {a b : Real} (p : (0 : Real) <= a + b) (q : b = a) : (0 : Real) <= a
    => linarith

  \func gap (eps a : Real) : Real => eps - a

  \lemma diff>0 {a eps : Real} (p : a < eps) : (0 : Real) < gap eps a
    => linarith

  \lemma diff-triang {a b c eps : Real} (p : c <= a + b) (q : b < gap eps a) : c < eps
    => linarith

  \lemma abs+1>0 {C : Real} : (0 : Real) < RealAbGroup.abs C + 1
    => \have t => RealAbGroup.abs>=0 {C} \in linarith

  -- | The radius $\varepsilon / (|C| + 1)$.
  \func lipRadius (C : Real) (eps : Rat) : Real
    => Real.fromRat eps * RealField.pinv (RealAbGroup.abs C + 1) abs+1>0

  \lemma lipRadius>0 {C : Real} {eps : Rat} (eps>0 : RatField.zro RatField.< eps) : (0 : Real) < lipRadius C eps
    => RealField.<_*_positive_positive (rat_real_<.1 eps>0) (RealField.pinv>0 abs+1>0)

  \lemma lip-bound {C n a : Real} {eps : Rat} (n>=0 : (0 : Real) <= n) (p : a <= C * n) (q : n < lipRadius C eps) : a < Real.fromRat eps
    => \have | m1 : C * n <= RealAbGroup.abs C * n => RealField.<=_*_positive-left RealAbGroup.abs>=id n>=0
             | m2 : RealAbGroup.abs C * n <= RealAbGroup.abs C * lipRadius C eps => RealField.<=_*_positive-right RealAbGroup.abs>=0 (<=-less q)
             | e : RealAbGroup.abs C * lipRadius C eps + lipRadius C eps = Real.fromRat eps
                 => equation.cRing {RealField.pinv-left (abs+1>0 {C})}
       \in linarith
}
