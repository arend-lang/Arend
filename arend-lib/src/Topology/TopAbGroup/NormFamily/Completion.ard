{- | Seminorms on the completion of a topological abelian group whose topology is given by a directed family of seminorms.

  * {normAt-lip}: $|n_j(x) - n_j(y)| \le n_j(x - y)$.
  * {normAt-lift}: the extension $\bar n_j$ of $n_j$ to the completion.
  * {completion-neighborhood}: every neighbourhood of `0` in the completion contains a ball $\{G \mid \bar n_j(G) < \varepsilon\}$.
  * {completion-limit}: a net converges to `x` if $\bar n_j(f_n - x) \to 0$ for every `j`.
  * {normAt-lift-+}, {normAt-lift-negative}: $\bar n_j$ is a seminorm.
  * {normFamily-array-locally-uniform}: a criterion for maps $A^n \to \bar X$ to be locally uniform.
-}

\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.Ordered.RieszSpace
\import Algebra.Pointed
\import Arith.Real
\import Arith.Real.Field
\import Function.Meta
\import Logic
\import Logic.Meta
\import Order.Directed
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Set.Set
\import Topology.CoverSpace.Complete
\import Topology.CoverSpace.Product
\import Topology.NormedAbGroup.Real
\import Topology.NormedAbGroup.Real.Functions
\import Topology.NormedAbGroup.Real.Inverse
\import Topology.TopAbGroup
\import Topology.TopAbGroup.Complete
\import Topology.TopAbGroup.NormFamily
\import Topology.TopAbGroup.Product
\import Topology.TopRieszSpace
\import Topology.TopRieszSpace.Completion()
\import Topology.TopSpace
\import Topology.TopSpace.Product
\import Topology.UniformSpace
\import Topology.UniformSpace.Product
\import Set.Fin
\open LatticeAbGroup

-- | $|n_j(x) - n_j(y)| \le n_j(x - y)$.
\lemma normAt-lip {X : NormFamilyTopAbGroup} {j : X.NormIndex} {x y : X} : RealAbGroup.abs (X.normAt j x - X.normAt j y) <= X.normAt j (x - y)
  => \have | a : X.normAt j x <= X.normAt j (x - y) + X.normAt j y => transportInv (\lam z => X.normAt j z <= _) (equation.abGroup : x = x - y + y) X.normAt-+
           | b : X.normAt j y <= X.normAt j (x - y) + X.normAt j x
               => transportInv (\lam z => X.normAt j z <= _) (equation.abGroup : y = negative (x - y) + x) X.normAt-+ <=∘ =_<= (pmap (`+ _) X.normAt-negative)
     \in RealField.abs-univ linarith linarith

-- | The extension $\bar n_j$ of the seminorm $n_j$ to the completion.
\func normAt-lift {X : NormFamilyTopAbGroup} (j : X.NormIndex) : CoverMap (TopAbGroupCompletion X) RealNormed
  => dense-lift completion completion.isDenseEmbedding (X.normAt-lip-uniform {j} {1} (X.normAt j) \lam x y => normAt-lip <=∘ =_<= (inv ide-left))
  \where
    \lemma char {X : NormFamilyTopAbGroup} {j : X.NormIndex} {x : X} : normAt-lift j (pointCF x) = X.normAt j x
      => dense-lift-char completion.isDenseEmbedding x

-- | $|F| \le |G|$ implies $\bar n_j(F) \le \bar n_j(G)$.
\lemma normAt-lift-abs-mono {X : NormFamilyTruncRieszSpace} {j : X.NormIndex} {F G : TopTruncRieszCompletion X} (p : abs F <= abs G)
  : normAt-lift j F <= normAt-lift j G
  => \let | Y => TopTruncRieszCompletion X
          | A : CoverMap (ProductCoverSpace Y Y) Y => Y.abs-uniform CoverMap.∘ ProductCoverSpace.proj2
          | C : CoverMap (ProductCoverSpace Y Y) Y => Y.join-uniform CoverMap.∘ ProductCoverSpace.tuple (Y.meet-uniform CoverMap.∘ ProductCoverSpace.tuple ProductCoverSpace.proj1 A) (negative-uniform {Y} CoverMap.∘ A)
     \in transport (__ <= _) (pmap (normAt-lift j) (Y.clip-id p)) $
         dense_<= real-join-uniform (ProductCoverSpace.prod completion completion) (ProductTopSpace.prod.isDense completion.isDenseEmbedding.1 completion.isDenseEmbedding.1)
           (normAt-lift j CoverMap.∘ C) (normAt-lift j CoverMap.∘ ProductCoverSpace.proj2)
           (\lam s => =_<= (pmap (normAt-lift j) (pmap (Y.clip __ _) (inv (RieszSpaceHom.func-abs {topTruncCompletion {X}})) *> inv (topTruncCompletion {X}).func-clip) *> normAt-lift.char)
                        <=∘ X.normAt-abs-mono (=_<= (X.clip-abs-eq X.abs>=0) <=∘ X.meet-right) <=∘ =_<= (inv normAt-lift.char)) (F,G)
  \where \open Topology.TopRieszSpace.Completion

-- | Every neighbourhood of `0` in the completion contains a ball $\{G \mid \bar n_j(G) < \varepsilon\}$.
\lemma completion-neighborhood {X : NormFamilyTopAbGroup} {U : Set (TopAbGroupCompletion X)} (Uo : isOpen U) (U0 : U 0)
  : ∃ (j : X.NormIndex) (eps : Real) (0 < eps) ∀ {G} (normAt-lift j G < eps -> U G)
  => \case (TopAbGroupCompletion X).shrink Uo U0 \with {
    | inP (V,Vo,V0,h) => \case X.neighborhood-char (completion-topAb.func-cont Vo) (transportInv V completion-topAb.func-zro V0) \with {
      | inP (j,eps,eps>0,f) => inP (j, eps, eps>0, \lam {G} d =>
          \have Oo : isOpen (\lam G' => \Sigma (V (G' - G)) (normAt-lift j G' < eps))
                   => open-inter (((TopAbGroupCompletion X).subtract-cont ContMap.∘ ProductTopSpace.tuple ContMap.id (ContMap.const G)).func-cont Vo) ((normAt-lift j).func-cont real-below-open)
          \in \case completion.isDenseEmbedding.1 Oo (transportInv V negative-right V0, d) \with {
            | inP (_, inP (y,idp), (Vy,ny)) => transport U (sub-sub {TopAbGroupCompletion X}) $ h (f $ transport (`< eps) normAt-lift.char ny) Vy
          })
    }
  }
  \where
    \lemma sub-sub {A : AbGroup} {a b : A} : a - (a - b) = b
      => equation.abGroup

-- | A net in the completion converges to `x` if $\bar n_j(f_n - x) \to 0$ for every `j`.
\lemma completion-limit {X : NormFamilyTopAbGroup} {I : DirectedSet} {f : I -> TopAbGroupCompletion X} {x : TopAbGroupCompletion X}
                        (p : \Pi (j : X.NormIndex) {eps : Real} -> 0 < eps -> ∃ (N : I) ∀ {n} (N <= n -> normAt-lift j (f n - x) < eps))
  : (TopAbGroupCompletion X).IsLimit f x
  => \lam {U} Uo Ux => \case completion-neighborhood (((TopAbGroupCompletion X).leftTranslation x).func-cont Uo) (transportInv U zro-right Ux) \with {
    | inP (j,eps,eps>0,g) => \case p j eps>0 \with {
      | inP (N,h) => inP (N, \lam q => transport U (add-sub {TopAbGroupCompletion X}) (g (h q)))
    }
  }
  \where
    \lemma add-sub {A : AbGroup} {a b : A} : a + (b - a) = b
      => equation.abGroup

{- | A map $A^n \to \bar X$ is locally uniform if, for every seminorm $\bar n_j$ and $\varepsilon > 0$, there are a seminorm $n_i$ and $\delta > 0$ such that around every $x_0$
 -   there are $n_{i'}$ and $\gamma > 0$ with $\bar n_j(f(y) - f(x)) < \varepsilon$ whenever $n_i(x_0 - x) < \delta$ and $n_{i'}(y - x) < \gamma$ coordinatewise.
 -}
\func normFamily-array-locally-uniform {A X : NormFamilyTopAbGroup} {n : Nat} (f : Array A n -> TopAbGroupCompletion X)
  (h : \Pi (j : X.NormIndex) {eps : Real} -> 0 < eps -> ∃ (i : A.NormIndex) (delta : Real) (0 < delta) ∀ (x0 : Array A n) ∃ (i' : A.NormIndex) (gamma : Real) (0 < gamma)
         ∀ {x y : Array A n} ((\Pi (k : Fin n) -> A.normAt i (x0 k - x k) < delta) -> (\Pi (k : Fin n) -> A.normAt i' (y k - x k) < gamma) -> normAt-lift j (f y - f x) < eps))
  : LocallyUniformMap (ArrayRegularPreuniformSpace n A) (TopAbGroupCompletion X) f \cowith
  | func-locally-uniform Eu => \case (TopAbGroupCompletion X).ab-neighborhood-uniform.1 Eu \with {
    | inP (V,Vo,V0,g) => \case completion-neighborhood Vo V0 \with {
      | inP (j,eps,eps>0,c) => \case h j eps>0 \with {
        | inP (i,delta,delta>0,g1) => inP (Boxes (\lam _ => balls i delta), inP (\lam _ => balls i delta, \lam _ => balls-uniform delta>0, Refines-refl), \lam {_} (inP (U,hU,idp)) =>
            \case FinSet.finiteAC {n} {\lam k => \Sigma (a : A) (U k = \lam b => A.normAt i (a - b) < delta)} hU \with {
              | inP cs => \case g1 (\lam k => (cs k).1) \with {
                | inP (i',gamma,gamma>0,g2) => inP (\lam _ => balls i' gamma, \lam _ => balls-uniform gamma>0, \lam {_} (inP (W',hW',idp)) =>
                    \case FinSet.finiteAC {n} {\lam k => \Sigma (a : A) (W' k = \lam b => A.normAt i' (a - b) < gamma)} hW' \with {
                      | inP ds => \case g (f (\lam k => (ds k).1)) \with {
                        | inP (W,EW,e) => inP (_, inP (W, EW, \lam {s} (sU,sW) => \have sW' : \Pi (k : Fin n) -> W' k (s k) => sW \in e $ c $ g2 (\lam k => transport (__ (s k)) (cs k).2 (sU k)) (\lam k => transport (__ (s k)) (ds k).2 (sW' k))), <=-refl)
                      }
                    })
              }
            })
      }
    }
  }
  \where {
    \func balls {A : NormFamilyTopAbGroup} (i : A.NormIndex) (d : Real) : Set (Set A)
      => \lam V => ∃ (a : A) (V = \lam b => A.normAt i (a - b) < d)

    \lemma balls-uniform {A : NormFamilyTopAbGroup} {i : A.NormIndex} {d : Real} (d>0 : 0 < d) : A.isUniform (balls i d)
      => A.topAbUniform A.normAt-ball-open (transportInv (__ < d) A.normAt-zro d>0)
  }

-- | $\bar n_j(F + G) \le \bar n_j(F) + \bar n_j(G)$.
\lemma normAt-lift-+ {X : NormFamilyTopAbGroup} {j : X.NormIndex} {F G : TopAbGroupCompletion X} : normAt-lift j (F + G) <= normAt-lift j F + normAt-lift j G
  => \let Y => TopAbGroupCompletion X
     \in dense_<= real-join-uniform (ProductCoverSpace.prod completion completion) (ProductTopSpace.prod.isDense completion.isDenseEmbedding.1 completion.isDenseEmbedding.1)
          (normAt-lift j CoverMap.∘ +-uniform {Y})
          (+-uniform {RealNormed} CoverMap.∘ ProductCoverSpace.tuple (normAt-lift j CoverMap.∘ ProductCoverSpace.proj1) (normAt-lift j CoverMap.∘ ProductCoverSpace.proj2))
          (\lam s => =_<= (pmap (normAt-lift j) (inv completion-topAb.func-+) *> normAt-lift.char) <=∘ X.normAt-+ <=∘ =_<= (inv (pmap2 (+) normAt-lift.char normAt-lift.char))) (F,G)

-- | $\bar n_j(-F) = \bar n_j(F)$.
\lemma normAt-lift-negative {X : NormFamilyTopAbGroup} {j : X.NormIndex} {F : TopAbGroupCompletion X} : normAt-lift j (negative F) = normAt-lift j F
  => dense-lift-unique completion completion.isDenseEmbedding.1 (normAt-lift j CoverMap.∘ negative-uniform {TopAbGroupCompletion X}) (normAt-lift j)
      (\lam x => pmap (normAt-lift j) (inv completion-topAb.func-negative) *> normAt-lift.char *> X.normAt-negative *> inv normAt-lift.char) F