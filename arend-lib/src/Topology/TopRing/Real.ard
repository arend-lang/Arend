{- | The real numbers as a topological near-field, combining the field structure with the metric topology.
 -
 -   This module provides the `NearField` instance for `Real`, instantiating the topological ring/near-field interface
 -   from `Topology.TopRing` with the real-number field structure (`RealField`) and the canonical metric/normed topology
 -   on `Real` (`RealNormed`). It witnesses that multiplication is continuous and that invertible elements are dense,
 -   making `Real` a topological near-field suitable for use in analysis and topology developments downstream.
 -}

\import Algebra.Meta
\import Algebra.Monoid
\import Arith.Real
\import Arith.Real.Field
\import Function.Meta
\import Logic
\import Topology.MetricSpace
\import Topology.NormedAbGroup.Real
\import Topology.TopModule
\import Topology.TopRing

{- | `NearField Real` instance, extending `CRing` via `RealField` and `TopAbGroup` via `RealNormed`. Supplies the
 -   continuity of multiplication (`*-cont`) and density of invertible elements (`inv-dense`), packaging `Real` as a
 -   topological near-field.
 -}
\instance RealNearField : NearField Real
  | CRing => RealField
  | TopAbGroup => RealNormed
  | *-cont => RealField.*-cover
  | inv-dense {x} Uo Ux => \case (dist_open {RealNormed}).1 Uo Ux \with {
    | inP (eps,eps>0,h) =>
      \have t => rat_real_<.1 eps>0
      \in \case real-located {0} {x} {x + RealField.half eps} linarith \with {
        | byLeft x<0 => inP (x, RealField.neg#0 x<0, Ux)
        | byRight p => inP (x + RealField.half eps, RealField.pos#0 p, h $ real_<_U.1 $ RealAbGroup.abs_-_< linarith linarith)
      }
  }

{- | Real as a Hausdorff TopLModule over itself: bundles `RingTopLModule RealNearField`
     (the canonical "ring as module over itself" structure)
     with the Hausdorff property inherited from `RealNormed`. -}
\instance RealTopLModule : HausdorffTopLModule RealNearField
  | TopLModule => RingTopLModule RealNearField
  | isSeparatedCoverSpace => RealNormed.isSeparatedCoverSpace