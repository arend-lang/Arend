\import Function
\import Function.Meta
\import Logic
\import Logic.Unique
\import Paths

-- # Definition of equivalences

\record TypeMap {A B : \Cat} (\coerce f : A -> B)

\record Section \extends TypeMap
  | ret : B -> A
  | ret_f : \Pi (x : A) -> ret (f x) = x
  \where {
    \func Section~Fiber {A B : \Cat} {f : A -> B} : QEquiv {Section f} {Fib (-o f) id} \cowith
      | f s => Fib.make s.ret $ path \lam i x => s.ret_f x i
      | ret z => \new Section f z.1 \lam x => path (z.2 __ x)
      | ret_f => idpe
      | f_sec => idpe

    \lemma levelProp {A B : \Cat} (r : Retraction {A} {B}) : isProp (Section r)
      => \lam s => isContr=>isProp (Contr.Contr_QEquiv (symQEquiv Section~Fiber) $
        IsEquiv=>contrFibers.fromSection (\new Section (-o r) {
          | ret => -o r.sec
          | ret_f g => path \lam i x => g (r.f_sec x i)
        }) (\new Retraction {
          | sec => -o s.ret
          | f_sec g => path \lam i x => g (s.ret_f x i)
        }) id) s
  }

\record Retraction \extends TypeMap
  | sec : B -> A
  | f_sec : \Pi (y : B) -> f (sec y) = y
  \where {
    \func fromSigma {A B : \Cat} {f : A -> B} (g : \Pi (b : B) -> \Sigma (a : A) (f a = b)) : Retraction f \cowith
      | sec b => (g b).1
      | f_sec b => (g b).2

    \func Retraction~Fiber {A B : \Cat} {f : A -> B} : QEquiv {Retraction f} {Fib (f `o-) id} \cowith
      | f r => Fib.make r.sec $ path \lam i x => r.f_sec x i
      | ret z => \new Retraction f z.1 \lam x => path (z.2 __ x)
      | ret_f => idpe
      | f_sec => idpe

    \lemma levelProp {A B : \Cat} (s : Section {A} {B}) : isProp (Retraction s)
      => \lam r => isContr=>isProp (Contr.Contr_QEquiv (symQEquiv Retraction~Fiber) $
        IsEquiv=>contrFibers.fromSection (\new Section (s `o-) {
          | ret => s.ret `o-
          | ret_f g => path \lam i x => s.ret_f (g x) i
        }) (\new Retraction {
          | sec => r.sec `o-
          | f_sec g => path \lam i x => r.f_sec (g x) i
        }) id) r

    \lemma isContr (e : QEquiv) : Contr (Retraction e)
      => isProp=>isContr (levelProp e) e
  }

\record QEquiv \extends Section, Retraction {
  | sec => ret

  \func f_ret (y : B) : f (ret y) = y
    => f_sec y

  \func isInj {a a' : A} (p : f a = f a') : a = a'
    => inv (ret_f a) *> pmap ret p *> ret_f a'

  \lemma isSurj : IsSurj f
    => \lam y => inP (ret y, f_ret y)

  \protected \func splitSurj (b : B) : \Sigma (a : A) (f a = b)
    => (ret b, f_ret b)

  \func adjoint {a : A} {b : B} (p : f a = b) : a = ret b
    => inv (ret_f a) *> pmap ret p

  \func adjointInv {a : A} {b : B} (p : a = ret b) : f a = b
    => pmap f p *> f_ret b
} \where {
    \sfunc fromInjSurj {A B : \Set} {f : A -> B} (inj : IsInj f) (surj : IsSurj f) : QEquiv f
      => \have s b => TruncP.remove (\lam t t' => sigmaPath (inj $ t.2 *> inv t'.2) prop-pi) (surj b)
         \in \new QEquiv {
           | ret b => (s b).1
           | ret_f a => inj (s (f a)).2
           | f_sec b => (s b).2
         }

    \lemma equals {A B : \Set} {e e' : QEquiv {A} {B}} (p : \Pi (a : A) -> e a = e' a) : e = e'
      => \have | pf : e.f = e'.f => path (\lam i a => p a @ i)
                | pr : e.ret = e'.ret => path (\lam i b => (e.isInj $ e.f_ret b *> inv (p _ *> e'.f_ret b)) @ i)
         \in path (\lam i => \new QEquiv {A} {B} (pf @ i) {
           | ret => pr @ i
           | ret_f => prop-dpi (\lam j => \Pi (a : A) -> (pr @ j) ((pf @ j) a) = a) e.ret_f e'.ret_f @ i
           | f_sec => prop-dpi (\lam j => \Pi (b : B) -> (pf @ j) ((pr @ j) b) = b) e.f_sec e'.f_sec @ i
         })

    \func leftFactor {A B C : \Cat} {f : A -> B} {g : B -> C} (e2 : Section g) (e3 : QEquiv (g `o` f)) : QEquiv f \cowith
      | ret b => e3.ret (g b)
      | ret_f => e3.ret_f
      | f_sec b =>
        f (e3.ret (g b))              ==< inv (e2.ret_f (f (e3.ret (g b)))) >==
        e2.ret (g (f (e3.ret (g b)))) ==< pmap e2.ret (e3.f_sec (g b)) >==
        e2.ret (g b)                  ==< e2.ret_f b >==
        b                             `qed

    \func rightFactor {A B C : \Cat} {f : A -> B} (e1 : Retraction f) {g : B -> C} (e3 : QEquiv (g `o` f)) : QEquiv g \cowith
      | ret c => f (e3.ret c)
      | ret_f b =>
        f (e3.ret (g b))              ==< pmap (f `o` e3.ret `o` g) (inv (e1.f_sec b)) >==
        f (e3.ret (g (f (e1.sec b)))) ==< pmap f (e3.ret_f (e1.sec b)) >==
        f (e1.sec b)                  ==< e1.f_sec b >==
        b                             `qed
      | f_sec => e3.f_sec
  }

\func QEquiv_= {A B : \Type} (e : QEquiv {A} {B}) (i : I) : \Type
  => iso e.f e.ret e.ret_f e.f_sec i

\type IsEquiv {A B : \Cat} (f : A -> B) : \Prop
  => TruncP (QEquiv f)
  \where {
    \lemma toBiEquiv (e : IsEquiv f) : BiEquiv f \level BiEquiv.levelProp {A} {B} {f}
      | inP e => e

    \sfunc toQEquiv (e : IsEquiv f) : QEquiv f
      => toBiEquiv e

    \sfunc ret (e : IsEquiv f) (b : B) : A
      => (toQEquiv e).ret b

    \sfunc ret_f (e : IsEquiv f) {a : A} : ret e (f a) = a
      => (\peval ret e (f a)) *> (toQEquiv e).ret_f a

    \sfunc f_ret (e : IsEquiv f) {b : B} : f (ret e b) = b
      => pmap f (\peval ret e b) *> (toQEquiv e).f_ret b

    \func splitSurj (e : IsEquiv f) (b : B) : \Sigma (a : A) (f a = b)
      => (ret e b, f_ret e)

    \func adjoint (e : IsEquiv f) {a : A} {b : B} (p : f a = b) : a = ret e b
      => inv (ret_f e) *> pmap (ret e) p

    \lemma ret-equiv (e : IsEquiv f) : IsEquiv (ret e)
      => inP \new QEquiv {
        | ret => f
        | ret_f b => f_ret e
        | f_sec a => ret_f e
      }

    \func isInj (e : IsEquiv f) {a a' : A} (p : f a = f a') : a = a'
      => inv (ret_f e) *> pmap (ret e) p *> ret_f e

    \lemma isSurj (e : IsEquiv f) : IsSurj f \elim e
      | inP e => e.isSurj

    \lemma fromEmbSurj {A B : \Cat} {f : A -> B} (emb : Embedding f) (surj : IsSurj f) : IsEquiv f
      => inP \new QEquiv {
        | ret b => (emb.surj-split surj b).1
        | ret_f a => (emb.isEmb _ _).sec (emb.surj-split surj (f a)).2
        | f_sec b => (emb.surj-split surj b).2
      }

    \lemma fromInjSurj {A B : \Set} {f : A -> B} (inj : IsInj f) (surj : IsSurj f) : IsEquiv f
      => inP (QEquiv.fromInjSurj inj surj)

    \lemma fromInjInv {A B : \Set} {f : A -> B} (g : B -> A) (inj : IsInj g) (surj : \Pi (a : A) -> g (f a) = a) : IsEquiv f
      => inP \new QEquiv {
        | ret => g
        | ret_f => surj
        | f_sec b => inj (surj (g b))
      }

    \lemma fromMonoRetraction {A B : \Cat} {f : A -> B} (mono : \Pi {a a' : A} -> f a = f a' -> a = a') (s : Retraction f) : IsEquiv f
      => inP \new QEquiv {
        | ret => s.sec
        | ret_f a => mono (s.f_sec (f a))
        | f_sec => s.f_sec
      }

    -- | A retract of an equivalence in the arrow category is an equivalence.
    \lemma retract {A B C D : \Cat} {f : A -> B} (e : IsEquiv f) {g : C -> D}
                   (sC : C -> A) (rC : A -> C) (rsC : \Pi (c : C) -> rC (sC c) = c)
                   (sD : D -> B) (rD : B -> D) (rsD : \Pi (d : D) -> rD (sD d) = d)
                   (fs : \Pi (c : C) -> f (sC c) = sD (g c)) (rf : \Pi (a : A) -> rD (f a) = g (rC a)) : IsEquiv g \elim e
      | inP e => inP \new QEquiv {
        | ret d => rC (e.ret (sD d))
        | ret_f c => pmap (\lam b => rC (e.ret b)) (inv (fs c)) *> pmap rC (e.ret_f (sC c)) *> rsC c
        | f_sec d => inv (rf _) *> pmap rD (e.f_sec (sD d)) *> rsD d
      }

    \lemma trans {A B C : \Cat} {f : A -> B} (e : IsEquiv f) {g : B -> C} (e' : IsEquiv g) : IsEquiv \lam a => g (f a) \elim e, e'
      | inP e, inP e' => inP (transQEquiv e e')

    \lemma leftFactor {A B C : \Cat} {f : A -> B} {g : B -> C} (e2 : IsEquiv g) (e3 : IsEquiv \lam a => g (f a)) : IsEquiv f \elim e2, e3
      | inP e2, inP e3 => inP (QEquiv.leftFactor e2 e3)

    \lemma rightFactor {A B C : \Cat} {f : A -> B} (e1 : IsEquiv f) {g : B -> C} (e3 : IsEquiv \lam a => g (f a)) : IsEquiv g \elim e1, e3
      | inP e1, inP e3 => inP (QEquiv.rightFactor e1 e3)

    \lemma parallelEquiv {A B C D : \Cat} {ab : A -> B} {cd : C -> D} {ac : A -> C} {bd : B -> D}
                         (ace : IsEquiv ac) (bde : IsEquiv bd) (h : \Pi (a : A) -> bd (ab a) = cd (ac a)) : IsEquiv ab <-> IsEquiv cd
      => \have q : (\lam a => bd (ab a)) = (\lam a => cd (ac a)) => path (\lam i a => h a @ i)
         \in (\lam abe => rightFactor ace $ transport IsEquiv q $ trans abe bde,
              \lam cde => leftFactor bde $ transportInv IsEquiv q $ trans ace cde)
  }

\data Equiv (A B : \Cat)
  | mkEquiv {f : A -> B} (IsEquiv f)
  \where {
    \use \coerce toFunc (e : Equiv A B) : A -> B \elim e
      | mkEquiv {f} _ => f

    \func toQEquiv (e : Equiv A B) : QEquiv {A} {B} e \elim e
      | mkEquiv e => IsEquiv.toQEquiv e

    \protected \func equals {e e' : Equiv A B} (p : toFunc e = toFunc e') : e = e' \elim e, e'
      | mkEquiv e, mkEquiv e' => path \lam i => mkEquiv {_} {_} {p i} (prop-dpi _ _ _ i)

    \lemma toFunc-embedding : Embedding {Equiv A B} {A -> B} toFunc \cowith
      | isEmb => \case \elim __, \elim __ \with {
        | mkEquiv e, mkEquiv e' => \new Retraction {
          | sec => equals
          | f_sec => idpe
        }
      }
  }

-- # Examples of equialences

\func idEquiv {A : \Cat} : QEquiv \cowith
  | A => A
  | B => A
  | f x => x
  | ret x => x
  | ret_f _ => idp
  | f_sec _ => idp

\func symQEquiv {A B : \Cat} (e : QEquiv {A} {B}) : QEquiv {B} {A} \cowith
  | f => e.ret
  | ret => e.f
  | ret_f => e.f_sec
  | f_sec => e.ret_f

\func \fixr 3 transQEquiv {A B C : \Cat} (e1 : QEquiv {A} {B}) (e2 : QEquiv {B} {C}) : QEquiv {A} {C} \cowith
  | f x => e2 (e1 x)
  | ret y => e1.ret (e2.ret y)
  | ret_f x => pmap e1.ret (e2.ret_f (e1 x)) *> e1.ret_f x
  | f_sec y => pmap e2 (e1.f_sec (e2.sec y)) *> e2.f_sec y

\lemma -o_IsEquiv {A B C : \Cat} {f : A -> B} (e : IsEquiv f) : IsEquiv {B -> C} {A -> C} (-o f)
  => inP \new QEquiv {
    | ret => -o (IsEquiv.ret e)
    | ret_f g => path \lam i x => g (IsEquiv.f_ret e {x} i)
    | f_sec g => path \lam i x => g (IsEquiv.ret_f e {x} i)
  }

\lemma o-_IsEquiv {A B C : \Cat} {f : A -> B} (e : IsEquiv f) : IsEquiv {C -> A} {C -> B} (f `o-)
  => inP \new QEquiv {
    | ret => IsEquiv.ret e `o-
    | ret_f g => path (\lam i x => IsEquiv.ret_f e {g x} i)
    | f_sec g => path (\lam i x => IsEquiv.f_ret e {g x} i)
  }

\func piEquiv {A : \Cat} (B : A -> \Cat) (f f' : \Pi (a : A) -> B a) : QEquiv \cowith
  | A => f = f'
  | B => \Pi (a : A) -> f a = f' a
  | f p a => path ((p @ __) a)
  | ret g => path (\lam i a => g a @ i)
  | ret_f _ => idp
  | f_sec _ => idp

\func sigmaEquiv {A : \Cat} (B : A -> \Cat) (p p' : \Sigma (a : A) (B a)) : QEquiv \cowith
  | A => p = p'
  | B => \Sigma (s : p.1 = p'.1) (transport B s p.2 = p'.2)
  | f q => (pmap __.1 q, pmapd __.2 q)
  | ret q => sigmaPath q.1 q.2
  | ret_f q => Jl (\lam p'' q' => sigmaPath (pmap __.1 q') (pmapd __.2 q') = q') idp q
  | f_sec q =>
    sigmaPath idp (\case p'.1 \as p'1        , q.1 \as q1 : p.1 = p'1,
                    p'.2 \as p'2 : B p'1, q.2 \as q2 : transport B q1 p.2 = p'2
              \return pmapd __.2 {p} {p'1, p'2} (sigmaPath q1 q2) = q2 \with {
                | p'1, idp, p'2, idp => idp
              })

\func piSigmaEquiv {A A' : \Cat} (h : A -> A') (B : A' -> \Cat)
  : QEquiv {\Pi (a : A) -> B (h a)}
           {\Sigma (g : A -> \Sigma (a' : A') (B a')) ((\lam a => (g a).1) = h)}
  \cowith
  | f g => (\lam a => (h a, g a), idp)
  | ret p => \lam a => transport B (path ((p.2 @ __) a)) (p.1 a).2
  | ret_f g => idp
  | f_sec p => Jl (\lam (h' : A -> A') q => (\lam a => (h' a, transport B (path ((q @ __) a)) (p.1 a).2), idp)
                                            = {\Sigma (g : A -> \Sigma (a' : A') (B a')) ((\lam a => (g a).1) = h')}
                                            (p.1, q))
                  idp
                  p.2

\func piSigmaIdEquiv {A : \Cat} (B : A -> \Cat)
  : QEquiv {\Pi (a : A) -> B a}
           {\Sigma (g : A -> \Sigma (a : A) (B a)) ((\lam a => (g a).1) = id)}
  => piSigmaEquiv id B

\func emptyEquiv {A B : \Cat} (Ae : A -> Empty) (Be : B -> Empty) : QEquiv {A} {B} \cowith
  | f a => absurd (Ae a)
  | ret b => absurd (Be b)
  | ret_f a => absurd (Ae a)
  | f_sec b => absurd (Be b)

\func pathEquiv-right {A : \Cat} {a b c : A} (ab : a = b) : QEquiv {a = c} {b = c} \cowith
  | f ac => inv ab *> ac
  | ret bc => ab *> bc
  | ret_f ac => inv *>-assoc *> pmap (*> _) *>_inv *> idp_*>
  | f_sec bc => inv *>-assoc *> pmap (*> _) inv_*> *> idp_*>

\func inv-equiv {A : \Cat} {a b : A} : QEquiv {a = b} {b = a} \cowith
  | f => inv
  | ret => inv
  | ret_f _ => inv_inv
  | f_sec _ => inv_inv

-- | Paths over a path {e} are transports along {e}.
\func pathOver-transport-equiv {X : \Cat} (B : X -> \Cat) {x x' : X} (e : x = x') {b : B x} {b' : B x'}
  : QEquiv {Path (\lam k => B (e k)) b b'} {transport B e b = b'} \elim e
  | idp => idEquiv

-- | Transport along a path is an equivalence.
\lemma transport-isEquiv {A : \Cat} (F : A -> \Cat) {a a' : A} (p : a = a') : IsEquiv (transport F p) \elim p
  | idp => inP idEquiv

-- # Embeddings and surjections

\record Embedding \extends TypeMap {
  | isEmb : \Pi (a a' : A) -> Retraction (pmap f {a} {a'})

  \sfunc pmap-isEquiv {a a' : A} : QEquiv (pmap f {a} {a'})
    => pathEquiv (f __ = f __) (\lam {a} {a'} => isEmb a a')

  \lemma surj-split (s : IsSurj f) (y : B)
    => TruncP.remove (Embedding.embeddingFiber-isProp \this y) (s y)
} \where {
  \use \level levelProp {A B : \Cat} {f : A -> B} (e e' : Embedding f) : e = e'
    => path (\lam i => \new Embedding f (\lam a a' => Retraction.levelProp (pathEquiv (e __ = e __) (\lam {a} {a'} => e.isEmb a a')) (e.isEmb a a') (e'.isEmb a a') @ i))

  \func fromInjection {A : \Cat} {B : \Set} {f : A -> B} (inj : \Pi {a a' : A} -> f a = f a' -> a = a') : Embedding f \cowith
    | isEmb a a' => \new Retraction {
      | sec => inj
      | f_sec p => prop-pi {f a = f a'}
    }

  \sfunc fromIsEquiv {A B : \Cat} {f : A -> B} (e : IsEquiv f) : Embedding f \cowith
    | isEmb a a' => IsEquiv.toQEquiv (pmapIsEquiv e)

  -- | The diagonal of an embedding is an equivalence
  \lemma diag-equiv (e : Embedding) : IsEquiv {e.A} {\Sigma (a1 a2 : e.A) (e a1 = e a2)} (\lam a => (a, a, idp)) =>
    \let | S => \Sigma (x : e.A) (\Sigma (y : e.A) (x = y))
         | T => \Sigma (x y : e.A) (e x = e y)
         | q => \new QEquiv {e.A} {S} (\lam x => (x,(x,idp))) {
                  | ret t => t.1
                  | ret_f x => idp
                  | f_sec t => pmap (\lam r => ((t.1,r) : S)) (Jl (\lam x p => (t.1,idp) = {\Sigma (x : e.A) (t.1 = x)} (x,p)) idp t.2.2)
                }
         | pe {a} {a'} : QEquiv (pmap e {a} {a'}) => e.pmap-isEquiv {a} {a'}
         | s => \new QEquiv {S} {T} (\lam t => (t.1, t.2.1, pmap e t.2.2)) {
                  | ret t => (t.1, (t.2, pe.ret t.3))
                  | ret_f t => pmap (\lam r => ((t.1, (t.2.1, r)) : S)) (pe.ret_f t.2.2)
                  | f_sec t => pmap (\lam r => ((t.1, t.2, r) : T)) (pe.f_sec t.3)
                }
    \in inP (transQEquiv q s)

  -- | The fiber of the diagonal over {t} is equivalent to the fiber of `pmap f` over `t.3`
  \func diag-fib-equiv {A B : \Cat} {f : A -> B} (t : \Sigma (a1 a2 : A) (f a1 = f a2))
    : QEquiv {\Sigma (a : A) ((a, a, idp) = {\Sigma (a1 a2 : A) (f a1 = f a2)} t)} {\Sigma (p : t.1 = t.2) (pmap f p = t.3)} \cowith
    | f s => diag-fib s.2
    | ret s => (t.1, fib-diag s.1 s.2)
    | ret_f s => ret_f' s.2
    | f_sec s => f_sec' s.1 s.2
    \where {
      \func diag-fib {A B : \Cat} {f : A -> B} {a : A} {t : \Sigma (a1 a2 : A) (f a1 = f a2)} (r : (a, a, idp) = {\Sigma (a1 a2 : A) (f a1 = f a2)} t)
        : \Sigma (p : t.1 = t.2) (pmap f p = t.3) \elim r
        | idp => (idp, idp)

      \func fib-diag {A B : \Cat} {f : A -> B} {a a' : A} {q : f a = f a'} (p : a = a') (h : pmap f p = q)
        : (a, a, idp) = {\Sigma (a1 a2 : A) (f a1 = f a2)} (a, a', q) \elim p, h
        | idp, idp => idp

      \func ret_f' {A B : \Cat} {f : A -> B} {a : A} {t : \Sigma (a1 a2 : A) (f a1 = f a2)} (r : (a, a, idp) = {\Sigma (a1 a2 : A) (f a1 = f a2)} t)
        : (t.1, fib-diag (diag-fib r).1 (diag-fib r).2) = {\Sigma (a : A) ((a, a, idp) = {\Sigma (a1 a2 : A) (f a1 = f a2)} t)} (a, r) \elim r
        | idp => idp

      \func f_sec' {A B : \Cat} {f : A -> B} {a a' : A} {q : f a = f a'} (p : a = a') (h : pmap f p = q)
        : diag-fib {A} {B} {f} (fib-diag p h) = {\Sigma (p : a = a') (pmap f p = q)} (p, h) \elim p, h
        | idp, idp => idp
    }

  -- | A map is an embedding if and only if its diagonal is an equivalence
  \lemma diag-char {A B : \Cat} {f : A -> B} : Embedding f <-> IsEquiv {A} {\Sigma (a1 a2 : A) (f a1 = f a2)} (\lam a => (a, a, idp))
    => (\lam e => diag-equiv e, \lam e => \new Embedding {
      | isEmb a a' => contrFibers=>QEquiv \lam q => Contr.Contr_QEquiv (diag-fib-equiv (a, a', q)) (IsEquiv=>contrFibers e (a, a', q))
    })

  \lemma projection {A : \Cat} (B : A -> \Prop) : Embedding {\Sigma (a : A) (B a)} __.1 \cowith
    | isEmb p p' => \new Retraction {
      | sec q => sigmaPath q prop-pi
      | f_sec => idpe
    }

  \lemma sigma-prop-embedding {A : \Cat} {B : A -> \Cat} (Bp : \Pi (a : A) -> isProp (B a)) : Embedding {\Sigma (a : A) (B a)} __.1 \cowith
    | isEmb s s' => \new Retraction {
      | sec p => sigmaPath p (Bp _ _ _)
      | f_sec => idpe
    }

  -- | If the fibers of a map are propositions, then the map is an embedding
  \lemma fibers {A B : \Cat} (f : A -> B) (p : \Pi (b : B) -> isProp (Fib f b)) : Embedding f \cowith
    | isEmb a a' => IsEquiv.toQEquiv (pmap-equiv p)
    \where {
      \protected \lemma pmap-equiv {A B : \Cat} {f : A -> B} (p : \Pi (b : B) -> isProp (Fib f b)) {a a' : A}
        : IsEquiv {a = a'} {f a = f a'} (pmap f)
        => inP $ pathEquiv (f __ = f __) \lam {a} {a'} => Retraction.fromSigma
            \lam q => Fib.equiv (f a') (a,q) (a',idp) (p (f a') (a,q) (a',idp))
    }

  -- | The fibers of an embedding are propositions.
  \lemma embeddingFiber-isProp (e : Embedding) (b : e.B) : isProp (Fib e b) => \lam x x' =>
    \let | eq : Retraction (pmap e {x.1} {x'.1}) => e.isEmb x.1 x'.1
         | fx=fx' => x.2 *> inv x'.2
    \in Fib.ext b x x' (eq.sec fx=fx') (
      pmap e (eq.sec fx=fx') *> x'.2 ==< pmap (*> x'.2) (eq.f_sec fx=fx') >==
      fx=fx' *> x'.2                   ==< *>-assoc >==
      x.2 *> inv x'.2 *> x'.2          ==< pmap (x.2 *>) inv_*> >==
      x.2                              `qed
    )
}

\func transEmbedding {A B C : \Cat} (e1 : Embedding {A} {B}) (e2 : Embedding {B} {C}) : Embedding {A} {C} \cowith
  | f a => e2 (e1 a)
  | isEmb a a' => \new Retraction {
    | sec p => sec {e1.isEmb a a'} (sec {e2.isEmb (e1 a) (e1 a')} p)
    | f_sec p => pmap (pmap e2) (f_sec {e1.isEmb a a'} (sec {e2.isEmb (e1 a) (e1 a')} p)) *> f_sec {e2.isEmb (e1 a) (e1 a')} p
  }

\lemma leftEmbedding {A B C : \Cat} {f : A -> B} (g : Embedding {B} {C}) (e : Embedding \lam x => g (f x)) : Embedding f \cowith
  | isEmb a a' => \new Retraction {
    | sec p => (e.isEmb a a').sec (pmap g p)
    | f_sec p => \have e' => g.pmap-isEquiv {f a} {f a'}
                 \in inv (e'.ret_f _) *> pmap e'.ret ((e.isEmb a a').f_sec (pmap g p)) *> e'.ret_f p
  }

\lemma piEmbedding {A : \Cat} {B C : A -> \Cat} (e : \Pi (a : A) -> Embedding {B a} {C a}) : Embedding {\Pi (a : A) -> B a} {\Pi (a : A) -> C a} (\lam f a => e a (f a)) \cowith
  | isEmb f g => \new Retraction {
    | sec p => path \lam i a => ((e a).isEmb (f a) (g a)).sec (path \lam j => p j a) i
    | f_sec p => path \lam i j a => ((e a).isEmb (f a) (g a)).f_sec (path \lam j => p j a) i j
  }

-- | If ``a = a'`` is a retract of ``R a a'``, then ``a = a'`` is equivalent to ``R a a'``.
\func pathEquiv {A : \Cat} (R : A -> A -> \Cat) (p : \Pi {a a' : A} -> Retraction {a = a'} {R a a'}) {a a' : A} : QEquiv {a = a'} p \cowith
  | ret => p.sec
  | ret_f => Jl (\lam _ q' => p.sec (p q') = q') (
    \let | h {a a' : A} (q : a = a') => p.sec (p q)
         | h-idemp {a a' : A} (q : a = a') : h (h q) = h q => pmap p.sec (p.f_sec (p q))
    \in Jl (\lam _ q => h idp = h q *> inv q) idp (h idp) *> pmap (*> inv (h idp)) (h-idemp idp) *> *>_inv
  )
  | f_sec => p.f_sec

\func pathConcatEquiv {A : \Cat} {a b c : A} (p : a = b) : QEquiv {a = c} {b = c} \cowith
  | f => inv p *>
  | ret => p *>
  | ret_f q => inv *>-assoc *> pmap (*> q) *>_inv *> idp_*>
  | f_sec q => inv *>-assoc *> pmap (*> q) inv_*> *> idp_*>

-- | If ``f : A -> B`` is an equivalence, then ``pmap f`` is also an equivalence.
\lemma pmapIsEquiv {A B : \Cat} {f : A -> B} (e : IsEquiv f) {a a' : A} : IsEquiv (pmap f {a} {a'}) \elim e
  | inP e => inP $ pathEquiv (f __ = f __) \lam {a} {a'} => \new Retraction {
    | f => pmap f
    | sec p => inv (e.ret_f a) *> pmap e.ret p *> e.ret_f a'
    | f_sec p => \let hae : HAEquiv f => e \in
      pmap f (inv (e.ret_f a) *> pmap e.ret p *> e.ret_f a')                   ==< pmap_*>-comm f (inv (e.ret_f a)) (pmap e.ret p *> e.ret_f a') >==
      pmap f (inv (e.ret_f a)) *> pmap f (pmap e.ret p *> e.ret_f a')          ==< pmap2 (*>) (pmap_inv-comm f (e.ret_f a)) (pmap_*>-comm f (pmap e.ret p) (e.ret_f a')) >==
      inv (pmap f (e.ret_f a)) *> pmap f (pmap e.ret p) *> pmap f (e.ret_f a') ==< rotatePathLeft (
        pmap f (pmap e.ret p) *> pmap f (e.ret_f a') ==< pmap (pmap f (pmap e.ret p) *> __) (hae.f_ret_f=f_sec_f a') >==
        pmap f (pmap e.ret p) *> hae.f_sec (f a')    ==< homotopy-isNatural (\lam y => f (e.ret y)) (\lam y => y) hae.f_sec p >==
        hae.f_sec (f a) *> p                         ==< inv (pmap (*> p) (hae.f_ret_f=f_sec_f a)) >==
        pmap f (e.ret_f a) *> p                      `qed) >==
      p `qed
  }

-- | If ``f : A -> B`` is an embedding, then ``pmap f`` is also an embedding.
\func pmapEmbedding (e : Embedding) {a a' : e.A} : Embedding {a = a'} (pmap e) \cowith
  | isEmb _ _ => IsEquiv.toQEquiv $ pmapIsEquiv $ inP (e.pmap-isEquiv {a} {a'})

-- | If ``f : A -> B`` is a section, then ``pmap f`` is also a section.
\func pmapSection (s : Section) {a a' : s.A} : Section {a = a'} (pmap s) \cowith
  | ret q => (inv (s.ret_f a) *> pmap s.ret q) *> s.ret_f a'
  | ret_f q => Jl (\lam a'' q' => (inv (s.ret_f a) *> pmap s.ret (pmap s q')) *> s.ret_f a'' = q') inv_*> q

\func Total {B : \Cat} (F : B -> \Cat) => \Sigma (b : B) (F b)
  \where
    \func proj (F : B -> \Cat) => \lam (t : Total F) => t.1

\func Fib {A B : \Cat} (f : A -> B) (base : B) => \Sigma (a : A) (f a = base)
  \where {
    \func make {base : B} (a : A) (p : f a = base) : Fib f base => (a,p)

    \func ext (b0 : B) (x x' : Fib f b0) (p : x.1 = x'.1) (q : pmap f p *> x'.2 = x.2) : x = x'
      => (retraction b0 x' x p q).1
      \where
        \func retraction (b0 : B) (x' x : Fib f b0) (p : x.1 = x'.1) (q : pmap f p *> x'.2 = x.2)
          : \Sigma (t : x = x') (transport (\lam x'' => \Sigma (p : x.1 = x''.1) (pmap f p *> x''.2 = x.2)) t (idp, idp_*>) = (p,q)) \elim x', x, p, q
          | (x'1,idp), (x1,x2), idp, idp => (idp,idp)

    \func equiv (b0 : B) (x x' : Fib f b0) : QEquiv {x = x'} {\Sigma (p : x.1 = x'.1) (pmap f p *> x'.2 = x.2)} =>
      \let S {b0 : B} (x x' : Fib f b0) => \Sigma (p : x.1 = x'.1) (pmap f p *> x'.2 = x.2)
      \in pathEquiv S (\lam {x x' : Fib f b0} =>
          \new Retraction {
            | f q => transport (S x) q (idp, idp_*>)
            | sec s => ext b0 x x' s.1 s.2
            | f_sec s => (ext.retraction b0 x' x s.1 s.2).2
          })
  }

-- | Fibers of a projection are the fibers of the family.
\func proj-fib {A : \Cat} (B : A -> \Cat) (a : A) : QEquiv {Fib {\Sigma (x : A) (B x)} __.1 a} {B a} \cowith
  | f w => transport B w.2 w.1.2
  | ret b => ((a,b), idp)
  | ret_f w => aux w.1.1 w.1.2 w.2
  | f_sec b => idp
  \where
    \private \func aux (x : A) (b : B x) {a : A} (p : x = a)
      : ((a, transport B p b), idp) = {Fib {\Sigma (x : A) (B x)} {A} __.1 a} ((x,b),p) \elim p
      | idp => idp

-- | A path between elements of a fiber relates their second components.
\func fib-path {A B : \Cat} {f : A -> B} {b : B} {s t : Fib f b} (e : s = t)
  : pmap (\lam z => f z.1) e *> t.2 = s.2 \elim e
  | idp => idp_*>

\record HAEquiv \extends QEquiv
  | f_ret_f=f_sec_f : \Pi (x : A) -> pmap f (ret_f x) = f_sec (f x)
  \where {
    \protected \func coh_f_sec (s : Section) (r : \Pi (y : s.B) -> s (s.ret y) = y) (y : s.B) : s (s.ret y) = y
      => inv (r (s (s.ret y))) *> pmap s (s.ret_f (s.ret y)) *> r y

    \protected \func coh_f_ret_f=f_sec_f (s : Section) (r : \Pi (y : s.B) -> s (s.ret y) = y) (x : s.A) : pmap s (s.ret_f x) = coh_f_sec s r (s x)
      => inv $ rotatePathLeft $
          pmap s (s.ret_f (s.ret (s x))) *> r (s x)               ==< pmap (pmap s __ *> r (s x)) (homotopy_app-comm (\lam x => s.ret (s x)) s.ret_f x) >==
          pmap (\lam x => s (s.ret (s x))) (s.ret_f x) *> r (s x) ==< homotopy-isNatural (\lam y => s (s.ret y)) (\lam y => y) r (pmap s (s.ret_f x))   >==
          r (s (s.ret (s x))) *> pmap s (s.ret_f x)               `qed

    \use \coerce fromQEquiv (e : QEquiv) : HAEquiv \cowith
      | Section => e
      | f_sec => coh_f_sec e e.f_sec
      | f_ret_f=f_sec_f => coh_f_ret_f=f_sec_f e e.f_sec

    \lemma levelProp.{u} {A B : \Type u} {f : A -> B} : isProp (HAEquiv f)
      => \lam e e' =>
          \let -- HAEquiv = Retraction + T1' = Retraction + T1
           | T1' (r : Retraction f) (x : A) =>
              (r.sec (f x), r.f_sec (f x)) = {Fib f (f x)} (x,idp)
           | T1 (r : Retraction f) (x : A) =>
              \Sigma (p : r.sec (f x) = x) (pmap f p = r.f_sec (f x))
           | T1'=T1 (r : Retraction f) (x : A) : T1' r x = T1 r x =>
              QEquiv_= (Fib.equiv (f x) (r.sec (f x), r.f_sec (f x)) (x,idp))
           | T1'-isContr (r : Retraction f) (x : A) : Contr (T1' r x) =>
              isProp=>PathContr (Fib f (f x)) (isContr=>isProp (IsEquiv=>contrFibers (inP e) (f x))) _ _
           | T1-isContr (r : Retraction f) (x : A) : Contr (T1 r x) =>
              transport (\lam X => Contr X) (T1'=T1 r x) (T1'-isContr r x)
           | T2 => \Sigma (r : Retraction f) (\Pi (x : A) -> T1 r x)
           | T2-isContr : Contr T2 => sigma-Contr
                                        (Retraction.isContr e)
                                        (\lam r => pi-Contr (T1 r) (T1-isContr r))
           | E : T2 = HAEquiv f => path (iso (\lam (t : T2) => \new HAEquiv f {
                                          | ret => sec {t.1}
                                          | f_sec => f_sec {t.1}
                                          | ret_f x => (t.2 x).1
                                          | f_ret_f=f_sec_f x => (t.2 x).2
                                          }) (\lam (r : HAEquiv f) => (\new Retraction f r.sec r.f_sec, \lam x => (r.ret_f x, r.f_ret_f=f_sec_f x)))
                                             (\lam t2 => idp) (\lam (hae : HAEquiv f) => idp {HAEquiv f hae.ret hae.ret_f hae.f_sec hae.f_ret_f=f_sec_f}))
          \in isContr=>isProp (transport (\lam X => Contr X) E T2-isContr) e e'
  }

\func HasContrFibers {A B : \Cat} (f : A -> B) : \Prop
  => \Pi (b : B) -> Contr (\Sigma (a : A) (f a = b))

\func contrFibers=>QEquiv {A B : \Cat} {f : A -> B} (p : HasContrFibers f) : QEquiv f \cowith
  | ret y => (p y).center.1
  | ret_f x => pmap (\lam (r : Fib f (f x)) => r.1) ((p (f x)).contraction (x,idp))
  | f_sec y => (p y).center.2

\lemma contrFibers=>IsEquiv {A B : \Cat} {f : A -> B} (p : HasContrFibers f) : IsEquiv f
  => inP (contrFibers=>QEquiv p)

\lemma IsEquiv=>contrFibers {A B : \Cat} {f : A -> B} (e : IsEquiv f) : HasContrFibers f \elim e
  | inP e => fromSection e e
  \where {
    \protected \lemma fromSection (s : Section f) (r : Retraction f) : HasContrFibers f
      => \lam b0 =>
          \let | r' y => pmap (\lam y => f (s.ret y)) (inv (r.f_sec y)) *> pmap f (s.ret_f (r.sec y)) *> r.f_sec y
               | f_sec => HAEquiv.coh_f_sec s r'
               | x0 => Fib.make (s.ret b0) (f_sec b0)
          \in Contr.make x0 (\lam x =>
              \let -- p0 proves that the first components are equal: x0.over = x.over.
                   | p0 => pmap s.ret (inv x.2) *> s.ret_f x.1
                   -- q0 proves that the second compontents are equal: pmap f p0 *> x.basePath = x0.basePath.
                   | q0 =>
                     pmap f p0 *> x.2                                               ==< pmap (*> x.2) (pmap_*>-comm f _ _) >==
                     (pmap f (pmap s.ret (inv x.2)) *> pmap f (s.ret_f x.1)) *> x.2 ==< pmap ((pmap f (pmap s.ret (inv x.2)) *> __) *> x.2) (HAEquiv.coh_f_ret_f=f_sec_f s r' x.1) >==
                     (pmap f (pmap s.ret (inv x.2)) *> f_sec (f x.1)) *> x.2      ==< pmap (*> x.2) (homotopy-isNatural (\lam x => f (s.ret x)) (\lam x => x) f_sec (inv x.2)) >==
                     (f_sec b0 *> inv x.2) *> x.2                                 ==< *>-assoc >==
                     f_sec b0 *> (inv x.2 *> x.2)                                 ==< pmap (f_sec b0 *>) inv_*> >==
                     f_sec b0                                                     `qed
              \in Fib.ext b0 x0 x p0 q0)
  }

\record BiEquiv \extends Section, Retraction
  \where {
    \use \coerce fromQEquiv (e : QEquiv) : BiEquiv \cowith
      | Section => e
      | Retraction => e

    \use \coerce toQEquiv (e : BiEquiv) : QEquiv \cowith
      | Section => e
      | f_sec y => pmap (\lam y => e (ret y)) (inv (f_sec y)) *> pmap e (ret_f (sec y)) *> f_sec y

    \func equals {A B : \Cat} {e e' : BiEquiv {A} {B}} (p : e.f = e'.f) : e = e'
      => path \lam i => \new BiEquiv {
        | Section => pathOver (Section.levelProp e' (transport (\lam g => Section {A} {B} g) p (\new Section e.f e.ret e.ret_f)) (\new Section e'.f e'.ret e'.ret_f)) @ i
        | Retraction => pathOver (Retraction.levelProp e' (transport (\lam g => Retraction {A} {B} g) p (\new Retraction e.f e.sec e.f_sec)) (\new Retraction e'.f e'.sec e'.f_sec)) @ i
      }

    \lemma levelProp {A B : \Cat} {f : A -> B} : isProp (BiEquiv f)
      => \lam e e' => path \lam i => \new BiEquiv {
        | Section => Section.levelProp e e e' i
        | Retraction => Retraction.levelProp e e e' i
      }
  }

\func BiEquiv~Equiv {A B : \Cat} : QEquiv {BiEquiv {A} {B}} {Equiv A B} \cowith
  | f e => mkEquiv (inP e)
  | ret e => Equiv.toQEquiv e
  | ret_f e => BiEquiv.equals idp
  | f_sec e => Equiv.equals idp

-- # Contractible types

\class Contr (A : \Cat) (center : A) (contraction : \Pi (a' : A) -> center = a') {
  \sfunc toSigma : \Sigma (x : A) (\Pi (a : A) -> x = a)
    => (center, contraction)
} \where {
    \func make {A : \Cat} (a : A) (p : \Pi (a' : A) -> a = a')
      => \new Contr A a p

    \use \level levelProp (A : \Cat) (c1 c2 : Contr A) : c1 = c2 => path (\lam i => \new Contr A {
      | center => c1.contraction c2.center i
      | contraction a' => pathOver {\lam i => c1.contraction c2.center i = a'} {c1.contraction a'} {c2.contraction a'}
          (isProp.=>isSet (\lam x y => inv (c1.contraction x) *> c1.contraction y) c2.center a' _ _) i
    })

    \lemma Contr_QEquiv {A B : \Cat} (e : QEquiv {A} {B}) (c : Contr A) : Contr B \cowith
      | center => e c.center
      | contraction b => e.adjointInv (c.contraction _)
  }

\lemma contr-equiv {A B : \Cat} (Ac : Contr A) (Bc : Contr B) {f : A -> B} : IsEquiv f
  => inP \new QEquiv {
    | ret _ => Ac.center
    | ret_f x => Ac.contraction x
    | f_sec y => isContr=>isProp Bc _ _
  }

\func isContr=>isProp {A : \Cat} (c : Contr A) : isProp A
  => \lam a a' => inv (c.contraction a) *> c.contraction a'

\lemma isContr'=>isProp {A : \Cat} (c : A -> Contr A) : isProp A
  => \lam a => isContr=>isProp (c a) a

\func isProp=>isContr {A : \Cat} (p : isProp A) (a : A) : Contr A
  => Contr.make a (p a)

\lemma isProp'=>isContr {A : \Cat} (p : isProp A) (a : TruncP A) : Contr A \elim a
  | inP a => isProp=>isContr p a

\lemma isProp=>PathContr (A : \Cat) (p : isProp A) (a a' : A) : Contr (a = a')
  => isProp=>isContr (isProp.=>isSet p a a') (p a a')

\lemma pi-Contr {A : \Cat} (B : A -> \Cat) (p : \Pi (a : A) -> Contr (B a)) : Contr (\Pi (a : A) -> B a)
  => Contr.make (\lam a => Contr.center {p a}) (\lam f => path (\lam i a => Contr.contraction {p a} (f a) @ i))

-- | Contr-based hLevels are closed under sigma-types
\lemma sigma-Contr (A : Contr) (B : \Pi (a : A) -> Contr) : Contr (\Sigma (a : A) (B a))
  => \let | a0 => A.center
          | p0 => ((a0, (B a0).center) : \Sigma (a : A) (B a))
     \in Contr.make p0 (\lam p => sigmaPath (A.contraction p.1) (isContr=>isProp (B p.1) _ _))

-- | If the total space of a family over a contractible base is contractible, then so is every fiber.
\lemma fiber-Contr {A : \Cat} (B : A -> \Type) (cA : Contr A) (cT : Contr (\Sigma (a : A) (B a))) (a : A) : Contr (B a)
  => \have c => transport B (isContr=>isProp cA cT.center.1 a) cT.center.2
     \in Contr.make c \lam b =>
          \have t => sigmaEquiv B (a,c) (a,b) (isContr=>isProp cT _ _)
          \in pmap (transport B __ c) (isProp.=>isSet (isContr=>isProp cA) a a idp t.1) *> t.2

-- | Paths over a path in a family of contractible types form a contractible type.
\lemma contr-pathOver {A : \Cat} (C : A -> \Cat) (Cc : \Pi (a : A) -> Contr (C a)) {a a' : A} (q : a = a') (u : C a) (v : C a')
  : Contr (Path (\lam j => C (q j)) u v) \elim q
  | idp => isProp=>PathContr _ (isContr=>isProp (Cc a)) u v

-- | Propositions are closed under equivalences
\lemma equiv-isProp {A B : \Type} {f : A -> B} (e : IsEquiv f) (As : isProp B) : isProp A
  => \lam a a' => inv (IsEquiv.ret_f e) *> pmap (IsEquiv.ret e) (As _ _) *> IsEquiv.ret_f e

-- | Sets are closed under equivalences
\lemma equiv-isSet {A B : \Type} {f : A -> B} (e : IsEquiv f) (As : isSet B) : isSet A
  => \lam a a' => equiv-isProp (pmapIsEquiv e) (As _ _)
