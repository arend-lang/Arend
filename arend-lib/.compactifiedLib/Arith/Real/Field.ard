\import Algebra.Field
\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.StrictlyOrdered
\import Algebra.Pointed
\import Algebra.Ring
\import Algebra.Semiring
\import Arith.Rat
\import Arith.Real
\import Arith.Real.InfReal
\import Arith.Real.LowerReal
\import Arith.Real.UpperReal
\import Data.Or
\import Function.Meta
\import Logic
\import Logic.Meta
\import Meta
\import Operations
\import Order.Biordered
\import Order.Lattice
\import Order.LinearOrder
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta
\import Topology.CoverSpace.Complete
\import Topology.CoverSpace.Product
\import Topology.MetricSpace
\import Topology.NormedAbGroup.Real
\import Topology.NormedAbGroup
\import Topology.TopAbGroup.Product
\import Topology.TopSpace
\import Topology.TopSpace.Product
\import Topology.UniformSpace
\import Topology.UniformSpace.Product
\open LinearlyOrderedAbGroup
\open ProductCoverSpace
\open DiscreteOrderedField
\open LinearOrder \hiding (<=)

\instance RealField : OrderedFieldAlgebra RatField Real 
  | LinearlyOrderedAbGroup => RealAbGroup
  | ide => 1
  | * => *
  | ide-left => ide-left
  | *-comm => *-comm
  | *-assoc => *-assoc
  | ldistr => ldistr
  | ide>zro => {?hidden_proof}
  | positive_* => {?hidden_proof}
  | positive=>#0 => {?hidden_proof}
  | #0=>eitherPosOrNeg => {?hidden_proof}
  | *c => \lam a x => Real.fromRat a * x
  | *c-assoc => {?hidden_proof}
  | *c-ldistr => {?hidden_proof}
  | *c-rdistr => {?hidden_proof}
  | ide_*c => {?hidden_proof}
  | *c-comm-left => {?hidden_proof}
  | coefMap => Real.fromRat
  | coefMap_*c => {?hidden_proof}
  | coef_< => {?hidden_proof}
  | coef_<-inv => {?hidden_proof}
  | natCoef => \lam n => Real.fromRat (natCoef n)
  | natCoefZero => {?hidden_proof}
  | natCoefSuc => {?hidden_proof}
  \where {
    \open Semigroup(* \as \infixl 7 *')
    \open CoverMap

    \lemma unique1 {X : SeparatedCoverSpace} (f g : CoverMap RealNormed X) (p : \Pi (x : Rat) -> f x = g x) {x : Real} : f x = g x => {?hidden_proof}

    \lemma unique2 {X : SeparatedCoverSpace} (f g : CoverMap (RealNormed ⨯ RealNormed) X) (p : \Pi (x y : Rat) -> f (x, y) = g (x, y)) {x y : Real} : f (x, y) = g (x, y) => {?hidden_proof}

    \lemma unique3 {X : SeparatedCoverSpace} (f g : CoverMap (RealNormed ⨯ RealNormed ⨯ RealNormed) X) (p : \Pi (x y z : Rat) -> f ((x, y), z) = g ((x, y), z)) 
    {x y z : Real} : f ((x, y), z) = g ((x, y), z) => {?hidden_proof}

    \lemma *-rat-locally-uniform : LocallyUniformMap (RatNormed ⨯ RatNormed) RatNormed (\lam s => s.1 *' s.2) => {?hidden_proof}

    \func *-cover-def : CoverMap (RealNormed ⨯ RealNormed) RealNormed => real-lift2 (rat_real ∘ *-rat-locally-uniform)

    \infixl 7 * (x y : Real) : Real => *-cover-def (x, y)

    \lemma *-rat {x y : Rat} : x * y = {Real} x *' y => {?hidden_proof}

    \lemma pow-rat {x : Rat} {n : Nat} : RealField.pow x n = {Real} RatField.pow x n => {?hidden_proof}

    \lemma *_>=0-char {x y : Real} (x>=0 : 0 <= x) (y>=0 : 0 <= y) {d : Rat} : (x * y).U d <-> ∃ (a : x.U) (b : y.U) (a *' b <= d) => {?hidden_proof}
      \where {
        \lemma *_>0-char {x y d : Real} (y>0 : 0 < y) (xy<d : x * y < d) : ∃ (a : x.U) (a * y < d) => {?hidden_proof}

        \lemma *_>0-char2 {x y : Real} (x>=0 : 0 <= x) (y>0 : 0 < y) {d : Rat} (xy<d : (x * y).U d) : ∃ (a : x.U) (b : y.U) (a *' b <= d) => {?hidden_proof}
      }


    \lemma *-upper {x y : Real} (x>=0 : 0 <= x) (y>=0 : 0 <= y) : x * y = x ExUpperReal.* y => {?hidden_proof}

    \lemma pow-upper {x : Real} (x>=0 : 0 <= x) {n : Nat} : RealField.pow x n = ExUpperRealSemigroup.pow x n => {?hidden_proof}

    \lemma *-cover : CoverMap (ProductCoverSpace RealNormed RealNormed) RealNormed (\lam s => s.1 * s.2) => {?hidden_proof}

    \lemma *_positive-char {x y : Real} (x>0 : x.L 0) (y>0 : y.L 0) {c d : Rat} :
      open-rat-int c d (x * y) <-> ∃ (a b a' b' : Rat) (0 < a) (0 < a') (open-rat-int a b x) (open-rat-int a' b' y) (c < a *' a') (b *' b' < d) => {?hidden_proof}

    \lemma *_positive-L {x y : Real} (x>0 : x.L 0) (y>0 : y.L 0) {c : Rat} : LowerReal.L {x * y} c <-> ∃ (a a' : Rat) (0 < a) (0 < a') (x.L a) (y.L a') (c < a *' a') => {?hidden_proof}

    \lemma *_positive-U {x y : Real} (x>0 : x.L 0) (y>0 : y.L 0) {d : Rat} : UpperReal.U {x * y} d <-> ∃ (b b' : Rat) (x.U b) (y.U b') (b *' b' < d) => {?hidden_proof}

    \func real-pos-inv {x : Real} (x>0 : x.L 0) : Real \cowith
      | L => \lam a => a <= 0 || x.U (finv a)
      | L-inh => {?hidden_proof}
      | L-closed => {?hidden_proof}
      | L-rounded => {?hidden_proof}
      | U => \lam a => \Sigma (0 < a) (x.L (finv a))
      | U-inh => {?hidden_proof}
      | U-closed => {?hidden_proof}
      | U-rounded => {?hidden_proof}
      | LU-disjoint => {?hidden_proof}
      | LU-located => {?hidden_proof}

    \lemma real-pos-inv>0 {x : Real} (x>0 : x.L 0) : LowerReal.L {real-pos-inv x>0} 0 => {?hidden_proof}

    \lemma pos-inv_rat {x : Rat} (x>0 : 0 < Real.fromRat x) : RealField.pinv x x>0 = Real.fromRat (finv x) => {?hidden_proof}

    \lemma finv-left {x : Rat} (x/=0 : x /= 0) : finv x * x = 1 => {?hidden_proof}

    \lemma finv-right {x : Rat} (x/=0 : x /= 0) : x * finv x = 1 => {?hidden_proof}

    \func half (x : Real) => x * ratio 1 2
  }
