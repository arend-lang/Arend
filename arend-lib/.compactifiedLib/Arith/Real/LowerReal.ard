\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Ordered
\import Algebra.StrictlyOrdered
\import Arith.Rat
\import Data.Or
\import Function.Meta
\import Logic
\import Logic.Meta
\import Meta
\import Order.Biordered
\import Order.Lattice
\import Order.LinearOrder
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths
\import Paths.Meta

\class ExtendedLowerReal {
  | L : Rat -> \Prop
  | L-closed {q q' : Rat} : L q -> q' < q -> L q'
  | L-rounded {q : Rat} : L q -> ∃ (r : L) (q < r)
}
  \where {
    \use \coerce fromRat (x : Rat) : ExtendedLowerReal \cowith
      | L => < x
      | L-closed => {?hidden_proof}
      | L-rounded => {?hidden_proof}
  }


\class LowerReal \extends ExtendedLowerReal {
  | L-inh : ∃ L
}
  \where {
    \use \coerce fromRat (x : Rat) : LowerReal \cowith
      | ExtendedLowerReal => ExtendedLowerReal.fromRat x
      | L-inh => {?hidden_proof}

    \func BJoin (b : LowerReal) {J : \Set} (f : J -> ExtendedLowerReal) : LowerReal \cowith
      | L => \lam q => b.L q || Given (j : J) ((f j).L q)
      | L-closed => {?hidden_proof}
      | L-rounded => {?hidden_proof}
      | L-inh => {?hidden_proof}

    \open LowerRealAbMonoid(<=)

    \lemma BJoin-bound {b : LowerReal} {J : \Set} {f : J -> ExtendedLowerReal} : b <= BJoin b f => {?hidden_proof}

    \lemma BJoin-cond {b : LowerReal} {J : \Set} (j : J) {f : J -> ExtendedLowerReal} : f j <= BJoin b f => {?hidden_proof}

    \lemma BJoin-univ {b : LowerReal} {J : \Set} {f : J -> ExtendedLowerReal} {e : ExtendedLowerReal} (b<=e : b <= e) (c : \Pi (j : J) -> f j <= e) : BJoin b f <= e => {?hidden_proof}
  }


\instance LowerRealAbMonoid : BiorderedLatticeAbMonoid LowerReal 
  | zro => LowerReal.fromRat 0
  | + => +
  | zro-left => {?hidden_proof}
  | +-assoc => {?hidden_proof}
  | +-comm => {?hidden_proof}
  | < => \lam x y => x < y
  | <-irreflexive => {?hidden_proof}
  | <-transitive => {?hidden_proof}
  | <= => \lam x y => x <= y
  | <=-refl => {?hidden_proof}
  | <=-transitive => {?hidden_proof}
  | <=-antisymmetric => {?hidden_proof}
  | meet => meet
  | meet-left => {?hidden_proof}
  | meet-right => {?hidden_proof}
  | meet-univ => {?hidden_proof}
  | join => join
  | join-left => {?hidden_proof}
  | join-right => {?hidden_proof}
  | join-univ => {?hidden_proof}
  | <-transitive-right => {?hidden_proof}
  | <-transitive-left => {?hidden_proof}
  | <=-less => {?hidden_proof}
  | <=_+ => {?hidden_proof}
  | <_meet-univ => {?hidden_proof}
  | <_join-univ => {?hidden_proof}
  | meet_+-left => {?hidden_proof}
  | join_+-left => {?hidden_proof}
  \where {
    \infixl 6 + (x y : LowerReal) : LowerReal \cowith
      | L => \lam a => ∃ (b : x.L) (c : y.L) (a RatField.< b RatField.+ c)
      | L-inh => {?hidden_proof}
      | L-closed => {?hidden_proof}
      | L-rounded => {?hidden_proof}

    \lemma +_L {x y : LowerReal} {a : Rat} : LowerReal.L {x + y} a <-> ∃ (b : x.L) (c : y.L) (a RatField.< b RatField.+ c) => {?hidden_proof}

    \lemma +-rat {x y : Rat} : LowerReal.fromRat x + LowerReal.fromRat y = LowerReal.fromRat (x RatField.+ y) => {?hidden_proof}

    \type \infix 4 <= (x y : ExtendedLowerReal) => ∀ {a : x.L} (y.L a)

    \type \infix 4 < (x y : ExtendedLowerReal) => ∃ (b : y.L) (x <= b)

    \lemma lower_<_L {a : Rat} {x : LowerReal} : (a : LowerReal) LowerRealAbMonoid.< x <-> x.L a => {?hidden_proof}

    meet (x y : LowerReal) : LowerReal \cowith
      | L => \lam a => \Sigma (x.L a) (y.L a)
      | L-inh => {?hidden_proof}
      | L-closed => {?hidden_proof}
      | L-rounded => {?hidden_proof}

    \lemma meet_L {x y : LowerReal} {a : Rat} : LowerReal.L {meet x y} a <-> (\Sigma (x.L a) (y.L a)) => {?hidden_proof}

    join (x y : LowerReal) : LowerReal \cowith
      | L => \lam a => x.L a || y.L a
      | L-inh => {?hidden_proof}
      | L-closed => {?hidden_proof}
      | L-rounded => {?hidden_proof}

    \lemma join_L {x y : LowerReal} {a : Rat} : LowerReal.L {join x y} a <-> x.L a || y.L a => {?hidden_proof}

    \lemma zro<ide : (0 : LowerReal) < (1 : LowerReal) => {?hidden_proof}

    \lemma <=-char {x : LowerReal} {a : Rat} (p : Not (x.L a)) : x <= LowerReal.fromRat a => {?hidden_proof}

    \lemma <_+ {a b c d : LowerReal} (p : a < c) (q : b < d) : a + b < c + d => {?hidden_proof}
  }


\instance ExtendedLowerRealLattice : CompleteLattice ExtendedLowerReal 
  | <= => LowerRealAbMonoid.<=
  | <=-refl => {?hidden_proof}
  | <=-transitive => {?hidden_proof}
  | <=-antisymmetric => {?hidden_proof}
  | Join => Join
  | Join-cond => {?hidden_proof}
  | Join-univ => {?hidden_proof}