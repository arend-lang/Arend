\import Category.Functor
\import Function.Meta
\import Logic
\import Logic.Meta
\import Meta
\import Order.Lattice
\import Order.PartialOrder
\import Paths.Meta
\import Set.Filter
\import Set.Subset
\import Topology.Locale
\import Topology.TopSpace
\import Topology.TopSpace.Category

\func OpensFrame (S : TopSpace) : Locale (Given S.isOpen) \cowith
  | <= => \lam U V => U.1 ⊆ V.1
  | <=-refl => {?hidden_proof}
  | <=-transitive => {?hidden_proof}
  | <=-antisymmetric => {?hidden_proof}
  | Join => \lam {J} g => (\lam x => ∃ (j : J) ((g j).1 x), S.open-IUnion g)
  | Join-cond => {?hidden_proof}
  | Join-univ => {?hidden_proof}
  | meet => \lam U V => (U.1 ∧ V.1, open-inter U.2 V.2)
  | meet-left => {?hidden_proof}
  | meet-right => {?hidden_proof}
  | meet-univ => {?hidden_proof}
  | Join-ldistr>= => {?hidden_proof}

\instance PointsSpace (L : Locale) : TopSpace (CompleteFilter L) 
  | isOpen => \lam U => ∃ (a : L) (\Pi {x : CompleteFilter L} -> U x <-> x a)
  | open-top => {?hidden_proof}
  | open-inter => {?hidden_proof}
  | open-Union => {?hidden_proof}

\func PointsSpaceFunctor : Functor LocaleCat TopCat \cowith
  | F => PointsSpace
  | Func {L M : Locale} (f : FrameHom M L) : ContMap (PointsSpace L) (PointsSpace M) 
    | func => filter-map f
    | func-cont => \lam inP (b, c) => inP (f b, \lam {x} => c)
  | Func-id => {?hidden_proof}
  | Func-o => {?hidden_proof}
  \where {
    \func filter-map {L M : Locale} (f : FrameHom M L) (x : CompleteFilter L) : CompleteFilter M \cowith
      | F => \lam b => x (f b)
      | filter-mono => {?hidden_proof}
      | filter-top => {?hidden_proof}
      | filter-meet => {?hidden_proof}
      | filter-Join => {?hidden_proof}
  }


\func points {L : Locale} : FrameHom L (OpensFrame (PointsSpace L)) \cowith
  | func => \lam a => (\lam x => x a, inP (a, \lam {x} => <->refl))
  | func-<= => {?hidden_proof}
  | func-top>= => {?hidden_proof}
  | func-meet>= => {?hidden_proof}
  | func-Join>= => {?hidden_proof}

\func points^* {L : Locale} (a : L) : Set (CompleteFilter L) => \lam x => x a

\lemma points^*-mono {L : Locale} {a b : L} (p : a <= b) : points^* a ⊆ points^* b => {?hidden_proof}

\lemma points^*_top>= {L : Locale} : top ⊆ points^* {L} top => {?hidden_proof}

\lemma points^*_top {L : Locale} : points^* {L} top = top => {?hidden_proof}

\lemma points^*_meet>= {L : Locale} {a b : L} : points^* a ∧ points^* b ⊆ points^* (a ∧ b) => {?hidden_proof}

\lemma points^*_meet {L : Locale} {a b : L} : points^* (a ∧ b) = points^* a ∧ points^* b => {?hidden_proof}

\func points_* {L : Locale} (U : Set (CompleteFilter L)) : L => L.SJoin (\lam a => points^* a ⊆ U)

\lemma points_*-mono {L : Locale} {U V : Set (CompleteFilter L)} (p : U ⊆ V) : points_* U <= points_* V => {?hidden_proof}

\lemma points_*_meet>= {L : Locale} {U V : Set (CompleteFilter L)} : points_* U ∧ points_* V <= points_* (U ∧ V) => {?hidden_proof}

\lemma points_*_meet {L : Locale} {U V : Set (CompleteFilter L)} : points_* (U ∧ V) = points_* U ∧ points_* V => {?hidden_proof}

\lemma points^*-points_* {L : Locale} {a : L} {U : Set (CompleteFilter L)} (p : points^* a ⊆ U) : a <= points_* U => {?hidden_proof}

\lemma points-unit {L : Locale} {a : L} : a <= points_* (points^* a) => {?hidden_proof}

\lemma points-counit {L : Locale} {U : Set (CompleteFilter L)} : points^* (points_* U) ⊆ U => {?hidden_proof}

\func framePres-point {P : FramePres} (F : P -> \Prop) (\property F-inh : ∃ F) (\property F-conj : \Pi {a b : P} -> F (conj a b) <-> (\Sigma (F a) (F b))) 
(\property F-cover : \Pi {J : \Set} {a : P} {f : J -> P} -> BasicCover a f -> F a -> ∃ (j : J) (F (f j))) : CompleteFilter (PresentedFrame P) \cowith
  | F => \lam U => ∃ (x : U.1) (F x)
  | filter-mono => {?hidden_proof}
  | filter-top => {?hidden_proof}
  | filter-meet => {?hidden_proof}
  | filter-Join => {?hidden_proof}
  \where {
    \lemma cover-filter {x : P} {J : \Set} {g : J -> P} (c : Cover x g) (Fx : F x) : ∃ (j : J) (F (g j)) => {?hidden_proof}
  }


\func HasDensePoints (L : Locale) : \Prop => points_* bottom <= L.bottom

\lemma hasDensePoints-char {L : Locale} : HasDensePoints L <-> (\Pi {a : L} -> (\Pi {x : CompleteFilter L} -> Not (x a)) -> a <= bottom) => {?hidden_proof}

\lemma hasDensePoints-fromPres {P : FramePres} (d : \Pi {a : P} -> points^* (PresentedFrame.embed a) ⊆ bottom -> Cover a absurd) : HasDensePoints (PresentedFrame P) => {?hidden_proof}

\func HasStronglyDensePoints (L : Locale) : \Prop => \Pi (a : L) -> a <= L.pHat (∃ (x : CompleteFilter L) (x a))

\lemma densePoints_cover {L : Locale} (d : HasStronglyDensePoints L) (a : L) : a <= Join (\lam (_ : ∃ (x : CompleteFilter L) (x a)) => a) => {?hidden_proof}

\lemma hasStronglyDensePoints-fromPres {P : FramePres} (d : \Pi (a : P) -> Cover a {∃ (points^* (PresentedFrame.embed a))} (\lam _ => a)) : HasStronglyDensePoints (PresentedFrame P) => {?hidden_proof}