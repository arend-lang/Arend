\import Data.Bool
\import Function.Meta
\import Logic
\import Logic.Meta
\import Meta
\import Operations
\import Order.Lattice
\import Order.PartialOrder
\import Paths
\import Paths.Meta
\import Set.Filter
\import Set.Subset
\import Topology.CoverSpace
\import Topology.CoverSpace.Complete
\import Topology.RatherBelow
\import Topology.TopSpace.Product
\open CoverMap
\open ClosurePrecoverSpace \hiding (closure-univ)
\open ProductCoverSpace

\instance CoverSpaceHasProduct : HasProduct CoverSpace 
  | Product => ProductCoverSpace

\instance ProductCoverSpace (X Y : CoverSpace) : CoverSpace (\Sigma X Y) 
  | TopSpace => ProductTopSpace X Y
  | isCauchy => isCauchy {Prod X Y}
  | cauchy-cover => {?hidden_proof}
  | cauchy-top => {?hidden_proof}
  | cauchy-refine => {?hidden_proof}
  | cauchy-glue => {?hidden_proof}
  | isRegular => {?hidden_proof}
  | cauchy-open => {?hidden_proof}
  \where {
\meta Prod X Y=>X Y CoverTransfer {\Sigma X Y} {X} __.1 ∨ CoverTransfer {\Sigma X Y} {Y} __.2

    \func proj1' {X Y : CoverSpace} : CoverMap (Prod X Y) X \cowith
      | func => \lam s => s.1
      | func-cover => {?hidden_proof}

    \func proj2' {X Y : CoverSpace} : CoverMap (Prod X Y) Y \cowith
      | func => \lam s => s.2
      | func-cover => {?hidden_proof}

    \lemma prodCover' {X Y : CoverSpace} {C : Set (Set X)} (Cc : X.isCauchy C) {D : Set (Set Y)} (Dc : Y.isCauchy D) :
      isCauchy {Prod X Y} (\lam W => ∃ (U : C) (V : D) (W = (\lam s => \Sigma (U s.1) (V s.2)))) => {?hidden_proof}

    \lemma prod-neighborhood' {X Y : CoverSpace} {x : X} {y : Y} {W : Set (\Sigma X Y)} (xy<=<W : single (x, y) <=< {Prod X Y} W) :
      ∃ (U : Set X) (V : Set Y) (single x <=< U) (single y <=< V) ∀ {x : U} {y : V} (W (x, y)) => {?hidden_proof}

    \lemma proj1 {X Y : CoverSpace} : CoverMap (X ⨯ Y) X __.1 => {?hidden_proof}

    \lemma proj2 {X Y : CoverSpace} : CoverMap (X ⨯ Y) Y __.2 => {?hidden_proof}

    \func tuple {X Y Z : CoverSpace} (f : CoverMap Z X) (g : CoverMap Z Y) : CoverMap Z (X ⨯ Y) \cowith
      | func => \lam z => (f z, g z)
      | func-cover => {?hidden_proof}
      \where {
        \func precover {Z : PrecoverSpace} {X Y : CoverSpace} (f : PrecoverMap Z X) (g : PrecoverMap Z Y) : PrecoverMap Z (X ⨯ Y) \cowith
          | func => \lam z => (f z, g z)
          | func-cover => {?hidden_proof}
      }


    \func prod {X Y X' Y' : CoverSpace} (f : CoverMap X Y) (g : CoverMap X' Y') : CoverMap (X ⨯ X') (Y ⨯ Y') => tuple (f ∘ proj1) (g ∘ proj2)
      \where {
        \lemma isEmbedding {X Y X' Y' : CoverSpace} {f : CoverMap X Y} {g : CoverMap X' Y'} (fe : f.IsEmbedding) (ge : g.IsEmbedding) : CoverMap.IsEmbedding {prod f g} => {?hidden_proof}

        \lemma isDenseEmbedding {X X' Y Y' : CoverSpace} {f : CoverMap X Y} {g : CoverMap X' Y'} (fde : f.IsDenseEmbedding) (gde : g.IsDenseEmbedding) :
          CoverMap.IsDenseEmbedding {prod f g} => {?hidden_proof}

        \lemma isWeaklyDenseEmbedding {X X' Y Y' : CoverSpace} {f : CoverMap X Y} {g : CoverMap X' Y'} (fde : f.IsWeaklyDenseEmbedding) (gde : g.IsWeaklyDenseEmbedding) :
          CoverMap.IsWeaklyDenseEmbedding {prod f g} => {?hidden_proof}
      }


    \lemma prod-neighborhood {X Y : CoverSpace} {x : X} {y : Y} {W : Set (\Sigma X Y)} :
      single (x, y) <=< {X ⨯ Y} W <-> ∃ (U : Set X) (V : Set Y) (single x <=< U) (single y <=< V) ∀ {x : U} {y : V} (W (x, y)) => {?hidden_proof}

    \lemma prodCover {X Y : CoverSpace} {C : Set (Set X)} (Cc : X.isCauchy C) {D : Set (Set Y)} (Dc : Y.isCauchy D) :
      isCauchy {X ⨯ Y} (\lam W => ∃ (U : C) (V : D) (W = (\lam s => \Sigma (U s.1) (V s.2)))) => {?hidden_proof}
  }


\instance ProductStronglyRegularCoverSpace (X Y : StronglyRegularCoverSpace) : StronglyRegularCoverSpace (\Sigma X Y) 
  | CoverSpace => ProductCoverSpace X Y
  | isStronglyRegular => {?hidden_proof}

\instance StronglyRegularCoverSpaceHasProduct : HasProduct StronglyRegularCoverSpace 
  | Product => ProductStronglyRegularCoverSpace

\instance ProductSeparatedCoverSpace (X Y : SeparatedCoverSpace) : SeparatedCoverSpace (\Sigma X Y) 
  | CoverSpace => ProductCoverSpace X Y
  | isSeparatedCoverSpace => {?hidden_proof}

\instance ProductCompleteCoverSpace (X Y : CompleteCoverSpace) : CompleteCoverSpace (\Sigma X Y) 
  => complete-char 1 0 $ inP (ProductCoverSpace.tuple (completion-lift proj1) (completion-lift proj2), \lam s => ext (completion-lift-char s, completion-lift-char s))

\func prodCF {X Y : CoverSpace} (F : CauchyFilter X) (G : CauchyFilter Y) : CauchyFilter (X ⨯ Y) \cowith
  | F => \lam W => ∃ (U : Set X) (F U) (V : Set Y) (G V) ∀ {x : U} {y : V} (W (x, y))
  | filter-mono => {?hidden_proof}
  | filter-top => {?hidden_proof}
  | filter-meet => {?hidden_proof}
  | isProper => {?hidden_proof}
  | isCauchyFilter => {?hidden_proof}

\instance PrecoverSpaceHasProduct : HasProduct PrecoverSpace 
  | Product => ProductPrecoverSpace

\instance ProductPrecoverSpace (X Y : PrecoverSpace) : PrecoverSpace (\Sigma X Y) 
  | isCauchy => isCauchy {Prod X Y}
  | cauchy-cover => {?hidden_proof}
  | cauchy-top => {?hidden_proof}
  | cauchy-refine => {?hidden_proof}
  | cauchy-glue => {?hidden_proof}
  \where {
\meta Prod X Y=>X Y PrecoverTransfer {\Sigma X Y} {X} __.1 ∨ PrecoverTransfer {\Sigma X Y} {Y} __.2

    \func proj1 {X Y : PrecoverSpace} : PrecoverMap (Prod X Y) X \cowith
      | func => \lam s => s.1
      | func-cover => {?hidden_proof}

    \func proj2 {X Y : PrecoverSpace} : PrecoverMap (Prod X Y) Y \cowith
      | func => \lam s => s.2
      | func-cover => {?hidden_proof}

    \lemma prodCover {X Y : PrecoverSpace} {C : Set (Set X)} (Cc : X.isCauchy C) {D : Set (Set Y)} (Dc : Y.isCauchy D) :
      isCauchy {X ⨯ Y} (\lam W => ∃ (U : C) (V : D) (W = (\lam s => \Sigma (U s.1) (V s.2)))) => {?hidden_proof}
  }
