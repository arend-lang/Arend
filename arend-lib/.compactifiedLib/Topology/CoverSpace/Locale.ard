\import Category.Functor
\import Data.Bool
\import Equiv
\import Function.Meta
\import Logic
\import Logic.Meta
\import Meta
\import Order.Lattice
\import Order.PartialOrder
\import Paths
\import Paths.Meta
\import Set.Filter
\import Set.Subset
\import Topology.CoverSpace
\import Topology.CoverSpace.Category
\import Topology.CoverSpace.Complete
\import Topology.CoverSpace.StronglyComplete(StronglyCompleteCoverSpace)
\import Topology.Locale \hiding (<=<_<=)
\import Topology.Locale.Points
\import Topology.RatherBelow
\open LocalePrecoverSpace
\open RatherBelow

\func CoverSpaceLocale (X : PrecoverSpace) : Locale => PresentedFrame (framePres {X})
  \where {
    \open PresentedFrame

    \func framePres {X : PrecoverSpace} : FramePres (Set X) \cowith
      | conj => ∧
      | BasicCover => \lam {J} U f =>
        Given (U = {Set X} top) (C : X.isCauchy) (∀ {V : C} ∃ (j : J) (f j = V)) || (\Pi {V : Set X} -> V s<=< U -> ∃ (j : J) (f j = V)) || (U = {Set X} bottom)

    \lemma cover-cauchy {X : PrecoverSpace} {C : Set (Set X)} (Cc : isCauchy C) : FramePres.SCover {framePres} top C => {?hidden_proof}

    \lemma cover-reg {X : PrecoverSpace} {U : Set X} : FramePres.SCover U (\lam V => V s<=< U) => {?hidden_proof}

    \lemma cover-empty {X : PrecoverSpace} {U : Set X} (Ue : \Pi {x : X} -> Not (U x)) {J : \Set} {g : J -> Set X} : Cover {framePres} U g => {?hidden_proof}

    \lemma embed_<=< {V U : Set X} (V<=<U : V s<=< U) : embed V Locale.<=< {CoverSpaceLocale X} embed U => {?hidden_proof}

    \lemma regular : Locale.IsRegularLocale {CoverSpaceLocale X} => {?hidden_proof}

    \lemma cover-char {X : StronglyRegularCoverSpace} {U : Set X} {J : \Set} {g : J -> Set X} (c : Cover {framePres} U g) {U' : Set X} (U'<=<U : U' s<=< U) :
      X.isCauchy (\lam V => (V = Compl U') || (\Sigma (j : J) (g j = V))) => {?hidden_proof}

    \lemma cover-point-char {X : StronglyRegularCoverSpace} {U : Set X} {J : \Set} {g : J -> Set X} (c : Cover {framePres} U g) {x : X} (x<=<U : single x <=< U) : ∃ (j : J) (single x <=< g j) 
      => {?hidden_proof}

    \lemma hasWeaklyDensePoints {X : StronglyRegularCoverSpace} (Xd : X.HasWeaklyDensePoints) : HasDensePoints (CoverSpaceLocale X) => {?hidden_proof}

    \lemma cover-inh {X : PrecoverSpace} (Xd : X.HasDensePoints) {U : Set X} : Cover {framePres} U {\Sigma (x : X) (U x)} (\lam _ => U) => {?hidden_proof}

    \lemma cover-reg-inh {X : PrecoverSpace} (Xd : X.HasDensePoints) {U : Set X} : Cover {framePres} U {\Sigma (x : X) (single x <=< U)} (\lam _ => U) => {?hidden_proof}

    \lemma hasStronglyDensePoints {X : StronglyRegularCoverSpace} (Xd : X.HasDensePoints) : HasStronglyDensePoints (CoverSpaceLocale X) => {?hidden_proof}
  }


\func LocalePrecoverSpace (L : Locale) : PrecoverSpace \cowith
  | E => CompleteFilter L
  | isCauchy => \lam C => top <= Join (\lam (s : Given C) => points_* s.1)
  | cauchy-cover => {?hidden_proof}
  | cauchy-top => {?hidden_proof}
  | cauchy-refine => {?hidden_proof}
  | cauchy-glue => {?hidden_proof}
  \where {
    \lemma points_<=< {a b : L} (p : a L.<=< b) : points^* a s<=< {LocalePrecoverSpace L} points^* b => {?hidden_proof}

    \lemma cover-cauchy {C : Set L} (p : top <= L.SJoin C) : isCauchy {LocalePrecoverSpace L} (\lam U => ∃ (a : C) (points^* a = U)) => {?hidden_proof}

    \lemma single_<=<-char {x : CompleteFilter L} {U : Set (CompleteFilter L)} (x<=<U : single x <=< {LocalePrecoverSpace L} U) : ∃ (a : L) (x a) (points^* a ⊆ U) => {?hidden_proof}

    \lemma hasWeaklyDensePoints (Ld : HasDensePoints L) : PrecoverSpace.HasWeaklyDensePoints {LocalePrecoverSpace L} => {?hidden_proof}

    \lemma hasDensePoints (Ld : HasStronglyDensePoints L) : PrecoverSpace.HasDensePoints {LocalePrecoverSpace L} => {?hidden_proof}
  }


\func LocaleCoverSpace {L : Locale} (Lr : L.IsRegularLocale) : StronglyRegularCoverSpace \cowith
  | PrecoverSpace => LocalePrecoverSpace L
  | isStronglyRegular => {?hidden_proof}

\func LocaleCoverSpaceFunctor : Functor LocaleCat PrecoverSpaceCat \cowith
  | F => LocalePrecoverSpace
  | Func => \lam f => \new PrecoverMap {
    | func => PointsSpaceFunctor.filter-map f
    | func-cover => \lam c => func-top>= <=∘ func-<= {f} c <=∘ func-Join>= <=∘ Join-univ
      (\lam (V, DV) => func-Join>= <=∘ Join-univ (\lam (b, p) => points^*-points_* (\lam c => later $ p $ later c) <=∘ Join-cond (later (_, inP (V, DV, idp)))))
  }
  | Func-id => {?hidden_proof}
  | Func-o => {?hidden_proof}

\func LocaleCoverSpaceFunctor-fullyFaithful {L M : Locale} (Ld : HasDensePoints L) (Mr : M.IsRegularLocale) : Equiv (LocaleCoverSpaceFunctor.Func {L} {M}) => Equiv.fromInjSurj _
  (
  \have r {f g : FrameHom M L} (p : LocaleCoverSpaceFunctor.Func f = LocaleCoverSpaceFunctor.Func g) {a : M} : f a <= g a => later $ f.func-<= (Mr a) <=∘ func-Join>= <=∘ Join-univ
            (\lam s => meet-univ <=-refl top-univ <=∘ MeetSemilattice.meet-monotone <=-refl (func-top>= <=∘ g.func-<= s.2 <=∘ g.func-join>=) <=∘ ldistr>= <=∘ join-univ
              (hasDensePoints-char.1 Ld  (\lam {x} c =>
        CompleteFilter.isProper $ filter-mono (filter-meet (filter-mono c meet-right) (propExt.dir (pmap {PrecoverMap _ _} (__ x s.1) p) $ filter-mono c meet-left)) $ func-meet>= <=∘ 
                  func-<= Locale.eval <=∘ g.func-bottom>=) <=∘ bottom-univ) meet-right)
  \in \lam p => exts (\lam a => <=-antisymmetric (r p) $ r $ inv p))
  (\lam f => inP (frameHom f,
  exts (\lam (x : CompleteFilter) => exts (\lam a => ext (\case filter-Join __ \with {  | inP ((b, b<=<a), r) => \case filter-Join r \with {
    | inP ((c, q), xc) => filter-mono (q xc) (Topology.Locale.<=<_<= b<=<a)  }},
  \lam fxa => (\case filter-Join $ filter-mono fxa (Mr a) \with {  | inP ((b, b<=<a), fxb) => \case filter-Join $ filter-mono fxb (Mr b) \with {
    | inP ((b', b'<=<b), fxb') => 
      \have t => func-cover {f} $ LocalePrecoverSpace.cover-cauchy {M} {\lam x => (x = M.neg b') || (x = b)} $ b'<=<b <=∘ join-univ (M.SJoin-cond $ byLeft idp) 
                    (M.SJoin-cond $ byRight idp)      \in \case filter-Join $ filter-mono {x} filter-top t \with {
            | inP ((_, inP (_, inP (_, byLeft idp, idp), idp)), xe) =>
              absurd (\case filter-Join xe \with {  | inP ((c, q), xc) => CompleteFilter.isProper $ filter-mono (filter-meet (q xc) fxb') M.eval})
            | inP ((_, inP (_, inP (_, byRight idp, idp), idp)), xe) => \case filter-Join xe \with {
              | inP ((c, q), xc) => filter-mono xe $ Join-cond (later (b, b<=<a))            }          }  }}))))))
  \where {
    \func frameHom (f : PrecoverMap (LocalePrecoverSpace L) (LocalePrecoverSpace M)) : FrameHom M L \cowith
      | func => \lam a => Join (\lam (s : \Sigma (b : M) (b M.<=< a)) => points_* $ f ^-1 points^* s.1)
      | func-<= => {?hidden_proof}
      | func-top>= => {?hidden_proof}
      | func-meet>= => {?hidden_proof}
      | func-Join>= => {?hidden_proof}
  }


\func CoverSpaceLocale-unit {X : StronglyRegularCoverSpace} (Xo : X.HasWeaklyDensePoints) : PrecoverMap X (LocaleCoverSpace {CoverSpaceLocale X} CoverSpaceLocale.regular) \cowith
  | func => \lam x => framePres-point (\lam U => single x <=< U) (inP (top, <=<_top)) 
    (\lam {a} {b} => (\lam p => (<=<-left p meet-left, <=<-left p meet-right), \lam (p, q) => <=<_meet-same p q)) 
    (\lam b x<=<U => CoverSpaceLocale.cover-point-char (cover-basic b) x<=<U)
  | func-cover => {?hidden_proof}
  \where {
    \open PresentedFrame

    \lemma isDense (Xd : X.HasWeaklyDensePoints) : PrecoverMap.IsWeaklyDense {CoverSpaceLocale-unit Xd} => {?hidden_proof}

    \lemma isEmbedding (Xd : X.HasWeaklyDensePoints) : PrecoverMap.IsEmbedding {CoverSpaceLocale-unit Xd} => {?hidden_proof}

    \lemma isDenseEmbedding (Xd : X.HasWeaklyDensePoints) : PrecoverMap.IsWeaklyDenseEmbedding {CoverSpaceLocale-unit Xd} => {?hidden_proof}
  }


\func LocaleCompleteCoverSpace {L : Locale} (Lr : L.IsRegularLocale) : StronglyCompleteCoverSpace \cowith
  | StronglyRegularCoverSpace => LocaleCoverSpace Lr
  | isSeparatedCoverSpace => {?hidden_proof}
  | isStronglyComplete => {?hidden_proof}
  \where {
    \open SeparatedCoverSpace

    \func makeFilter (F : WeaklyCauchyFilter (LocaleCoverSpace Lr)) : CompleteFilter L \cowith
      | F => \lam a => ∃ (b : L) (b L.<=< a) (F (points^* b))
      | filter-mono => {?hidden_proof}
      | filter-top => {?hidden_proof}
      | filter-meet => {?hidden_proof}
      | filter-Join => {?hidden_proof}
  }
