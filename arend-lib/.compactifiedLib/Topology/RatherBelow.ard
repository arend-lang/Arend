\import Function.Meta
\import Logic
\import Logic.Meta
\import Order.Lattice
\import Order.PartialOrder
\import Paths.Meta
\import Set.Subset

\class RatherBelow {
  | A : TopMeetSemilattice
  | R : A -> A -> \Prop
  | <=<-left {U V W : A} : R U V -> V <= W -> R U W
  | <=<-right {U V W : A} : U <= V -> R V W -> R U W
  | <=<_top {V : A} : R V top
  | <=<_meet {U V U' V' : A} : R U V -> R U' V' -> R (U ∧ U') (V ∧ V')
}
  \where {
    \lemma <=<c_bottom {A : CompleteLattice} {R : RatherBelow {A}} (p : \Pi {U : A} -> R bottom U) {U : A} : bottom R.<=<c U => {?hidden_proof}
  }


\lemma <=<c_^-1 {X Y : \Set} {RX : RatherBelow {SetLattice X}} {RY : RatherBelow {SetLattice Y}} {f : X -> Y} 
(<=<_^-1 : \Pi {U V : Set Y} -> RY U V -> RX (f ^-1 U) (f ^-1 V)) {U V : Set Y} (p : U RY.<=<c V) : f ^-1 U RX.<=<c f ^-1 V => {?hidden_proof}