\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Pointed
\import Function.Meta
\import Logic
\import Meta
\import Operations
\import Paths
\import Paths.Meta
\import Set.Subset
\import Topology.CoverSpace
\import Topology.CoverSpace.Complete
\import Topology.CoverSpace.Product
\import Topology.TopAbGroup
\import Topology.TopSpace
\import Topology.TopSpace.Product
\import Topology.UniformSpace.Product

\instance ProductTopAbGroup (X Y : TopAbGroup) : TopAbGroup (\Sigma X Y) 
  | UniformSpace => ProductUniformSpace X Y
  | zro => (0, 0)
  | + => \lam s t => (s.1 + t.1, s.2 + t.2)
  | zro-left => {?hidden_proof}
  | +-assoc => {?hidden_proof}
  | negative => \lam s => (negative s.1, negative s.2)
  | negative-left => {?hidden_proof}
  | +-comm => {?hidden_proof}
  | +-cont => {?hidden_proof}
  | negative-cont => {?hidden_proof}
  | neighborhood-uniform => {?hidden_proof}

\instance TopAbGroupHasProduct : HasProduct TopAbGroup 
  | Product => ProductTopAbGroup

\lemma negative-uniform {X : TopAbGroup} : TopAbGroupMap X X negative => {?hidden_proof}

\lemma +-uniform {X : TopAbGroup} : TopAbGroupMap (X ⨯ X) X (\lam s => s.1 + s.2) => {?hidden_proof}

\lemma subtract-uniform {X : TopAbGroup} : TopAbGroupMap (X ⨯ X) X (\lam s => s.1 - s.2) => {?hidden_proof}

\lemma *n-uniform {X : TopAbGroup} {n : Nat} : TopAbGroupMap X X (n X.*n) => {?hidden_proof}
  \where {
    \lemma *n-cont {n : Nat} : ContMap X X (n X.*n) => {?hidden_proof}
  }


\lemma *i-uniform {X : TopAbGroup} {n : Int} : TopAbGroupMap X X (n X.*i) => {?hidden_proof}

\lemma BigSum-cover {X : CoverSpace} {Y : TopAbGroup} (fs : Array (CoverMap X Y)) : CoverMap X Y (\lam x => Y.BigSum (\lam j => fs j x)) => {?hidden_proof}