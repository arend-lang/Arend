\import Category
\import Category.Meta
\import Function()
\import Order.Lattice
\import Order.LinearOrder
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths.Meta
\import Set
\import Set.SetHom

\class PosetHom \extends SetHom {
  \override Dom : Poset
  \override Cod : Poset
  | func-<= {x y : Dom} : x <= y -> func x <= func y
}

\instance PosetCat : Cat 
  | Ob => Poset
  | Hom => \lam P1 P2 => PosetHom P1 P2
  | id => id
  | o => \lam f g => \new PosetHom {
    | func => f Function.o g
    | func-<= => \lam leq => func-<= (func-<= leq)
  }
  | id-left => {?hidden_proof}
  | id-right => {?hidden_proof}
  | o-assoc => {?hidden_proof}
  | univalence => {?hidden_proof}

\class StrictPosetHom \extends SetHom {
  \override Dom : StrictPoset
  \override Cod : StrictPoset
  | func-< {x y : Dom} : x < y -> func x < func y
}

\instance StrictPosetCat : Cat 
  | Ob => StrictPoset
  | Hom => \lam P1 P2 => StrictPosetHom P1 P2
  | id => id
  | o => \lam f g => \new StrictPosetHom {
    | func => f Function.o g
    | func-< => \lam leq => func-< (func-< leq)
  }
  | id-left => {?hidden_proof}
  | id-right => {?hidden_proof}
  | o-assoc => {?hidden_proof}
  | univalence => {?hidden_proof}

\instance DecLinearOrderCat : Cat 
  | Ob => LinearOrder.Dec
  | Hom => \lam E1 E2 => PosetHom E1 E2
  | id => \lam X => \new (PosetHom X X) {
    | func => \lam x => x
    | func-<= => \lam x => x
  }
  | o => \lam f g => \new PosetHom {
    | func => \lam x => f (g x)
    | func-<= => \lam p1 => func-<= {f} (func-<= {g} p1)
  }
  | id-left => {?hidden_proof}
  | id-right => {?hidden_proof}
  | o-assoc => {?hidden_proof}
  | univalence => {?hidden_proof}