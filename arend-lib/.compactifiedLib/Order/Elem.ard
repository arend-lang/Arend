\import Order.Biordered
\import Order.LinearOrder
\import Order.PartialOrder
\import Order.StrictOrder
\import Paths.Meta
\import Set.Subset

\instance ElemStrictPoset {X : StrictPoset} (U : Set X) : StrictPoset (Elem U) 
  | < => \lam x y => x.1 < y.1
  | <-irreflexive => {?hidden_proof}
  | <-transitive => {?hidden_proof}

\instance ElemPoset {X : Poset} (U : Set X) : Poset (Elem U) 
  | <= => \lam x y => x.1 <= y.1
  | <=-refl => {?hidden_proof}
  | <=-transitive => {?hidden_proof}
  | <=-antisymmetric => {?hidden_proof}

\instance ElemBiordered {X : BiorderedSet} (U : Set X) : BiorderedSet (Elem U) 
  | StrictPoset => ElemStrictPoset U
  | Poset => ElemPoset U
  | <-transitive-right => {?hidden_proof}
  | <-transitive-left => {?hidden_proof}
  | <=-less => {?hidden_proof}

\instance ElemLinearOrder {X : LinearOrder} (U : Set X) : LinearOrder (Elem U) 
  | StrictPoset => ElemStrictPoset U
  | <-comparison => {?hidden_proof}
  | <-connectedness => {?hidden_proof}