\import Algebra.Meta
\import Category
\import Category.CartesianClosed
\import Category.Coreflection
\import Category.Limit
\import Equiv
\import Function(IsInj)
\import Function.Meta
\import Logic
\import Meta
\import Paths
\import Paths.Meta
\import Set.SetCategory
\open PrecatWithBprod

\class ToposPrecat \extends FinCompletePrecat, CartesianClosedPrecat {
  | subobj-classifier \alias omega : Ob
  | true-map : Hom terminal omega
  | char-map {S B : Ob} (m : Mono {\this} {S} {B}) : Hom B omega
  | char-pullback {S B : Ob} (m : Mono {\this} {S} {B}) : Pullback {\this} (char-map m) true-map S m terminalMap
  | char-unique {S B : Ob} {m : Mono {\this} {S} {B}} {phi : Hom B omega} (phi-pull : Pullback phi true-map S m terminalMap) : phi = char-map m
  | p-exponential : isExponentiable omega
  | p-exponential => CartesianClosedPrecat.is-exponentiable omega
  | exp => exp
}

\lemma sigma-prop-ext {A : \Prop} (a : A) : A = (\Sigma) => {?hidden_proof}

\lemma sigma-prop-ext-inv {A : \Prop} (eq : A = (\Sigma)) : A => {?hidden_proof}

\open PrecatWithTerminal
\open SetCartesianClosed

\instance SetTopos : ToposPrecat \Set 
  | FinCompletePrecat => SetBicat
  | CartesianClosedPrecat => SetCartesianClosed
  | subobj-classifier => \Prop
  | true-map => \lam _ => \Sigma
  | char-map => IsElement
  | char-pullback => \lam m => \new Pullback {
    | pbCoh => exts (\lam _ => sigma-prop-ext (SetTopos.isContained _ idp))
    | pbMap => \lam {_} p1 _ eq => \lam w1 => cases (isElement-char {_} {_} {_} {_} {p1} {eq} w1)
    | pbBeta1 => \lam {_} {p1} {_} {eq} => ext (\lam w1 => cases (isElement-char {_} {_} {_} {_} {p1} {eq} w1))
    | pbBeta2 => terminal-unique {SetBicat}
    | pbEta => \lam {_} {h1} {h2} eq _ => ext (\lam x => (  \let s : Mono.f {m} (h1 x) = Mono.f {m} (h2 x) => path (\lam i => (eq @ i) x)  \in mono-is-inj m s))
  }
  | char-unique => {?hidden_proof}
  \where {
    \func mono-is-inj {A B : SetBicat} (m : Mono {SetBicat} {A} {B}) : IsInj m.f 
      => \lam {a} {b} p => run {(name-inj, m.isMono, rewrite (name-f m.f a, name-f m.f b), pmap name' p)}

\data IsElement {A B : SetBicat} (m : Mono {SetBicat} {A} {B}) (b : B) 
      | isContained (a : A) (m.f a = b)
      \where {
        \use \level isProp {A B : SetBicat} (m : Mono {SetBicat} {A} {B}) (b : B) (x y : IsElement m b) : x = y \elim x, y
          | isContained a p, isContained c p1 => 
            \let | a=c : a = c => mono-is-inj m (p *> inv p1)
                 | p=p1 : transport {A} (\lam (x : A) => m.f x = b) a=c p = p1 => prop-isProp _ _
            \in \case \elim a, \elim c, \elim p, \elim p1, \elim a=c, \elim p=p1 \with {
                  | a, c, _, _, idp, idp => idp
                }
      }


    \func isElement-char {S B : SetBicat} {m : Mono {SetBicat} {S} {B}} {w : SetBicat} {p1 : w -> B} {eq : (\lam x => IsElement m (p1 x)) = (\lam _ => \Sigma)} (x : w) : IsElement m (p1 x) 
    => 
      \let s : IsElement m (p1 x) = (\Sigma) => path (\lam i => (eq @ i) x)
      \in sigma-prop-ext-inv s
  }
