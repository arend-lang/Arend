\import Algebra.Monoid
\import Algebra.Solver
\import Data.List
\import Function.Meta
\import Paths
\import Paths.Meta

\func MonoidSolverModel (M : Monoid) : SubstSolverModel M \cowith
  | Term => Term
  | NF => \lam n => List (Fin n)
  | normalize => \lam t => normalize-aux t nil
  | interpret {n : Nat} (env : Fin n -> M) (t : Term n) : M \elim t
    | var x => env x
    | :ide => M.ide
    | :* t s => interpret env t * interpret env s
  | interpretNF => interpretNF
  | interpretNF-consistent => {?hidden_proof}
  | nfVar => \lam v => v :: nil
  | >>= => >>=
  | >>=-consistent => {?hidden_proof}
  \where {
\data Term (n : Nat) 
      | var (Fin n)
      | :ide
      | \infixl 7 :* (t s : Term n)

    \func normalize-aux {n : Nat} (t : Term n) (acc : List (Fin n)) : List (Fin n) \elim t
      | var v => v :: acc
      | :ide => acc
      | :* t s => normalize-aux t (normalize-aux s acc)

    \protected \func interpretNF {V : \Set} (env : V -> M) (l : List V) : M \elim l
      | nil => M.ide
      | x :: nil => env x
      | x :: l => env x * interpretNF env l

    \protected \lemma interpretNF_:: {V : \Set} {env : V -> M} {x : V} {l : List V} : interpretNF env (x :: l) = env x * interpretNF env l => {?hidden_proof}

    \protected \lemma interpretNF_++ {V : \Set} {env : V -> M} {t s : List V} : interpretNF env (t ++ s) = interpretNF env t * interpretNF env s => {?hidden_proof}

    \lemma interpretNF-consistent-aux {n : Nat} {env : Fin n -> M} {t : Term n} {acc : List (Fin n)} : interpretNF env (normalize-aux t acc) = interpret env t * interpretNF env acc => {?hidden_proof}

    \func \infixl 2 >>= {U V : \Set} (l : List U) (k : U -> List V) : List V \elim l
      | nil => nil
      | u :: l => k u ++ (l >>= k)

    \lemma >>=-consistent {U V : \Set} {env : V -> M} {l : List U} {k : U -> List V} : interpretNF env (l >>= k) = interpretNF (\lam u => interpretNF env (k u)) l => {?hidden_proof}
  }


\func AddMonoidSolverModel (A : AddMonoid) : SubstSolverModel A => MonoidSolverModel (AddMonoid.toMonoid A)