\import Algebra.Group
\import Algebra.Monoid
\import Algebra.Monoid.Sub
\import Algebra.Pointed
\import Algebra.Ring
\import Algebra.Ring.Graded
\import Algebra.Ring.Localization
\import Algebra.Ring.Sub
\import Arith.Nat
\import Function.Meta
\import Logic
\import Logic.Meta
\import Paths
\import Paths.Meta

\func HomogenLocRing {R : GradedCRing} (S : SubMonoid R) : CRing => SubRing.cStruct subRing
  \where {
    \func subRing : SubRing (LocRing S) \cowith
      | contains => \lam x => ∃ (y : LocRing.SType S) (x = inl~ y) (n : Nat) (isHomogen y.1 n) (isHomogen y.2 n)
      | contains_zro => {?hidden_proof}
      | contains_+ => {?hidden_proof}
      | contains_ide => {?hidden_proof}
      | contains_* => {?hidden_proof}
      | contains_negative => {?hidden_proof}

    \func fromSType (y : LocRing.SType S) {n : Nat} (\property y1h : isHomogen y.1 n) (\property y2h : isHomogen y.2 n) : HomogenLocRing S 
      => (inl~ y, inP (y, idp, n, y1h, y2h))
      \where {
        \lemma equality (x : LocRing S) (x=[y] : x = inl~ y) : fromSType y y1h y2h = (x, inP (y, x=[y], n, y1h, y2h)) => {?hidden_proof}
      }

  }
