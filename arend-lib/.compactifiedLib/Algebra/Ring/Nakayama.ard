\lemma nakayama {R : CRing} {M : LModule R} {I : Ideal R} (fg : M.IsFinitelyGenerated) (c : topSubLModule M <= I *m topSubLModule M) :
  ∃ (e : R) (I (1 - e)) ∀ (m : M) (e *c m = 0) => {?hidden_proof}
  \where {
    \open MatrixRing
  }


\lemma nakayama' {R : CRing} {M : LModule R} {I : Ideal R} (fg : M.IsFinitelyGenerated) (c : topSubLModule M <= I *m topSubLModule M) : ∃ (e : R) (I e) ∀ m (e *c m = m) 
  => {?hidden_proof}

\lemma nakayama-ideal {R : CRing} {I : Ideal R} (Ifg : I.IsFinitelyGenerated) (p : I <= I * I) : ∃ (u : R) (u * u = u) (I.IsGeneratedBy1 u) => {?hidden_proof}

\lemma linear-surj-equiv {R : CRing} {U : LModule R} (fg : U.IsFinitelyGenerated) {f : LinearMap U U} (fs : IsSurj f) : Equiv f => {?hidden_proof}