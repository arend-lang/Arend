\import Algebra.Domain.Bezout
\import Algebra.Field
\import Algebra.Group
\import Algebra.Meta
\import Algebra.Monoid
\import Algebra.Monoid.Prime
\import Algebra.Monoid.Sub
\import Algebra.Pointed
\import Algebra.Pointed.Sub
\import Algebra.Ring
\import Algebra.Ring.Ideal
\import Algebra.Ring.RingHom
\import Algebra.Semiring
\import Function.Meta
\import Logic
\import Meta
\import Paths
\import Paths.Meta
\import Relation.Equivalence
\open Monoid

\instance FactorRing (I : Ideal) : CRing 
  | E => Type I
  | zro => inF 0
  | + (x y : Type I) : Type I \with
    | in~ a, in~ b => in~ (a Ring.+ b)
    | in~ a, ~-equiv b c r => fequiv (simplify r)
    | ~-equiv b c r, in~ a => fequiv (simplify r)
  | zro-left => {?hidden_proof}
  | +-assoc => {?hidden_proof}
  | +-comm => {?hidden_proof}
  | ide => inF 1
  | * (x y : Type I) : Type I \with
    | in~ a, in~ b => inF (a Ring.* b)
    | in~ a, ~-equiv b c r => fequiv $ transport I Ring.ldistr_- (I.ideal-left r)
    | ~-equiv b c r, in~ a => fequiv $ transport I Ring.rdistr_- (I.ideal-right r)
  | ide-left => {?hidden_proof}
  | *-assoc => {?hidden_proof}
  | ldistr => {?hidden_proof}
  | natCoef => \lam n => inF (natCoef n)
  | natCoefZero => {?hidden_proof}
  | natCoefSuc => {?hidden_proof}
  | negative (x : Type I) : Type I \with
    | in~ a => inF (Ring.negative a)
    | ~-equiv a b r => fequiv $ transport I equation.ring (I.ideal-left {-1} r)
  | negative-left => {?hidden_proof}
  | *-comm => {?hidden_proof}
  \where {
    \type Type (I : Ideal) => Quotient {I.S} (\lam a b => I (a - b))

    \func inF {I : Ideal} (a : I.S) : Type I => in~ a

    \lemma fequiv {I : Ideal} {a b : I.S} (p : I (a - b)) : inF a = inF b => {?hidden_proof}

    \lemma fequiv0 {I : Ideal} {a : I.S} (p : I a) : inF a = inF 0 => {?hidden_proof}

    \lemma unfequiv {I : Ideal} {a b : I.S} (p : inF a = inF b) : I (a - b) => {?hidden_proof}

    \lemma unfequiv0 {I : Ideal} {a : I.S} (p : inF a = inF 0) : I a => {?hidden_proof}
  }


\func factorHom {I : Ideal} : RingHom I.S (FactorRing I) \cowith
  | func => FactorRing.inF
  | func-+ => {?hidden_proof}
  | func-ide => {?hidden_proof}
  | func-* => {?hidden_proof}

\func factor-lift {I : Ideal} {R : Ring} (f : RingHom I.S R) (p : \Pi {a : I.S} -> I a -> f a = 0) : RingHom (FactorRing I) R \cowith
  | func (x : FactorRing I) : R \with
    | in~ a => f a
    | ~-equiv a b r => R.fromZero $ inv (f.func-+ *> pmap (_ +) f.func-negative) *> p r
  | func-+ => {?hidden_proof}
  | func-ide => {?hidden_proof}
  | func-* => {?hidden_proof}

\instance FactorField {I : Ideal} (Im : I.IsMaximal) : DiscreteField 
  | CRing => FactorRing I
  | zro/=ide => {?hidden_proof}
  | eitherZeroOrInv => {?hidden_proof}
  \where {
    \open FactorRing

    \lemma conv {I : Ideal} (p : 0 /= {FactorRing I} 1) (q : \Pi (x : FactorRing I) -> (x = 0) || Inv x) : I.IsMaximal => {?hidden_proof}
  }


\instance FactorIrrField (R : BezoutRing) (p : Irr {R}) : DiscreteField 
  | CRing => FactorRing (Ideal.closure1 p)
  | zro/=ide => {?hidden_proof}
  | eitherZeroOrInv => {?hidden_proof}
  \where {
    \open FactorRing \hiding (+, *, negative)

    \lemma trivial_Inv {R : CRing} {p : R} : (0 = {FactorRing (Ideal.closure1 p)} 1) <-> Inv p => {?hidden_proof}

    \lemma zeroOrInv-char {R : CRing} {p : R} : (\Pi (a : FactorRing (Ideal.closure1 p)) -> (a = 0) || Inv a) <-> (\Pi (a : R) -> Monoid.LDiv p a || (\Sigma (s t : R) (s * a + t * p = 1))) 
      => {?hidden_proof}

    \lemma conv {R : CRing} {p : R} (c : \Pi {x y : R} -> p * x = p * y -> x = y) (d : DiscreteField {  | CRing => FactorRing (Ideal.closure1 p)}) : Prime p => {?hidden_proof}
  }
