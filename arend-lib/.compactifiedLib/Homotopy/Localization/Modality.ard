\import Equiv
\import Homotopy.Localization.Universe

\class Modality \extends ReflUniverse {
  | isModality (A : Local) (B : A -> Local) : Local (\Sigma (a : A) (B a))
}

\lemma modality-elim {U : Modality} {A : \Type} (B : LType A -> Local) : Equiv {\Pi (x : LType A) -> B x} {\Pi (a : A) -> B (lEta a)} (\lam f a => f (lEta a)) => {?hidden_proof}