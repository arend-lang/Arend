\import Data.Bool
\import Data.Fin
\import Data.Or
\import Equiv
\import Equiv.Sigma
\import Equiv.HalfAdjoint
\import Function
\import Function.Meta
\import Logic
\import Logic.Meta
\import Meta
\import Order.Category
