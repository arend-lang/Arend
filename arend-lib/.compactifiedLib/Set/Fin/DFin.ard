\import Equiv
\import Function
\import Function.Iterate
\import Function.Meta
\import Logic
\import Paths
\import Set.Fin.Pigeonhole

\type isDFin (A : \Set) : \Prop => \Pi (f : A -> A) -> IsInj f -> IsSurj f
  \where {
    \lemma isEquiv {A : \Set} (p : isDFin A) (f : A -> A) (inj : IsInj f) : Equiv f => {?hidden_proof}

    \func isSplit {A : \Set} (p : isDFin A) (f : A -> A) (inj : IsInj f) (a : A) : \Sigma (a' : A) (f a' = a) => (ret {isEquiv p f inj} a, Equiv.f_ret a)

    \lemma fromPigeonhole (A : PigeonholeSet) : isDFin A => {?hidden_proof}
  }
