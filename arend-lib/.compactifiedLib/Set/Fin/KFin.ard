\import Arith.Nat (id<suc)
\import Data.Array
\import Data.Or
\import Function
\import Function.Meta ($)
\import Logic
\import Logic.Meta
\import Meta
\import Paths
\import Relation.Equivalence
\import Set
\import Set.Fin
\import Set.Fin.Pigeonhole

\class KFinSet \extends BoundedPigeonholeSet {
  | finSurj : ∃ (f : (Fin finCard -> E)) (IsSurj f)
  | boundedPigeonhole => \case finSurj \with {
    | inP (f, s) => boundedPigeonhole {pigeonhole-surj (\new (BoundedPigeonholeSet (Fin finCard) finCard (pigeonhole-fin __ id<suc))) f s}
  }

\lemma search (A : E -> \Prop) (d : \Pi (e : E) -> Dec (A e)) : Dec (∃ (e : E) (A e)) => {?hidden_proof}

\lemma ||-search {A : \Type} {B : E -> \Prop} (f : \Pi (x : E) -> A || B x) : A || (\Pi (x : E) -> B x) => {?hidden_proof}

\lemma search_yes_reduce {A : E -> \Prop} (d : \Pi (e : E) -> Dec (A e)) (e : ∃ (e : E) (A e)) : search A d = yes e => {?hidden_proof}

\lemma search_no_reduce {A : E -> \Prop} (d : \Pi (e : E) -> Dec (A e)) (q : Not (∃ (e : E) (A e))) : search A d = no q => {?hidden_proof}

\lemma dec : Dec (TruncP E) => {?hidden_proof}
}
\where {
  \lemma fromArray {A : \Set} (l : Array A) (p : \Pi (a : A) -> ∃ (i : Fin l.len) (l i = a)) : KFinSet A l.len => {?hidden_proof}

  \lemma toArray (A : KFinSet) : ∃ (l : Array A) ∀ a ∃ (i : Fin l.len) (l i = a) => {?hidden_proof}

  \lemma KFin+Dec=>Fin {A : \Set} (k : KFinSet A) {d : DecSet A} : FinSet A => {?hidden_proof}
}


\lemma QuotientKFin {A : KFinSet} {R : A -> A -> \Type} : KFinSet (Quotient R) A.finCard => {?hidden_proof}